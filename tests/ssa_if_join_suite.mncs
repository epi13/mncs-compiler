mncs 0.18;
module tests.compiler_ssa_if_join;

use mncs.compiler.decl.v1 as decl;
use mncs.compiler.flow.v1 as flow;
use mncs.compiler.ssa.v1 as ssa;
use mncs.test.assertions;
use mncs.test.suite;

// Source bytes: "x y z x" at spans:
// "x" = 0..1 (outer let x: u64)
// "y" = 2..3 (branch-local let y: u64)
// "z" = 4..5 (branch-local let z: u64)
// "x" = 6..7 (shadowed inner let x: bool or u64)
fn test_pages() -> (result: [[byte; up_to 64]; up_to 1]) {
    let p: [byte; up_to 64] = [120, 32, 121, 32, 122, 32, 120];
    return [p];
}

fn u64_ty() -> (result: decl.SemType) {
    return decl.SemType.TInt { width: 64, signed: false };
}

fn make_cfg_block(id: u64, kind: u64, succ0: u64, succ1: u64, succ_count: u64, is_join: bool, exprs: flow.TypedExprList) -> (result: flow.Block) {
    let base: flow.Block = flow.empty_block(id, true, is_join);
    return flow.Block {
        ..base,
        kind: kind,
        succ0: succ0,
        succ1: succ1,
        succ_count: succ_count,
        expressions: exprs
    };
}

fn bool_branch_expr() -> (result: flow.TypedExprList) {
    let op: decl.TOp = decl.TOp.TBool { value: true, ty: decl.SemType.TBool, start: 0, end: 1 };
    let expr: flow.TypedExpr = flow.TypedExpr {
        role: 2, start: 0, end: 1, binding_start: 0, binding_end: 0,
        ops: decl.TOpList.PCons { head: op, tail: decl.TOpList.PNil }, op_count: 1
    };
    return flow.TypedExprList.ECons { head: expr, tail: flow.TypedExprList.ENil };
}

fn let_int_expr(name_start: u64, name_end: u64, val: u64) -> (result: flow.TypedExpr) {
    let op: decl.TOp = decl.TOp.TInt { value: val, ty: u64_ty(), start: name_start, end: name_end };
    return flow.TypedExpr {
        role: 1, start: name_start, end: name_end, binding_start: name_start, binding_end: name_end,
        ops: decl.TOpList.PCons { head: op, tail: decl.TOpList.PNil }, op_count: 1
    };
}

fn let_bool_expr(name_start: u64, name_end: u64, val: bool) -> (result: flow.TypedExpr) {
    let op: decl.TOp = decl.TOp.TBool { value: val, ty: decl.SemType.TBool, start: name_start, end: name_end };
    return flow.TypedExpr {
        role: 1, start: name_start, end: name_end, binding_start: name_start, binding_end: name_end,
        ops: decl.TOpList.PCons { head: op, tail: decl.TOpList.PNil }, op_count: 1
    };
}

fn return_outer_x_expr() -> (result: flow.TypedExprList) {
    let op: decl.TOp = decl.TOp.TName { ty: u64_ty(), start: 0, end: 1 };
    let expr: flow.TypedExpr = flow.TypedExpr {
        role: 3, start: 0, end: 1, binding_start: 0, binding_end: 0,
        ops: decl.TOpList.PCons { head: op, tail: decl.TOpList.PNil }, op_count: 1
    };
    return flow.TypedExprList.ECons { head: expr, tail: flow.TypedExprList.ENil };
}

fn seed_for_blocks(blocks: flow.BlockList, next_block_id: u64) -> (result: ssa.SsaBuild) {
    let outer_x: ssa.Binding = ssa.Binding { name_start: 0, name_end: 1, value: 0, ty: u64_ty() };
    let entry_env: ssa.Environment = ssa.Environment.EnvCons { head: outer_x, tail: ssa.Environment.EnvNil };
    let entry_val: ssa.Value = ssa.Value { id: 0, ty: u64_ty(), owner_block: 0, kind: 0, index: 0 };
    let entry_vals: ssa.ValueList = ssa.ValueList.VCons { head: entry_val, tail: ssa.ValueList.VNil };
    return ssa.SsaBuild {
        rest: blocks, edges: ssa.EdgeList.ENil, join_scopes: ssa.JoinScopeList.JSNil,
        blocks: ssa.SsaBlockList.LNil, values: entry_vals, inputs: entry_vals,
        entry_env: entry_env, next_value: 1, next_instruction: 0, next_block_id: next_block_id,
        result_type: u64_ty(), identity: ssa.invalid_identity(),
        nominals: decl.NominalTypeIdentityList.NINil, entry: 0,
        supported: true, initial_failure_kind: 0
    };
}

test branch_local_disappears_at_if_join() -> (result: TestResult) {
    let pages: [[byte; up_to 64]; up_to 1] = test_pages();
    let b0: flow.Block = make_cfg_block(0, 1, 1, 2, 2, false, bool_branch_expr());
    let b1: flow.Block = make_cfg_block(1, 2, 3, 0, 1, false, flow.TypedExprList.ECons {
        head: let_int_expr(2, 3, 11),
        tail: flow.TypedExprList.ENil
    });
    let b2: flow.Block = make_cfg_block(2, 2, 3, 0, 1, false, flow.TypedExprList.ECons {
        head: let_int_expr(4, 5, 22),
        tail: flow.TypedExprList.ENil
    });
    let b3: flow.Block = make_cfg_block(3, 3, 0, 0, 0, true, return_outer_x_expr());
    let blocks: flow.BlockList = flow.BlockList.BCons {
        head: b0, tail: flow.BlockList.BCons {
        head: b1, tail: flow.BlockList.BCons {
        head: b2, tail: flow.BlockList.BCons {
        head: b3, tail: flow.BlockList.BNil }}}
    };
    let walk: ssa.SsaBlockWalk = ssa.lower_flow_blocks<1, 64>(pages, 64, 7, 4, seed_for_blocks(blocks, 4));
    let join3_in: ssa.Incoming = ssa.incoming_for<1, 64>(pages, 64, 7, 3, walk.build.edges);
    let has_x: ssa.BindingLookup = ssa.lookup_binding_exact_span(join3_in.bindings, 0, 1);
    let has_y: ssa.BindingLookup = ssa.lookup_binding_exact_span(join3_in.bindings, 2, 3);
    let has_z: ssa.BindingLookup = ssa.lookup_binding_exact_span(join3_in.bindings, 4, 5);
    let ok: bool = walk.processed == 4
        && walk.build.supported
        && join3_in.found && join3_in.ok && join3_in.count == 2
        && has_x.found && !has_y.found && !has_z.found;
    return from_assertion(equals_bool(true, ok, 1001));
}

test shadowed_outer_binding_retains_identity_and_type() -> (result: TestResult) {
    let pages: [[byte; up_to 64]; up_to 1] = test_pages();
    let b0: flow.Block = make_cfg_block(0, 1, 1, 2, 2, false, bool_branch_expr());
    // B1 (block param v2 for outer x: u64 at 0..1) shadows x with inner `let x: bool = true` (v3 at 6..7)
    let b1: flow.Block = make_cfg_block(1, 2, 3, 0, 1, false, flow.TypedExprList.ECons {
        head: let_bool_expr(6, 7, true),
        tail: flow.TypedExprList.ENil
    });
    // B2 (block param v4 for outer x: u64 at 0..1) shadows x with inner `let x: u64 = 99` (v5 at 6..7)
    let b2: flow.Block = make_cfg_block(2, 2, 3, 0, 1, false, flow.TypedExprList.ECons {
        head: let_int_expr(6, 7, 99),
        tail: flow.TypedExprList.ENil
    });
    let b3: flow.Block = make_cfg_block(3, 3, 0, 0, 0, true, return_outer_x_expr());
    let blocks: flow.BlockList = flow.BlockList.BCons {
        head: b0, tail: flow.BlockList.BCons {
        head: b1, tail: flow.BlockList.BCons {
        head: b2, tail: flow.BlockList.BCons {
        head: b3, tail: flow.BlockList.BNil }}}
    };
    let walk: ssa.SsaBlockWalk = ssa.lower_flow_blocks<1, 64>(pages, 64, 7, 4, seed_for_blocks(blocks, 4));
    let join3_in: ssa.Incoming = ssa.incoming_for<1, 64>(pages, 64, 7, 3, walk.build.edges);
    let outer_x: ssa.BindingLookup = ssa.lookup_binding_exact_span(join3_in.bindings, 0, 1);
    let shadow_x: ssa.BindingLookup = ssa.lookup_binding_exact_span(join3_in.bindings, 6, 7);
    let ok: bool = walk.processed == 4
        && walk.build.supported
        && join3_in.found && join3_in.ok && join3_in.count == 2
        && outer_x.found
        && outer_x.binding.name_start == 0
        && outer_x.binding.name_end == 1
        && (outer_x.binding.value == 2 || outer_x.binding.value == 4)
        && outer_x.binding.value != 3
        && outer_x.binding.value != 5
        && decl.is_u64_ty(outer_x.binding.ty)
        && !shadow_x.found;
    return from_assertion(equals_bool(true, ok, 1002));
}

test nested_no_else_if_join_regression() -> (result: TestResult) {
    let pages: [[byte; up_to 64]; up_to 1] = test_pages();
    let b0: flow.Block = make_cfg_block(0, 1, 1, 2, 2, false, bool_branch_expr());
    let b1_exprs: flow.TypedExprList = flow.TypedExprList.ECons {
        head: let_int_expr(2, 3, 11),
        tail: bool_branch_expr()
    };
    let b1: flow.Block = make_cfg_block(1, 1, 4, 5, 2, false, b1_exprs);
    let b4_exprs: flow.TypedExprList = flow.TypedExprList.ECons {
        head: let_int_expr(4, 5, 22),
        tail: flow.TypedExprList.ENil
    };
    let b4: flow.Block = make_cfg_block(4, 2, 6, 0, 1, false, b4_exprs);
    let b5: flow.Block = make_cfg_block(5, 2, 6, 0, 1, false, flow.TypedExprList.ENil);
    let b6: flow.Block = make_cfg_block(6, 2, 3, 0, 1, true, flow.TypedExprList.ENil);
    let b2: flow.Block = make_cfg_block(2, 2, 3, 0, 1, false, flow.TypedExprList.ENil);
    let b3: flow.Block = make_cfg_block(3, 3, 0, 0, 0, true, return_outer_x_expr());

    let blocks: flow.BlockList = flow.BlockList.BCons {
        head: b0, tail: flow.BlockList.BCons {
        head: b1, tail: flow.BlockList.BCons {
        head: b4, tail: flow.BlockList.BCons {
        head: b5, tail: flow.BlockList.BCons {
        head: b6, tail: flow.BlockList.BCons {
        head: b2, tail: flow.BlockList.BCons {
        head: b3, tail: flow.BlockList.BNil }}}}}}
    };
    let walk: ssa.SsaBlockWalk = ssa.lower_flow_blocks<1, 64>(pages, 64, 7, 7, seed_for_blocks(blocks, 7));
    let join6_in: ssa.Incoming = ssa.incoming_for<1, 64>(pages, 64, 7, 6, walk.build.edges);
    let join6_has_x: ssa.BindingLookup = ssa.lookup_binding_exact_span(join6_in.bindings, 0, 1);
    let join6_has_y: ssa.BindingLookup = ssa.lookup_binding_exact_span(join6_in.bindings, 2, 3);
    let join6_has_z: ssa.BindingLookup = ssa.lookup_binding_exact_span(join6_in.bindings, 4, 5);
    let join3_in: ssa.Incoming = ssa.incoming_for<1, 64>(pages, 64, 7, 3, walk.build.edges);
    let join3_has_x: ssa.BindingLookup = ssa.lookup_binding_exact_span(join3_in.bindings, 0, 1);
    let join3_has_y: ssa.BindingLookup = ssa.lookup_binding_exact_span(join3_in.bindings, 2, 3);
    let join3_has_z: ssa.BindingLookup = ssa.lookup_binding_exact_span(join3_in.bindings, 4, 5);
    let ok: bool = walk.processed == 7
        && walk.build.supported
        && join6_in.found && join6_in.ok && join6_in.count == 2
        && join6_has_x.found && join6_has_y.found && !join6_has_z.found
        && join3_in.found && join3_in.ok && join3_in.count == 2
        && join3_has_x.found && !join3_has_y.found && !join3_has_z.found;
    return from_assertion(equals_bool(true, ok, 1003));
}

fn match_switch_pages() -> (result: [[byte; up_to 128]; up_to 1]) {
    // "mncs 0.19; module t; x y e u64 Box Empty Pair v bool z match x { 0 => 10, _ => 30 } match e { Empty => 0, Pair { v: z } => 1 }" (126 bytes)
    let page: [byte; up_to 128] = [
        109 as byte, 110 as byte, 99 as byte, 115 as byte, 32 as byte, 48 as byte, 46 as byte, 49 as byte, 57 as byte, 59 as byte, 32 as byte, 109 as byte, 111 as byte, 100 as byte, 117 as byte, 108 as byte,
        101 as byte, 32 as byte, 116 as byte, 59 as byte, 32 as byte, 120 as byte, 32 as byte, 121 as byte, 32 as byte, 101 as byte, 32 as byte, 117 as byte, 54 as byte, 52 as byte, 32 as byte, 66 as byte,
        111 as byte, 120 as byte, 32 as byte, 69 as byte, 109 as byte, 112 as byte, 116 as byte, 121 as byte, 32 as byte, 80 as byte, 97 as byte, 105 as byte, 114 as byte, 32 as byte, 118 as byte, 32 as byte,
        98 as byte, 111 as byte, 111 as byte, 108 as byte, 32 as byte, 122 as byte, 32 as byte, 109 as byte, 97 as byte, 116 as byte, 99 as byte, 104 as byte, 32 as byte, 120 as byte, 32 as byte, 123 as byte,
        32 as byte, 48 as byte, 32 as byte, 61 as byte, 62 as byte, 32 as byte, 49 as byte, 48 as byte, 44 as byte, 32 as byte, 95 as byte, 32 as byte, 61 as byte, 62 as byte, 32 as byte, 51 as byte,
        48 as byte, 32 as byte, 125 as byte, 32 as byte, 109 as byte, 97 as byte, 116 as byte, 99 as byte, 104 as byte, 32 as byte, 101 as byte, 32 as byte, 123 as byte, 32 as byte, 69 as byte, 109 as byte,
        112 as byte, 116 as byte, 121 as byte, 32 as byte, 61 as byte, 62 as byte, 32 as byte, 48 as byte, 44 as byte, 32 as byte, 80 as byte, 97 as byte, 105 as byte, 114 as byte, 32 as byte, 123 as byte,
        32 as byte, 118 as byte, 58 as byte, 32 as byte, 122 as byte, 32 as byte, 125 as byte, 32 as byte, 61 as byte, 62 as byte, 32 as byte, 49 as byte, 32 as byte, 125 as byte
    ];
    return [page];
}

fn switch_nominal_id() -> (result: decl.SemanticIdentity) {
    return decl.SemanticIdentity { bytes: [50 as byte; 512], len: 4, valid: true };
}

fn switch_box_ty() -> (result: decl.SemType) {
    return decl.SemType.TNamed { start: 31, end: 34 };
}

fn switch_box_enum_decl() -> (result: decl.EnumDecl) {
    let field_v: decl.Field = decl.Field { name_start: 46, name_end: 47, type_start: 27, type_end: 30, type_kind: 1 };
    let empty_v: decl.Variant = decl.Variant { name_start: 35, name_end: 40, fields: decl.FieldList.FNil };
    let pair_v: decl.Variant = decl.Variant {
        name_start: 41, name_end: 45,
        fields: decl.FieldList.FCons { head: field_v, tail: decl.FieldList.FNil }
    };
    return decl.EnumDecl {
        ok: true, err_start: 0, err_end: 0, name_start: 31, name_end: 34,
        variants: decl.VariantList.VCons { head: empty_v, tail: decl.VariantList.VCons { head: pair_v, tail: decl.VariantList.VNil } },
        decl_start: 31, decl_end: 47, cursor: 47
    };
}

fn assemble_ssa_function(walk: ssa.SsaBlockWalk, entry_inputs: ssa.ValueList, nominals: decl.NominalTypeIdentityList) -> (result: ssa.Function) {
    let st: ssa.SsaBuild = walk.build;
    let normal_count: u64 = st.next_block_id;
    let fail_block: ssa.SsaBlock = ssa.SsaBlock {
        id: normal_count, parameters: ssa.ValueList.VNil, parameter_bindings: ssa.Environment.EnvNil,
        instructions: ssa.InstructionList.QNil, terminator: ssa.Terminator.Fail,
        reachable: false, has_failure_target: false, failure_target: 0, lowering_ok: true, lowering_failure_kind: 0
    };
    let bound: ssa.SsaBlockList = ssa.bind_failure_targets<1, 128>(st.blocks, normal_count);
    let blocks: ssa.SsaBlockList = ssa.SsaBlockList.LCons { head: fail_block, tail: bound };
    let fn_id: decl.SemanticIdentity = decl.SemanticIdentity { bytes: [49 as byte; 512], len: 1, valid: true };
    return ssa.Function {
        identity: fn_id, nominals: nominals,
        imported_records: decl.ImportedRecordList.IRNil, imported_enums: decl.ImportedEnumList.IENil,
        inputs: entry_inputs, result_type: u64_ty(),
        blocks: blocks, block_count: normal_count + 1,
        values: st.values, value_count: st.next_value,
        supported: st.supported, verified: false
    };
}

test finite_match_payload_arm_isolation_and_verification() -> (result: TestResult) {
    let pages: [[byte; up_to 128]; up_to 1] = match_switch_pages();
    let box_ty: decl.SemType = switch_box_ty();
    let nom_id: decl.SemanticIdentity = switch_nominal_id();
    let nominals: decl.NominalTypeIdentityList = decl.NominalTypeIdentityList.NICons {
        head: decl.NominalTypeIdentity { start: 31, end: 34, identity: nom_id, reference: false },
        tail: decl.NominalTypeIdentityList.NINil
    };
    let decls: ssa.LocalTypeDecls = ssa.LocalTypeDecls {
        valid: true, records: decl.RecordList.RNil,
        enums: decl.EnumList.GCons { head: switch_box_enum_decl(), tail: decl.EnumList.GNil }
    };

    // Finite match with payload binding `z` (116..117): isolated to Pair arm block 3, absent at join block 1.
    let pat_empty: decl.FinitePattern = decl.FinitePattern {
        has_qualifier: false, qualifier_start: 0, qualifier_end: 0, variant_start: 94, variant_end: 99,
        has_payload: false, ignore_payload: false, bindings: decl.PayloadBindingList.YNil, start: 94, end: 99
    };
    let pat_pair: decl.FinitePattern = decl.FinitePattern {
        has_qualifier: false, qualifier_start: 0, qualifier_end: 0, variant_start: 106, variant_end: 110,
        has_payload: true, ignore_payload: false,
        bindings: decl.PayloadBindingList.YCons {
            head: decl.PayloadBinding { field_start: 113, field_end: 114, name_start: 116, name_end: 117 },
            tail: decl.PayloadBindingList.YNil
        },
        start: 106, end: 119
    };
    let arm_empty: decl.TypedFiniteMatchArm = decl.TypedFiniteMatchArm {
        pattern: pat_empty, type_identity: nom_id, payload_fields: decl.BindList.BNil,
        ops: decl.TOpList.PCons { head: decl.TOp.TInt { value: 0, ty: u64_ty(), start: 103, end: 104 }, tail: decl.TOpList.PNil }, op_count: 1
    };
    let arm_pair: decl.TypedFiniteMatchArm = decl.TypedFiniteMatchArm {
        pattern: pat_pair, type_identity: nom_id,
        payload_fields: decl.BindList.BCons { head: decl.Bind { start: 113, end: 114, ty: u64_ty() }, tail: decl.BindList.BNil },
        ops: decl.TOpList.PCons { head: decl.TOp.TInt { value: 1, ty: u64_ty(), start: 123, end: 124 }, tail: decl.TOpList.PNil }, op_count: 1
    };
    let fm_op: decl.TOp = decl.TOp.TFiniteMatch {
        ty: u64_ty(), subject_ty: box_ty,
        arms: decl.TypedFiniteMatchArmList.TFCons { head: arm_empty, tail: decl.TypedFiniteMatchArmList.TFCons { head: arm_pair, tail: decl.TypedFiniteMatchArmList.TFNil } },
        arm_count: 2, start: 84, end: 126
    };
    let fm_expr: flow.TypedExpr = flow.TypedExpr {
        role: 1, start: 84, end: 126, binding_start: 46, binding_end: 47,
        ops: decl.TOpList.PCons { head: decl.TOp.TName { ty: box_ty, start: 25, end: 26 }, tail: decl.TOpList.PCons { head: fm_op, tail: decl.TOpList.PNil } },
        op_count: 2
    };
    let f_b0: flow.Block = make_cfg_block(0, 2, 1, 0, 1, false, flow.TypedExprList.ECons { head: fm_expr, tail: flow.TypedExprList.ENil });
    let f_ret_x: flow.TypedExpr = flow.TypedExpr {
        role: 3, start: 21, end: 22, binding_start: 0, binding_end: 0,
        ops: decl.TOpList.PCons { head: decl.TOp.TName { ty: u64_ty(), start: 21, end: 22 }, tail: decl.TOpList.PNil }, op_count: 1
    };
    let f_b1: flow.Block = make_cfg_block(1, 3, 0, 0, 0, true, flow.TypedExprList.ECons { head: f_ret_x, tail: flow.TypedExprList.ENil });
    let f_blocks: flow.BlockList = flow.BlockList.BCons { head: f_b0, tail: flow.BlockList.BCons { head: f_b1, tail: flow.BlockList.BNil } };
    let vx: ssa.Value = ssa.Value { id: 0, ty: u64_ty(), owner_block: 0, kind: 0, index: 0 };
    let vy: ssa.Value = ssa.Value { id: 1, ty: decl.SemType.TBool, owner_block: 0, kind: 0, index: 0 };
    let ve: ssa.Value = ssa.Value { id: 2, ty: box_ty, owner_block: 0, kind: 0, index: 0 };
    let f_inputs: ssa.ValueList = ssa.ValueList.VCons { head: vx, tail: ssa.ValueList.VCons { head: vy, tail: ssa.ValueList.VCons { head: ve, tail: ssa.ValueList.VNil } } };
    let f_values: ssa.ValueList = ssa.ValueList.VCons { head: ve, tail: ssa.ValueList.VCons { head: vy, tail: ssa.ValueList.VCons { head: vx, tail: ssa.ValueList.VNil } } };
    let f_env: ssa.Environment = ssa.Environment.EnvCons {
        head: ssa.Binding { name_start: 21, name_end: 22, value: 0, ty: u64_ty() },
        tail: ssa.Environment.EnvCons {
            head: ssa.Binding { name_start: 23, name_end: 24, value: 1, ty: decl.SemType.TBool },
            tail: ssa.Environment.EnvCons { head: ssa.Binding { name_start: 25, name_end: 26, value: 2, ty: box_ty }, tail: ssa.Environment.EnvNil }
        }
    };
    let f_seed: ssa.SsaBuild = ssa.SsaBuild {
        rest: f_blocks, edges: ssa.EdgeList.ENil, join_scopes: ssa.JoinScopeList.JSNil, blocks: ssa.SsaBlockList.LNil,
        values: f_values, inputs: f_inputs, entry_env: f_env, next_value: 3, next_instruction: 0, next_block_id: 2,
        result_type: u64_ty(), identity: ssa.invalid_identity(), nominals: nominals, entry: 0, supported: true, initial_failure_kind: 0
    };
    let f_walk: ssa.SsaBlockWalk = ssa.lower_flow_blocks<1, 128>(pages, 128, 126, 2, f_seed);
    let pair_arm_lk: ssa.BlockLookup = ssa.find_block<1, 128>(pages, 128, 126, f_walk.build.blocks, 3);
    let arm_has_z: ssa.BindingLookup = ssa.lookup_binding_exact_span(pair_arm_lk.block.parameter_bindings, 116, 117);
    let b1_in: ssa.Incoming = ssa.incoming_for<1, 128>(pages, 128, 126, 1, f_walk.build.edges);
    let join_has_z: ssa.BindingLookup = ssa.lookup_binding_exact_span(b1_in.bindings, 116, 117);
    let join_has_y: ssa.BindingLookup = ssa.lookup_binding_exact_span(b1_in.bindings, 23, 24);
    let f_fn: ssa.Function = assemble_ssa_function(f_walk, f_inputs, nominals);
    let finite_verified: bool = ssa.verify_function_base_with_decls<1, 128>(pages, 128, 126, f_fn, decls);
    let ok: bool = f_walk.processed == 2 && f_walk.build.supported
        && pair_arm_lk.found && arm_has_z.found && !(join_has_z.found)
        && join_has_y.found && decl.is_bool_ty(join_has_y.binding.ty)
        && finite_verified;
    return from_assertion(equals_bool(true, ok, 1004));
}

test scalar_switch_lowering_and_verification() -> (result: TestResult) {
    let pages: [[byte; up_to 128]; up_to 1] = match_switch_pages();
    let decls: ssa.LocalTypeDecls = ssa.LocalTypeDecls {
        valid: true, records: decl.RecordList.RNil,
        enums: decl.EnumList.GCons { head: switch_box_enum_decl(), tail: decl.EnumList.GNil }
    };
    let s_arm0: decl.TypedScalarMatchArm = decl.TypedScalarMatchArm {
        is_default: false, negative: false, value: 0, overflow: false, pattern_start: 65, pattern_end: 66,
        ops: decl.TOpList.PCons { head: decl.TOp.TInt { value: 10, ty: u64_ty(), start: 70, end: 72 }, tail: decl.TOpList.PNil }, op_count: 1
    };
    let s_arm1: decl.TypedScalarMatchArm = decl.TypedScalarMatchArm {
        is_default: true, negative: false, value: 0, overflow: false, pattern_start: 74, pattern_end: 75,
        ops: decl.TOpList.PCons { head: decl.TOp.TInt { value: 30, ty: u64_ty(), start: 79, end: 81 }, tail: decl.TOpList.PNil }, op_count: 1
    };
    let sm_op: decl.TOp = decl.TOp.TMatch {
        ty: u64_ty(), subject_ty: u64_ty(),
        arms: decl.TypedScalarMatchArmList.TSCons { head: s_arm0, tail: decl.TypedScalarMatchArmList.TSCons { head: s_arm1, tail: decl.TypedScalarMatchArmList.TSNil } },
        arm_count: 2, default_count: 1, start: 55, end: 83
    };
    let sm_expr: flow.TypedExpr = flow.TypedExpr {
        role: 3, start: 55, end: 83, binding_start: 0, binding_end: 0,
        ops: decl.TOpList.PCons { head: decl.TOp.TName { ty: u64_ty(), start: 21, end: 22 }, tail: decl.TOpList.PCons { head: sm_op, tail: decl.TOpList.PNil } },
        op_count: 2
    };
    let s_b0: flow.Block = make_cfg_block(0, 3, 0, 0, 0, false, flow.TypedExprList.ECons { head: sm_expr, tail: flow.TypedExprList.ENil });
    let s_blocks: flow.BlockList = flow.BlockList.BCons { head: s_b0, tail: flow.BlockList.BNil };
    let vx: ssa.Value = ssa.Value { id: 0, ty: u64_ty(), owner_block: 0, kind: 0, index: 0 };
    let s_inputs: ssa.ValueList = ssa.ValueList.VCons { head: vx, tail: ssa.ValueList.VNil };
    let s_env: ssa.Environment = ssa.Environment.EnvCons { head: ssa.Binding { name_start: 21, name_end: 22, value: 0, ty: u64_ty() }, tail: ssa.Environment.EnvNil };
    let s_seed: ssa.SsaBuild = ssa.SsaBuild {
        rest: s_blocks, edges: ssa.EdgeList.ENil, join_scopes: ssa.JoinScopeList.JSNil, blocks: ssa.SsaBlockList.LNil,
        values: s_inputs, inputs: s_inputs, entry_env: s_env, next_value: 1, next_instruction: 0, next_block_id: 1,
        result_type: u64_ty(), identity: ssa.invalid_identity(), nominals: decl.NominalTypeIdentityList.NINil, entry: 0, supported: true, initial_failure_kind: 0
    };
    let s_walk: ssa.SsaBlockWalk = ssa.lower_flow_blocks<1, 128>(pages, 128, 126, 1, s_seed);
    let s_fn: ssa.Function = assemble_ssa_function(s_walk, s_inputs, decl.NominalTypeIdentityList.NINil);
    let scalar_verified: bool = ssa.verify_function_base_with_decls<1, 128>(pages, 128, 126, s_fn, decls);
    let bad_sm_op: decl.TOp = decl.TOp.TMatch {
        ty: u64_ty(), subject_ty: u64_ty(),
        arms: decl.TypedScalarMatchArmList.TSCons { head: s_arm0, tail: decl.TypedScalarMatchArmList.TSNil },
        arm_count: 1, default_count: 1, start: 55, end: 83
    };
    let bad_sm_expr: flow.TypedExpr = flow.TypedExpr {
        role: 3, start: 55, end: 83, binding_start: 0, binding_end: 0,
        ops: decl.TOpList.PCons { head: decl.TOp.TName { ty: u64_ty(), start: 21, end: 22 }, tail: decl.TOpList.PCons { head: bad_sm_op, tail: decl.TOpList.PNil } },
        op_count: 2
    };
    let bad_b0: flow.Block = make_cfg_block(0, 3, 0, 0, 0, false, flow.TypedExprList.ECons { head: bad_sm_expr, tail: flow.TypedExprList.ENil });
    let bad_walk: ssa.SsaBlockWalk = ssa.lower_flow_blocks<1, 128>(pages, 128, 126, 1, ssa.SsaBuild { ..s_seed, rest: flow.BlockList.BCons { head: bad_b0, tail: flow.BlockList.BNil } });
    let bad_fn: ssa.Function = assemble_ssa_function(bad_walk, s_inputs, decl.NominalTypeIdentityList.NINil);
    let bad_scalar_rejected: bool = !(ssa.verify_function_base_with_decls<1, 128>(pages, 128, 126, bad_fn, decls));
    let ok: bool = s_walk.processed == 1 && s_walk.build.supported && scalar_verified && bad_scalar_rejected;
    return from_assertion(equals_bool(true, ok, 1005));
}
