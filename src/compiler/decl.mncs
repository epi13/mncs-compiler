mncs 0.10;
module mncs.compiler.decl.v1;
use mncs.compiler.source.v1 as source;
use mncs.compiler.lexer.v1 as lexer;
use mncs.compiler.segment.v1 as segment;
use mncs.compiler.parser.v1 as parser;

// Bounded declaration-scale syntax facts over a four-segment logical source
// (see segment.v1). Inputs are exact caller-supplied chunks plus a total
// length; every offset below is absolute. This is the bounded laboratory
// interface from CP-0001, not a whole-module source API.
//
// Homing rule (see CP-0008): every tree type in this module (expressions,
// statements, declarations, and their lists) is defined, constructed, and
// destructured HERE. Stage-0 rejects cross-module finite payload use, so
// tree-walking stages (parse, resolve, check, lower) must share one home
// module. Byte/token/record-only layers stay separate; consumers in other
// modules may only pass these trees opaquely.
//
// Scope of this slice (profile 0.10 shapes only; no profile gating):
// header, use, record, payload enum, and function declarations; function
// bodies with let/if-else/fail/terminal-return; expressions over names,
// integers, booleans, all binary operators, direct calls, and field
// projection. Deliberately deferred: iterate statements, match expressions,
// record/enum construction literals, index/slice/cast, select/replace and
// host intrinsics, generics, qualified calls, and vec/mask types. Inputs
// using deferred shapes fail with an explicit local error span; they are
// never silently accepted.
//
// Error policy: first failure wins. Every parse record carries ok plus the
// failing span. Nodes are valid only when ok is true; on failure records
// still carry a dummy node so callers can thread state without option
// types. Differential negative tests compare the first-error span against
// Stage-0, mirroring the header precedent.

// Type spelling classification. kind: 1 u64, 2 i64, 3 bool, 4 byte,
// 5 named, 6 qualified, 7 exact sequence, 8 viewed sequence, 9 other.
record TypeRef { kind: u64, start: u64, end: u64 }
record TypeParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, node: TypeRef }

// Shared name:type pair shape for parameters, results, record fields, and
// enum payload fields. Source order is preserved (reversed during the
// fuel-loop accumulation, then restored).
record Field { name_start: u64, name_end: u64, type_start: u64, type_end: u64, type_kind: u64 }
enum FieldList { FNil, FCons { head: Field, tail: FieldList } }
record FieldsParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: FieldList }

enum Stmt {
    Let { name_start: u64, name_end: u64, type_start: u64, type_end: u64, type_kind: u64, value: Expr, start: u64, end: u64 },
    If { cond: Expr, then_b: StmtList, else_b: StmtList, start: u64, end: u64 },
    Fail { mode_start: u64, mode_end: u64, start: u64, end: u64 },
    Return { value: Expr, start: u64, end: u64 }
}
enum StmtList { SNil, SCons { head: Stmt, tail: StmtList } }
record StmtParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, node: Stmt }

record Clause { kind_start: u64, kind_end: u64, name_start: u64, name_end: u64 }
enum ClauseList { CNil, CCons { head: Clause, tail: ClauseList } }
record Effect { kind_start: u64, kind_end: u64, cap_start: u64, cap_end: u64 }
enum EffectList { XNil, XCons { head: Effect, tail: EffectList } }
record Cap { start: u64, end: u64 }
enum CapList { ANil, ACons { head: Cap, tail: CapList } }

record FnSig { name_start: u64, name_end: u64, params: FieldList, results: FieldList, contracts: ClauseList, effects: EffectList, capabilities: CapList }
record FnBody { body: StmtList, ret: Expr, has_ret: bool }
record FnDecl { ok: bool, err_start: u64, err_end: u64, sig: FnSig, body: FnBody, fn_start: u64, fn_end: u64, cursor: u64 }
enum FnList { DNil, DCons { head: FnDecl, tail: FnList } }

record UseDecl { ok: bool, err_start: u64, err_end: u64, module_start: u64, module_end: u64, alias_start: u64, alias_end: u64, has_alias: bool, cursor: u64 }
enum UseList { UNil, UCons { head: UseDecl, tail: UseList } }
record RecordDecl { ok: bool, err_start: u64, err_end: u64, name_start: u64, name_end: u64, fields: FieldList, decl_start: u64, decl_end: u64, cursor: u64 }
enum RecordList { RNil, RCons { head: RecordDecl, tail: RecordList } }
record Variant { name_start: u64, name_end: u64, fields: FieldList }
enum VariantList { VNil, VCons { head: Variant, tail: VariantList } }
record EnumDecl { ok: bool, err_start: u64, err_end: u64, name_start: u64, name_end: u64, variants: VariantList, decl_start: u64, decl_end: u64, cursor: u64 }
enum EnumList { GNil, GCons { head: EnumDecl, tail: EnumList } }

record Unit { ok: bool, err_start: u64, err_end: u64, header: parser.Header, uses: UseList, records: RecordList, enums: EnumList, fns: FnList, cursor: u64 }

enum Expr {
    Name { start: u64, end: u64 },
    Integer { start: u64, end: u64, value: u64, overflow: bool },
    Boolean { start: u64, end: u64, value: bool },
    Binary { op: u64, left: Expr, right: Expr, start: u64, end: u64 },
    Call { name_start: u64, name_end: u64, args: ExprList, start: u64, end: u64 },
    Project { base: Expr, field_start: u64, field_end: u64, start: u64, end: u64, path: bool }
}
enum ExprList { ENil, ECons { head: Expr, tail: ExprList } }
record ExprParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, node: Expr, start: u64, end: u64 }

// The language has no logical-negation operator, so predicates use this
// total helper (see CP-0004).
fn not(value: bool) -> (result: bool) {
    return select(value, false, true);
}

// Operator stack element. Real operators carry the token kind; markers use
// kind 1000 (parenthesized group) and 1001 (call with callee spans and the
// arguments collected so far, innermost-first).
record Op { kind: u64, argc: u64, name_start: u64, name_end: u64, args: ExprList }
enum OpList { ONil, OCons { head: Op, tail: OpList } }

// Shunting-yard state. expect_operand distinguishes a leading/continued
// operand position from an operator/delimiter position so lexical failures
// and EOF land on the same spans Stage-0 reports.
record ExprState { ok: bool, err_start: u64, err_end: u64, cursor: u64, operands: ExprList, operators: OpList, depth: u64, done: bool, expect_operand: bool }

fn expr_start(node: Expr) -> (result: u64) {
    return match node {
        Name { start: s, end: e } => s,
        Integer { start: s, end: e, value: v, overflow: o } => s,
        Boolean { start: s, end: e, value: v } => s,
        Binary { op: o, left: l, right: r, start: s, end: e } => s,
        Call { name_start: s, name_end: e, args: a, start: t, end: n } => t,
        Project { base: b, field_start: f, field_end: g, start: s, end: e, path: p } => s
    };
}
fn expr_end(node: Expr) -> (result: u64) {
    return match node {
        Name { start: s, end: e } => e,
        Integer { start: s, end: e, value: v, overflow: o } => e,
        Boolean { start: s, end: e, value: v } => e,
        Binary { op: o, left: l, right: r, start: s, end: e } => e,
        Call { name_start: s, name_end: e, args: a, start: t, end: n } => n,
        Project { base: b, field_start: f, field_end: g, start: s, end: e, path: p } => e
    };
}

// Stage-0 binary_operator precedence, keyed by our token kind. 0 means the
// token never continues a binary expression.
fn prec(kind: u64) -> (result: u64) {
    if kind == 83 { return 1; }
    if kind == 82 { return 2; }
    if kind == 56 { return 3; }
    if kind == 57 { return 4; }
    if kind == 55 { return 5; }
    if kind == 84 || kind == 85 { return 6; }
    if kind == 58 || kind == 86 || kind == 59 || kind == 87 { return 7; }
    if kind == 88 || kind == 89 { return 8; }
    if kind == 50 || kind == 51 || kind == 91 || kind == 92 || kind == 94 || kind == 95 { return 9; }
    if kind == 52 || kind == 93 || kind == 96 || kind == 53 || kind == 54 { return 10; }
    return 0;
}

fn is_operand_start(kind: u64) -> (result: bool) {
    return kind == 5 || kind == 4 || kind == 25 || kind == 38 || kind == 39;
}

// One directed action per fuel step: shift exactly one token, reduce exactly
// one operator, or stop/fail. Every action either consumes input, shrinks a
// stack, or terminates, so byte-count fuel always suffices.
fn parse_expr(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: ExprParse) {
    let seed: ExprState = ExprState { ok: true, err_start: 0, err_end: 0, cursor: cursor, operands: ExprList.ENil, operators: OpList.ONil, depth: 0, done: false, expect_operand: true };
    iterate ex0 over s0 carrying a: ExprState = seed {
        next a = expr_step(s0, s1, s2, s3, total, a);
    }
    iterate ex1 over s1 carrying b: ExprState = a {
        next b = expr_step(s0, s1, s2, s3, total, b);
    }
    iterate ex2 over s2 carrying c: ExprState = b {
        next c = expr_step(s0, s1, s2, s3, total, c);
    }
    iterate ex3 over s3 carrying d: ExprState = c {
        next d = expr_step(s0, s1, s2, s3, total, d);
    }
    iterate ex4 over s0 carrying e: ExprState = d {
        next e = expr_step(s0, s1, s2, s3, total, e);
    }
    iterate ex5 over s1 carrying f: ExprState = e {
        next f = expr_step(s0, s1, s2, s3, total, f);
    }
    iterate ex6 over s2 carrying g: ExprState = f {
        next g = expr_step(s0, s1, s2, s3, total, g);
    }
    iterate ex7 over s3 carrying h: ExprState = g {
        next h = expr_step(s0, s1, s2, s3, total, h);
    }
    iterate exc up_to 32 carrying i: ExprState = h {
        next i = expr_step(s0, s1, s2, s3, total, i);
    }
    return finish_expr(s0, s1, s2, s3, total, i);
}

fn expr_fail(st: ExprState, start: u64, end: u64) -> (result: ExprState) {
    return ExprState { ok: false, err_start: start, err_end: end, cursor: st.cursor, operands: st.operands, operators: st.operators, depth: st.depth, done: true, expect_operand: st.expect_operand };
}

fn expr_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState) -> (result: ExprState) {
    if not(st.ok) || st.done { return st; }
    let tok: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.cursor);
    if tok.diagnostic != 0 {
        if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
        return close_or_reduce(s0, s1, s2, s3, total, st, tok.start, tok.end);
    }
    if tok.kind == 0 {
        if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
        return close_or_reduce(s0, s1, s2, s3, total, st, tok.start, tok.end);
    }
    if is_operand_start(tok.kind) {
        if not(st.expect_operand) { return close_or_reduce(s0, s1, s2, s3, total, st, tok.start, tok.end); }
        return shift_operand(s0, s1, s2, s3, total, st, tok);
    }
    if tok.kind == 65 {
        if not(st.expect_operand) { return path_call(s0, s1, s2, s3, total, st, tok); }
        return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: st.operands, operators: OpList.OCons { head: Op { kind: 1000, argc: 0, name_start: 0, name_end: 0, args: ExprList.ENil }, tail: st.operators }, depth: st.depth + 1, done: false, expect_operand: true };
    }
    if tok.kind == 66 {
        return close_paren(s0, s1, s2, s3, total, st, tok);
    }
    if tok.kind == 64 {
        return comma_step(s0, s1, s2, s3, total, st, tok);
    }
    if tok.kind == 61 {
        return project_step(s0, s1, s2, s3, total, st, tok);
    }
    if prec(tok.kind) > 0 {
        return operator_step(st, tok);
    }
    return close_or_reduce(s0, s1, s2, s3, total, st, tok.start, tok.end);
}

// A delimiter (or a second operand, or a closing paren context): drain one
// pending operator, or finish when the stacks allow it.
fn close_or_reduce(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState, err_start: u64, err_end: u64) -> (result: ExprState) {
    if st.depth > 0 { return expr_fail(st, err_start, err_end); }
    return match st.operators {
        ONil => ExprState { ok: true, err_start: 0, err_end: 0, cursor: st.cursor, operands: st.operands, operators: st.operators, depth: st.depth, done: true, expect_operand: st.expect_operand },
        OCons { head: op, tail: rest } => reduce_or_fail(st, op, rest, err_start, err_end)
    };
}
fn reduce_or_fail(st: ExprState, op: Op, rest: OpList, err_start: u64, err_end: u64) -> (result: ExprState) {
    if op.kind >= 1000 { return expr_fail(st, err_start, err_end); }
    return reduce_one(st, op, rest, err_start, err_end);
}
fn reduce_one(st: ExprState, op: Op, rest: OpList, err_start: u64, err_end: u64) -> (result: ExprState) {
    return match st.operands {
        ENil => expr_fail(st, err_start, err_end),
        ECons { head: r, tail: t1 } => reduce_inner(st, op, rest, r, t1, err_start, err_end)
    };
}
fn reduce_inner(st: ExprState, op: Op, rest: OpList, r: Expr, t1: ExprList, err_start: u64, err_end: u64) -> (result: ExprState) {
    return match t1 {
        ENil => expr_fail(st, err_start, err_end),
        ECons { head: l, tail: t2 } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: st.cursor, operands: ExprList.ECons { head: Expr.Binary { op: op.kind, left: l, right: r, start: expr_start(l), end: expr_end(r) }, tail: t2 }, operators: rest, depth: st.depth, done: false, expect_operand: false }
    };
}

fn shift_operand(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    if tok.kind == 5 {
        let value: IntVal = int_value(s0, s1, s2, s3, total, tok.start, tok.end);
        let node: Expr = Expr.Integer { start: tok.start, end: tok.end, value: value.value, overflow: value.overflow };
        return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: st.operands }, operators: st.operators, depth: st.depth, done: false, expect_operand: false };
    }
    if tok.kind == 38 || tok.kind == 39 {
        let node: Expr = Expr.Boolean { start: tok.start, end: tok.end, value: tok.kind == 38 };
        return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: st.operands }, operators: st.operators, depth: st.depth, done: false, expect_operand: false };
    }
    let after: lexer.Token = segment.significant(s0, s1, s2, s3, total, tok.end);
    let node: Expr = Expr.Name { start: tok.start, end: tok.end };
    if after.diagnostic == 0 && after.kind == 65 {
        return ExprState { ok: true, err_start: 0, err_end: 0, cursor: after.end, operands: ExprList.ECons { head: node, tail: st.operands }, operators: OpList.OCons { head: Op { kind: 1001, argc: 0, name_start: tok.start, name_end: tok.end, args: ExprList.ENil }, tail: st.operators }, depth: st.depth + 1, done: false, expect_operand: true };
    }
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: st.operands }, operators: st.operators, depth: st.depth, done: false, expect_operand: false };
}

fn close_paren(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    return match st.operators {
        ONil => expr_fail(st, tok.start, tok.end),
        OCons { head: op, tail: rest } => close_paren_top(s0, s1, s2, s3, total, st, tok, op, rest)
    };
}
fn close_paren_top(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if op.kind < 1000 { return reduce_one(st, op, rest, tok.start, tok.end); }
    if op.kind == 1000 {
        if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
        return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: st.operands, operators: rest, depth: st.depth - 1, done: false, expect_operand: false };
    }
    return close_call(s0, s1, s2, s3, st, tok, op, rest);
}
fn close_call(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if st.expect_operand && op.argc != 0 { return expr_fail(st, tok.start, tok.end); }
    if st.expect_operand {
        let node: Expr = Expr.Call { name_start: op.name_start, name_end: op.name_end, args: ExprList.ENil, start: op.name_start, end: tok.end };
        return match st.operands {
            ENil => expr_fail(st, tok.start, tok.end),
            ECons { head: callee, tail: tail } => drop_callee(st, tok, rest, node, callee, tail)
        };
    }
    return match st.operands {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: last, tail: before } => close_call_args(s0, s1, s2, s3, st, tok, op, rest, last, before)
    };
}
fn close_call_args(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: ExprState, tok: lexer.Token, op: Op, rest: OpList, last: Expr, before: ExprList) -> (result: ExprState) {
    let args: ExprList = reverse_exprs(s0, s1, s2, s3, ExprList.ECons { head: last, tail: op.args });
    let node: Expr = Expr.Call { name_start: op.name_start, name_end: op.name_end, args: args, start: op.name_start, end: tok.end };
    return match before {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: callee, tail: tail } => drop_callee(st, tok, rest, node, callee, tail)
    };
}
// The callee name operand sits below its arguments by stack discipline;
// popping it here restores the single-value invariant. Anything else in
// that position is an internal caller error, reported at the paren.
fn drop_callee(st: ExprState, tok: lexer.Token, rest: OpList, node: Expr, callee: Expr, tail: ExprList) -> (result: ExprState) {
    return match callee {
        Name { start: s, end: e } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: tail }, operators: rest, depth: st.depth - 1, done: false, expect_operand: false },
        Integer { start: s, end: e, value: v, overflow: o } => expr_fail(st, tok.start, tok.end),
        Boolean { start: s, end: e, value: v } => expr_fail(st, tok.start, tok.end),
        Binary { op: o, left: l, right: r, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Call { name_start: s, name_end: e, args: a, start: t, end: n } => expr_fail(st, tok.start, tok.end),
        Project { base: b, field_start: f, field_end: g, start: s, end: e, path: p } => expr_fail(st, tok.start, tok.end)
    };
}

fn comma_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
    return match st.operators {
        ONil => expr_fail(st, tok.start, tok.end),
        OCons { head: op, tail: rest } => comma_top(s0, s1, s2, s3, total, st, tok, op, rest)
    };
}
fn comma_top(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if op.kind < 1000 { return reduce_one(st, op, rest, tok.start, tok.end); }
    if op.kind == 1001 {
        return match st.operands {
            ENil => expr_fail(st, tok.start, tok.end),
            ECons { head: arg, tail: before } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: before, operators: OpList.OCons { head: Op { kind: 1001, argc: op.argc + 1, name_start: op.name_start, name_end: op.name_end, args: ExprList.ECons { head: arg, tail: op.args } }, tail: rest }, depth: st.depth, done: false, expect_operand: true }
        };
    }
    return expr_fail(st, tok.start, tok.end);
}

fn project_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
    let field: lexer.Token = segment.significant(s0, s1, s2, s3, total, tok.end);
    if field.diagnostic != 0 || field.kind != 4 { return expr_fail(st, field.start, field.end); }
    return match st.operands {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: base, tail: before } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: field.end, operands: ExprList.ECons { head: Expr.Project { base: base, field_start: field.start, field_end: field.end, start: expr_start(base), end: field.end, path: base_is_path(base) }, tail: before }, operators: st.operators, depth: st.depth, done: false, expect_operand: false }
    };
}
// A projection continues a namespace path only over a bare name or a path
// projection. Anything else (calls, operators) ends the path, so a later
// paren stops the expression instead of forming a qualified call.
fn base_is_path(base: Expr) -> (result: bool) {
    return match base {
        Name { start: s, end: e } => true,
        Project { base: b, field_start: f, field_end: g, start: s, end: e, path: p } => p,
        Integer { start: s, end: e, value: v, overflow: o } => false,
        Boolean { start: s, end: e, value: v } => false,
        Binary { op: o, left: l, right: r, start: s, end: e } => false,
        Call { name_start: s, name_end: e, args: a, start: t, end: n } => false
    };
}
// A paren after a complete operand: a qualified call over a namespace path,
// or the end of the expression (Stage-0 rejects `(f)(1)` the same way).
fn path_call(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    return match st.operands {
        ENil => close_or_reduce(s0, s1, s2, s3, total, st, tok.start, tok.end),
        ECons { head: base, tail: before } => path_call_top(s0, s1, s2, s3, total, st, tok, base, before)
    };
}
fn path_call_top(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState, tok: lexer.Token, base: Expr, before: ExprList) -> (result: ExprState) {
    return match base {
        Name { start: s, end: e } => path_call_push(st, tok, s, e, before),
        Project { base: b, field_start: f, field_end: g, start: s, end: e, path: p } => path_call_project(s0, s1, s2, s3, total, st, tok, s, e, p, before),
        Integer { start: s, end: e, value: v, overflow: o } => close_or_reduce(s0, s1, s2, s3, total, st, tok.start, tok.end),
        Boolean { start: s, end: e, value: v } => close_or_reduce(s0, s1, s2, s3, total, st, tok.start, tok.end),
        Binary { op: o, left: l, right: r, start: s, end: e } => close_or_reduce(s0, s1, s2, s3, total, st, tok.start, tok.end),
        Call { name_start: s, name_end: e, args: a, start: t, end: n } => close_or_reduce(s0, s1, s2, s3, total, st, tok.start, tok.end)
    };
}
fn path_call_project(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState, tok: lexer.Token, start: u64, end: u64, path: bool, before: ExprList) -> (result: ExprState) {
    if path { return path_call_push(st, tok, start, end, before); }
    return close_or_reduce(s0, s1, s2, s3, total, st, tok.start, tok.end);
}
// The path span stands in for the callee operand so call closing keeps its
// single stack shape: the callee below the arguments is always a Name.
fn path_call_push(st: ExprState, tok: lexer.Token, start: u64, end: u64, before: ExprList) -> (result: ExprState) {
    let callee: Expr = Expr.Name { start: start, end: end };
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: callee, tail: before }, operators: OpList.OCons { head: Op { kind: 1001, argc: 0, name_start: start, name_end: end, args: ExprList.ENil }, tail: st.operators }, depth: st.depth + 1, done: false, expect_operand: true };
}

fn operator_step(st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
    return match st.operators {
        ONil => ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: st.operands, operators: OpList.OCons { head: Op { kind: tok.kind, argc: 0, name_start: 0, name_end: 0, args: ExprList.ENil }, tail: st.operators }, depth: st.depth, done: false, expect_operand: true },
        OCons { head: op, tail: rest } => operator_top(st, tok, op, rest)
    };
}
fn operator_top(st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if op.kind < 1000 && prec(op.kind) >= prec(tok.kind) { return reduce_one(st, op, rest, tok.start, tok.end); }
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: st.operands, operators: OpList.OCons { head: Op { kind: tok.kind, argc: 0, name_start: 0, name_end: 0, args: ExprList.ENil }, tail: st.operators }, depth: st.depth, done: false, expect_operand: true };
}

fn finish_expr(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ExprState) -> (result: ExprParse) {
    let bad: Expr = Expr.Name { start: st.cursor, end: st.cursor };
    if not(st.ok) { return ExprParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, node: bad, start: st.cursor, end: st.cursor }; }
    if not(st.done) { return ExprParse { cursor: st.cursor, ok: false, err_start: st.cursor, err_end: st.cursor, node: bad, start: st.cursor, end: st.cursor }; }
    return match st.operands {
        ENil => ExprParse { cursor: st.cursor, ok: false, err_start: st.cursor, err_end: st.cursor, node: bad, start: st.cursor, end: st.cursor },
        ECons { head: node, tail: rest } => finish_single(st, node, rest)
    };
}
fn finish_single(st: ExprState, node: Expr, rest: ExprList) -> (result: ExprParse) {
    return match rest {
        ENil => ExprParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, node: node, start: expr_start(node), end: expr_end(node) },
        ECons { head: extra, tail: more } => ExprParse { cursor: st.cursor, ok: false, err_start: expr_start(extra), err_end: expr_end(extra), node: node, start: st.cursor, end: st.cursor }
    };
}

// Argument/order restoration shared with declaration lists.
record ExprRev { rest: ExprList, acc: ExprList }
fn reverse_exprs(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: ExprList) -> (result: ExprList) {
    iterate vi0 over s0 carrying a: ExprRev = ExprRev { rest: list, acc: ExprList.ENil } {
        next a = reverse_exprs_step(a);
    }
    iterate vi1 over s1 carrying b: ExprRev = a {
        next b = reverse_exprs_step(b);
    }
    iterate vi2 over s2 carrying c: ExprRev = b {
        next c = reverse_exprs_step(c);
    }
    iterate vi3 over s3 carrying d: ExprRev = c {
        next d = reverse_exprs_step(d);
    }
    return d.acc;
}
fn reverse_exprs_step(st: ExprRev) -> (result: ExprRev) {
    return match st.rest { ENil => st, ECons { head: h, tail: t } => ExprRev { rest: t, acc: ExprList.ECons { head: h, tail: st.acc } } };
}

// Decimal literal accumulation with a pre-checked bound so checked
// arithmetic never traps: values at or beyond 2^64 set overflow instead.
record IntVal { value: u64, overflow: bool }
record IntAcc { value: u64, overflow: bool }
fn int_value(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64) -> (result: IntVal) {
    iterate ni0 over s0 carrying a: IntAcc = IntAcc { value: 0, overflow: false } {
        next a = int_step(total, start, end, a, ni0, source.byte_at(s0, ni0) as u64);
    }
    iterate ni1 over s1 carrying b: IntAcc = a {
        next b = int_step(total, start, end, b, s0.len + ni1, source.byte_at(s1, ni1) as u64);
    }
    iterate ni2 over s2 carrying c: IntAcc = b {
        next c = int_step(total, start, end, c, s0.len + s1.len + ni2, source.byte_at(s2, ni2) as u64);
    }
    iterate ni3 over s3 carrying d: IntAcc = c {
        next d = int_step(total, start, end, d, s0.len + s1.len + s2.len + ni3, source.byte_at(s3, ni3) as u64);
    }
    return IntVal { value: d.value, overflow: d.overflow };
}
fn int_step(total: u64, start: u64, end: u64, st: IntAcc, pos: u64, byte: u64) -> (result: IntAcc) {
    if pos < start || pos >= end { return st; }
    let digit: u64 = byte - 48;
    if st.value > 1844674407370955161 { return IntAcc { value: st.value, overflow: true }; }
    if st.value == 1844674407370955161 && digit > 5 { return IntAcc { value: st.value, overflow: true }; }
    return IntAcc { value: st.value * 10 + digit, overflow: st.overflow };
}

// Header fact twin of parser.header over absolute offsets. Identical state
// machine and error-spans-as-codes policy; codes match parser.Header.
fn header(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64) -> (result: parser.Header) {
    let seed: parser.Header = parser.Header { code: 0, start: 0, end: 0, version_start: 0, version_end: 0, module_start: 0, module_end: 0, next_offset: 0, state: 0 };
    if segment.ascii(s0, s1, s2, s3, total) {
        iterate hi0 over s0 carrying a: parser.Header = seed {
            next a = header_step(s0, s1, s2, s3, total, a);
        }
        iterate hi1 over s1 carrying b: parser.Header = a {
            next b = header_step(s0, s1, s2, s3, total, b);
        }
        iterate hi2 over s2 carrying c: parser.Header = b {
            next c = header_step(s0, s1, s2, s3, total, c);
        }
        iterate hi3 over s3 carrying d: parser.Header = c {
            next d = header_step(s0, s1, s2, s3, total, d);
        }
        return header_finish(s0, s1, s2, s3, total, d);
    }
    return parser.Header { ..seed, code: 8, end: total };
}
fn header_finish(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: parser.Header) -> (result: parser.Header) {
    if st.code != 0 || st.state == 8 { return st; }
    return header_step(s0, s1, s2, s3, total, st);
}
fn header_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: parser.Header) -> (result: parser.Header) {
    if st.code != 0 || st.state == 8 { return st; }
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.next_offset);
    if token.diagnostic != 0 { return parser.Header { ..st, code: 1, start: token.start, end: token.end }; }
    if st.state == 0 {
        if token.kind == 10 { return parser.Header { ..st, state: 1, next_offset: token.end }; }
        return parser.Header { ..st, code: 2, start: token.start, end: token.end };
    }
    if st.state == 1 {
        if token.kind == 6 { return parser.Header { ..st, state: 2, next_offset: token.end, version_start: token.start, version_end: token.end }; }
        return parser.Header { ..st, code: 3, start: token.start, end: token.end };
    }
    if st.state == 2 {
        if token.kind == 63 { return parser.Header { ..st, state: 3, next_offset: token.end }; }
        return parser.Header { ..st, code: 4, start: token.start, end: token.end };
    }
    if st.state == 3 {
        if token.kind == 11 { return parser.Header { ..st, state: 4, next_offset: token.end }; }
        return parser.Header { ..st, code: 5, start: token.start, end: token.end };
    }
    if st.state == 4 || st.state == 6 {
        if token.kind == 4 || token.kind == 10 { return parser.Header { ..st, state: 5, next_offset: token.end, module_start: select(st.state == 4, token.start, st.module_start), module_end: token.end }; }
        return parser.Header { ..st, code: 6, start: token.start, end: token.end };
    }
    if token.kind == 61 { return parser.Header { ..st, state: 6, next_offset: token.end }; }
    if token.kind == 63 { return parser.Header { ..st, state: 8, next_offset: token.end }; }
    return parser.Header { ..st, code: 7, start: token.start, end: token.end };
}

// A term-level name: identifier (4) or the capability keyword (25) used as
// an identifier. Mirrors Stage-0 value_name positions.
fn is_value_name(kind: u64) -> (result: bool) {
    return kind == 4 || kind == 25;
}

// Expect the significant token at cursor to have the wanted kind. Returns
// the token end on success; on failure ok is false and the span is the
// offending (or EOF) token, mirroring Stage-0 expect() spans.
record Expect { cursor: u64, ok: bool, err_start: u64, err_end: u64, tok_start: u64, tok_end: u64 }
fn expect(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64, want: u64) -> (result: Expect) {
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, cursor);
    if token.diagnostic != 0 { return Expect { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, tok_start: token.start, tok_end: token.end }; }
    if token.kind == want { return Expect { cursor: token.end, ok: true, err_start: 0, err_end: 0, tok_start: token.start, tok_end: token.end }; }
    return Expect { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, tok_start: token.start, tok_end: token.end };
}

// Parse one name token. mode 0 requires an identifier; mode 1 also accepts
// the capability keyword in value positions.
record NameParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, start: u64, end: u64 }
fn parse_name(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64, mode: u64) -> (result: NameParse) {
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, cursor);
    if token.diagnostic != 0 { return NameParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, start: token.start, end: token.end }; }
    if token.kind == 4 || (mode == 1 && token.kind == 25) {
        return NameParse { cursor: token.end, ok: true, err_start: 0, err_end: 0, start: token.start, end: token.end };
    }
    return NameParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, start: token.start, end: token.end };
}

// Type spelling. Sequences nest via the same function for the element type;
// the returned span covers the whole spelling for later text comparison.
fn parse_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: TypeParse) {
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, cursor);
    if token.diagnostic != 0 { return TypeParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: TypeRef { kind: 0, start: cursor, end: cursor } }; }
    if token.kind == 69 {
        return parse_seq_type(s0, s1, s2, s3, total, token.start, token.end);
    }
    if token.kind == 4 {
        return parse_flat_type(s0, s1, s2, s3, total, token.start, token.end);
    }
    return TypeParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: TypeRef { kind: 0, start: cursor, end: cursor } };
}

fn scalar_kind(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64) -> (result: u64) {
    if end - start == 3 {
        if segment.byte_at(s0, s1, s2, s3, total, start) == 117 && segment.byte_at(s0, s1, s2, s3, total, start + 1) == 54 && segment.byte_at(s0, s1, s2, s3, total, start + 2) == 52 { return 1; }
    }
    if end - start == 3 {
        if segment.byte_at(s0, s1, s2, s3, total, start) == 105 && segment.byte_at(s0, s1, s2, s3, total, start + 1) == 54 && segment.byte_at(s0, s1, s2, s3, total, start + 2) == 52 { return 2; }
    }
    if end - start == 4 {
        if segment.byte_at(s0, s1, s2, s3, total, start) == 98 && segment.byte_at(s0, s1, s2, s3, total, start + 1) == 111 && segment.byte_at(s0, s1, s2, s3, total, start + 2) == 111 && segment.byte_at(s0, s1, s2, s3, total, start + 3) == 108 { return 3; }
    }
    if end - start == 4 {
        if segment.byte_at(s0, s1, s2, s3, total, start) == 98 && segment.byte_at(s0, s1, s2, s3, total, start + 1) == 121 && segment.byte_at(s0, s1, s2, s3, total, start + 2) == 116 && segment.byte_at(s0, s1, s2, s3, total, start + 3) == 101 { return 4; }
    }
    return 5;
}

// Flat (non-sequence) type: identifier with optional qualification. Sequence
// element types nest at most one level deep through here: genuinely nested
// sequence spellings are a deferred shape (explicit local error at the inner
// `[`), because mutual parser recursion is unavailable. See parse_seq_type.
fn parse_flat_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, cursor: u64) -> (result: TypeParse) {
    iterate ti0 over s0 carrying a: TypeParse = TypeParse { cursor: cursor, ok: true, err_start: 0, err_end: 0, node: TypeRef { kind: 0, start: start, end: cursor } } {
        next a = qualified_step(s0, s1, s2, s3, total, a);
    }
    iterate ti1 over s1 carrying b: TypeParse = a {
        next b = qualified_step(s0, s1, s2, s3, total, b);
    }
    iterate ti2 over s2 carrying c: TypeParse = b {
        next c = qualified_step(s0, s1, s2, s3, total, c);
    }
    iterate ti3 over s3 carrying d: TypeParse = c {
        next d = qualified_step(s0, s1, s2, s3, total, d);
    }
    return finish_named_type(s0, s1, s2, s3, total, start, d);
}
fn qualified_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: TypeParse) -> (result: TypeParse) {
    if not(st.ok) { return st; }
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.cursor);
    if token.diagnostic != 0 || token.kind != 61 { return st; }
    let name: NameParse = parse_name(s0, s1, s2, s3, total, token.end, 0);
    if not(name.ok) { return TypeParse { cursor: st.cursor, ok: false, err_start: name.err_start, err_end: name.err_end, node: st.node }; }
    return TypeParse { cursor: name.cursor, ok: true, err_start: 0, err_end: 0, node: TypeRef { kind: 6, start: st.node.start, end: name.end } };
}
fn finish_named_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, st: TypeParse) -> (result: TypeParse) {
    if not(st.ok) {
        return TypeParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, node: TypeRef { kind: 0, start: start, end: start } };
    }
    if st.node.kind == 6 {
        return TypeParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, node: TypeRef { kind: 6, start: start, end: st.node.end } };
    }
    let kind: u64 = scalar_kind(s0, s1, s2, s3, total, start, st.node.end);
    return TypeParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, node: TypeRef { kind: kind, start: start, end: st.node.end } };
}

// Exact `[T; N]` and viewed `[T; up_to N]` spellings. Bounds may be integer
// literals or Nat identifiers in profile 0.10; only the span is retained
// because index/select expressions are deferred.
fn parse_seq_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, bracket: u64, cursor: u64) -> (result: TypeParse) {
    let bad: TypeRef = TypeRef { kind: 0, start: cursor, end: cursor };
    let elem: TypeParse = parse_seq_elem(s0, s1, s2, s3, total, cursor);
    if not(elem.ok) { return TypeParse { cursor: cursor, ok: false, err_start: elem.err_start, err_end: elem.err_end, node: bad }; }
    let semi: Expect = expect(s0, s1, s2, s3, total, elem.cursor, 63);
    if not(semi.ok) { return TypeParse { cursor: cursor, ok: false, err_start: semi.err_start, err_end: semi.err_end, node: bad }; }
    let bound: NameParse = seq_bound(s0, s1, s2, s3, total, semi.cursor);
    if not(bound.ok) { return TypeParse { cursor: cursor, ok: false, err_start: bound.err_start, err_end: bound.err_end, node: bad }; }
    let close: Expect = expect(s0, s1, s2, s3, total, bound.cursor, 70);
    if not(close.ok) { return TypeParse { cursor: cursor, ok: false, err_start: close.err_start, err_end: close.err_end, node: bad }; }
    let viewed: bool = is_up_to_bound(s0, s1, s2, s3, total, bound.start, bound.end);
    return TypeParse { cursor: close.cursor, ok: true, err_start: 0, err_end: 0, node: TypeRef { kind: select(viewed, 8, 7), start: bracket, end: close.cursor } };
}
// A viewed bound starts with the `up_to` keyword plus a space. A bare Nat
// identifier can never equal the keyword (it lexes as kind 32), and a longer
// identifier starting with those bytes has a non-space sixth byte.
fn is_up_to_bound(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64) -> (result: bool) {
    if end - start < 6 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, start) != 117 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, start + 1) != 112 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, start + 2) != 95 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, start + 3) != 116 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, start + 4) != 111 { return false; }
    if not(lexer.space(segment.byte_at(s0, s1, s2, s3, total, start + 5))) { return false; }
    return true;
}

// A sequence bound is `up_to` plus a literal/identifier, or a bare literal
// or Nat identifier. Returns the bound span; viewed-ness is re-derived by
// the caller from the leading byte ('u' == 117).
fn seq_bound(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: NameParse) {
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, cursor);
    if token.diagnostic != 0 { return NameParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, start: token.start, end: token.end }; }
    if token.kind == 32 {
        let cap: lexer.Token = segment.significant(s0, s1, s2, s3, total, token.end);
        if cap.diagnostic != 0 { return NameParse { cursor: cursor, ok: false, err_start: cap.start, err_end: cap.end, start: cap.start, end: cap.end }; }
        if cap.kind == 5 || cap.kind == 4 {
            return NameParse { cursor: cap.end, ok: true, err_start: 0, err_end: 0, start: token.start, end: cap.end };
        }
        return NameParse { cursor: cursor, ok: false, err_start: cap.start, err_end: cap.end, start: cap.start, end: cap.end };
    }
    if token.kind == 5 || token.kind == 4 {
        return NameParse { cursor: token.end, ok: true, err_start: 0, err_end: 0, start: token.start, end: token.end };
    }
    return NameParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, start: token.start, end: token.end };
}

// Shared name:type list for parameters, results, record fields, and payload
// fields. closer is the terminating kind (66 ')' or 68 '}'); name_mode 0
// requires identifiers, 1 also accepts `capability` in value positions.
fn parse_fields(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64, closer: u64, name_mode: u64) -> (result: FieldsParse) {
    iterate fi0 over s0 carrying a: FieldsParse = FieldsParse { cursor: cursor, ok: true, err_start: 0, err_end: 0, list: FieldList.FNil } {
        next a = fields_step(s0, s1, s2, s3, total, a, closer, name_mode);
    }
    iterate fi1 over s1 carrying b: FieldsParse = a {
        next b = fields_step(s0, s1, s2, s3, total, b, closer, name_mode);
    }
    iterate fi2 over s2 carrying c: FieldsParse = b {
        next c = fields_step(s0, s1, s2, s3, total, c, closer, name_mode);
    }
    iterate fi3 over s3 carrying d: FieldsParse = c {
        next d = fields_step(s0, s1, s2, s3, total, d, closer, name_mode);
    }
    return finish_fields(s0, s1, s2, s3, d);
}
fn fields_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: FieldsParse, closer: u64, name_mode: u64) -> (result: FieldsParse) {
    if not(st.ok) { return st; }
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.cursor);
    if token.diagnostic != 0 || token.kind == closer || (not(is_value_name(token.kind)) && token.kind != 4) { return st; }
    if token.kind != 4 && not(name_mode == 1 && token.kind == 25) { return st; }
    let name: NameParse = parse_name(s0, s1, s2, s3, total, st.cursor, name_mode);
    if not(name.ok) { return FieldsParse { cursor: st.cursor, ok: false, err_start: name.err_start, err_end: name.err_end, list: st.list }; }
    let colon: Expect = expect(s0, s1, s2, s3, total, name.cursor, 62);
    if not(colon.ok) { return FieldsParse { cursor: st.cursor, ok: false, err_start: colon.err_start, err_end: colon.err_end, list: st.list }; }
    let ftype: TypeParse = parse_type(s0, s1, s2, s3, total, colon.cursor);
    if not(ftype.ok) { return FieldsParse { cursor: st.cursor, ok: false, err_start: ftype.err_start, err_end: ftype.err_end, list: st.list }; }
    let field: Field = Field { name_start: name.start, name_end: name.end, type_start: ftype.node.start, type_end: ftype.node.end, type_kind: ftype.node.kind };
    let comma: lexer.Token = segment.significant(s0, s1, s2, s3, total, ftype.cursor);
    if comma.diagnostic == 0 && comma.kind == 64 {
        return FieldsParse { cursor: comma.end, ok: true, err_start: 0, err_end: 0, list: FieldList.FCons { head: field, tail: st.list } };
    }
    return FieldsParse { cursor: ftype.cursor, ok: true, err_start: 0, err_end: 0, list: FieldList.FCons { head: field, tail: st.list } };
}
// Element spellings nest at most one level: a flat type, or an explicit
// local error on a nested `[`. Keeps the type parser acyclic.
fn parse_seq_elem(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: TypeParse) {
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, cursor);
    if token.diagnostic == 0 && token.kind == 69 {
        return TypeParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: TypeRef { kind: 0, start: cursor, end: cursor } };
    }
    if token.diagnostic == 0 && token.kind == 4 {
        return parse_flat_type(s0, s1, s2, s3, total, token.start, token.end);
    }
    if token.diagnostic != 0 {
        return TypeParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: TypeRef { kind: 0, start: cursor, end: cursor } };
    }
    return TypeParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: TypeRef { kind: 0, start: cursor, end: cursor } };
}
fn finish_fields(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: FieldsParse) -> (result: FieldsParse) {
    return FieldsParse { cursor: st.cursor, ok: st.ok, err_start: st.err_start, err_end: st.err_end, list: reverse_fields(s0, s1, s2, s3, st.list) };
}
// Reversal by fuel loop (parser recursion is unavailable): each step pops
// one cell, so the four chunk traversals always suffice.
record FieldRev { rest: FieldList, acc: FieldList }
fn reverse_fields(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: FieldList) -> (result: FieldList) {
    iterate ri0 over s0 carrying a: FieldRev = FieldRev { rest: list, acc: FieldList.FNil } {
        next a = reverse_fields_step(a);
    }
    iterate ri1 over s1 carrying b: FieldRev = a {
        next b = reverse_fields_step(b);
    }
    iterate ri2 over s2 carrying c: FieldRev = b {
        next c = reverse_fields_step(c);
    }
    iterate ri3 over s3 carrying d: FieldRev = c {
        next d = reverse_fields_step(d);
    }
    return d.acc;
}
fn reverse_fields_step(st: FieldRev) -> (result: FieldRev) {
    return match st.rest { FNil => st, FCons { head: h, tail: t } => FieldRev { rest: t, acc: FieldList.FCons { head: h, tail: st.acc } } };
}

// `use a.b.c [as alias];`. Segments accept identifiers and the `mncs`
// keyword so standard paths keep parsing; alias requires an identifier.
fn parse_use(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: UseDecl) {
    let bad: UseDecl = UseDecl { ok: false, err_start: cursor, err_end: cursor, module_start: cursor, module_end: cursor, alias_start: 0, alias_end: 0, has_alias: false, cursor: cursor };
    let path: NameParse = parse_module_path(s0, s1, s2, s3, total, cursor);
    if not(path.ok) { return UseDecl { ..bad, err_start: path.err_start, err_end: path.err_end }; }
    let alias: NameParse = parse_use_alias(s0, s1, s2, s3, total, path.cursor);
    if not(alias.ok) { return UseDecl { ..bad, module_start: path.start, module_end: path.end, err_start: alias.err_start, err_end: alias.err_end }; }
    let semi: Expect = expect(s0, s1, s2, s3, total, alias.cursor, 63);
    if not(semi.ok) { return UseDecl { ..bad, module_start: path.start, module_end: path.end, err_start: semi.err_start, err_end: semi.err_end }; }
    return UseDecl { ok: true, err_start: 0, err_end: 0, module_start: path.start, module_end: path.end, alias_start: alias.start, alias_end: alias.end, has_alias: alias.start != alias.end, cursor: semi.cursor };
}
fn parse_module_path(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: NameParse) {
    let first: lexer.Token = segment.significant(s0, s1, s2, s3, total, cursor);
    if first.diagnostic != 0 || (first.kind != 4 && first.kind != 10) {
        return NameParse { cursor: cursor, ok: false, err_start: first.start, err_end: first.end, start: cursor, end: cursor };
    }
    iterate pi0 over s0 carrying a: NameParse = NameParse { cursor: first.end, ok: true, err_start: 0, err_end: 0, start: first.start, end: first.end } {
        next a = path_step(s0, s1, s2, s3, total, a);
    }
    iterate pi1 over s1 carrying b: NameParse = a {
        next b = path_step(s0, s1, s2, s3, total, b);
    }
    iterate pi2 over s2 carrying c: NameParse = b {
        next c = path_step(s0, s1, s2, s3, total, c);
    }
    iterate pi3 over s3 carrying d: NameParse = c {
        next d = path_step(s0, s1, s2, s3, total, d);
    }
    return d;
}
fn path_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: NameParse) -> (result: NameParse) {
    if not(st.ok) { return st; }
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.cursor);
    if token.diagnostic != 0 || token.kind != 61 { return st; }
    let seg: lexer.Token = segment.significant(s0, s1, s2, s3, total, token.end);
    if seg.diagnostic != 0 || (seg.kind != 4 && seg.kind != 10) {
        return NameParse { cursor: st.cursor, ok: false, err_start: seg.start, err_end: seg.end, start: st.start, end: st.end };
    }
    return NameParse { cursor: seg.end, ok: true, err_start: 0, err_end: 0, start: st.start, end: seg.end };
}
fn parse_use_alias(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: NameParse) {
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, cursor);
    if token.diagnostic != 0 || token.kind != 36 {
        return NameParse { cursor: cursor, ok: true, err_start: 0, err_end: 0, start: cursor, end: cursor };
    }
    return parse_name(s0, s1, s2, s3, total, token.end, 0);
}

// `record Name { fields }`. At least one field is required.
fn parse_record(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64, start: u64) -> (result: RecordDecl) {
    let bad: RecordDecl = RecordDecl { ok: false, err_start: cursor, err_end: cursor, name_start: cursor, name_end: cursor, fields: FieldList.FNil, decl_start: start, decl_end: cursor, cursor: cursor };
    let name: NameParse = parse_name(s0, s1, s2, s3, total, cursor, 0);
    if not(name.ok) { return RecordDecl { ..bad, err_start: name.err_start, err_end: name.err_end }; }
    let open: Expect = expect(s0, s1, s2, s3, total, name.cursor, 67);
    if not(open.ok) { return RecordDecl { ..bad, name_start: name.start, name_end: name.end, err_start: open.err_start, err_end: open.err_end }; }
    let fields: FieldsParse = parse_fields(s0, s1, s2, s3, total, open.cursor, 68, 0);
    if not(fields.ok) { return RecordDecl { ..bad, name_start: name.start, name_end: name.end, err_start: fields.err_start, err_end: fields.err_end }; }
    // An empty body reports at the token AFTER the closing brace (or the
    // missing-brace span when `}` is absent), mirroring Stage-0 MNP128.
    if fields.cursor == open.cursor {
        let empty_close: Expect = expect(s0, s1, s2, s3, total, open.cursor, 68);
        if not(empty_close.ok) { return RecordDecl { ..bad, name_start: name.start, name_end: name.end, err_start: empty_close.err_start, err_end: empty_close.err_end }; }
        let at: lexer.Token = segment.significant(s0, s1, s2, s3, total, empty_close.cursor);
        return RecordDecl { ..bad, name_start: name.start, name_end: name.end, err_start: at.start, err_end: at.end };
    }
    let close: Expect = expect(s0, s1, s2, s3, total, fields.cursor, 68);
    if not(close.ok) { return RecordDecl { ..bad, name_start: name.start, name_end: name.end, err_start: close.err_start, err_end: close.err_end }; }
    return RecordDecl { ok: true, err_start: 0, err_end: 0, name_start: name.start, name_end: name.end, fields: fields.list, decl_start: start, decl_end: close.cursor, cursor: close.cursor };
}

// `enum Name { variants }` with optional `{ field: Type, ... }` payloads.
// At least one variant is required; variant names are strict identifiers.
fn parse_enum(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64, start: u64) -> (result: EnumDecl) {
    let bad: EnumDecl = EnumDecl { ok: false, err_start: cursor, err_end: cursor, name_start: cursor, name_end: cursor, variants: VariantList.VNil, decl_start: start, decl_end: cursor, cursor: cursor };
    let name: NameParse = parse_name(s0, s1, s2, s3, total, cursor, 0);
    if not(name.ok) { return EnumDecl { ..bad, err_start: name.err_start, err_end: name.err_end }; }
    let open: Expect = expect(s0, s1, s2, s3, total, name.cursor, 67);
    if not(open.ok) { return EnumDecl { ..bad, name_start: name.start, name_end: name.end, err_start: open.err_start, err_end: open.err_end }; }
    let variants: VariantsParse = parse_variants(s0, s1, s2, s3, total, open.cursor);
    if not(variants.ok) { return EnumDecl { ..bad, name_start: name.start, name_end: name.end, err_start: variants.err_start, err_end: variants.err_end }; }
    let close: Expect = expect(s0, s1, s2, s3, total, variants.cursor, 68);
    if not(close.ok) { return EnumDecl { ..bad, name_start: name.start, name_end: name.end, err_start: close.err_start, err_end: close.err_end }; }
    return EnumDecl { ok: true, err_start: 0, err_end: 0, name_start: name.start, name_end: name.end, variants: variants.list, decl_start: start, decl_end: close.cursor, cursor: close.cursor };
}
record VariantsParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: VariantList }
record VariantsState { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: VariantList, done: bool }
fn parse_variants(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: VariantsParse) {
    iterate ni0 over s0 carrying a: VariantsState = VariantsState { cursor: cursor, ok: true, err_start: 0, err_end: 0, list: VariantList.VNil, done: false } {
        next a = variants_step(s0, s1, s2, s3, total, a);
    }
    iterate ni1 over s1 carrying b: VariantsState = a {
        next b = variants_step(s0, s1, s2, s3, total, b);
    }
    iterate ni2 over s2 carrying c: VariantsState = b {
        next c = variants_step(s0, s1, s2, s3, total, c);
    }
    iterate ni3 over s3 carrying d: VariantsState = c {
        next d = variants_step(s0, s1, s2, s3, total, d);
    }
    return finish_variants(s0, s1, s2, s3, total, d);
}
fn variants_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: VariantsState) -> (result: VariantsState) {
    if not(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.cursor);
    if token.diagnostic != 0 || token.kind != 4 { return VariantsState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: st.list, done: true }; }
    let name: NameParse = parse_name(s0, s1, s2, s3, total, st.cursor, 0);
    if not(name.ok) { return VariantsState { cursor: st.cursor, ok: false, err_start: name.err_start, err_end: name.err_end, list: st.list, done: true }; }
    let payload: FieldsParse = parse_variant_payload(s0, s1, s2, s3, total, name.cursor);
    if not(payload.ok) { return VariantsState { cursor: st.cursor, ok: false, err_start: payload.err_start, err_end: payload.err_end, list: st.list, done: true }; }
    let variant: Variant = Variant { name_start: name.start, name_end: name.end, fields: payload.list };
    let comma: lexer.Token = segment.significant(s0, s1, s2, s3, total, payload.cursor);
    if comma.diagnostic == 0 && comma.kind == 64 {
        return VariantsState { cursor: comma.end, ok: true, err_start: 0, err_end: 0, list: VariantList.VCons { head: variant, tail: st.list }, done: false };
    }
    return VariantsState { cursor: payload.cursor, ok: true, err_start: 0, err_end: 0, list: VariantList.VCons { head: variant, tail: st.list }, done: false };
}
fn parse_variant_payload(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: FieldsParse) {
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, cursor);
    if token.diagnostic != 0 || token.kind != 67 {
        return FieldsParse { cursor: cursor, ok: true, err_start: 0, err_end: 0, list: FieldList.FNil };
    }
    let fields: FieldsParse = parse_fields(s0, s1, s2, s3, total, token.end, 68, 0);
    if not(fields.ok) { return fields; }
    let close: Expect = expect(s0, s1, s2, s3, total, fields.cursor, 68);
    if not(close.ok) { return FieldsParse { cursor: cursor, ok: false, err_start: close.err_start, err_end: close.err_end, list: FieldList.FNil }; }
    return FieldsParse { cursor: close.cursor, ok: true, err_start: 0, err_end: 0, list: fields.list };
}
fn finish_variants(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: VariantsState) -> (result: VariantsParse) {
    if not(st.ok) { return VariantsParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, list: VariantList.VNil }; }
    return match st.list {
        VNil => finish_variants_empty(s0, s1, s2, s3, total, st),
        VCons { head: h, tail: t } => VariantsParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: reverse_variants(s0, s1, s2, s3, st.list) }
    };
}
fn finish_variants_empty(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: VariantsState) -> (result: VariantsParse) {
    // Empty variant lists report after the closing brace like records
    // (Stage-0 MNP075); a missing brace reports at its own span (MNP074).
    let empty_close: Expect = expect(s0, s1, s2, s3, total, st.cursor, 68);
    if not(empty_close.ok) { return VariantsParse { cursor: st.cursor, ok: false, err_start: empty_close.err_start, err_end: empty_close.err_end, list: VariantList.VNil }; }
    let at: lexer.Token = segment.significant(s0, s1, s2, s3, total, empty_close.cursor);
    return VariantsParse { cursor: st.cursor, ok: false, err_start: at.start, err_end: at.end, list: VariantList.VNil };
}
record VariantRev { rest: VariantList, acc: VariantList }
fn reverse_variants(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: VariantList) -> (result: VariantList) {
    iterate qi0 over s0 carrying a: VariantRev = VariantRev { rest: list, acc: VariantList.VNil } {
        next a = reverse_variants_step(a);
    }
    iterate qi1 over s1 carrying b: VariantRev = a {
        next b = reverse_variants_step(b);
    }
    iterate qi2 over s2 carrying c: VariantRev = b {
        next c = reverse_variants_step(c);
    }
    iterate qi3 over s3 carrying d: VariantRev = c {
        next d = reverse_variants_step(d);
    }
    return d.acc;
}
fn reverse_variants_step(st: VariantRev) -> (result: VariantRev) {
    return match st.rest { VNil => st, VCons { head: h, tail: t } => VariantRev { rest: t, acc: VariantList.VCons { head: h, tail: st.acc } } };
}

// Statements. `return` parses as a statement for branch bodies; the top
// body loop stops at `return` itself so mid-body returns keep failing
// exactly where Stage-0 reports them.
fn parse_stmt(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: StmtParse) {
    let bad: Stmt = Stmt.Fail { mode_start: cursor, mode_end: cursor, start: cursor, end: cursor };
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, cursor);
    if token.diagnostic != 0 { return StmtParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad }; }
    if token.kind == 14 { return parse_let(s0, s1, s2, s3, total, token.end); }
    if token.kind == 15 { return StmtParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad }; }
    if token.kind == 17 { return parse_fail_stmt(s0, s1, s2, s3, total, token.end); }
    if token.kind == 13 { return parse_return_stmt(s0, s1, s2, s3, total, token.end); }
    if token.kind == 31 { return StmtParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad }; }
    if token.kind == 37 { return StmtParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad }; }
    return StmtParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad };
}
fn parse_let(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: StmtParse) {
    let bad: Stmt = Stmt.Fail { mode_start: cursor, mode_end: cursor, start: cursor, end: cursor };
    let name: NameParse = parse_name(s0, s1, s2, s3, total, cursor, 1);
    if not(name.ok) { return StmtParse { cursor: cursor, ok: false, err_start: name.err_start, err_end: name.err_end, node: bad }; }
    let colon: Expect = expect(s0, s1, s2, s3, total, name.cursor, 62);
    if not(colon.ok) { return StmtParse { cursor: cursor, ok: false, err_start: colon.err_start, err_end: colon.err_end, node: bad }; }
    let ftype: TypeParse = parse_type(s0, s1, s2, s3, total, colon.cursor);
    if not(ftype.ok) { return StmtParse { cursor: cursor, ok: false, err_start: ftype.err_start, err_end: ftype.err_end, node: bad }; }
    let eq: Expect = expect(s0, s1, s2, s3, total, ftype.cursor, 60);
    if not(eq.ok) { return StmtParse { cursor: cursor, ok: false, err_start: eq.err_start, err_end: eq.err_end, node: bad }; }
    let value: ExprParse = parse_expr(s0, s1, s2, s3, total, eq.cursor);
    if not(value.ok) { return StmtParse { cursor: cursor, ok: false, err_start: value.err_start, err_end: value.err_end, node: bad }; }
    let semi: Expect = expect(s0, s1, s2, s3, total, value.cursor, 63);
    if not(semi.ok) { return StmtParse { cursor: cursor, ok: false, err_start: semi.err_start, err_end: semi.err_end, node: bad }; }
    let node: Stmt = Stmt.Let { name_start: name.start, name_end: name.end, type_start: ftype.node.start, type_end: ftype.node.end, type_kind: ftype.node.kind, value: value.node, start: name.start, end: value.end };
    return StmtParse { cursor: semi.cursor, ok: true, err_start: 0, err_end: 0, node: node };
}
fn parse_fail_stmt(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: StmtParse) {
    let bad: Stmt = Stmt.Fail { mode_start: cursor, mode_end: cursor, start: cursor, end: cursor };
    let mode: NameParse = parse_name(s0, s1, s2, s3, total, cursor, 0);
    if not(mode.ok) { return StmtParse { cursor: cursor, ok: false, err_start: mode.err_start, err_end: mode.err_end, node: bad }; }
    let semi: Expect = expect(s0, s1, s2, s3, total, mode.cursor, 63);
    if not(semi.ok) { return StmtParse { cursor: cursor, ok: false, err_start: semi.err_start, err_end: semi.err_end, node: bad }; }
    let node: Stmt = Stmt.Fail { mode_start: mode.start, mode_end: mode.end, start: mode.start, end: mode.end };
    return StmtParse { cursor: semi.cursor, ok: true, err_start: 0, err_end: 0, node: node };
}
fn parse_return_stmt(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: StmtParse) {
    let bad: Stmt = Stmt.Fail { mode_start: cursor, mode_end: cursor, start: cursor, end: cursor };
    let value: ExprParse = parse_expr(s0, s1, s2, s3, total, cursor);
    if not(value.ok) { return StmtParse { cursor: cursor, ok: false, err_start: value.err_start, err_end: value.err_end, node: bad }; }
    let semi: Expect = expect(s0, s1, s2, s3, total, value.cursor, 63);
    if not(semi.ok) { return StmtParse { cursor: cursor, ok: false, err_start: semi.err_start, err_end: semi.err_end, node: bad }; }
    let node: Stmt = Stmt.Return { value: value.node, start: value.start, end: value.end };
    return StmtParse { cursor: semi.cursor, ok: true, err_start: 0, err_end: 0, node: node };
}
// Statement blocks with arbitrarily nested `if`/`else`, parsed by one
// iterative machine over an explicit frame stack (statement recursion is
// unavailable). mode 0 is a branch block: `return` parses as a statement.
// mode 1 is a top body block: the machine stops at `return` so the body
// tail owns it, which keeps mid-body returns failing exactly where
// Stage-0 reports them. Lists come out in source order.
record BranchParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: StmtList }
record Frame { cond: Expr, cond_start: u64, cond_end: u64, then_list: StmtList, parent: StmtList, phase: u64 }
enum FrameList { YNil, YCons { head: Frame, tail: FrameList } }
record BlockState { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: StmtList, frames: FrameList, done: bool, mode: u64 }
fn parse_branch(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: BranchParse) {
    return parse_stmts(s0, s1, s2, s3, total, cursor, 0);
}
fn parse_stmts(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64, mode: u64) -> (result: BranchParse) {
    iterate bi0 over s0 carrying a: BlockState = BlockState { cursor: cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SNil, frames: FrameList.YNil, done: false, mode: mode } {
        next a = block_step(s0, s1, s2, s3, total, a);
    }
    iterate bi1 over s1 carrying b: BlockState = a {
        next b = block_step(s0, s1, s2, s3, total, b);
    }
    iterate bi2 over s2 carrying c: BlockState = b {
        next c = block_step(s0, s1, s2, s3, total, c);
    }
    iterate bi3 over s3 carrying d: BlockState = c {
        next d = block_step(s0, s1, s2, s3, total, d);
    }
    iterate bi4 over s0 carrying e: BlockState = d {
        next e = block_step(s0, s1, s2, s3, total, e);
    }
    iterate bi5 over s1 carrying f: BlockState = e {
        next f = block_step(s0, s1, s2, s3, total, f);
    }
    iterate bi6 over s2 carrying g: BlockState = f {
        next g = block_step(s0, s1, s2, s3, total, g);
    }
    iterate bi7 over s3 carrying h: BlockState = g {
        next h = block_step(s0, s1, s2, s3, total, h);
    }
    return finish_block(s0, s1, s2, s3, h);
}
fn block_fail(st: BlockState, start: u64, end: u64) -> (result: BlockState) {
    return BlockState { cursor: st.cursor, ok: false, err_start: start, err_end: end, list: st.list, frames: st.frames, done: true, mode: st.mode };
}
fn block_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: BlockState) -> (result: BlockState) {
    if not(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.cursor);
    if token.diagnostic != 0 { return block_fail(st, token.start, token.end); }
    if token.kind == 0 { return block_eof(s0, s1, s2, s3, total, st, token); }
    if token.kind == 68 { return block_rbrace(s0, s1, s2, s3, total, st, token); }
    if token.kind == 15 { return block_if(s0, s1, s2, s3, total, st, token); }
    if st.mode == 1 && token.kind == 13 {
        return match st.frames {
            YNil => BlockState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: st.list, frames: st.frames, done: true, mode: st.mode },
            YCons { head: fr, tail: fl } => block_plain_stmt(s0, s1, s2, s3, total, st, token)
        };
    }
    return block_plain_stmt(s0, s1, s2, s3, total, st, token);
}
fn block_eof(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    return match st.frames {
        YNil => BlockState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: st.list, frames: st.frames, done: true, mode: st.mode },
        YCons { head: fr, tail: fl } => block_fail(st, token.start, token.end)
    };
}
fn block_rbrace(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    return match st.frames {
        YNil => BlockState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: st.list, frames: st.frames, done: true, mode: st.mode },
        YCons { head: fr, tail: fl } => block_then_close(s0, s1, s2, s3, total, st, token, fr, fl)
    };
}
// A `}` inside a then-branch parks the branch and looks for `else`.
fn block_then_close(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: BlockState, token: lexer.Token, fr: Frame, fl: FrameList) -> (result: BlockState) {
    if fr.phase == 0 {
        let parked: Frame = Frame { cond: fr.cond, cond_start: fr.cond_start, cond_end: fr.cond_end, then_list: st.list, parent: fr.parent, phase: 1 };
        return BlockState { cursor: token.end, ok: true, err_start: 0, err_end: 0, list: StmtList.SNil, frames: FrameList.YCons { head: parked, tail: fl }, done: false, mode: st.mode };
    }
    return block_else_close(s0, s1, s2, s3, st, token, fr, fl);
}
fn block_else_close(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: BlockState, token: lexer.Token, fr: Frame, fl: FrameList) -> (result: BlockState) {
    let node: Stmt = Stmt.If { cond: fr.cond, then_b: reverse_stmts(s0, s1, s2, s3, fr.then_list), else_b: reverse_stmts(s0, s1, s2, s3, st.list), start: fr.cond_start, end: fr.cond_end };
    return BlockState { cursor: token.end, ok: true, err_start: 0, err_end: 0, list: StmtList.SCons { head: node, tail: fr.parent }, frames: fl, done: false, mode: st.mode };
}
// After a then-branch: `else {` continues the frame, anything else
// completes the if with an empty else without consuming the token.
fn block_await_else(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: BlockState, token: lexer.Token, fr: Frame, fl: FrameList) -> (result: BlockState) {
    if token.kind == 16 {
        let open: Expect = expect(s0, s1, s2, s3, total, token.end, 67);
        if not(open.ok) { return block_fail(st, open.err_start, open.err_end); }
        let cont: Frame = Frame { cond: fr.cond, cond_start: fr.cond_start, cond_end: fr.cond_end, then_list: fr.then_list, parent: fr.parent, phase: 2 };
        return BlockState { cursor: open.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SNil, frames: FrameList.YCons { head: cont, tail: fl }, done: false, mode: st.mode };
    }
    let node: Stmt = Stmt.If { cond: fr.cond, then_b: reverse_stmts(s0, s1, s2, s3, fr.then_list), else_b: StmtList.SNil, start: fr.cond_start, end: fr.cond_end };
    return BlockState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SCons { head: node, tail: fr.parent }, frames: fl, done: false, mode: st.mode };
}
fn block_if(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    return match st.frames {
        YNil => block_if_open(s0, s1, s2, s3, total, st, token),
        YCons { head: fr, tail: fl } => block_if_frame(s0, s1, s2, s3, total, st, token, fr, fl)
    };
}
// An `if` while awaiting `else` is not an else-branch: complete the pending
// if first (mirrors Stage-0 rejecting `else if`), then open the new one.
fn block_if_frame(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: BlockState, token: lexer.Token, fr: Frame, fl: FrameList) -> (result: BlockState) {
    if fr.phase == 1 {
        let node: Stmt = Stmt.If { cond: fr.cond, then_b: reverse_stmts(s0, s1, s2, s3, fr.then_list), else_b: StmtList.SNil, start: fr.cond_start, end: fr.cond_end };
        let popped: BlockState = BlockState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SCons { head: node, tail: fr.parent }, frames: fl, done: false, mode: st.mode };
        return block_if_open(s0, s1, s2, s3, total, popped, token);
    }
    return block_if_open(s0, s1, s2, s3, total, st, token);
}
fn block_if_open(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    let cond: ExprParse = parse_expr(s0, s1, s2, s3, total, token.end);
    if not(cond.ok) { return block_fail(st, cond.err_start, cond.err_end); }
    let open: Expect = expect(s0, s1, s2, s3, total, cond.cursor, 67);
    if not(open.ok) { return block_fail(st, open.err_start, open.err_end); }
    let frame: Frame = Frame { cond: cond.node, cond_start: cond.start, cond_end: cond.end, then_list: StmtList.SNil, parent: st.list, phase: 0 };
    return BlockState { cursor: open.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SNil, frames: FrameList.YCons { head: frame, tail: st.frames }, done: false, mode: st.mode };
}
fn block_plain_stmt(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    return match st.frames {
        YNil => block_top_stmt(s0, s1, s2, s3, total, st),
        YCons { head: fr, tail: fl } => block_frame_stmt(s0, s1, s2, s3, total, st, fr, fl)
    };
}
fn block_top_stmt(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: BlockState) -> (result: BlockState) {
    let stmt: StmtParse = parse_stmt(s0, s1, s2, s3, total, st.cursor);
    if not(stmt.ok) { return block_fail(st, stmt.err_start, stmt.err_end); }
    return BlockState { cursor: stmt.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SCons { head: stmt.node, tail: st.list }, frames: st.frames, done: false, mode: st.mode };
}
fn block_frame_stmt(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: BlockState, fr: Frame, fl: FrameList) -> (result: BlockState) {
    if fr.phase == 1 {
        let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.cursor);
        return block_await_else(s0, s1, s2, s3, total, st, token, fr, fl);
    }
    return block_top_stmt(s0, s1, s2, s3, total, st);
}
fn finish_block(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: BlockState) -> (result: BranchParse) {
    if not(st.ok) { return BranchParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, list: StmtList.SNil }; }
    if not(st.done) { return BranchParse { cursor: st.cursor, ok: false, err_start: st.cursor, err_end: st.cursor, list: StmtList.SNil }; }
    return match st.frames {
        YNil => BranchParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: reverse_stmts(s0, s1, s2, s3, st.list) },
        YCons { head: fr, tail: fl } => BranchParse { cursor: st.cursor, ok: false, err_start: st.cursor, err_end: st.cursor, list: StmtList.SNil }
    };
}
record StmtRev { rest: StmtList, acc: StmtList }
fn reverse_stmts(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: StmtList) -> (result: StmtList) {
    iterate qi4 over s0 carrying a: StmtRev = StmtRev { rest: list, acc: StmtList.SNil } {
        next a = reverse_stmts_step(a);
    }
    iterate qi5 over s1 carrying b: StmtRev = a {
        next b = reverse_stmts_step(b);
    }
    iterate qi6 over s2 carrying c: StmtRev = b {
        next c = reverse_stmts_step(c);
    }
    iterate qi7 over s3 carrying d: StmtRev = c {
        next d = reverse_stmts_step(d);
    }
    return d.acc;
}
fn reverse_stmts_step(st: StmtRev) -> (result: StmtRev) {
    return match st.rest { SNil => st, SCons { head: h, tail: t } => StmtRev { rest: t, acc: StmtList.SCons { head: h, tail: st.acc } } };
}

// Function signature clauses: requires/ensures/assumes/property/invariant/
// metamorphic (kind + name), `capability name`, and
// `effect kind authorized_by capability`. Retained as facts; the semantic
// layer does not interpret them in this slice.
record ClausesParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, contracts: ClauseList, effects: EffectList, capabilities: CapList }
record ClausesState { cursor: u64, ok: bool, err_start: u64, err_end: u64, contracts: ClauseList, effects: EffectList, capabilities: CapList, done: bool }
fn parse_clauses(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: ClausesParse) {
    iterate ci0 over s0 carrying a: ClausesState = ClausesState { cursor: cursor, ok: true, err_start: 0, err_end: 0, contracts: ClauseList.CNil, effects: EffectList.XNil, capabilities: CapList.ANil, done: false } {
        next a = clauses_step(s0, s1, s2, s3, total, a);
    }
    iterate ci1 over s1 carrying b: ClausesState = a {
        next b = clauses_step(s0, s1, s2, s3, total, b);
    }
    iterate ci2 over s2 carrying c: ClausesState = b {
        next c = clauses_step(s0, s1, s2, s3, total, c);
    }
    iterate ci3 over s3 carrying d: ClausesState = c {
        next d = clauses_step(s0, s1, s2, s3, total, d);
    }
    return finish_clauses(s0, s1, s2, s3, d);
}
fn clauses_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ClausesState) -> (result: ClausesState) {
    if not(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.cursor);
    if token.diagnostic != 0 { return ClausesState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    if token.kind == 25 { return clause_capability(s0, s1, s2, s3, total, st, token); }
    if token.kind == 24 { return clause_effect(s0, s1, s2, s3, total, st, token); }
    if token.kind == 18 || token.kind == 19 || token.kind == 20 || token.kind == 21 || token.kind == 22 || token.kind == 23 {
        return clause_contract(s0, s1, s2, s3, total, st, token);
    }
    return ClausesState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true };
}
fn clause_contract(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ClausesState, token: lexer.Token) -> (result: ClausesState) {
    let name: NameParse = parse_name(s0, s1, s2, s3, total, token.end, 0);
    if not(name.ok) { return ClausesState { cursor: st.cursor, ok: false, err_start: name.err_start, err_end: name.err_end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    let clause: Clause = Clause { kind_start: token.start, kind_end: token.end, name_start: name.start, name_end: name.end };
    return ClausesState { cursor: name.cursor, ok: true, err_start: 0, err_end: 0, contracts: ClauseList.CCons { head: clause, tail: st.contracts }, effects: st.effects, capabilities: st.capabilities, done: false };
}
fn clause_capability(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ClausesState, token: lexer.Token) -> (result: ClausesState) {
    let name: NameParse = parse_name(s0, s1, s2, s3, total, token.end, 0);
    if not(name.ok) { return ClausesState { cursor: st.cursor, ok: false, err_start: name.err_start, err_end: name.err_end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    let cap: Cap = Cap { start: name.start, end: name.end };
    return ClausesState { cursor: name.cursor, ok: true, err_start: 0, err_end: 0, contracts: st.contracts, effects: st.effects, capabilities: CapList.ACons { head: cap, tail: st.capabilities }, done: false };
}
fn clause_effect(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ClausesState, token: lexer.Token) -> (result: ClausesState) {
    let bad: ClausesState = ClausesState { cursor: st.cursor, ok: false, err_start: token.start, err_end: token.end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true };
    let kind: NameParse = parse_name(s0, s1, s2, s3, total, token.end, 0);
    if not(kind.ok) { return ClausesState { cursor: bad.cursor, ok: false, err_start: kind.err_start, err_end: kind.err_end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    let auth: Expect = expect(s0, s1, s2, s3, total, kind.cursor, 26);
    if not(auth.ok) { return ClausesState { cursor: bad.cursor, ok: false, err_start: auth.err_start, err_end: auth.err_end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    let cap: NameParse = parse_name(s0, s1, s2, s3, total, auth.cursor, 0);
    if not(cap.ok) { return ClausesState { cursor: bad.cursor, ok: false, err_start: cap.err_start, err_end: cap.err_end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    let eff: Effect = Effect { kind_start: kind.start, kind_end: kind.end, cap_start: cap.start, cap_end: cap.end };
    return ClausesState { cursor: cap.cursor, ok: true, err_start: 0, err_end: 0, contracts: st.contracts, effects: EffectList.XCons { head: eff, tail: st.effects }, capabilities: st.capabilities, done: false };
}
fn finish_clauses(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: ClausesState) -> (result: ClausesParse) {
    if not(st.ok) { return ClausesParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, contracts: ClauseList.CNil, effects: EffectList.XNil, capabilities: CapList.ANil }; }
    return ClausesParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, contracts: reverse_clauses(s0, s1, s2, s3, st.contracts), effects: reverse_effects(s0, s1, s2, s3, st.effects), capabilities: reverse_caps(s0, s1, s2, s3, st.capabilities) };
}
record ClauseRev { rest: ClauseList, acc: ClauseList }
fn reverse_clauses(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: ClauseList) -> (result: ClauseList) {
    iterate qi8 over s0 carrying a: ClauseRev = ClauseRev { rest: list, acc: ClauseList.CNil } {
        next a = reverse_clauses_step(a);
    }
    iterate qi9 over s1 carrying b: ClauseRev = a {
        next b = reverse_clauses_step(b);
    }
    iterate qi10 over s2 carrying c: ClauseRev = b {
        next c = reverse_clauses_step(c);
    }
    iterate qi11 over s3 carrying d: ClauseRev = c {
        next d = reverse_clauses_step(d);
    }
    return d.acc;
}
fn reverse_clauses_step(st: ClauseRev) -> (result: ClauseRev) {
    return match st.rest { CNil => st, CCons { head: h, tail: t } => ClauseRev { rest: t, acc: ClauseList.CCons { head: h, tail: st.acc } } };
}
record EffectRev { rest: EffectList, acc: EffectList }
fn reverse_effects(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: EffectList) -> (result: EffectList) {
    iterate qi12 over s0 carrying a: EffectRev = EffectRev { rest: list, acc: EffectList.XNil } {
        next a = reverse_effects_step(a);
    }
    iterate qi13 over s1 carrying b: EffectRev = a {
        next b = reverse_effects_step(b);
    }
    iterate qi14 over s2 carrying c: EffectRev = b {
        next c = reverse_effects_step(c);
    }
    iterate qi15 over s3 carrying d: EffectRev = c {
        next d = reverse_effects_step(d);
    }
    return d.acc;
}
fn reverse_effects_step(st: EffectRev) -> (result: EffectRev) {
    return match st.rest { XNil => st, XCons { head: h, tail: t } => EffectRev { rest: t, acc: EffectList.XCons { head: h, tail: st.acc } } };
}
record CapRev { rest: CapList, acc: CapList }
fn reverse_caps(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: CapList) -> (result: CapList) {
    iterate qi16 over s0 carrying a: CapRev = CapRev { rest: list, acc: CapList.ANil } {
        next a = reverse_caps_step(a);
    }
    iterate qi17 over s1 carrying b: CapRev = a {
        next b = reverse_caps_step(b);
    }
    iterate qi18 over s2 carrying c: CapRev = b {
        next c = reverse_caps_step(c);
    }
    iterate qi19 over s3 carrying d: CapRev = c {
        next d = reverse_caps_step(d);
    }
    return d.acc;
}
fn reverse_caps_step(st: CapRev) -> (result: CapRev) {
    return match st.rest { ANil => st, ACons { head: h, tail: t } => CapRev { rest: t, acc: CapList.ACons { head: h, tail: st.acc } } };
}

// `fn name(params) -> (results) clauses { body }`. Generic parameter lists
// are a deferred shape: `<` after the name fails explicitly.
fn parse_fn(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64, start: u64) -> (result: FnDecl) {
    let bad: FnDecl = FnDecl { ok: false, err_start: cursor, err_end: cursor, sig: FnSig { name_start: cursor, name_end: cursor, params: FieldList.FNil, results: FieldList.FNil, contracts: ClauseList.CNil, effects: EffectList.XNil, capabilities: CapList.ANil }, body: FnBody { body: StmtList.SNil, ret: Expr.Name { start: cursor, end: cursor }, has_ret: false }, fn_start: start, fn_end: cursor, cursor: cursor };
    let name: NameParse = parse_name(s0, s1, s2, s3, total, cursor, 1);
    if not(name.ok) { return FnDecl { ..bad, err_start: name.err_start, err_end: name.err_end }; }
    let peek: lexer.Token = segment.significant(s0, s1, s2, s3, total, name.cursor);
    if peek.diagnostic == 0 && peek.kind == 58 {
        return FnDecl { ..bad, err_start: peek.start, err_end: peek.end };
    }
    let open: Expect = expect(s0, s1, s2, s3, total, name.cursor, 65);
    if not(open.ok) { return FnDecl { ..bad, err_start: open.err_start, err_end: open.err_end }; }
    let params: FieldsParse = parse_fields(s0, s1, s2, s3, total, open.cursor, 66, 1);
    if not(params.ok) { return FnDecl { ..bad, err_start: params.err_start, err_end: params.err_end }; }
    let close: Expect = expect(s0, s1, s2, s3, total, params.cursor, 66);
    if not(close.ok) { return FnDecl { ..bad, err_start: close.err_start, err_end: close.err_end }; }
    let arrow: Expect = expect(s0, s1, s2, s3, total, close.cursor, 80);
    if not(arrow.ok) { return FnDecl { ..bad, err_start: arrow.err_start, err_end: arrow.err_end }; }
    let open2: Expect = expect(s0, s1, s2, s3, total, arrow.cursor, 65);
    if not(open2.ok) { return FnDecl { ..bad, err_start: open2.err_start, err_end: open2.err_end }; }
    let results: FieldsParse = parse_fields(s0, s1, s2, s3, total, open2.cursor, 66, 1);
    if not(results.ok) { return FnDecl { ..bad, err_start: results.err_start, err_end: results.err_end }; }
    let close2: Expect = expect(s0, s1, s2, s3, total, results.cursor, 66);
    if not(close2.ok) { return FnDecl { ..bad, err_start: close2.err_start, err_end: close2.err_end }; }
    let clauses: ClausesParse = parse_clauses(s0, s1, s2, s3, total, close2.cursor);
    if not(clauses.ok) { return FnDecl { ..bad, err_start: clauses.err_start, err_end: clauses.err_end }; }
    let open3: Expect = expect(s0, s1, s2, s3, total, clauses.cursor, 67);
    if not(open3.ok) { return FnDecl { ..bad, err_start: open3.err_start, err_end: open3.err_end }; }
    let body: BranchParse = parse_stmts(s0, s1, s2, s3, total, open3.cursor, 1);
    if not(body.ok) { return FnDecl { ..bad, err_start: body.err_start, err_end: body.err_end }; }
    let tail: ReturnParse = parse_return_tail(s0, s1, s2, s3, total, body.cursor);
    if not(tail.ok) { return FnDecl { ..bad, err_start: tail.err_start, err_end: tail.err_end }; }
    let close3: Expect = expect(s0, s1, s2, s3, total, tail.cursor, 68);
    if not(close3.ok) { return FnDecl { ..bad, err_start: close3.err_start, err_end: close3.err_end }; }
    let sig: FnSig = FnSig { name_start: name.start, name_end: name.end, params: params.list, results: results.list, contracts: clauses.contracts, effects: clauses.effects, capabilities: clauses.capabilities };
    let fnbody: FnBody = FnBody { body: body.list, ret: tail.node, has_ret: true };
    return FnDecl { ok: true, err_start: 0, err_end: 0, sig: sig, body: fnbody, fn_start: start, fn_end: close3.cursor, cursor: close3.cursor };
}
record ReturnParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, node: Expr }
fn parse_return_tail(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: ReturnParse) {
    let bad: Expr = Expr.Name { start: cursor, end: cursor };
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, cursor);
    if token.diagnostic != 0 || token.kind != 13 {
        return ReturnParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad };
    }
    let value: ExprParse = parse_expr(s0, s1, s2, s3, total, token.end);
    if not(value.ok) { return ReturnParse { cursor: cursor, ok: false, err_start: value.err_start, err_end: value.err_end, node: bad }; }
    let semi: Expect = expect(s0, s1, s2, s3, total, value.cursor, 63);
    if not(semi.ok) { return ReturnParse { cursor: cursor, ok: false, err_start: semi.err_start, err_end: semi.err_end, node: bad }; }
    return ReturnParse { cursor: semi.cursor, ok: true, err_start: 0, err_end: 0, node: value.node };
}

// Whole logical-source unit: header, imports, then interleaved record,
// enum, and function declarations through EOF.
record UnitState { cursor: u64, ok: bool, err_start: u64, err_end: u64, uses: UseList, records: RecordList, enums: EnumList, fns: FnList, count: u64, done: bool }
fn parse_unit(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64) -> (result: Unit) {
    let empty: parser.Header = parser.Header { code: 0, start: 0, end: 0, version_start: 0, version_end: 0, module_start: 0, module_end: 0, next_offset: 0, state: 0 };
    let bad: Unit = Unit { ok: false, err_start: 0, err_end: 0, header: empty, uses: UseList.UNil, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, cursor: 0 };
    if not(segment.total_valid(s0, s1, s2, s3, total)) { return Unit { ..bad, err_end: total }; }
    let head: parser.Header = header(s0, s1, s2, s3, total);
    if head.code != 0 { return Unit { ..bad, header: head, err_start: head.start, err_end: head.end, cursor: head.next_offset }; }
    let uses: UsesParse = parse_uses(s0, s1, s2, s3, total, head.next_offset);
    if not(uses.ok) { return Unit { ..bad, header: head, err_start: uses.err_start, err_end: uses.err_end, cursor: uses.cursor }; }
    iterate ui0 over s0 carrying a: UnitState = UnitState { cursor: uses.cursor, ok: true, err_start: 0, err_end: 0, uses: uses.list, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, count: 0, done: false } {
        next a = unit_step(s0, s1, s2, s3, total, a);
    }
    iterate ui1 over s1 carrying b: UnitState = a {
        next b = unit_step(s0, s1, s2, s3, total, b);
    }
    iterate ui2 over s2 carrying c: UnitState = b {
        next c = unit_step(s0, s1, s2, s3, total, c);
    }
    iterate ui3 over s3 carrying d: UnitState = c {
        next d = unit_step(s0, s1, s2, s3, total, d);
    }
    return finish_unit(s0, s1, s2, s3, total, head, d);
}
record UsesParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: UseList }
record UsesState { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: UseList, done: bool }
fn parse_uses(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, cursor: u64) -> (result: UsesParse) {
    iterate si0 over s0 carrying a: UsesState = UsesState { cursor: cursor, ok: true, err_start: 0, err_end: 0, list: UseList.UNil, done: false } {
        next a = uses_step(s0, s1, s2, s3, total, a);
    }
    iterate si1 over s1 carrying b: UsesState = a {
        next b = uses_step(s0, s1, s2, s3, total, b);
    }
    iterate si2 over s2 carrying c: UsesState = b {
        next c = uses_step(s0, s1, s2, s3, total, c);
    }
    iterate si3 over s3 carrying d: UsesState = c {
        next d = uses_step(s0, s1, s2, s3, total, d);
    }
    return finish_uses(s0, s1, s2, s3, d);
}
fn uses_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: UsesState) -> (result: UsesState) {
    if not(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.cursor);
    if token.diagnostic != 0 || token.kind != 28 { return UsesState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: st.list, done: true }; }
    let decl: UseDecl = parse_use(s0, s1, s2, s3, total, token.end);
    if not(decl.ok) { return UsesState { cursor: st.cursor, ok: false, err_start: decl.err_start, err_end: decl.err_end, list: st.list, done: true }; }
    return UsesState { cursor: decl.cursor, ok: true, err_start: 0, err_end: 0, list: UseList.UCons { head: decl, tail: st.list }, done: false };
}
fn finish_uses(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: UsesState) -> (result: UsesParse) {
    if not(st.ok) { return UsesParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, list: UseList.UNil }; }
    return UsesParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: reverse_uses(s0, s1, s2, s3, st.list) };
}
record UseRev { rest: UseList, acc: UseList }
fn reverse_uses(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: UseList) -> (result: UseList) {
    iterate qi20 over s0 carrying a: UseRev = UseRev { rest: list, acc: UseList.UNil } {
        next a = reverse_uses_step(a);
    }
    iterate qi21 over s1 carrying b: UseRev = a {
        next b = reverse_uses_step(b);
    }
    iterate qi22 over s2 carrying c: UseRev = b {
        next c = reverse_uses_step(c);
    }
    iterate qi23 over s3 carrying d: UseRev = c {
        next d = reverse_uses_step(d);
    }
    return d.acc;
}
fn reverse_uses_step(st: UseRev) -> (result: UseRev) {
    return match st.rest { UNil => st, UCons { head: h, tail: t } => UseRev { rest: t, acc: UseList.UCons { head: h, tail: st.acc } } };
}
fn unit_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: UnitState) -> (result: UnitState) {
    if not(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.cursor);
    if token.diagnostic != 0 || token.kind == 0 { return UnitState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, uses: st.uses, records: st.records, enums: st.enums, fns: st.fns, count: st.count, done: true }; }
    if token.kind == 27 { return unit_enum(s0, s1, s2, s3, total, st, token); }
    if token.kind == 29 { return unit_record(s0, s1, s2, s3, total, st, token); }
    if token.kind == 12 { return unit_fn(s0, s1, s2, s3, total, st, token); }
    return UnitState { cursor: st.cursor, ok: false, err_start: token.start, err_end: token.end, uses: st.uses, records: st.records, enums: st.enums, fns: st.fns, count: st.count, done: true };
}
fn unit_enum(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: UnitState, token: lexer.Token) -> (result: UnitState) {
    let decl: EnumDecl = parse_enum(s0, s1, s2, s3, total, token.end, token.start);
    if not(decl.ok) { return UnitState { cursor: st.cursor, ok: false, err_start: decl.err_start, err_end: decl.err_end, uses: st.uses, records: st.records, enums: st.enums, fns: st.fns, count: st.count, done: true }; }
    return UnitState { cursor: decl.cursor, ok: true, err_start: 0, err_end: 0, uses: st.uses, records: st.records, enums: EnumList.GCons { head: decl, tail: st.enums }, fns: st.fns, count: st.count + 1, done: false };
}
fn unit_record(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: UnitState, token: lexer.Token) -> (result: UnitState) {
    let decl: RecordDecl = parse_record(s0, s1, s2, s3, total, token.end, token.start);
    if not(decl.ok) { return UnitState { cursor: st.cursor, ok: false, err_start: decl.err_start, err_end: decl.err_end, uses: st.uses, records: st.records, enums: st.enums, fns: st.fns, count: st.count, done: true }; }
    return UnitState { cursor: decl.cursor, ok: true, err_start: 0, err_end: 0, uses: st.uses, records: RecordList.RCons { head: decl, tail: st.records }, enums: st.enums, fns: st.fns, count: st.count + 1, done: false };
}
fn unit_fn(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: UnitState, token: lexer.Token) -> (result: UnitState) {
    let decl: FnDecl = parse_fn(s0, s1, s2, s3, total, token.end, token.start);
    if not(decl.ok) { return UnitState { cursor: st.cursor, ok: false, err_start: decl.err_start, err_end: decl.err_end, uses: st.uses, records: st.records, enums: st.enums, fns: st.fns, count: st.count, done: true }; }
    return UnitState { cursor: decl.cursor, ok: true, err_start: 0, err_end: 0, uses: st.uses, records: st.records, enums: st.enums, fns: FnList.DCons { head: decl, tail: st.fns }, count: st.count + 1, done: false };
}
fn finish_unit(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, head: parser.Header, st: UnitState) -> (result: Unit) {
    let empty: parser.Header = parser.Header { code: 0, start: 0, end: 0, version_start: 0, version_end: 0, module_start: 0, module_end: 0, next_offset: 0, state: 0 };
    if not(st.ok) { return Unit { ok: false, err_start: st.err_start, err_end: st.err_end, header: head, uses: UseList.UNil, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, cursor: st.cursor }; }
    let tail: lexer.Token = segment.significant(s0, s1, s2, s3, total, st.cursor);
    if tail.diagnostic != 0 { return Unit { ok: false, err_start: tail.start, err_end: tail.end, header: head, uses: UseList.UNil, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, cursor: st.cursor }; }
    if tail.kind != 0 { return Unit { ok: false, err_start: tail.start, err_end: tail.end, header: head, uses: UseList.UNil, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, cursor: st.cursor }; }
    if st.count == 0 {
        return Unit { ok: false, err_start: tail.start, err_end: tail.end, header: head, uses: UseList.UNil, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, cursor: st.cursor };
    }
    return Unit { ok: true, err_start: 0, err_end: 0, header: head, uses: st.uses, records: reverse_records(s0, s1, s2, s3, st.records), enums: reverse_enums(s0, s1, s2, s3, st.enums), fns: reverse_fns(s0, s1, s2, s3, st.fns), cursor: st.cursor };
}
record RecordRev { rest: RecordList, acc: RecordList }
fn reverse_records(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: RecordList) -> (result: RecordList) {
    iterate qi24 over s0 carrying a: RecordRev = RecordRev { rest: list, acc: RecordList.RNil } {
        next a = reverse_records_step(a);
    }
    iterate qi25 over s1 carrying b: RecordRev = a {
        next b = reverse_records_step(b);
    }
    iterate qi26 over s2 carrying c: RecordRev = b {
        next c = reverse_records_step(c);
    }
    iterate qi27 over s3 carrying d: RecordRev = c {
        next d = reverse_records_step(d);
    }
    return d.acc;
}
fn reverse_records_step(st: RecordRev) -> (result: RecordRev) {
    return match st.rest { RNil => st, RCons { head: h, tail: t } => RecordRev { rest: t, acc: RecordList.RCons { head: h, tail: st.acc } } };
}
record EnumRev { rest: EnumList, acc: EnumList }
fn reverse_enums(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: EnumList) -> (result: EnumList) {
    iterate qi28 over s0 carrying a: EnumRev = EnumRev { rest: list, acc: EnumList.GNil } {
        next a = reverse_enums_step(a);
    }
    iterate qi29 over s1 carrying b: EnumRev = a {
        next b = reverse_enums_step(b);
    }
    iterate qi30 over s2 carrying c: EnumRev = b {
        next c = reverse_enums_step(c);
    }
    iterate qi31 over s3 carrying d: EnumRev = c {
        next d = reverse_enums_step(d);
    }
    return d.acc;
}
fn reverse_enums_step(st: EnumRev) -> (result: EnumRev) {
    return match st.rest { GNil => st, GCons { head: h, tail: t } => EnumRev { rest: t, acc: EnumList.GCons { head: h, tail: st.acc } } };
}
record FnRev { rest: FnList, acc: FnList }
fn reverse_fns(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: FnList) -> (result: FnList) {
    iterate qi32 over s0 carrying a: FnRev = FnRev { rest: list, acc: FnList.DNil } {
        next a = reverse_fns_step(a);
    }
    iterate qi33 over s1 carrying b: FnRev = a {
        next b = reverse_fns_step(b);
    }
    iterate qi34 over s2 carrying c: FnRev = b {
        next c = reverse_fns_step(c);
    }
    iterate qi35 over s3 carrying d: FnRev = c {
        next d = reverse_fns_step(d);
    }
    return d.acc;
}
fn reverse_fns_step(st: FnRev) -> (result: FnRev) {
    return match st.rest { DNil => st, DCons { head: h, tail: t } => FnRev { rest: t, acc: FnList.DCons { head: h, tail: st.acc } } };
}

// Symbol, semantic, and IR micro-facts over parsed units. Same home module
// as the trees (see the homing rule at the top of this file). All checks
// are bounded: list traversals burn caller-supplied segment fuel, and an
// undrained work stack at the end of fuel is reported as a check failure,
// never silently accepted (see CP-0009). Stage tags on UnitCheck: 0 parse,
// 1 duplicate symbols, 2 resolve/span walk, 3 IR depth, 4 fully verified.
// Type-namespace resolution (record/enum/value types, use aliases) is
// deferred; only function-name symbols and call resolution are checked.

// A declared function name as a source span.
record NameSpan { start: u64, end: u64 }
enum NameList { NNil, NCons { head: NameSpan, tail: NameList } }

// Exact byte equality of two spans. Lengths compare without fuel; only
// equal-length spans burn byte fuel, one position per step.
record EqState { a_start: u64, len: u64, b_start: u64, off: u64, eq: bool }
fn spans_equal(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, a_start: u64, a_end: u64, b_start: u64, b_end: u64) -> (result: bool) {
    if a_end < a_start || b_end < b_start { return false; }
    if a_end - a_start != b_end - b_start { return false; }
    iterate ei0 over s0 carrying a: EqState = EqState { a_start: a_start, len: a_end - a_start, b_start: b_start, off: 0, eq: true } {
        next a = span_eq_step(s0, s1, s2, s3, total, a);
    }
    iterate ei1 over s1 carrying b: EqState = a {
        next b = span_eq_step(s0, s1, s2, s3, total, b);
    }
    iterate ei2 over s2 carrying c: EqState = b {
        next c = span_eq_step(s0, s1, s2, s3, total, c);
    }
    iterate ei3 over s3 carrying d: EqState = c {
        next d = span_eq_step(s0, s1, s2, s3, total, d);
    }
    return d.eq;
}
fn span_eq_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: EqState) -> (result: EqState) {
    if st.off >= st.len { return st; }
    let same: bool = segment.byte_at(s0, s1, s2, s3, total, st.a_start + st.off) == segment.byte_at(s0, s1, s2, s3, total, st.b_start + st.off);
    return EqState { a_start: st.a_start, len: st.len, b_start: st.b_start, off: st.off + 1, eq: st.eq && same };
}

// Declared function names in source order (reversed during accumulation,
// then restored like every other list here).
record FnNameAcc { rest: FnList, acc: NameList }
fn collect_fn_names(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], fns: FnList) -> (result: NameList) {
    iterate ni0 over s0 carrying a: FnNameAcc = FnNameAcc { rest: fns, acc: NameList.NNil } {
        next a = collect_fn_names_step(a);
    }
    iterate ni1 over s1 carrying b: FnNameAcc = a {
        next b = collect_fn_names_step(b);
    }
    iterate ni2 over s2 carrying c: FnNameAcc = b {
        next c = collect_fn_names_step(c);
    }
    iterate ni3 over s3 carrying d: FnNameAcc = c {
        next d = collect_fn_names_step(d);
    }
    return reverse_names(s0, s1, s2, s3, d.acc);
}
fn collect_fn_names_step(st: FnNameAcc) -> (result: FnNameAcc) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => collect_fn_names_cons(st, h, t)
    };
}
fn collect_fn_names_cons(st: FnNameAcc, h: FnDecl, t: FnList) -> (result: FnNameAcc) {
    let sg: FnSig = h.sig;
    return FnNameAcc { rest: t, acc: NameList.NCons { head: NameSpan { start: sg.name_start, end: sg.name_end }, tail: st.acc } };
}
record NameRev { rest: NameList, acc: NameList }
fn reverse_names(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: NameList) -> (result: NameList) {
    iterate ri0 over s0 carrying a: NameRev = NameRev { rest: list, acc: NameList.NNil } {
        next a = reverse_names_step(a);
    }
    iterate ri1 over s1 carrying b: NameRev = a {
        next b = reverse_names_step(b);
    }
    iterate ri2 over s2 carrying c: NameRev = b {
        next c = reverse_names_step(c);
    }
    iterate ri3 over s3 carrying d: NameRev = c {
        next d = reverse_names_step(d);
    }
    return d.acc;
}
fn reverse_names_step(st: NameRev) -> (result: NameRev) {
    return match st.rest { NNil => st, NCons { head: h, tail: t } => NameRev { rest: t, acc: NameList.NCons { head: h, tail: st.acc } } };
}

// Membership of a span in a name list by exact bytes.
record KnownState { rest: NameList, start: u64, end: u64, found: bool }
fn name_known(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, list: NameList, start: u64, end: u64) -> (result: bool) {
    iterate ki0 over s0 carrying a: KnownState = KnownState { rest: list, start: start, end: end, found: false } {
        next a = name_known_step(s0, s1, s2, s3, total, a);
    }
    iterate ki1 over s1 carrying b: KnownState = a {
        next b = name_known_step(s0, s1, s2, s3, total, b);
    }
    iterate ki2 over s2 carrying c: KnownState = b {
        next c = name_known_step(s0, s1, s2, s3, total, c);
    }
    iterate ki3 over s3 carrying d: KnownState = c {
        next d = name_known_step(s0, s1, s2, s3, total, d);
    }
    return d.found;
}
fn name_known_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: KnownState) -> (result: KnownState) {
    return match st.rest {
        NNil => st,
        NCons { head: h, tail: t } => KnownState { rest: t, start: st.start, end: st.end, found: st.found || spans_equal(s0, s1, s2, s3, total, h.start, h.end, st.start, st.end) }
    };
}

// First duplicated function name, if any.
record DupState { rest: NameList, seen: NameList, found: bool, start: u64, end: u64 }
record DupReport { found: bool, start: u64, end: u64 }
fn duplicate_fn_names(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, names: NameList) -> (result: DupReport) {
    iterate di0 over s0 carrying a: DupState = DupState { rest: names, seen: NameList.NNil, found: false, start: 0, end: 0 } {
        next a = duplicate_fn_names_step(s0, s1, s2, s3, total, a);
    }
    iterate di1 over s1 carrying b: DupState = a {
        next b = duplicate_fn_names_step(s0, s1, s2, s3, total, b);
    }
    iterate di2 over s2 carrying c: DupState = b {
        next c = duplicate_fn_names_step(s0, s1, s2, s3, total, c);
    }
    iterate di3 over s3 carrying d: DupState = c {
        next d = duplicate_fn_names_step(s0, s1, s2, s3, total, d);
    }
    return DupReport { found: d.found, start: d.start, end: d.end };
}
fn duplicate_fn_names_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: DupState) -> (result: DupState) {
    return match st.rest {
        NNil => st,
        NCons { head: h, tail: t } => duplicate_fn_names_cons(s0, s1, s2, s3, total, st, h, t)
    };
}
fn duplicate_fn_names_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: DupState, h: NameSpan, t: NameList) -> (result: DupState) {
    if st.found { return DupState { rest: t, seen: st.seen, found: true, start: st.start, end: st.end }; }
    if name_known(s0, s1, s2, s3, total, st.seen, h.start, h.end) {
        return DupState { rest: t, seen: st.seen, found: true, start: h.start, end: h.end };
    }
    return DupState { rest: t, seen: NameList.NCons { head: h, tail: st.seen }, found: false, start: 0, end: 0 };
}

// Resolve/span walk over one function body. Two work stacks: swords holds
// statements whose expressions are not yet queued, work holds queued
// expressions. Every visited expression is pushed onto acc for the later
// IR phase. The first bad span (out-of-range expression span or call to
// an undeclared function name) drains both stacks and wins; traversal
// order is the documented first-error order.
record WalkState { swords: StmtList, work: ExprList, acc: ExprList, names: NameList, total: u64, ok: bool, bad_start: u64, bad_end: u64 }
record BodyReport { ok: bool, bad_start: u64, bad_end: u64, exprs: ExprList }
fn check_body(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, body: StmtList, ret: Expr, names: NameList) -> (result: BodyReport) {
    iterate wi0 over s0 carrying a: WalkState = WalkState { swords: body, work: ExprList.ECons { head: ret, tail: ExprList.ENil }, acc: ExprList.ENil, names: names, total: total, ok: true, bad_start: 0, bad_end: 0 } {
        next a = walk_step(s0, s1, s2, s3, a);
    }
    iterate wi1 over s1 carrying b: WalkState = a {
        next b = walk_step(s0, s1, s2, s3, b);
    }
    iterate wi2 over s2 carrying c: WalkState = b {
        next c = walk_step(s0, s1, s2, s3, c);
    }
    iterate wi3 over s3 carrying d: WalkState = c {
        next d = walk_step(s0, s1, s2, s3, d);
    }
    return walk_report(d);
}
fn walk_report(st: WalkState) -> (result: BodyReport) {
    if not(st.ok) { return BodyReport { ok: false, bad_start: st.bad_start, bad_end: st.bad_end, exprs: ExprList.ENil }; }
    if not(walk_drained(st)) { return BodyReport { ok: false, bad_start: st.total, bad_end: st.total, exprs: ExprList.ENil }; }
    return BodyReport { ok: true, bad_start: 0, bad_end: 0, exprs: st.acc };
}
fn walk_drained(st: WalkState) -> (result: bool) {
    return match st.swords {
        SCons { head: h, tail: t } => walk_drained_cons(h, t, st),
        SNil => walk_work_drained(st)
    };
}
fn walk_drained_cons(h: Stmt, t: StmtList, st: WalkState) -> (result: bool) {
    return false;
}
fn walk_work_drained(st: WalkState) -> (result: bool) {
    return match st.work {
        ECons { head: h, tail: t } => walk_drained_cons_expr(h, t),
        ENil => true
    };
}
fn walk_drained_cons_expr(h: Expr, t: ExprList) -> (result: bool) {
    return false;
}
fn walk_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: WalkState) -> (result: WalkState) {
    if not(st.ok) { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: st.acc, names: st.names, total: st.total, ok: false, bad_start: st.bad_start, bad_end: st.bad_end }; }
    return match st.swords {
        SCons { head: h, tail: t } => walk_stmt(s0, s1, s2, s3, st, h, t),
        SNil => walk_expr_top(s0, s1, s2, s3, st)
    };
}
fn walk_stmt(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: WalkState, h: Stmt, t: StmtList) -> (result: WalkState) {
    return match h {
        Let { name_start: a, name_end: b, type_start: c, type_end: d, type_kind: k, value: v, start: s, end: e } => walk_stmt_let(st, t, v, a, b, c, d, k, s, e),
        If { cond: c, then_b: tb, else_b: eb, start: s, end: e } => walk_stmt_if(s0, s1, s2, s3, st, t, c, tb, eb, s, e),
        Fail { mode_start: a, mode_end: b, start: s, end: e } => walk_stmt_fail(st, t, a, b, s, e),
        Return { value: v, start: s, end: e } => walk_stmt_return(st, t, v, s, e)
    };
}
fn walk_stmt_let(st: WalkState, t: StmtList, v: Expr, a: u64, b: u64, c: u64, d: u64, k: u64, s: u64, e: u64) -> (result: WalkState) {
    if e < s || e > st.total { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: st.acc, names: st.names, total: st.total, ok: false, bad_start: s, bad_end: e }; }
    return WalkState { swords: t, work: ExprList.ECons { head: v, tail: st.work }, acc: st.acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 };
}
fn walk_stmt_if(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: WalkState, t: StmtList, c: Expr, tb: StmtList, eb: StmtList, s: u64, e: u64) -> (result: WalkState) {
    if e < s || e > st.total { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: st.acc, names: st.names, total: st.total, ok: false, bad_start: s, bad_end: e }; }
    return WalkState { swords: append_stmts(s0, s1, s2, s3, tb, append_stmts(s0, s1, s2, s3, eb, t)), work: ExprList.ECons { head: c, tail: st.work }, acc: st.acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 };
}
fn walk_stmt_fail(st: WalkState, t: StmtList, a: u64, b: u64, s: u64, e: u64) -> (result: WalkState) {
    if e < s || e > st.total { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: st.acc, names: st.names, total: st.total, ok: false, bad_start: s, bad_end: e }; }
    return WalkState { swords: t, work: st.work, acc: st.acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 };
}
fn walk_stmt_return(st: WalkState, t: StmtList, v: Expr, s: u64, e: u64) -> (result: WalkState) {
    if e < s || e > st.total { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: st.acc, names: st.names, total: st.total, ok: false, bad_start: s, bad_end: e }; }
    return WalkState { swords: t, work: ExprList.ECons { head: v, tail: st.work }, acc: st.acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 };
}
fn walk_expr_top(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: WalkState) -> (result: WalkState) {
    return match st.work {
        ENil => st,
        ECons { head: h, tail: t } => walk_expr(s0, s1, s2, s3, st, h, t)
    };
}
fn walk_expr(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: WalkState, h: Expr, t: ExprList) -> (result: WalkState) {
    let s: u64 = expr_start(h);
    let e: u64 = expr_end(h);
    let acc: ExprList = ExprList.ECons { head: h, tail: st.acc };
    if e < s || e > st.total { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: acc, names: st.names, total: st.total, ok: false, bad_start: s, bad_end: e }; }
    return walk_children(s0, s1, s2, s3, st, h, t, acc);
}
fn walk_children(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: WalkState, h: Expr, t: ExprList, acc: ExprList) -> (result: WalkState) {
    return match h {
        Name { start: s, end: e } => WalkState { swords: st.swords, work: t, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        Integer { start: s, end: e, value: v, overflow: o } => WalkState { swords: st.swords, work: t, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        Boolean { start: s, end: e, value: v } => WalkState { swords: st.swords, work: t, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        Binary { op: o, left: l, right: r, start: s, end: e } => WalkState { swords: st.swords, work: ExprList.ECons { head: l, tail: ExprList.ECons { head: r, tail: t } }, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        Call { name_start: ns, name_end: ne, args: a, start: s, end: e } => walk_call(s0, s1, s2, s3, st, t, acc, ns, ne, a),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => WalkState { swords: st.swords, work: ExprList.ECons { head: b, tail: t }, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 }
    };
}
fn walk_call(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: WalkState, t: ExprList, acc: ExprList, ns: u64, ne: u64, args: ExprList) -> (result: WalkState) {
    if not(name_known(s0, s1, s2, s3, st.total, st.names, ns, ne)) {
        return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: acc, names: st.names, total: st.total, ok: false, bad_start: ns, bad_end: ne };
    }
    return WalkState { swords: st.swords, work: append_exprs(s0, s1, s2, s3, args, t), acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 };
}

// List appends via reversal (each input list is consumed once, so the
// traversal stays within segment fuel for bounded sources).
record StmtPrepend { rest: StmtList, acc: StmtList }
fn append_stmts(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], first: StmtList, second: StmtList) -> (result: StmtList) {
    let rev: StmtList = reverse_stmts(s0, s1, s2, s3, first);
    iterate ai0 over s0 carrying a: StmtPrepend = StmtPrepend { rest: rev, acc: second } {
        next a = append_stmts_step(a);
    }
    iterate ai1 over s1 carrying b: StmtPrepend = a {
        next b = append_stmts_step(b);
    }
    iterate ai2 over s2 carrying c: StmtPrepend = b {
        next c = append_stmts_step(c);
    }
    iterate ai3 over s3 carrying d: StmtPrepend = c {
        next d = append_stmts_step(d);
    }
    return d.acc;
}
fn append_stmts_step(st: StmtPrepend) -> (result: StmtPrepend) {
    return match st.rest { SNil => st, SCons { head: h, tail: t } => StmtPrepend { rest: t, acc: StmtList.SCons { head: h, tail: st.acc } } };
}
record ExprPrepend { rest: ExprList, acc: ExprList }
fn append_exprs(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], first: ExprList, second: ExprList) -> (result: ExprList) {
    let rev: ExprList = reverse_exprs(s0, s1, s2, s3, first);
    iterate pi0 over s0 carrying a: ExprPrepend = ExprPrepend { rest: rev, acc: second } {
        next a = append_exprs_step(a);
    }
    iterate pi1 over s1 carrying b: ExprPrepend = a {
        next b = append_exprs_step(b);
    }
    iterate pi2 over s2 carrying c: ExprPrepend = b {
        next c = append_exprs_step(c);
    }
    iterate pi3 over s3 carrying d: ExprPrepend = c {
        next d = append_exprs_step(d);
    }
    return d.acc;
}
fn append_exprs_step(st: ExprPrepend) -> (result: ExprPrepend) {
    return match st.rest { ENil => st, ECons { head: h, tail: t } => ExprPrepend { rest: t, acc: ExprList.ECons { head: h, tail: st.acc } } };
}

// Tiny stack IR: one instruction per expression node in postorder. The
// depth verifier below is a self-check in the kernel.shape tradition: it
// must accept every lowering of a walked body, so a rejection is always
// a lowering bug, never a source fact.
enum FlatOp {
    PInt { value: u64 },
    PBool { value: bool },
    PName { start: u64, end: u64 },
    PBin { op: u64 },
    PCall { name_start: u64, name_end: u64, argc: u64 },
    PProj { field_start: u64, field_end: u64, path: bool }
}
enum FlatList { INil, ICons { head: FlatOp, tail: FlatList } }
record LowerState { work: ExprList, out: FlatList }
fn lower_expr(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], node: Expr) -> (result: FlatList) {
    iterate li0 over s0 carrying a: LowerState = LowerState { work: ExprList.ECons { head: node, tail: ExprList.ENil }, out: FlatList.INil } {
        next a = lower_step(s0, s1, s2, s3, a);
    }
    iterate li1 over s1 carrying b: LowerState = a {
        next b = lower_step(s0, s1, s2, s3, b);
    }
    iterate li2 over s2 carrying c: LowerState = b {
        next c = lower_step(s0, s1, s2, s3, c);
    }
    iterate li3 over s3 carrying d: LowerState = c {
        next d = lower_step(s0, s1, s2, s3, d);
    }
    // No reversal: right-subtree-first visiting conses nodes so the head-
    // first output list already reads postorder (operator after both
    // operand subtrees, call after all argument subtrees).
    return d.out;
}
fn lower_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: LowerState) -> (result: LowerState) {
    return match st.work {
        ENil => st,
        ECons { head: h, tail: t } => lower_one(s0, s1, s2, s3, st, h, t)
    };
}
fn lower_one(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: LowerState, h: Expr, t: ExprList) -> (result: LowerState) {
    return match h {
        Name { start: s, end: e } => LowerState { work: t, out: FlatList.ICons { head: FlatOp.PName { start: s, end: e }, tail: st.out } },
        Integer { start: s, end: e, value: v, overflow: o } => LowerState { work: t, out: FlatList.ICons { head: FlatOp.PInt { value: v }, tail: st.out } },
        Boolean { start: s, end: e, value: v } => LowerState { work: t, out: FlatList.ICons { head: FlatOp.PBool { value: v }, tail: st.out } },
        Binary { op: o, left: l, right: r, start: s, end: e } => LowerState { work: ExprList.ECons { head: r, tail: ExprList.ECons { head: l, tail: t } }, out: FlatList.ICons { head: FlatOp.PBin { op: o }, tail: st.out } },
        Call { name_start: ns, name_end: ne, args: a, start: s, end: e } => lower_call(s0, s1, s2, s3, st, t, ns, ne, a),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => LowerState { work: ExprList.ECons { head: b, tail: t }, out: FlatList.ICons { head: FlatOp.PProj { field_start: fs, field_end: fe, path: p }, tail: st.out } }
    };
}
fn lower_call(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: LowerState, t: ExprList, ns: u64, ne: u64, args: ExprList) -> (result: LowerState) {
    let argc: u64 = count_exprs(s0, s1, s2, s3, args);
    // Arguments queue reversed so the last argument is visited first and
    // the output keeps source argument order before the call op.
    let rev: ExprList = reverse_exprs(s0, s1, s2, s3, args);
    return LowerState { work: append_exprs(s0, s1, s2, s3, rev, t), out: FlatList.ICons { head: FlatOp.PCall { name_start: ns, name_end: ne, argc: argc }, tail: st.out } };
}
record CountState { rest: ExprList, n: u64 }
fn count_exprs(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: ExprList) -> (result: u64) {
    iterate ci0 over s0 carrying a: CountState = CountState { rest: list, n: 0 } {
        next a = count_exprs_step(a);
    }
    iterate ci1 over s1 carrying b: CountState = a {
        next b = count_exprs_step(b);
    }
    iterate ci2 over s2 carrying c: CountState = b {
        next c = count_exprs_step(c);
    }
    iterate ci3 over s3 carrying d: CountState = c {
        next d = count_exprs_step(d);
    }
    return d.n;
}
fn count_exprs_step(st: CountState) -> (result: CountState) {
    return match st.rest { ENil => st, ECons { head: h, tail: t } => CountState { rest: t, n: st.n + 1 } };
}
// Stack-depth verifier: pushes add one, PBin nets minus one, PCall nets
// one minus argc, PProj is depth-neutral. A well-formed lowering of one
// expression ends at depth exactly one without ever going negative.
record DepthState { rest: FlatList, depth: u64, ok: bool }
fn flat_ok(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], ops: FlatList) -> (result: bool) {
    iterate gi0 over s0 carrying a: DepthState = DepthState { rest: ops, depth: 0, ok: true } {
        next a = flat_step(a);
    }
    iterate gi1 over s1 carrying b: DepthState = a {
        next b = flat_step(b);
    }
    iterate gi2 over s2 carrying c: DepthState = b {
        next c = flat_step(c);
    }
    iterate gi3 over s3 carrying d: DepthState = c {
        next d = flat_step(d);
    }
    return d.ok && d.depth == 1;
}
fn flat_step(st: DepthState) -> (result: DepthState) {
    if not(st.ok) { return st; }
    return match st.rest {
        INil => st,
        ICons { head: h, tail: t } => flat_one(st, h, t)
    };
}
fn flat_one(st: DepthState, h: FlatOp, t: FlatList) -> (result: DepthState) {
    return match h {
        PInt { value: v } => DepthState { rest: t, depth: st.depth + 1, ok: true },
        PBool { value: v } => DepthState { rest: t, depth: st.depth + 1, ok: true },
        PName { start: s, end: e } => DepthState { rest: t, depth: st.depth + 1, ok: true },
        PBin { op: o } => flat_bin(st, t),
        PCall { name_start: ns, name_end: ne, argc: c } => flat_call(st, t, c),
        PProj { field_start: fs, field_end: fe, path: p } => flat_proj(st, t)
    };
}
fn flat_bin(st: DepthState, t: FlatList) -> (result: DepthState) {
    if st.depth < 2 { return DepthState { rest: FlatList.INil, depth: 0, ok: false }; }
    return DepthState { rest: t, depth: st.depth - 1, ok: true };
}
fn flat_call(st: DepthState, t: FlatList, argc: u64) -> (result: DepthState) {
    if st.depth < argc { return DepthState { rest: FlatList.INil, depth: 0, ok: false }; }
    return DepthState { rest: t, depth: st.depth - argc + 1, ok: true };
}
fn flat_proj(st: DepthState, t: FlatList) -> (result: DepthState) {
    if st.depth < 1 { return DepthState { rest: FlatList.INil, depth: 0, ok: false }; }
    return DepthState { rest: t, depth: st.depth, ok: true };
}

// Whole-unit driver: parse, then duplicate symbols, then the resolve/span
// walk over every function body, then the IR depth self-check over every
// walked expression. Counts are reported for evidence; ir_ok must be true
// whenever ok is true.
record FnsState { rest: FnList, names: NameList, total: u64, ok: bool, bad_start: u64, bad_end: u64, fn_count: u64, exprs: ExprList }
record FnsReport { ok: bool, bad_start: u64, bad_end: u64, fn_count: u64, exprs: ExprList }
record IrState { rest: ExprList, ok: bool, count: u64 }
record IrReport { ok: bool, count: u64 }
record UnitCheck { ok: bool, err_start: u64, err_end: u64, stage: u64, fn_count: u64, expr_count: u64, ir_ok: bool }
fn check_unit(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64) -> (result: UnitCheck) {
    let u: Unit = parse_unit(s0, s1, s2, s3, total);
    if not(u.ok) { return UnitCheck { ok: false, err_start: u.err_start, err_end: u.err_end, stage: 0, fn_count: 0, expr_count: 0, ir_ok: false }; }
    let names: NameList = collect_fn_names(s0, s1, s2, s3, u.fns);
    let dup: DupReport = duplicate_fn_names(s0, s1, s2, s3, total, names);
    if dup.found { return UnitCheck { ok: false, err_start: dup.start, err_end: dup.end, stage: 1, fn_count: 0, expr_count: 0, ir_ok: false }; }
    let fns: FnsReport = check_all_fns(s0, s1, s2, s3, total, u.fns, names);
    if not(fns.ok) { return UnitCheck { ok: false, err_start: fns.bad_start, err_end: fns.bad_end, stage: 2, fn_count: 0, expr_count: 0, ir_ok: false }; }
    let ir: IrReport = verify_ir_exprs(s0, s1, s2, s3, fns.exprs);
    if not(ir.ok) { return UnitCheck { ok: false, err_start: total, err_end: total, stage: 3, fn_count: fns.fn_count, expr_count: ir.count, ir_ok: false }; }
    return UnitCheck { ok: true, err_start: 0, err_end: 0, stage: 4, fn_count: fns.fn_count, expr_count: ir.count, ir_ok: true };
}
fn check_all_fns(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, fns: FnList, names: NameList) -> (result: FnsReport) {
    iterate mi0 over s0 carrying a: FnsState = FnsState { rest: fns, names: names, total: total, ok: true, bad_start: 0, bad_end: 0, fn_count: 0, exprs: ExprList.ENil } {
        next a = check_fns_step(s0, s1, s2, s3, a);
    }
    iterate mi1 over s1 carrying b: FnsState = a {
        next b = check_fns_step(s0, s1, s2, s3, b);
    }
    iterate mi2 over s2 carrying c: FnsState = b {
        next c = check_fns_step(s0, s1, s2, s3, c);
    }
    iterate mi3 over s3 carrying d: FnsState = c {
        next d = check_fns_step(s0, s1, s2, s3, d);
    }
    return FnsReport { ok: d.ok, bad_start: d.bad_start, bad_end: d.bad_end, fn_count: d.fn_count, exprs: d.exprs };
}
fn check_fns_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: FnsState) -> (result: FnsState) {
    if not(st.ok) { return FnsState { rest: FnList.DNil, names: st.names, total: st.total, ok: false, bad_start: st.bad_start, bad_end: st.bad_end, fn_count: st.fn_count, exprs: st.exprs }; }
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => check_one_fn(s0, s1, s2, s3, st, h, t)
    };
}
fn check_one_fn(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: FnsState, h: FnDecl, t: FnList) -> (result: FnsState) {
    let bd: FnBody = h.body;
    let rep: BodyReport = check_body(s0, s1, s2, s3, st.total, bd.body, bd.ret, st.names);
    if not(rep.ok) { return FnsState { rest: FnList.DNil, names: st.names, total: st.total, ok: false, bad_start: rep.bad_start, bad_end: rep.bad_end, fn_count: st.fn_count, exprs: st.exprs }; }
    return FnsState { rest: t, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0, fn_count: st.fn_count + 1, exprs: append_exprs(s0, s1, s2, s3, rep.exprs, st.exprs) };
}
fn verify_ir_exprs(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], exprs: ExprList) -> (result: IrReport) {
    iterate qi0 over s0 carrying a: IrState = IrState { rest: exprs, ok: true, count: 0 } {
        next a = verify_ir_step(s0, s1, s2, s3, a);
    }
    iterate qi1 over s1 carrying b: IrState = a {
        next b = verify_ir_step(s0, s1, s2, s3, b);
    }
    iterate qi2 over s2 carrying c: IrState = b {
        next c = verify_ir_step(s0, s1, s2, s3, c);
    }
    iterate qi3 over s3 carrying d: IrState = c {
        next d = verify_ir_step(s0, s1, s2, s3, d);
    }
    return IrReport { ok: d.ok, count: d.count };
}
fn verify_ir_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: IrState) -> (result: IrState) {
    if not(st.ok) { return IrState { rest: ExprList.ENil, ok: false, count: st.count }; }
    return match st.rest {
        ENil => st,
        ECons { head: h, tail: t } => verify_ir_one(s0, s1, s2, s3, st, h, t)
    };
}
fn verify_ir_one(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: IrState, h: Expr, t: ExprList) -> (result: IrState) {
    let ops: FlatList = lower_expr(s0, s1, s2, s3, h);
    if not(flat_ok(s0, s1, s2, s3, ops)) { return IrState { rest: ExprList.ENil, ok: false, count: st.count }; }
    return IrState { rest: t, ok: true, count: st.count + 1 };
}

// Semantic facts, obligations, and intrinsic proof.
//
// Where check_unit stops at resolution and a structural depth tripwire,
// this section establishes meaning: every function body is checked against
// a bidirectional type discipline mirroring Stage-0 elaboration, and every
// check emits proof obligations as structured values. Proof lives inside
// fact establishment (each checking step is its own narrow authority),
// not in a separate pass.
//
// Obligation statuses: 1 FAIL (fact rejected), 2 UNKNOWN (fact accepted
// conservatively with the obligation retained). PASS leaves no obligation;
// the accepted fact plus its typed IR is the evidence. UNKNOWN never
// silently becomes PASS: any UNKNOWN forces conservative status.
//
// Obligation kinds (differential families against Stage-0 codes):
// 1 NAME_BOUND (MNE102) 2 NAME_TYPE (MNE117) 3 INT_LIT (MNE118)
// 4 BOOL_LIT (MNE122) 5 NO_SHADOW (MNE110) 6 ARITY (MNE132)
// 7 OPERAND_SAME (MNE119) 8 ARITH_INT (MNE120) 9 CMP_INT (MNE121)
// 10 BOOL_OP (MNE181) 11 SHIFT_BASE (MNE190) 12 BYTE_ARITH (MNE191)
// 13 OVERFLOW (checked-arithmetic risk, always UNKNOWN)
// 14 DIV_ZERO (non-literal divisor risk, always UNKNOWN)
// 15 EFFECT_COVER (MNE134) 16 CONTRACT (requires/ensures, always UNKNOWN)
// 17 CAP_AUTH (MNE111) 18 RESULT_ONE (MNE101) 19 TYPE_VALID (MNE105)
// 20 UNREACHABLE (MNE114) 21 FAIL_MODE (MNE113) 22 PROJ_FIELD (MNE162)
// 23 PROJ_BASE (MNE161) 24 IF_BOOL (MNE116) 25 CALL_RESULT (MNE135)
// 26 ARG_MATCH (MNE133) 27 RET_MATCH (MNE103) 28 LET_MATCH (MNE115)
// 29 REC_FIELD (MNE153) 30 ENUM_PAYLOAD (MNE171) 31 QUALIFIED (MNE173)
// 32 CALLEE (MNE131) 33 DUP_FIELD (MNE152) 34 DUP_VARIANT (MNE121 quirk)
// 35 PROJ_TYPE (MNE163) 36 USE_UNAVAIL (MNE173) 37 FN_DUP (MNE104)
record Obligation { kind: u64, start: u64, end: u64, status: u64 }
enum OblList { LNil, LCons { head: Obligation, tail: OblList } }
record OblRev { rest: OblList, acc: OblList }
fn reverse_obls(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: OblList) -> (result: OblList) {
    iterate oi0 over s0 carrying a: OblRev = OblRev { rest: list, acc: OblList.LNil } {
        next a = reverse_obls_step(a);
    }
    iterate oi1 over s1 carrying b: OblRev = a {
        next b = reverse_obls_step(b);
    }
    iterate oi2 over s2 carrying c: OblRev = b {
        next c = reverse_obls_step(c);
    }
    iterate oi3 over s3 carrying d: OblRev = c {
        next d = reverse_obls_step(d);
    }
    return d.acc;
}
fn reverse_obls_step(st: OblRev) -> (result: OblRev) {
    return match st.rest { LNil => st, LCons { head: h, tail: t } => OblRev { rest: t, acc: OblList.LCons { head: h, tail: st.acc } } };
}
record OblPrepend { rest: OblList, acc: OblList }
fn append_obls(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], first: OblList, second: OblList) -> (result: OblList) {
    let rev: OblList = reverse_obls(s0, s1, s2, s3, first);
    iterate oj0 over s0 carrying a: OblPrepend = OblPrepend { rest: rev, acc: second } {
        next a = append_obls_step(a);
    }
    iterate oj1 over s1 carrying b: OblPrepend = a {
        next b = append_obls_step(b);
    }
    iterate oj2 over s2 carrying c: OblPrepend = b {
        next c = append_obls_step(c);
    }
    iterate oj3 over s3 carrying d: OblPrepend = c {
        next d = append_obls_step(d);
    }
    return d.acc;
}
fn append_obls_step(st: OblPrepend) -> (result: OblPrepend) {
    return match st.rest { LNil => st, LCons { head: h, tail: t } => OblPrepend { rest: t, acc: OblList.LCons { head: h, tail: st.acc } } };
}
record OblCount { rest: OblList, n: u64, unknowns: u64, fails: u64 }
fn count_obls(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: OblList) -> (result: OblCount) {
    iterate ok0 over s0 carrying a: OblCount = OblCount { rest: list, n: 0, unknowns: 0, fails: 0 } {
        next a = count_obls_step(a);
    }
    iterate ok1 over s1 carrying b: OblCount = a {
        next b = count_obls_step(b);
    }
    iterate ok2 over s2 carrying c: OblCount = b {
        next c = count_obls_step(c);
    }
    iterate ok3 over s3 carrying d: OblCount = c {
        next d = count_obls_step(d);
    }
    return d;
}
fn count_obls_step(st: OblCount) -> (result: OblCount) {
    return match st.rest {
        LNil => st,
        LCons { head: h, tail: t } => count_obls_cons(st, h, t)
    };
}
fn count_obls_cons(st: OblCount, h: Obligation, t: OblList) -> (result: OblCount) {
    if h.status == 2 { return OblCount { rest: t, n: st.n + 1, unknowns: st.unknowns + 1, fails: st.fails }; }
    return OblCount { rest: t, n: st.n + 1, unknowns: st.unknowns, fails: st.fails + 1 };
}

// Resolved semantic types. Named carries the declaration name span;
// Seq is opaque (element validity is established at resolution; no index
// expressions exist in this subset). TPoison marks error recovery: checks
// against poison are skipped so one error does not cascade.
enum SemType {
    TBool,
    TByte,
    TInt { width: u64, signed: bool },
    TNamed { start: u64, end: u64 },
    TSeq,
    TPoison
}
// Required-type input for bidirectional checking: absent, or present.
enum ExpTy { XNone, XSome { ty: SemType } }
fn is_poison(ty: SemType) -> (result: bool) {
    return match ty { TPoison => true, TBool => false, TByte => false, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TSeq => false };
}
fn sem_eq(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, a: SemType, b: SemType) -> (result: bool) {
    return match a {
        TBool => sem_eq_bool(b),
        TByte => sem_eq_byte(b),
        TInt { width: w, signed: s } => sem_eq_int(b, w, s),
        TNamed { start: s, end: e } => sem_eq_named(s0, s1, s2, s3, total, b, s, e),
        TSeq => sem_eq_seq(b),
        TPoison => sem_eq_poison(b)
    };
}
fn sem_eq_poison(b: SemType) -> (result: bool) {
    return match b { TPoison => true, TBool => false, TByte => false, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TSeq => false };
}
fn sem_eq_bool(b: SemType) -> (result: bool) {
    return match b { TBool => true, TByte => false, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TSeq => false, TPoison => false };
}
fn sem_eq_byte(b: SemType) -> (result: bool) {
    return match b { TBool => false, TByte => true, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TSeq => false, TPoison => false };
}
fn sem_eq_int(b: SemType, w: u64, s: bool) -> (result: bool) {
    return match b {
        TInt { width: w2, signed: s2 } => int_eq_extra(w, w2, s, s2),
        TBool => false,
        TByte => false,
        TNamed { start: s3, end: e3 } => false,
        TSeq => false,
        TPoison => false
    };
}
// Boolean conjunction without `==` on booleans (Stage-0 rejects boolean
// equality, so the compiler itself cannot use it).
fn int_eq_extra(w: u64, w2: u64, s: bool, s2: bool) -> (result: bool) {
    if w != w2 { return false; }
    if s { return s2; }
    return not(s2);
}
fn sem_eq_named(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, b: SemType, s: u64, e: u64) -> (result: bool) {
    return match b {
        TNamed { start: q2, end: g2 } => spans_equal(s0, s1, s2, s3, total, s, e, q2, g2),
        TBool => false,
        TByte => false,
        TInt { width: w, signed: g } => false,
        TSeq => false,
        TPoison => false
    };
}
fn sem_eq_seq(b: SemType) -> (result: bool) {
    return match b { TSeq => true, TBool => false, TByte => false, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TPoison => false };
}
fn is_int_ty(ty: SemType) -> (result: bool) {
    return match ty { TInt { width: w, signed: s } => true, TBool => false, TByte => false, TNamed { start: s, end: e } => false, TSeq => false, TPoison => false };
}
fn is_bool_ty(ty: SemType) -> (result: bool) {
    return match ty { TBool => true, TByte => false, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TSeq => false, TPoison => false };
}

// Lexical scopes. Bindings never leak out of a block: each if/else branch
// is checked under a pushed scope that is discarded afterward, while the
// function top level shares one scope with its parameters (Stage-0
// MNE110/MNE102 behavior). Rebinding in the same scope keeps the FIRST
// binding and records the obligation; the later declaration is dropped.
record Bind { start: u64, end: u64, ty: SemType }
enum BindList { BNil, BCons { head: Bind, tail: BindList } }
record Scope { binds: BindList }
enum ScopeStack { ZNil, ZCons { head: Scope, tail: ScopeStack } }
record LookupRes { found: bool, ty: SemType }
record ScopeLookup { rest: BindList, start: u64, end: u64, found: bool, ty: SemType }
fn scope_lookup(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, binds: BindList, start: u64, end: u64) -> (result: LookupRes) {
    iterate sl0 over s0 carrying a: ScopeLookup = ScopeLookup { rest: binds, start: start, end: end, found: false, ty: SemType.TPoison } {
        next a = scope_lookup_step(s0, s1, s2, s3, total, a);
    }
    iterate sl1 over s1 carrying b: ScopeLookup = a {
        next b = scope_lookup_step(s0, s1, s2, s3, total, b);
    }
    iterate sl2 over s2 carrying c: ScopeLookup = b {
        next c = scope_lookup_step(s0, s1, s2, s3, total, c);
    }
    iterate sl3 over s3 carrying d: ScopeLookup = c {
        next d = scope_lookup_step(s0, s1, s2, s3, total, d);
    }
    return LookupRes { found: d.found, ty: d.ty };
}
fn scope_lookup_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ScopeLookup) -> (result: ScopeLookup) {
    if st.found { return st; }
    return match st.rest {
        BNil => st,
        BCons { head: h, tail: t } => scope_lookup_cons(s0, s1, s2, s3, total, st, h, t)
    };
}
fn scope_lookup_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ScopeLookup, h: Bind, t: BindList) -> (result: ScopeLookup) {
    if spans_equal(s0, s1, s2, s3, total, h.start, h.end, st.start, st.end) {
        return ScopeLookup { rest: BindList.BNil, start: st.start, end: st.end, found: true, ty: h.ty };
    }
    return ScopeLookup { rest: t, start: st.start, end: st.end, found: false, ty: SemType.TPoison };
}
record EnvLookup { rest: ScopeStack, start: u64, end: u64, found: bool, ty: SemType }
fn env_lookup(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ScopeStack, start: u64, end: u64) -> (result: LookupRes) {
    iterate el0 over s0 carrying a: EnvLookup = EnvLookup { rest: st, start: start, end: end, found: false, ty: SemType.TPoison } {
        next a = env_lookup_step(s0, s1, s2, s3, total, a);
    }
    iterate el1 over s1 carrying b: EnvLookup = a {
        next b = env_lookup_step(s0, s1, s2, s3, total, b);
    }
    iterate el2 over s2 carrying c: EnvLookup = b {
        next c = env_lookup_step(s0, s1, s2, s3, total, c);
    }
    iterate el3 over s3 carrying d: EnvLookup = c {
        next d = env_lookup_step(s0, s1, s2, s3, total, d);
    }
    return LookupRes { found: d.found, ty: d.ty };
}
fn env_lookup_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: EnvLookup) -> (result: EnvLookup) {
    if st.found { return st; }
    return match st.rest {
        ZNil => st,
        ZCons { head: h, tail: t } => env_lookup_cons(s0, s1, s2, s3, total, st, h, t)
    };
}
fn env_lookup_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: EnvLookup, h: Scope, t: ScopeStack) -> (result: EnvLookup) {
    let got: LookupRes = scope_lookup(s0, s1, s2, s3, total, h.binds, st.start, st.end);
    if got.found { return EnvLookup { rest: ScopeStack.ZNil, start: st.start, end: st.end, found: true, ty: got.ty }; }
    return EnvLookup { rest: t, start: st.start, end: st.end, found: false, ty: SemType.TPoison };
}
record BindRes { dup: bool, stack: ScopeStack }
fn env_bind_current(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ScopeStack, start: u64, end: u64, ty: SemType) -> (result: BindRes) {
    return match st {
        ZNil => BindRes { dup: false, stack: ScopeStack.ZCons { head: Scope { binds: BindList.BCons { head: Bind { start: start, end: end, ty: ty }, tail: BindList.BNil } }, tail: ScopeStack.ZNil } },
        ZCons { head: h, tail: t } => env_bind_scope(s0, s1, s2, s3, total, h, t, start, end, ty)
    };
}
fn env_bind_scope(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, h: Scope, t: ScopeStack, start: u64, end: u64, ty: SemType) -> (result: BindRes) {
    let got: LookupRes = scope_lookup(s0, s1, s2, s3, total, h.binds, start, end);
    if got.found { return BindRes { dup: true, stack: ScopeStack.ZCons { head: h, tail: t } }; }
    return BindRes { dup: false, stack: ScopeStack.ZCons { head: Scope { binds: BindList.BCons { head: Bind { start: start, end: end, ty: ty }, tail: h.binds } }, tail: t } };
}
fn push_scope(st: ScopeStack) -> (result: ScopeStack) {
    return ScopeStack.ZCons { head: Scope { binds: BindList.BNil }, tail: st };
}

// Extended integer spellings (u8/u16/u32/i8/i16/i32/i64) arrive as named
// type references; anything else falls through to record/enum resolution
// by returning the name itself as a TNamed candidate.
fn scalar_sem(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64) -> (result: SemType) {
    if end < start { return SemType.TNamed { start: start, end: end }; }
    if end - start < 2 || end - start > 3 { return SemType.TNamed { start: start, end: end }; }
    let b0: u64 = segment.byte_at(s0, s1, s2, s3, total, start);
    if b0 != 117 && b0 != 105 { return SemType.TNamed { start: start, end: end }; }
    if not(span_digits(s0, s1, s2, s3, total, start + 1, end)) { return SemType.TNamed { start: start, end: end }; }
    let val: IntVal = int_value(s0, s1, s2, s3, total, start + 1, end);
    if val.overflow { return SemType.TNamed { start: start, end: end }; }
    if val.value == 8 || val.value == 16 || val.value == 32 || val.value == 64 {
        return SemType.TInt { width: val.value, signed: b0 == 105 };
    }
    return SemType.TNamed { start: start, end: end };
}
record DigitCheck { pos: u64, end: u64, ok: bool }
fn span_digits(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64) -> (result: bool) {
    iterate dg0 over s0 carrying a: DigitCheck = DigitCheck { pos: start, end: end, ok: true } {
        next a = span_digits_step(s0, s1, s2, s3, total, a);
    }
    iterate dg1 over s1 carrying b: DigitCheck = a {
        next b = span_digits_step(s0, s1, s2, s3, total, b);
    }
    iterate dg2 over s2 carrying c: DigitCheck = b {
        next c = span_digits_step(s0, s1, s2, s3, total, c);
    }
    iterate dg3 over s3 carrying d: DigitCheck = c {
        next d = span_digits_step(s0, s1, s2, s3, total, d);
    }
    return d.ok && d.pos >= d.end;
}
fn span_digits_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: DigitCheck) -> (result: DigitCheck) {
    if not(st.ok) || st.pos >= st.end { return st; }
    let byte: u64 = segment.byte_at(s0, s1, s2, s3, total, st.pos);
    if byte < 48 || byte > 57 { return DigitCheck { pos: st.pos, end: st.end, ok: false }; }
    return DigitCheck { pos: st.pos + 1, end: st.end, ok: true };
}
// Type resolution against scalar spellings and the declared record/enum
// tables. Qualified (kind 6) and unknown (kind 9) spellings fail here; the
// caller selects the diagnostic family (MNE105/MNE153/MNE171/MNE173).
record TyRes { ty: SemType, ok: bool }
fn resolve_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, kind: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList) -> (result: TyRes) {
    if kind == 3 { return TyRes { ty: SemType.TBool, ok: true }; }
    if kind == 4 { return TyRes { ty: SemType.TByte, ok: true }; }
    if kind == 1 { return TyRes { ty: SemType.TInt { width: 64, signed: false }, ok: true }; }
    if kind == 2 { return TyRes { ty: SemType.TInt { width: 64, signed: true }, ok: true }; }
    if kind == 7 || kind == 8 { return resolve_seq_type(s0, s1, s2, s3, total, start, end, rectab, enumtab); }
    if kind == 5 { return resolve_named_type(s0, s1, s2, s3, total, start, end, rectab, enumtab); }
    return TyRes { ty: SemType.TPoison, ok: false };
}
fn resolve_seq_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList) -> (result: TyRes) {
    let elem: TypeParse = parse_type(s0, s1, s2, s3, total, start + 1);
    if not(elem.ok) { return TyRes { ty: SemType.TPoison, ok: false }; }
    // No back-call into resolve_type (MNE130): sequence elements are flat
    // by construction (the parser rejects nested `[`), so the element is
    // resolved by the flat case split below.
    if elem.node.kind == 7 || elem.node.kind == 8 { return TyRes { ty: SemType.TSeq, ok: true }; }
    if elem.node.kind == 1 || elem.node.kind == 2 || elem.node.kind == 3 || elem.node.kind == 4 { return TyRes { ty: SemType.TSeq, ok: true }; }
    if elem.node.kind == 5 { return resolve_seq_elem(s0, s1, s2, s3, total, elem.node.start, elem.node.end, rectab, enumtab); }
    return TyRes { ty: SemType.TPoison, ok: false };
}
fn resolve_seq_elem(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList) -> (result: TyRes) {
    let inner: TyRes = resolve_named_type(s0, s1, s2, s3, total, start, end, rectab, enumtab);
    if not(inner.ok) { return TyRes { ty: SemType.TPoison, ok: false }; }
    return TyRes { ty: SemType.TSeq, ok: true };
}
fn resolve_named_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList) -> (result: TyRes) {
    let sc: SemType = scalar_sem(s0, s1, s2, s3, total, start, end);
    return match sc {
        TNamed { start: n, end: m } => resolve_declared_type(s0, s1, s2, s3, total, n, m, rectab, enumtab),
        TBool => TyRes { ty: SemType.TBool, ok: true },
        TByte => TyRes { ty: SemType.TByte, ok: true },
        TInt { width: w, signed: g } => TyRes { ty: SemType.TInt { width: w, signed: g }, ok: true },
        TSeq => TyRes { ty: SemType.TSeq, ok: true },
        TPoison => TyRes { ty: SemType.TPoison, ok: false }
    };
}
fn resolve_declared_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList) -> (result: TyRes) {
    if record_declared(s0, s1, s2, s3, total, rectab, start, end) { return TyRes { ty: SemType.TNamed { start: start, end: end }, ok: true }; }
    if enum_declared(s0, s1, s2, s3, total, enumtab, start, end) { return TyRes { ty: SemType.TNamed { start: start, end: end }, ok: true }; }
    return TyRes { ty: SemType.TPoison, ok: false };
}
fn record_declared(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, rectab: RecordList, start: u64, end: u64) -> (result: bool) {
    iterate rd0 over s0 carrying a: RecScan = RecScan { rest: rectab, start: start, end: end, found: false } {
        next a = record_declared_step(s0, s1, s2, s3, total, a);
    }
    iterate rd1 over s1 carrying b: RecScan = a {
        next b = record_declared_step(s0, s1, s2, s3, total, b);
    }
    iterate rd2 over s2 carrying c: RecScan = b {
        next c = record_declared_step(s0, s1, s2, s3, total, c);
    }
    iterate rd3 over s3 carrying d: RecScan = c {
        next d = record_declared_step(s0, s1, s2, s3, total, d);
    }
    return d.found;
}
record RecScan { rest: RecordList, start: u64, end: u64, found: bool }
fn record_declared_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: RecScan) -> (result: RecScan) {
    if st.found { return st; }
    return match st.rest {
        RNil => st,
        RCons { head: h, tail: t } => record_declared_cons(s0, s1, s2, s3, total, st, h, t)
    };
}
fn record_declared_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: RecScan, h: RecordDecl, t: RecordList) -> (result: RecScan) {
    if spans_equal(s0, s1, s2, s3, total, h.name_start, h.name_end, st.start, st.end) {
        return RecScan { rest: RecordList.RNil, start: st.start, end: st.end, found: true };
    }
    return RecScan { rest: t, start: st.start, end: st.end, found: false };
}
fn enum_declared(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, enumtab: EnumList, start: u64, end: u64) -> (result: bool) {
    iterate ed0 over s0 carrying a: EnumScan = EnumScan { rest: enumtab, start: start, end: end, found: false } {
        next a = enum_declared_step(s0, s1, s2, s3, total, a);
    }
    iterate ed1 over s1 carrying b: EnumScan = a {
        next b = enum_declared_step(s0, s1, s2, s3, total, b);
    }
    iterate ed2 over s2 carrying c: EnumScan = b {
        next c = enum_declared_step(s0, s1, s2, s3, total, c);
    }
    iterate ed3 over s3 carrying d: EnumScan = c {
        next d = enum_declared_step(s0, s1, s2, s3, total, d);
    }
    return d.found;
}
record EnumScan { rest: EnumList, start: u64, end: u64, found: bool }
fn enum_declared_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: EnumScan) -> (result: EnumScan) {
    if st.found { return st; }
    return match st.rest {
        GNil => st,
        GCons { head: h, tail: t } => enum_declared_cons(s0, s1, s2, s3, total, st, h, t)
    };
}
fn enum_declared_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: EnumScan, h: EnumDecl, t: EnumList) -> (result: EnumScan) {
    if spans_equal(s0, s1, s2, s3, total, h.name_start, h.name_end, st.start, st.end) {
        return EnumScan { rest: EnumList.GNil, start: st.start, end: st.end, found: true };
    }
    return EnumScan { rest: t, start: st.start, end: st.end, found: false };
}

// Function signatures: parameter/result type validity, exactly-one-result,
// capability declaration with keep-first duplicate handling, effect
// authority against declared capabilities, and contract clauses recorded
// as retained UNKNOWN assumptions (Stage-0 never rejects them, not even
// for undeclared names or mismatched arities).
record Sig { start: u64, end: u64, params: BindList, nparams: u64, result: SemType, fx: EffectList }
enum SigTab { HNil, HCons { head: Sig, tail: SigTab } }
record SigRep { sig: Sig, obls: OblList }
fn check_sig(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, h: FnDecl, rectab: RecordList, enumtab: EnumList) -> (result: SigRep) {
    let sg: FnSig = h.sig;
    let ps: ParamRep = check_params(s0, s1, s2, s3, total, sg.params, rectab, enumtab);
    let rs: ResultRep = check_results(s0, s1, s2, s3, total, sg.results, h.fn_start, h.fn_end, rectab, enumtab);
    let cs: CapRep = check_caps(s0, s1, s2, s3, total, sg.capabilities);
    let es: FxRep = check_effects(s0, s1, s2, s3, total, sg.effects, cs.caps);
    let ks: OblList = check_contracts(s0, s1, s2, s3, sg.contracts);
    let o1: OblList = append_obls(s0, s1, s2, s3, ps.obls, rs.obls);
    let o2: OblList = append_obls(s0, s1, s2, s3, o1, cs.obls);
    let o3: OblList = append_obls(s0, s1, s2, s3, o2, es.obls);
    let obls: OblList = append_obls(s0, s1, s2, s3, o3, ks);
    return SigRep { sig: Sig { start: sg.name_start, end: sg.name_end, params: ps.binds, nparams: ps.n, result: rs.ty, fx: es.fx }, obls: obls };
}
record ParamRep { binds: BindList, n: u64, obls: OblList }
record ParamState { rest: FieldList, binds: BindList, seen: NameList, n: u64, obls: OblList }
fn check_params(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, params: FieldList, rectab: RecordList, enumtab: EnumList) -> (result: ParamRep) {
    iterate pm0 over s0 carrying a: ParamState = ParamState { rest: params, binds: BindList.BNil, seen: NameList.NNil, n: 0, obls: OblList.LNil } {
        next a = check_params_step(s0, s1, s2, s3, total, a, rectab, enumtab);
    }
    iterate pm1 over s1 carrying b: ParamState = a {
        next b = check_params_step(s0, s1, s2, s3, total, b, rectab, enumtab);
    }
    iterate pm2 over s2 carrying c: ParamState = b {
        next c = check_params_step(s0, s1, s2, s3, total, c, rectab, enumtab);
    }
    iterate pm3 over s3 carrying d: ParamState = c {
        next d = check_params_step(s0, s1, s2, s3, total, d, rectab, enumtab);
    }
    return ParamRep { binds: d.binds, n: d.n, obls: reverse_obls(s0, s1, s2, s3, d.obls) };
}
fn check_params_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ParamState, rectab: RecordList, enumtab: EnumList) -> (result: ParamState) {
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => check_one_param(s0, s1, s2, s3, total, st, h, t, rectab, enumtab)
    };
}
fn check_one_param(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ParamState, h: Field, t: FieldList, rectab: RecordList, enumtab: EnumList) -> (result: ParamState) {
    let ty: TyRes = resolve_type(s0, s1, s2, s3, total, h.type_kind, h.type_start, h.type_end, rectab, enumtab);
    let tob: OblList = param_type_obl(h, ty);
    if name_known(s0, s1, s2, s3, total, st.seen, h.name_start, h.name_end) {
        let dob: Obligation = Obligation { kind: 5, start: h.name_start, end: h.name_end, status: 1 };
        return ParamState { rest: t, binds: st.binds, seen: st.seen, n: st.n, obls: OblList.LCons { head: dob, tail: append_obls(s0, s1, s2, s3, tob, st.obls) } };
    }
    let seen: NameList = NameList.NCons { head: NameSpan { start: h.name_start, end: h.name_end }, tail: st.seen };
    let bound: SemType = param_bound_type(ty);
    let binds: BindList = BindList.BCons { head: Bind { start: h.name_start, end: h.name_end, ty: bound }, tail: st.binds };
    return ParamState { rest: t, binds: binds, seen: seen, n: st.n + 1, obls: append_obls(s0, s1, s2, s3, tob, st.obls) };
}
fn param_type_obl(h: Field, ty: TyRes) -> (result: OblList) {
    if ty.ok { return OblList.LNil; }
    if h.type_kind == 6 { return OblList.LCons { head: Obligation { kind: 31, start: h.type_start, end: h.type_end, status: 1 }, tail: OblList.LNil }; }
    return OblList.LCons { head: Obligation { kind: 19, start: h.type_start, end: h.type_end, status: 1 }, tail: OblList.LNil };
}
fn param_bound_type(ty: TyRes) -> (result: SemType) {
    if ty.ok { return ty.ty; }
    return SemType.TPoison;
}
record ResultRep { ty: SemType, obls: OblList }
record ResultState { rest: FieldList, n: u64, ty: SemType, obls: OblList }
fn check_results(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, results: FieldList, fn_start: u64, fn_end: u64, rectab: RecordList, enumtab: EnumList) -> (result: ResultRep) {
    iterate rs0 over s0 carrying a: ResultState = ResultState { rest: results, n: 0, ty: SemType.TPoison, obls: OblList.LNil } {
        next a = check_results_step(s0, s1, s2, s3, total, a, rectab, enumtab);
    }
    iterate rs1 over s1 carrying b: ResultState = a {
        next b = check_results_step(s0, s1, s2, s3, total, b, rectab, enumtab);
    }
    iterate rs2 over s2 carrying c: ResultState = b {
        next c = check_results_step(s0, s1, s2, s3, total, c, rectab, enumtab);
    }
    iterate rs3 over s3 carrying d: ResultState = c {
        next d = check_results_step(s0, s1, s2, s3, total, d, rectab, enumtab);
    }
    return finish_results(s0, s1, s2, s3, d, fn_start, fn_end);
}
fn check_results_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ResultState, rectab: RecordList, enumtab: EnumList) -> (result: ResultState) {
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => check_one_result(s0, s1, s2, s3, total, st, h, t, rectab, enumtab)
    };
}
fn check_one_result(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: ResultState, h: Field, t: FieldList, rectab: RecordList, enumtab: EnumList) -> (result: ResultState) {
    let ty: TyRes = resolve_type(s0, s1, s2, s3, total, h.type_kind, h.type_start, h.type_end, rectab, enumtab);
    let tob: OblList = param_type_obl(h, ty);
    let bound: SemType = param_bound_type(ty);
    let kept: SemType = result_kept_type(st, bound);
    return ResultState { rest: t, n: st.n + 1, ty: kept, obls: append_obls(s0, s1, s2, s3, tob, st.obls) };
}
fn result_kept_type(st: ResultState, bound: SemType) -> (result: SemType) {
    if st.n == 0 { return bound; }
    return st.ty;
}
fn finish_results(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: ResultState, fn_start: u64, fn_end: u64) -> (result: ResultRep) {
    let ordered: OblList = reverse_obls(s0, s1, s2, s3, st.obls);
    if st.n == 1 { return ResultRep { ty: st.ty, obls: ordered }; }
    let obl: Obligation = Obligation { kind: 18, start: fn_start, end: fn_end, status: 1 };
    return ResultRep { ty: SemType.TPoison, obls: append_obls(s0, s1, s2, s3, ordered, OblList.LCons { head: obl, tail: OblList.LNil }) };
}
record CapRep { caps: NameList, obls: OblList }
record CapState { rest: CapList, caps: NameList, obls: OblList }
fn check_caps(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, caps: CapList) -> (result: CapRep) {
    iterate cp0 over s0 carrying a: CapState = CapState { rest: caps, caps: NameList.NNil, obls: OblList.LNil } {
        next a = check_caps_step(s0, s1, s2, s3, total, a);
    }
    iterate cp1 over s1 carrying b: CapState = a {
        next b = check_caps_step(s0, s1, s2, s3, total, b);
    }
    iterate cp2 over s2 carrying c: CapState = b {
        next c = check_caps_step(s0, s1, s2, s3, total, c);
    }
    iterate cp3 over s3 carrying d: CapState = c {
        next d = check_caps_step(s0, s1, s2, s3, total, d);
    }
    return CapRep { caps: d.caps, obls: reverse_obls(s0, s1, s2, s3, d.obls) };
}
fn check_caps_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: CapState) -> (result: CapState) {
    return match st.rest {
        ANil => st,
        ACons { head: h, tail: t } => check_one_cap(s0, s1, s2, s3, total, st, h, t)
    };
}
fn check_one_cap(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: CapState, h: Cap, t: CapList) -> (result: CapState) {
    if name_known(s0, s1, s2, s3, total, st.caps, h.start, h.end) {
        let obl: Obligation = Obligation { kind: 5, start: h.start, end: h.end, status: 1 };
        return CapState { rest: t, caps: st.caps, obls: OblList.LCons { head: obl, tail: st.obls } };
    }
    let caps: NameList = NameList.NCons { head: NameSpan { start: h.start, end: h.end }, tail: st.caps };
    return CapState { rest: t, caps: caps, obls: st.obls };
}
record FxRep { fx: EffectList, obls: OblList }
record FxState { rest: EffectList, fx: EffectList, obls: OblList }
fn check_effects(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, effects: EffectList, caps: NameList) -> (result: FxRep) {
    iterate fx0 over s0 carrying a: FxState = FxState { rest: effects, fx: EffectList.XNil, obls: OblList.LNil } {
        next a = check_effects_step(s0, s1, s2, s3, total, a, caps);
    }
    iterate fx1 over s1 carrying b: FxState = a {
        next b = check_effects_step(s0, s1, s2, s3, total, b, caps);
    }
    iterate fx2 over s2 carrying c: FxState = b {
        next c = check_effects_step(s0, s1, s2, s3, total, c, caps);
    }
    iterate fx3 over s3 carrying d: FxState = c {
        next d = check_effects_step(s0, s1, s2, s3, total, d, caps);
    }
    return FxRep { fx: reverse_effects(s0, s1, s2, s3, d.fx), obls: reverse_obls(s0, s1, s2, s3, d.obls) };
}
fn check_effects_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: FxState, caps: NameList) -> (result: FxState) {
    return match st.rest {
        XNil => st,
        XCons { head: h, tail: t } => check_one_effect(s0, s1, s2, s3, total, st, h, t, caps)
    };
}
fn check_one_effect(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: FxState, h: Effect, t: EffectList, caps: NameList) -> (result: FxState) {
    if name_known(s0, s1, s2, s3, total, caps, h.cap_start, h.cap_end) {
        return FxState { rest: t, fx: EffectList.XCons { head: h, tail: st.fx }, obls: st.obls };
    }
    let obl: Obligation = Obligation { kind: 17, start: h.kind_start, end: h.cap_end, status: 1 };
    return FxState { rest: t, fx: st.fx, obls: OblList.LCons { head: obl, tail: st.obls } };
}
record ClauseState { rest: ClauseList, obls: OblList }
fn check_contracts(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], clauses: ClauseList) -> (result: OblList) {
    iterate kc0 over s0 carrying a: ClauseState = ClauseState { rest: clauses, obls: OblList.LNil } {
        next a = check_contracts_step(a);
    }
    iterate kc1 over s1 carrying b: ClauseState = a {
        next b = check_contracts_step(b);
    }
    iterate kc2 over s2 carrying c: ClauseState = b {
        next c = check_contracts_step(c);
    }
    iterate kc3 over s3 carrying d: ClauseState = c {
        next d = check_contracts_step(d);
    }
    return reverse_obls(s0, s1, s2, s3, d.obls);
}
fn check_contracts_step(st: ClauseState) -> (result: ClauseState) {
    return match st.rest {
        CNil => st,
        CCons { head: h, tail: t } => ClauseState { rest: t, obls: OblList.LCons { head: Obligation { kind: 16, start: h.kind_start, end: h.name_end, status: 2 }, tail: st.obls } }
    };
}
// Declaration tables: uses are unavailable without a module system
// (MNE173, matching the oracle in this environment); enum payloads admit
// scalars and declared nominals but no sequences; record fields admit
// sequences with valid elements.
fn check_uses(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], uses: UseList) -> (result: OblList) {
    iterate us0 over s0 carrying a: UseState = UseState { rest: uses, obls: OblList.LNil } {
        next a = check_uses_step(a);
    }
    iterate us1 over s1 carrying b: UseState = a {
        next b = check_uses_step(b);
    }
    iterate us2 over s2 carrying c: UseState = b {
        next c = check_uses_step(c);
    }
    iterate us3 over s3 carrying d: UseState = c {
        next d = check_uses_step(d);
    }
    return reverse_obls(s0, s1, s2, s3, d.obls);
}
record UseState { rest: UseList, obls: OblList }
fn check_uses_step(st: UseState) -> (result: UseState) {
    return match st.rest {
        UNil => st,
        UCons { head: h, tail: t } => UseState { rest: t, obls: OblList.LCons { head: Obligation { kind: 36, start: h.module_start, end: h.module_end, status: 1 }, tail: st.obls } }
    };
}

// Typed stack IR with provenance. Every operation carries its source span
// and its established type, so an IR operation stays related to the
// semantic expression it came from. The type-stack verifier below is a
// narrow authority: it checks operand depth, binary operand equality, and
// the final type, but it does NOT re-derive operator typing (that proof
// belongs to the checking step that emitted the operation). It rejects
// poisoned types: poison only arises alongside a recorded FAIL, so
// poisoned IR is never verified.
enum TOp {
    TInt { value: u64, ty: SemType, start: u64, end: u64 },
    TBool { value: bool, ty: SemType, start: u64, end: u64 },
    TName { ty: SemType, start: u64, end: u64 },
    TBin { op: u64, ty: SemType, start: u64, end: u64 },
    TCall { ty: SemType, argc: u64, start: u64, end: u64, ns: u64, ne: u64 },
    TProj { ty: SemType, fstart: u64, fend: u64, start: u64, end: u64 }
}
enum TOpList { PNil, PCons { head: TOp, tail: TOpList } }
enum TopsList { TLNil, TLCons { head: TOpList, tail: TopsList } }
enum TyList { TyNil, TyCons { head: SemType, tail: TyList } }
enum TyStack { WNil, WCons { head: SemType, tail: TyStack } }
record TopsRev { rest: TOpList, acc: TOpList }
fn reverse_tops(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: TOpList) -> (result: TOpList) {
    iterate tp0 over s0 carrying a: TopsRev = TopsRev { rest: list, acc: TOpList.PNil } {
        next a = reverse_tops_step(a);
    }
    iterate tp1 over s1 carrying b: TopsRev = a {
        next b = reverse_tops_step(b);
    }
    iterate tp2 over s2 carrying c: TopsRev = b {
        next c = reverse_tops_step(c);
    }
    iterate tp3 over s3 carrying d: TopsRev = c {
        next d = reverse_tops_step(d);
    }
    return d.acc;
}
fn reverse_tops_step(st: TopsRev) -> (result: TopsRev) {
    return match st.rest { PNil => st, PCons { head: h, tail: t } => TopsRev { rest: t, acc: TOpList.PCons { head: h, tail: st.acc } } };
}
record TopsPrepend { rest: TOpList, acc: TOpList }
fn append_tops(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], first: TOpList, second: TOpList) -> (result: TOpList) {
    let rev: TOpList = reverse_tops(s0, s1, s2, s3, first);
    iterate tq0 over s0 carrying a: TopsPrepend = TopsPrepend { rest: rev, acc: second } {
        next a = append_tops_step(a);
    }
    iterate tq1 over s1 carrying b: TopsPrepend = a {
        next b = append_tops_step(b);
    }
    iterate tq2 over s2 carrying c: TopsPrepend = b {
        next c = append_tops_step(c);
    }
    iterate tq3 over s3 carrying d: TopsPrepend = c {
        next d = append_tops_step(d);
    }
    return d.acc;
}
fn append_tops_step(st: TopsPrepend) -> (result: TopsPrepend) {
    return match st.rest { PNil => st, PCons { head: h, tail: t } => TopsPrepend { rest: t, acc: TOpList.PCons { head: h, tail: st.acc } } };
}
record TopsCount { rest: TOpList, n: u64 }
fn count_tops(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: TOpList) -> (result: u64) {
    iterate tc0 over s0 carrying a: TopsCount = TopsCount { rest: list, n: 0 } {
        next a = count_tops_step(a);
    }
    iterate tc1 over s1 carrying b: TopsCount = a {
        next b = count_tops_step(b);
    }
    iterate tc2 over s2 carrying c: TopsCount = b {
        next c = count_tops_step(c);
    }
    iterate tc3 over s3 carrying d: TopsCount = c {
        next d = count_tops_step(d);
    }
    return d.n;
}
fn count_tops_step(st: TopsCount) -> (result: TopsCount) {
    return match st.rest { PNil => st, PCons { head: h, tail: t } => TopsCount { rest: t, n: st.n + 1 } };
}
// Type-stack verification: pushes add one typed slot; TBin needs two
// equal operand types; TCall needs argc slots; TProj is depth-neutral.
// A well-formed lowering of one expression ends at depth exactly one;
// when a final type is required it must equal the established type.
record TDepth { rest: TOpList, stack: TyStack, depth: u64, ok: bool }
fn verify_tops(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, ops: TOpList, want: ExpTy) -> (result: bool) {
    iterate tv0 over s0 carrying a: TDepth = TDepth { rest: ops, stack: TyStack.WNil, depth: 0, ok: true } {
        next a = verify_tops_step(s0, s1, s2, s3, total, a);
    }
    iterate tv1 over s1 carrying b: TDepth = a {
        next b = verify_tops_step(s0, s1, s2, s3, total, b);
    }
    iterate tv2 over s2 carrying c: TDepth = b {
        next c = verify_tops_step(s0, s1, s2, s3, total, c);
    }
    iterate tv3 over s3 carrying d: TDepth = c {
        next d = verify_tops_step(s0, s1, s2, s3, total, d);
    }
    return finish_verify_tops(s0, s1, s2, s3, total, d, want);
}
fn verify_tops_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: TDepth) -> (result: TDepth) {
    if not(st.ok) { return st; }
    return match st.rest {
        PNil => st,
        PCons { head: h, tail: t } => verify_top_one(s0, s1, s2, s3, total, st, h, t)
    };
}
fn verify_top_one(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: TDepth, h: TOp, t: TOpList) -> (result: TDepth) {
    return match h {
        TInt { value: v, ty: ty, start: s, end: e } => verify_top_push(st, t, ty),
        TBool { value: v, ty: ty, start: s, end: e } => verify_top_push(st, t, ty),
        TName { ty: ty, start: s, end: e } => verify_top_push(st, t, ty),
        TBin { op: o, ty: ty, start: s, end: e } => verify_top_bin(s0, s1, s2, s3, total, st, t, ty),
        TCall { ty: ty, argc: c, start: s, end: e, ns: ns, ne: ne } => verify_top_call(s0, s1, s2, s3, st, t, ty, c),
        TProj { ty: ty, fstart: fs, fend: fe, start: s, end: e } => verify_top_proj(st, t, ty)
    };
}
fn verify_top_push(st: TDepth, t: TOpList, ty: SemType) -> (result: TDepth) {
    if is_poison(ty) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: st.stack }, depth: st.depth + 1, ok: true };
}
fn verify_top_bin(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: TDepth, t: TOpList, ty: SemType) -> (result: TDepth) {
    if is_poison(ty) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return match st.stack {
        WNil => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        WCons { head: h1, tail: t1 } => verify_top_bin_inner(s0, s1, s2, s3, total, st, t, ty, h1, t1)
    };
}
fn verify_top_bin_inner(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: TDepth, t: TOpList, ty: SemType, h1: SemType, t1: TyStack) -> (result: TDepth) {
    return match t1 {
        WNil => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        WCons { head: h2, tail: t2 } => verify_top_bin_eq(s0, s1, s2, s3, total, st, t, ty, h1, h2, t2)
    };
}
fn verify_top_bin_eq(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: TDepth, t: TOpList, ty: SemType, h1: SemType, h2: SemType, t2: TyStack) -> (result: TDepth) {
    if not(sem_eq(s0, s1, s2, s3, total, h1, h2)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: t2 }, depth: st.depth - 1, ok: true };
}
record PopN { rest: TyStack, n: u64, ok: bool }
fn pop_tys(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], stack: TyStack, n: u64) -> (result: PopN) {
    iterate pn0 over s0 carrying a: PopN = PopN { rest: stack, n: n, ok: true } {
        next a = pop_tys_step(a);
    }
    iterate pn1 over s1 carrying b: PopN = a {
        next b = pop_tys_step(b);
    }
    iterate pn2 over s2 carrying c: PopN = b {
        next c = pop_tys_step(c);
    }
    iterate pn3 over s3 carrying d: PopN = c {
        next d = pop_tys_step(d);
    }
    return d;
}
fn pop_tys_step(st: PopN) -> (result: PopN) {
    if not(st.ok) || st.n == 0 { return st; }
    return match st.rest {
        WNil => PopN { rest: TyStack.WNil, n: st.n, ok: false },
        WCons { head: h, tail: t } => PopN { rest: t, n: st.n - 1, ok: true }
    };
}
fn verify_top_call(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: TDepth, t: TOpList, ty: SemType, argc: u64) -> (result: TDepth) {
    if is_poison(ty) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    if st.depth < argc { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    let popped: PopN = pop_tys(s0, s1, s2, s3, st.stack, argc);
    if not(popped.ok) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: popped.rest }, depth: st.depth - argc + 1, ok: true };
}
fn verify_top_proj(st: TDepth, t: TOpList, ty: SemType) -> (result: TDepth) {
    if is_poison(ty) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return match st.stack {
        WNil => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        WCons { head: h, tail: t2 } => TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: t2 }, depth: st.depth, ok: true }
    };
}
fn finish_verify_tops(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: TDepth, want: ExpTy) -> (result: bool) {
    if not(st.ok) { return false; }
    if st.depth != 1 { return false; }
    return match want {
        XNone => true,
        XSome { ty: ty } => finish_verify_want(s0, s1, s2, s3, total, st, ty)
    };
}
fn finish_verify_want(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: TDepth, ty: SemType) -> (result: bool) {
    return match st.stack {
        WNil => false,
        WCons { head: h, tail: t } => finish_verify_top(s0, s1, s2, s3, total, h, ty)
    };
}
fn finish_verify_top(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, h: SemType, ty: SemType) -> (result: bool) {
    if is_poison(h) || is_poison(ty) { return false; }
    return sem_eq(s0, s1, s2, s3, total, h, ty);
}
// Adversarial constructors: deliberately corrupted IR states built inside
// MNCS. Each must be rejected by its verifier; the sound sample must pass.
// The probe passes only source bytes, so no host-constructed values cross
// the boundary: construction and verdict both execute in MNCS.
fn sabotage_depth(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64]) -> (result: bool) {
    let bad: FlatList = FlatList.ICons { head: FlatOp.PBin { op: 50 }, tail: FlatList.INil };
    return flat_ok(s0, s1, s2, s3, bad);
}
fn sabotage_call_arity(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64) -> (result: bool) {
    let bad: TOpList = TOpList.PCons { head: TOp.TCall { ty: SemType.TInt { width: 64, signed: false }, argc: 2, start: 0, end: 1, ns: 0, ne: 1 }, tail: TOpList.PNil };
    return verify_tops(s0, s1, s2, s3, total, bad, ExpTy.XNone);
}
fn sabotage_bin_mismatch(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64) -> (result: bool) {
    let ints: SemType = SemType.TInt { width: 64, signed: false };
    let ops: TOpList = TOpList.PCons { head: TOp.TInt { value: 1, ty: ints, start: 0, end: 1 }, tail: TOpList.PCons { head: TOp.TBool { value: true, ty: SemType.TBool, start: 2, end: 6 }, tail: TOpList.PCons { head: TOp.TBin { op: 50, ty: ints, start: 0, end: 6 }, tail: TOpList.PNil } } };
    return verify_tops(s0, s1, s2, s3, total, ops, ExpTy.XNone);
}
fn sabotage_final_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64) -> (result: bool) {
    let ops: TOpList = TOpList.PCons { head: TOp.TInt { value: 1, ty: SemType.TInt { width: 64, signed: false }, start: 0, end: 1 }, tail: TOpList.PNil };
    return verify_tops(s0, s1, s2, s3, total, ops, ExpTy.XSome { ty: SemType.TBool });
}
fn sound_sample(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64) -> (result: bool) {
    let ints: SemType = SemType.TInt { width: 64, signed: false };
    let ops: TOpList = TOpList.PCons { head: TOp.TInt { value: 1, ty: ints, start: 0, end: 1 }, tail: TOpList.PCons { head: TOp.TInt { value: 2, ty: ints, start: 4, end: 5 }, tail: TOpList.PCons { head: TOp.TBin { op: 50, ty: ints, start: 0, end: 5 }, tail: TOpList.PNil } } };
    return verify_tops(s0, s1, s2, s3, total, ops, ExpTy.XSome { ty: ints });
}

// Bidirectional expression checking as an explicit-stack machine (MNE130
// forbids the recursive descent this algorithm wants to be). Each job
// carries its required type downward; each continuation resumes the parent
// when a child type is established. A hard failure (unresolvable name,
// arity, class violation) drains the machine; a mismatch against a
// required type records its obligation and continues with the actual
// type, mirroring Stage-0 elaboration. Checking and typed lowering are
// fused: every established node emits its typed operation, so the typed
// IR is produced BY the proof, not after it.
record SemJob { e: Expr, exp: ExpTy }
enum JobList { JNil, JCons { head: SemJob, tail: JobList } }
enum SemKont {
    KTop,
    KBinL { op: u64, right: Expr, start: u64, end: u64 },
    KBinR { op: u64, lty: SemType, start: u64, end: u64, rlit: bool },
    KCallA { sig: Sig, args: ExprList, ptys: TyList, start: u64, end: u64, exp: ExpTy },
    KProj { fstart: u64, fend: u64, bstart: u64, bend: u64, start: u64, end: u64, exp: ExpTy }
}
enum KontList { QNil, QCons { head: SemKont, tail: KontList } }
record SemState { jobs: JobList, konts: KontList, obls: OblList, tops: TOpList, last_ty: SemType, top_ty: SemType, failed: bool, env: ScopeStack, sigs: SigTab, rectab: RecordList, enumtab: EnumList, fx: EffectList, total: u64 }
record ExprRes { ty: SemType, ok: bool, obls: OblList, tops: TOpList }
fn prove_expr(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], env: ScopeStack, sigs: SigTab, rectab: RecordList, enumtab: EnumList, fx: EffectList, total: u64, e: Expr, exp: ExpTy) -> (result: ExprRes) {
    iterate sm0 over s0 carrying a: SemState = SemState { jobs: JobList.JCons { head: SemJob { e: e, exp: exp }, tail: JobList.JNil }, konts: KontList.QCons { head: SemKont.KTop, tail: KontList.QNil }, obls: OblList.LNil, tops: TOpList.PNil, last_ty: SemType.TPoison, top_ty: SemType.TPoison, failed: false, env: env, sigs: sigs, rectab: rectab, enumtab: enumtab, fx: fx, total: total } {
        next a = sem_step(s0, s1, s2, s3, a);
    }
    iterate sm1 over s1 carrying b: SemState = a {
        next b = sem_step(s0, s1, s2, s3, b);
    }
    iterate sm2 over s2 carrying c: SemState = b {
        next c = sem_step(s0, s1, s2, s3, c);
    }
    iterate sm3 over s3 carrying d: SemState = c {
        next d = sem_step(s0, s1, s2, s3, d);
    }
    return finish_prove_expr(s0, s1, s2, s3, d);
}
fn finish_prove_expr(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState) -> (result: ExprRes) {
    if st.failed { return ExprRes { ty: SemType.TPoison, ok: false, obls: reverse_obls(s0, s1, s2, s3, st.obls), tops: TOpList.PNil }; }
    return ExprRes { ty: st.top_ty, ok: true, obls: reverse_obls(s0, s1, s2, s3, st.obls), tops: reverse_tops(s0, s1, s2, s3, st.tops) };
}
fn sem_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState) -> (result: SemState) {
    if st.failed { return st; }
    return match st.jobs {
        JCons { head: j, tail: t } => sem_job(s0, s1, s2, s3, SemState { ..st, jobs: t }, j),
        JNil => sem_kont_empty(s0, s1, s2, s3, st)
    };
}
fn sem_kont_empty(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState) -> (result: SemState) {
    return match st.konts {
        QNil => st,
        QCons { head: k, tail: t } => apply_kont(s0, s1, s2, s3, SemState { ..st, konts: t }, k)
    };
}
fn sem_emit(st: SemState, kind: u64, start: u64, end: u64, status: u64) -> (result: SemState) {
    return SemState { ..st, obls: OblList.LCons { head: Obligation { kind: kind, start: start, end: end, status: status }, tail: st.obls } };
}
fn sem_emit_top(st: SemState, top: TOp) -> (result: SemState) {
    return SemState { ..st, tops: TOpList.PCons { head: top, tail: st.tops } };
}
fn sem_drain(st: SemState) -> (result: SemState) {
    return SemState { ..st, jobs: JobList.JNil, konts: KontList.QNil, failed: true };
}
fn sem_accept(st: SemState, ty: SemType) -> (result: SemState) {
    return SemState { ..st, last_ty: ty };
}
fn sem_job(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, job: SemJob) -> (result: SemState) {
    return match job.e {
        Name { start: s, end: e } => finish_name(s0, s1, s2, s3, st, s, e, job.exp),
        Integer { start: s, end: e, value: v, overflow: o } => finish_int(st, v, s, e, job.exp),
        Boolean { start: s, end: e, value: v } => finish_bool(st, v, s, e, job.exp),
        Binary { op: o, left: l, right: r, start: s, end: e } => seed_binop(st, o, l, r, s, e, job.exp),
        Call { name_start: ns, name_end: ne, args: a, start: s, end: e } => seed_call(s0, s1, s2, s3, st, ns, ne, a, s, e, job.exp),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => seed_proj(st, b, fs, fe, s, e, job.exp)
    };
}
fn finish_name(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let got: LookupRes = env_lookup(s0, s1, s2, s3, st.total, st.env, start, end);
    if not(got.found) { return sem_drain(sem_emit(st, 1, start, end, 1)); }
    return finish_name_exp(s0, s1, s2, s3, st, got.ty, start, end, exp);
}
fn finish_name_exp(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, ty: SemType, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => sem_emit_top(sem_accept(st, ty), TOp.TName { ty: ty, start: start, end: end }),
        XSome { ty: r } => finish_name_req(s0, s1, s2, s3, st, ty, r, start, end)
    };
}
fn finish_name_req(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, ty: SemType, r: SemType, start: u64, end: u64) -> (result: SemState) {
    if sem_eq(s0, s1, s2, s3, st.total, ty, r) { return sem_emit_top(sem_accept(st, ty), TOp.TName { ty: ty, start: start, end: end }); }
    return sem_emit_top(sem_accept(sem_emit(st, 2, start, end, 1), ty), TOp.TName { ty: ty, start: start, end: end });
}
fn finish_int(st: SemState, value: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => finish_int_plain(st, value, start, end),
        XSome { ty: r } => finish_int_req(st, value, r, start, end)
    };
}
fn finish_int_plain(st: SemState, value: u64, start: u64, end: u64) -> (result: SemState) {
    let ty: SemType = SemType.TInt { width: 64, signed: true };
    return sem_emit_top(sem_accept(st, ty), TOp.TInt { value: value, ty: ty, start: start, end: end });
}
fn finish_int_req(st: SemState, value: u64, r: SemType, start: u64, end: u64) -> (result: SemState) {
    return match r {
        TInt { width: w, signed: g } => sem_emit_top(sem_accept(st, r), TOp.TInt { value: value, ty: r, start: start, end: end }),
        TByte => finish_int_byte(st, value, start, end),
        TBool => finish_int_fail(st, value, start, end),
        TNamed { start: n, end: m } => finish_int_fail(st, value, start, end),
        TSeq => finish_int_fail(st, value, start, end),
        TPoison => finish_int_fail(st, value, start, end)
    };
}
fn finish_int_byte(st: SemState, value: u64, start: u64, end: u64) -> (result: SemState) {
    if value <= 255 { return sem_emit_top(sem_accept(st, SemType.TByte), TOp.TInt { value: value, ty: SemType.TByte, start: start, end: end }); }
    return sem_emit_top(sem_accept(sem_emit(st, 3, start, end, 1), SemType.TByte), TOp.TInt { value: value, ty: SemType.TByte, start: start, end: end });
}
fn finish_int_fail(st: SemState, value: u64, start: u64, end: u64) -> (result: SemState) {
    let ty: SemType = SemType.TInt { width: 64, signed: true };
    return sem_emit_top(sem_accept(sem_emit(st, 3, start, end, 1), ty), TOp.TInt { value: value, ty: ty, start: start, end: end });
}
fn finish_bool(st: SemState, value: bool, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => sem_emit_top(sem_accept(st, SemType.TBool), TOp.TBool { value: value, ty: SemType.TBool, start: start, end: end }),
        XSome { ty: r } => finish_bool_req(st, value, r, start, end)
    };
}
fn finish_bool_req(st: SemState, value: bool, r: SemType, start: u64, end: u64) -> (result: SemState) {
    return match r {
        TBool => sem_emit_top(sem_accept(st, SemType.TBool), TOp.TBool { value: value, ty: SemType.TBool, start: start, end: end }),
        TByte => finish_bool_fail(st, value, start, end),
        TInt { width: w, signed: g } => finish_bool_fail(st, value, start, end),
        TNamed { start: n, end: m } => finish_bool_fail(st, value, start, end),
        TSeq => finish_bool_fail(st, value, start, end),
        TPoison => finish_bool_fail(st, value, start, end)
    };
}
fn finish_bool_fail(st: SemState, value: bool, start: u64, end: u64) -> (result: SemState) {
    return sem_emit_top(sem_accept(sem_emit(st, 4, start, end, 1), SemType.TBool), TOp.TBool { value: value, ty: SemType.TBool, start: start, end: end });
}
fn is_threaded(op: u64) -> (result: bool) {
    if op == 50 || op == 51 || op == 52 { return true; }
    if op == 55 || op == 56 || op == 57 { return true; }
    if op == 91 || op == 92 || op == 93 { return true; }
    if op == 94 || op == 95 || op == 96 { return true; }
    return false;
}
fn bin_left_exp(op: u64, exp: ExpTy) -> (result: ExpTy) {
    if is_threaded(op) { return exp; }
    return ExpTy.XNone;
}
fn seed_binop(st: SemState, op: u64, left: Expr, right: Expr, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let lexp: ExpTy = bin_left_exp(op, exp);
    let job: SemJob = SemJob { e: left, exp: lexp };
    let kont: SemKont = SemKont.KBinL { op: op, right: right, start: start, end: end };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn nonzero_lit(e: Expr) -> (result: bool) {
    return match e {
        Integer { start: s, end: e2, value: v, overflow: o } => nonzero_val(v),
        Name { start: s, end: e2 } => false,
        Boolean { start: s, end: e2, value: v } => false,
        Binary { op: o, left: l, right: r, start: s, end: e2 } => false,
        Call { name_start: ns, name_end: ne, args: a, start: s, end: e2 } => false,
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e2, path: p } => false
    };
}
fn nonzero_val(v: u64) -> (result: bool) {
    if v == 0 { return false; }
    return true;
}
fn apply_kont(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, k: SemKont) -> (result: SemState) {
    return match k {
        KTop => SemState { ..st, top_ty: st.last_ty },
        KBinL { op: o, right: r, start: s, end: e } => apply_bin_l(st, o, r, s, e),
        KBinR { op: o, lty: l, start: s, end: e, rlit: q } => apply_bin_r(s0, s1, s2, s3, st, o, l, s, e, q),
        KCallA { sig: g, args: a, ptys: p, start: s, end: e, exp: x } => apply_call_a(s0, s1, s2, s3, st, g, a, p, s, e, x),
        KProj { fstart: fs, fend: fe, bstart: bs, bend: be, start: s, end: e, exp: x } => apply_proj(s0, s1, s2, s3, st, fs, fe, bs, be, s, e, x)
    };
}
fn apply_bin_l(st: SemState, op: u64, right: Expr, start: u64, end: u64) -> (result: SemState) {
    let lty: SemType = st.last_ty;
    let job: SemJob = SemJob { e: right, exp: ExpTy.XSome { ty: lty } };
    let kont: SemKont = SemKont.KBinR { op: op, lty: lty, start: start, end: end, rlit: nonzero_lit(right) };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn apply_bin_r(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, op: u64, lty: SemType, start: u64, end: u64, rlit: bool) -> (result: SemState) {
    let rty: SemType = st.last_ty;
    if not(sem_eq(s0, s1, s2, s3, st.total, lty, rty)) { return sem_drain(sem_emit(st, 7, start, end, 1)); }
    return finish_bin_class(s0, s1, s2, s3, st, op, lty, rty, start, end, rlit);
}
// Operator classes: 0 total arithmetic (checked, wrapping, saturating,
// bitwise), 1 division/modulo, 2 comparisons, 3 boolean connectives,
// 4 shifts. Anything else is unreachable from the parser and defended
// as an integer-arithmetic failure.
fn op_class(op: u64) -> (result: u64) {
    if op == 50 || op == 51 || op == 52 { return 0; }
    if op == 55 || op == 56 || op == 57 { return 0; }
    if op == 91 || op == 92 || op == 93 { return 0; }
    if op == 94 || op == 95 || op == 96 { return 0; }
    if op == 53 || op == 54 { return 1; }
    if op == 84 || op == 85 || op == 58 { return 2; }
    if op == 86 || op == 59 || op == 87 { return 2; }
    if op == 82 || op == 83 { return 3; }
    if op == 88 || op == 89 { return 4; }
    return 0;
}
fn finish_bin_class(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, op: u64, lty: SemType, rty: SemType, start: u64, end: u64, rlit: bool) -> (result: SemState) {
    let cls: u64 = op_class(op);
    if cls == 1 { return finish_bin_divmod(st, op, lty, start, end, rlit); }
    if cls == 2 { return finish_bin_cmp(st, op, lty, start, end); }
    if cls == 3 { return finish_bin_boolop(st, op, lty, start, end); }
    if cls == 4 { return finish_bin_shift(st, op, lty, start, end); }
    return finish_bin_arith(st, op, lty, start, end);
}
fn arith_int_or_byte(st: SemState, lty: SemType, start: u64, end: u64) -> (result: SemState) {
    return match lty {
        TInt { width: w, signed: g } => st,
        TByte => sem_emit(st, 12, start, end, 1),
        TBool => sem_emit(st, 8, start, end, 1),
        TNamed { start: n, end: m } => sem_emit(st, 8, start, end, 1),
        TSeq => sem_emit(st, 8, start, end, 1),
        TPoison => sem_emit(st, 8, start, end, 1)
    };
}
fn arith_failed(st: SemState, lty: SemType) -> (result: bool) {
    return match lty {
        TInt { width: w, signed: g } => false,
        TByte => true,
        TBool => true,
        TNamed { start: n, end: m } => true,
        TSeq => true,
        TPoison => true
    };
}
fn finish_bin_arith(st: SemState, op: u64, lty: SemType, start: u64, end: u64) -> (result: SemState) {
    if arith_failed(st, lty) { return sem_drain(arith_int_or_byte(st, lty, start, end)); }
    if op == 50 || op == 51 || op == 52 {
        return sem_emit_top(sem_accept(sem_emit(st, 13, start, end, 2), lty), TOp.TBin { op: op, ty: lty, start: start, end: end });
    }
    return sem_emit_top(sem_accept(st, lty), TOp.TBin { op: op, ty: lty, start: start, end: end });
}
fn finish_bin_divmod(st: SemState, op: u64, lty: SemType, start: u64, end: u64, rlit: bool) -> (result: SemState) {
    if arith_failed(st, lty) { return sem_drain(arith_int_or_byte(st, lty, start, end)); }
    if rlit { return sem_emit_top(sem_accept(st, lty), TOp.TBin { op: op, ty: lty, start: start, end: end }); }
    return sem_emit_top(sem_accept(sem_emit(st, 14, start, end, 2), lty), TOp.TBin { op: op, ty: lty, start: start, end: end });
}
fn finish_bin_cmp(st: SemState, op: u64, lty: SemType, start: u64, end: u64) -> (result: SemState) {
    return match lty {
        TInt { width: w, signed: g } => sem_emit_top(sem_accept(st, SemType.TBool), TOp.TBin { op: op, ty: SemType.TBool, start: start, end: end }),
        TByte => sem_emit_top(sem_accept(st, SemType.TBool), TOp.TBin { op: op, ty: SemType.TBool, start: start, end: end }),
        TBool => sem_drain(sem_emit(st, 9, start, end, 1)),
        TNamed { start: n, end: m } => sem_drain(sem_emit(st, 9, start, end, 1)),
        TSeq => sem_drain(sem_emit(st, 9, start, end, 1)),
        TPoison => sem_drain(sem_emit(st, 9, start, end, 1))
    };
}
fn finish_bin_boolop(st: SemState, op: u64, lty: SemType, start: u64, end: u64) -> (result: SemState) {
    if is_bool_ty(lty) { return sem_emit_top(sem_accept(st, SemType.TBool), TOp.TBin { op: op, ty: SemType.TBool, start: start, end: end }); }
    return sem_drain(sem_emit(st, 10, start, end, 1));
}
fn finish_bin_shift(st: SemState, op: u64, lty: SemType, start: u64, end: u64) -> (result: SemState) {
    return match lty {
        TByte => sem_emit_top(sem_accept(st, SemType.TByte), TOp.TBin { op: op, ty: SemType.TByte, start: start, end: end }),
        TInt { width: w, signed: g } => sem_emit_top(sem_accept(st, lty), TOp.TBin { op: op, ty: lty, start: start, end: end }),
        TBool => sem_drain(sem_emit(st, 11, start, end, 1)),
        TNamed { start: n, end: m } => sem_drain(sem_emit(st, 11, start, end, 1)),
        TSeq => sem_drain(sem_emit(st, 11, start, end, 1)),
        TPoison => sem_drain(sem_emit(st, 11, start, end, 1))
    };
}
// Callee signatures resolve by exact name bytes over the collected table.
record SigRes { found: bool, sig: Sig }
record SigScan { rest: SigTab, start: u64, end: u64, found: bool, sig: Sig }
fn sig_lookup(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, sigs: SigTab, start: u64, end: u64) -> (result: SigRes) {
    iterate gs0 over s0 carrying a: SigScan = SigScan { rest: sigs, start: start, end: end, found: false, sig: Sig { start: 0, end: 0, params: BindList.BNil, nparams: 0, result: SemType.TPoison, fx: EffectList.XNil } } {
        next a = sig_lookup_step(s0, s1, s2, s3, total, a);
    }
    iterate gs1 over s1 carrying b: SigScan = a {
        next b = sig_lookup_step(s0, s1, s2, s3, total, b);
    }
    iterate gs2 over s2 carrying c: SigScan = b {
        next c = sig_lookup_step(s0, s1, s2, s3, total, c);
    }
    iterate gs3 over s3 carrying d: SigScan = c {
        next d = sig_lookup_step(s0, s1, s2, s3, total, d);
    }
    return SigRes { found: d.found, sig: d.sig };
}
fn sig_lookup_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: SigScan) -> (result: SigScan) {
    if st.found { return st; }
    return match st.rest {
        HNil => st,
        HCons { head: h, tail: t } => sig_lookup_cons(s0, s1, s2, s3, total, st, h, t)
    };
}
fn sig_lookup_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: SigScan, h: Sig, t: SigTab) -> (result: SigScan) {
    if spans_equal(s0, s1, s2, s3, total, h.start, h.end, st.start, st.end) {
        return SigScan { rest: SigTab.HNil, start: st.start, end: st.end, found: true, sig: h };
    }
    return SigScan { rest: t, start: st.start, end: st.end, found: false, sig: st.sig };
}
record TysAcc { rest: BindList, acc: TyList }
fn params_to_tys(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], params: BindList) -> (result: TyList) {
    iterate ty0 over s0 carrying a: TysAcc = TysAcc { rest: params, acc: TyList.TyNil } {
        next a = params_to_tys_step(a);
    }
    iterate ty1 over s1 carrying b: TysAcc = a {
        next b = params_to_tys_step(b);
    }
    iterate ty2 over s2 carrying c: TysAcc = b {
        next c = params_to_tys_step(c);
    }
    iterate ty3 over s3 carrying d: TysAcc = c {
        next d = params_to_tys_step(d);
    }
    return reverse_tys(s0, s1, s2, s3, d.acc);
}
fn params_to_tys_step(st: TysAcc) -> (result: TysAcc) {
    return match st.rest { BNil => st, BCons { head: h, tail: t } => TysAcc { rest: t, acc: TyList.TyCons { head: h.ty, tail: st.acc } } };
}
record TysRev { rest: TyList, acc: TyList }
fn reverse_tys(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: TyList) -> (result: TyList) {
    iterate tr0 over s0 carrying a: TysRev = TysRev { rest: list, acc: TyList.TyNil } {
        next a = reverse_tys_step(a);
    }
    iterate tr1 over s1 carrying b: TysRev = a {
        next b = reverse_tys_step(b);
    }
    iterate tr2 over s2 carrying c: TysRev = b {
        next c = reverse_tys_step(c);
    }
    iterate tr3 over s3 carrying d: TysRev = c {
        next d = reverse_tys_step(d);
    }
    return d.acc;
}
fn reverse_tys_step(st: TysRev) -> (result: TysRev) {
    return match st.rest { TyNil => st, TyCons { head: h, tail: t } => TysRev { rest: t, acc: TyList.TyCons { head: h, tail: st.acc } } };
}
fn seed_call(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, ns: u64, ne: u64, args: ExprList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let got: SigRes = sig_lookup(s0, s1, s2, s3, st.total, st.sigs, ns, ne);
    if not(got.found) { return sem_drain(sem_emit(st, 32, ns, ne, 1)); }
    let argc: u64 = count_exprs(s0, s1, s2, s3, args);
    if argc != got.sig.nparams { return sem_drain(sem_emit(st, 6, start, end, 1)); }
    return seed_call_args(s0, s1, s2, s3, st, got.sig, args, start, end, exp);
}
fn seed_call_args(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, sig: Sig, args: ExprList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match args {
        ENil => finish_call(s0, s1, s2, s3, st, sig, start, end, exp),
        ECons { head: h, tail: t } => seed_first_arg(s0, s1, s2, s3, st, sig, args, h, start, end, exp)
    };
}
fn seed_first_arg(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, sig: Sig, args: ExprList, h: Expr, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let ptys: TyList = params_to_tys(s0, s1, s2, s3, sig.params);
    return match ptys {
        TyNil => finish_call(s0, s1, s2, s3, st, sig, start, end, exp),
        TyCons { head: p, tail: q } => push_first_arg(st, sig, args, ptys, h, p, start, end, exp)
    };
}
fn push_first_arg(st: SemState, sig: Sig, args: ExprList, ptys: TyList, h: Expr, p: SemType, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let job: SemJob = SemJob { e: h, exp: ExpTy.XSome { ty: p } };
    let kont: SemKont = SemKont.KCallA { sig: sig, args: args, ptys: ptys, start: start, end: end, exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
// Expression spans for diagnostics that point at a subexpression (MNE133
// at the argument, MNE161 at the projection base).
record ExprSpan { start: u64, end: u64 }
fn expr_span(e: Expr) -> (result: ExprSpan) {
    return match e {
        Name { start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        Integer { start: s, end: e2, value: v, overflow: o } => ExprSpan { start: s, end: e2 },
        Boolean { start: s, end: e2, value: v } => ExprSpan { start: s, end: e2 },
        Binary { op: o, left: l, right: r, start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        Call { name_start: ns, name_end: ne, args: a, start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e2, path: ph } => ExprSpan { start: s, end: e2 }
    };
}
// Each argument is checked against its parameter as it completes, mirroring
// elaboration order: the argument's own obligations come first, then the
// match obligation at the argument span. A mismatch records ARG_MATCH and
// continues with the actual type; arity was already gated at seeding.
fn apply_call_a(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, sig: Sig, args: ExprList, ptys: TyList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match ptys {
        TyNil => finish_call(s0, s1, s2, s3, st, sig, start, end, exp),
        TyCons { head: p, tail: q } => apply_call_arg(s0, s1, s2, s3, st, sig, args, p, q, start, end, exp)
    };
}
fn apply_call_arg(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, sig: Sig, args: ExprList, p: SemType, q: TyList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match args {
        ENil => finish_call(s0, s1, s2, s3, st, sig, start, end, exp),
        ECons { head: h, tail: t } => check_arg_cons(s0, s1, s2, s3, st, sig, h, t, p, q, start, end, exp)
    };
}
fn check_arg_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, sig: Sig, h: Expr, t: ExprList, p: SemType, q: TyList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let asp: ExprSpan = expr_span(h);
    let actual: SemType = st.last_ty;
    let st2: SemState = check_arg_ty(s0, s1, s2, s3, st, actual, p, asp.start, asp.end);
    return match t {
        ENil => finish_call(s0, s1, s2, s3, st2, sig, start, end, exp),
        ECons { head: nh, tail: nt } => advance_call_arg(s0, s1, s2, s3, st2, sig, t, q, nh, start, end, exp)
    };
}
fn check_arg_ty(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, actual: SemType, p: SemType, astart: u64, aend: u64) -> (result: SemState) {
    if sem_eq(s0, s1, s2, s3, st.total, actual, p) { return st; }
    return sem_emit(st, 26, astart, aend, 1);
}
fn advance_call_arg(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, sig: Sig, t: ExprList, q: TyList, nh: Expr, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match q {
        TyNil => finish_call(s0, s1, s2, s3, st, sig, start, end, exp),
        TyCons { head: np, tail: nq } => push_next_arg(st, sig, t, q, nh, np, start, end, exp)
    };
}
fn push_next_arg(st: SemState, sig: Sig, args: ExprList, ptys: TyList, nh: Expr, np: SemType, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let job: SemJob = SemJob { e: nh, exp: ExpTy.XSome { ty: np } };
    let kont: SemKont = SemKont.KCallA { sig: sig, args: args, ptys: ptys, start: start, end: end, exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
// Effect coverage (MNE134): every callee effect must already be granted to
// the caller. The check is fatal and runs after all arguments, before the
// result check. Capability authorization (MNE111) is a signature-level
// concern handled by check_sig, not repeated per call.
fn fx_eq(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, a: Effect, b: Effect) -> (result: bool) {
    if not(spans_equal(s0, s1, s2, s3, total, a.kind_start, a.kind_end, b.kind_start, b.kind_end)) { return false; }
    return spans_equal(s0, s1, s2, s3, total, a.cap_start, a.cap_end, b.cap_start, b.cap_end);
}
record FxScan { rest: EffectList, want: Effect, covered: bool }
fn fx_covered(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, avail: EffectList, want: Effect) -> (result: bool) {
    iterate fx0 over s0 carrying a: FxScan = FxScan { rest: avail, want: want, covered: false } {
        next a = fx_cover_step(s0, s1, s2, s3, total, a);
    }
    iterate fx1 over s1 carrying b: FxScan = a {
        next b = fx_cover_step(s0, s1, s2, s3, total, b);
    }
    iterate fx2 over s2 carrying c: FxScan = b {
        next c = fx_cover_step(s0, s1, s2, s3, total, c);
    }
    iterate fx3 over s3 carrying d: FxScan = c {
        next d = fx_cover_step(s0, s1, s2, s3, total, d);
    }
    return d.covered;
}
fn fx_cover_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: FxScan) -> (result: FxScan) {
    if st.covered { return st; }
    return match st.rest {
        XNil => st,
        XCons { head: h, tail: t } => fx_cover_cons(s0, s1, s2, s3, total, st, h, t)
    };
}
fn fx_cover_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: FxScan, h: Effect, t: EffectList) -> (result: FxScan) {
    if fx_eq(s0, s1, s2, s3, total, h, st.want) {
        return FxScan { rest: EffectList.XNil, want: st.want, covered: true };
    }
    return FxScan { rest: t, want: st.want, covered: false };
}
record NeedScan { rest: EffectList, ok: bool }
fn fx_cover_check(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, need: EffectList, start: u64, end: u64) -> (result: SemState) {
    iterate nc0 over s0 carrying a: NeedScan = NeedScan { rest: need, ok: true } {
        next a = need_scan_step(s0, s1, s2, s3, st, a);
    }
    iterate nc1 over s1 carrying b: NeedScan = a {
        next b = need_scan_step(s0, s1, s2, s3, st, b);
    }
    iterate nc2 over s2 carrying c: NeedScan = b {
        next c = need_scan_step(s0, s1, s2, s3, st, c);
    }
    iterate nc3 over s3 carrying d: NeedScan = c {
        next d = need_scan_step(s0, s1, s2, s3, st, d);
    }
    if d.ok { return st; }
    return sem_drain(sem_emit(st, 15, start, end, 1));
}
fn need_scan_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, acc: NeedScan) -> (result: NeedScan) {
    if not(acc.ok) { return acc; }
    return match acc.rest {
        XNil => acc,
        XCons { head: h, tail: t } => need_scan_cons(s0, s1, s2, s3, st, acc, h, t)
    };
}
fn need_scan_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, acc: NeedScan, h: Effect, t: EffectList) -> (result: NeedScan) {
    if fx_covered(s0, s1, s2, s3, st.total, st.fx, h) {
        return NeedScan { rest: t, ok: acc.ok };
    }
    return NeedScan { rest: EffectList.XNil, ok: false };
}
fn finish_call(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, sig: Sig, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let st2: SemState = fx_cover_check(s0, s1, s2, s3, st, sig.fx, start, end);
    if st2.failed { return st2; }
    return finish_call_res(s0, s1, s2, s3, st2, sig, start, end, exp);
}
fn finish_call_res(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, sig: Sig, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let top: TOp = TOp.TCall { ty: sig.result, argc: sig.nparams, start: start, end: end, ns: sig.start, ne: sig.end };
    return match exp {
        XNone => sem_emit_top(sem_accept(st, sig.result), top),
        XSome { ty: r } => finish_call_req(s0, s1, s2, s3, st, sig, top, r, start, end)
    };
}
fn finish_call_req(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, sig: Sig, top: TOp, r: SemType, start: u64, end: u64) -> (result: SemState) {
    if sem_eq(s0, s1, s2, s3, st.total, sig.result, r) { return sem_emit_top(sem_accept(st, sig.result), top); }
    return sem_emit_top(sem_accept(sem_emit(st, 25, start, end, 1), sig.result), top);
}
// Projection seeds its base with no requirement; the record type is
// established when the base completes. Chained projections nest through
// the base job, so each level resolves against its own base type.
fn seed_proj(st: SemState, b: Expr, fs: u64, fe: u64, s: u64, e: u64, exp: ExpTy) -> (result: SemState) {
    let bsp: ExprSpan = expr_span(b);
    let job: SemJob = SemJob { e: b, exp: ExpTy.XNone };
    let kont: SemKont = SemKont.KProj { fstart: fs, fend: fe, bstart: bsp.start, bend: bsp.end, start: s, end: e, exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn apply_proj(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, fs: u64, fe: u64, bs: u64, be: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let bty: SemType = st.last_ty;
    if is_poison(bty) {
        return sem_emit_top(sem_accept(st, SemType.TPoison), TOp.TProj { ty: SemType.TPoison, fstart: fs, fend: fe, start: start, end: end });
    }
    return match bty {
        TNamed { start: ns, end: ne } => proj_named(s0, s1, s2, s3, st, ns, ne, fs, fe, bs, be, start, end, exp),
        TBool => sem_drain(sem_emit(st, 23, bs, be, 1)),
        TByte => sem_drain(sem_emit(st, 23, bs, be, 1)),
        TInt { width: w, signed: g } => sem_drain(sem_emit(st, 23, bs, be, 1)),
        TSeq => sem_drain(sem_emit(st, 23, bs, be, 1)),
        TPoison => sem_emit_top(sem_accept(st, SemType.TPoison), TOp.TProj { ty: SemType.TPoison, fstart: fs, fend: fe, start: start, end: end })
    };
}
// Records resolve by exact name bytes over the collected table; fields
// resolve by exact name bytes within the record, first declaration wins.
record RecFind { rest: RecordList, ns: u64, ne: u64, found: bool, decl: RecordDecl }
record FieldScan { rest: FieldList, fs: u64, fe: u64, found: bool, field: Field }
fn rec_lookup(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, rectab: RecordList, ns: u64, ne: u64) -> (result: RecFind) {
    iterate rl0 over s0 carrying a: RecFind = RecFind { rest: rectab, ns: ns, ne: ne, found: false, decl: RecordDecl { ok: false, err_start: 0, err_end: 0, name_start: 0, name_end: 0, fields: FieldList.FNil, decl_start: 0, decl_end: 0, cursor: 0 } } {
        next a = rec_lookup_step(s0, s1, s2, s3, total, a);
    }
    iterate rl1 over s1 carrying b: RecFind = a {
        next b = rec_lookup_step(s0, s1, s2, s3, total, b);
    }
    iterate rl2 over s2 carrying c: RecFind = b {
        next c = rec_lookup_step(s0, s1, s2, s3, total, c);
    }
    iterate rl3 over s3 carrying d: RecFind = c {
        next d = rec_lookup_step(s0, s1, s2, s3, total, d);
    }
    return d;
}
fn rec_lookup_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: RecFind) -> (result: RecFind) {
    if st.found { return st; }
    return match st.rest {
        RNil => st,
        RCons { head: h, tail: t } => rec_lookup_cons(s0, s1, s2, s3, total, st, h, t)
    };
}
fn rec_lookup_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: RecFind, h: RecordDecl, t: RecordList) -> (result: RecFind) {
    if spans_equal(s0, s1, s2, s3, total, h.name_start, h.name_end, st.ns, st.ne) {
        return RecFind { rest: RecordList.RNil, ns: st.ns, ne: st.ne, found: true, decl: h };
    }
    return RecFind { rest: t, ns: st.ns, ne: st.ne, found: false, decl: st.decl };
}
fn field_scan(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, fields: FieldList, fs: u64, fe: u64) -> (result: FieldScan) {
    iterate fd0 over s0 carrying a: FieldScan = FieldScan { rest: fields, fs: fs, fe: fe, found: false, field: Field { name_start: 0, name_end: 0, type_start: 0, type_end: 0, type_kind: 9 } } {
        next a = field_scan_step(s0, s1, s2, s3, total, a);
    }
    iterate fd1 over s1 carrying b: FieldScan = a {
        next b = field_scan_step(s0, s1, s2, s3, total, b);
    }
    iterate fd2 over s2 carrying c: FieldScan = b {
        next c = field_scan_step(s0, s1, s2, s3, total, c);
    }
    iterate fd3 over s3 carrying d: FieldScan = c {
        next d = field_scan_step(s0, s1, s2, s3, total, d);
    }
    return d;
}
fn field_scan_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: FieldScan) -> (result: FieldScan) {
    if st.found { return st; }
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => field_scan_cons(s0, s1, s2, s3, total, st, h, t)
    };
}
fn field_scan_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: FieldScan, h: Field, t: FieldList) -> (result: FieldScan) {
    if spans_equal(s0, s1, s2, s3, total, h.name_start, h.name_end, st.fs, st.fe) {
        return FieldScan { rest: FieldList.FNil, fs: st.fs, fe: st.fe, found: true, field: h };
    }
    return FieldScan { rest: t, fs: st.fs, fe: st.fe, found: false, field: st.field };
}
fn proj_named(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, ns: u64, ne: u64, fs: u64, fe: u64, bs: u64, be: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let got: RecFind = rec_lookup(s0, s1, s2, s3, st.total, st.rectab, ns, ne);
    if not(got.found) { return sem_drain(sem_emit(st, 23, bs, be, 1)); }
    let fld: FieldScan = field_scan(s0, s1, s2, s3, st.total, got.decl.fields, fs, fe);
    if not(fld.found) { return sem_drain(sem_emit(st, 22, fs, fe, 1)); }
    let fty: TyRes = resolve_type(s0, s1, s2, s3, st.total, fld.field.type_kind, fld.field.type_start, fld.field.type_end, st.rectab, st.enumtab);
    if not(fty.ok) {
        return sem_emit_top(sem_accept(st, SemType.TPoison), TOp.TProj { ty: SemType.TPoison, fstart: fs, fend: fe, start: start, end: end });
    }
    return finish_proj_exp(s0, s1, s2, s3, st, fty.ty, fs, fe, start, end, exp);
}
fn finish_proj_exp(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, fty: SemType, fs: u64, fe: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let top: TOp = TOp.TProj { ty: fty, fstart: fs, fend: fe, start: start, end: end };
    return match exp {
        XNone => sem_emit_top(sem_accept(st, fty), top),
        XSome { ty: r } => finish_proj_req(s0, s1, s2, s3, st, fty, top, r, start, end)
    };
}
fn finish_proj_req(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: SemState, fty: SemType, top: TOp, r: SemType, start: u64, end: u64) -> (result: SemState) {
    if sem_eq(s0, s1, s2, s3, st.total, fty, r) { return sem_emit_top(sem_accept(st, fty), top); }
    return sem_emit_top(sem_accept(sem_emit(st, 35, start, end, 1), fty), top);
}
// Function bodies: statement proving over the expression machine (F12).
// Signatures are collected for the whole unit first (elaboration order is
// [all signatures] then [all bodies]); each body re-resolves its own
// parameter and result annotations, so declaration type failures surface
// twice, while scope duplicates stay signature-side. A body whose result
// list does not hold exactly one output is skipped after its signature:
// with no single output there is no expectation to prove against.
record StmtSpan { start: u64, end: u64 }
fn stmt_span(h: Stmt) -> (result: StmtSpan) {
    return match h {
        Let { name_start: a, name_end: b, type_start: c, type_end: d, type_kind: k, value: v, start: s, end: e } => StmtSpan { start: s, end: e },
        If { cond: c, then_b: tb, else_b: eb, start: s, end: e } => StmtSpan { start: s, end: e },
        Fail { mode_start: a, mode_end: b, start: s, end: e } => StmtSpan { start: s, end: e },
        Return { value: v, start: s, end: e } => StmtSpan { start: s, end: e }
    };
}
// Failure modes are raw name bytes matched exactly: isolated, atomic,
// fatal. Anything else records FAIL_MODE and behaves as a terminator.
fn fail_mode_ok(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, a: u64, b: u64) -> (result: bool) {
    if b < a { return false; }
    if b - a == 8 { return fail_is_isolated(s0, s1, s2, s3, total, a); }
    if b - a == 6 { return fail_is_atomic(s0, s1, s2, s3, total, a); }
    if b - a == 5 { return fail_is_fatal(s0, s1, s2, s3, total, a); }
    return false;
}
fn fail_is_isolated(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, a: u64) -> (result: bool) {
    if segment.byte_at(s0, s1, s2, s3, total, a) != 105 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 1) != 115 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 2) != 111 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 3) != 108 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 4) != 97 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 5) != 116 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 6) != 101 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 7) != 100 { return false; }
    return true;
}
fn fail_is_atomic(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, a: u64) -> (result: bool) {
    if segment.byte_at(s0, s1, s2, s3, total, a) != 97 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 1) != 116 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 2) != 111 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 3) != 109 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 4) != 105 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 5) != 99 { return false; }
    return true;
}
fn fail_is_fatal(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, a: u64) -> (result: bool) {
    if segment.byte_at(s0, s1, s2, s3, total, a) != 102 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 1) != 97 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 2) != 116 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 3) != 97 { return false; }
    if segment.byte_at(s0, s1, s2, s3, total, a + 4) != 108 { return false; }
    return true;
}
// The type-stack verifier only guards clean lowerings: poison in the
// established or required type means a FAIL obligation already covers
// this proof, and poisoned IR is never verified. Statement sites verify
// shape only (XNone): the required-type comparison belongs to the match
// obligations, which stay non-fatal.
fn want_poison(w: ExpTy) -> (result: bool) {
    return match w { XNone => false, XSome { ty: t } => is_poison(t) };
}
record FldObl { rest: FieldList, obls: OblList }
fn field_type_obls(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, fields: FieldList, rectab: RecordList, enumtab: EnumList) -> (result: OblList) {
    iterate fo0 over s0 carrying a: FldObl = FldObl { rest: fields, obls: OblList.LNil } {
        next a = field_obls_step(s0, s1, s2, s3, total, a, rectab, enumtab);
    }
    iterate fo1 over s1 carrying b: FldObl = a {
        next b = field_obls_step(s0, s1, s2, s3, total, b, rectab, enumtab);
    }
    iterate fo2 over s2 carrying c: FldObl = b {
        next c = field_obls_step(s0, s1, s2, s3, total, c, rectab, enumtab);
    }
    iterate fo3 over s3 carrying d: FldObl = c {
        next d = field_obls_step(s0, s1, s2, s3, total, d, rectab, enumtab);
    }
    return reverse_obls(s0, s1, s2, s3, d.obls);
}
fn field_obls_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: FldObl, rectab: RecordList, enumtab: EnumList) -> (result: FldObl) {
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => field_obls_cons(s0, s1, s2, s3, total, st, h, t, rectab, enumtab)
    };
}
fn field_obls_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: FldObl, h: Field, t: FieldList, rectab: RecordList, enumtab: EnumList) -> (result: FldObl) {
    let ty: TyRes = resolve_type(s0, s1, s2, s3, total, h.type_kind, h.type_start, h.type_end, rectab, enumtab);
    let tob: OblList = param_type_obl(h, ty);
    return FldObl { rest: t, obls: append_obls(s0, s1, s2, s3, st.obls, tob) };
}
record ResCount { rest: FieldList, n: u64 }
fn count_results_fields(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], fields: FieldList) -> (result: u64) {
    iterate rc0 over s0 carrying a: ResCount = ResCount { rest: fields, n: 0 } {
        next a = count_results_step(a);
    }
    iterate rc1 over s1 carrying b: ResCount = a {
        next b = count_results_step(b);
    }
    iterate rc2 over s2 carrying c: ResCount = b {
        next c = count_results_step(c);
    }
    iterate rc3 over s3 carrying d: ResCount = c {
        next d = count_results_step(d);
    }
    return d.n;
}
fn count_results_step(st: ResCount) -> (result: ResCount) {
    return match st.rest { FNil => st, FCons { head: h, tail: t } => ResCount { rest: t, n: st.n + 1 } };
}
// Statement proving as one iterative machine over an explicit frame stack:
// branch bodies cannot recurse (statement recursion is unavailable), so an
// `if` suspends its parent list in a frame while each arm proves in a
// pushed scope. Obligation lists stay in source order throughout: proved
// expressions arrive ordered, single obligations append behind them.
record StmtFrame { after: StmtList, saved_env: ScopeStack, else_b: StmtList, phase: u64 }
enum StmtFrames { BrNil, BrCons { head: StmtFrame, tail: StmtFrames } }
record StmtWalk { rest: StmtList, frames: StmtFrames, env: ScopeStack, closed: bool, ok: bool, obls: OblList, tops: TopsList, sig: Sig, sigs: SigTab, rectab: RecordList, enumtab: EnumList, total: u64 }
fn prove_stmts(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], w: StmtWalk) -> (result: StmtWalk) {
    iterate sw0 over s0 carrying a: StmtWalk = w {
        next a = prove_stmt_step(s0, s1, s2, s3, a);
    }
    iterate sw1 over s1 carrying b: StmtWalk = a {
        next b = prove_stmt_step(s0, s1, s2, s3, b);
    }
    iterate sw2 over s2 carrying c: StmtWalk = b {
        next c = prove_stmt_step(s0, s1, s2, s3, c);
    }
    iterate sw3 over s3 carrying d: StmtWalk = c {
        next d = prove_stmt_step(s0, s1, s2, s3, d);
    }
    return d;
}
fn prove_stmt_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk) -> (result: StmtWalk) {
    if not(st.ok) { return StmtWalk { ..st, rest: StmtList.SNil, frames: StmtFrames.BrNil }; }
    return match st.rest {
        SNil => unwind_or_done(st),
        SCons { head: h, tail: t } => prove_stmt_cons(s0, s1, s2, s3, st, h, t)
    };
}
fn prove_stmt_cons(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, h: Stmt, t: StmtList) -> (result: StmtWalk) {
    if st.closed {
        let sp: StmtSpan = stmt_span(h);
        let obl: OblList = OblList.LCons { head: Obligation { kind: 20, start: sp.start, end: sp.end, status: 1 }, tail: OblList.LNil };
        return StmtWalk { ..st, rest: StmtList.SNil, obls: append_obls(s0, s1, s2, s3, st.obls, obl) };
    }
    return prove_one_stmt(s0, s1, s2, s3, st, h, t);
}
fn unwind_or_done(st: StmtWalk) -> (result: StmtWalk) {
    return match st.frames {
        BrNil => st,
        BrCons { head: f, tail: t } => unwind_frame(st, f, t)
    };
}
fn unwind_frame(st: StmtWalk, f: StmtFrame, t: StmtFrames) -> (result: StmtWalk) {
    if f.phase == 0 {
        let frame: StmtFrame = StmtFrame { after: f.after, saved_env: f.saved_env, else_b: f.else_b, phase: 1 };
        return StmtWalk { ..st, rest: f.else_b, frames: StmtFrames.BrCons { head: frame, tail: t }, env: push_scope(f.saved_env), closed: false };
    }
    return StmtWalk { ..st, rest: f.after, frames: t, env: f.saved_env, closed: false };
}
fn close_and(a: bool, b: bool) -> (result: bool) {
    if not(a) { return false; }
    if not(b) { return false; }
    return true;
}
fn prove_one_stmt(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, h: Stmt, t: StmtList) -> (result: StmtWalk) {
    return match h {
        Let { name_start: a, name_end: b, type_start: c, type_end: d, type_kind: k, value: v, start: s, end: e } => prove_let(s0, s1, s2, s3, st, t, a, b, c, d, k, v, s, e),
        If { cond: c, then_b: tb, else_b: eb, start: s, end: e } => prove_if(s0, s1, s2, s3, st, t, c, tb, eb, s, e),
        Fail { mode_start: a, mode_end: b, start: s, end: e } => prove_fail(s0, s1, s2, s3, st, t, a, b, s, e),
        Return { value: v, start: s, end: e } => prove_return_val(s0, s1, s2, s3, st, v, t, s, e)
    };
}
fn prove_let(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, t: StmtList, a: u64, b: u64, c: u64, d: u64, k: u64, v: Expr, s: u64, e: u64) -> (result: StmtWalk) {
    let ty: TyRes = resolve_type(s0, s1, s2, s3, st.total, k, c, d, st.rectab, st.enumtab);
    let tob: OblList = param_type_obl(Field { name_start: a, name_end: b, type_start: c, type_end: d, type_kind: k }, ty);
    let declared: SemType = param_bound_type(ty);
    let want: ExpTy = ExpTy.XSome { ty: declared };
    let res: ExprRes = prove_expr(s0, s1, s2, s3, st.env, st.sigs, st.rectab, st.enumtab, st.sig.fx, st.total, v, want);
    let obls1: OblList = append_obls(s0, s1, s2, s3, append_obls(s0, s1, s2, s3, st.obls, tob), res.obls);
    if not(res.ok) { return StmtWalk { ..st, rest: t, obls: obls1 }; }
    if not(skip_verify(res.ty, want)) {
        if not(verify_tops(s0, s1, s2, s3, st.total, res.tops, ExpTy.XNone)) {
            return StmtWalk { ..st, rest: StmtList.SNil, frames: StmtFrames.BrNil, ok: false, obls: obls1, tops: TopsList.TLCons { head: res.tops, tail: st.tops } };
        }
    }
    return finish_let(s0, s1, s2, s3, st, t, a, b, s, e, res, declared, obls1);
}
fn skip_verify(ty: SemType, want: ExpTy) -> (result: bool) {
    if is_poison(ty) { return true; }
    if want_poison(want) { return true; }
    return false;
}
fn finish_let(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, t: StmtList, a: u64, b: u64, s: u64, e: u64, res: ExprRes, declared: SemType, obls1: OblList) -> (result: StmtWalk) {
    let obls2: OblList = match_obl(s0, s1, s2, s3, st, res.ty, declared, obls1, 28, s, e);
    let bind: BindRes = env_bind_current(s0, s1, s2, s3, st.total, st.env, a, b, declared);
    let obls3: OblList = dup_obl(s0, s1, s2, s3, st, bind, obls2, a, b);
    return StmtWalk { ..st, rest: t, env: bind.stack, obls: obls3, tops: TopsList.TLCons { head: res.tops, tail: st.tops } };
}
fn match_obl(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, actual: SemType, want_ty: SemType, obls: OblList, kind: u64, s: u64, e: u64) -> (result: OblList) {
    if sem_eq(s0, s1, s2, s3, st.total, actual, want_ty) { return obls; }
    let obl: OblList = OblList.LCons { head: Obligation { kind: kind, start: s, end: e, status: 1 }, tail: OblList.LNil };
    return append_obls(s0, s1, s2, s3, obls, obl);
}
fn dup_obl(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, bind: BindRes, obls: OblList, a: u64, b: u64) -> (result: OblList) {
    if not(bind.dup) { return obls; }
    let obl: OblList = OblList.LCons { head: Obligation { kind: 5, start: a, end: b, status: 1 }, tail: OblList.LNil };
    return append_obls(s0, s1, s2, s3, obls, obl);
}
fn prove_if(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, t: StmtList, c: Expr, tb: StmtList, eb: StmtList, s: u64, e: u64) -> (result: StmtWalk) {
    let want: ExpTy = ExpTy.XSome { ty: SemType.TBool };
    let res: ExprRes = prove_expr(s0, s1, s2, s3, st.env, st.sigs, st.rectab, st.enumtab, st.sig.fx, st.total, c, want);
    let obls1: OblList = append_obls(s0, s1, s2, s3, st.obls, res.obls);
    if not(res.ok) { return StmtWalk { ..st, rest: t, obls: obls1 }; }
    if not(skip_verify(res.ty, want)) {
        if not(verify_tops(s0, s1, s2, s3, st.total, res.tops, ExpTy.XNone)) {
            return StmtWalk { ..st, rest: StmtList.SNil, frames: StmtFrames.BrNil, ok: false, obls: obls1, tops: TopsList.TLCons { head: res.tops, tail: st.tops } };
        }
    }
    let tops1: TopsList = TopsList.TLCons { head: res.tops, tail: st.tops };
    if sem_eq(s0, s1, s2, s3, st.total, res.ty, SemType.TBool) {
        return prove_if_arms(st, t, tb, eb, obls1, tops1);
    }
    return prove_if_reject(s0, s1, s2, s3, st, t, c, obls1, tops1);
}
fn prove_if_arms(st: StmtWalk, t: StmtList, tb: StmtList, eb: StmtList, obls1: OblList, tops1: TopsList) -> (result: StmtWalk) {
    let frame: StmtFrame = StmtFrame { after: t, saved_env: st.env, else_b: eb, phase: 0 };
    return StmtWalk { ..st, rest: tb, frames: StmtFrames.BrCons { head: frame, tail: st.frames }, env: push_scope(st.env), closed: false, obls: obls1, tops: tops1 };
}
fn prove_if_reject(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, t: StmtList, c: Expr, obls1: OblList, tops1: TopsList) -> (result: StmtWalk) {
    let csp: ExprSpan = expr_span(c);
    let obl: OblList = OblList.LCons { head: Obligation { kind: 24, start: csp.start, end: csp.end, status: 1 }, tail: OblList.LNil };
    return StmtWalk { ..st, rest: t, obls: append_obls(s0, s1, s2, s3, obls1, obl), tops: tops1 };
}
fn prove_fail(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, t: StmtList, a: u64, b: u64, s: u64, e: u64) -> (result: StmtWalk) {
    if fail_mode_ok(s0, s1, s2, s3, st.total, a, b) {
        return StmtWalk { ..st, rest: t, closed: true };
    }
    let obl: OblList = OblList.LCons { head: Obligation { kind: 21, start: s, end: e, status: 1 }, tail: OblList.LNil };
    return StmtWalk { ..st, rest: t, closed: true, obls: append_obls(s0, s1, s2, s3, st.obls, obl) };
}
// A returned name resolves only: no requirement is checked against it, so
// NAME_TYPE never fires here; the output comparison below still applies.
// Any other tail value elaborates against the declared output.
fn prove_return_val(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, v: Expr, t: StmtList, qs: u64, qe: u64) -> (result: StmtWalk) {
    return match v {
        Name { start: ns, end: ne } => prove_return_name(s0, s1, s2, s3, st, t, ns, ne, qs, qe),
        Integer { start: s, end: e2, value: vv, overflow: o } => prove_return_expr(s0, s1, s2, s3, st, v, t, qs, qe),
        Boolean { start: s, end: e2, value: vv } => prove_return_expr(s0, s1, s2, s3, st, v, t, qs, qe),
        Binary { op: o, left: l, right: r, start: s, end: e2 } => prove_return_expr(s0, s1, s2, s3, st, v, t, qs, qe),
        Call { name_start: ns, name_end: ne, args: a, start: s, end: e2 } => prove_return_expr(s0, s1, s2, s3, st, v, t, qs, qe),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e2, path: ph } => prove_return_expr(s0, s1, s2, s3, st, v, t, qs, qe)
    };
}
fn prove_return_name(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, t: StmtList, ns: u64, ne: u64, qs: u64, qe: u64) -> (result: StmtWalk) {
    let got: LookupRes = env_lookup(s0, s1, s2, s3, st.total, st.env, ns, ne);
    if not(got.found) {
        let obl: OblList = OblList.LCons { head: Obligation { kind: 1, start: ns, end: ne, status: 1 }, tail: OblList.LNil };
        return StmtWalk { ..st, rest: t, obls: append_obls(s0, s1, s2, s3, st.obls, obl) };
    }
    let top: TOp = TOp.TName { ty: got.ty, start: ns, end: ne };
    let tops1: TopsList = TopsList.TLCons { head: TOpList.PCons { head: top, tail: TOpList.PNil }, tail: st.tops };
    let obls1: OblList = match_obl(s0, s1, s2, s3, st, got.ty, st.sig.result, st.obls, 27, qs, qe);
    return StmtWalk { ..st, rest: t, closed: true, obls: obls1, tops: tops1 };
}
fn prove_return_expr(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: StmtWalk, v: Expr, t: StmtList, qs: u64, qe: u64) -> (result: StmtWalk) {
    let want: ExpTy = ExpTy.XSome { ty: st.sig.result };
    let res: ExprRes = prove_expr(s0, s1, s2, s3, st.env, st.sigs, st.rectab, st.enumtab, st.sig.fx, st.total, v, want);
    let obls1: OblList = append_obls(s0, s1, s2, s3, st.obls, res.obls);
    if not(res.ok) { return StmtWalk { ..st, rest: t, obls: obls1 }; }
    if not(skip_verify(res.ty, want)) {
        if not(verify_tops(s0, s1, s2, s3, st.total, res.tops, ExpTy.XNone)) {
            return StmtWalk { ..st, rest: StmtList.SNil, frames: StmtFrames.BrNil, ok: false, obls: obls1, tops: TopsList.TLCons { head: res.tops, tail: st.tops } };
        }
    }
    let obls2: OblList = match_obl(s0, s1, s2, s3, st, res.ty, st.sig.result, obls1, 27, qs, qe);
    return StmtWalk { ..st, rest: t, closed: true, obls: obls2, tops: TopsList.TLCons { head: res.tops, tail: st.tops } };
}
fn prove_tail(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], w: StmtWalk, ret: Expr) -> (result: StmtWalk) {
    let sp: ExprSpan = expr_span(ret);
    if w.closed {
        let obl: OblList = OblList.LCons { head: Obligation { kind: 20, start: sp.start, end: sp.end, status: 1 }, tail: OblList.LNil };
        return StmtWalk { ..w, obls: append_obls(s0, s1, s2, s3, w.obls, obl) };
    }
    return prove_return_val(s0, s1, s2, s3, w, ret, StmtList.SNil, sp.start, sp.end);
}
record FnProve { ok: bool, obls: OblList, tops: TopsList }
fn prove_fn(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], h: FnDecl, sig: Sig, sigs: SigTab, rectab: RecordList, enumtab: EnumList, total: u64) -> (result: FnProve) {
    let nres: u64 = count_results_fields(s0, s1, s2, s3, h.sig.results);
    if nres != 1 { return FnProve { ok: true, obls: OblList.LNil, tops: TopsList.TLNil }; }
    let par: OblList = field_type_obls(s0, s1, s2, s3, total, h.sig.params, rectab, enumtab);
    let res: OblList = field_type_obls(s0, s1, s2, s3, total, h.sig.results, rectab, enumtab);
    let env0: ScopeStack = ScopeStack.ZCons { head: Scope { binds: sig.params }, tail: ScopeStack.ZNil };
    let w0: StmtWalk = StmtWalk { rest: h.body.body, frames: StmtFrames.BrNil, env: env0, closed: false, ok: true, obls: OblList.LNil, tops: TopsList.TLNil, sig: sig, sigs: sigs, rectab: rectab, enumtab: enumtab, total: total };
    let w1: StmtWalk = prove_stmts(s0, s1, s2, s3, w0);
    if walk_stuck(w1) { return FnProve { ok: false, obls: append_obls(s0, s1, s2, s3, par, append_obls(s0, s1, s2, s3, res, w1.obls)), tops: topslist_reverse(s0, s1, s2, s3, w1.tops) }; }
    let w2: StmtWalk = prove_tail(s0, s1, s2, s3, w1, h.body.ret);
    return FnProve { ok: w2.ok, obls: append_obls(s0, s1, s2, s3, par, append_obls(s0, s1, s2, s3, res, w2.obls)), tops: topslist_reverse(s0, s1, s2, s3, w2.tops) };
}
fn walk_stuck(w: StmtWalk) -> (result: bool) {
    return match w.rest {
        SNil => frames_stuck(w.frames),
        SCons { head: h, tail: t } => true
    };
}
fn frames_stuck(frames: StmtFrames) -> (result: bool) {
    return match frames { BrNil => false, BrCons { head: h, tail: t } => true };
}
record TopsLRev { rest: TopsList, acc: TopsList }
fn topslist_reverse(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], list: TopsList) -> (result: TopsList) {
    iterate tl0 over s0 carrying a: TopsLRev = TopsLRev { rest: list, acc: TopsList.TLNil } {
        next a = topslist_reverse_step(a);
    }
    iterate tl1 over s1 carrying b: TopsLRev = a {
        next b = topslist_reverse_step(b);
    }
    iterate tl2 over s2 carrying c: TopsLRev = b {
        next c = topslist_reverse_step(c);
    }
    iterate tl3 over s3 carrying d: TopsLRev = c {
        next d = topslist_reverse_step(d);
    }
    return d.acc;
}
fn topslist_reverse_step(st: TopsLRev) -> (result: TopsLRev) {
    return match st.rest { TLNil => st, TLCons { head: h, tail: t } => TopsLRev { rest: t, acc: TopsList.TLCons { head: h, tail: st.acc } } };
}
record TopsLPrepend { rest: TopsList, acc: TopsList }
fn append_topslist(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], first: TopsList, second: TopsList) -> (result: TopsList) {
    let rev: TopsList = topslist_reverse(s0, s1, s2, s3, first);
    iterate ta0 over s0 carrying a: TopsLPrepend = TopsLPrepend { rest: rev, acc: second } {
        next a = append_topslist_step(a);
    }
    iterate ta1 over s1 carrying b: TopsLPrepend = a {
        next b = append_topslist_step(b);
    }
    iterate ta2 over s2 carrying c: TopsLPrepend = b {
        next c = append_topslist_step(c);
    }
    iterate ta3 over s3 carrying d: TopsLPrepend = c {
        next d = append_topslist_step(d);
    }
    return d.acc;
}
fn append_topslist_step(st: TopsLPrepend) -> (result: TopsLPrepend) {
    return match st.rest { TLNil => st, TLCons { head: h, tail: t } => TopsLPrepend { rest: t, acc: TopsList.TLCons { head: h, tail: st.acc } } };
}
// The unit proof runs in elaboration order: every signature first, then
// every body against the completed table. Table order is reverse-source
// (prepend accumulation), which lookup does not observe: after duplicate
// rejection each name resolves at most once.
record SigTabRep { tab: SigTab, obls: OblList }
record SigWalk { rest: FnList, tab: SigTab, obls: OblList }
fn collect_sigtab(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, fns: FnList, rectab: RecordList, enumtab: EnumList) -> (result: SigTabRep) {
    iterate sg0 over s0 carrying a: SigWalk = SigWalk { rest: fns, tab: SigTab.HNil, obls: OblList.LNil } {
        next a = collect_sigtab_step(s0, s1, s2, s3, total, a, rectab, enumtab);
    }
    iterate sg1 over s1 carrying b: SigWalk = a {
        next b = collect_sigtab_step(s0, s1, s2, s3, total, b, rectab, enumtab);
    }
    iterate sg2 over s2 carrying c: SigWalk = b {
        next c = collect_sigtab_step(s0, s1, s2, s3, total, c, rectab, enumtab);
    }
    iterate sg3 over s3 carrying d: SigWalk = c {
        next d = collect_sigtab_step(s0, s1, s2, s3, total, d, rectab, enumtab);
    }
    return SigTabRep { tab: d.tab, obls: d.obls };
}
fn collect_sigtab_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: SigWalk, rectab: RecordList, enumtab: EnumList) -> (result: SigWalk) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => collect_one_sig(s0, s1, s2, s3, total, st, h, t, rectab, enumtab)
    };
}
fn collect_one_sig(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: SigWalk, h: FnDecl, t: FnList, rectab: RecordList, enumtab: EnumList) -> (result: SigWalk) {
    let rep: SigRep = check_sig(s0, s1, s2, s3, total, h, rectab, enumtab);
    let tob: OblList = obl_only_types(s0, s1, s2, s3, rep.obls);
    return SigWalk { rest: t, tab: SigTab.HCons { head: rep.sig, tail: st.tab }, obls: append_obls(s0, s1, s2, s3, st.obls, tob) };
}
// Signature obligations split across elaboration passes: declaration type
// validity (TYPE_VALID/QUALIFIED) resolves for every function first; scope,
// count, authorization, and contract obligations stay per-function.
fn is_type_obl_kind(k: u64) -> (result: bool) {
    if k == 19 { return true; }
    if k == 31 { return true; }
    return false;
}
record OblKeep { rest: OblList, acc: OblList, keep: bool }
fn obl_filter_types(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], obls: OblList, keep: bool) -> (result: OblList) {
    iterate fk0 over s0 carrying a: OblKeep = OblKeep { rest: obls, acc: OblList.LNil, keep: keep } {
        next a = obl_filter_step(a);
    }
    iterate fk1 over s1 carrying b: OblKeep = a {
        next b = obl_filter_step(b);
    }
    iterate fk2 over s2 carrying c: OblKeep = b {
        next c = obl_filter_step(c);
    }
    iterate fk3 over s3 carrying d: OblKeep = c {
        next d = obl_filter_step(d);
    }
    return reverse_obls(s0, s1, s2, s3, d.acc);
}
fn obl_filter_step(st: OblKeep) -> (result: OblKeep) {
    return match st.rest {
        LNil => st,
        LCons { head: h, tail: t } => obl_filter_cons(st, h, t)
    };
}
fn obl_filter_cons(st: OblKeep, h: Obligation, t: OblList) -> (result: OblKeep) {
    if is_type_obl_kind(h.kind) {
        if st.keep { return OblKeep { rest: t, acc: OblList.LCons { head: h, tail: st.acc }, keep: st.keep }; }
        return OblKeep { rest: t, acc: st.acc, keep: st.keep };
    }
    if st.keep { return OblKeep { rest: t, acc: st.acc, keep: st.keep }; }
    return OblKeep { rest: t, acc: OblList.LCons { head: h, tail: st.acc }, keep: st.keep };
}
fn obl_only_types(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], obls: OblList) -> (result: OblList) {
    return obl_filter_types(s0, s1, s2, s3, obls, true);
}
record BodyWalk { rest: FnList, tab: SigTab, rectab: RecordList, enumtab: EnumList, total: u64, obls: OblList, tops: TopsList, ok: bool, n: u64 }
fn prove_bodies(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: BodyWalk) -> (result: BodyWalk) {
    iterate pb0 over s0 carrying a: BodyWalk = st {
        next a = prove_bodies_step(s0, s1, s2, s3, a);
    }
    iterate pb1 over s1 carrying b: BodyWalk = a {
        next b = prove_bodies_step(s0, s1, s2, s3, b);
    }
    iterate pb2 over s2 carrying c: BodyWalk = b {
        next c = prove_bodies_step(s0, s1, s2, s3, c);
    }
    iterate pb3 over s3 carrying d: BodyWalk = c {
        next d = prove_bodies_step(s0, s1, s2, s3, d);
    }
    return d;
}
fn prove_bodies_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: BodyWalk) -> (result: BodyWalk) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => prove_one_body(s0, s1, s2, s3, st, h, t)
    };
}
fn prove_one_body(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: BodyWalk, h: FnDecl, t: FnList) -> (result: BodyWalk) {
    let nres: u64 = count_results_fields(s0, s1, s2, s3, h.sig.results);
    if nres != 1 { return prove_body_skip(s0, s1, s2, s3, st, h, t); }
    let checked: SigRep = check_sig(s0, s1, s2, s3, st.total, h, st.rectab, st.enumtab);
    let rest: OblList = sig_rest_obls(s0, s1, s2, s3, st, h);
    let rep: FnProve = prove_fn(s0, s1, s2, s3, h, checked.sig, st.tab, st.rectab, st.enumtab, st.total);
    let obls1: OblList = append_obls(s0, s1, s2, s3, st.obls, rest);
    return BodyWalk { ..st, rest: t, obls: append_obls(s0, s1, s2, s3, obls1, rep.obls), tops: append_topslist(s0, s1, s2, s3, st.tops, rep.tops), ok: close_and(st.ok, rep.ok), n: st.n + 1 };
}
// A result list without exactly one output ends the function after a
// single RESULT_ONE obligation: no clause, scope, or body work follows.
fn prove_body_skip(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: BodyWalk, h: FnDecl, t: FnList) -> (result: BodyWalk) {
    let obl: OblList = OblList.LCons { head: Obligation { kind: 18, start: h.fn_start, end: h.fn_end, status: 1 }, tail: OblList.LNil };
    return BodyWalk { ..st, rest: t, obls: append_obls(s0, s1, s2, s3, st.obls, obl), n: st.n + 1 };
}
// Per-function signature remainder in elaboration order: capabilities,
// effects, contracts, then parameter scope. Declaration type validity
// already resolved in the pre-pass; the count gate above owns RESULT_ONE.
fn sig_rest_obls(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], st: BodyWalk, h: FnDecl) -> (result: OblList) {
    let sg: FnSig = h.sig;
    let cs: CapRep = check_caps(s0, s1, s2, s3, st.total, sg.capabilities);
    let es: FxRep = check_effects(s0, s1, s2, s3, st.total, sg.effects, cs.caps);
    let ks: OblList = check_contracts(s0, s1, s2, s3, sg.contracts);
    let ps: ParamRep = check_params(s0, s1, s2, s3, st.total, sg.params, st.rectab, st.enumtab);
    let dup5: OblList = obl_only_kind(s0, s1, s2, s3, ps.obls, 5);
    let o1: OblList = append_obls(s0, s1, s2, s3, cs.obls, es.obls);
    let o2: OblList = append_obls(s0, s1, s2, s3, o1, ks);
    return append_obls(s0, s1, s2, s3, o2, dup5);
}
record OblKindKeep { rest: OblList, acc: OblList, want: u64 }
fn obl_only_kind(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], obls: OblList, want: u64) -> (result: OblList) {
    iterate kk0 over s0 carrying a: OblKindKeep = OblKindKeep { rest: obls, acc: OblList.LNil, want: want } {
        next a = obl_kind_step(a);
    }
    iterate kk1 over s1 carrying b: OblKindKeep = a {
        next b = obl_kind_step(b);
    }
    iterate kk2 over s2 carrying c: OblKindKeep = b {
        next c = obl_kind_step(c);
    }
    iterate kk3 over s3 carrying d: OblKindKeep = c {
        next d = obl_kind_step(d);
    }
    return reverse_obls(s0, s1, s2, s3, d.acc);
}
fn obl_kind_step(st: OblKindKeep) -> (result: OblKindKeep) {
    return match st.rest {
        LNil => st,
        LCons { head: h, tail: t } => obl_kind_cons(st, h, t)
    };
}
fn obl_kind_cons(st: OblKindKeep, h: Obligation, t: OblList) -> (result: OblKindKeep) {
    if h.kind == st.want { return OblKindKeep { rest: t, acc: OblList.LCons { head: h, tail: st.acc }, want: st.want }; }
    return OblKindKeep { rest: t, acc: st.acc, want: st.want };
}
record FailScan { rest: OblList, found: bool }
fn obl_has_fail(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], obls: OblList) -> (result: bool) {
    iterate fh0 over s0 carrying a: FailScan = FailScan { rest: obls, found: false } {
        next a = obl_fail_step(a);
    }
    iterate fh1 over s1 carrying b: FailScan = a {
        next b = obl_fail_step(b);
    }
    iterate fh2 over s2 carrying c: FailScan = b {
        next c = obl_fail_step(c);
    }
    iterate fh3 over s3 carrying d: FailScan = c {
        next d = obl_fail_step(d);
    }
    return d.found;
}
fn obl_fail_step(st: FailScan) -> (result: FailScan) {
    if st.found { return st; }
    return match st.rest {
        LNil => st,
        LCons { head: h, tail: t } => obl_fail_cons(st, h, t)
    };
}
fn obl_fail_cons(st: FailScan, h: Obligation, t: OblList) -> (result: FailScan) {
    if h.status == 1 { return FailScan { rest: OblList.LNil, found: true }; }
    return FailScan { rest: t, found: false };
}
record UnitProve { ok: bool, err_start: u64, err_end: u64, obls: OblList, tops: TopsList, fn_count: u64 }
fn prove_unit(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64) -> (result: UnitProve) {
    let u: Unit = parse_unit(s0, s1, s2, s3, total);
    if not(u.ok) { return UnitProve { ok: false, err_start: u.err_start, err_end: u.err_end, obls: OblList.LNil, tops: TopsList.TLNil, fn_count: 0 }; }
    let names: NameList = collect_fn_names(s0, s1, s2, s3, u.fns);
    let dup: DupReport = duplicate_fn_names(s0, s1, s2, s3, total, names);
    if dup.found {
        let obl: OblList = OblList.LCons { head: Obligation { kind: 37, start: dup.start, end: dup.end, status: 1 }, tail: OblList.LNil };
        return UnitProve { ok: false, err_start: dup.start, err_end: dup.end, obls: obl, tops: TopsList.TLNil, fn_count: 0 };
    }
    let sigs: SigTabRep = collect_sigtab(s0, s1, s2, s3, total, u.fns, u.records, u.enums);
    let done: BodyWalk = prove_bodies(s0, s1, s2, s3, BodyWalk { rest: u.fns, tab: sigs.tab, rectab: u.records, enumtab: u.enums, total: total, obls: sigs.obls, tops: TopsList.TLNil, ok: true, n: 0 });
    let ok: bool = close_and(done.ok, not(obl_has_fail(s0, s1, s2, s3, done.obls)));
    return UnitProve { ok: ok, err_start: 0, err_end: 0, obls: done.obls, tops: done.tops, fn_count: done.n };
}
// Field type validity by declaration context (0 value, 1 record, 2 enum).
// Value positions accept scalars, declared nominals, and sequences with
// valid elements; record fields the same; enum payloads reject sequences
// outright. Qualified spellings fail with the context family.
fn check_field_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, kind: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList, ctx: u64) -> (result: OblList) {
    if kind == 1 || kind == 2 || kind == 3 || kind == 4 { return OblList.LNil; }
    if kind == 5 { return check_named_field_type(s0, s1, s2, s3, total, start, end, rectab, enumtab, ctx); }
    if kind == 6 { return ctx_field_obl(kind_ctx_qualified(ctx), start, end); }
    if kind == 7 || kind == 8 { return check_seq_field_type(s0, s1, s2, s3, total, start, end, rectab, enumtab, ctx); }
    return ctx_field_obl(kind_ctx_other(ctx), start, end);
}
fn kind_ctx_qualified(ctx: u64) -> (result: u64) {
    if ctx == 1 { return 29; }
    if ctx == 2 { return 30; }
    return 31;
}
fn kind_ctx_other(ctx: u64) -> (result: u64) {
    if ctx == 1 { return 29; }
    if ctx == 2 { return 30; }
    return 19;
}
fn ctx_field_obl(kind: u64, start: u64, end: u64) -> (result: OblList) {
    return OblList.LCons { head: Obligation { kind: kind, start: start, end: end, status: 1 }, tail: OblList.LNil };
}
fn check_named_field_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList, ctx: u64) -> (result: OblList) {
    let sc: SemType = scalar_sem(s0, s1, s2, s3, total, start, end);
    return match sc {
        TNamed { start: n, end: m } => check_declared_field_type(s0, s1, s2, s3, total, n, m, rectab, enumtab, ctx),
        TBool => OblList.LNil,
        TByte => OblList.LNil,
        TInt { width: w, signed: g } => OblList.LNil,
        TSeq => OblList.LNil,
        TPoison => OblList.LNil
    };
}
fn check_declared_field_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList, ctx: u64) -> (result: OblList) {
    if record_declared(s0, s1, s2, s3, total, rectab, start, end) { return OblList.LNil; }
    if enum_declared(s0, s1, s2, s3, total, enumtab, start, end) { return OblList.LNil; }
    return ctx_field_obl(kind_ctx_other(ctx), start, end);
}
fn check_seq_field_type(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList, ctx: u64) -> (result: OblList) {
    if ctx == 2 { return ctx_field_obl(30, start, end); }
    let inner: TyRes = resolve_seq_type(s0, s1, s2, s3, total, start, end, rectab, enumtab);
    if inner.ok { return OblList.LNil; }
    return ctx_field_obl(kind_ctx_other(ctx), start, end);
}
record RecCheckState { rest: RecordList, obls: OblList }
fn check_records(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, recs: RecordList, rectab: RecordList, enumtab: EnumList) -> (result: OblList) {
    iterate rc0 over s0 carrying a: RecCheckState = RecCheckState { rest: recs, obls: OblList.LNil } {
        next a = check_records_step(s0, s1, s2, s3, total, a, rectab, enumtab);
    }
    iterate rc1 over s1 carrying b: RecCheckState = a {
        next b = check_records_step(s0, s1, s2, s3, total, b, rectab, enumtab);
    }
    iterate rc2 over s2 carrying c: RecCheckState = b {
        next c = check_records_step(s0, s1, s2, s3, total, c, rectab, enumtab);
    }
    iterate rc3 over s3 carrying d: RecCheckState = c {
        next d = check_records_step(s0, s1, s2, s3, total, d, rectab, enumtab);
    }
    return reverse_obls(s0, s1, s2, s3, d.obls);
}
fn check_records_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: RecCheckState, rectab: RecordList, enumtab: EnumList) -> (result: RecCheckState) {
    return match st.rest {
        RNil => st,
        RCons { head: h, tail: t } => check_one_record(s0, s1, s2, s3, total, st, h, t, rectab, enumtab)
    };
}
fn check_one_record(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: RecCheckState, h: RecordDecl, t: RecordList, rectab: RecordList, enumtab: EnumList) -> (result: RecCheckState) {
    let obls: OblList = check_record_fields(s0, s1, s2, s3, total, h.fields, rectab, enumtab);
    return RecCheckState { rest: t, obls: append_obls(s0, s1, s2, s3, st.obls, obls) };
}
record RecFieldState { rest: FieldList, seen: NameList, obls: OblList }
fn check_record_fields(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, fields: FieldList, rectab: RecordList, enumtab: EnumList) -> (result: OblList) {
    iterate rf0 over s0 carrying a: RecFieldState = RecFieldState { rest: fields, seen: NameList.NNil, obls: OblList.LNil } {
        next a = check_record_fields_step(s0, s1, s2, s3, total, a, rectab, enumtab);
    }
    iterate rf1 over s1 carrying b: RecFieldState = a {
        next b = check_record_fields_step(s0, s1, s2, s3, total, b, rectab, enumtab);
    }
    iterate rf2 over s2 carrying c: RecFieldState = b {
        next c = check_record_fields_step(s0, s1, s2, s3, total, c, rectab, enumtab);
    }
    iterate rf3 over s3 carrying d: RecFieldState = c {
        next d = check_record_fields_step(s0, s1, s2, s3, total, d, rectab, enumtab);
    }
    return reverse_obls(s0, s1, s2, s3, d.obls);
}
fn check_record_fields_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: RecFieldState, rectab: RecordList, enumtab: EnumList) -> (result: RecFieldState) {
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => check_one_record_field(s0, s1, s2, s3, total, st, h, t, rectab, enumtab)
    };
}
fn check_one_record_field(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: RecFieldState, h: Field, t: FieldList, rectab: RecordList, enumtab: EnumList) -> (result: RecFieldState) {
    let tob: OblList = check_field_type(s0, s1, s2, s3, total, h.type_kind, h.type_start, h.type_end, rectab, enumtab, 1);
    if name_known(s0, s1, s2, s3, total, st.seen, h.name_start, h.name_end) {
        let dob: Obligation = Obligation { kind: 33, start: h.name_start, end: h.name_end, status: 1 };
        return RecFieldState { rest: t, seen: st.seen, obls: OblList.LCons { head: dob, tail: append_obls(s0, s1, s2, s3, tob, st.obls) } };
    }
    let seen: NameList = NameList.NCons { head: NameSpan { start: h.name_start, end: h.name_end }, tail: st.seen };
    return RecFieldState { rest: t, seen: seen, obls: append_obls(s0, s1, s2, s3, tob, st.obls) };
}
record EnumCheckState { rest: EnumList, obls: OblList }
fn check_enums(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, enums: EnumList, rectab: RecordList, enumtab: EnumList) -> (result: OblList) {
    iterate ec0 over s0 carrying a: EnumCheckState = EnumCheckState { rest: enums, obls: OblList.LNil } {
        next a = check_enums_step(s0, s1, s2, s3, total, a, rectab, enumtab);
    }
    iterate ec1 over s1 carrying b: EnumCheckState = a {
        next b = check_enums_step(s0, s1, s2, s3, total, b, rectab, enumtab);
    }
    iterate ec2 over s2 carrying c: EnumCheckState = b {
        next c = check_enums_step(s0, s1, s2, s3, total, c, rectab, enumtab);
    }
    iterate ec3 over s3 carrying d: EnumCheckState = c {
        next d = check_enums_step(s0, s1, s2, s3, total, d, rectab, enumtab);
    }
    return reverse_obls(s0, s1, s2, s3, d.obls);
}
fn check_enums_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: EnumCheckState, rectab: RecordList, enumtab: EnumList) -> (result: EnumCheckState) {
    return match st.rest {
        GNil => st,
        GCons { head: h, tail: t } => check_one_enum(s0, s1, s2, s3, total, st, h, t, rectab, enumtab)
    };
}
fn check_one_enum(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: EnumCheckState, h: EnumDecl, t: EnumList, rectab: RecordList, enumtab: EnumList) -> (result: EnumCheckState) {
    let obls: OblList = check_variants(s0, s1, s2, s3, total, h.variants, rectab, enumtab);
    return EnumCheckState { rest: t, obls: append_obls(s0, s1, s2, s3, st.obls, obls) };
}
record VariantState { rest: VariantList, seen: NameList, obls: OblList }
fn check_variants(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, variants: VariantList, rectab: RecordList, enumtab: EnumList) -> (result: OblList) {
    iterate vx0 over s0 carrying a: VariantState = VariantState { rest: variants, seen: NameList.NNil, obls: OblList.LNil } {
        next a = check_variants_step(s0, s1, s2, s3, total, a, rectab, enumtab);
    }
    iterate vx1 over s1 carrying b: VariantState = a {
        next b = check_variants_step(s0, s1, s2, s3, total, b, rectab, enumtab);
    }
    iterate vx2 over s2 carrying c: VariantState = b {
        next c = check_variants_step(s0, s1, s2, s3, total, c, rectab, enumtab);
    }
    iterate vx3 over s3 carrying d: VariantState = c {
        next d = check_variants_step(s0, s1, s2, s3, total, d, rectab, enumtab);
    }
    return reverse_obls(s0, s1, s2, s3, d.obls);
}
fn check_variants_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: VariantState, rectab: RecordList, enumtab: EnumList) -> (result: VariantState) {
    return match st.rest {
        VNil => st,
        VCons { head: h, tail: t } => check_one_variant(s0, s1, s2, s3, total, st, h, t, rectab, enumtab)
    };
}
fn check_one_variant(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: VariantState, h: Variant, t: VariantList, rectab: RecordList, enumtab: EnumList) -> (result: VariantState) {
    let pobls: OblList = check_payload_fields(s0, s1, s2, s3, total, h.fields, rectab, enumtab);
    if name_known(s0, s1, s2, s3, total, st.seen, h.name_start, h.name_end) {
        let dob: Obligation = Obligation { kind: 34, start: h.name_start, end: h.name_end, status: 1 };
        return VariantState { rest: t, seen: st.seen, obls: OblList.LCons { head: dob, tail: append_obls(s0, s1, s2, s3, pobls, st.obls) } };
    }
    let seen: NameList = NameList.NCons { head: NameSpan { start: h.name_start, end: h.name_end }, tail: st.seen };
    return VariantState { rest: t, seen: seen, obls: append_obls(s0, s1, s2, s3, pobls, st.obls) };
}
fn check_payload_fields(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, fields: FieldList, rectab: RecordList, enumtab: EnumList) -> (result: OblList) {
    iterate pf0 over s0 carrying a: RecFieldState = RecFieldState { rest: fields, seen: NameList.NNil, obls: OblList.LNil } {
        next a = check_payload_fields_step(s0, s1, s2, s3, total, a, rectab, enumtab);
    }
    iterate pf1 over s1 carrying b: RecFieldState = a {
        next b = check_payload_fields_step(s0, s1, s2, s3, total, b, rectab, enumtab);
    }
    iterate pf2 over s2 carrying c: RecFieldState = b {
        next c = check_payload_fields_step(s0, s1, s2, s3, total, c, rectab, enumtab);
    }
    iterate pf3 over s3 carrying d: RecFieldState = c {
        next d = check_payload_fields_step(s0, s1, s2, s3, total, d, rectab, enumtab);
    }
    return reverse_obls(s0, s1, s2, s3, d.obls);
}
fn check_payload_fields_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: RecFieldState, rectab: RecordList, enumtab: EnumList) -> (result: RecFieldState) {
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => check_one_payload_field(s0, s1, s2, s3, total, st, h, t, rectab, enumtab)
    };
}
fn check_one_payload_field(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: RecFieldState, h: Field, t: FieldList, rectab: RecordList, enumtab: EnumList) -> (result: RecFieldState) {
    let tob: OblList = check_field_type(s0, s1, s2, s3, total, h.type_kind, h.type_start, h.type_end, rectab, enumtab, 2);
    if name_known(s0, s1, s2, s3, total, st.seen, h.name_start, h.name_end) {
        let dob: Obligation = Obligation { kind: 33, start: h.name_start, end: h.name_end, status: 1 };
        return RecFieldState { rest: t, seen: st.seen, obls: OblList.LCons { head: dob, tail: append_obls(s0, s1, s2, s3, tob, st.obls) } };
    }
    let seen: NameList = NameList.NCons { head: NameSpan { start: h.name_start, end: h.name_end }, tail: st.seen };
    return RecFieldState { rest: t, seen: seen, obls: append_obls(s0, s1, s2, s3, tob, st.obls) };
}

