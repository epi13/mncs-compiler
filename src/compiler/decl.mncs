fn op_arity(slot: u64) -> (result: u64) {
    if slot == 1 { return 2; }
    if slot == 2 { return 3; }
    if slot == 0 || slot == 3 || slot == 4 { return 1; }
    return 0;
}
fn close_call<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if st.expect_operand && op.argc != 0 { return expr_fail(st, tok.start, tok.end); }
    if st.expect_operand {
        let empty_slot: u64 = op_slot_at<P, N>(pages, stride, total, op.name_start, op.name_end);
        if empty_slot != 5 && targ_list_empty(op.targs) { return expr_fail(st, tok.start, tok.end); }
        let node: Expr = Expr.Call { name_start: op.name_start, name_end: op.name_end, args: ExprList.ENil, targs: op.targs, start: op.name_start, end: tok.end };
        return match st.operands {
            ENil => expr_fail(st, tok.start, tok.end),
            ECons { head: callee, tail: tail } => drop_callee(st, tok, rest, node, callee, tail)
        };
    }
    return match st.operands {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: last, tail: before } => close_call_args<P, N>(pages, stride, total, st, tok, op, rest, last, before)
    };
}
fn close_call_args<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList, last: Expr, before: ExprList) -> (result: ExprState) {
    let args: ExprList = reverse_exprs<P, N>(pages, stride, total, ExprList.ECons { head: last, tail: op.args });
    let slot: u64 = op_slot_at<P, N>(pages, stride, total, op.name_start, op.name_end);
    // Operation names take no type arguments: `structured_read<N>(...)`
    // parses as a plain generic call (Stage-0 agrees at parse), and the
    // proof rejects the unknown callee. Only bare operation calls reserve.
    if slot != 5 && targ_list_empty(op.targs) { return close_op_call<P, N>(pages, stride, total, st, tok, op, rest, args, slot, before); }
    let node: Expr = Expr.Call { name_start: op.name_start, name_end: op.name_end, args: args, targs: op.targs, start: op.name_start, end: tok.end };
    return match before {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: callee, tail: tail } => drop_callee(st, tok, rest, node, callee, tail)
    };
}
fn close_op_call<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList, args: ExprList, slot: u64, before: ExprList) -> (result: ExprState) {
    if op.argc + 1 != op_arity(slot) { return expr_fail(st, tok.start, tok.end); }
    let node: Expr = Expr.OpCall { slot: slot, name_start: op.name_start, name_end: op.name_end, args: args, start: op.name_start, end: tok.end };
    return match before {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: callee, tail: tail } => drop_callee(st, tok, rest, node, callee, tail)
    };
}
// The callee name operand sits below its arguments by stack discipline;
// popping it here restores the single-value invariant. Anything else in
// that position is an internal caller error, reported at the paren.
fn drop_callee(st: ExprState, tok: lexer.Token, rest: OpList, node: Expr, callee: Expr, tail: ExprList) -> (result: ExprState) {
    return match callee {
        Name { start: s, end: e } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: tail }, operators: rest, depth: st.depth - 1, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct },
        Integer { start: s, end: e, value: v, overflow: o } => expr_fail(st, tok.start, tok.end),
        Boolean { start: s, end: e, value: v } => expr_fail(st, tok.start, tok.end),
        UnaryNot { value: v, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Binary { op: o, left: l, right: r, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Call { name_start: s, name_end: e, args: a, targs: tg, start: t, end: n } => expr_fail(st, tok.start, tok.end),
        Project { base: b, field_start: f, field_end: g, start: s, end: e, path: p } => expr_fail(st, tok.start, tok.end),
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => expr_fail(st, tok.start, tok.end)
    };
}

fn comma_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
    return match st.operators {
        ONil => expr_fail(st, tok.start, tok.end),
        OCons { head: op, tail: rest } => comma_top<P, N>(pages, stride, total, st, tok, op, rest)
    };
}
fn comma_top<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if op.kind < 1000 || op.kind == 1002 { return reduce_one(st, op, rest, tok.start, tok.end); }
    if op.kind == 1001 {
        return match st.operands {
            ENil => expr_fail(st, tok.start, tok.end),
            ECons { head: arg, tail: before } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: before, operators: OpList.OCons { head: Op { kind: 1001, argc: op.argc + 1, name_start: op.name_start, name_end: op.name_end, args: ExprList.ECons { head: arg, tail: op.args }, targs: op.targs }, tail: rest }, depth: st.depth, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct }
        };
    }
    if op.kind == 1004 {
        return construct_comma<P, N>(pages, stride, total, st, tok, op, rest);
    }
    if op.kind == 1005 {
        return construct_comma<P, N>(pages, stride, total, st, tok, op, rest);
    }
    if op.kind == 1006 {
        return record_base_comma<P, N>(pages, stride, total, st, tok, op, rest);
    }
    return expr_fail(st, tok.start, tok.end);
}

fn project_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
    let field: lexer.Token = segment.significant_global<P, N>(pages, stride, total, tok.end);
    if field.diagnostic != 0 || (field.kind != 4 && !(field.kind == 34 && st.profile_013)) { return expr_fail(st, field.start, field.end); }
    return match st.operands {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: base, tail: before } => project_base(st, tok, field, base, before)
    };
}
// Stage-0 ends a record literal before any `.`: the delimiter lands where
// the enclosing statement reports it, so a projection directly off a
// literal fails here at the dot on both sides.
fn project_base(st: ExprState, tok: lexer.Token, field: lexer.Token, base: Expr, before: ExprList) -> (result: ExprState) {
    return match base {
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Name { start: s, end: e } => project_build(st, field, base, before),
        Integer { start: s, end: e, value: v, overflow: o } => project_build(st, field, base, before),
        Boolean { start: s, end: e, value: v } => project_build(st, field, base, before),
        UnaryNot { value: v, start: s, end: e } => project_build(st, field, base, before),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => project_build(st, field, base, before),
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => project_build(st, field, base, before),
        Binary { op: o, left: l, right: r, start: s, end: e } => project_build(st, field, base, before),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e } => project_build(st, field, base, before),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => project_build(st, field, base, before),
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => project_build(st, field, base, before),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => project_build(st, field, base, before),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => project_build(st, field, base, before)
    };
}
fn project_build(st: ExprState, field: lexer.Token, base: Expr, before: ExprList) -> (result: ExprState) {
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: field.end, operands: ExprList.ECons { head: Expr.Project { base: base, field_start: field.start, field_end: field.end, start: expr_start(base), end: field.end, path: base_is_path(base) }, tail: before }, operators: st.operators, depth: st.depth, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
// A projection continues a namespace path only over a bare name or a path
// projection. Anything else (calls, operators) ends the path, so a later
// paren stops the expression instead of forming a qualified call.
fn base_is_path(base: Expr) -> (result: bool) {
    return match base {
        Name { start: s, end: e } => true,
        Project { base: b, field_start: f, field_end: g, start: s, end: e, path: p } => p,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => false,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => false,
        Integer { start: s, end: e, value: v, overflow: o } => false,
        Boolean { start: s, end: e, value: v } => false,
        UnaryNot { value: v, start: s, end: e } => false,
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => false,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => false,
        Binary { op: o, left: l, right: r, start: s, end: e } => false,
        Call { name_start: s, name_end: e, args: a, targs: tg, start: t, end: n } => false,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => false
    };
}
// A paren after a complete operand: a qualified call over a namespace path,
// or the end of the expression (Stage-0 rejects `(f)(1)` the same way).
fn path_call<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    return match st.operands {
        ENil => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        ECons { head: base, tail: before } => path_call_top<P, N>(pages, stride, total, st, tok, base, before)
    };
}
fn path_call_top<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, base: Expr, before: ExprList) -> (result: ExprState) {
    return match base {
        Name { start: s, end: e } => path_call_push(st, tok, s, e, before),
        Project { base: b, field_start: f, field_end: g, start: s, end: e, path: p } => path_call_project<P, N>(pages, stride, total, st, tok, s, e, p, before),
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        Integer { start: s, end: e, value: v, overflow: o } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        Boolean { start: s, end: e, value: v } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        UnaryNot { value: v, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        Binary { op: o, left: l, right: r, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        Call { name_start: s, name_end: e, args: a, targs: tg, start: t, end: n } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end)
    };
}
fn path_call_project<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, start: u64, end: u64, path: bool, before: ExprList) -> (result: ExprState) {
    if path { return path_call_push(st, tok, start, end, before); }
    return close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end);
}
// The path span stands in for the callee operand so call closing keeps its
// single stack shape: the callee below the arguments is always a Name.
fn path_call_push(st: ExprState, tok: lexer.Token, start: u64, end: u64, before: ExprList) -> (result: ExprState) {
    let callee: Expr = Expr.Name { start: start, end: end };
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: callee, tail: before }, operators: OpList.OCons { head: Op { kind: 1001, argc: 0, name_start: start, name_end: end, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: st.operators }, depth: st.depth + 1, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
// A `{` after a complete operand: enum construction over a single-level
// `Type.Variant` path, record construction over a bare `Name` when the
// brace holds `..` or `field:`, or the end of the expression (statement
// and match bodies own their braces; the noconstruct entries never reach
// this step at depth 0).
fn construct_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    return match st.operands {
        ENil => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        ECons { head: base, tail: before } => construct_top<P, N>(pages, stride, total, st, tok, base, before)
    };
}
fn construct_top<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, base: Expr, before: ExprList) -> (result: ExprState) {
    return match base {
        Name { start: s, end: e } => record_or_close<P, N>(pages, stride, total, st, tok, s, e, before),
        Integer { start: s, end: e, value: v, overflow: o } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        Boolean { start: s, end: e, value: v } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        UnaryNot { value: v, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        Binary { op: o, left: l, right: r, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => construct_project<P, N>(pages, stride, total, st, tok, b, fs, fe, s, before),
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end)
    };
}
fn construct_project<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, b: Expr, fs: u64, fe: u64, s: u64, before: ExprList) -> (result: ExprState) {
    return match b {
        Name { start: ns, end: ne } => construct_push(st, tok, ns, ne, fs, fe, s, before),
        Integer { start: x, end: y, value: v, overflow: o } => expr_fail(st, tok.start, tok.end),
        Boolean { start: x, end: y, value: v } => expr_fail(st, tok.start, tok.end),
        UnaryNot { value: v, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        ScalarMatch { subject: subject, arms: arms, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Binary { op: o, left: l, right: r, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Project { base: q, field_start: gs, field_end: ge, start: x, end: y, path: p } => expr_fail(st, tok.start, tok.end),
        FiniteMatch { subject: subject, arms: arms, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: x, end: y } => expr_fail(st, tok.start, tok.end)
    };
}
fn construct_push(st: ExprState, tok: lexer.Token, ns: u64, ne: u64, fs: u64, fe: u64, s: u64, before: ExprList) -> (result: ExprState) {
    let node: Expr = Expr.EnumConstruct { type_start: ns, type_end: ne, variant_start: fs, variant_end: fe, fields: ConstructFieldList.CNil, start: s, end: 0 };
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: before }, operators: OpList.OCons { head: Op { kind: 1004, argc: 0, name_start: 0, name_end: 0, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: st.operators }, depth: st.depth + 1, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
// A `{` after a bare name opens a record literal only when the brace holds
// `..` or `field:`, mirroring the Stage-0 record-literal lookahead; an
// empty brace, a block body, or any other token still closes the
// expression, so `if x {` and `R {}` keep their historical spans.
fn record_or_close<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, s: u64, e: u64, before: ExprList) -> (result: ExprState) {
    if at_record_literal<P, N>(pages, stride, total, tok.end) { return record_push(st, tok, s, e, before); }
    return close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end);
}
fn at_record_literal<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: bool) {
    let first: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if first.diagnostic != 0 { return false; }
    if first.kind == 90 { return true; }
    if first.kind == 4 { return at_record_field<P, N>(pages, stride, total, first.end); }
    return false;
}
fn at_record_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: bool) {
    let second: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if second.diagnostic != 0 { return false; }
    return second.kind == 62;
}
fn record_push(st: ExprState, tok: lexer.Token, s: u64, e: u64, before: ExprList) -> (result: ExprState) {
    let node: Expr = Expr.RecordConstruct { type_start: s, type_end: e, base: Expr.Name { start: 0, end: 0 }, has_base: false, fields: ConstructFieldList.CNil, start: s, end: 0 };
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: before }, operators: OpList.OCons { head: Op { kind: 1005, argc: 0, name_start: 0, name_end: 0, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: st.operators }, depth: st.depth + 1, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
fn colon_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    return match st.operators {
        ONil => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        OCons { head: op, tail: rest } => colon_top<P, N>(pages, stride, total, st, tok, op, rest)
    };
}
fn colon_top<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if op.kind == 1004 && op.argc == 0 && !(st.expect_operand) { return colon_field<P, N>(pages, stride, total, st, tok, op, rest); }
    if op.kind == 1005 && op.argc == 0 && !(st.expect_operand) { return colon_field<P, N>(pages, stride, total, st, tok, op, rest); }
    return close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end);
}
fn colon_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    return match st.operands {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: name, tail: before } => colon_name<P, N>(pages, stride, total, st, tok, op, rest, name, before)
    };
}
fn colon_name<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList, name: Expr, before: ExprList) -> (result: ExprState) {
    return match name {
        Name { start: s, end: e } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: before, operators: OpList.OCons { head: Op { kind: op.kind, argc: 1, name_start: s, name_end: e, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: rest }, depth: st.depth, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct },
        Integer { start: s, end: e, value: v, overflow: o } => expr_fail(st, tok.start, tok.end),
        Boolean { start: s, end: e, value: v } => expr_fail(st, tok.start, tok.end),
        UnaryNot { value: v, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Binary { op: o, left: l, right: r, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => expr_fail(st, tok.start, tok.end),
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => expr_fail(st, tok.start, tok.end)
    };
}
fn construct_comma<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if op.argc != 1 { return expr_fail(st, tok.start, tok.end); }
    return match st.operands {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: value, tail: below } => construct_accumulate(st, tok, op, rest, value, below)
    };
}
fn construct_accumulate(st: ExprState, tok: lexer.Token, op: Op, rest: OpList, value: Expr, below: ExprList) -> (result: ExprState) {
    return match below {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: node, tail: before } => construct_append(st, tok, op, rest, value, node, before)
    };
}
fn construct_append(st: ExprState, tok: lexer.Token, op: Op, rest: OpList, value: Expr, node: Expr, before: ExprList) -> (result: ExprState) {
    return match node {
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: Expr.EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: ConstructFieldList.CCons { head: ConstructField { field_start: op.name_start, field_end: op.name_end, value: value }, tail: f }, start: s, end: 0 }, tail: before }, operators: OpList.OCons { head: Op { kind: op.kind, argc: 0, name_start: 0, name_end: 0, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: rest }, depth: st.depth, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct },
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: Expr.RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: ConstructFieldList.CCons { head: ConstructField { field_start: op.name_start, field_end: op.name_end, value: value }, tail: f }, start: s, end: 0 }, tail: before }, operators: OpList.OCons { head: Op { kind: op.kind, argc: 0, name_start: 0, name_end: 0, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: rest }, depth: st.depth, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct },
        Name { start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Integer { start: s, end: e, value: v, overflow: o } => expr_fail(st, tok.start, tok.end),
        Boolean { start: s, end: e, value: v } => expr_fail(st, tok.start, tok.end),
        UnaryNot { value: v, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Binary { op: o, left: l, right: r, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => expr_fail(st, tok.start, tok.end),
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => expr_fail(st, tok.start, tok.end)
    };
}
fn close_brace<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    return match st.operators {
        ONil => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        OCons { head: op, tail: rest } => close_brace_top<P, N>(pages, stride, total, st, tok, op, rest)
    };
}
fn close_brace_top<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if op.kind == 1004 { return close_construct<P, N>(pages, stride, total, st, tok, op, rest); }
    if op.kind == 1005 { return close_construct<P, N>(pages, stride, total, st, tok, op, rest); }
    if op.kind == 1006 { return record_base_close<P, N>(pages, stride, total, st, tok, op, rest); }
    return close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end);
}
fn close_construct<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if st.expect_operand && op.argc == 0 { return close_construct_empty<P, N>(pages, stride, total, st, tok, op, rest); }
    if st.expect_operand || op.argc != 1 { return expr_fail(st, tok.start, tok.end); }
    return match st.operands {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: value, tail: below } => close_construct_value<P, N>(pages, stride, total, st, tok, op, rest, value, below)
    };
}
fn close_construct_empty<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    return match st.operands {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: node, tail: before } => close_construct_no_fields<P, N>(pages, stride, total, st, tok, rest, node, before)
    };
}
fn close_construct_no_fields<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, rest: OpList, node: Expr, before: ExprList) -> (result: ExprState) {
    return match node {
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => close_construct_finish<P, N>(pages, stride, total, st, tok, rest, ts, te, vs, ve, f, dummy_construct_field(), false, s, before),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => close_record_finish<P, N>(pages, stride, total, st, tok, rest, ts, te, b, hb, f, dummy_construct_field(), false, s, before),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Name { start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Integer { start: x, end: y, value: v, overflow: o } => expr_fail(st, tok.start, tok.end),
        Boolean { start: x, end: y, value: v } => expr_fail(st, tok.start, tok.end),
        UnaryNot { value: v, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        ScalarMatch { subject: subject, arms: arms, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Binary { op: o, left: l, right: r, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Project { base: b, field_start: fs, field_end: fe, start: x, end: y, path: p } => expr_fail(st, tok.start, tok.end),
        FiniteMatch { subject: subject, arms: arms, start: x, end: y } => expr_fail(st, tok.start, tok.end)
    };
}
fn close_construct_value<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList, value: Expr, below: ExprList) -> (result: ExprState) {
    return match below {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: node, tail: before } => close_construct_field<P, N>(pages, stride, total, st, tok, op, rest, value, node, before)
    };
}
fn close_construct_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList, value: Expr, node: Expr, before: ExprList) -> (result: ExprState) {
    return match node {
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => close_construct_finish<P, N>(pages, stride, total, st, tok, rest, ts, te, vs, ve, f, ConstructField { field_start: op.name_start, field_end: op.name_end, value: value }, true, s, before),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => close_record_finish<P, N>(pages, stride, total, st, tok, rest, ts, te, b, hb, f, ConstructField { field_start: op.name_start, field_end: op.name_end, value: value }, true, s, before),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Name { start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Integer { start: x, end: y, value: v, overflow: o } => expr_fail(st, tok.start, tok.end),
        Boolean { start: x, end: y, value: v } => expr_fail(st, tok.start, tok.end),
        UnaryNot { value: v, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        ScalarMatch { subject: subject, arms: arms, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Binary { op: o, left: l, right: r, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: x, end: y } => expr_fail(st, tok.start, tok.end),
        Project { base: b, field_start: fs, field_end: fe, start: x, end: y, path: p } => expr_fail(st, tok.start, tok.end),
        FiniteMatch { subject: subject, arms: arms, start: x, end: y } => expr_fail(st, tok.start, tok.end)
    };
}
fn dummy_construct_field() -> (result: ConstructField) {
    return ConstructField { field_start: 0, field_end: 0, value: Expr.Name { start: 0, end: 0 } };
}
fn close_construct_finish<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, rest: OpList, ts: u64, te: u64, vs: u64, ve: u64, f: ConstructFieldList, last: ConstructField, has_last: bool, s: u64, before: ExprList) -> (result: ExprState) {
    let rev: ConstructFieldList = close_construct_rev(f, last, has_last);
    let fields: ConstructFieldList = reverse_construct_fields<P, N>(pages, stride, total, rev);
    let node: Expr = Expr.EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: fields, start: s, end: tok.end };
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: before }, operators: rest, depth: st.depth - 1, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
fn close_record_finish<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, rest: OpList, ts: u64, te: u64, b: Expr, hb: bool, f: ConstructFieldList, last: ConstructField, has_last: bool, s: u64, before: ExprList) -> (result: ExprState) {
    let rev: ConstructFieldList = close_construct_rev(f, last, has_last);
    let fields: ConstructFieldList = reverse_construct_fields<P, N>(pages, stride, total, rev);
    let node: Expr = Expr.RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: fields, start: s, end: tok.end };
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: before }, operators: rest, depth: st.depth - 1, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
// A `..` in operand position opens a record base only directly inside a
// fresh 1005 frame (no base yet, no fields yet); anywhere else it keeps
// the historical close behavior, so slice/index `..` failures land on
// their established spans.
fn dotdot_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    return match st.operators {
        ONil => close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end),
        OCons { head: op, tail: rest } => dotdot_top<P, N>(pages, stride, total, st, tok, op, rest)
    };
}
fn dotdot_top<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if op.kind != 1005 || op.argc != 0 { return close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end); }
    return match st.operands {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: node, tail: before } => dotdot_node(st, tok, node, before)
    };
}
fn dotdot_node(st: ExprState, tok: lexer.Token, node: Expr, before: ExprList) -> (result: ExprState) {
    return match node {
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => dotdot_record(st, tok, hb, f),
        Name { start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Integer { start: s, end: e, value: v, overflow: o } => expr_fail(st, tok.start, tok.end),
        Boolean { start: s, end: e, value: v } => expr_fail(st, tok.start, tok.end),
        UnaryNot { value: v, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Binary { op: o, left: l, right: r, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => expr_fail(st, tok.start, tok.end),
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => expr_fail(st, tok.start, tok.end),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => expr_fail(st, tok.start, tok.end)
    };
}
fn dotdot_record(st: ExprState, tok: lexer.Token, hb: bool, f: ConstructFieldList) -> (result: ExprState) {
    if hb || !(construct_fields_empty(f)) { return expr_fail(st, tok.start, tok.end); }
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: st.operands, operators: OpList.OCons { head: Op { kind: 1006, argc: 0, name_start: 0, name_end: 0, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: st.operators }, depth: st.depth, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
// The `,`/`}` ending a `..base` operand: pending binary operators above
// the 1006 marker reduce through the shared comma path first, so arrival
// here means exactly one base value sits over the record node.
record RecordFrameParts { ok: bool, ts: u64, te: u64, f: ConstructFieldList, s: u64 }
fn record_frame_parts(node: Expr) -> (result: RecordFrameParts) {
    return match node {
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => RecordFrameParts { ok: true, ts: ts, te: te, f: f, s: s },
        Name { start: s, end: e } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 },
        Integer { start: s, end: e, value: v, overflow: o } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 },
        Boolean { start: s, end: e, value: v } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 },
        UnaryNot { value: v, start: s, end: e } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 },
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 },
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 },
        Binary { op: o, left: l, right: r, start: s, end: e } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 },
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 },
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 },
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 },
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 },
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => RecordFrameParts { ok: false, ts: 0, te: 0, f: ConstructFieldList.CNil, s: 0 }
    };
}
fn record_base_comma<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
    return match st.operands {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: base, tail: below } => record_base_below<P, N>(pages, stride, total, st, tok, rest, base, below, false)
    };
}
fn record_base_close<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
    return match st.operands {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: base, tail: below } => record_base_below<P, N>(pages, stride, total, st, tok, rest, base, below, true)
    };
}
fn record_base_below<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, rest: OpList, base: Expr, below: ExprList, is_close: bool) -> (result: ExprState) {
    return match below {
        ENil => expr_fail(st, tok.start, tok.end),
        ECons { head: node, tail: before } => record_base_resolve<P, N>(pages, stride, total, st, tok, rest, base, node, before, is_close)
    };
}
fn record_base_resolve<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, rest: OpList, base: Expr, node: Expr, before: ExprList, is_close: bool) -> (result: ExprState) {
    let parts: RecordFrameParts = record_frame_parts(node);
    if !(parts.ok) { return expr_fail(st, tok.start, tok.end); }
    return match rest {
        ONil => expr_fail(st, tok.start, tok.end),
        OCons { head: frame, tail: rest2 } => record_base_frame<P, N>(pages, stride, total, st, tok, frame, rest, rest2, base, parts, before, is_close)
    };
}
fn record_base_frame<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, frame: Op, rest: OpList, rest2: OpList, base: Expr, parts: RecordFrameParts, before: ExprList, is_close: bool) -> (result: ExprState) {
    if frame.kind != 1005 || frame.argc != 0 { return expr_fail(st, tok.start, tok.end); }
    if is_close { return close_record_finish_from_parts<P, N>(pages, stride, total, st, tok, rest2, base, parts, before); }
    let node: Expr = Expr.RecordConstruct { type_start: parts.ts, type_end: parts.te, base: base, has_base: true, fields: parts.f, start: parts.s, end: 0 };
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: before }, operators: rest, depth: st.depth, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
// A base-closing `}` finishes the literal: the base is always first, so no
// fields accumulated yet and the shared finish path applies directly.
fn close_record_finish_from_parts<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, rest2: OpList, base: Expr, parts: RecordFrameParts, before: ExprList) -> (result: ExprState) {
    return close_record_finish<P, N>(pages, stride, total, st, tok, rest2, parts.ts, parts.te, base, true, parts.f, dummy_construct_field(), false, parts.s, before);
}
fn close_construct_rev(f: ConstructFieldList, last: ConstructField, has_last: bool) -> (result: ConstructFieldList) {
    if has_last { return ConstructFieldList.CCons { head: last, tail: f }; }
    return f;
}
record ConstructFieldRev { rest: ConstructFieldList, acc: ConstructFieldList }
fn reverse_construct_fields<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: ConstructFieldList) -> (result: ConstructFieldList) {
    iterate i up_to 1024 carrying d: ConstructFieldRev = ConstructFieldRev { rest: fields, acc: ConstructFieldList.CNil } {
        if construct_fields_empty(d.rest) { return d.acc; }
        next d = reverse_construct_fields_step(d);
    }
    return d.acc;
}
fn reverse_construct_fields_step(st: ConstructFieldRev) -> (result: ConstructFieldRev) {
    return match st.rest {
        CNil => st,
        CCons { head: h, tail: t } => ConstructFieldRev { rest: t, acc: ConstructFieldList.CCons { head: h, tail: st.acc } }
    };
}
fn construct_fields_empty(list: ConstructFieldList) -> (result: bool) {
    return match list { CNil => true, CCons { head: head, tail: tail } => false };
}

fn operator_step(st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
    return match st.operators {
        ONil => ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: st.operands, operators: OpList.OCons { head: Op { kind: tok.kind, argc: 0, name_start: 0, name_end: 0, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: st.operators }, depth: st.depth, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct },
        OCons { head: op, tail: rest } => operator_top(st, tok, op, rest)
    };
}
fn operator_top(st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if op.kind == 1002 || (op.kind < 1000 && prec(op.kind) >= prec(tok.kind)) { return reduce_one(st, op, rest, tok.start, tok.end); }
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: st.operands, operators: OpList.OCons { head: Op { kind: tok.kind, argc: 0, name_start: 0, name_end: 0, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: st.operators }, depth: st.depth, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct };
}

// `<` after a Name or namespace path: a type-argument list when Stage-0's
// lookahead rule matches (a balancing `>` within 32 significant tokens,
// then `(`), else the less-than operator. The scan mirrors Stage-0's
// generic_args lookahead exactly: `<`/`>` depth counting, `>>` closing two
// depths, `[`/`]` square tracking, and brace/semicolon abort. A scan match
// is provisional like Stage-0's: when the argument parse fails (or no `(`
// follows the parsed list), parsing backtracks to the comparison operator
// instead of failing, so `g<1+2>(x)` and `f<G<H>>(x)` read as comparisons
// on both sides. Only the profile gate below 0.10 fails at the bracket
// (Stage-0 MNP189); the native machine has no continue-with-diagnostic
// state, and the first-error span is what the differential compares.
record LtScan { cursor: u64, depth: u64, square: u64, steps: u64, found: bool, done: bool }
fn generic_bracket_scan<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: bool) {
    // Exactly 32 significant tokens like Stage-0's lookahead window; the
    // loop bound is the cap, so no step needs its own count check.
    iterate i up_to 32 carrying d: LtScan = LtScan { cursor: cursor, depth: 1, square: 0, steps: 0, found: false, done: false } {
        next d = generic_bracket_step<P, N>(pages, stride, total, d);
    }
    return d.found;
}
fn generic_bracket_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LtScan) -> (result: LtScan) {
    if st.done { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if token.diagnostic != 0 || token.kind == 0 { return LtScan { cursor: st.cursor, depth: st.depth, square: st.square, steps: st.steps, found: false, done: true }; }
    if token.kind == 58 { return LtScan { cursor: token.end, depth: st.depth + 1, square: st.square, steps: st.steps + 1, found: false, done: false }; }
    if token.kind == 69 { return LtScan { cursor: token.end, depth: st.depth, square: st.square + 1, steps: st.steps + 1, found: false, done: false }; }
    if token.kind == 70 {
        let square: u64 = select(st.square == 0, 0, st.square - 1);
        return LtScan { cursor: token.end, depth: st.depth, square: square, steps: st.steps + 1, found: false, done: false };
    }
    if token.kind == 59 {
        if st.depth == 1 { return generic_bracket_close<P, N>(pages, stride, total, st, token); }
        return LtScan { cursor: token.end, depth: st.depth - 1, square: st.square, steps: st.steps + 1, found: false, done: false };
    }
    if token.kind == 89 {
        if st.depth <= 2 { return generic_bracket_close<P, N>(pages, stride, total, st, token); }
        return LtScan { cursor: token.end, depth: st.depth - 2, square: st.square, steps: st.steps + 1, found: false, done: false };
    }
    if st.depth == 1 && st.square == 0 && (token.kind == 67 || token.kind == 68 || token.kind == 63) {
        return LtScan { cursor: st.cursor, depth: st.depth, square: st.square, steps: st.steps, found: false, done: true };
    }
    return LtScan { cursor: token.end, depth: st.depth, square: st.square, steps: st.steps + 1, found: false, done: false };
}
fn generic_bracket_close<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LtScan, token: lexer.Token) -> (result: LtScan) {
    let after: lexer.Token = segment.significant_global<P, N>(pages, stride, total, token.end);
    if after.diagnostic == 0 && after.kind == 65 {
        return LtScan { cursor: st.cursor, depth: st.depth, square: st.square, steps: st.steps, found: true, done: true };
    }
    return LtScan { cursor: st.cursor, depth: st.depth, square: st.square, steps: st.steps, found: false, done: true };
}

// Committed type-argument list `<T, 4, ...>` (Stage-0 generic_args past its
// lookahead). Each argument is an integer literal or a type spelling;
// nested `<`/`>>` inside the list is the deferred nested-argument shape
// and fails explicitly at the bracket.
record TArgsParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: TypeArgList }
record TArgsState { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: TypeArgList, done: bool }
fn parse_type_args<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: TArgsParse) {
    let open: Expect = expect<P, N>(pages, stride, total, cursor, 58);
    if !(open.ok) { return TArgsParse { cursor: cursor, ok: false, err_start: open.err_start, err_end: open.err_end, list: TypeArgList.TNil }; }
    iterate i up_to 1024 carrying d: TArgsState = TArgsState { cursor: open.cursor, ok: true, err_start: 0, err_end: 0, list: TypeArgList.TNil, done: false } {
        next d = type_args_step<P, N>(pages, stride, total, d);
    }
    if !(d.ok) { return TArgsParse { cursor: d.cursor, ok: false, err_start: d.err_start, err_end: d.err_end, list: TypeArgList.TNil }; }
    if !(d.done) { return TArgsParse { cursor: d.cursor, ok: false, err_start: d.cursor, err_end: d.cursor, list: TypeArgList.TNil }; }
    return TArgsParse { cursor: d.cursor, ok: true, err_start: 0, err_end: 0, list: reverse_targs<P, N>(pages, stride, total, d.list) };
}
fn type_args_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TArgsState) -> (result: TArgsState) {
    if !(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if token.diagnostic == 0 && token.kind == 59 { return TArgsState { cursor: token.end, ok: true, err_start: 0, err_end: 0, list: st.list, done: true }; }
    if token.diagnostic == 0 && (token.kind == 58 || token.kind == 89) {
        return TArgsState { cursor: st.cursor, ok: false, err_start: token.start, err_end: token.end, list: st.list, done: true };
    }
    if token.diagnostic == 0 && token.kind == 5 {
        return type_args_after<P, N>(pages, stride, total, st, TypeArg { start: token.start, end: token.end, kind: 10 }, token.end);
    }
    let parsed: TypeParse = parse_type<P, N>(pages, stride, total, st.cursor);
    if !(parsed.ok) { return TArgsState { cursor: st.cursor, ok: false, err_start: parsed.err_start, err_end: parsed.err_end, list: st.list, done: true }; }
    return type_args_after<P, N>(pages, stride, total, st, TypeArg { start: parsed.node.start, end: parsed.node.end, kind: parsed.node.kind }, parsed.cursor);
}
fn type_args_after<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TArgsState, arg: TypeArg, cursor: u64) -> (result: TArgsState) {
    let list: TypeArgList = TypeArgList.TCons { head: arg, tail: st.list };
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if token.diagnostic == 0 && token.kind == 64 {
        return TArgsState { cursor: token.end, ok: true, err_start: 0, err_end: 0, list: list, done: false };
    }
    if token.diagnostic == 0 && token.kind == 59 {
        return TArgsState { cursor: token.end, ok: true, err_start: 0, err_end: 0, list: list, done: true };
    }
    return TArgsState { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, list: list, done: true };
}

// `<` in operator position after a complete operand: a generic call when
// the top operand is a bare name or namespace path and the bracket scan
// matches, else the less-than operator. A parenthesized callee keeps its
// transparent Name operand, so `(f)<N>(x)` commits to a generic call
// where Stage-0 reads a comparison; that pathological shape is a known
// boundary (no real source parenthesizes a generic callee).
fn lt_or_type_args<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    return match st.operands {
        ENil => operator_step(st, tok),
        ECons { head: base, tail: before } => lt_or_type_args_top<P, N>(pages, stride, total, st, tok, base, before)
    };
}
fn lt_or_type_args_top<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, base: Expr, before: ExprList) -> (result: ExprState) {
    return match base {
        Name { start: s, end: e } => try_generic_call<P, N>(pages, stride, total, st, tok, s, e, before),
        Project { base: b, field_start: f, field_end: g, start: s, end: e, path: p } => lt_generic_project<P, N>(pages, stride, total, st, tok, s, e, p, before),
        Integer { start: s, end: e, value: v, overflow: o } => operator_step(st, tok),
        Boolean { start: s, end: e, value: v } => operator_step(st, tok),
        UnaryNot { value: v, start: s, end: e } => operator_step(st, tok),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => operator_step(st, tok),
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => operator_step(st, tok),
        Binary { op: o, left: l, right: r, start: s, end: e } => operator_step(st, tok),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e } => operator_step(st, tok),
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => operator_step(st, tok),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => operator_step(st, tok),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => operator_step(st, tok),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => operator_step(st, tok)
    };
}
fn lt_generic_project<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, start: u64, end: u64, path: bool, before: ExprList) -> (result: ExprState) {
    if path { return try_generic_call<P, N>(pages, stride, total, st, tok, start, end, before); }
    return operator_step(st, tok);
}
fn try_generic_call<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, start: u64, end: u64, before: ExprList) -> (result: ExprState) {
    if !(generic_bracket_scan<P, N>(pages, stride, total, tok.end)) {
        return operator_step(st, tok);
    }
    if !(generics_profile_ok<P, N>(pages, stride, total)) {
        return expr_fail(st, tok.start, tok.end);
    }
    let targs: TArgsParse = parse_type_args<P, N>(pages, stride, total, st.cursor);
    if !(targs.ok) { return operator_step(st, tok); }
    let open: Expect = expect<P, N>(pages, stride, total, targs.cursor, 65);
    if !(open.ok) { return operator_step(st, tok); }
    let callee: Expr = Expr.Name { start: start, end: end };
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: open.cursor, operands: ExprList.ECons { head: callee, tail: before }, operators: OpList.OCons { head: Op { kind: 1001, argc: 0, name_start: start, name_end: end, args: ExprList.ENil, targs: targs.list }, tail: st.operators }, depth: st.depth + 1, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct };
}

fn finish_expr<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState) -> (result: ExprParse) {
    let bad: Expr = Expr.Name { start: st.cursor, end: st.cursor };
    if !(st.ok) { return ExprParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, node: bad, start: st.cursor, end: st.cursor }; }
    if !(st.done) { return ExprParse { cursor: st.cursor, ok: false, err_start: st.cursor, err_end: st.cursor, node: bad, start: st.cursor, end: st.cursor }; }
    return match st.operands {
        ENil => finish_empty<P, N>(pages, stride, total, st, bad),
        ECons { head: node, tail: rest } => finish_single(st, node, rest)
    };
}
// An expression that closed before shifting any operand: the next
// significant token is the unexpected delimiter Stage-0 reports, not the
// pre-token cursor, so fail at its span in every value position.
fn finish_empty<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, bad: Expr) -> (result: ExprParse) {
    let tok: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    return ExprParse { cursor: st.cursor, ok: false, err_start: tok.start, err_end: tok.end, node: bad, start: st.cursor, end: st.cursor };
}
fn finish_single(st: ExprState, node: Expr, rest: ExprList) -> (result: ExprParse) {
    return match rest {
        ENil => ExprParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, node: node, start: expr_start(node), end: expr_end(node) },
        ECons { head: extra, tail: more } => ExprParse { cursor: st.cursor, ok: false, err_start: expr_start(extra), err_end: expr_end(extra), node: node, start: st.cursor, end: st.cursor }
    };
}

// Argument/order restoration shared with declaration lists.
record ExprRev { rest: ExprList, acc: ExprList }
fn reverse_exprs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: ExprList) -> (result: ExprList) {
    iterate i up_to 1024 carrying d: ExprRev = ExprRev { rest: list, acc: ExprList.ENil } {
        if expr_list_empty(d.rest) { return d.acc; }
        next d = reverse_exprs_step(d);
    }
    return d.acc;
}
fn reverse_exprs_step(st: ExprRev) -> (result: ExprRev) {
    return match st.rest { ENil => st, ECons { head: h, tail: t } => ExprRev { rest: t, acc: ExprList.ECons { head: h, tail: st.acc } } };
}
fn targ_list_empty(list: TypeArgList) -> (result: bool) {
    return match list { TNil => true, TCons { head: h, tail: t } => false };
}
fn generic_list_empty(list: GenericParamList) -> (result: bool) {
    return match list { GNil => true, GCons { head: h, tail: t } => false };
}
record TargRev { rest: TypeArgList, acc: TypeArgList }
fn reverse_targs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: TypeArgList) -> (result: TypeArgList) {
    iterate i up_to 1024 carrying d: TargRev = TargRev { rest: list, acc: TypeArgList.TNil } {
        if targ_list_empty(d.rest) { return d.acc; }
        next d = reverse_targs_step(d);
    }
    return d.acc;
}
fn reverse_targs_step(st: TargRev) -> (result: TargRev) {
    return match st.rest { TNil => st, TCons { head: h, tail: t } => TargRev { rest: t, acc: TypeArgList.TCons { head: h, tail: st.acc } } };
}
record GenericRev { rest: GenericParamList, acc: GenericParamList }
fn reverse_generics<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: GenericParamList) -> (result: GenericParamList) {
    iterate i up_to 1024 carrying d: GenericRev = GenericRev { rest: list, acc: GenericParamList.GNil } {
        if generic_list_empty(d.rest) { return d.acc; }
        next d = reverse_generics_step(d);
    }
    return d.acc;
}
fn reverse_generics_step(st: GenericRev) -> (result: GenericRev) {
    return match st.rest { GNil => st, GCons { head: h, tail: t } => GenericRev { rest: t, acc: GenericParamList.GCons { head: h, tail: st.acc } } };
}
fn bound_list_empty(list: GenericBoundList) -> (result: bool) {
    return match list { KNil => true, KCons { head: h, tail: t } => false };
}
record BoundRev { rest: GenericBoundList, acc: GenericBoundList }
fn reverse_bounds<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: GenericBoundList) -> (result: GenericBoundList) {
    iterate i up_to 1024 carrying d: BoundRev = BoundRev { rest: list, acc: GenericBoundList.KNil } {
        if bound_list_empty(d.rest) { return d.acc; }
        next d = reverse_bounds_step(d);
    }
    return d.acc;
}
fn reverse_bounds_step(st: BoundRev) -> (result: BoundRev) {
    return match st.rest { KNil => st, KCons { head: h, tail: t } => BoundRev { rest: t, acc: GenericBoundList.KCons { head: h, tail: st.acc } } };
}
// Classify one generic parameter bound from its source bytes: 0 Nat,
// 1 Type (or absent — unconstrained parameters accept types only),
// 2 higher/other kinds.
fn generic_bound_kind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, param: GenericParam) -> (result: u64) {
    if !(param.has_bound) { return 1; }
    if param.bound_end - param.bound_start == 3 {
        if segment.byte_at_global<P, N>(pages, stride, total, param.bound_start) == 78 && segment.byte_at_global<P, N>(pages, stride, total, param.bound_start + 1) == 97 && segment.byte_at_global<P, N>(pages, stride, total, param.bound_start + 2) == 116 { return 0; }
    }
    if param.bound_end - param.bound_start == 4 {
        if segment.byte_at_global<P, N>(pages, stride, total, param.bound_start) == 84 && segment.byte_at_global<P, N>(pages, stride, total, param.bound_start + 1) == 121 && segment.byte_at_global<P, N>(pages, stride, total, param.bound_start + 2) == 112 && segment.byte_at_global<P, N>(pages, stride, total, param.bound_start + 3) == 101 { return 1; }
    }
    return 2;
}
record BoundBuild { rest: GenericParamList, acc: GenericBoundList }
fn build_generic_bounds<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: GenericParamList) -> (result: GenericBoundList) {
    iterate i up_to 1024 carrying d: BoundBuild = BoundBuild { rest: list, acc: GenericBoundList.KNil } {
        next d = build_generic_bounds_step<P, N>(pages, stride, total, d);
    }
    return reverse_bounds<P, N>(pages, stride, total, d.acc);
}
fn build_generic_bounds_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BoundBuild) -> (result: BoundBuild) {
    return match st.rest {
        GNil => st,
        GCons { head: h, tail: t } => BoundBuild { rest: t, acc: GenericBoundList.KCons { head: generic_bound_kind<P, N>(pages, stride, total, h), tail: st.acc } }
    };
}
record BoundCount { rest: GenericBoundList, n: u64 }
fn count_bounds(list: GenericBoundList) -> (result: u64) {
    iterate i up_to 1024 carrying d: BoundCount = BoundCount { rest: list, n: 0 } {
        next d = count_bounds_step(d);
    }
    return d.n;
}
fn count_bounds_step(st: BoundCount) -> (result: BoundCount) {
    return match st.rest {
        KNil => st,
        KCons { head: h, tail: t } => BoundCount { rest: t, n: st.n + 1 }
    };
}
record TargCount { rest: TypeArgList, n: u64 }
fn count_targs(list: TypeArgList) -> (result: u64) {
    iterate i up_to 1024 carrying d: TargCount = TargCount { rest: list, n: 0 } {
        next d = count_targs_step(d);
    }
    return d.n;
}
fn count_targs_step(st: TargCount) -> (result: TargCount) {
    return match st.rest {
        TNil => st,
        TCons { head: h, tail: t } => TargCount { rest: t, n: st.n + 1 }
    };
}
// Look up a type-argument name in the caller's generic parameters.
record GenericLookup { found: bool, kind: u64 }
record GenericScan { rest: GenericParamList, start: u64, end: u64, found: bool, kind: u64 }
fn generic_param_lookup<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: GenericParamList, start: u64, end: u64) -> (result: GenericLookup) {
    iterate i up_to 1024 carrying d: GenericScan = GenericScan { rest: list, start: start, end: end, found: false, kind: 0 } {
        next d = generic_param_lookup_step<P, N>(pages, stride, total, d);
    }
    return GenericLookup { found: d.found, kind: d.kind };
}
fn generic_param_lookup_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: GenericScan) -> (result: GenericScan) {
    if st.found { return GenericScan { rest: GenericParamList.GNil, start: st.start, end: st.end, found: true, kind: st.kind }; }
    return match st.rest {
        GNil => st,
        GCons { head: h, tail: t } => generic_param_lookup_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn generic_param_lookup_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: GenericScan, h: GenericParam, t: GenericParamList) -> (result: GenericScan) {
    if spans_equal<P, N>(pages, stride, total, h.name_start, h.name_end, st.start, st.end) {
        return GenericScan { rest: GenericParamList.GNil, start: st.start, end: st.end, found: true, kind: generic_bound_kind<P, N>(pages, stride, total, h) };
    }
    return GenericScan { rest: t, start: st.start, end: st.end, found: false, kind: 0 };
}

// Decimal literal accumulation with a pre-checked bound so checked
// arithmetic never traps: values at or beyond 2^64 set overflow instead.
record IntVal { value: u64, overflow: bool }
record IntAcc { value: u64, overflow: bool }
fn int_value<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: IntVal) {
    iterate i up_to 1024 carrying d: IntAcc = IntAcc { value: 0, overflow: false } {
        next d = int_step(start, end, d, i, source.byte_at_global<P, N>(pages, stride, total, i) as u64);
    }
    return IntVal { value: d.value, overflow: d.overflow };
}
fn int_step(start: u64, end: u64, st: IntAcc, pos: u64, byte: u64) -> (result: IntAcc) {
    if pos < start || pos >= end { return st; }
    let digit: u64 = byte - 48;
    if st.value > 1844674407370955161 { return IntAcc { value: st.value, overflow: true }; }
    if st.value == 1844674407370955161 && digit > 5 { return IntAcc { value: st.value, overflow: true }; }
    return IntAcc { value: st.value * 10 + digit, overflow: st.overflow };
}

// Header fact twin of parser.header over absolute offsets. Identical state
// machine and error-spans-as-codes policy; codes match parser.Header.
fn header<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: parser.Header) {

    let seed: parser.Header = parser.Header { code: 0, start: 0, end: 0, version_start: 0, version_end: 0, module_start: 0, module_end: 0, next_offset: 0, state: 0 };
    if segment.ascii_global<P, N>(pages, stride, total) {
        iterate i up_to 1024 carrying d: parser.Header = seed {
            next d = header_step<P, N>(pages, stride, total, d);
        }
        return header_finish<P, N>(pages, stride, total, d);
    }
    return parser.Header { ..seed, code: 8, end: total };
}
fn header_finish<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: parser.Header) -> (result: parser.Header) {
    if st.code != 0 || st.state == 8 { return st; }
    return header_step<P, N>(pages, stride, total, st);
}
fn header_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: parser.Header) -> (result: parser.Header) {
    if st.code != 0 || st.state == 8 { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.next_offset);
    if token.diagnostic != 0 { return parser.Header { ..st, code: 1, start: token.start, end: token.end }; }
    if st.state == 0 {
        if token.kind == 10 { return parser.Header { ..st, state: 1, next_offset: token.end }; }
        return parser.Header { ..st, code: 2, start: token.start, end: token.end };
    }
    if st.state == 1 {
        if token.kind == 6 { return parser.Header { ..st, state: 2, next_offset: token.end, version_start: token.start, version_end: token.end }; }
        return parser.Header { ..st, code: 3, start: token.start, end: token.end };
    }
    if st.state == 2 {
        if token.kind == 63 { return parser.Header { ..st, state: 3, next_offset: token.end }; }
        return parser.Header { ..st, code: 4, start: token.start, end: token.end };
    }
    if st.state == 3 {
        if token.kind == 11 { return parser.Header { ..st, state: 4, next_offset: token.end }; }
        return parser.Header { ..st, code: 5, start: token.start, end: token.end };
    }
    if st.state == 4 || st.state == 6 {
        if token.kind == 4 || token.kind == 10 { return parser.Header { ..st, state: 5, next_offset: token.end, module_start: select(st.state == 4, token.start, st.module_start), module_end: token.end }; }
        return parser.Header { ..st, code: 6, start: token.start, end: token.end };
    }
    if token.kind == 61 { return parser.Header { ..st, state: 6, next_offset: token.end }; }
    if token.kind == 63 { return parser.Header { ..st, state: 8, next_offset: token.end }; }
    return parser.Header { ..st, code: 7, start: token.start, end: token.end };
}
fn profile_at_least_013<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: bool) {
    if end <= start || end > total { return false; }
    let major_first: u64 = segment.byte_at_global<P, N>(pages, stride, total, start) as u64;
    if major_first > 48 { return true; }
    if major_first != 48 || end - start < 3 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, start + 1) as u64 != 46 { return false; }
    let minor: IntVal = int_value<P, N>(pages, stride, total, start + 2, end);
    return !(minor.overflow) && minor.value >= 13;
}

// A term-level name: identifier (4) or the capability keyword (25) used as
// an identifier. Mirrors Stage-0 value_name positions.
fn is_value_name(kind: u64) -> (result: bool) {
    return match kind {
        4 => true,
        25 => true,
        _ => false
    };
}

// Expect the significant token at cursor to have the wanted kind. Returns
// the token end on success; on failure ok is false and the span is the
// offending (or EOF) token, mirroring Stage-0 expect<N>() spans.
record Expect { cursor: u64, ok: bool, err_start: u64, err_end: u64, tok_start: u64, tok_end: u64 }
fn expect<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, want: u64) -> (result: Expect) {
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if token.diagnostic != 0 { return Expect { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, tok_start: token.start, tok_end: token.end }; }
    if token.kind == want { return Expect { cursor: token.end, ok: true, err_start: 0, err_end: 0, tok_start: token.start, tok_end: token.end }; }
    return Expect { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, tok_start: token.start, tok_end: token.end };
}

// Parse one name token. mode 0 requires an identifier; mode 1 also accepts
// the capability keyword in value positions; mode 2 accepts the contextual
// `next` field spelling after the caller has checked Profile 0.13+.
record NameParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, start: u64, end: u64 }
fn parse_name<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, mode: u64) -> (result: NameParse) {
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if token.diagnostic != 0 { return NameParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, start: token.start, end: token.end }; }
    if token.kind == 4 || (mode == 1 && token.kind == 25) || (mode == 2 && token.kind == 34) {
        return NameParse { cursor: token.end, ok: true, err_start: 0, err_end: 0, start: token.start, end: token.end };
    }
    return NameParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, start: token.start, end: token.end };
}

// Type spelling. Sequences nest via the same function for the element type;
// the returned span covers the whole spelling for later text comparison.
fn parse_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: TypeParse) {
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if token.diagnostic != 0 { return TypeParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: TypeRef { kind: 0, start: cursor, end: cursor }, done: true }; }
    if token.kind == 69 {
        return parse_seq_type<P, N>(pages, stride, total, token.start, token.end);
    }
    if token.kind == 4 {
        return parse_flat_type<P, N>(pages, stride, total, token.start, token.end);
    }
    return TypeParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: TypeRef { kind: 0, start: cursor, end: cursor }, done: true };
}

fn scalar_kind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: u64) {
    if end - start == 3 {
        if segment.byte_at_global<P, N>(pages, stride, total, start) == 117 && segment.byte_at_global<P, N>(pages, stride, total, start + 1) == 54 && segment.byte_at_global<P, N>(pages, stride, total, start + 2) == 52 { return 1; }
    }
    if end - start == 3 {
        if segment.byte_at_global<P, N>(pages, stride, total, start) == 105 && segment.byte_at_global<P, N>(pages, stride, total, start + 1) == 54 && segment.byte_at_global<P, N>(pages, stride, total, start + 2) == 52 { return 2; }
    }
    if end - start == 4 {
        if segment.byte_at_global<P, N>(pages, stride, total, start) == 98 && segment.byte_at_global<P, N>(pages, stride, total, start + 1) == 111 && segment.byte_at_global<P, N>(pages, stride, total, start + 2) == 111 && segment.byte_at_global<P, N>(pages, stride, total, start + 3) == 108 { return 3; }
    }
    if end - start == 4 {
        if segment.byte_at_global<P, N>(pages, stride, total, start) == 98 && segment.byte_at_global<P, N>(pages, stride, total, start + 1) == 121 && segment.byte_at_global<P, N>(pages, stride, total, start + 2) == 116 && segment.byte_at_global<P, N>(pages, stride, total, start + 3) == 101 { return 4; }
    }
    return 5;
}

// Flat (non-sequence) type: identifier with optional qualification. Sequence
// elements nest one further level through parse_seq_nested; only the third
// level stays deferred (explicit local error at the inner `[`), because
// mutual parser recursion is unavailable. See parse_seq_type.
fn parse_flat_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, cursor: u64) -> (result: TypeParse) {
    // CP-0003: conditional chunk chain (16 + 1008 = 1024, unchanged
    // fuel). Qualified paths are short; the first chunk almost always
    // finishes, skipping ~1000 re-scans of the terminating token.
    iterate i up_to 16 carrying d0: TypeParse = TypeParse { cursor: cursor, ok: true, err_start: 0, err_end: 0, node: TypeRef { kind: 0, start: start, end: cursor }, done: false } {
        next d0 = qualified_step<P, N>(pages, stride, total, d0);
    }
    if d0.done || !(d0.ok) { return finish_named_type<P, N>(pages, stride, total, start, d0); }
    iterate i up_to 1008 carrying d: TypeParse = d0 {
        next d = qualified_step<P, N>(pages, stride, total, d);
    }
    return finish_named_type<P, N>(pages, stride, total, start, d);
}
fn qualified_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TypeParse) -> (result: TypeParse) {
    if !(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if token.diagnostic != 0 || token.kind != 61 { return TypeParse { ..st, done: true }; }
    let name: NameParse = parse_name<P, N>(pages, stride, total, token.end, 0);
    if !(name.ok) { return TypeParse { cursor: st.cursor, ok: false, err_start: name.err_start, err_end: name.err_end, node: st.node, done: true }; }
    return TypeParse { cursor: name.cursor, ok: true, err_start: 0, err_end: 0, node: TypeRef { kind: 6, start: st.node.start, end: name.end }, done: false };
}
fn finish_named_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, st: TypeParse) -> (result: TypeParse) {
    if !(st.ok) {
        return TypeParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, node: TypeRef { kind: 0, start: start, end: start }, done: true };
    }
    if st.node.kind == 6 {
        return TypeParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, node: TypeRef { kind: 6, start: start, end: st.node.end }, done: true };
    }
    let kind: u64 = scalar_kind<P, N>(pages, stride, total, start, st.node.end);
    return TypeParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, node: TypeRef { kind: kind, start: start, end: st.node.end }, done: true };
}

// Exact `[T; N]` and viewed `[T; up_to N]` spellings. Bounds may be integer
// literals or Nat identifiers in profile 0.10; only the span is retained
// because index/select expressions are deferred.
fn parse_seq_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, bracket: u64, cursor: u64) -> (result: TypeParse) {
    let bad: TypeRef = TypeRef { kind: 0, start: cursor, end: cursor };
    let elem: TypeParse = parse_seq_elem<P, N>(pages, stride, total, cursor);
    if !(elem.ok) { return TypeParse { cursor: cursor, ok: false, err_start: elem.err_start, err_end: elem.err_end, node: bad, done: true }; }
    let semi: Expect = expect<P, N>(pages, stride, total, elem.cursor, 63);
    if !(semi.ok) { return TypeParse { cursor: cursor, ok: false, err_start: semi.err_start, err_end: semi.err_end, node: bad, done: true }; }
    let bound: NameParse = seq_bound<P, N>(pages, stride, total, semi.cursor);
    if !(bound.ok) { return TypeParse { cursor: cursor, ok: false, err_start: bound.err_start, err_end: bound.err_end, node: bad, done: true }; }
    let close: Expect = expect<P, N>(pages, stride, total, bound.cursor, 70);
    if !(close.ok) { return TypeParse { cursor: cursor, ok: false, err_start: close.err_start, err_end: close.err_end, node: bad, done: true }; }
    let viewed: bool = is_up_to_bound<P, N>(pages, stride, total, bound.start, bound.end);
    return TypeParse { cursor: close.cursor, ok: true, err_start: 0, err_end: 0, node: TypeRef { kind: select(viewed, 8, 7), start: bracket, end: close.cursor }, done: true };
}
// A viewed bound starts with the `up_to` keyword plus a space. A bare Nat
// identifier can never equal the keyword (it lexes as kind 32), and a longer
// identifier starting with those bytes has a non-space sixth byte.
fn is_up_to_bound<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: bool) {
    if end - start < 6 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, start) != 117 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, start + 1) != 112 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, start + 2) != 95 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, start + 3) != 116 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, start + 4) != 111 { return false; }
    if !(lexer.space(segment.byte_at_global<P, N>(pages, stride, total, start + 5))) { return false; }
    return true;
}

// A sequence bound is `up_to` plus a literal/identifier, or a bare literal
// or Nat identifier. Returns the bound span; viewed-ness is re-derived by
// the caller from the leading byte ('u' == 117).
fn seq_bound<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: NameParse) {
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if token.diagnostic != 0 { return NameParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, start: token.start, end: token.end }; }
    if token.kind == 32 {
        let cap: lexer.Token = segment.significant_global<P, N>(pages, stride, total, token.end);
        if cap.diagnostic != 0 { return NameParse { cursor: cursor, ok: false, err_start: cap.start, err_end: cap.end, start: cap.start, end: cap.end }; }
        if cap.kind == 5 || cap.kind == 4 {
            return NameParse { cursor: cap.end, ok: true, err_start: 0, err_end: 0, start: token.start, end: cap.end };
        }
        return NameParse { cursor: cursor, ok: false, err_start: cap.start, err_end: cap.end, start: cap.start, end: cap.end };
    }
    if token.kind == 5 || token.kind == 4 {
        return NameParse { cursor: token.end, ok: true, err_start: 0, err_end: 0, start: token.start, end: token.end };
    }
    return NameParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, start: token.start, end: token.end };
}

// Shared name:type list for parameters, results, record fields, and payload
// fields. closer is the terminating kind (66 ')' or 68 '}'); name_mode 0
// requires identifiers, 1 also accepts `capability` in value positions, and
// 2 also accepts `next` after the caller's Profile 0.13+ check.
fn parse_fields<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, closer: u64, name_mode: u64, profile_013: bool) -> (result: FieldsParse) {
    // CP-0003: conditional chunk chain (16 + 1008 = 1024, unchanged
    // fuel). Field lists are short; the first chunk almost always
    // finishes, skipping ~1000 no-op tails per parameter/result list.
    iterate i up_to 16 carrying d0: FieldsParse = FieldsParse { cursor: cursor, ok: true, err_start: 0, err_end: 0, list: FieldList.FNil, done: false } {
        next d0 = fields_step<P, N>(pages, stride, total, d0, closer, name_mode, profile_013);
    }
    if d0.done || !(d0.ok) { return finish_fields<P, N>(pages, stride, total, d0); }
    iterate i up_to 1008 carrying d: FieldsParse = d0 {
        next d = fields_step<P, N>(pages, stride, total, d, closer, name_mode, profile_013);
    }
    return finish_fields<P, N>(pages, stride, total, d);
}
fn fields_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldsParse, closer: u64, name_mode: u64, profile_013: bool) -> (result: FieldsParse) {
    if !(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    let next_field: bool = name_mode == 2 && token.kind == 34 && profile_013;
    if token.diagnostic != 0 || token.kind == closer || (!(is_value_name(token.kind)) && token.kind != 4 && !(next_field)) { return FieldsParse { ..st, done: true }; }
    if token.kind != 4 && !(name_mode == 1 && token.kind == 25) && !(next_field) { return FieldsParse { ..st, done: true }; }
    let name: NameParse = parse_name<P, N>(pages, stride, total, st.cursor, name_mode);
    if !(name.ok) { return FieldsParse { cursor: st.cursor, ok: false, err_start: name.err_start, err_end: name.err_end, list: st.list, done: true }; }
    let colon: Expect = expect<P, N>(pages, stride, total, name.cursor, 62);
    if !(colon.ok) { return FieldsParse { cursor: st.cursor, ok: false, err_start: colon.err_start, err_end: colon.err_end, list: st.list, done: true }; }
    let ftype: TypeParse = parse_type<P, N>(pages, stride, total, colon.cursor);
    if !(ftype.ok) { return FieldsParse { cursor: st.cursor, ok: false, err_start: ftype.err_start, err_end: ftype.err_end, list: st.list, done: true }; }
    let field: Field = Field { name_start: name.start, name_end: name.end, type_start: ftype.node.start, type_end: ftype.node.end, type_kind: ftype.node.kind };
    let comma: lexer.Token = segment.significant_global<P, N>(pages, stride, total, ftype.cursor);
    if comma.diagnostic == 0 && comma.kind == 64 {
        return FieldsParse { cursor: comma.end, ok: true, err_start: 0, err_end: 0, list: FieldList.FCons { head: field, tail: st.list }, done: false };
    }
    return FieldsParse { cursor: ftype.cursor, ok: true, err_start: 0, err_end: 0, list: FieldList.FCons { head: field, tail: st.list }, done: false };
}
// Element spellings nest at most two levels: a flat type, or one nested
// sequence with a flat element. A third level fails explicitly at the
// inner `[`. The nested parser is a separate non-recursive function, so
// the type parser stays acyclic. Two levels cover every real compiler
// module (`[[byte; up_to N]; up_to P]`); deeper nesting stays deferred.
fn parse_seq_elem<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: TypeParse) {
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if token.diagnostic == 0 && token.kind == 69 {
        return parse_seq_nested<P, N>(pages, stride, total, token.start, token.end);
    }
    if token.diagnostic == 0 && token.kind == 4 {
        return parse_flat_type<P, N>(pages, stride, total, token.start, token.end);
    }
    if token.diagnostic != 0 {
        return TypeParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: TypeRef { kind: 0, start: cursor, end: cursor }, done: true };
    }
    return TypeParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: TypeRef { kind: 0, start: cursor, end: cursor }, done: true };
}
fn finish_fields<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldsParse) -> (result: FieldsParse) {
    return FieldsParse { cursor: st.cursor, ok: st.ok, err_start: st.err_start, err_end: st.err_end, list: reverse_fields<P, N>(pages, stride, total, st.list), done: st.done };
}
// One nested sequence element: `[` flat `;` bound `]`. The element must be
// flat; a further `[` is the deferred third level and fails explicitly.
fn parse_seq_nested<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, bracket: u64, cursor: u64) -> (result: TypeParse) {
    let bad: TypeRef = TypeRef { kind: 0, start: cursor, end: cursor };
    let first: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if first.diagnostic == 0 && first.kind == 69 {
        return TypeParse { cursor: cursor, ok: false, err_start: first.start, err_end: first.end, node: bad, done: true };
    }
    if first.diagnostic != 0 || first.kind != 4 {
        return TypeParse { cursor: cursor, ok: false, err_start: first.start, err_end: first.end, node: bad, done: true };
    }
    let elem: TypeParse = parse_flat_type<P, N>(pages, stride, total, first.start, first.end);
    if !(elem.ok) { return TypeParse { cursor: cursor, ok: false, err_start: elem.err_start, err_end: elem.err_end, node: bad, done: true }; }
    let semi: Expect = expect<P, N>(pages, stride, total, elem.cursor, 63);
    if !(semi.ok) { return TypeParse { cursor: cursor, ok: false, err_start: semi.err_start, err_end: semi.err_end, node: bad, done: true }; }
    let bound: NameParse = seq_bound<P, N>(pages, stride, total, semi.cursor);
    if !(bound.ok) { return TypeParse { cursor: cursor, ok: false, err_start: bound.err_start, err_end: bound.err_end, node: bad, done: true }; }
    let close: Expect = expect<P, N>(pages, stride, total, bound.cursor, 70);
    if !(close.ok) { return TypeParse { cursor: cursor, ok: false, err_start: close.err_start, err_end: close.err_end, node: bad, done: true }; }
    let viewed: bool = is_up_to_bound<P, N>(pages, stride, total, bound.start, bound.end);
    return TypeParse { cursor: close.cursor, ok: true, err_start: 0, err_end: 0, node: TypeRef { kind: select(viewed, 8, 7), start: bracket, end: close.cursor }, done: true };
}
// Reversal by fuel loop (parser recursion is unavailable): each step pops
// one cell. The source-length traversal bound is sufficient for this parser
// worklist because each transition consumes a source node or terminates.
record FieldRev { rest: FieldList, acc: FieldList }
fn reverse_fields<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: FieldList) -> (result: FieldList) {
    iterate i up_to 1024 carrying d: FieldRev = FieldRev { rest: list, acc: FieldList.FNil } {
        if field_list_empty(d.rest) { return d.acc; }
        next d = reverse_fields_step(d);
    }
    return d.acc;
}
fn reverse_fields_step(st: FieldRev) -> (result: FieldRev) {
    return match st.rest { FNil => st, FCons { head: h, tail: t } => FieldRev { rest: t, acc: FieldList.FCons { head: h, tail: st.acc } } };
}

// `use a.b.c [as alias];`. Segments accept identifiers and the `mncs`
// keyword so standard paths keep parsing; alias requires an identifier.
fn parse_use<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: UseDecl) {
    let bad: UseDecl = UseDecl { ok: false, err_start: cursor, err_end: cursor, module_start: cursor, module_end: cursor, alias_start: 0, alias_end: 0, has_alias: false, cursor: cursor };
    let path: NameParse = parse_module_path<P, N>(pages, stride, total, cursor);
    if !(path.ok) { return UseDecl { ..bad, err_start: path.err_start, err_end: path.err_end }; }
    let alias: NameParse = parse_use_alias<P, N>(pages, stride, total, path.cursor);
    if !(alias.ok) { return UseDecl { ..bad, module_start: path.start, module_end: path.end, err_start: alias.err_start, err_end: alias.err_end }; }
    let semi: Expect = expect<P, N>(pages, stride, total, alias.cursor, 63);
    if !(semi.ok) { return UseDecl { ..bad, module_start: path.start, module_end: path.end, err_start: semi.err_start, err_end: semi.err_end }; }
    return UseDecl { ok: true, err_start: 0, err_end: 0, module_start: path.start, module_end: path.end, alias_start: alias.start, alias_end: alias.end, has_alias: alias.start != alias.end, cursor: semi.cursor };
}
fn parse_module_path<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: NameParse) {
    let first: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if first.diagnostic != 0 || (first.kind != 4 && first.kind != 10) {
        return NameParse { cursor: cursor, ok: false, err_start: first.start, err_end: first.end, start: cursor, end: cursor };
    }
    iterate i up_to 1024 carrying d: NameParse = NameParse { cursor: first.end, ok: true, err_start: 0, err_end: 0, start: first.start, end: first.end } {
        next d = path_step<P, N>(pages, stride, total, d);
    }
    return d;
}
fn path_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NameParse) -> (result: NameParse) {
    if !(st.ok) { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if token.diagnostic != 0 || token.kind != 61 { return st; }
    let seg: lexer.Token = segment.significant_global<P, N>(pages, stride, total, token.end);
    if seg.diagnostic != 0 || (seg.kind != 4 && seg.kind != 10) {
        return NameParse { cursor: st.cursor, ok: false, err_start: seg.start, err_end: seg.end, start: st.start, end: st.end };
    }
    return NameParse { cursor: seg.end, ok: true, err_start: 0, err_end: 0, start: st.start, end: seg.end };
}
fn parse_use_alias<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: NameParse) {
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if token.diagnostic != 0 || token.kind != 36 {
        return NameParse { cursor: cursor, ok: true, err_start: 0, err_end: 0, start: cursor, end: cursor };
    }
    return parse_name<P, N>(pages, stride, total, token.end, 0);
}

// `record Name { fields }`. At least one field is required.
fn parse_record<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, start: u64, profile_013: bool) -> (result: RecordDecl) {
    let bad: RecordDecl = RecordDecl { ok: false, err_start: cursor, err_end: cursor, name_start: cursor, name_end: cursor, fields: FieldList.FNil, decl_start: start, decl_end: cursor, cursor: cursor };
    let name: NameParse = parse_name<P, N>(pages, stride, total, cursor, 0);
    if !(name.ok) { return RecordDecl { ..bad, err_start: name.err_start, err_end: name.err_end }; }
    let open: Expect = expect<P, N>(pages, stride, total, name.cursor, 67);
    if !(open.ok) { return RecordDecl { ..bad, name_start: name.start, name_end: name.end, err_start: open.err_start, err_end: open.err_end }; }
    let fields: FieldsParse = parse_fields<P, N>(pages, stride, total, open.cursor, 68, 2, profile_013);
    if !(fields.ok) { return RecordDecl { ..bad, name_start: name.start, name_end: name.end, err_start: fields.err_start, err_end: fields.err_end }; }
    // An empty body reports at the token AFTER the closing brace (or the
    // missing-brace span when `}` is absent), mirroring Stage-0 MNP128.
    if fields.cursor == open.cursor {
        let empty_close: Expect = expect<P, N>(pages, stride, total, open.cursor, 68);
        if !(empty_close.ok) { return RecordDecl { ..bad, name_start: name.start, name_end: name.end, err_start: empty_close.err_start, err_end: empty_close.err_end }; }
        let at: lexer.Token = segment.significant_global<P, N>(pages, stride, total, empty_close.cursor);
        return RecordDecl { ..bad, name_start: name.start, name_end: name.end, err_start: at.start, err_end: at.end };
    }
    let close: Expect = expect<P, N>(pages, stride, total, fields.cursor, 68);
    if !(close.ok) { return RecordDecl { ..bad, name_start: name.start, name_end: name.end, err_start: close.err_start, err_end: close.err_end }; }
    return RecordDecl { ok: true, err_start: 0, err_end: 0, name_start: name.start, name_end: name.end, fields: fields.list, decl_start: start, decl_end: close.cursor, cursor: close.cursor };
}

// `enum Name { variants }` with optional `{ field: Type, ... }` payloads.
// At least one variant is required; variant names are strict identifiers.
fn parse_enum<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, start: u64, profile_013: bool) -> (result: EnumDecl) {
    let bad: EnumDecl = EnumDecl { ok: false, err_start: cursor, err_end: cursor, name_start: cursor, name_end: cursor, variants: VariantList.VNil, decl_start: start, decl_end: cursor, cursor: cursor };
    let name: NameParse = parse_name<P, N>(pages, stride, total, cursor, 0);
    if !(name.ok) { return EnumDecl { ..bad, err_start: name.err_start, err_end: name.err_end }; }
    let open: Expect = expect<P, N>(pages, stride, total, name.cursor, 67);
    if !(open.ok) { return EnumDecl { ..bad, name_start: name.start, name_end: name.end, err_start: open.err_start, err_end: open.err_end }; }
    let variants: VariantsParse = parse_variants<P, N>(pages, stride, total, open.cursor, profile_013);
    if !(variants.ok) { return EnumDecl { ..bad, name_start: name.start, name_end: name.end, err_start: variants.err_start, err_end: variants.err_end }; }
    let close: Expect = expect<P, N>(pages, stride, total, variants.cursor, 68);
    if !(close.ok) { return EnumDecl { ..bad, name_start: name.start, name_end: name.end, err_start: close.err_start, err_end: close.err_end }; }
    return EnumDecl { ok: true, err_start: 0, err_end: 0, name_start: name.start, name_end: name.end, variants: variants.list, decl_start: start, decl_end: close.cursor, cursor: close.cursor };
}
record VariantsParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: VariantList }
record VariantsState { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: VariantList, done: bool }
fn parse_variants<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: VariantsParse) {
    iterate i up_to 1024 carrying d: VariantsState = VariantsState { cursor: cursor, ok: true, err_start: 0, err_end: 0, list: VariantList.VNil, done: false } {
        next d = variants_step<P, N>(pages, stride, total, d, profile_013);
    }
    return finish_variants<P, N>(pages, stride, total, d);
}
fn variants_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: VariantsState, profile_013: bool) -> (result: VariantsState) {
    if !(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if token.diagnostic != 0 || token.kind != 4 { return VariantsState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: st.list, done: true }; }
    let name: NameParse = parse_name<P, N>(pages, stride, total, st.cursor, 0);
    if !(name.ok) { return VariantsState { cursor: st.cursor, ok: false, err_start: name.err_start, err_end: name.err_end, list: st.list, done: true }; }
    let payload: FieldsParse = parse_variant_payload<P, N>(pages, stride, total, name.cursor, profile_013);
    if !(payload.ok) { return VariantsState { cursor: st.cursor, ok: false, err_start: payload.err_start, err_end: payload.err_end, list: st.list, done: true }; }
    let variant: Variant = Variant { name_start: name.start, name_end: name.end, fields: payload.list };
    let comma: lexer.Token = segment.significant_global<P, N>(pages, stride, total, payload.cursor);
    if comma.diagnostic == 0 && comma.kind == 64 {
        return VariantsState { cursor: comma.end, ok: true, err_start: 0, err_end: 0, list: VariantList.VCons { head: variant, tail: st.list }, done: false };
    }
    return VariantsState { cursor: payload.cursor, ok: true, err_start: 0, err_end: 0, list: VariantList.VCons { head: variant, tail: st.list }, done: false };
}
fn parse_variant_payload<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: FieldsParse) {
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if token.diagnostic != 0 || token.kind != 67 {
        return FieldsParse { cursor: cursor, ok: true, err_start: 0, err_end: 0, list: FieldList.FNil, done: true };
    }
    let fields: FieldsParse = parse_fields<P, N>(pages, stride, total, token.end, 68, 2, profile_013);
    if !(fields.ok) { return fields; }
    let close: Expect = expect<P, N>(pages, stride, total, fields.cursor, 68);
    if !(close.ok) { return FieldsParse { cursor: cursor, ok: false, err_start: close.err_start, err_end: close.err_end, list: FieldList.FNil, done: true }; }
    return FieldsParse { cursor: close.cursor, ok: true, err_start: 0, err_end: 0, list: fields.list, done: true };
}
fn finish_variants<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: VariantsState) -> (result: VariantsParse) {
    if !(st.ok) { return VariantsParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, list: VariantList.VNil }; }
    return match st.list {
        VNil => finish_variants_empty<P, N>(pages, stride, total, st),
        VCons { head: h, tail: t } => VariantsParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: reverse_variants<P, N>(pages, stride, total, st.list) }
    };
}
fn finish_variants_empty<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: VariantsState) -> (result: VariantsParse) {
    // Empty variant lists report after the closing brace like records
    // (Stage-0 MNP075); a missing brace reports at its own span (MNP074).
    let empty_close: Expect = expect<P, N>(pages, stride, total, st.cursor, 68);
    if !(empty_close.ok) { return VariantsParse { cursor: st.cursor, ok: false, err_start: empty_close.err_start, err_end: empty_close.err_end, list: VariantList.VNil }; }
    let at: lexer.Token = segment.significant_global<P, N>(pages, stride, total, empty_close.cursor);
    return VariantsParse { cursor: st.cursor, ok: false, err_start: at.start, err_end: at.end, list: VariantList.VNil };
}
record VariantRev { rest: VariantList, acc: VariantList }
fn reverse_variants<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: VariantList) -> (result: VariantList) {
    iterate i up_to 1024 carrying d: VariantRev = VariantRev { rest: list, acc: VariantList.VNil } {
        if variant_list_empty(d.rest) { return d.acc; }
        next d = reverse_variants_step(d);
    }
    return d.acc;
}
fn reverse_variants_step(st: VariantRev) -> (result: VariantRev) {
    return match st.rest { VNil => st, VCons { head: h, tail: t } => VariantRev { rest: t, acc: VariantList.VCons { head: h, tail: st.acc } } };
}

// Statements. `return` parses as a statement for branch bodies; the top
// body loop stops at `return` itself so mid-body returns keep failing
// exactly where Stage-0 reports them.
fn parse_stmt<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: StmtParse) {
    let bad: Stmt = Stmt.Fail { mode_start: cursor, mode_end: cursor, start: cursor, end: cursor };
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if token.diagnostic != 0 { return StmtParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad }; }
    if token.kind == 14 { return parse_let<P, N>(pages, stride, total, token.end, profile_013); }
    if token.kind == 15 { return StmtParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad }; }
    if token.kind == 17 { return parse_fail_stmt<P, N>(pages, stride, total, token.end); }
    if token.kind == 13 { return parse_return_stmt<P, N>(pages, stride, total, token.end, profile_013); }
    if token.kind == 31 { return StmtParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad }; }
    if token.kind == 37 { return StmtParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad }; }
    return StmtParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad };
}
fn parse_let<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: StmtParse) {
    let bad: Stmt = Stmt.Fail { mode_start: cursor, mode_end: cursor, start: cursor, end: cursor };
    let name: NameParse = parse_name<P, N>(pages, stride, total, cursor, 1);
    if !(name.ok) { return StmtParse { cursor: cursor, ok: false, err_start: name.err_start, err_end: name.err_end, node: bad }; }
    let colon: Expect = expect<P, N>(pages, stride, total, name.cursor, 62);
    if !(colon.ok) { return StmtParse { cursor: cursor, ok: false, err_start: colon.err_start, err_end: colon.err_end, node: bad }; }
    let ftype: TypeParse = parse_type<P, N>(pages, stride, total, colon.cursor);
    if !(ftype.ok) { return StmtParse { cursor: cursor, ok: false, err_start: ftype.err_start, err_end: ftype.err_end, node: bad }; }
    let eq: Expect = expect<P, N>(pages, stride, total, ftype.cursor, 60);
    if !(eq.ok) { return StmtParse { cursor: cursor, ok: false, err_start: eq.err_start, err_end: eq.err_end, node: bad }; }
    let value: ExprParse = parse_expr<P, N>(pages, stride, total, eq.cursor, profile_013);
    if !(value.ok) { return StmtParse { cursor: cursor, ok: false, err_start: value.err_start, err_end: value.err_end, node: bad }; }
    let semi: Expect = expect<P, N>(pages, stride, total, value.cursor, 63);
    if !(semi.ok) { return StmtParse { cursor: cursor, ok: false, err_start: semi.err_start, err_end: semi.err_end, node: bad }; }
    let node: Stmt = Stmt.Let { name_start: name.start, name_end: name.end, type_start: ftype.node.start, type_end: ftype.node.end, type_kind: ftype.node.kind, value: value.node, start: name.start, end: value.end };
    return StmtParse { cursor: semi.cursor, ok: true, err_start: 0, err_end: 0, node: node };
}
fn parse_fail_stmt<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: StmtParse) {
    let bad: Stmt = Stmt.Fail { mode_start: cursor, mode_end: cursor, start: cursor, end: cursor };
    let mode: NameParse = parse_name<P, N>(pages, stride, total, cursor, 0);
    if !(mode.ok) { return StmtParse { cursor: cursor, ok: false, err_start: mode.err_start, err_end: mode.err_end, node: bad }; }
    let semi: Expect = expect<P, N>(pages, stride, total, mode.cursor, 63);
    if !(semi.ok) { return StmtParse { cursor: cursor, ok: false, err_start: semi.err_start, err_end: semi.err_end, node: bad }; }
    let node: Stmt = Stmt.Fail { mode_start: mode.start, mode_end: mode.end, start: mode.start, end: mode.end };
    return StmtParse { cursor: semi.cursor, ok: true, err_start: 0, err_end: 0, node: node };
}
fn parse_return_stmt<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: StmtParse) {
    let bad: Stmt = Stmt.Fail { mode_start: cursor, mode_end: cursor, start: cursor, end: cursor };
    let value: ExprParse = parse_expr<P, N>(pages, stride, total, cursor, profile_013);
    if !(value.ok) { return StmtParse { cursor: cursor, ok: false, err_start: value.err_start, err_end: value.err_end, node: bad }; }
    let semi: Expect = expect<P, N>(pages, stride, total, value.cursor, 63);
    if !(semi.ok) { return StmtParse { cursor: cursor, ok: false, err_start: semi.err_start, err_end: semi.err_end, node: bad }; }
    let node: Stmt = Stmt.Return { value: value.node, start: value.start, end: value.end };
    return StmtParse { cursor: semi.cursor, ok: true, err_start: 0, err_end: 0, node: node };
}
// Statement blocks with arbitrarily nested `if`/`else` and `iterate`,
// parsed by one iterative machine over an explicit frame stack (statement
// recursion is unavailable). mode 0 is a branch block: `return` parses as
// a statement. mode 1 is a top body block: the machine stops at `return`
// so the body tail owns it, which keeps mid-body returns failing exactly
// where Stage-0 reports them. Lists come out in source order.
record BranchParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: StmtList }
// Block frames: open `if` branches and open `iterate` headers. The two
// interleave freely (`if` inside an iterate body, iterate inside a
// branch), so one stack carries both; each closer dispatches on the top
// frame kind. An Iter frame holds the parsed header while st.list
// accumulates the body; the trailing `next` transition completes it.
enum Frame {
    If { cond: Expr, cond_start: u64, cond_end: u64, then_list: StmtList, parent: StmtList, phase: u64 },
    Iter { name_start: u64, name_end: u64, over_source: Expr, has_over_source: bool, bound_start: u64, bound_end: u64, state_start: u64, state_end: u64, type_start: u64, type_end: u64, type_kind: u64, initial: Expr, parent: StmtList, start: u64 }
}
enum FrameList { YNil, YCons { head: Frame, tail: FrameList } }
record BlockState { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: StmtList, frames: FrameList, done: bool, mode: u64, profile_013: bool }
fn parse_branch<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: BranchParse) {
    return parse_stmts<P, N>(pages, stride, total, cursor, 0, profile_013);
}
fn parse_stmts<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, mode: u64, profile_013: bool) -> (result: BranchParse) {
    // CP-0003: conditional chunk chain (16 + 1008 + 1024 = 2048,
    // unchanged fuel). Bodies under 16 statements skip ~2000 tails.
    iterate i up_to 16 carrying d0: BlockState = BlockState { cursor: cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SNil, frames: FrameList.YNil, done: false, mode: mode, profile_013: profile_013 } {
        next d0 = block_step<P, N>(pages, stride, total, d0);
    }
    if d0.done || !(d0.ok) { return finish_block<P, N>(pages, stride, total, d0); }
    iterate i up_to 1008 carrying d: BlockState = d0 {
        next d = block_step<P, N>(pages, stride, total, d);
    }
    if d.done || !(d.ok) { return finish_block<P, N>(pages, stride, total, d); }
    iterate i up_to 1024 carrying h: BlockState = d {
        next h = block_step<P, N>(pages, stride, total, h);
    }
    return finish_block<P, N>(pages, stride, total, h);
}
fn block_fail(st: BlockState, start: u64, end: u64) -> (result: BlockState) {
    return BlockState { cursor: st.cursor, ok: false, err_start: start, err_end: end, list: st.list, frames: st.frames, done: true, mode: st.mode, profile_013: st.profile_013 };
}
fn block_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState) -> (result: BlockState) {
    if !(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if token.diagnostic != 0 { return block_fail(st, token.start, token.end); }
    if token.kind == 0 { return block_eof<P, N>(pages, stride, total, st, token); }
    if token.kind == 68 { return block_rbrace<P, N>(pages, stride, total, st, token); }
    if token.kind == 15 { return block_if<P, N>(pages, stride, total, st, token); }
    if token.kind == 31 { return block_iter_open<P, N>(pages, stride, total, st, token); }
    if token.kind == 34 { return block_next<P, N>(pages, stride, total, st, token); }
    if st.mode == 1 && token.kind == 13 {
        return match st.frames {
            YNil => BlockState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: st.list, frames: st.frames, done: true, mode: st.mode, profile_013: st.profile_013 },
            YCons { head: fr, tail: fl } => block_plain_stmt<P, N>(pages, stride, total, st, token)
        };
    }
    return block_plain_stmt<P, N>(pages, stride, total, st, token);
}
fn block_eof<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    return match st.frames {
        YNil => BlockState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: st.list, frames: st.frames, done: true, mode: st.mode, profile_013: st.profile_013 },
        YCons { head: fr, tail: fl } => block_fail(st, token.start, token.end)
    };
}
fn block_rbrace<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    return match st.frames {
        YNil => BlockState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: st.list, frames: st.frames, done: true, mode: st.mode, profile_013: st.profile_013 },
        YCons { head: fr, tail: fl } => block_frame_close<P, N>(pages, stride, total, st, token, fr, fl)
    };
}
// A `}` closes an `if` branch; an iterate body must end with an explicit
// `next` transition, so a `}` there fails where Stage-0 reports it.
fn block_frame_close<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token, fr: Frame, fl: FrameList) -> (result: BlockState) {
    return match fr {
        If { cond: c, cond_start: cs, cond_end: ce, then_list: tl, parent: p, phase: ph } => block_if_close<P, N>(pages, stride, total, st, token, c, cs, ce, tl, p, ph, fl),
        Iter { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, parent: p, start: s } => block_fail(st, token.start, token.end)
    };
}
// A `}` inside a then-branch parks the branch and looks for `else`.
fn block_if_close<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token, c: Expr, cs: u64, ce: u64, tl: StmtList, p: StmtList, ph: u64, fl: FrameList) -> (result: BlockState) {
    if ph == 0 {
        let parked: Frame = Frame.If { cond: c, cond_start: cs, cond_end: ce, then_list: st.list, parent: p, phase: 1 };
        return BlockState { cursor: token.end, ok: true, err_start: 0, err_end: 0, list: StmtList.SNil, frames: FrameList.YCons { head: parked, tail: fl }, done: false, mode: st.mode, profile_013: st.profile_013 };
    }
    return block_else_close<P, N>(pages, stride, total, st, token, c, cs, ce, tl, p, fl);
}
fn block_else_close<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token, c: Expr, cs: u64, ce: u64, tl: StmtList, p: StmtList, fl: FrameList) -> (result: BlockState) {
    let node: Stmt = Stmt.If { cond: c, then_b: reverse_stmts<P, N>(pages, stride, total, tl), else_b: reverse_stmts<P, N>(pages, stride, total, st.list), start: cs, end: ce };
    return BlockState { cursor: token.end, ok: true, err_start: 0, err_end: 0, list: StmtList.SCons { head: node, tail: p }, frames: fl, done: false, mode: st.mode, profile_013: st.profile_013 };
}
// After a then-branch: `else {` continues the frame, anything else
// completes the if with an empty else without consuming the token.
fn block_await_else<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token, c: Expr, cs: u64, ce: u64, tl: StmtList, p: StmtList, fl: FrameList) -> (result: BlockState) {
    if token.kind == 16 {
        let open: Expect = expect<P, N>(pages, stride, total, token.end, 67);
        if !(open.ok) { return block_fail(st, open.err_start, open.err_end); }
        let cont: Frame = Frame.If { cond: c, cond_start: cs, cond_end: ce, then_list: tl, parent: p, phase: 2 };
        return BlockState { cursor: open.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SNil, frames: FrameList.YCons { head: cont, tail: fl }, done: false, mode: st.mode, profile_013: st.profile_013 };
    }
    let node: Stmt = Stmt.If { cond: c, then_b: reverse_stmts<P, N>(pages, stride, total, tl), else_b: StmtList.SNil, start: cs, end: ce };
    return BlockState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SCons { head: node, tail: p }, frames: fl, done: false, mode: st.mode, profile_013: st.profile_013 };
}
fn block_if<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    return match st.frames {
        YNil => block_if_open<P, N>(pages, stride, total, st, token),
        YCons { head: fr, tail: fl } => block_if_frame<P, N>(pages, stride, total, st, token, fr, fl)
    };
}
// An `if` while awaiting `else` is not an else-branch: complete the pending
// if first (mirrors Stage-0 rejecting `else if`), then open the new one.
fn block_if_frame<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token, fr: Frame, fl: FrameList) -> (result: BlockState) {
    return match fr {
        If { cond: c, cond_start: cs, cond_end: ce, then_list: tl, parent: p, phase: ph } => block_if_frame_if<P, N>(pages, stride, total, st, token, c, cs, ce, tl, p, ph, fl),
        Iter { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, parent: p, start: s } => block_if_open<P, N>(pages, stride, total, st, token)
    };
}
fn block_if_frame_if<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token, c: Expr, cs: u64, ce: u64, tl: StmtList, p: StmtList, ph: u64, fl: FrameList) -> (result: BlockState) {
    if ph == 1 {
        let node: Stmt = Stmt.If { cond: c, then_b: reverse_stmts<P, N>(pages, stride, total, tl), else_b: StmtList.SNil, start: cs, end: ce };
        let popped: BlockState = BlockState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SCons { head: node, tail: p }, frames: fl, done: false, mode: st.mode, profile_013: st.profile_013 };
        return block_if_open<P, N>(pages, stride, total, popped, token);
    }
    return block_if_open<P, N>(pages, stride, total, st, token);
}
fn block_if_open<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    let cond: ExprParse = parse_expr_noconstruct<P, N>(pages, stride, total, token.end, st.profile_013);
    if !(cond.ok) { return block_fail(st, cond.err_start, cond.err_end); }
    let open: Expect = expect<P, N>(pages, stride, total, cond.cursor, 67);
    if !(open.ok) { return block_fail(st, open.err_start, open.err_end); }
    let frame: Frame = Frame.If { cond: cond.node, cond_start: cond.start, cond_end: cond.end, then_list: StmtList.SNil, parent: st.list, phase: 0 };
    return BlockState { cursor: open.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SNil, frames: FrameList.YCons { head: frame, tail: st.frames }, done: false, mode: st.mode, profile_013: st.profile_013 };
}
// Bounded iteration headers: `iterate i over xs carrying s: T = init {`
// or `iterate i up_to 64 carrying s: T = init {`. The bound is an integer
// literal only; the traversal source and the initial state are full
// expressions. Each expectation fails at the offending token, mirroring
// the Stage-0 header diagnostics in order.
record IterHeader { ok: bool, err_start: u64, err_end: u64, cursor: u64, name_start: u64, name_end: u64, over_source: Expr, has_over_source: bool, bound_start: u64, bound_end: u64, state_start: u64, state_end: u64, type_start: u64, type_end: u64, type_kind: u64, initial: Expr }
fn block_iter_open<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    return match st.frames {
        YNil => block_iter_header<P, N>(pages, stride, total, st, token),
        YCons { head: fr, tail: fl } => block_iter_frame<P, N>(pages, stride, total, st, token, fr, fl)
    };
}
// An `iterate` while awaiting `else` is not an else-branch: complete the
// pending if first (mirrors Stage-0 sequencing `if` then `iterate`), then
// re-step the unconsumed `iterate` against the popped frames.
fn block_iter_frame<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token, fr: Frame, fl: FrameList) -> (result: BlockState) {
    return match fr {
        If { cond: c, cond_start: cs, cond_end: ce, then_list: tl, parent: p, phase: ph } => block_iter_frame_if<P, N>(pages, stride, total, st, token, c, cs, ce, tl, p, ph, fl),
        Iter { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, parent: p, start: s } => block_iter_header<P, N>(pages, stride, total, st, token)
    };
}
fn block_iter_frame_if<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token, c: Expr, cs: u64, ce: u64, tl: StmtList, p: StmtList, ph: u64, fl: FrameList) -> (result: BlockState) {
    if ph == 1 { return block_await_else<P, N>(pages, stride, total, st, token, c, cs, ce, tl, p, fl); }
    return block_iter_header<P, N>(pages, stride, total, st, token);
}
fn block_iter_header<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    let header: IterHeader = parse_iter_header<P, N>(pages, stride, total, token.end, st.profile_013);
    if !(header.ok) { return block_fail(st, header.err_start, header.err_end); }
    let frame: Frame = Frame.Iter { name_start: header.name_start, name_end: header.name_end, over_source: header.over_source, has_over_source: header.has_over_source, bound_start: header.bound_start, bound_end: header.bound_end, state_start: header.state_start, state_end: header.state_end, type_start: header.type_start, type_end: header.type_end, type_kind: header.type_kind, initial: header.initial, parent: st.list, start: token.start };
    return BlockState { cursor: header.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SNil, frames: FrameList.YCons { head: frame, tail: st.frames }, done: false, mode: st.mode, profile_013: st.profile_013 };
}
fn iter_header_fail(cursor: u64, start: u64, end: u64) -> (result: IterHeader) {
    return IterHeader { ok: false, err_start: start, err_end: end, cursor: cursor, name_start: start, name_end: end, over_source: Expr.Name { start: 0, end: 0 }, has_over_source: false, bound_start: 0, bound_end: 0, state_start: start, state_end: end, type_start: start, type_end: end, type_kind: 9, initial: Expr.Name { start: 0, end: 0 } };
}
fn parse_iter_header<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: IterHeader) {
    let name: NameParse = parse_name<P, N>(pages, stride, total, cursor, 1);
    if !(name.ok) { return iter_header_fail(cursor, name.err_start, name.err_end); }
    let tok: lexer.Token = segment.significant_global<P, N>(pages, stride, total, name.cursor);
    if tok.diagnostic != 0 { return iter_header_fail(cursor, tok.start, tok.end); }
    if tok.kind == 35 { return parse_iter_over<P, N>(pages, stride, total, cursor, tok.end, profile_013, name.start, name.end); }
    if tok.kind == 32 { return parse_iter_bound<P, N>(pages, stride, total, cursor, tok.end, profile_013, name.start, name.end); }
    return iter_header_fail(cursor, tok.start, tok.end);
}
fn parse_iter_over<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, after_over: u64, profile_013: bool, ns: u64, ne: u64) -> (result: IterHeader) {
    let source: ExprParse = parse_expr<P, N>(pages, stride, total, after_over, profile_013);
    if !(source.ok) { return iter_header_fail(cursor, source.err_start, source.err_end); }
    return parse_iter_carrying<P, N>(pages, stride, total, cursor, source.cursor, profile_013, ns, ne, source.node, true, 0, 0);
}
fn parse_iter_bound<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, after_upto: u64, profile_013: bool, ns: u64, ne: u64) -> (result: IterHeader) {
    let bound: lexer.Token = segment.significant_global<P, N>(pages, stride, total, after_upto);
    if bound.diagnostic != 0 || bound.kind != 5 { return iter_header_fail(cursor, bound.start, bound.end); }
    let dummy: Expr = Expr.Name { start: 0, end: 0 };
    return parse_iter_carrying<P, N>(pages, stride, total, cursor, bound.end, profile_013, ns, ne, dummy, false, bound.start, bound.end);
}
fn parse_iter_carrying<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, after_bound: u64, profile_013: bool, ns: u64, ne: u64, over_source: Expr, has_over_source: bool, bs: u64, be: u64) -> (result: IterHeader) {
    let carry: Expect = expect<P, N>(pages, stride, total, after_bound, 33);
    if !(carry.ok) { return iter_header_fail(cursor, carry.err_start, carry.err_end); }
    let state: NameParse = parse_name<P, N>(pages, stride, total, carry.cursor, 1);
    if !(state.ok) { return iter_header_fail(cursor, state.err_start, state.err_end); }
    let colon: Expect = expect<P, N>(pages, stride, total, state.cursor, 62);
    if !(colon.ok) { return iter_header_fail(cursor, colon.err_start, colon.err_end); }
    let ftype: TypeParse = parse_type<P, N>(pages, stride, total, colon.cursor);
    if !(ftype.ok) { return iter_header_fail(cursor, ftype.err_start, ftype.err_end); }
    let eq: Expect = expect<P, N>(pages, stride, total, ftype.cursor, 60);
    if !(eq.ok) { return iter_header_fail(cursor, eq.err_start, eq.err_end); }
    let initial: ExprParse = parse_expr<P, N>(pages, stride, total, eq.cursor, profile_013);
    if !(initial.ok) { return iter_header_fail(cursor, initial.err_start, initial.err_end); }
    let open: Expect = expect<P, N>(pages, stride, total, initial.cursor, 67);
    if !(open.ok) { return iter_header_fail(cursor, open.err_start, open.err_end); }
    return IterHeader { ok: true, err_start: 0, err_end: 0, cursor: open.cursor, name_start: ns, name_end: ne, over_source: over_source, has_over_source: has_over_source, bound_start: bs, bound_end: be, state_start: state.start, state_end: state.end, type_start: ftype.node.start, type_end: ftype.node.end, type_kind: ftype.node.kind, initial: initial.node };
}
// The `next` transition completes the innermost open iterate frame; a
// `next` anywhere else fails at the keyword, matching Stage-0.
fn block_next<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    return match st.frames {
        YNil => block_fail(st, token.start, token.end),
        YCons { head: fr, tail: fl } => block_next_frame<P, N>(pages, stride, total, st, token, fr, fl)
    };
}
fn block_next_frame<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token, fr: Frame, fl: FrameList) -> (result: BlockState) {
    return match fr {
        If { cond: c, cond_start: cs, cond_end: ce, then_list: tl, parent: p, phase: ph } => block_next_frame_if<P, N>(pages, stride, total, st, token, c, cs, ce, tl, p, ph, fl),
        Iter { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, parent: p, start: s } => block_next_close<P, N>(pages, stride, total, st, token, ns, ne, o, ho, bs, be, ss, se, ts, te, tk, init, p, s, fl)
    };
}
// A `next` while awaiting `else` completes the pending if first (mirrors
// Stage-0 accepting an `if` directly before the transition), then re-steps
// the unconsumed `next` against the popped frames. Any other open `if`
// still fails at the keyword.
fn block_next_frame_if<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token, c: Expr, cs: u64, ce: u64, tl: StmtList, p: StmtList, ph: u64, fl: FrameList) -> (result: BlockState) {
    if ph == 1 { return block_await_else<P, N>(pages, stride, total, st, token, c, cs, ce, tl, p, fl); }
    return block_fail(st, token.start, token.end);
}
fn block_next_close<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token, ns: u64, ne: u64, o: Expr, ho: bool, bs: u64, be: u64, ss: u64, se: u64, ts: u64, te: u64, tk: u64, init: Expr, p: StmtList, s: u64, fl: FrameList) -> (result: BlockState) {
    let nm: NameParse = parse_name<P, N>(pages, stride, total, token.end, 1);
    if !(nm.ok) { return block_fail(st, nm.err_start, nm.err_end); }
    let eq: Expect = expect<P, N>(pages, stride, total, nm.cursor, 60);
    if !(eq.ok) { return block_fail(st, eq.err_start, eq.err_end); }
    let value: ExprParse = parse_expr<P, N>(pages, stride, total, eq.cursor, st.profile_013);
    if !(value.ok) { return block_fail(st, value.err_start, value.err_end); }
    let semi: Expect = expect<P, N>(pages, stride, total, value.cursor, 63);
    if !(semi.ok) { return block_fail(st, semi.err_start, semi.err_end); }
    let close: Expect = expect<P, N>(pages, stride, total, semi.cursor, 68);
    if !(close.ok) { return block_fail(st, close.err_start, close.err_end); }
    let node: Stmt = Stmt.Iterate { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, body: reverse_stmts<P, N>(pages, stride, total, st.list), next_start: nm.start, next_end: nm.end, next_value: value.node, start: s, end: close.cursor };
    return BlockState { cursor: close.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SCons { head: node, tail: p }, frames: fl, done: false, mode: st.mode, profile_013: st.profile_013 };
}
fn block_plain_stmt<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, token: lexer.Token) -> (result: BlockState) {
    return match st.frames {
        YNil => block_top_stmt<P, N>(pages, stride, total, st),
        YCons { head: fr, tail: fl } => block_frame_stmt<P, N>(pages, stride, total, st, fr, fl)
    };
}
fn block_top_stmt<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState) -> (result: BlockState) {
    let stmt: StmtParse = parse_stmt<P, N>(pages, stride, total, st.cursor, st.profile_013);
    if !(stmt.ok) { return block_fail(st, stmt.err_start, stmt.err_end); }
    return BlockState { cursor: stmt.cursor, ok: true, err_start: 0, err_end: 0, list: StmtList.SCons { head: stmt.node, tail: st.list }, frames: st.frames, done: false, mode: st.mode, profile_013: st.profile_013 };
}
fn block_frame_stmt<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, fr: Frame, fl: FrameList) -> (result: BlockState) {
    return match fr {
        If { cond: c, cond_start: cs, cond_end: ce, then_list: tl, parent: p, phase: ph } => block_frame_stmt_if<P, N>(pages, stride, total, st, c, cs, ce, tl, p, ph, fl),
        Iter { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, parent: p, start: s } => block_top_stmt<P, N>(pages, stride, total, st)
    };
}
fn block_frame_stmt_if<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState, c: Expr, cs: u64, ce: u64, tl: StmtList, p: StmtList, ph: u64, fl: FrameList) -> (result: BlockState) {
    if ph == 1 {
        let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
        return block_await_else<P, N>(pages, stride, total, st, token, c, cs, ce, tl, p, fl);
    }
    return block_top_stmt<P, N>(pages, stride, total, st);
}
fn finish_block<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockState) -> (result: BranchParse) {
    if !(st.ok) { return BranchParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, list: StmtList.SNil }; }
    if !(st.done) { return BranchParse { cursor: st.cursor, ok: false, err_start: st.cursor, err_end: st.cursor, list: StmtList.SNil }; }
    return match st.frames {
        YNil => BranchParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: reverse_stmts<P, N>(pages, stride, total, st.list) },
        YCons { head: fr, tail: fl } => BranchParse { cursor: st.cursor, ok: false, err_start: st.cursor, err_end: st.cursor, list: StmtList.SNil }
    };
}
record StmtRev { rest: StmtList, acc: StmtList }
fn reverse_stmts<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: StmtList) -> (result: StmtList) {
    iterate i up_to 1024 carrying d: StmtRev = StmtRev { rest: list, acc: StmtList.SNil } {
        if stmt_list_empty(d.rest) { return d.acc; }
        next d = reverse_stmts_step(d);
    }
    return d.acc;
}
fn reverse_stmts_step(st: StmtRev) -> (result: StmtRev) {
    return match st.rest { SNil => st, SCons { head: h, tail: t } => StmtRev { rest: t, acc: StmtList.SCons { head: h, tail: st.acc } } };
}

// Function signature clauses: requires/ensures/assumes/property/invariant/
// metamorphic (kind + name), `capability name`, and
// `effect kind authorized_by capability`. Retained as facts; the semantic
// layer does not interpret them in this slice.
record ClausesParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, contracts: ClauseList, effects: EffectList, capabilities: CapList }
record ClausesState { cursor: u64, ok: bool, err_start: u64, err_end: u64, contracts: ClauseList, effects: EffectList, capabilities: CapList, done: bool }
fn parse_clauses<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: ClausesParse) {
    // CP-0003: conditional chunk chain (16 + 1008 = 1024).
    iterate i up_to 16 carrying d0: ClausesState = ClausesState { cursor: cursor, ok: true, err_start: 0, err_end: 0, contracts: ClauseList.CNil, effects: EffectList.XNil, capabilities: CapList.ANil, done: false } {
        next d0 = clauses_step<P, N>(pages, stride, total, d0);
    }
    if d0.done || !(d0.ok) { return finish_clauses<P, N>(pages, stride, total, d0); }
    iterate i up_to 1008 carrying d: ClausesState = d0 {
        next d = clauses_step<P, N>(pages, stride, total, d);
    }
    return finish_clauses<P, N>(pages, stride, total, d);
}
fn clauses_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ClausesState) -> (result: ClausesState) {
    if !(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if token.diagnostic != 0 { return ClausesState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    if token.kind == 25 { return clause_capability<P, N>(pages, stride, total, st, token); }
    if token.kind == 24 { return clause_effect<P, N>(pages, stride, total, st, token); }
    if token.kind == 18 || token.kind == 19 || token.kind == 20 || token.kind == 21 || token.kind == 22 || token.kind == 23 {
        return clause_contract<P, N>(pages, stride, total, st, token);
    }
    return ClausesState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true };
}
fn clause_contract<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ClausesState, token: lexer.Token) -> (result: ClausesState) {
    let name: NameParse = parse_name<P, N>(pages, stride, total, token.end, 0);
    if !(name.ok) { return ClausesState { cursor: st.cursor, ok: false, err_start: name.err_start, err_end: name.err_end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    let clause: Clause = Clause { kind_start: token.start, kind_end: token.end, name_start: name.start, name_end: name.end };
    return ClausesState { cursor: name.cursor, ok: true, err_start: 0, err_end: 0, contracts: ClauseList.CCons { head: clause, tail: st.contracts }, effects: st.effects, capabilities: st.capabilities, done: false };
}
fn clause_capability<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ClausesState, token: lexer.Token) -> (result: ClausesState) {
    let name: NameParse = parse_name<P, N>(pages, stride, total, token.end, 0);
    if !(name.ok) { return ClausesState { cursor: st.cursor, ok: false, err_start: name.err_start, err_end: name.err_end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    let cap: Cap = Cap { start: name.start, end: name.end };
    return ClausesState { cursor: name.cursor, ok: true, err_start: 0, err_end: 0, contracts: st.contracts, effects: st.effects, capabilities: CapList.ACons { head: cap, tail: st.capabilities }, done: false };
}
fn clause_effect<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ClausesState, token: lexer.Token) -> (result: ClausesState) {
    let bad: ClausesState = ClausesState { cursor: st.cursor, ok: false, err_start: token.start, err_end: token.end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true };
    let kind: NameParse = parse_name<P, N>(pages, stride, total, token.end, 0);
    if !(kind.ok) { return ClausesState { cursor: bad.cursor, ok: false, err_start: kind.err_start, err_end: kind.err_end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    let auth: Expect = expect<P, N>(pages, stride, total, kind.cursor, 26);
    if !(auth.ok) { return ClausesState { cursor: bad.cursor, ok: false, err_start: auth.err_start, err_end: auth.err_end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    let cap: NameParse = parse_name<P, N>(pages, stride, total, auth.cursor, 0);
    if !(cap.ok) { return ClausesState { cursor: bad.cursor, ok: false, err_start: cap.err_start, err_end: cap.err_end, contracts: st.contracts, effects: st.effects, capabilities: st.capabilities, done: true }; }
    let eff: Effect = Effect { kind_start: kind.start, kind_end: kind.end, cap_start: cap.start, cap_end: cap.end };
    return ClausesState { cursor: cap.cursor, ok: true, err_start: 0, err_end: 0, contracts: st.contracts, effects: EffectList.XCons { head: eff, tail: st.effects }, capabilities: st.capabilities, done: false };
}
fn finish_clauses<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ClausesState) -> (result: ClausesParse) {
    if !(st.ok) { return ClausesParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, contracts: ClauseList.CNil, effects: EffectList.XNil, capabilities: CapList.ANil }; }
    return ClausesParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, contracts: reverse_clauses<P, N>(pages, stride, total, st.contracts), effects: reverse_effects<P, N>(pages, stride, total, st.effects), capabilities: reverse_caps<P, N>(pages, stride, total, st.capabilities) };
}
record ClauseRev { rest: ClauseList, acc: ClauseList }
fn reverse_clauses<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: ClauseList) -> (result: ClauseList) {
    iterate i up_to 1024 carrying d: ClauseRev = ClauseRev { rest: list, acc: ClauseList.CNil } {
        if clause_list_empty(d.rest) { return d.acc; }
        next d = reverse_clauses_step(d);
    }
    return d.acc;
}
fn reverse_clauses_step(st: ClauseRev) -> (result: ClauseRev) {
    return match st.rest { CNil => st, CCons { head: h, tail: t } => ClauseRev { rest: t, acc: ClauseList.CCons { head: h, tail: st.acc } } };
}
record EffectRev { rest: EffectList, acc: EffectList }
fn reverse_effects<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: EffectList) -> (result: EffectList) {
    iterate i up_to 1024 carrying d: EffectRev = EffectRev { rest: list, acc: EffectList.XNil } {
        if effect_list_empty(d.rest) { return d.acc; }
        next d = reverse_effects_step(d);
    }
    return d.acc;
}
fn reverse_effects_step(st: EffectRev) -> (result: EffectRev) {
    return match st.rest { XNil => st, XCons { head: h, tail: t } => EffectRev { rest: t, acc: EffectList.XCons { head: h, tail: st.acc } } };
}
record CapRev { rest: CapList, acc: CapList }
fn reverse_caps<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: CapList) -> (result: CapList) {
    iterate i up_to 1024 carrying d: CapRev = CapRev { rest: list, acc: CapList.ANil } {
        if cap_list_empty(d.rest) { return d.acc; }
        next d = reverse_caps_step(d);
    }
    return d.acc;
}
fn reverse_caps_step(st: CapRev) -> (result: CapRev) {
    return match st.rest { ANil => st, ACons { head: h, tail: t } => CapRev { rest: t, acc: CapList.ACons { head: h, tail: st.acc } } };
}

// Generics are gated to Profile 0.10 (Stage-0 MNP184/MNP189). The header
// is already validated when any generic site runs, so the gate re-derives
// from the version token at its fixed position instead of threading one
// more profile flag through every expression and declaration signature.
fn generics_profile_ok<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    let tok: lexer.Token = segment.significant_global<P, N>(pages, stride, total, 5);
    if tok.diagnostic != 0 || tok.kind != 6 { return false; }
    let major_first: u64 = segment.byte_at_global<P, N>(pages, stride, total, tok.start) as u64;
    if major_first > 48 { return true; }
    if major_first != 48 || tok.end - tok.start < 3 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, tok.start + 1) as u64 != 46 { return false; }
    let minor: IntVal = int_value<P, N>(pages, stride, total, tok.start + 2, tok.end);
    return !(minor.overflow) && minor.value >= 10;
}

// Generic parameter list `<N: Nat, T>` after a function name (Stage-0
// generic_params). Constraints are `Type`/`Nat` identifiers with an
// optional `->` result; anything else fails where Stage-0 reports MNP187
// (the token after the constraint). Duplicates fail where Stage-0 reports
// MNP186 (the token after the repeated name). The bound span covers the
// whole constraint text.
record GenericsParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: GenericParamList }
record GenericsState { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: GenericParamList, seen: NameList, done: bool }
fn parse_generic_params<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: GenericsParse) {
    let open: Expect = expect<P, N>(pages, stride, total, cursor, 58);
    if !(open.ok) { return GenericsParse { cursor: cursor, ok: false, err_start: open.err_start, err_end: open.err_end, list: GenericParamList.GNil }; }
    iterate i up_to 1024 carrying d: GenericsState = GenericsState { cursor: open.cursor, ok: true, err_start: 0, err_end: 0, list: GenericParamList.GNil, seen: NameList.NNil, done: false } {
        next d = generics_step<P, N>(pages, stride, total, d);
    }
    if !(d.ok) { return GenericsParse { cursor: d.cursor, ok: false, err_start: d.err_start, err_end: d.err_end, list: GenericParamList.GNil }; }
    if !(d.done) { return GenericsParse { cursor: d.cursor, ok: false, err_start: d.cursor, err_end: d.cursor, list: GenericParamList.GNil }; }
    return GenericsParse { cursor: d.cursor, ok: true, err_start: 0, err_end: 0, list: reverse_generics<P, N>(pages, stride, total, d.list) };
}
fn generics_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: GenericsState) -> (result: GenericsState) {
    if !(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if token.diagnostic == 0 && token.kind == 59 { return GenericsState { cursor: token.end, ok: true, err_start: 0, err_end: 0, list: st.list, seen: st.seen, done: true }; }
    let name: NameParse = parse_name<P, N>(pages, stride, total, st.cursor, 0);
    if !(name.ok) { return GenericsState { cursor: st.cursor, ok: false, err_start: name.err_start, err_end: name.err_end, list: st.list, seen: st.seen, done: true }; }
    if name_known<P, N>(pages, stride, total, st.seen, name.start, name.end) {
        let after: lexer.Token = segment.significant_global<P, N>(pages, stride, total, name.cursor);
        return GenericsState { cursor: st.cursor, ok: false, err_start: after.start, err_end: after.end, list: st.list, seen: st.seen, done: true };
    }
    return generics_bound<P, N>(pages, stride, total, st, name);
}
fn generics_bound<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: GenericsState, name: NameParse) -> (result: GenericsState) {
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, name.cursor);
    if token.diagnostic == 0 && token.kind == 62 {
        return generics_constraint<P, N>(pages, stride, total, st, name, token.end);
    }
    return generics_after<P, N>(pages, stride, total, st, name, GenericParam { name_start: name.start, name_end: name.end, bound_start: 0, bound_end: 0, has_bound: false }, name.cursor);
}
fn generics_constraint<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: GenericsState, name: NameParse, cursor: u64) -> (result: GenericsState) {
    let first: NameParse = parse_name<P, N>(pages, stride, total, cursor, 0);
    if !(first.ok) { return GenericsState { cursor: st.cursor, ok: false, err_start: first.err_start, err_end: first.err_end, list: st.list, seen: st.seen, done: true }; }
    let arrow: lexer.Token = segment.significant_global<P, N>(pages, stride, total, first.cursor);
    if arrow.diagnostic == 0 && arrow.kind == 80 {
        let second: NameParse = parse_name<P, N>(pages, stride, total, arrow.end, 0);
        if !(second.ok) { return GenericsState { cursor: st.cursor, ok: false, err_start: second.err_start, err_end: second.err_end, list: st.list, seen: st.seen, done: true }; }
        return generics_after<P, N>(pages, stride, total, st, name, GenericParam { name_start: name.start, name_end: name.end, bound_start: first.start, bound_end: second.end, has_bound: true }, second.cursor);
    }
    if !(constraint_is_type_or_nat<P, N>(pages, stride, total, first.start, first.end)) {
        return GenericsState { cursor: st.cursor, ok: false, err_start: arrow.start, err_end: arrow.end, list: st.list, seen: st.seen, done: true };
    }
    return generics_after<P, N>(pages, stride, total, st, name, GenericParam { name_start: name.start, name_end: name.end, bound_start: first.start, bound_end: first.end, has_bound: true }, first.cursor);
}
fn constraint_is_type_or_nat<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: bool) {
    if end - start == 4 {
        if segment.byte_at_global<P, N>(pages, stride, total, start) == 84 && segment.byte_at_global<P, N>(pages, stride, total, start + 1) == 121 && segment.byte_at_global<P, N>(pages, stride, total, start + 2) == 112 && segment.byte_at_global<P, N>(pages, stride, total, start + 3) == 101 { return true; }
    }
    if end - start == 3 {
        if segment.byte_at_global<P, N>(pages, stride, total, start) == 78 && segment.byte_at_global<P, N>(pages, stride, total, start + 1) == 97 && segment.byte_at_global<P, N>(pages, stride, total, start + 2) == 116 { return true; }
    }
    return false;
}
fn generics_after<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: GenericsState, name: NameParse, param: GenericParam, cursor: u64) -> (result: GenericsState) {
    let seen: NameList = NameList.NCons { head: NameSpan { start: name.start, end: name.end }, tail: st.seen };
    let list: GenericParamList = GenericParamList.GCons { head: param, tail: st.list };
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if token.diagnostic == 0 && token.kind == 64 {
        return GenericsState { cursor: token.end, ok: true, err_start: 0, err_end: 0, list: list, seen: seen, done: false };
    }
    if token.diagnostic == 0 && token.kind == 59 {
        return GenericsState { cursor: token.end, ok: true, err_start: 0, err_end: 0, list: list, seen: seen, done: true };
    }
    return GenericsState { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, list: list, seen: seen, done: true };
}

// Optional generic parameter list between a function name and its parameter
// list. No `<`: empty success without consuming. `<` below Profile 0.10:
// fail at the bracket (Stage-0 MNP184).
fn parse_fn_generics<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, peek: lexer.Token) -> (result: GenericsParse) {
    if peek.diagnostic != 0 || peek.kind != 58 {
        return GenericsParse { cursor: cursor, ok: true, err_start: 0, err_end: 0, list: GenericParamList.GNil };
    }
    if !(generics_profile_ok<P, N>(pages, stride, total)) {
        return GenericsParse { cursor: cursor, ok: false, err_start: peek.start, err_end: peek.end, list: GenericParamList.GNil };
    }
    return parse_generic_params<P, N>(pages, stride, total, cursor);
}

// `fn name(params) -> (results) clauses { body }`, with an optional
// generic parameter list between the name and the parameter list.
fn parse_fn<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, start: u64, profile_013: bool) -> (result: FnDecl) {
    let bad: FnDecl = FnDecl { ok: false, err_start: cursor, err_end: cursor, sig: FnSig { name_start: cursor, name_end: cursor, generics: GenericParamList.GNil, params: FieldList.FNil, results: FieldList.FNil, contracts: ClauseList.CNil, effects: EffectList.XNil, capabilities: CapList.ANil }, body: FnBody { body: StmtList.SNil, ret: Expr.Name { start: cursor, end: cursor }, has_ret: false }, fn_start: start, fn_end: cursor, cursor: cursor };
    let name: NameParse = parse_name<P, N>(pages, stride, total, cursor, 1);
    if !(name.ok) { return FnDecl { ..bad, err_start: name.err_start, err_end: name.err_end }; }
    let peek: lexer.Token = segment.significant_global<P, N>(pages, stride, total, name.cursor);
    let generics: GenericsParse = parse_fn_generics<P, N>(pages, stride, total, name.cursor, peek);
    if !(generics.ok) { return FnDecl { ..bad, err_start: generics.err_start, err_end: generics.err_end }; }
    let open: Expect = expect<P, N>(pages, stride, total, generics.cursor, 65);
    if !(open.ok) { return FnDecl { ..bad, err_start: open.err_start, err_end: open.err_end }; }
    let params: FieldsParse = parse_fields<P, N>(pages, stride, total, open.cursor, 66, 1, profile_013);
    if !(params.ok) { return FnDecl { ..bad, err_start: params.err_start, err_end: params.err_end }; }
    let close: Expect = expect<P, N>(pages, stride, total, params.cursor, 66);
    if !(close.ok) { return FnDecl { ..bad, err_start: close.err_start, err_end: close.err_end }; }
    let arrow: Expect = expect<P, N>(pages, stride, total, close.cursor, 80);
    if !(arrow.ok) { return FnDecl { ..bad, err_start: arrow.err_start, err_end: arrow.err_end }; }
    let open2: Expect = expect<P, N>(pages, stride, total, arrow.cursor, 65);
    if !(open2.ok) { return FnDecl { ..bad, err_start: open2.err_start, err_end: open2.err_end }; }
    let results: FieldsParse = parse_fields<P, N>(pages, stride, total, open2.cursor, 66, 1, profile_013);
    if !(results.ok) { return FnDecl { ..bad, err_start: results.err_start, err_end: results.err_end }; }
    let close2: Expect = expect<P, N>(pages, stride, total, results.cursor, 66);
    if !(close2.ok) { return FnDecl { ..bad, err_start: close2.err_start, err_end: close2.err_end }; }
    let clauses: ClausesParse = parse_clauses<P, N>(pages, stride, total, close2.cursor);
    if !(clauses.ok) { return FnDecl { ..bad, err_start: clauses.err_start, err_end: clauses.err_end }; }
    let open3: Expect = expect<P, N>(pages, stride, total, clauses.cursor, 67);
    if !(open3.ok) { return FnDecl { ..bad, err_start: open3.err_start, err_end: open3.err_end }; }
    let body: BranchParse = parse_stmts<P, N>(pages, stride, total, open3.cursor, 1, profile_013);
    if !(body.ok) { return FnDecl { ..bad, err_start: body.err_start, err_end: body.err_end }; }
    let tail: ReturnParse = parse_return_tail<P, N>(pages, stride, total, body.cursor, profile_013);
    if !(tail.ok) { return FnDecl { ..bad, err_start: tail.err_start, err_end: tail.err_end }; }
    let close3: Expect = expect<P, N>(pages, stride, total, tail.cursor, 68);
    if !(close3.ok) { return FnDecl { ..bad, err_start: close3.err_start, err_end: close3.err_end }; }
    let sig: FnSig = FnSig { name_start: name.start, name_end: name.end, generics: generics.list, params: params.list, results: results.list, contracts: clauses.contracts, effects: clauses.effects, capabilities: clauses.capabilities };
    let fnbody: FnBody = FnBody { body: body.list, ret: tail.node, has_ret: true };
    return FnDecl { ok: true, err_start: 0, err_end: 0, sig: sig, body: fnbody, fn_start: start, fn_end: close3.cursor, cursor: close3.cursor };
}
record ReturnParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, node: Expr }
fn parse_return_tail<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: ReturnParse) {
    let bad: Expr = Expr.Name { start: cursor, end: cursor };
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if token.diagnostic != 0 || token.kind != 13 {
        return ReturnParse { cursor: cursor, ok: false, err_start: token.start, err_end: token.end, node: bad };
    }
    let value: ExprParse = parse_expr<P, N>(pages, stride, total, token.end, profile_013);
    if !(value.ok) { return ReturnParse { cursor: cursor, ok: false, err_start: value.err_start, err_end: value.err_end, node: bad }; }
    let semi: Expect = expect<P, N>(pages, stride, total, value.cursor, 63);
    if !(semi.ok) { return ReturnParse { cursor: cursor, ok: false, err_start: semi.err_start, err_end: semi.err_end, node: bad }; }
    return ReturnParse { cursor: semi.cursor, ok: true, err_start: 0, err_end: 0, node: value.node };
}

// Whole logical-source unit: header, imports, then interleaved record,
// enum, and function declarations through EOF.
record UnitState { cursor: u64, ok: bool, err_start: u64, err_end: u64, uses: UseList, records: RecordList, enums: EnumList, fns: FnList, count: u64, done: bool, profile_013: bool }
fn parse_unit<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: Unit) {
    let empty: parser.Header = parser.Header { code: 0, start: 0, end: 0, version_start: 0, version_end: 0, module_start: 0, module_end: 0, next_offset: 0, state: 0 };
    let bad: Unit = Unit { ok: false, err_start: 0, err_end: 0, header: empty, uses: UseList.UNil, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, cursor: 0 };
    // CP-0021: the declaration stage consumes the logical paged source. A
    // non-canonical page composition fails closed here (span [0, 0]) before
    // any cursor work; downstream project-chained calls trust this gate.
    if source.validate_pages<P, N>(pages, stride, total) != 0 { return bad; }
    let head: parser.Header = header<P, N>(pages, stride, total);
    if head.code != 0 { return Unit { ..bad, header: head, err_start: head.start, err_end: head.end, cursor: head.next_offset }; }
    let uses: UsesParse = parse_uses<P, N>(pages, stride, total, head.next_offset);
    if !(uses.ok) { return Unit { ..bad, header: head, err_start: uses.err_start, err_end: uses.err_end, cursor: uses.cursor }; }
    let profile_013: bool = profile_at_least_013<P, N>(pages, stride, total, head.version_start, head.version_end);
    // CP-0003: conditional chunk chain (64 x 16 = 1024, unchanged
    // fuel). The unit loop carries every accumulated declaration, so
    // each no-op tail copies the largest state; 16-declaration
    // chunks cap post-completion tails at 15 copies. `done` is
    // terminal (unit_step + unit_enum/record/fn set it; the step
    // preserves it), so skipping is semantics-preserving.
    iterate i up_to 16 carrying u0: UnitState = UnitState { cursor: uses.cursor, ok: true, err_start: 0, err_end: 0, uses: uses.list, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, count: 0, done: false, profile_013: profile_013 } {
        next u0 = unit_step<P, N>(pages, stride, total, u0);
    }
    if u0.done || !(u0.ok) { return finish_unit<P, N>(pages, stride, total, head, u0); }
    iterate i up_to 16 carrying u1: UnitState = u0 {
        next u1 = unit_step<P, N>(pages, stride, total, u1);
    }
    if u1.done || !(u1.ok) { return finish_unit<P, N>(pages, stride, total, head, u1); }
    iterate i up_to 16 carrying u2: UnitState = u1 {
        next u2 = unit_step<P, N>(pages, stride, total, u2);
    }
    if u2.done || !(u2.ok) { return finish_unit<P, N>(pages, stride, total, head, u2); }
    iterate i up_to 16 carrying u3: UnitState = u2 {
        next u3 = unit_step<P, N>(pages, stride, total, u3);
    }
    if u3.done || !(u3.ok) { return finish_unit<P, N>(pages, stride, total, head, u3); }
    iterate i up_to 16 carrying u4: UnitState = u3 {
        next u4 = unit_step<P, N>(pages, stride, total, u4);
    }
    if u4.done || !(u4.ok) { return finish_unit<P, N>(pages, stride, total, head, u4); }
    iterate i up_to 16 carrying u5: UnitState = u4 {
        next u5 = unit_step<P, N>(pages, stride, total, u5);
    }
    if u5.done || !(u5.ok) { return finish_unit<P, N>(pages, stride, total, head, u5); }
    iterate i up_to 16 carrying u6: UnitState = u5 {
