        next u57 = unit_step<P, N>(pages, stride, total, u57);
    }
    if u57.done || !(u57.ok) { return finish_unit<P, N>(pages, stride, total, head, u57); }
    iterate i up_to 16 carrying u58: UnitState = u57 {
        next u58 = unit_step<P, N>(pages, stride, total, u58);
    }
    if u58.done || !(u58.ok) { return finish_unit<P, N>(pages, stride, total, head, u58); }
    iterate i up_to 16 carrying u59: UnitState = u58 {
        next u59 = unit_step<P, N>(pages, stride, total, u59);
    }
    if u59.done || !(u59.ok) { return finish_unit<P, N>(pages, stride, total, head, u59); }
    iterate i up_to 16 carrying u60: UnitState = u59 {
        next u60 = unit_step<P, N>(pages, stride, total, u60);
    }
    if u60.done || !(u60.ok) { return finish_unit<P, N>(pages, stride, total, head, u60); }
    iterate i up_to 16 carrying u61: UnitState = u60 {
        next u61 = unit_step<P, N>(pages, stride, total, u61);
    }
    if u61.done || !(u61.ok) { return finish_unit<P, N>(pages, stride, total, head, u61); }
    iterate i up_to 16 carrying u62: UnitState = u61 {
        next u62 = unit_step<P, N>(pages, stride, total, u62);
    }
    if u62.done || !(u62.ok) { return finish_unit<P, N>(pages, stride, total, head, u62); }
    iterate i up_to 16 carrying u63: UnitState = u62 {
        next u63 = unit_step<P, N>(pages, stride, total, u63);
    }
    return finish_unit<P, N>(pages, stride, total, head, u63);
}
record UsesParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: UseList }
record UsesState { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: UseList, done: bool }
fn parse_uses<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: UsesParse) {
    iterate i up_to 1024 carrying d: UsesState = UsesState { cursor: cursor, ok: true, err_start: 0, err_end: 0, list: UseList.UNil, done: false } {
        next d = uses_step<P, N>(pages, stride, total, d);
    }
    return finish_uses<P, N>(pages, stride, total, d);
}
fn uses_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: UsesState) -> (result: UsesState) {
    if !(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if token.diagnostic != 0 || token.kind != 28 { return UsesState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: st.list, done: true }; }
    let decl: UseDecl = parse_use<P, N>(pages, stride, total, token.end);
    if !(decl.ok) { return UsesState { cursor: st.cursor, ok: false, err_start: decl.err_start, err_end: decl.err_end, list: st.list, done: true }; }
    return UsesState { cursor: decl.cursor, ok: true, err_start: 0, err_end: 0, list: UseList.UCons { head: decl, tail: st.list }, done: false };
}
fn finish_uses<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: UsesState) -> (result: UsesParse) {
    if !(st.ok) { return UsesParse { cursor: st.cursor, ok: false, err_start: st.err_start, err_end: st.err_end, list: UseList.UNil }; }
    return UsesParse { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, list: reverse_uses<P, N>(pages, stride, total, st.list) };
}
record UseRev { rest: UseList, acc: UseList }
fn reverse_uses<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: UseList) -> (result: UseList) {
    iterate i up_to 1024 carrying d: UseRev = UseRev { rest: list, acc: UseList.UNil } {
        if use_list_empty(d.rest) { return d.acc; }
        next d = reverse_uses_step(d);
    }
    return d.acc;
}
fn reverse_uses_step(st: UseRev) -> (result: UseRev) {
    return match st.rest { UNil => st, UCons { head: h, tail: t } => UseRev { rest: t, acc: UseList.UCons { head: h, tail: st.acc } } };
}
fn unit_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: UnitState) -> (result: UnitState) {
    if !(st.ok) || st.done { return st; }
    let token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if token.diagnostic != 0 || token.kind == 0 { return UnitState { cursor: st.cursor, ok: true, err_start: 0, err_end: 0, uses: st.uses, records: st.records, enums: st.enums, fns: st.fns, count: st.count, done: true, profile_013: st.profile_013 }; }
    if token.kind == 27 { return unit_enum<P, N>(pages, stride, total, st, token); }
    if token.kind == 29 { return unit_record<P, N>(pages, stride, total, st, token); }
    if token.kind == 12 { return unit_fn<P, N>(pages, stride, total, st, token); }
    return UnitState { cursor: st.cursor, ok: false, err_start: token.start, err_end: token.end, uses: st.uses, records: st.records, enums: st.enums, fns: st.fns, count: st.count, done: true, profile_013: st.profile_013 };
}
fn unit_enum<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: UnitState, token: lexer.Token) -> (result: UnitState) {
    let decl: EnumDecl = parse_enum<P, N>(pages, stride, total, token.end, token.start, st.profile_013);
    if !(decl.ok) { return UnitState { cursor: st.cursor, ok: false, err_start: decl.err_start, err_end: decl.err_end, uses: st.uses, records: st.records, enums: st.enums, fns: st.fns, count: st.count, done: true, profile_013: st.profile_013 }; }
    return UnitState { cursor: decl.cursor, ok: true, err_start: 0, err_end: 0, uses: st.uses, records: st.records, enums: EnumList.GCons { head: decl, tail: st.enums }, fns: st.fns, count: st.count + 1, done: false, profile_013: st.profile_013 };
}
fn unit_record<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: UnitState, token: lexer.Token) -> (result: UnitState) {
    let decl: RecordDecl = parse_record<P, N>(pages, stride, total, token.end, token.start, st.profile_013);
    if !(decl.ok) { return UnitState { cursor: st.cursor, ok: false, err_start: decl.err_start, err_end: decl.err_end, uses: st.uses, records: st.records, enums: st.enums, fns: st.fns, count: st.count, done: true, profile_013: st.profile_013 }; }
    return UnitState { cursor: decl.cursor, ok: true, err_start: 0, err_end: 0, uses: st.uses, records: RecordList.RCons { head: decl, tail: st.records }, enums: st.enums, fns: st.fns, count: st.count + 1, done: false, profile_013: st.profile_013 };
}
fn unit_fn<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: UnitState, token: lexer.Token) -> (result: UnitState) {
    let decl: FnDecl = parse_fn<P, N>(pages, stride, total, token.end, token.start, st.profile_013);
    if !(decl.ok) { return UnitState { cursor: st.cursor, ok: false, err_start: decl.err_start, err_end: decl.err_end, uses: st.uses, records: st.records, enums: st.enums, fns: st.fns, count: st.count, done: true, profile_013: st.profile_013 }; }
    return UnitState { cursor: decl.cursor, ok: true, err_start: 0, err_end: 0, uses: st.uses, records: st.records, enums: st.enums, fns: FnList.DCons { head: decl, tail: st.fns }, count: st.count + 1, done: false, profile_013: st.profile_013 };
}
fn finish_unit<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, head: parser.Header, st: UnitState) -> (result: Unit) {
    let empty: parser.Header = parser.Header { code: 0, start: 0, end: 0, version_start: 0, version_end: 0, module_start: 0, module_end: 0, next_offset: 0, state: 0 };
    if !(st.ok) { return Unit { ok: false, err_start: st.err_start, err_end: st.err_end, header: head, uses: UseList.UNil, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, cursor: st.cursor }; }
    let tail: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if tail.diagnostic != 0 { return Unit { ok: false, err_start: tail.start, err_end: tail.end, header: head, uses: UseList.UNil, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, cursor: st.cursor }; }
    if tail.kind != 0 { return Unit { ok: false, err_start: tail.start, err_end: tail.end, header: head, uses: UseList.UNil, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, cursor: st.cursor }; }
    if st.count == 0 {
        return Unit { ok: false, err_start: tail.start, err_end: tail.end, header: head, uses: UseList.UNil, records: RecordList.RNil, enums: EnumList.GNil, fns: FnList.DNil, cursor: st.cursor };
    }
    return Unit { ok: true, err_start: 0, err_end: 0, header: head, uses: st.uses, records: reverse_records<P, N>(pages, stride, total, st.records), enums: reverse_enums<P, N>(pages, stride, total, st.enums), fns: reverse_fns<P, N>(pages, stride, total, st.fns), cursor: st.cursor };
}
record RecordRev { rest: RecordList, acc: RecordList }
fn reverse_records<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: RecordList) -> (result: RecordList) {
    iterate i up_to 1024 carrying d: RecordRev = RecordRev { rest: list, acc: RecordList.RNil } {
        if record_list_empty(d.rest) { return d.acc; }
        next d = reverse_records_step(d);
    }
    return d.acc;
}
fn reverse_records_step(st: RecordRev) -> (result: RecordRev) {
    return match st.rest { RNil => st, RCons { head: h, tail: t } => RecordRev { rest: t, acc: RecordList.RCons { head: h, tail: st.acc } } };
}
record EnumRev { rest: EnumList, acc: EnumList }
fn reverse_enums<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: EnumList) -> (result: EnumList) {
    iterate i up_to 1024 carrying d: EnumRev = EnumRev { rest: list, acc: EnumList.GNil } {
        if enum_list_empty(d.rest) { return d.acc; }
        next d = reverse_enums_step(d);
    }
    return d.acc;
}
fn reverse_enums_step(st: EnumRev) -> (result: EnumRev) {
    return match st.rest { GNil => st, GCons { head: h, tail: t } => EnumRev { rest: t, acc: EnumList.GCons { head: h, tail: st.acc } } };
}
record FnRev { rest: FnList, acc: FnList }
fn reverse_fns<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: FnList) -> (result: FnList) {
    iterate i up_to 1024 carrying d: FnRev = FnRev { rest: list, acc: FnList.DNil } {
        if declared_fn_list_empty(d.rest) { return d.acc; }
        next d = reverse_fns_step(d);
    }
    return d.acc;
}
fn reverse_fns_step(st: FnRev) -> (result: FnRev) {
    return match st.rest { DNil => st, DCons { head: h, tail: t } => FnRev { rest: t, acc: FnList.DCons { head: h, tail: st.acc } } };
}

// Symbol, semantic, and IR micro-facts over parsed units. Same home module
// as the trees (see the homing rule at the top of this file). All checks
// are bounded: list traversals burn caller-supplied segment fuel, and an
// undrained work stack at the end of fuel is reported as a check failure,
// never silently accepted (see CP-0009). Stage tags on UnitCheck: 0 parse,
// 1 duplicate symbols, 2 resolve/span walk, 3 IR depth, 4 fully verified.
// Type-namespace resolution (record/enum/value types, use aliases) is
// deferred; only function-name symbols and call resolution are checked.

// A declared function name as a source span.
record NameSpan { start: u64, end: u64 }
enum NameList { NNil, NCons { head: NameSpan, tail: NameList } }

// Exact byte equality of two spans. Lengths compare without fuel; only
// equal-length spans burn byte fuel, one position per step.
record EqState { a_start: u64, len: u64, b_start: u64, off: u64, eq: bool }
fn spans_equal<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, a_start: u64, a_end: u64, b_start: u64, b_end: u64) -> (result: bool) {
    if a_end < a_start || b_end < b_start { return false; }
    if a_end - a_start != b_end - b_start { return false; }
    iterate i up_to 1024 carrying d: EqState = EqState { a_start: a_start, len: a_end - a_start, b_start: b_start, off: 0, eq: true } {
        if !(d.eq) || d.off >= d.len { return d.eq; }
        next d = span_eq_step<P, N>(pages, stride, total, d);
    }
    return d.eq;
}
fn span_eq_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: EqState) -> (result: EqState) {
    if st.off >= st.len { return st; }
    let same: bool = segment.byte_at_global<P, N>(pages, stride, total, st.a_start + st.off) == segment.byte_at_global<P, N>(pages, stride, total, st.b_start + st.off);
    return EqState { a_start: st.a_start, len: st.len, b_start: st.b_start, off: st.off + 1, eq: st.eq && same };
}

// Declared function names in source order (reversed during accumulation,
// then restored like every other list here).
record FnNameAcc { rest: FnList, acc: NameList }
fn collect_fn_names<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fns: FnList) -> (result: NameList) {
    iterate i up_to 1024 carrying d: FnNameAcc = FnNameAcc { rest: fns, acc: NameList.NNil } {
        next d = collect_fn_names_step(d);
    }
    return reverse_names<P, N>(pages, stride, total, d.acc);
}
fn collect_fn_names_step(st: FnNameAcc) -> (result: FnNameAcc) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => collect_fn_names_cons(st, h, t)
    };
}
fn collect_fn_names_cons(st: FnNameAcc, h: FnDecl, t: FnList) -> (result: FnNameAcc) {
    let sg: FnSig = h.sig;
    return FnNameAcc { rest: t, acc: NameList.NCons { head: NameSpan { start: sg.name_start, end: sg.name_end }, tail: st.acc } };
}
record NameRev { rest: NameList, acc: NameList }
fn reverse_names<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: NameList) -> (result: NameList) {
    iterate i up_to 1024 carrying d: NameRev = NameRev { rest: list, acc: NameList.NNil } {
        if name_list_empty(d.rest) { return d.acc; }
        next d = reverse_names_step(d);
    }
    return d.acc;
}
fn reverse_names_step(st: NameRev) -> (result: NameRev) {
    return match st.rest { NNil => st, NCons { head: h, tail: t } => NameRev { rest: t, acc: NameList.NCons { head: h, tail: st.acc } } };
}

// Membership of a span in a name list by exact bytes.
record KnownState { rest: NameList, start: u64, end: u64, found: bool }
fn name_known<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: NameList, start: u64, end: u64) -> (result: bool) {
    iterate i up_to 1024 carrying d: KnownState = KnownState { rest: list, start: start, end: end, found: false } {
        next d = name_known_step<P, N>(pages, stride, total, d);
    }
    return d.found;
}
fn name_known_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: KnownState) -> (result: KnownState) {
    return match st.rest {
        NNil => st,
        NCons { head: h, tail: t } => KnownState { rest: t, start: st.start, end: st.end, found: st.found || spans_equal<P, N>(pages, stride, total, h.start, h.end, st.start, st.end) }
    };
}

// First duplicated function name, if any.
record DupState { rest: NameList, seen: NameList, found: bool, start: u64, end: u64 }
record DupReport { found: bool, start: u64, end: u64 }
fn duplicate_fn_names<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, names: NameList) -> (result: DupReport) {
    iterate i up_to 1024 carrying d: DupState = DupState { rest: names, seen: NameList.NNil, found: false, start: 0, end: 0 } {
        next d = duplicate_fn_names_step<P, N>(pages, stride, total, d);
    }
    return DupReport { found: d.found, start: d.start, end: d.end };
}
fn duplicate_fn_names_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: DupState) -> (result: DupState) {
    return match st.rest {
        NNil => st,
        NCons { head: h, tail: t } => duplicate_fn_names_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn duplicate_fn_names_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: DupState, h: NameSpan, t: NameList) -> (result: DupState) {

    if st.found { return DupState { rest: t, seen: st.seen, found: true, start: st.start, end: st.end }; }
    if name_known<P, N>(pages, stride, total, st.seen, h.start, h.end) {
        return DupState { rest: t, seen: st.seen, found: true, start: h.start, end: h.end };
    }
    return DupState { rest: t, seen: NameList.NCons { head: h, tail: st.seen }, found: false, start: 0, end: 0 };
}

// Resolve/span walk over one function body. Two work stacks: swords holds
// statements whose expressions are not yet queued, work holds queued
// expressions. Every visited expression is pushed onto acc for the later
// IR phase. The first bad span (out-of-range expression span or call to
// an undeclared function name) drains both stacks and wins; traversal
// order is the documented first-error order.
record WalkState { swords: StmtList, work: ExprList, acc: ExprList, names: NameList, total: u64, ok: bool, bad_start: u64, bad_end: u64 }
record BodyReport { ok: bool, bad_start: u64, bad_end: u64, exprs: ExprList }
fn check_body<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, body: StmtList, ret: Expr, names: NameList) -> (result: BodyReport) {

    iterate i up_to 1024 carrying d: WalkState = WalkState { swords: body, work: ExprList.ECons { head: ret, tail: ExprList.ENil }, acc: ExprList.ENil, names: names, total: total, ok: true, bad_start: 0, bad_end: 0 } {
        next d = walk_step<P, N>(pages, stride, total, d);
    }
    return walk_report(d);
}
fn walk_report(st: WalkState) -> (result: BodyReport) {
    if !(st.ok) { return BodyReport { ok: false, bad_start: st.bad_start, bad_end: st.bad_end, exprs: ExprList.ENil }; }
    if !(walk_drained(st)) { return BodyReport { ok: false, bad_start: st.total, bad_end: st.total, exprs: ExprList.ENil }; }
    return BodyReport { ok: true, bad_start: 0, bad_end: 0, exprs: st.acc };
}
fn walk_drained(st: WalkState) -> (result: bool) {
    return match st.swords {
        SCons { head: h, tail: t } => walk_drained_cons(h, t, st),
        SNil => walk_work_drained(st)
    };
}
fn walk_drained_cons(h: Stmt, t: StmtList, st: WalkState) -> (result: bool) {
    return false;
}
fn walk_work_drained(st: WalkState) -> (result: bool) {
    return match st.work {
        ECons { head: h, tail: t } => walk_drained_cons_expr(h, t),
        ENil => true
    };
}
fn walk_drained_cons_expr(h: Expr, t: ExprList) -> (result: bool) {
    return false;
}
fn walk_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: WalkState) -> (result: WalkState) {

    if !(st.ok) { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: st.acc, names: st.names, total: st.total, ok: false, bad_start: st.bad_start, bad_end: st.bad_end }; }
    return match st.swords {
        SCons { head: h, tail: t } => walk_stmt<P, N>(pages, stride, total, st, h, t),
        SNil => walk_expr_top<P, N>(pages, stride, total, st)
    };
}
fn walk_stmt<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: WalkState, h: Stmt, t: StmtList) -> (result: WalkState) {
    return match h {
        Let { name_start: a, name_end: b, type_start: c, type_end: d, type_kind: k, value: v, start: s, end: e } => walk_stmt_let(st, t, v, a, b, c, d, k, s, e),
        If { cond: c, then_b: tb, else_b: eb, start: s, end: e } => walk_stmt_if<P, N>(pages, stride, total, st, t, c, tb, eb, s, e),
        Fail { mode_start: a, mode_end: b, start: s, end: e } => walk_stmt_fail(st, t, a, b, s, e),
        Return { value: v, start: s, end: e } => walk_stmt_return(st, t, v, s, e),
        Iterate { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, body: b, next_start: xs, next_end: xe, next_value: nv, start: s, end: e } => walk_stmt_iterate<P, N>(pages, stride, total, st, t, o, ho, init, b, nv, s, e)
    };
}
fn walk_stmt_iterate<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: WalkState, t: StmtList, o: Expr, ho: bool, init: Expr, b: StmtList, nv: Expr, s: u64, e: u64) -> (result: WalkState) {
    if e < s || e > st.total { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: st.acc, names: st.names, total: st.total, ok: false, bad_start: s, bad_end: e }; }
    return WalkState { swords: append_stmts<P, N>(pages, stride, total, b, t), work: iterate_call_exprs(o, ho, init, nv, st.work), acc: st.acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 };
}
fn walk_stmt_let(st: WalkState, t: StmtList, v: Expr, a: u64, b: u64, c: u64, d: u64, k: u64, s: u64, e: u64) -> (result: WalkState) {
    if e < s || e > st.total { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: st.acc, names: st.names, total: st.total, ok: false, bad_start: s, bad_end: e }; }
    return WalkState { swords: t, work: ExprList.ECons { head: v, tail: st.work }, acc: st.acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 };
}
fn walk_stmt_if<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: WalkState, t: StmtList, c: Expr, tb: StmtList, eb: StmtList, s: u64, e: u64) -> (result: WalkState) {

    if e < s || e > st.total { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: st.acc, names: st.names, total: st.total, ok: false, bad_start: s, bad_end: e }; }
    return WalkState { swords: append_stmts<P, N>(pages, stride, total, tb, append_stmts<P, N>(pages, stride, total, eb, t)), work: ExprList.ECons { head: c, tail: st.work }, acc: st.acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 };
}
fn walk_stmt_fail(st: WalkState, t: StmtList, a: u64, b: u64, s: u64, e: u64) -> (result: WalkState) {
    if e < s || e > st.total { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: st.acc, names: st.names, total: st.total, ok: false, bad_start: s, bad_end: e }; }
    return WalkState { swords: t, work: st.work, acc: st.acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 };
}
fn walk_stmt_return(st: WalkState, t: StmtList, v: Expr, s: u64, e: u64) -> (result: WalkState) {
    if e < s || e > st.total { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: st.acc, names: st.names, total: st.total, ok: false, bad_start: s, bad_end: e }; }
    return WalkState { swords: t, work: ExprList.ECons { head: v, tail: st.work }, acc: st.acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 };
}
fn walk_expr_top<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: WalkState) -> (result: WalkState) {
    return match st.work {
        ENil => st,
        ECons { head: h, tail: t } => walk_expr<P, N>(pages, stride, total, st, h, t)
    };
}
fn walk_expr<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: WalkState, h: Expr, t: ExprList) -> (result: WalkState) {

    let s: u64 = expr_start(h);
    let e: u64 = expr_end(h);
    let acc: ExprList = ExprList.ECons { head: h, tail: st.acc };
    if e < s || e > st.total { return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: acc, names: st.names, total: st.total, ok: false, bad_start: s, bad_end: e }; }
    return walk_children<P, N>(pages, stride, total, st, h, t, acc);
}
fn walk_children<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: WalkState, h: Expr, t: ExprList, acc: ExprList) -> (result: WalkState) {

    return match h {
        Name { start: s, end: e } => WalkState { swords: st.swords, work: t, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        Integer { start: s, end: e, value: v, overflow: o } => WalkState { swords: st.swords, work: t, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        Boolean { start: s, end: e, value: v } => WalkState { swords: st.swords, work: t, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        UnaryNot { value: value, start: s, end: e } => WalkState { swords: st.swords, work: ExprList.ECons { head: value, tail: t }, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => WalkState { swords: st.swords, work: ExprList.ECons { head: value, tail: t }, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => WalkState { swords: st.swords, work: scalar_match_children<P, N>(pages, stride, total, subject, arms, t), acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        Binary { op: o, left: l, right: r, start: s, end: e } => WalkState { swords: st.swords, work: ExprList.ECons { head: l, tail: ExprList.ECons { head: r, tail: t } }, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e } => walk_call<P, N>(pages, stride, total, st, t, acc, ns, ne, a, tg),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => WalkState { swords: st.swords, work: ExprList.ECons { head: b, tail: t }, acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => WalkState { swords: st.swords, work: finite_match_children<P, N>(pages, stride, total, subject, arms, t), acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => WalkState { swords: st.swords, work: construct_children<P, N>(pages, stride, total, f, t), acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => WalkState { swords: st.swords, work: record_children<P, N>(pages, stride, total, b, hb, f, t), acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 },
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => WalkState { swords: st.swords, work: append_exprs<P, N>(pages, stride, total, a, t), acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 }
    };
}
fn walk_call<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: WalkState, t: ExprList, acc: ExprList, ns: u64, ne: u64, args: ExprList, tg: TypeArgList) -> (result: WalkState) {

    if !(name_known<P, N>(pages, stride, total, st.names, ns, ne)) {
        return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: acc, names: st.names, total: st.total, ok: false, bad_start: ns, bad_end: ne };
    }
    let checked: TargSpanCheck = check_targ_spans(tg, st.total);
    if !(checked.ok) {
        return WalkState { swords: StmtList.SNil, work: ExprList.ENil, acc: acc, names: st.names, total: st.total, ok: false, bad_start: checked.bad_start, bad_end: checked.bad_end };
    }
    return WalkState { swords: st.swords, work: append_exprs<P, N>(pages, stride, total, args, t), acc: acc, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0 };
}
record TargSpanCheck { ok: bool, bad_start: u64, bad_end: u64 }
record TargSpanWalk { rest: TypeArgList, ok: bool, bad_start: u64, bad_end: u64 }
fn check_targ_spans(list: TypeArgList, total: u64) -> (result: TargSpanCheck) {
    iterate i up_to 1024 carrying d: TargSpanWalk = TargSpanWalk { rest: list, ok: true, bad_start: 0, bad_end: 0 } {
        next d = check_targ_spans_step(d, total);
    }
    return TargSpanCheck { ok: d.ok, bad_start: d.bad_start, bad_end: d.bad_end };
}
fn check_targ_spans_step(st: TargSpanWalk, total: u64) -> (result: TargSpanWalk) {
    if !(st.ok) { return TargSpanWalk { rest: TypeArgList.TNil, ok: false, bad_start: st.bad_start, bad_end: st.bad_end }; }
    return match st.rest {
        TNil => st,
        TCons { head: h, tail: t } => check_one_targ_span(st, t, total, h.start, h.end)
    };
}
fn check_one_targ_span(st: TargSpanWalk, rest: TypeArgList, total: u64, start: u64, end: u64) -> (result: TargSpanWalk) {
    if end < start || end > total { return TargSpanWalk { rest: TypeArgList.TNil, ok: false, bad_start: start, bad_end: end }; }
    return TargSpanWalk { rest: rest, ok: true, bad_start: 0, bad_end: 0 };
}

// List appends via reversal (each input list is consumed once, so the
// traversal stays within segment fuel for bounded sources).
record StmtPrepend { rest: StmtList, acc: StmtList }
fn append_stmts<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, first: StmtList, second: StmtList) -> (result: StmtList) {
    let rev: StmtList = reverse_stmts<P, N>(pages, stride, total, first);
    iterate i up_to 1024 carrying d: StmtPrepend = StmtPrepend { rest: rev, acc: second } {
        next d = append_stmts_step(d);
    }
    return d.acc;
}
fn append_stmts_step(st: StmtPrepend) -> (result: StmtPrepend) {
    return match st.rest { SNil => st, SCons { head: h, tail: t } => StmtPrepend { rest: t, acc: StmtList.SCons { head: h, tail: st.acc } } };
}
record ExprPrepend { rest: ExprList, acc: ExprList }
fn append_exprs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, first: ExprList, second: ExprList) -> (result: ExprList) {
    let rev: ExprList = reverse_exprs<P, N>(pages, stride, total, first);
    iterate i up_to 1024 carrying d: ExprPrepend = ExprPrepend { rest: rev, acc: second } {
        next d = append_exprs_step(d);
    }
    return d.acc;
}
fn append_exprs_step(st: ExprPrepend) -> (result: ExprPrepend) {
    return match st.rest { ENil => st, ECons { head: h, tail: t } => ExprPrepend { rest: t, acc: ExprList.ECons { head: h, tail: st.acc } } };
}

// Tiny stack IR: one instruction per expression node in postorder. The
// depth verifier below is a self-check in the kernel.shape tradition: it
// must accept every lowering of a walked body, so a rejection is always
// a lowering bug, never a source fact.
enum FlatOp {
    PInt { value: u64 },
    PBool { value: bool },
    PName { start: u64, end: u64 },
    PNot,
    PRepeat { count: u64 },
    PMatch { arms: u64 },
    PBin { op: u64 },
    PCall { name_start: u64, name_end: u64, argc: u64 },
    PProj { field_start: u64, field_end: u64, path: bool },
    PConstruct { fields: u64 }
}
enum FlatList { INil, ICons { head: FlatOp, tail: FlatList } }
record LowerState { work: ExprList, out: FlatList }
fn lower_expr<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, node: Expr) -> (result: FlatList) {
    iterate i up_to 1024 carrying d: LowerState = LowerState { work: ExprList.ECons { head: node, tail: ExprList.ENil }, out: FlatList.INil } {
        next d = lower_step<P, N>(pages, stride, total, d);
    }
    // No reversal: right-subtree-first visiting conses nodes so the head-
    // first output list already reads postorder (operator after both
    // operand subtrees, call after all argument subtrees).
    return d.out;
}
fn lower_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LowerState) -> (result: LowerState) {
    return match st.work {
        ENil => st,
        ECons { head: h, tail: t } => lower_one<P, N>(pages, stride, total, st, h, t)
    };
}
fn lower_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LowerState, h: Expr, t: ExprList) -> (result: LowerState) {
    return match h {
        Name { start: s, end: e } => LowerState { work: t, out: FlatList.ICons { head: FlatOp.PName { start: s, end: e }, tail: st.out } },
        Integer { start: s, end: e, value: v, overflow: o } => LowerState { work: t, out: FlatList.ICons { head: FlatOp.PInt { value: v }, tail: st.out } },
        Boolean { start: s, end: e, value: v } => LowerState { work: t, out: FlatList.ICons { head: FlatOp.PBool { value: v }, tail: st.out } },
        UnaryNot { value: value, start: s, end: e } => LowerState { work: ExprList.ECons { head: value, tail: t }, out: FlatList.ICons { head: FlatOp.PNot, tail: st.out } },
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => lower_repeat<P, N>(pages, stride, total, st, t, value, cs, ce, ck),
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => lower_scalar_match<P, N>(pages, stride, total, st, t, subject, arms),
        Binary { op: o, left: l, right: r, start: s, end: e } => LowerState { work: ExprList.ECons { head: r, tail: ExprList.ECons { head: l, tail: t } }, out: FlatList.ICons { head: FlatOp.PBin { op: o }, tail: st.out } },
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e } => lower_call<P, N>(pages, stride, total, st, t, ns, ne, a),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => LowerState { work: ExprList.ECons { head: b, tail: t }, out: FlatList.ICons { head: FlatOp.PProj { field_start: fs, field_end: fe, path: p }, tail: st.out } },
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => lower_finite_match<P, N>(pages, stride, total, st, t, subject, arms),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => lower_construct<P, N>(pages, stride, total, st, t, f),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => lower_record_construct<P, N>(pages, stride, total, st, t, b, hb, f),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => lower_call<P, N>(pages, stride, total, st, t, ns, ne, a)
    };
}
fn lower_scalar_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LowerState, t: ExprList, subject: Expr, arms: ScalarMatchArmList) -> (result: LowerState) {
    let count: ScalarMatchCount = scalar_match_count<P, N>(pages, stride, total, arms);
    let children: ExprList = scalar_match_children<P, N>(pages, stride, total, subject, arms, ExprList.ENil);
    let rev: ExprList = reverse_exprs<P, N>(pages, stride, total, children);
    return LowerState { work: append_exprs<P, N>(pages, stride, total, rev, t), out: FlatList.ICons { head: FlatOp.PMatch { arms: count.n }, tail: st.out } };
}
fn lower_finite_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LowerState, t: ExprList, subject: Expr, arms: FiniteMatchArmList) -> (result: LowerState) {
    let count: FiniteMatchCount = finite_match_count<P, N>(pages, stride, total, arms);
    let children: ExprList = finite_match_children<P, N>(pages, stride, total, subject, arms, ExprList.ENil);
    let rev: ExprList = reverse_exprs<P, N>(pages, stride, total, children);
    return LowerState { work: append_exprs<P, N>(pages, stride, total, rev, t), out: FlatList.ICons { head: FlatOp.PMatch { arms: count.n }, tail: st.out } };
}
fn lower_construct<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LowerState, t: ExprList, fields: ConstructFieldList) -> (result: LowerState) {
    let children: ExprList = construct_children<P, N>(pages, stride, total, fields, ExprList.ENil);
    let count: u64 = count_exprs<P, N>(pages, stride, total, children);
    let rev: ExprList = reverse_exprs<P, N>(pages, stride, total, children);
    return LowerState { work: append_exprs<P, N>(pages, stride, total, rev, t), out: FlatList.ICons { head: FlatOp.PConstruct { fields: count }, tail: st.out } };
}
// Record lowering counts the `..base` operand alongside the field values,
// so the depth verifier sees the base as the real stack input it is.
fn lower_record_construct<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LowerState, t: ExprList, base: Expr, has_base: bool, fields: ConstructFieldList) -> (result: LowerState) {
    let children: ExprList = record_children<P, N>(pages, stride, total, base, has_base, fields, ExprList.ENil);
    let count: u64 = count_exprs<P, N>(pages, stride, total, children);
    let rev: ExprList = reverse_exprs<P, N>(pages, stride, total, children);
    return LowerState { work: append_exprs<P, N>(pages, stride, total, rev, t), out: FlatList.ICons { head: FlatOp.PConstruct { fields: count }, tail: st.out } };
}
fn lower_repeat<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LowerState, t: ExprList, value: Expr, count_start: u64, count_end: u64, count_kind: u64) -> (result: LowerState) {
    if count_kind != 5 { return LowerState { work: ExprList.ECons { head: value, tail: t }, out: FlatList.ICons { head: FlatOp.PRepeat { count: 0 }, tail: st.out } }; }
    let count: IntVal = int_value<P, N>(pages, stride, total, count_start, count_end);
    return LowerState { work: ExprList.ECons { head: value, tail: t }, out: FlatList.ICons { head: FlatOp.PRepeat { count: count.value }, tail: st.out } };
}
fn lower_call<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LowerState, t: ExprList, ns: u64, ne: u64, args: ExprList) -> (result: LowerState) {
    let argc: u64 = count_exprs<P, N>(pages, stride, total, args);
    // Arguments queue reversed so the last argument is visited first and
    // the output keeps source argument order before the call op.
    let rev: ExprList = reverse_exprs<P, N>(pages, stride, total, args);
    return LowerState { work: append_exprs<P, N>(pages, stride, total, rev, t), out: FlatList.ICons { head: FlatOp.PCall { name_start: ns, name_end: ne, argc: argc }, tail: st.out } };
}
record CountState { rest: ExprList, n: u64 }
fn count_exprs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: ExprList) -> (result: u64) {
    iterate i up_to 1024 carrying d: CountState = CountState { rest: list, n: 0 } {
        next d = count_exprs_step(d);
    }
    return d.n;
}
fn count_exprs_step(st: CountState) -> (result: CountState) {
    return match st.rest { ENil => st, ECons { head: h, tail: t } => CountState { rest: t, n: st.n + 1 } };
}
// Stack-depth verifier: pushes add one, PBin nets minus one, PCall nets
// one minus argc, PProj is depth-neutral. A well-formed lowering of one
// expression ends at depth exactly one without ever going negative.
record DepthState { rest: FlatList, depth: u64, ok: bool }
fn flat_ok<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ops: FlatList) -> (result: bool) {
    iterate i up_to 1024 carrying d: DepthState = DepthState { rest: ops, depth: 0, ok: true } {
        next d = flat_step(d);
    }
    return d.ok && d.depth == 1;
}
fn flat_step(st: DepthState) -> (result: DepthState) {
    if !(st.ok) { return st; }
    return match st.rest {
        INil => st,
        ICons { head: h, tail: t } => flat_one(st, h, t)
    };
}
fn flat_one(st: DepthState, h: FlatOp, t: FlatList) -> (result: DepthState) {
    return match h {
        PInt { value: v } => DepthState { rest: t, depth: st.depth + 1, ok: true },
        PBool { value: v } => DepthState { rest: t, depth: st.depth + 1, ok: true },
        PName { start: s, end: e } => DepthState { rest: t, depth: st.depth + 1, ok: true },
        PNot => flat_not(st, t),
        PRepeat { count: n } => flat_not(st, t),
        PMatch { arms: n } => flat_match(st, t, n),
        PBin { op: o } => flat_bin(st, t),
        PCall { name_start: ns, name_end: ne, argc: c } => flat_call(st, t, c),
        PProj { field_start: fs, field_end: fe, path: p } => flat_proj(st, t),
        PConstruct { fields: f } => flat_call(st, t, f)
    };
}
fn flat_match(st: DepthState, t: FlatList, arms: u64) -> (result: DepthState) {
    if st.depth < arms + 1 { return DepthState { rest: FlatList.INil, depth: 0, ok: false }; }
    return DepthState { rest: t, depth: st.depth - arms, ok: true };
}
fn flat_not(st: DepthState, t: FlatList) -> (result: DepthState) {
    if st.depth < 1 { return DepthState { rest: FlatList.INil, depth: 0, ok: false }; }
    return DepthState { rest: t, depth: st.depth, ok: true };
}
fn flat_bin(st: DepthState, t: FlatList) -> (result: DepthState) {
    if st.depth < 2 { return DepthState { rest: FlatList.INil, depth: 0, ok: false }; }
    return DepthState { rest: t, depth: st.depth - 1, ok: true };
}
fn flat_call(st: DepthState, t: FlatList, argc: u64) -> (result: DepthState) {
    if st.depth < argc { return DepthState { rest: FlatList.INil, depth: 0, ok: false }; }
    return DepthState { rest: t, depth: st.depth - argc + 1, ok: true };
}
fn flat_proj(st: DepthState, t: FlatList) -> (result: DepthState) {
    if st.depth < 1 { return DepthState { rest: FlatList.INil, depth: 0, ok: false }; }
    return DepthState { rest: t, depth: st.depth, ok: true };
}

// Whole-unit driver: parse, then duplicate symbols, then the resolve/span
// walk over every function body, then the IR depth self-check over every
// walked expression. Counts are reported for evidence; ir_ok must be true
// whenever ok is true.
record FnsState { rest: FnList, names: NameList, total: u64, ok: bool, bad_start: u64, bad_end: u64, fn_count: u64, exprs: ExprList }
record FnsReport { ok: bool, bad_start: u64, bad_end: u64, fn_count: u64, exprs: ExprList }
record IrState { rest: ExprList, ok: bool, count: u64 }
record IrReport { ok: bool, count: u64 }
record UnitCheck { ok: bool, err_start: u64, err_end: u64, stage: u64, fn_count: u64, expr_count: u64, ir_ok: bool }
fn check_unit<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: UnitCheck) {

    let u: Unit = parse_unit<P, N>(pages, stride, total);
    if !(u.ok) { return UnitCheck { ok: false, err_start: u.err_start, err_end: u.err_end, stage: 0, fn_count: 0, expr_count: 0, ir_ok: false }; }
    let names: NameList = collect_fn_names<P, N>(pages, stride, total, u.fns);
    let dup: DupReport = duplicate_fn_names<P, N>(pages, stride, total, names);
    if dup.found { return UnitCheck { ok: false, err_start: dup.start, err_end: dup.end, stage: 1, fn_count: 0, expr_count: 0, ir_ok: false }; }
    let fns: FnsReport = check_all_fns<P, N>(pages, stride, total, u.fns, names);
    if !(fns.ok) { return UnitCheck { ok: false, err_start: fns.bad_start, err_end: fns.bad_end, stage: 2, fn_count: 0, expr_count: 0, ir_ok: false }; }
    let ir: IrReport = verify_ir_exprs<P, N>(pages, stride, total, fns.exprs);
    if !(ir.ok) { return UnitCheck { ok: false, err_start: total, err_end: total, stage: 3, fn_count: fns.fn_count, expr_count: ir.count, ir_ok: false }; }
    return UnitCheck { ok: true, err_start: 0, err_end: 0, stage: 4, fn_count: fns.fn_count, expr_count: ir.count, ir_ok: true };
}
fn check_all_fns<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fns: FnList, names: NameList) -> (result: FnsReport) {

    iterate i up_to 1024 carrying d: FnsState = FnsState { rest: fns, names: names, total: total, ok: true, bad_start: 0, bad_end: 0, fn_count: 0, exprs: ExprList.ENil } {
        next d = check_fns_step<P, N>(pages, stride, total, d);
    }
    return FnsReport { ok: d.ok, bad_start: d.bad_start, bad_end: d.bad_end, fn_count: d.fn_count, exprs: d.exprs };
}
fn check_fns_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FnsState) -> (result: FnsState) {

    if !(st.ok) { return FnsState { rest: FnList.DNil, names: st.names, total: st.total, ok: false, bad_start: st.bad_start, bad_end: st.bad_end, fn_count: st.fn_count, exprs: st.exprs }; }
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => check_one_fn<P, N>(pages, stride, total, st, h, t)
    };
}
fn check_one_fn<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FnsState, h: FnDecl, t: FnList) -> (result: FnsState) {

    let bd: FnBody = h.body;
    let rep: BodyReport = check_body<P, N>(pages, stride, total, bd.body, bd.ret, st.names);
    if !(rep.ok) { return FnsState { rest: FnList.DNil, names: st.names, total: st.total, ok: false, bad_start: rep.bad_start, bad_end: rep.bad_end, fn_count: st.fn_count, exprs: st.exprs }; }
    return FnsState { rest: t, names: st.names, total: st.total, ok: true, bad_start: 0, bad_end: 0, fn_count: st.fn_count + 1, exprs: append_exprs<P, N>(pages, stride, total, rep.exprs, st.exprs) };
}
fn verify_ir_exprs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, exprs: ExprList) -> (result: IrReport) {
    iterate i up_to 1024 carrying d: IrState = IrState { rest: exprs, ok: true, count: 0 } {
        next d = verify_ir_step<P, N>(pages, stride, total, d);
    }
    return IrReport { ok: d.ok, count: d.count };
}
fn verify_ir_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: IrState) -> (result: IrState) {
    if !(st.ok) { return IrState { rest: ExprList.ENil, ok: false, count: st.count }; }
    return match st.rest {
        ENil => st,
        ECons { head: h, tail: t } => verify_ir_one<P, N>(pages, stride, total, st, h, t)
    };
}
fn verify_ir_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: IrState, h: Expr, t: ExprList) -> (result: IrState) {
    let ops: FlatList = lower_expr<P, N>(pages, stride, total, h);
    if !(flat_ok<P, N>(pages, stride, total, ops)) { return IrState { rest: ExprList.ENil, ok: false, count: st.count }; }
    return IrState { rest: t, ok: true, count: st.count + 1 };
}

// Semantic facts, obligations, and intrinsic proof.
//
// Where check_unit stops at resolution and a structural depth tripwire,
// this section establishes meaning: every function body is checked against
// a bidirectional type discipline mirroring Stage-0 elaboration, and every
// check emits proof obligations as structured values. Proof lives inside
// fact establishment (each checking step is its own narrow authority),
// not in a separate pass.
//
// Obligation statuses: 1 FAIL (fact rejected), 2 UNKNOWN (fact accepted
// conservatively with the obligation retained). PASS leaves no obligation;
// the accepted fact plus its typed IR is the evidence. UNKNOWN never
// silently becomes PASS: any UNKNOWN forces conservative status.
//
// Obligation kinds (differential families against Stage-0 codes):
// 1 NAME_BOUND (MNE102) 2 NAME_TYPE (MNE117) 3 INT_LIT (MNE118)
// 4 BOOL_LIT (MNE122) 5 NO_SHADOW (MNE110) 6 ARITY (MNE132)
// 7 OPERAND_SAME (MNE119) 8 ARITH_INT (MNE120) 9 CMP_INT (MNE121)
// 10 BOOL_OP (MNE181) 11 SHIFT_BASE (MNE190) 12 BYTE_ARITH (MNE191)
// 13 OVERFLOW (checked-arithmetic risk, always UNKNOWN)
// 14 DIV_ZERO (non-literal divisor risk, always UNKNOWN)
// 15 EFFECT_COVER (MNE134) 16 CONTRACT (requires/ensures, always UNKNOWN)
// 17 CAP_AUTH (MNE111) 18 RESULT_ONE (MNE101) 19 TYPE_VALID (MNE105)
// 20 UNREACHABLE (MNE114) 21 FAIL_MODE (MNE113) 22 PROJ_FIELD (MNE162)
// 23 PROJ_BASE (MNE161) 24 IF_BOOL (MNE116) 25 CALL_RESULT (MNE135)
// 26 ARG_MATCH (MNE133) 27 RET_MATCH (MNE103) 28 LET_MATCH (MNE115)
// 29 REC_FIELD (MNE153) 30 ENUM_PAYLOAD (MNE171) 31 QUALIFIED (MNE173)
// 32 CALLEE (MNE131) 33 DUP_FIELD (MNE152) 34 DUP_VARIANT (MNE121 quirk)
// 35 PROJ_TYPE (MNE163) 36 USE_UNAVAIL (MNE173) 37 FN_DUP (MNE104)
// 38 MATCH_ARM (MNE138) 39 MATCH_DUP (MNE139) 40 MATCH_COVER (MNE140)
// 41 ARM_RESULT (MNE141) 42 CONSTRUCT_TYPE (MNE123) 43 CONSTRUCT_VARIANT (MNE124)
// 44 PAYLOAD_BIND (MNE177) 45 CONSTRUCT_FIELD (MNE172) 46 PAYLOAD_DUP (MNE178)
// 47 PAYLOAD_SHAPE (MNE179) 48 CONSTRUCT_DUP (MNE173) 49 CONSTRUCT_SHAPE (MNE174)
// 50 CONSTRUCT_VALUE (MNE175) 51 MATCH_SUBJECT (MNE136)
// 52 CONSTRUCT_RESULT (MNE125)
// 68 GENERIC_MISSING (MNE220) 69 GENERIC_ARITY (MNE221) 70 GENERIC_KIND (MNE222)
// 71 GENERIC_APPLY (UNKNOWN: substitution unmodeled) 72 NAT_AS_TYPE (MNE232)
// 73 HIGHER_BOUND (MNE229) 74 GENERIC_UNBOUND (MNE224)
record Obligation { kind: u64, start: u64, end: u64, status: u64 }
enum OblList { LNil, LCons { head: Obligation, tail: OblList } }
record OblRev { rest: OblList, acc: OblList }
fn reverse_obls<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: OblList) -> (result: OblList) {
    iterate i up_to 1024 carrying d: OblRev = OblRev { rest: list, acc: OblList.LNil } {
        if obligation_list_empty(d.rest) { return d.acc; }
        next d = reverse_obls_step(d);
    }
    return d.acc;
}
fn reverse_obls_step(st: OblRev) -> (result: OblRev) {
    return match st.rest { LNil => st, LCons { head: h, tail: t } => OblRev { rest: t, acc: OblList.LCons { head: h, tail: st.acc } } };
}
record OblPrepend { rest: OblList, acc: OblList }
fn append_obls<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, first: OblList, second: OblList) -> (result: OblList) {
    let rev: OblList = reverse_obls<P, N>(pages, stride, total, first);
    iterate i up_to 1024 carrying d: OblPrepend = OblPrepend { rest: rev, acc: second } {
        next d = append_obls_step(d);
    }
    return d.acc;
}
fn append_obls_step(st: OblPrepend) -> (result: OblPrepend) {
    return match st.rest { LNil => st, LCons { head: h, tail: t } => OblPrepend { rest: t, acc: OblList.LCons { head: h, tail: st.acc } } };
}
record OblCount { rest: OblList, n: u64, unknowns: u64, fails: u64 }
fn count_obls<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: OblList) -> (result: OblCount) {
    iterate i up_to 1024 carrying d: OblCount = OblCount { rest: list, n: 0, unknowns: 0, fails: 0 } {
        next d = count_obls_step(d);
    }
    return d;
}
fn count_obls_step(st: OblCount) -> (result: OblCount) {
    return match st.rest {
        LNil => st,
        LCons { head: h, tail: t } => count_obls_cons(st, h, t)
    };
}
fn count_obls_cons(st: OblCount, h: Obligation, t: OblList) -> (result: OblCount) {
    if h.status == 2 { return OblCount { rest: t, n: st.n + 1, unknowns: st.unknowns + 1, fails: st.fails }; }
    return OblCount { rest: t, n: st.n + 1, unknowns: st.unknowns, fails: st.fails + 1 };
}

// Resolved semantic types. Named carries the declaration name span;
// Seq is opaque (element validity is established at resolution; no index
// expressions exist in this subset). TPoison marks error recovery: checks
// against poison are skipped so one error does not cascade.
// Canonical callable identity bytes come from the Stage-0 module and
// declaration name scheme. Typed calls retain this exact value through SSA.
// Named semantic types still carry source spans in this profile slice and do
// not yet have project-canonical identities.
record SemanticIdentity { bytes: [byte; 512], len: u64, valid: bool }
record SemanticIdentityBuild { bytes: [byte; 512], len: u64, valid: bool }
// Signature identities retain both the declaring module and the canonical
// grant key. Owned identities are used in resolved facts; grant keys preserve
// Stage-0's effect-coverage rule, which compares declared effect/capability
// names across a call boundary without using those names to resolve symbols.
record EffectIdentity { identity: SemanticIdentity, capability_identity: SemanticIdentity, kind_key: SemanticIdentity, capability_key: SemanticIdentity }
enum EffectIdentityList { EINil, EICons { head: EffectIdentity, tail: EffectIdentityList } }
record CapabilityIdentity { identity: SemanticIdentity, key: SemanticIdentity }
enum CapabilityIdentityList { CINil, CICons { head: CapabilityIdentity, tail: CapabilityIdentityList } }
// Nominal identities are project facts keyed either by a declaration name
// span (reference=false) or by one resolved imported type-reference span
// (reference=true). The project resolver supplies the exact declaring-module
// identity; declaration proof never searches a global short-name table.
record NominalTypeIdentity { start: u64, end: u64, identity: SemanticIdentity, reference: bool }
enum NominalTypeIdentityList { NINil, NICons { head: NominalTypeIdentity, tail: NominalTypeIdentityList } }
record NominalTypeSpan { start: u64, end: u64, kind: u64 }
enum NominalTypeSpanList { NSNil, NSCons { head: NominalTypeSpan, tail: NominalTypeSpanList } }
record NominalSpanWalk { fns: FnList, records: RecordList, enums: EnumList, acc: NominalTypeSpanList }
record NominalFieldWalk { fields: FieldList, acc: NominalTypeSpanList }
record NominalVariantWalk { variants: VariantList, acc: NominalTypeSpanList }
record NominalStmtWalk { rest: StmtList, acc: NominalTypeSpanList }
fn collect_unit_nominal_type_spans<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, unit: Unit) -> (result: NominalTypeSpanList) {
    iterate i up_to 1024 carrying st: NominalSpanWalk = NominalSpanWalk { fns: unit.fns, records: unit.records, enums: unit.enums, acc: NominalTypeSpanList.NSNil } {
        next st = collect_unit_nominal_span_step<P, N>(pages, stride, total, st);
    }
    return st.acc;
}
fn collect_unit_nominal_span_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalSpanWalk) -> (result: NominalSpanWalk) {
    return match st.fns {
        DCons { head: function, tail: rest } => collect_function_nominal_spans<P, N>(pages, stride, total, st, function, rest),
        DNil => collect_record_nominal_spans<P, N>(pages, stride, total, st)
    };
}
fn collect_function_nominal_spans<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalSpanWalk, function: FnDecl, rest: FnList) -> (result: NominalSpanWalk) {
    let params: NominalTypeSpanList = collect_field_nominal_spans<P, N>(pages, stride, total, function.sig.params, st.acc);
    let results: NominalTypeSpanList = collect_field_nominal_spans<P, N>(pages, stride, total, function.sig.results, params);
    let body: NominalTypeSpanList = collect_body_nominal_spans<P, N>(pages, stride, total, function.body.body, results);
    return NominalSpanWalk { ..st, fns: rest, acc: body };
}
fn collect_body_nominal_spans<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, body: StmtList, acc: NominalTypeSpanList) -> (result: NominalTypeSpanList) {
    iterate i up_to 1024 carrying st: NominalStmtWalk = NominalStmtWalk { rest: body, acc: acc } {
        next st = collect_body_nominal_span_step<P, N>(pages, stride, total, st);
    }
    return st.acc;
}
fn collect_body_nominal_span_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalStmtWalk) -> (result: NominalStmtWalk) {
    return match st.rest {
        SNil => st,
        SCons { head: statement, tail: rest } => collect_one_body_nominal_span<P, N>(pages, stride, total, st, statement, rest)
    };
}
fn collect_one_body_nominal_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalStmtWalk, statement: Stmt, rest: StmtList) -> (result: NominalStmtWalk) {
    return match statement {
        Let { name_start: ns, name_end: ne, type_start: ts, type_end: te, type_kind: kind, value: value, start: start, end: end } => collect_let_nominal_span<P, N>(pages, stride, total, st, rest, kind, ts, te),
        If { cond: cond, then_b: then_body, else_b: else_body, start: start, end: end } => NominalStmtWalk { rest: append_stmts<P, N>(pages, stride, total, then_body, append_stmts<P, N>(pages, stride, total, else_body, rest)), acc: st.acc },
        Fail { mode_start: ms, mode_end: me, start: start, end: end } => NominalStmtWalk { rest: rest, acc: st.acc },
        Return { value: value, start: start, end: end } => NominalStmtWalk { rest: rest, acc: st.acc },
        Iterate { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, body: b, next_start: xs, next_end: xe, next_value: nv, start: start, end: end } => collect_iterate_nominal_span<P, N>(pages, stride, total, st, rest, b, tk, ts, te)
    };
}
// The carried-state annotation is a nominal use exactly like a let-type;
// the loop body queues for its own walk.
fn collect_iterate_nominal_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalStmtWalk, rest: StmtList, body: StmtList, kind: u64, start: u64, end: u64) -> (result: NominalStmtWalk) {
    let queued: StmtList = append_stmts<P, N>(pages, stride, total, body, rest);
    return collect_let_nominal_span<P, N>(pages, stride, total, st, queued, kind, start, end);
}
fn collect_let_nominal_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalStmtWalk, rest: StmtList, kind: u64, start: u64, end: u64) -> (result: NominalStmtWalk) {
    if kind == 5 || kind == 6 { return NominalStmtWalk { rest: rest, acc: NominalTypeSpanList.NSCons { head: NominalTypeSpan { start: start, end: end, kind: kind }, tail: st.acc } }; }
    if kind == 7 || kind == 8 {
        let element: TypeParse = parse_type<P, N>(pages, stride, total, start + 1);
        if element.ok && (element.node.kind == 5 || element.node.kind == 6) {
            return NominalStmtWalk { rest: rest, acc: NominalTypeSpanList.NSCons { head: NominalTypeSpan { start: element.node.start, end: element.node.end, kind: element.node.kind }, tail: st.acc } };
        }
    }
    return NominalStmtWalk { rest: rest, acc: st.acc };
}
fn collect_record_nominal_spans<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalSpanWalk) -> (result: NominalSpanWalk) {
    return match st.records {
        RCons { head: record_decl, tail: rest } => collect_one_record_nominal_spans<P, N>(pages, stride, total, st, record_decl, rest),
        RNil => collect_enum_nominal_spans<P, N>(pages, stride, total, st)
    };
}
fn collect_one_record_nominal_spans<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalSpanWalk, record_decl: RecordDecl, rest: RecordList) -> (result: NominalSpanWalk) {
    let acc: NominalTypeSpanList = collect_field_nominal_spans<P, N>(pages, stride, total, record_decl.fields, st.acc);
    return NominalSpanWalk { ..st, records: rest, acc: acc };
}
fn collect_enum_nominal_spans<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalSpanWalk) -> (result: NominalSpanWalk) {
    return match st.enums {
        GCons { head: enum_decl, tail: rest } => collect_one_enum_nominal_spans<P, N>(pages, stride, total, st, enum_decl, rest),
        GNil => st
    };
}
fn collect_one_enum_nominal_spans<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalSpanWalk, enum_decl: EnumDecl, rest: EnumList) -> (result: NominalSpanWalk) {
    let acc: NominalTypeSpanList = collect_variant_nominal_spans<P, N>(pages, stride, total, enum_decl.variants, st.acc);
    return NominalSpanWalk { ..st, enums: rest, acc: acc };
}
fn collect_variant_nominal_spans<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, variants: VariantList, acc: NominalTypeSpanList) -> (result: NominalTypeSpanList) {
    iterate i up_to 1024 carrying st: NominalVariantWalk = NominalVariantWalk { variants: variants, acc: acc } {
        next st = collect_variant_nominal_span_step<P, N>(pages, stride, total, st);
    }
    return st.acc;
}
fn collect_variant_nominal_span_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalVariantWalk) -> (result: NominalVariantWalk) {
    return match st.variants {
        VCons { head: variant, tail: rest } => NominalVariantWalk { variants: rest, acc: collect_field_nominal_spans<P, N>(pages, stride, total, variant.fields, st.acc) },
        VNil => st
    };
}
fn collect_field_nominal_spans<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList, acc: NominalTypeSpanList) -> (result: NominalTypeSpanList) {
    iterate i up_to 1024 carrying st: NominalFieldWalk = NominalFieldWalk { fields: fields, acc: acc } {
        next st = collect_field_nominal_span_step<P, N>(pages, stride, total, st);
    }
    return st.acc;
}
fn collect_field_nominal_span_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalFieldWalk) -> (result: NominalFieldWalk) {
    return match st.fields {
        FCons { head: field, tail: rest } => collect_one_field_nominal_span<P, N>(pages, stride, total, st, field, rest),
        FNil => st
    };
}
fn collect_one_field_nominal_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalFieldWalk, field: Field, rest: FieldList) -> (result: NominalFieldWalk) {
    if field.type_kind == 5 || field.type_kind == 6 {
        let reference: NominalTypeSpan = NominalTypeSpan { start: field.type_start, end: field.type_end, kind: field.type_kind };
        return NominalFieldWalk { fields: rest, acc: NominalTypeSpanList.NSCons { head: reference, tail: st.acc } };
    }
    if field.type_kind == 7 || field.type_kind == 8 { return collect_sequence_field_nominal_span<P, N>(pages, stride, total, st, field, rest); }
    return NominalFieldWalk { fields: rest, acc: st.acc };
}
fn collect_sequence_field_nominal_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalFieldWalk, field: Field, rest: FieldList) -> (result: NominalFieldWalk) {
    let element: TypeParse = parse_type<P, N>(pages, stride, total, field.type_start + 1);
    if element.ok && (element.node.kind == 5 || element.node.kind == 6) {
        return NominalFieldWalk { fields: rest, acc: NominalTypeSpanList.NSCons { head: NominalTypeSpan { start: element.node.start, end: element.node.end, kind: element.node.kind }, tail: st.acc } };
    }
    return NominalFieldWalk { fields: rest, acc: st.acc };
}
record NominalLookup { rest: NominalTypeIdentityList, found: bool, identity: SemanticIdentity }
record NominalRefLookup { rest: NominalTypeIdentityList, wanted: SemanticIdentity, found: bool, start: u64, end: u64 }
fn invalid_semantic_identity() -> (result: SemanticIdentity) {
    return SemanticIdentity { bytes: [0 as byte; 512], len: 0, valid: false };
}
fn semantic_identity_equal(a: SemanticIdentity, b: SemanticIdentity) -> (result: bool) {
    if !(a.valid) || !(b.valid) || a.len != b.len { return false; }
    iterate i over a.bytes carrying same: bool = true {
        next same = semantic_identity_equal_step(a, b, i, same);
    }
    return same;
}
fn semantic_identity_equal_step(a: SemanticIdentity, b: SemanticIdentity, i: u64, same: bool) -> (result: bool) {
    if !(same) || i >= a.len { return same; }
    return a.bytes[i] == b.bytes[i];
}
fn nominal_identity_at<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, types: NominalTypeIdentityList, start: u64, end: u64) -> (result: NominalLookup) {
    iterate i up_to 1024 carrying st: NominalLookup = NominalLookup { rest: types, found: false, identity: invalid_semantic_identity() } {
        next st = nominal_identity_at_step<P, N>(pages, stride, total, st, start, end);
    }
    return st;
}
fn nominal_identity_at_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalLookup, start: u64, end: u64) -> (result: NominalLookup) {
    if st.found { return st; }
    return match st.rest {
        NINil => st,
        NICons { head: item, tail: rest } => nominal_identity_at_cons<P, N>(pages, stride, total, st, item, rest, start, end)
    };
}
fn nominal_identity_at_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalLookup, item: NominalTypeIdentity, rest: NominalTypeIdentityList, start: u64, end: u64) -> (result: NominalLookup) {
    if item.reference && item.start == start && item.end == end && item.identity.valid {
        return NominalLookup { rest: NominalTypeIdentityList.NINil, found: true, identity: item.identity };
    }
    return NominalLookup { rest: rest, found: false, identity: st.identity };
}
fn nominal_identity_by_name<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, types: NominalTypeIdentityList, start: u64, end: u64) -> (result: NominalLookup) {
    iterate i up_to 1024 carrying st: NominalLookup = NominalLookup { rest: types, found: false, identity: invalid_semantic_identity() } {
        next st = nominal_identity_by_name_step<P, N>(pages, stride, total, st, start, end);
    }
    return st;
}
fn nominal_identity_by_name_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalLookup, start: u64, end: u64) -> (result: NominalLookup) {
    if st.found { return st; }
    return match st.rest {
        NINil => st,
        NICons { head: item, tail: rest } => nominal_identity_by_name_cons<P, N>(pages, stride, total, st, item, rest, start, end)
    };
}
fn nominal_identity_by_name_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NominalLookup, item: NominalTypeIdentity, rest: NominalTypeIdentityList, start: u64, end: u64) -> (result: NominalLookup) {
    if !(item.reference) && spans_equal<P, N>(pages, stride, total, item.start, item.end, start, end) {
        return NominalLookup { rest: NominalTypeIdentityList.NINil, found: true, identity: item.identity };
    }
    return NominalLookup { rest: rest, found: false, identity: st.identity };
}
fn nominal_reference_by_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, types: NominalTypeIdentityList, wanted: SemanticIdentity) -> (result: NominalRefLookup) {
    iterate i up_to 1024 carrying st: NominalRefLookup = NominalRefLookup { rest: types, wanted: wanted, found: false, start: 0, end: 0 } {
        next st = nominal_reference_by_identity_step(st);
    }
    return st;
}
fn nominal_reference_by_identity_step(st: NominalRefLookup) -> (result: NominalRefLookup) {
    if st.found { return st; }
    return match st.rest {
        NINil => st,
        NICons { head: item, tail: rest } => nominal_reference_by_identity_cons(st, item, rest)
    };
}
fn nominal_reference_by_identity_cons(st: NominalRefLookup, item: NominalTypeIdentity, rest: NominalTypeIdentityList) -> (result: NominalRefLookup) {
    if item.reference && semantic_identity_equal(item.identity, st.wanted) {
        return NominalRefLookup { rest: NominalTypeIdentityList.NINil, wanted: st.wanted, found: true, start: item.start, end: item.end };
    }
    return NominalRefLookup { rest: rest, wanted: st.wanted, found: false, start: st.start, end: st.end };
}

enum SemType {
    TBool,
    TByte,
    TInt { width: u64, signed: bool },
    TNamed { start: u64, end: u64 },
    TSeq,
    TSeqExact { element: SemType, length: u64, length_valid: bool },
    TPoison
}
// Required-type input for bidirectional checking: absent, or present.
enum ExpTy { XNone, XSome { ty: SemType } }
fn is_poison(ty: SemType) -> (result: bool) {
    return match ty { TPoison => true, TBool => false, TByte => false, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TSeq => false, TSeqExact { element: t, length: n, length_valid: v } => false };
}
fn sem_eq<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, a: SemType, b: SemType) -> (result: bool) {
    return match a {
        TBool => sem_eq_bool(b),
        TByte => sem_eq_byte(b),
        TInt { width: w, signed: s } => sem_eq_int(b, w, s),
        TNamed { start: s, end: e } => sem_eq_named<P, N>(pages, stride, total, b, s, e),
        TSeq => sem_eq_seq<P, N>(pages, stride, total, b),
        TSeqExact { element: element, length: length, length_valid: length_valid } => sem_eq_seq_exact<P, N>(pages, stride, total, b, element, length, length_valid),
        TPoison => sem_eq_poison(b)
    };
}
fn sem_eq_poison(b: SemType) -> (result: bool) {
    return match b { TPoison => true, TBool => false, TByte => false, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TSeq => false, TSeqExact { element: t, length: n, length_valid: v } => false };
}
fn sem_eq_bool(b: SemType) -> (result: bool) {
    return match b { TBool => true, TByte => false, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TSeq => false, TSeqExact { element: t, length: n, length_valid: v } => false, TPoison => false };
}
fn sem_eq_byte(b: SemType) -> (result: bool) {
    return match b { TBool => false, TByte => true, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TSeq => false, TSeqExact { element: t, length: n, length_valid: v } => false, TPoison => false };
}
fn sem_eq_int(b: SemType, w: u64, s: bool) -> (result: bool) {
    return match b {
        TInt { width: w2, signed: s2 } => int_eq_extra(w, w2, s, s2),
        TBool => false,
        TByte => false,
        TNamed { start: s3, end: e3 } => false,
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: length_valid } => false,
        TPoison => false
    };
}
// Boolean conjunction without `==` on booleans (Stage-0 rejects boolean
// equality, so the compiler itself cannot use it).
fn int_eq_extra(w: u64, w2: u64, s: bool, s2: bool) -> (result: bool) {
    if w != w2 { return false; }
    if s { return s2; }
    return !(s2);
}
fn sem_eq_named<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, b: SemType, start: u64, end: u64) -> (result: bool) {
    return match b {
        TNamed { start: q2, end: g2 } => spans_equal<P, N>(pages, stride, total, start, end, q2, g2),
        TBool => false,
        TByte => false,
        TInt { width: w, signed: g } => false,
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: length_valid } => false,
        TPoison => false
    };
}
fn sem_eq_seq<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, b: SemType) -> (result: bool) {
    return match b { TSeq => true, TSeqExact { element: element, length: length, length_valid: valid } => true, TBool => false, TByte => false, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TPoison => false };
}
// Exact lengths match only exact lengths, and view bounds only view bounds;
// a view never equals an exact length even when the numbers coincide.
fn seq_validity_matches(length_valid: bool, other_valid: bool) -> (result: bool) {
    if length_valid { return other_valid; }
    return !(other_valid);
}
fn sem_eq_seq_exact<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, b: SemType, element: SemType, length: u64, length_valid: bool) -> (result: bool) {
    return match b {
        TSeqExact { element: other_element, length: other_length, length_valid: other_valid } => length == other_length && sem_eq_element<P, N>(pages, stride, total, element, other_element) && seq_validity_matches(length_valid, other_valid),
        TSeq => false,
        TBool => false,
        TByte => false,
        TInt { width: w, signed: s } => false,
        TNamed { start: s, end: e } => false,
        TPoison => false
    };
}
fn sem_eq_element<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, a: SemType, b: SemType) -> (result: bool) {
    return match a {
        TBool => sem_eq_bool(b),
        TByte => sem_eq_byte(b),
        TInt { width: w, signed: s } => sem_eq_int(b, w, s),
        TNamed { start: s, end: e } => sem_eq_named<P, N>(pages, stride, total, b, s, e),
        TSeq => false,
        TSeqExact { element: e, length: n, length_valid: v } => false,
        TPoison => sem_eq_poison(b)
    };
}
// Exact-to-view borrow (Stage-0 exact_view_borrow_dimensions): an `[E; N]`
// value satisfies an `[E; up_to M]` expectation exactly when the elements
// agree and N <= M. This is the ungated borrow rule, not profile-gated
// view widen/narrow: only a statically exact actual borrows, and only
// into a bounded view expectation.
fn seq_borrow_ok<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, actual: SemType, expected: SemType) -> (result: bool) {
    return match actual {
        TSeqExact { element: element, length: length, length_valid: valid } => seq_borrow_expected<P, N>(pages, stride, total, expected, element, length, valid),
        TBool => false,
        TByte => false,
        TInt { width: w, signed: s } => false,
        TNamed { start: s, end: e } => false,
        TSeq => false,
        TPoison => false
    };
}
fn seq_borrow_expected<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, expected: SemType, element: SemType, length: u64, valid: bool) -> (result: bool) {
    if !(valid) { return false; }
    return match expected {
        TSeqExact { element: other_element, length: other_length, length_valid: other_valid } => !(other_valid) && !(length > other_length) && sem_eq_element<P, N>(pages, stride, total, element, other_element),
        TBool => false,
        TByte => false,
        TInt { width: w, signed: s } => false,
        TNamed { start: s, end: e } => false,
        TSeq => false,
        TPoison => false
    };
}
fn is_int_ty(ty: SemType) -> (result: bool) {
    return match ty { TInt { width: w, signed: s } => true, TBool => false, TByte => false, TNamed { start: s, end: e } => false, TSeq => false, TSeqExact { element: t, length: n, length_valid: v } => false, TPoison => false };
}
fn is_bool_ty(ty: SemType) -> (result: bool) {
    return match ty { TBool => true, TByte => false, TInt { width: w, signed: s } => false, TNamed { start: s, end: e } => false, TSeq => false, TSeqExact { element: t, length: n, length_valid: v } => false, TPoison => false };
}

// Lexical scopes. Bindings never leak out of a block: each if/else branch
// is checked under a pushed scope that is discarded afterward, while the
// function top level shares one scope with its parameters (Stage-0
// MNE110/MNE102 behavior). Rebinding in the same scope keeps the FIRST
// binding and records the obligation; the later declaration is dropped.
record Bind { start: u64, end: u64, ty: SemType }
enum BindList { BNil, BCons { head: Bind, tail: BindList } }
record Scope { binds: BindList }
enum ScopeStack { ZNil, ZCons { head: Scope, tail: ScopeStack } }
record LookupRes { found: bool, ty: SemType }
record ScopeLookup { rest: BindList, start: u64, end: u64, found: bool, ty: SemType }
fn scope_lookup<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, binds: BindList, start: u64, end: u64) -> (result: LookupRes) {
    iterate i up_to 1024 carrying d: ScopeLookup = ScopeLookup { rest: binds, start: start, end: end, found: false, ty: SemType.TPoison } {
        next d = scope_lookup_step<P, N>(pages, stride, total, d);
    }
    return LookupRes { found: d.found, ty: d.ty };
}
fn scope_lookup_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ScopeLookup) -> (result: ScopeLookup) {
    if st.found { return st; }
    return match st.rest {
        BNil => st,
        BCons { head: h, tail: t } => scope_lookup_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn scope_lookup_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ScopeLookup, h: Bind, t: BindList) -> (result: ScopeLookup) {
    if spans_equal<P, N>(pages, stride, total, h.start, h.end, st.start, st.end) {
        return ScopeLookup { rest: BindList.BNil, start: st.start, end: st.end, found: true, ty: h.ty };
    }
    return ScopeLookup { rest: t, start: st.start, end: st.end, found: false, ty: SemType.TPoison };
}
record EnvLookup { rest: ScopeStack, start: u64, end: u64, found: bool, ty: SemType }
fn env_lookup<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ScopeStack, start: u64, end: u64) -> (result: LookupRes) {
    iterate i up_to 1024 carrying d: EnvLookup = EnvLookup { rest: st, start: start, end: end, found: false, ty: SemType.TPoison } {
        next d = env_lookup_step<P, N>(pages, stride, total, d);
    }
    return LookupRes { found: d.found, ty: d.ty };
}
fn env_lookup_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: EnvLookup) -> (result: EnvLookup) {
    if st.found { return st; }
    return match st.rest {
        ZNil => st,
        ZCons { head: h, tail: t } => env_lookup_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn env_lookup_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: EnvLookup, h: Scope, t: ScopeStack) -> (result: EnvLookup) {
    let got: LookupRes = scope_lookup<P, N>(pages, stride, total, h.binds, st.start, st.end);
    if got.found { return EnvLookup { rest: ScopeStack.ZNil, start: st.start, end: st.end, found: true, ty: got.ty }; }
    return EnvLookup { rest: t, start: st.start, end: st.end, found: false, ty: SemType.TPoison };
}
record BindRes { dup: bool, stack: ScopeStack }
fn env_bind_current<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ScopeStack, start: u64, end: u64, ty: SemType) -> (result: BindRes) {
    return match st {
        ZNil => BindRes { dup: false, stack: ScopeStack.ZCons { head: Scope { binds: BindList.BCons { head: Bind { start: start, end: end, ty: ty }, tail: BindList.BNil } }, tail: ScopeStack.ZNil } },
        ZCons { head: h, tail: t } => env_bind_scope<P, N>(pages, stride, total, h, t, start, end, ty)
    };
}
fn env_bind_scope<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, h: Scope, t: ScopeStack, start: u64, end: u64, ty: SemType) -> (result: BindRes) {
    let got: LookupRes = scope_lookup<P, N>(pages, stride, total, h.binds, start, end);
    if got.found { return BindRes { dup: true, stack: ScopeStack.ZCons { head: h, tail: t } }; }
    return BindRes { dup: false, stack: ScopeStack.ZCons { head: Scope { binds: BindList.BCons { head: Bind { start: start, end: end, ty: ty }, tail: h.binds } }, tail: t } };
}
fn push_scope(st: ScopeStack) -> (result: ScopeStack) {
    return ScopeStack.ZCons { head: Scope { binds: BindList.BNil }, tail: st };
}

// Extended integer spellings (u8/u16/u32/i8/i16/i32/i64) arrive as named
// type references; anything else falls through to record/enum resolution
// by returning the name itself as a TNamed candidate.
fn scalar_sem<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: SemType) {
    if end < start { return SemType.TNamed { start: start, end: end }; }
    if end - start < 2 || end - start > 3 { return SemType.TNamed { start: start, end: end }; }
    let b0: u64 = segment.byte_at_global<P, N>(pages, stride, total, start);
    if b0 != 117 && b0 != 105 { return SemType.TNamed { start: start, end: end }; }
    if !(span_digits<P, N>(pages, stride, total, start + 1, end)) { return SemType.TNamed { start: start, end: end }; }
    let val: IntVal = int_value<P, N>(pages, stride, total, start + 1, end);
    if val.overflow { return SemType.TNamed { start: start, end: end }; }
    if val.value == 8 || val.value == 16 || val.value == 32 || val.value == 64 {
        return SemType.TInt { width: val.value, signed: b0 == 105 };
    }
    return SemType.TNamed { start: start, end: end };
}
record DigitCheck { pos: u64, end: u64, ok: bool }
fn span_digits<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: bool) {
    iterate i up_to 1024 carrying d: DigitCheck = DigitCheck { pos: start, end: end, ok: true } {
        next d = span_digits_step<P, N>(pages, stride, total, d);
    }
    return d.ok && d.pos >= d.end;
}
fn span_digits_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: DigitCheck) -> (result: DigitCheck) {
    if !(st.ok) || st.pos >= st.end { return st; }
    let byte: u64 = segment.byte_at_global<P, N>(pages, stride, total, st.pos);
    if byte < 48 || byte > 57 { return DigitCheck { pos: st.pos, end: st.end, ok: false }; }
    return DigitCheck { pos: st.pos + 1, end: st.end, ok: true };
}
// Type resolution against scalar spellings, local declarations, and the
// exact imported nominal reference spans supplied by project resolution.
record TyRes { ty: SemType, ok: bool }
fn resolve_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, kind: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: TyRes) {
    if kind == 3 { return TyRes { ty: SemType.TBool, ok: true }; }
    if kind == 4 { return TyRes { ty: SemType.TByte, ok: true }; }
    if kind == 1 { return TyRes { ty: SemType.TInt { width: 64, signed: false }, ok: true }; }
    if kind == 2 { return TyRes { ty: SemType.TInt { width: 64, signed: true }, ok: true }; }
    if kind == 6 {
        let found: NominalLookup = nominal_identity_at<P, N>(pages, stride, total, nominals, start, end);
        if found.found { return TyRes { ty: SemType.TNamed { start: start, end: end }, ok: true }; }
        return TyRes { ty: SemType.TPoison, ok: false };
    }
    if kind == 7 || kind == 8 { return resolve_seq_type<P, N>(pages, stride, total, kind, start, end, rectab, enumtab, nominals); }
    if kind == 5 {
        let local: TyRes = resolve_named_type<P, N>(pages, stride, total, start, end, rectab, enumtab);
        if local.ok { return local; }
        let imported: NominalLookup = nominal_identity_at<P, N>(pages, stride, total, nominals, start, end);
        if imported.found { return TyRes { ty: SemType.TNamed { start: start, end: end }, ok: true }; }
        return local;
    }
    return TyRes { ty: SemType.TPoison, ok: false };
}
fn resolve_seq_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, kind: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: TyRes) {
    let elem: TypeParse = parse_type<P, N>(pages, stride, total, start + 1);
    if !(elem.ok) { return TyRes { ty: SemType.TPoison, ok: false }; }
    // No back-call into resolve_type (MNE130): sequence elements are flat
    // by construction (the parser rejects nested `[`). Exact bounds and
    // element types are retained for repeat-literal proof; viewed sequences
    // keep their bound ceiling with length_valid=false (views are bounded
    // but not statically exact), so operation bounds and view equality can
    // observe the ceiling. Non-literal view bounds stay opaque (TSeq).
    if kind == 8 { return resolve_view_type<P, N>(pages, stride, total, elem, rectab, enumtab, nominals); }
    let element: TyRes = resolve_sequence_element<P, N>(pages, stride, total, elem.node, rectab, enumtab, nominals);
    if !(element.ok) { return element; }
    let semi: Expect = expect<P, N>(pages, stride, total, elem.cursor, 63);
    if !(semi.ok) { return TyRes { ty: SemType.TPoison, ok: false }; }
    let bound: NameParse = seq_bound<P, N>(pages, stride, total, semi.cursor);
    if !(bound.ok) { return TyRes { ty: SemType.TPoison, ok: false }; }
    let close: Expect = expect<P, N>(pages, stride, total, bound.cursor, 70);
    if !(close.ok) { return TyRes { ty: SemType.TPoison, ok: false }; }
    let literal_bound: bool = span_digits<P, N>(pages, stride, total, bound.start, bound.end);
    let length: IntVal = int_value<P, N>(pages, stride, total, bound.start, bound.end);
    return TyRes { ty: SemType.TSeqExact { element: element.ty, length: length.value, length_valid: literal_bound && !(length.overflow) }, ok: true };
}
// Viewed sequences (`[byte; up_to 64]`): the element resolves as usual and
// the ceiling comes from the digit run after the `up_to` keyword. The
// parser guarantees the keyword prefix for kind 8; a missing or
// non-literal bound (Nat identifier, overflow) stays opaque.
fn resolve_view_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, elem: TypeParse, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: TyRes) {
    let element: TyRes = resolve_sequence_element<P, N>(pages, stride, total, elem.node, rectab, enumtab, nominals);
    if !(element.ok) { return element; }
    let semi: Expect = expect<P, N>(pages, stride, total, elem.cursor, 63);
    if !(semi.ok) { return TyRes { ty: SemType.TPoison, ok: false }; }
    let bound: NameParse = seq_bound<P, N>(pages, stride, total, semi.cursor);
    if !(bound.ok) { return TyRes { ty: SemType.TPoison, ok: false }; }
    let close: Expect = expect<P, N>(pages, stride, total, bound.cursor, 70);
    if !(close.ok) { return TyRes { ty: SemType.TPoison, ok: false }; }
    return resolve_view_bound<P, N>(pages, stride, total, element.ty, bound.start, bound.end);
}
fn resolve_view_bound<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, element: SemType, start: u64, end: u64) -> (result: TyRes) {
    let digits: UpToDigits = up_to_digits<P, N>(pages, stride, total, start, end);
    if !(digits.ok) { return TyRes { ty: SemType.TSeq, ok: true }; }
    let length: IntVal = int_value<P, N>(pages, stride, total, digits.start, digits.end);
    if length.overflow { return TyRes { ty: SemType.TSeq, ok: true }; }
    return TyRes { ty: SemType.TSeqExact { element: element, length: length.value, length_valid: false }, ok: true };
}
record UpToDigits { ok: bool, start: u64, end: u64 }
record UpToScan { cursor: u64, end: u64, ok: bool }
fn up_to_digits<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: UpToDigits) {
    if end < start + 6 { return UpToDigits { ok: false, start: start, end: end }; }
    iterate i up_to 1024 carrying st: UpToScan = UpToScan { cursor: start + 5, end: end, ok: true } {
        next st = up_to_space_step<P, N>(pages, stride, total, st);
    }
    if !(st.ok) || !(st.cursor < st.end) { return UpToDigits { ok: false, start: start, end: end }; }
    if !(span_digits<P, N>(pages, stride, total, st.cursor, st.end)) { return UpToDigits { ok: false, start: start, end: end }; }
    return UpToDigits { ok: true, start: st.cursor, end: st.end };
}
fn up_to_space_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: UpToScan) -> (result: UpToScan) {
    if !(st.ok) || !(st.cursor < st.end) { return st; }
    if lexer.space(segment.byte_at_global<P, N>(pages, stride, total, st.cursor)) { return UpToScan { cursor: st.cursor + 1, end: st.end, ok: true }; }
    return UpToScan { cursor: st.cursor, end: st.end, ok: true };
}
fn resolve_sequence_element<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, element: TypeRef, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: TyRes) {
    if element.kind == 1 { return TyRes { ty: SemType.TInt { width: 64, signed: false }, ok: true }; }
    if element.kind == 2 { return TyRes { ty: SemType.TInt { width: 64, signed: true }, ok: true }; }
    if element.kind == 3 { return TyRes { ty: SemType.TBool, ok: true }; }
    if element.kind == 4 { return TyRes { ty: SemType.TByte, ok: true }; }
    if element.kind == 5 { return resolve_seq_elem<P, N>(pages, stride, total, element.start, element.end, rectab, enumtab, nominals); }
    if element.kind == 6 {
        let imported: NominalLookup = nominal_identity_at<P, N>(pages, stride, total, nominals, element.start, element.end);
        if imported.found { return TyRes { ty: SemType.TNamed { start: element.start, end: element.end }, ok: true }; }
        return TyRes { ty: SemType.TPoison, ok: false };
    }
    return TyRes { ty: SemType.TPoison, ok: false };
}
fn resolve_seq_elem<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: TyRes) {
    let inner: TyRes = resolve_named_type<P, N>(pages, stride, total, start, end, rectab, enumtab);
    if !(inner.ok) {
        let imported: NominalLookup = nominal_identity_at<P, N>(pages, stride, total, nominals, start, end);
        if imported.found { return TyRes { ty: SemType.TNamed { start: start, end: end }, ok: true }; }
        return TyRes { ty: SemType.TPoison, ok: false };
    }
    return inner;
}
fn resolve_named_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList) -> (result: TyRes) {
    let sc: SemType = scalar_sem<P, N>(pages, stride, total, start, end);
    return match sc {
        TNamed { start: n, end: m } => resolve_declared_type<P, N>(pages, stride, total, n, m, rectab, enumtab),
        TBool => TyRes { ty: SemType.TBool, ok: true },
        TByte => TyRes { ty: SemType.TByte, ok: true },
        TInt { width: w, signed: g } => TyRes { ty: SemType.TInt { width: w, signed: g }, ok: true },
        TSeq => TyRes { ty: SemType.TSeq, ok: true },
        TSeqExact { element: element, length: length, length_valid: valid } => TyRes { ty: SemType.TSeqExact { element: element, length: length, length_valid: valid }, ok: true },
        TPoison => TyRes { ty: SemType.TPoison, ok: false }
    };
}
fn resolve_declared_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList) -> (result: TyRes) {
    if record_declared<P, N>(pages, stride, total, rectab, start, end) { return TyRes { ty: SemType.TNamed { start: start, end: end }, ok: true }; }
    if enum_declared<P, N>(pages, stride, total, enumtab, start, end) { return TyRes { ty: SemType.TNamed { start: start, end: end }, ok: true }; }
    return TyRes { ty: SemType.TPoison, ok: false };
}
fn record_declared<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, rectab: RecordList, start: u64, end: u64) -> (result: bool) {
    let empty: bool = match rectab { RNil => true, RCons { head: h, tail: t } => false };
    if empty { return false; }
    iterate i up_to 1024 carrying d: RecScan = RecScan { rest: rectab, start: start, end: end, found: false } {
        let exhausted: bool = match d.rest { RNil => true, RCons { head: h, tail: t } => false };
        if exhausted { return d.found; }
        next d = record_declared_step<P, N>(pages, stride, total, d);
    }
    return d.found;
}
record RecScan { rest: RecordList, start: u64, end: u64, found: bool }
fn record_declared_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecScan) -> (result: RecScan) {
    if st.found { return st; }
    return match st.rest {
        RNil => st,
        RCons { head: h, tail: t } => record_declared_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn record_declared_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecScan, h: RecordDecl, t: RecordList) -> (result: RecScan) {
    if spans_equal<P, N>(pages, stride, total, h.name_start, h.name_end, st.start, st.end) {
        return RecScan { rest: RecordList.RNil, start: st.start, end: st.end, found: true };
    }
    return RecScan { rest: t, start: st.start, end: st.end, found: false };
}
fn enum_declared<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, enumtab: EnumList, start: u64, end: u64) -> (result: bool) {
    let empty: bool = match enumtab { GNil => true, GCons { head: h, tail: t } => false };
    if empty { return false; }
    iterate i up_to 1024 carrying d: EnumScan = EnumScan { rest: enumtab, start: start, end: end, found: false } {
        let exhausted: bool = match d.rest { GNil => true, GCons { head: h, tail: t } => false };
        if exhausted { return d.found; }
        next d = enum_declared_step<P, N>(pages, stride, total, d);
    }
    return d.found;
}
record EnumScan { rest: EnumList, start: u64, end: u64, found: bool }
fn enum_declared_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: EnumScan) -> (result: EnumScan) {
    if st.found { return st; }
    return match st.rest {
        GNil => st,
        GCons { head: h, tail: t } => enum_declared_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn enum_declared_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: EnumScan, h: EnumDecl, t: EnumList) -> (result: EnumScan) {
    if spans_equal<P, N>(pages, stride, total, h.name_start, h.name_end, st.start, st.end) {
        return EnumScan { rest: EnumList.GNil, start: st.start, end: st.end, found: true };
    }
    return EnumScan { rest: t, start: st.start, end: st.end, found: false };
}

// Function signatures: parameter/result type validity, exactly-one-result,
// capability declaration with keep-first duplicate handling, effect
// authority against declared capabilities, and contract clauses recorded
// as retained UNKNOWN assumptions (Stage-0 never rejects them, not even
// for undeclared names or mismatched arities).
// Canonical Stage-0 callable identity bytes are produced in the compiler and
// carried with the typed call. The fixed capacity is an explicit boundary;
// overflow fails closed and never falls back to source-slot/span identity.
fn callable_identity_byte(st: SemanticIdentityBuild, value: byte) -> (result: SemanticIdentityBuild) {
    if !(st.valid) || st.len >= 512 { return SemanticIdentityBuild { ..st, valid: false }; }
    return SemanticIdentityBuild { ..st, bytes: replace(st.bytes, st.len, value), len: st.len + 1 };
}
fn callable_identity_span_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemanticIdentityBuild, pos: u64, start: u64, end: u64) -> (result: SemanticIdentityBuild) {
    if !(st.valid) || pos < start || pos >= end { return st; }
    return callable_identity_byte(st, source.byte_at_global<P, N>(pages, stride, total, pos) as byte);
}
fn callable_identity_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemanticIdentityBuild, start: u64, end: u64) -> (result: SemanticIdentityBuild) {
    if end < start || end > total { return SemanticIdentityBuild { ..st, valid: false }; }
    iterate i up_to 1024 carrying d: SemanticIdentityBuild = st {
        next d = callable_identity_span_step<P, N>(pages, stride, total, d, i, start, end);
    }
    return d;
}
fn canonical_function_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, module_start: u64, module_end: u64, function_start: u64, function_end: u64) -> (result: SemanticIdentity) {
    let prefix: [byte; 18] = [109 as byte, 110 as byte, 99 as byte, 115 as byte, 58 as byte, 48 as byte, 46 as byte, 50 as byte, 58 as byte, 102 as byte, 117 as byte, 110 as byte, 99 as byte, 116 as byte, 105 as byte, 111 as byte, 110 as byte, 58 as byte];
    let seed: SemanticIdentityBuild = SemanticIdentityBuild { bytes: [0 as byte; 512], len: 0, valid: true };
    iterate i over prefix carrying d: SemanticIdentityBuild = seed {
        next d = callable_identity_byte(d, prefix[i]);
    }
    let module_part: SemanticIdentityBuild = callable_identity_span<P, N>(pages, stride, total, d, module_start, module_end);
    let sep1: SemanticIdentityBuild = callable_identity_byte(module_part, 58 as byte);
    let sep2: SemanticIdentityBuild = callable_identity_byte(sep1, 58 as byte);
    let function_part: SemanticIdentityBuild = callable_identity_span<P, N>(pages, stride, total, sep2, function_start, function_end);
    return SemanticIdentity { bytes: function_part.bytes, len: function_part.len, valid: function_part.valid && module_end > module_start && function_end > function_start };
}


fn canonical_effect_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, module_start: u64, module_end: u64, name_start: u64, name_end: u64) -> (result: SemanticIdentity) {
    let prefix: [byte; 16] = [109 as byte, 110 as byte, 99 as byte, 115 as byte, 58 as byte, 48 as byte, 46 as byte, 50 as byte, 58 as byte, 101 as byte, 102 as byte, 102 as byte, 101 as byte, 99 as byte, 116 as byte, 58 as byte];
    let seed: SemanticIdentityBuild = SemanticIdentityBuild { bytes: [0 as byte; 512], len: 0, valid: true };
    iterate i over prefix carrying d: SemanticIdentityBuild = seed { next d = callable_identity_byte(d, prefix[i]); }
    let owner_bytes: SemanticIdentityBuild = callable_identity_span<P, N>(pages, stride, total, d, module_start, module_end);
    let sep1: SemanticIdentityBuild = callable_identity_byte(owner_bytes, 58 as byte);
    let sep2: SemanticIdentityBuild = callable_identity_byte(sep1, 58 as byte);
    let name: SemanticIdentityBuild = identity_component_span<P, N>(pages, stride, total, sep2, name_start, name_end);
    return SemanticIdentity { bytes: name.bytes, len: name.len, valid: name.valid && module_end > module_start && name_end > name_start };
}
fn canonical_capability_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, module_start: u64, module_end: u64, name_start: u64, name_end: u64) -> (result: SemanticIdentity) {
    let prefix: [byte; 20] = [109 as byte, 110 as byte, 99 as byte, 115 as byte, 58 as byte, 48 as byte, 46 as byte, 50 as byte, 58 as byte, 99 as byte, 97 as byte, 112 as byte, 97 as byte, 98 as byte, 105 as byte, 108 as byte, 105 as byte, 116 as byte, 121 as byte, 58 as byte];
    let seed: SemanticIdentityBuild = SemanticIdentityBuild { bytes: [0 as byte; 512], len: 0, valid: true };
    iterate i over prefix carrying d: SemanticIdentityBuild = seed { next d = callable_identity_byte(d, prefix[i]); }
    let owner_bytes: SemanticIdentityBuild = callable_identity_span<P, N>(pages, stride, total, d, module_start, module_end);
    let sep1: SemanticIdentityBuild = callable_identity_byte(owner_bytes, 58 as byte);
    let sep2: SemanticIdentityBuild = callable_identity_byte(sep1, 58 as byte);
    let name: SemanticIdentityBuild = identity_component_span<P, N>(pages, stride, total, sep2, name_start, name_end);
    return SemanticIdentity { bytes: name.bytes, len: name.len, valid: name.valid && module_end > module_start && name_end > name_start };
}
// These component keys are compared only while checking whether a caller's
// declared grant covers an imported effect. They never resolve an imported
// declaration; the full owner-qualified identities above remain on the IR.
fn signature_name_key<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: SemanticIdentity) {
    let seed: SemanticIdentityBuild = SemanticIdentityBuild { bytes: [0 as byte; 512], len: 0, valid: true };
    let key: SemanticIdentityBuild = identity_component_span<P, N>(pages, stride, total, seed, start, end);
    return SemanticIdentity { bytes: key.bytes, len: key.len, valid: key.valid && end > start };
}
record EffectIdentityBuild { rest: EffectList, acc: EffectIdentityList, module_start: u64, module_end: u64 }
fn canonical_effect_identities<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, module_start: u64, module_end: u64, effects: EffectList) -> (result: EffectIdentityList) {
    iterate i up_to 1024 carrying st: EffectIdentityBuild = EffectIdentityBuild { rest: effects, acc: EffectIdentityList.EINil, module_start: module_start, module_end: module_end } { next st = canonical_effect_identity_step<P, N>(pages, stride, total, st); }
    return st.acc;
}
fn canonical_effect_identity_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: EffectIdentityBuild) -> (result: EffectIdentityBuild) {
    return match st.rest { XNil => st, XCons { head: effect_fact, tail: rest } => canonical_effect_identity_one<P, N>(pages, stride, total, st, effect_fact, rest) };
}
fn canonical_effect_identity_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: EffectIdentityBuild, effect_fact: Effect, rest: EffectList) -> (result: EffectIdentityBuild) {
    let identity: SemanticIdentity = canonical_effect_identity<P, N>(pages, stride, total, st.module_start, st.module_end, effect_fact.kind_start, effect_fact.kind_end);
    let capability_identity: SemanticIdentity = canonical_capability_identity<P, N>(pages, stride, total, st.module_start, st.module_end, effect_fact.cap_start, effect_fact.cap_end);
    let item: EffectIdentity = EffectIdentity { identity: identity, capability_identity: capability_identity, kind_key: signature_name_key<P, N>(pages, stride, total, effect_fact.kind_start, effect_fact.kind_end), capability_key: signature_name_key<P, N>(pages, stride, total, effect_fact.cap_start, effect_fact.cap_end) };
    return EffectIdentityBuild { ..st, rest: rest, acc: EffectIdentityList.EICons { head: item, tail: st.acc } };
}
record CapabilityIdentityBuild { rest: CapList, acc: CapabilityIdentityList, module_start: u64, module_end: u64 }
fn canonical_capability_identities<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, module_start: u64, module_end: u64, capabilities: CapList) -> (result: CapabilityIdentityList) {
    iterate i up_to 1024 carrying st: CapabilityIdentityBuild = CapabilityIdentityBuild { rest: capabilities, acc: CapabilityIdentityList.CINil, module_start: module_start, module_end: module_end } { next st = canonical_capability_identity_step<P, N>(pages, stride, total, st); }
    return st.acc;
}
fn canonical_capability_identity_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CapabilityIdentityBuild) -> (result: CapabilityIdentityBuild) {
    return match st.rest { ANil => st, ACons { head: cap, tail: rest } => canonical_capability_identity_one<P, N>(pages, stride, total, st, cap, rest) };
}
fn canonical_capability_identity_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CapabilityIdentityBuild, cap: Cap, rest: CapList) -> (result: CapabilityIdentityBuild) {
    let item: CapabilityIdentity = CapabilityIdentity { identity: canonical_capability_identity<P, N>(pages, stride, total, st.module_start, st.module_end, cap.start, cap.end), key: signature_name_key<P, N>(pages, stride, total, cap.start, cap.end) };
    return CapabilityIdentityBuild { ..st, rest: rest, acc: CapabilityIdentityList.CICons { head: item, tail: st.acc } };
}
record CapabilityIdentityLookup { rest: CapabilityIdentityList, identity: SemanticIdentity, found: bool }
fn capability_identity_contains<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, capabilities: CapabilityIdentityList, identity: SemanticIdentity) -> (result: bool) {
    iterate i up_to 1024 carrying st: CapabilityIdentityLookup = CapabilityIdentityLookup { rest: capabilities, identity: identity, found: false } { next st = capability_identity_lookup_step(st); }
    return st.found;
}
fn capability_identity_lookup_step(st: CapabilityIdentityLookup) -> (result: CapabilityIdentityLookup) {
    if st.found { return st; }
    return match st.rest { CapabilityIdentityList.CINil => st, CapabilityIdentityList.CICons { head: item, tail: rest } => capability_identity_lookup_one(st, item, rest) };
}
fn capability_identity_lookup_one(st: CapabilityIdentityLookup, item: CapabilityIdentity, rest: CapabilityIdentityList) -> (result: CapabilityIdentityLookup) {
    if semantic_identity_equal(item.identity, st.identity) { return CapabilityIdentityLookup { rest: CapabilityIdentityList.CINil, identity: st.identity, found: true }; }
    return CapabilityIdentityLookup { ..st, rest: rest };
}
record CapabilityIdentityValidation { rest: CapabilityIdentityList, ok: bool }
fn capability_identity_list_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, capabilities: CapabilityIdentityList) -> (result: bool) {
    iterate i up_to 1024 carrying st: CapabilityIdentityValidation = CapabilityIdentityValidation { rest: capabilities, ok: true } { next st = capability_identity_valid_step(st); }
    return st.ok;
}
fn capability_identity_valid_step(st: CapabilityIdentityValidation) -> (result: CapabilityIdentityValidation) {
    if !(st.ok) { return st; }
    return match st.rest { CapabilityIdentityList.CINil => st, CapabilityIdentityList.CICons { head: item, tail: rest } => CapabilityIdentityValidation { rest: rest, ok: item.identity.valid && item.identity.len > 0 && item.key.valid && item.key.len > 0 } };
}
record SignatureIdentityValidation { rest: EffectIdentityList, capabilities: CapabilityIdentityList, ok: bool }
fn signature_identity_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, effects: EffectIdentityList, capabilities: CapabilityIdentityList) -> (result: bool) {
    iterate i up_to 1024 carrying st: SignatureIdentityValidation = SignatureIdentityValidation { rest: effects, capabilities: capabilities, ok: capability_identity_list_valid<P, N>(pages, stride, total, capabilities) } { next st = signature_identity_valid_step<P, N>(pages, stride, total, st); }
    return st.ok;
}
fn signature_identity_valid_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SignatureIdentityValidation) -> (result: SignatureIdentityValidation) {
    if !(st.ok) { return st; }
    return match st.rest { EffectIdentityList.EINil => st, EffectIdentityList.EICons { head: item, tail: rest } => SignatureIdentityValidation { rest: rest, capabilities: st.capabilities, ok: item.identity.valid && item.identity.len > 0 && item.capability_identity.valid && item.capability_identity.len > 0 && item.kind_key.valid && item.kind_key.len > 0 && item.capability_key.valid && item.capability_key.len > 0 && capability_identity_contains<P, N>(pages, stride, total, st.capabilities, item.capability_identity) } };
}
record EffectCoverageLookup { rest: EffectIdentityList, want: EffectIdentity, found: bool }
fn effect_identity_covered<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, available: EffectIdentityList, want: EffectIdentity) -> (result: bool) {
    iterate i up_to 1024 carrying st: EffectCoverageLookup = EffectCoverageLookup { rest: available, want: want, found: false } { next st = effect_coverage_lookup_step(st); }
    return st.found;
}
fn effect_coverage_lookup_step(st: EffectCoverageLookup) -> (result: EffectCoverageLookup) {
    if st.found { return st; }
    return match st.rest { EffectIdentityList.EINil => st, EffectIdentityList.EICons { head: item, tail: rest } => effect_coverage_lookup_one(st, item, rest) };
}
fn effect_coverage_lookup_one(st: EffectCoverageLookup, item: EffectIdentity, rest: EffectIdentityList) -> (result: EffectCoverageLookup) {
    if semantic_identity_equal(item.kind_key, st.want.kind_key) && semantic_identity_equal(item.capability_key, st.want.capability_key) { return EffectCoverageLookup { rest: EffectIdentityList.EINil, want: st.want, found: true }; }
    return EffectCoverageLookup { ..st, rest: rest };
}
record EffectNeedScan { rest: EffectIdentityList, ok: bool }
fn effects_covered<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, available: EffectIdentityList, need: EffectIdentityList) -> (result: bool) {
    iterate i up_to 1024 carrying st: EffectNeedScan = EffectNeedScan { rest: need, ok: true } { next st = effects_covered_step<P, N>(pages, stride, total, available, st); }
    return st.ok;
}
fn effects_covered_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, available: EffectIdentityList, st: EffectNeedScan) -> (result: EffectNeedScan) {
    if !(st.ok) { return st; }
    return match st.rest { EffectIdentityList.EINil => st, EffectIdentityList.EICons { head: effect_fact, tail: rest } => EffectNeedScan { rest: rest, ok: effect_identity_covered<P, N>(pages, stride, total, available, effect_fact) } };
}

// Stage-0 semantic identities encode each identity component independently.
// Record field descriptors form one component and are sorted by field name,
// matching mncs-model's record_type_id contract.
fn identity_hex_digit(value: u64) -> (result: byte) {
    if value < 10 { return (48 + value) as byte; }
    return (55 + value) as byte;
}
fn identity_component_byte(st: SemanticIdentityBuild, value: byte) -> (result: SemanticIdentityBuild) {
    let raw: u64 = value as u64;
    if (raw >= 97 && raw <= 122) || (raw >= 65 && raw <= 90) || (raw >= 48 && raw <= 57) || raw == 95 || raw == 45 || raw == 46 {
        return callable_identity_byte(st, value);
    }
    let pct: SemanticIdentityBuild = callable_identity_byte(st, 37 as byte);
    let high: SemanticIdentityBuild = callable_identity_byte(pct, identity_hex_digit(raw / 16));
    return callable_identity_byte(high, identity_hex_digit(raw % 16));
}
record IdentityComponentSpan { pos: u64, end: u64, build: SemanticIdentityBuild }
fn identity_component_span_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: IdentityComponentSpan) -> (result: IdentityComponentSpan) {
    if !(st.build.valid) || st.pos >= st.end { return st; }
    return IdentityComponentSpan { ..st, pos: st.pos + 1, build: identity_component_byte(st.build, source.byte_at_global<P, N>(pages, stride, total, st.pos) as byte) };
}
fn identity_component_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemanticIdentityBuild, start: u64, end: u64) -> (result: SemanticIdentityBuild) {
    if end < start || end > total { return SemanticIdentityBuild { ..st, valid: false }; }
    iterate i up_to 1024 carrying d: IdentityComponentSpan = IdentityComponentSpan { pos: start, end: end, build: st } {
        next d = identity_component_span_step<P, N>(pages, stride, total, d);
    }
    return d.build;
}
fn identity_component_raw_byte(st: SemanticIdentityBuild, value: byte) -> (result: SemanticIdentityBuild) {
    return identity_component_byte(st, value);
}
fn field_list_empty(fields: FieldList) -> (result: bool) {
    return match fields { FNil => true, FCons { head: head, tail: tail } => false };
}
record FieldNameOrder { left: Field, right: Field, offset: u64, order: u64, done: bool }
fn field_name_order<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, left: Field, right: Field) -> (result: u64) {
    iterate i up_to 1024 carrying st: FieldNameOrder = FieldNameOrder { left: left, right: right, offset: 0, order: 0, done: false } {
        next st = field_name_order_step<P, N>(pages, stride, total, st);
    }
    if st.done { return st.order; }
    let left_len: u64 = left.name_end - left.name_start;
    let right_len: u64 = right.name_end - right.name_start;
    if left_len < right_len { return 1; }
    if left_len > right_len { return 2; }
    return 0;
}
fn field_name_order_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldNameOrder) -> (result: FieldNameOrder) {
    if st.done { return st; }
    let left_len: u64 = st.left.name_end - st.left.name_start;
    let right_len: u64 = st.right.name_end - st.right.name_start;
    if st.offset >= left_len || st.offset >= right_len {
        if left_len < right_len { return FieldNameOrder { ..st, order: 1, done: true }; }
        if left_len > right_len { return FieldNameOrder { ..st, order: 2, done: true }; }
        return FieldNameOrder { ..st, done: true };
    }
    let left_byte: u64 = source.byte_at_global<P, N>(pages, stride, total, st.left.name_start + st.offset);
    let right_byte: u64 = source.byte_at_global<P, N>(pages, stride, total, st.right.name_start + st.offset);
    if left_byte < right_byte { return FieldNameOrder { ..st, order: 1, done: true }; }
    if left_byte > right_byte { return FieldNameOrder { ..st, order: 2, done: true }; }
    return FieldNameOrder { ..st, offset: st.offset + 1 };
}
record FieldMinScan { rest: FieldList, found: bool, best: Field }
fn field_min<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList) -> (result: FieldMinScan) {
    iterate i up_to 1024 carrying st: FieldMinScan = FieldMinScan { rest: fields, found: false, best: Field { name_start: 0, name_end: 0, type_start: 0, type_end: 0, type_kind: 9 } } {
        if field_list_empty(st.rest) { return st; }
        next st = field_min_step<P, N>(pages, stride, total, st);
    }
    return st;
}
fn field_min_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldMinScan) -> (result: FieldMinScan) {
    return match st.rest {
        FNil => st,
        FCons { head: field, tail: rest } => field_min_cons<P, N>(pages, stride, total, st, field, rest)
    };
}
fn field_min_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldMinScan, field: Field, rest: FieldList) -> (result: FieldMinScan) {
    if !(st.found) { return FieldMinScan { rest: rest, found: true, best: field }; }
    if field_name_order<P, N>(pages, stride, total, field, st.best) == 1 { return FieldMinScan { rest: rest, found: true, best: field }; }
    return FieldMinScan { rest: rest, found: true, best: st.best };
}
record FieldRemove { rest: FieldList, reversed: FieldList, target: Field, removed: bool }
fn remove_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList, target: Field) -> (result: FieldList) {
    iterate i up_to 1024 carrying st: FieldRemove = FieldRemove { rest: fields, reversed: FieldList.FNil, target: target, removed: false } {
        if field_list_empty(st.rest) { return reverse_fields<P, N>(pages, stride, total, st.reversed); }
        next st = remove_field_step<P, N>(pages, stride, total, st);
    }
    return reverse_fields<P, N>(pages, stride, total, st.reversed);
}
fn remove_field_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldRemove) -> (result: FieldRemove) {
    return match st.rest {
        FNil => st,
        FCons { head: field, tail: rest } => remove_field_cons<P, N>(pages, stride, total, st, field, rest)
    };
}
fn remove_field_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldRemove, field: Field, rest: FieldList) -> (result: FieldRemove) {
    if !(st.removed) && spans_equal<P, N>(pages, stride, total, field.name_start, field.name_end, st.target.name_start, st.target.name_end) {
        return FieldRemove { rest: rest, reversed: st.reversed, target: st.target, removed: true };
    }
    return FieldRemove { rest: rest, reversed: FieldList.FCons { head: field, tail: st.reversed }, target: st.target, removed: st.removed };
}
fn append_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList, value: Field) -> (result: FieldList) {
    let reversed: FieldList = reverse_fields<P, N>(pages, stride, total, fields);
    return reverse_fields<P, N>(pages, stride, total, FieldList.FCons { head: value, tail: reversed });
}
record FieldSort { rest: FieldList, sorted: FieldList }
fn sort_fields_by_name<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList) -> (result: FieldList) {
    iterate i up_to 1024 carrying st: FieldSort = FieldSort { rest: fields, sorted: FieldList.FNil } {
        if field_list_empty(st.rest) { return st.sorted; }
        next st = sort_fields_step<P, N>(pages, stride, total, st);
    }
    return st.sorted;
}
fn sort_fields_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldSort) -> (result: FieldSort) {
    let minimum: FieldMinScan = field_min<P, N>(pages, stride, total, st.rest);
    if !(minimum.found) { return FieldSort { rest: FieldList.FNil, sorted: st.sorted }; }
    let rest: FieldList = remove_field<P, N>(pages, stride, total, st.rest, minimum.best);
    return FieldSort { rest: rest, sorted: append_field<P, N>(pages, stride, total, st.sorted, minimum.best) };
}
fn canonical_finite_type_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, module_start: u64, module_end: u64, name_start: u64, name_end: u64) -> (result: SemanticIdentity) {
    let prefix: [byte; 21] = [109 as byte, 110 as byte, 99 as byte, 115 as byte, 58 as byte, 48 as byte, 46 as byte, 50 as byte, 58 as byte, 102 as byte, 105 as byte, 110 as byte, 105 as byte, 116 as byte, 101 as byte, 45 as byte, 116 as byte, 121 as byte, 112 as byte, 101 as byte, 58 as byte];
    let seed: SemanticIdentityBuild = SemanticIdentityBuild { bytes: [0 as byte; 512], len: 0, valid: true };
    iterate i over prefix carrying d: SemanticIdentityBuild = seed { next d = callable_identity_byte(d, prefix[i]); }
    let module_part: SemanticIdentityBuild = identity_component_span<P, N>(pages, stride, total, d, module_start, module_end);
    let sep1: SemanticIdentityBuild = callable_identity_byte(module_part, 58 as byte);
    let sep2: SemanticIdentityBuild = callable_identity_byte(sep1, 58 as byte);
    let type_part: SemanticIdentityBuild = identity_component_span<P, N>(pages, stride, total, sep2, name_start, name_end);
    return SemanticIdentity { bytes: type_part.bytes, len: type_part.len, valid: type_part.valid && module_end > module_start && name_end > name_start };
}
record IdentityBytesScan { identity: SemanticIdentity, offset: u64, build: SemanticIdentityBuild }
fn append_identity_component_step(st: IdentityBytesScan) -> (result: IdentityBytesScan) {
    if !(st.build.valid) || st.offset >= st.identity.len { return st; }
    let component: byte = st.identity.bytes[st.offset];
    let build: SemanticIdentityBuild = identity_component_byte(st.build, component);
    return IdentityBytesScan { ..st, offset: st.offset + 1, build: build };
}
fn append_identity_component(build: SemanticIdentityBuild, identity: SemanticIdentity) -> (result: SemanticIdentityBuild) {
    if !(identity.valid) || identity.len == 0 { return SemanticIdentityBuild { ..build, valid: false }; }
    iterate i over identity.bytes carrying st: IdentityBytesScan = IdentityBytesScan { identity: identity, offset: 0, build: build } {
        next st = append_identity_component_step(st);
    }
    return st.build;
}
record RecordIdentityBuild { build: SemanticIdentityBuild, fields: FieldList, nominals: NominalTypeIdentityList, valid: bool }
fn canonical_record_type_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, module_start: u64, module_end: u64, declaration: RecordDecl, nominals: NominalTypeIdentityList) -> (result: SemanticIdentity) {
    let prefix: [byte; 21] = [109 as byte, 110 as byte, 99 as byte, 115 as byte, 58 as byte, 48 as byte, 46 as byte, 50 as byte, 58 as byte, 114 as byte, 101 as byte, 99 as byte, 111 as byte, 114 as byte, 100 as byte, 45 as byte, 116 as byte, 121 as byte, 112 as byte, 101 as byte, 58 as byte];
    let seed: SemanticIdentityBuild = SemanticIdentityBuild { bytes: [0 as byte; 512], len: 0, valid: true };
    iterate i over prefix carrying d: SemanticIdentityBuild = seed { next d = callable_identity_byte(d, prefix[i]); }
    let module_part: SemanticIdentityBuild = identity_component_span<P, N>(pages, stride, total, d, module_start, module_end);
    let sep1: SemanticIdentityBuild = callable_identity_byte(module_part, 58 as byte);
    let sep2: SemanticIdentityBuild = callable_identity_byte(sep1, 58 as byte);
    let name_part: SemanticIdentityBuild = identity_component_span<P, N>(pages, stride, total, sep2, declaration.name_start, declaration.name_end);
    let sep3: SemanticIdentityBuild = callable_identity_byte(name_part, 58 as byte);
    let sep4: SemanticIdentityBuild = callable_identity_byte(sep3, 58 as byte);
    let sorted: FieldList = sort_fields_by_name<P, N>(pages, stride, total, declaration.fields);
    iterate i up_to 1024 carrying st: RecordIdentityBuild = RecordIdentityBuild { build: sep4, fields: sorted, nominals: nominals, valid: true } {
        next st = append_record_field_identity<P, N>(pages, stride, total, st);
    }
    return SemanticIdentity { bytes: st.build.bytes, len: st.build.len, valid: st.build.valid && st.valid && module_end > module_start && declaration.name_end > declaration.name_start };
}
fn append_record_field_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecordIdentityBuild) -> (result: RecordIdentityBuild) {
    return match st.fields {
        FNil => st,
        FCons { head: field, tail: rest } => append_record_field_identity_one<P, N>(pages, stride, total, st, field, rest)
    };
}
fn append_record_field_identity_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecordIdentityBuild, field: Field, rest: FieldList) -> (result: RecordIdentityBuild) {
    let field_name: SemanticIdentityBuild = identity_component_span<P, N>(pages, stride, total, st.build, field.name_start, field.name_end);
    let colon: SemanticIdentityBuild = identity_component_raw_byte(field_name, 58 as byte);
    let ty: SemanticIdentityBuild = record_field_type_identity<P, N>(pages, stride, total, st.nominals, colon, field);
    let semi: SemanticIdentityBuild = identity_component_raw_byte(ty, 59 as byte);
    return RecordIdentityBuild { build: semi, fields: rest, nominals: st.nominals, valid: st.valid };
}
fn record_field_type_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: NominalTypeIdentityList, build: SemanticIdentityBuild, field: Field) -> (result: SemanticIdentityBuild) {
    if field.type_kind == 5 || field.type_kind == 6 {
        // Stage-0's structural record fingerprint retains the declaring
        // source spelling of each field type. Semantic ownership is carried
        // separately by nominal references; substituting an imported
        // identity here would change the canonical record identity.
        return identity_component_span<P, N>(pages, stride, total, build, field.type_start, field.type_end);
    }
    if field.type_kind == 1 || field.type_kind == 2 || field.type_kind == 3 || field.type_kind == 4 || field.type_kind == 5 || field.type_kind == 7 || field.type_kind == 8 {
        return identity_component_span<P, N>(pages, stride, total, build, field.type_start, field.type_end);
    }
    return SemanticIdentityBuild { ..build, valid: false };
}

record DeclNominalWalk { enums: EnumList, records: RecordList, header: parser.Header, acc: NominalTypeIdentityList }
fn local_nominal_type_identities<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, unit: Unit) -> (result: NominalTypeIdentityList) {
    return local_nominal_type_identities_with_references<P, N>(pages, stride, total, unit, NominalTypeIdentityList.NINil);
}
fn local_nominal_type_identities_with_references<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, unit: Unit, references: NominalTypeIdentityList) -> (result: NominalTypeIdentityList) {
    iterate i up_to 1024 carrying st: DeclNominalWalk = DeclNominalWalk { enums: unit.enums, records: unit.records, header: unit.header, acc: references } {
        next st = local_nominal_identity_step<P, N>(pages, stride, total, st);
    }
    return st.acc;
}
record NominalReferenceWalk { rest: NominalTypeIdentityList, acc: NominalTypeIdentityList }
fn nominal_reference_entries<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, types: NominalTypeIdentityList) -> (result: NominalTypeIdentityList) {
    iterate i up_to 1024 carrying st: NominalReferenceWalk = NominalReferenceWalk { rest: types, acc: NominalTypeIdentityList.NINil } {
        next st = nominal_reference_entry_step(st);
    }
    return st.acc;
}
fn nominal_reference_entry_step(st: NominalReferenceWalk) -> (result: NominalReferenceWalk) {
    return match st.rest {
        NINil => st,
        NICons { head: item, tail: rest } => nominal_reference_entry_one(st, item, rest)
    };
}
fn nominal_reference_entry_one(st: NominalReferenceWalk, item: NominalTypeIdentity, rest: NominalTypeIdentityList) -> (result: NominalReferenceWalk) {
    if item.reference { return NominalReferenceWalk { rest: rest, acc: NominalTypeIdentityList.NICons { head: item, tail: st.acc } }; }
    return NominalReferenceWalk { rest: rest, acc: st.acc };
}
record NominalMergeWalk { rest: NominalTypeIdentityList, acc: NominalTypeIdentityList }
fn combine_nominal_type_identities<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, local: NominalTypeIdentityList, references: NominalTypeIdentityList) -> (result: NominalTypeIdentityList) {
    iterate i up_to 1024 carrying st: NominalMergeWalk = NominalMergeWalk { rest: local, acc: references } {
        next st = combine_nominal_type_identity_step(st);
    }
    return st.acc;
}
fn combine_nominal_type_identity_step(st: NominalMergeWalk) -> (result: NominalMergeWalk) {
    return match st.rest {
        NINil => st,
        NICons { head: item, tail: rest } => NominalMergeWalk { rest: rest, acc: NominalTypeIdentityList.NICons { head: item, tail: st.acc } }
    };
}
fn local_nominal_identity_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: DeclNominalWalk) -> (result: DeclNominalWalk) {
    return match st.enums {
        GCons { head: enum_decl, tail: rest } => local_finite_identity<P, N>(pages, stride, total, st, enum_decl, rest),
        GNil => local_record_identity<P, N>(pages, stride, total, st)
    };
}
fn local_finite_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: DeclNominalWalk, item: EnumDecl, rest: EnumList) -> (result: DeclNominalWalk) {
    let identity: SemanticIdentity = canonical_finite_type_identity<P, N>(pages, stride, total, st.header.module_start, st.header.module_end, item.name_start, item.name_end);
    let nominal: NominalTypeIdentity = NominalTypeIdentity { start: item.name_start, end: item.name_end, identity: identity, reference: false };
    return DeclNominalWalk { ..st, enums: rest, acc: NominalTypeIdentityList.NICons { head: nominal, tail: st.acc } };
}
fn local_record_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: DeclNominalWalk) -> (result: DeclNominalWalk) {
    return match st.records {
        RCons { head: record_decl, tail: rest } => local_record_identity_one<P, N>(pages, stride, total, st, record_decl, rest),
        RNil => st
    };
}
fn local_record_identity_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: DeclNominalWalk, item: RecordDecl, rest: RecordList) -> (result: DeclNominalWalk) {
    let identity: SemanticIdentity = canonical_record_type_identity<P, N>(pages, stride, total, st.header.module_start, st.header.module_end, item, st.acc);
    let nominal: NominalTypeIdentity = NominalTypeIdentity { start: item.name_start, end: item.name_end, identity: identity, reference: false };
    return DeclNominalWalk { ..st, records: rest, acc: NominalTypeIdentityList.NICons { head: nominal, tail: st.acc } };
}

record Sig { start: u64, end: u64, params: BindList, nparams: u64, generic_bounds: GenericBoundList, result: SemType, fx: EffectList, raw_capabilities: CapList, effects: EffectIdentityList, capabilities: CapabilityIdentityList, identity: SemanticIdentity }
enum SigTab { HNil, HCons { head: Sig, tail: SigTab } }
record SigRep { sig: Sig, obls: OblList }

record SigIdentityWalk { rest: SigTab, acc: SigTab, module_start: u64, module_end: u64 }
fn bind_local_callable_identities<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, sigs: SigTab) -> (result: SigTab) {
    iterate i up_to 1024 carrying st: SigIdentityWalk = SigIdentityWalk { rest: sigs, acc: SigTab.HNil, module_start: header.module_start, module_end: header.module_end } {
        next st = bind_local_callable_identity<P, N>(pages, stride, total, st);
    }
    return st.acc;
}
fn bind_local_callable_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SigIdentityWalk) -> (result: SigIdentityWalk) {
    return match st.rest {
        HNil => st,
        HCons { head: sig, tail: rest } => bind_local_callable_sig<P, N>(pages, stride, total, st, sig, rest)
    };
}
fn bind_local_callable_sig<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SigIdentityWalk, sig: Sig, rest: SigTab) -> (result: SigIdentityWalk) {
    let owned: Sig = bind_callable_signature<P, N>(pages, stride, total, st.module_start, st.module_end, sig);
    return SigIdentityWalk { ..st, rest: rest, acc: SigTab.HCons { head: owned, tail: st.acc } };
}
fn bind_callable_signature<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, module_start: u64, module_end: u64, sig: Sig) -> (result: Sig) {
    let identity: SemanticIdentity = canonical_function_identity<P, N>(pages, stride, total, module_start, module_end, sig.start, sig.end);
    let effects: EffectIdentityList = canonical_effect_identities<P, N>(pages, stride, total, module_start, module_end, sig.fx);
    let capabilities: CapabilityIdentityList = canonical_capability_identities<P, N>(pages, stride, total, module_start, module_end, sig.raw_capabilities);
    return Sig { ..sig, effects: effects, capabilities: capabilities, identity: identity };
}
fn check_sig<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, h: FnDecl, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: SigRep) {
    let sg: FnSig = h.sig;
    let ps: ParamRep = check_params<P, N>(pages, stride, total, sg.params, rectab, enumtab, nominals);
    let rs: ResultRep = check_results<P, N>(pages, stride, total, sg.results, h.fn_start, h.fn_end, rectab, enumtab, nominals);
    let cs: CapRep = check_caps<P, N>(pages, stride, total, sg.capabilities);
    let es: FxRep = check_effects<P, N>(pages, stride, total, sg.effects, cs.caps);
    let ks: OblList = check_contracts<P, N>(pages, stride, total, sg.contracts);
    let o1: OblList = append_obls<P, N>(pages, stride, total, ps.obls, rs.obls);
    let o2: OblList = append_obls<P, N>(pages, stride, total, o1, cs.obls);
    let o3: OblList = append_obls<P, N>(pages, stride, total, o2, es.obls);
    let obls: OblList = append_obls<P, N>(pages, stride, total, o3, ks);
    return SigRep { sig: Sig { start: sg.name_start, end: sg.name_end, params: ps.binds, nparams: ps.n, generic_bounds: build_generic_bounds<P, N>(pages, stride, total, sg.generics), result: rs.ty, fx: es.fx, raw_capabilities: sg.capabilities, effects: EffectIdentityList.EINil, capabilities: CapabilityIdentityList.CINil, identity: invalid_semantic_identity() }, obls: obls };
}
record ParamRep { binds: BindList, n: u64, obls: OblList }
record ParamState { rest: FieldList, binds: BindList, seen: NameList, n: u64, obls: OblList }
fn check_params<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, params: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: ParamRep) {
    iterate i up_to 1024 carrying d: ParamState = ParamState { rest: params, binds: BindList.BNil, seen: NameList.NNil, n: 0, obls: OblList.LNil } {
        next d = check_params_step<P, N>(pages, stride, total, d, rectab, enumtab, nominals);
    }
    return ParamRep { binds: d.binds, n: d.n, obls: reverse_obls<P, N>(pages, stride, total, d.obls) };
}
fn check_params_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ParamState, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: ParamState) {
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => check_one_param<P, N>(pages, stride, total, st, h, t, rectab, enumtab, nominals)
    };
}
fn check_one_param<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ParamState, h: Field, t: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: ParamState) {
    let ty: TyRes = resolve_type<P, N>(pages, stride, total, h.type_kind, h.type_start, h.type_end, rectab, enumtab, nominals);
    let tob: OblList = param_type_obl(h, ty);
    if name_known<P, N>(pages, stride, total, st.seen, h.name_start, h.name_end) {
        let dob: Obligation = Obligation { kind: 5, start: h.name_start, end: h.name_end, status: 1 };
        return ParamState { rest: t, binds: st.binds, seen: st.seen, n: st.n, obls: OblList.LCons { head: dob, tail: append_obls<P, N>(pages, stride, total, tob, st.obls) } };
    }
    let seen: NameList = NameList.NCons { head: NameSpan { start: h.name_start, end: h.name_end }, tail: st.seen };
    let bound: SemType = param_bound_type(ty);
    let binds: BindList = BindList.BCons { head: Bind { start: h.name_start, end: h.name_end, ty: bound }, tail: st.binds };
    return ParamState { rest: t, binds: binds, seen: seen, n: st.n + 1, obls: append_obls<P, N>(pages, stride, total, tob, st.obls) };
}
fn param_type_obl(h: Field, ty: TyRes) -> (result: OblList) {
    if ty.ok { return OblList.LNil; }
    if h.type_kind == 6 { return OblList.LCons { head: Obligation { kind: 31, start: h.type_start, end: h.type_end, status: 1 }, tail: OblList.LNil }; }
    return OblList.LCons { head: Obligation { kind: 19, start: h.type_start, end: h.type_end, status: 1 }, tail: OblList.LNil };
}
fn param_bound_type(ty: TyRes) -> (result: SemType) {
    if ty.ok { return ty.ty; }
    return SemType.TPoison;
}
record ResultRep { ty: SemType, obls: OblList }
record ResultState { rest: FieldList, n: u64, ty: SemType, obls: OblList }
fn check_results<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, results: FieldList, fn_start: u64, fn_end: u64, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: ResultRep) {
    iterate i up_to 1024 carrying d: ResultState = ResultState { rest: results, n: 0, ty: SemType.TPoison, obls: OblList.LNil } {
        next d = check_results_step<P, N>(pages, stride, total, d, rectab, enumtab, nominals);
    }
    return finish_results<P, N>(pages, stride, total, d, fn_start, fn_end);
}
fn check_results_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ResultState, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: ResultState) {
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => check_one_result<P, N>(pages, stride, total, st, h, t, rectab, enumtab, nominals)
    };
}
fn check_one_result<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ResultState, h: Field, t: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: ResultState) {
    let ty: TyRes = resolve_type<P, N>(pages, stride, total, h.type_kind, h.type_start, h.type_end, rectab, enumtab, nominals);
    let tob: OblList = param_type_obl(h, ty);
    let bound: SemType = param_bound_type(ty);
    let kept: SemType = result_kept_type(st, bound);
    return ResultState { rest: t, n: st.n + 1, ty: kept, obls: append_obls<P, N>(pages, stride, total, tob, st.obls) };
}
fn result_kept_type(st: ResultState, bound: SemType) -> (result: SemType) {
    if st.n == 0 { return bound; }
    return st.ty;
}
fn finish_results<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ResultState, fn_start: u64, fn_end: u64) -> (result: ResultRep) {
    let ordered: OblList = reverse_obls<P, N>(pages, stride, total, st.obls);
    if st.n == 1 { return ResultRep { ty: st.ty, obls: ordered }; }
    let obl: Obligation = Obligation { kind: 18, start: fn_start, end: fn_end, status: 1 };
    return ResultRep { ty: SemType.TPoison, obls: append_obls<P, N>(pages, stride, total, ordered, OblList.LCons { head: obl, tail: OblList.LNil }) };
}
record CapRep { caps: NameList, obls: OblList }
record CapState { rest: CapList, caps: NameList, obls: OblList }
fn check_caps<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, caps: CapList) -> (result: CapRep) {
    iterate i up_to 1024 carrying d: CapState = CapState { rest: caps, caps: NameList.NNil, obls: OblList.LNil } {
        next d = check_caps_step<P, N>(pages, stride, total, d);
    }
    return CapRep { caps: d.caps, obls: reverse_obls<P, N>(pages, stride, total, d.obls) };
}
fn check_caps_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CapState) -> (result: CapState) {
    return match st.rest {
        ANil => st,
        ACons { head: h, tail: t } => check_one_cap<P, N>(pages, stride, total, st, h, t)
    };
}
fn check_one_cap<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CapState, h: Cap, t: CapList) -> (result: CapState) {
    if name_known<P, N>(pages, stride, total, st.caps, h.start, h.end) {
        let obl: Obligation = Obligation { kind: 5, start: h.start, end: h.end, status: 1 };
        return CapState { rest: t, caps: st.caps, obls: OblList.LCons { head: obl, tail: st.obls } };
    }
    let caps: NameList = NameList.NCons { head: NameSpan { start: h.start, end: h.end }, tail: st.caps };
    return CapState { rest: t, caps: caps, obls: st.obls };
}
record FxRep { fx: EffectList, obls: OblList }
record FxState { rest: EffectList, fx: EffectList, obls: OblList }
fn check_effects<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, effects: EffectList, caps: NameList) -> (result: FxRep) {
    iterate i up_to 1024 carrying d: FxState = FxState { rest: effects, fx: EffectList.XNil, obls: OblList.LNil } {
        next d = check_effects_step<P, N>(pages, stride, total, d, caps);
    }
    return FxRep { fx: reverse_effects<P, N>(pages, stride, total, d.fx), obls: reverse_obls<P, N>(pages, stride, total, d.obls) };
}
fn check_effects_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FxState, caps: NameList) -> (result: FxState) {
    return match st.rest {
        XNil => st,
        XCons { head: h, tail: t } => check_one_effect<P, N>(pages, stride, total, st, h, t, caps)
    };
}
fn check_one_effect<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FxState, h: Effect, t: EffectList, caps: NameList) -> (result: FxState) {
    if name_known<P, N>(pages, stride, total, caps, h.cap_start, h.cap_end) {
        return FxState { rest: t, fx: EffectList.XCons { head: h, tail: st.fx }, obls: st.obls };
    }
    let obl: Obligation = Obligation { kind: 17, start: h.kind_start, end: h.cap_end, status: 1 };
    return FxState { rest: t, fx: st.fx, obls: OblList.LCons { head: obl, tail: st.obls } };
}
record ClauseState { rest: ClauseList, obls: OblList }
fn check_contracts<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, clauses: ClauseList) -> (result: OblList) {
    iterate i up_to 1024 carrying d: ClauseState = ClauseState { rest: clauses, obls: OblList.LNil } {
        next d = check_contracts_step(d);
    }
    return reverse_obls<P, N>(pages, stride, total, d.obls);
}
fn check_contracts_step(st: ClauseState) -> (result: ClauseState) {
    return match st.rest {
        CNil => st,
        CCons { head: h, tail: t } => ClauseState { rest: t, obls: OblList.LCons { head: Obligation { kind: 16, start: h.kind_start, end: h.name_end, status: 2 }, tail: st.obls } }
    };
}
// Declaration tables: uses are unavailable without a module system
// (MNE173, matching the oracle in this environment); enum payloads admit
// scalars and declared nominals but no sequences; record fields admit
// sequences with valid elements.
fn check_uses<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, uses: UseList) -> (result: OblList) {
    iterate i up_to 1024 carrying d: UseState = UseState { rest: uses, obls: OblList.LNil } {
        next d = check_uses_step(d);
    }
    return reverse_obls<P, N>(pages, stride, total, d.obls);
}
record UseState { rest: UseList, obls: OblList }
fn check_uses_step(st: UseState) -> (result: UseState) {
    return match st.rest {
        UNil => st,
        UCons { head: h, tail: t } => UseState { rest: t, obls: OblList.LCons { head: Obligation { kind: 36, start: h.module_start, end: h.module_end, status: 1 }, tail: st.obls } }
    };
}

// Typed stack IR with provenance. Every operation carries its source span
// and its established type, so an IR operation stays related to the
// semantic expression it came from. The type-stack verifier below is a
// narrow authority: it checks operand depth, binary operand equality, and
// the final type, but it does NOT re-derive operator typing (that proof
// belongs to the checking step that emitted the operation). It rejects
// poisoned types: poison only arises alongside a recorded FAIL, so
// poisoned IR is never verified.
enum TOp {
    TInt { value: u64, ty: SemType, start: u64, end: u64 },
    TBool { value: bool, ty: SemType, start: u64, end: u64 },
    TName { ty: SemType, start: u64, end: u64 },
    TNot { ty: SemType, start: u64, end: u64 },
    TRepeat { ty: SemType, element: SemType, count: u64, start: u64, end: u64 },
    TMatch { ty: SemType, subject_ty: SemType, arms: TypedScalarMatchArmList, arm_count: u64, default_count: u64, start: u64, end: u64 },
    TFiniteMatch { ty: SemType, subject_ty: SemType, arms: TypedFiniteMatchArmList, arm_count: u64, start: u64, end: u64 },
    TEnumConstruct { ty: SemType, variant_start: u64, variant_end: u64, field_count: u64, params: BindList, start: u64, end: u64 },
    TBin { op: u64, ty: SemType, start: u64, end: u64 },
    TCall { ty: SemType, argc: u64, params: BindList, start: u64, end: u64, ns: u64, ne: u64, identity: SemanticIdentity, effects: EffectIdentityList, capabilities: CapabilityIdentityList },
    TProj { ty: SemType, fstart: u64, fend: u64, field_index: u64, start: u64, end: u64 },
    TOp { slot: u64, ty: SemType, argc: u64, ns: u64, ne: u64, identity: SemanticIdentity, start: u64, end: u64 }
}
enum TOpList { PNil, PCons { head: TOp, tail: TOpList } }
record TypedFiniteMatchArm { variant_start: u64, variant_end: u64, has_payload: bool, bindings: PayloadBindingList, pattern_start: u64, pattern_end: u64, payload_fields: BindList, ops: TOpList, op_count: u64 }
enum TypedFiniteMatchArmList { TFNil, TFCons { head: TypedFiniteMatchArm, tail: TypedFiniteMatchArmList } }
record TypedScalarMatchArm { is_default: bool, negative: bool, value: u64, overflow: bool, pattern_start: u64, pattern_end: u64, ops: TOpList, op_count: u64 }
enum TypedScalarMatchArmList { TSNil, TSCons { head: TypedScalarMatchArm, tail: TypedScalarMatchArmList } }
enum TopsList { TLNil, TLCons { head: TOpList, tail: TopsList } }
enum TyList { TyNil, TyCons { head: SemType, tail: TyList } }
enum TyStack { WNil, WCons { head: SemType, tail: TyStack } }
record TopsRev { rest: TOpList, acc: TOpList }
fn reverse_tops<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: TOpList) -> (result: TOpList) {
    iterate i up_to 1024 carrying d: TopsRev = TopsRev { rest: list, acc: TOpList.PNil } {
        if top_list_empty(d.rest) { return d.acc; }
        next d = reverse_tops_step(d);
    }
    return d.acc;
}
fn reverse_tops_step(st: TopsRev) -> (result: TopsRev) {
    return match st.rest { PNil => st, PCons { head: h, tail: t } => TopsRev { rest: t, acc: TOpList.PCons { head: h, tail: st.acc } } };
}
record TopsPrepend { rest: TOpList, acc: TOpList }
fn append_tops<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, first: TOpList, second: TOpList) -> (result: TOpList) {
    let rev: TOpList = reverse_tops<P, N>(pages, stride, total, first);
    iterate i up_to 1024 carrying d: TopsPrepend = TopsPrepend { rest: rev, acc: second } {
        next d = append_tops_step(d);
    }
    return d.acc;
}
fn append_tops_step(st: TopsPrepend) -> (result: TopsPrepend) {
    return match st.rest { PNil => st, PCons { head: h, tail: t } => TopsPrepend { rest: t, acc: TOpList.PCons { head: h, tail: st.acc } } };
}
record TopsCount { rest: TOpList, n: u64 }
fn count_tops<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: TOpList) -> (result: u64) {
    iterate i up_to 1024 carrying d: TopsCount = TopsCount { rest: list, n: 0 } {
        next d = count_tops_step(d);
    }
    return d.n;
}
fn count_tops_step(st: TopsCount) -> (result: TopsCount) {
    return match st.rest { PNil => st, PCons { head: h, tail: t } => TopsCount { rest: t, n: st.n + 1 } };
}
record TopsPrefixSplit { rest: TOpList, taken: TOpList, remaining: u64, ok: bool }
fn split_tops_prefix<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, tops: TOpList, count: u64) -> (result: TopsPrefixSplit) {
    iterate i up_to 1024 carrying st: TopsPrefixSplit = TopsPrefixSplit { rest: tops, taken: TOpList.PNil, remaining: count, ok: true } {
        next st = split_tops_prefix_step(st);
    }
    return TopsPrefixSplit { ..st, ok: st.ok && st.remaining == 0 };
}
fn split_tops_prefix_step(st: TopsPrefixSplit) -> (result: TopsPrefixSplit) {
    if !(st.ok) || st.remaining == 0 { return st; }
    return match st.rest {
        PNil => TopsPrefixSplit { ..st, ok: false },
        PCons { head: h, tail: t } => TopsPrefixSplit { rest: t, taken: TOpList.PCons { head: h, tail: st.taken }, remaining: st.remaining - 1, ok: true }
    };
}
record TypedFiniteArmRev { rest: TypedFiniteMatchArmList, acc: TypedFiniteMatchArmList }
fn reverse_typed_finite_match_arms<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: TypedFiniteMatchArmList) -> (result: TypedFiniteMatchArmList) {
    iterate i up_to 1024 carrying st: TypedFiniteArmRev = TypedFiniteArmRev { rest: arms, acc: TypedFiniteMatchArmList.TFNil } {
        next st = reverse_typed_finite_match_arm_step(st);
    }
    return st.acc;
}
fn reverse_typed_finite_match_arm_step(st: TypedFiniteArmRev) -> (result: TypedFiniteArmRev) {
    return match st.rest {
        TFNil => st,
        TFCons { head: h, tail: t } => TypedFiniteArmRev { rest: t, acc: TypedFiniteMatchArmList.TFCons { head: h, tail: st.acc } }
    };
}
record TypedScalarArmRev { rest: TypedScalarMatchArmList, acc: TypedScalarMatchArmList }
fn reverse_typed_scalar_match_arms<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: TypedScalarMatchArmList) -> (result: TypedScalarMatchArmList) {
    iterate i up_to 1024 carrying st: TypedScalarArmRev = TypedScalarArmRev { rest: arms, acc: TypedScalarMatchArmList.TSNil } {
        next st = reverse_typed_scalar_match_arm_step(st);
    }
    return st.acc;
}
fn reverse_typed_scalar_match_arm_step(st: TypedScalarArmRev) -> (result: TypedScalarArmRev) {
    return match st.rest {
        TSNil => st,
        TSCons { head: h, tail: t } => TypedScalarArmRev { rest: t, acc: TypedScalarMatchArmList.TSCons { head: h, tail: st.acc } }
    };
}
// Type-stack verification: pushes add one typed slot; TBin needs two
// equal operand types; TCall needs argc slots; TProj is depth-neutral.
// A well-formed lowering of one expression ends at depth exactly one;
// when a final type is required it must equal the established type.
record TDepth { rest: TOpList, stack: TyStack, depth: u64, ok: bool }
record VerifyFrame { depth: TDepth, want: ExpTy }
enum VerifyFrameList { VQNil, VQCons { head: VerifyFrame, tail: VerifyFrameList } }
record VerifyMachine { current: VerifyFrame, pending: VerifyFrameList, ok: bool, done: bool }
fn verify_tops<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ops: TOpList, want: ExpTy) -> (result: bool) {
    let first: VerifyFrame = VerifyFrame { depth: TDepth { rest: ops, stack: TyStack.WNil, depth: 0, ok: true }, want: want };
    iterate i up_to 1024 carrying st: VerifyMachine = VerifyMachine { current: first, pending: VerifyFrameList.VQNil, ok: true, done: false } {
        next st = verify_tops_machine_step<P, N>(pages, stride, total, st);
    }
    return st.ok && st.done;
}
fn verify_tops_machine_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: VerifyMachine) -> (result: VerifyMachine) {
    if !(st.ok) || st.done { return st; }
    return match st.current.depth.rest {
        PNil => finish_verify_frame<P, N>(pages, stride, total, st),
        PCons { head: operation, tail: rest } => advance_verify_frame<P, N>(pages, stride, total, st, operation, rest)
    };
}
fn finish_verify_frame<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: VerifyMachine) -> (result: VerifyMachine) {
    if !(finish_verify_tops<P, N>(pages, stride, total, st.current.depth, st.current.want)) { return VerifyMachine { ..st, ok: false }; }
    return match st.pending {
        VerifyFrameList.VQNil => VerifyMachine { ..st, done: true },
        VerifyFrameList.VQCons { head: queued, tail: pending } => VerifyMachine { current: queued, pending: pending, ok: true, done: false }
    };
}
fn advance_verify_frame<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: VerifyMachine, operation: TOp, rest: TOpList) -> (result: VerifyMachine) {
    let advanced: TDepth = verify_top_one<P, N>(pages, stride, total, st.current.depth, operation, rest);
    if !(advanced.ok) { return VerifyMachine { ..st, ok: false }; }
    let pending: VerifyFrameList = queue_finite_match_checks<P, N>(pages, stride, total, operation, st.pending);
    return VerifyMachine { current: VerifyFrame { depth: advanced, want: st.current.want }, pending: pending, ok: true, done: false };
}
record TypedVerifyQueue { rest: TypedFiniteMatchArmList, ty: SemType, pending: VerifyFrameList, ok: bool }
fn queue_finite_match_checks<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, operation: TOp, pending: VerifyFrameList) -> (result: VerifyFrameList) {
    return match operation {
        TFiniteMatch { ty: ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, start: start, end: end } => queue_typed_finite_match_arms<P, N>(pages, stride, total, arms, ty, pending),
        TInt { value: value, ty: ty, start: start, end: end } => pending,
        TBool { value: value, ty: ty, start: start, end: end } => pending,
        TName { ty: ty, start: start, end: end } => pending,
        TNot { ty: ty, start: start, end: end } => pending,
        TRepeat { ty: ty, element: element, count: count, start: start, end: end } => pending,
        TMatch { ty: ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, default_count: default_count, start: start, end: end } => queue_typed_scalar_match_arms<P, N>(pages, stride, total, arms, ty, pending),
        TEnumConstruct { ty: ty, variant_start: vs, variant_end: ve, field_count: count, params: params, start: start, end: end } => pending,
        TBin { op: op, ty: ty, start: start, end: end } => pending,
        TCall { ty: ty, argc: argc, params: params, start: start, end: end, ns: ns, ne: ne, identity: identity, effects: effects, capabilities: capabilities } => pending,
        TProj { ty: ty, fstart: fs, fend: fe, field_index: index, start: start, end: end } => pending,
        TOp { slot: slot, ty: ty, argc: argc, ns: ns, ne: ne, identity: identity, start: start, end: end } => pending
    };
}
fn queue_typed_finite_match_arms<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: TypedFiniteMatchArmList, ty: SemType, pending: VerifyFrameList) -> (result: VerifyFrameList) {
    iterate i up_to 1024 carrying st: TypedVerifyQueue = TypedVerifyQueue { rest: arms, ty: ty, pending: pending, ok: true } {
        next st = queue_typed_finite_match_arm_step<P, N>(pages, stride, total, st);
    }
    if !(st.ok) { return VerifyFrameList.VQNil; }
    return st.pending;
}
fn queue_typed_finite_match_arm_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TypedVerifyQueue) -> (result: TypedVerifyQueue) {
    return match st.rest {
        TFNil => st,
        TFCons { head: arm, tail: rest } => queue_one_typed_finite_match_arm<P, N>(pages, stride, total, st, arm, rest)
    };
}
fn queue_one_typed_finite_match_arm<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TypedVerifyQueue, arm: TypedFiniteMatchArm, rest: TypedFiniteMatchArmList) -> (result: TypedVerifyQueue) {
    let actual_count: u64 = count_tops<P, N>(pages, stride, total, arm.ops);
    let frame: VerifyFrame = VerifyFrame { depth: TDepth { rest: arm.ops, stack: TyStack.WNil, depth: 0, ok: true }, want: ExpTy.XSome { ty: st.ty } };
    return TypedVerifyQueue { rest: rest, ty: st.ty, pending: VerifyFrameList.VQCons { head: frame, tail: st.pending }, ok: st.ok && arm.op_count > 0 && arm.op_count == actual_count };
}
record TypedScalarVerifyQueue { rest: TypedScalarMatchArmList, ty: SemType, pending: VerifyFrameList, ok: bool }
fn queue_typed_scalar_match_arms<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: TypedScalarMatchArmList, ty: SemType, pending: VerifyFrameList) -> (result: VerifyFrameList) {
    iterate i up_to 1024 carrying st: TypedScalarVerifyQueue = TypedScalarVerifyQueue { rest: arms, ty: ty, pending: pending, ok: true } {
        next st = queue_typed_scalar_match_arm_step<P, N>(pages, stride, total, st);
    }
    if !(st.ok) { return VerifyFrameList.VQNil; }
    return st.pending;
}
fn queue_typed_scalar_match_arm_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TypedScalarVerifyQueue) -> (result: TypedScalarVerifyQueue) {
    return match st.rest {
        TSNil => st,
        TSCons { head: arm, tail: rest } => queue_one_typed_scalar_match_arm<P, N>(pages, stride, total, st, arm, rest)
    };
}
fn queue_one_typed_scalar_match_arm<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TypedScalarVerifyQueue, arm: TypedScalarMatchArm, rest: TypedScalarMatchArmList) -> (result: TypedScalarVerifyQueue) {
    let actual_count: u64 = count_tops<P, N>(pages, stride, total, arm.ops);
    let frame: VerifyFrame = VerifyFrame { depth: TDepth { rest: arm.ops, stack: TyStack.WNil, depth: 0, ok: true }, want: ExpTy.XSome { ty: st.ty } };
    return TypedScalarVerifyQueue { rest: rest, ty: st.ty, pending: VerifyFrameList.VQCons { head: frame, tail: st.pending }, ok: st.ok && arm.op_count > 0 && arm.op_count == actual_count };
}
fn verify_tops_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth) -> (result: TDepth) {
    if !(st.ok) { return st; }
    return match st.rest {
        PNil => st,
        PCons { head: h, tail: t } => verify_top_one<P, N>(pages, stride, total, st, h, t)
    };
}
fn verify_top_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, h: TOp, t: TOpList) -> (result: TDepth) {
    return match h {
        TInt { value: v, ty: ty, start: s, end: e } => verify_top_push(st, t, ty),
        TBool { value: v, ty: ty, start: s, end: e } => verify_top_push(st, t, ty),
        TName { ty: ty, start: s, end: e } => verify_top_push(st, t, ty),
        TNot { ty: ty, start: s, end: e } => verify_top_not<P, N>(pages, stride, total, st, t, ty),
        TRepeat { ty: ty, element: element, count: count, start: s, end: e } => verify_top_repeat<P, N>(pages, stride, total, st, t, ty, element, count),
        TMatch { ty: ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, default_count: default_count, start: s, end: e } => verify_top_match<P, N>(pages, stride, total, st, t, ty, subject_ty, arms, arm_count, default_count),
        TFiniteMatch { ty: ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, start: s, end: e } => verify_top_finite_match<P, N>(pages, stride, total, st, t, ty, subject_ty, arms, arm_count),
        TEnumConstruct { ty: ty, variant_start: vs, variant_end: ve, field_count: f, params: params, start: s, end: e } => verify_top_enum_construct<P, N>(pages, stride, total, st, t, ty, f, params, vs, ve, s, e),
        TBin { op: o, ty: ty, start: s, end: e } => verify_top_bin<P, N>(pages, stride, total, st, t, ty),
        TCall { ty: ty, argc: c, params: params, start: s, end: e, ns: ns, ne: ne, identity: id, effects: effects, capabilities: capabilities } => verify_top_call<P, N>(pages, stride, total, st, t, ty, c, effects, capabilities),
        TProj { ty: ty, fstart: fs, fend: fe, field_index: index, start: s, end: e } => verify_top_proj(st, t, ty),
        TOp { slot: slot, ty: ty, argc: argc, ns: ns, ne: ne, identity: id, start: s, end: e } => verify_top_op<P, N>(pages, stride, total, st, t, slot, ty, argc, ns, ne, id, s, e)
    };
}
fn verify_top_repeat<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, element: SemType, count: u64) -> (result: TDepth) {
    if is_poison(ty) || is_poison(element) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return match ty {
        TSeqExact { element: expected_element, length: length, length_valid: valid } => verify_top_repeat_exact<P, N>(pages, stride, total, st, t, ty, element, expected_element, length, valid, count),
        TBool => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        TByte => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        TInt { width: w, signed: g } => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        TNamed { start: s, end: e } => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        TSeq => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        TPoison => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }
    };
}
fn verify_top_repeat_exact<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, element: SemType, expected_element: SemType, length: u64, valid: bool, count: u64) -> (result: TDepth) {
    if !(valid) || length != count || !(sem_eq<P, N>(pages, stride, total, element, expected_element)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return match st.stack {
        WNil => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        WCons { head: actual, tail: rest } => verify_top_repeat_value<P, N>(pages, stride, total, st, t, ty, element, actual, rest)
    };
}
fn verify_top_repeat_value<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, element: SemType, actual: SemType, rest: TyStack) -> (result: TDepth) {
    if !(sem_eq<P, N>(pages, stride, total, actual, element)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: rest }, depth: st.depth, ok: true };
}
fn verify_top_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, subject_ty: SemType, arms: TypedScalarMatchArmList, arm_count: u64, default_count: u64) -> (result: TDepth) {
    let count: TypedScalarMatchCount = typed_scalar_match_count<P, N>(pages, stride, total, arms);
    if is_poison(ty) || !(is_int_ty(subject_ty)) || count.n != arm_count || count.defaults != default_count || default_count != 1 { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    if !(typed_scalar_match_patterns_ok<P, N>(pages, stride, total, arms, subject_ty)) || !(typed_scalar_match_arms_valid<P, N>(pages, stride, total, arms)) || st.depth == 0 { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return match st.stack {
        WNil => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        WCons { head: actual_subject, tail: remaining } => verify_top_match_subject<P, N>(pages, stride, total, st, t, ty, subject_ty, actual_subject, remaining)
    };
}
fn verify_top_match_subject<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, subject_ty: SemType, actual: SemType, remaining: TyStack) -> (result: TDepth) {
    if !(is_int_ty(actual)) || !(sem_eq<P, N>(pages, stride, total, actual, subject_ty)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: remaining }, depth: st.depth, ok: true };
}
// Arm operations are isolated proof frames and are checked by the same
// iterative verifier worklist. The parent stack therefore consumes only the
// nominal subject and replaces it with the match result.
record TypedFiniteMatchCount { rest: TypedFiniteMatchArmList, count: u64 }
fn typed_finite_match_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: TypedFiniteMatchArmList) -> (result: u64) {
    iterate i up_to 1024 carrying st: TypedFiniteMatchCount = TypedFiniteMatchCount { rest: arms, count: 0 } { next st = typed_finite_match_count_step(st); }
    return st.count;
}
fn typed_finite_match_count_step(st: TypedFiniteMatchCount) -> (result: TypedFiniteMatchCount) {
    return match st.rest { TFNil => st, TFCons { head: arm, tail: rest } => TypedFiniteMatchCount { rest: rest, count: st.count + 1 } };
}
record TypedFiniteArmValidity { rest: TypedFiniteMatchArmList, ok: bool }
fn typed_finite_match_arms_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: TypedFiniteMatchArmList) -> (result: bool) {
    iterate i up_to 1024 carrying st: TypedFiniteArmValidity = TypedFiniteArmValidity { rest: arms, ok: true } { next st = typed_finite_arm_valid_step<P, N>(pages, stride, total, st); }
    return st.ok;
}
fn typed_finite_arm_valid_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TypedFiniteArmValidity) -> (result: TypedFiniteArmValidity) {
    if !(st.ok) { return st; }
    return match st.rest {
        TFNil => st,
        TFCons { head: arm, tail: rest } => typed_finite_arm_valid_one<P, N>(pages, stride, total, arm, rest)
    };
}
fn typed_finite_arm_valid_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arm: TypedFiniteMatchArm, rest: TypedFiniteMatchArmList) -> (result: TypedFiniteArmValidity) {
    let op_count: u64 = count_tops<P, N>(pages, stride, total, arm.ops);
    let bind_count_actual: u64 = payload_binding_count<P, N>(pages, stride, total, arm.bindings);
    let fields_count: u64 = bind_count<P, N>(pages, stride, total, arm.payload_fields);
    let shape: bool = select(arm.has_payload, bind_count_actual == fields_count, bind_count_actual == 0);
    return TypedFiniteArmValidity { rest: rest, ok: op_count > 0 && arm.op_count == op_count && shape && payload_bindings_match<P, N>(pages, stride, total, arm.bindings, arm.payload_fields) };
}
record TypedScalarMatchCount { rest: TypedScalarMatchArmList, n: u64, defaults: u64 }
fn typed_scalar_match_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: TypedScalarMatchArmList) -> (result: TypedScalarMatchCount) {
    iterate i up_to 1024 carrying st: TypedScalarMatchCount = TypedScalarMatchCount { rest: arms, n: 0, defaults: 0 } { next st = typed_scalar_match_count_step(st); }
    return st;
}
fn typed_scalar_match_count_step(st: TypedScalarMatchCount) -> (result: TypedScalarMatchCount) {
    return match st.rest {
        TSNil => st,
        TSCons { head: arm, tail: rest } => TypedScalarMatchCount { rest: rest, n: st.n + 1, defaults: st.defaults + select(arm.is_default, 1, 0) }
    };
}
record TypedScalarArmValidity { rest: TypedScalarMatchArmList, ok: bool }
fn typed_scalar_match_arms_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: TypedScalarMatchArmList) -> (result: bool) {
    iterate i up_to 1024 carrying st: TypedScalarArmValidity = TypedScalarArmValidity { rest: arms, ok: true } { next st = typed_scalar_arm_valid_step<P, N>(pages, stride, total, st); }
    return st.ok;
}
fn typed_scalar_arm_valid_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TypedScalarArmValidity) -> (result: TypedScalarArmValidity) {
    if !(st.ok) { return st; }
    return match st.rest {
        TSNil => st,
        TSCons { head: arm, tail: rest } => typed_scalar_arm_valid_one<P, N>(pages, stride, total, arm, rest)
    };
}
fn typed_scalar_arm_valid_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arm: TypedScalarMatchArm, rest: TypedScalarMatchArmList) -> (result: TypedScalarArmValidity) {
    let op_count: u64 = count_tops<P, N>(pages, stride, total, arm.ops);
    return TypedScalarArmValidity { rest: rest, ok: op_count > 0 && arm.op_count == op_count };
}
fn verify_top_finite_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, subject_ty: SemType, arms: TypedFiniteMatchArmList, arm_count: u64) -> (result: TDepth) {
    let count: u64 = typed_finite_match_count<P, N>(pages, stride, total, arms);
    if is_poison(ty) || is_poison(subject_ty) || count != arm_count || arm_count == 0 || !(typed_finite_match_arms_valid<P, N>(pages, stride, total, arms)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    if !(is_named_ty(subject_ty)) || st.depth == 0 { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return match st.stack {
        WNil => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        WCons { head: actual_subject, tail: remaining } => verify_top_finite_subject<P, N>(pages, stride, total, st, t, ty, subject_ty, actual_subject, remaining)
    };
}
fn verify_top_finite_subject<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, subject_ty: SemType, actual: SemType, remaining: TyStack) -> (result: TDepth) {
    if !(is_named_ty(actual)) || !(sem_eq<P, N>(pages, stride, total, actual, subject_ty)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: remaining }, depth: st.depth, ok: true };
}
fn is_named_ty(ty: SemType) -> (result: bool) {
    return match ty { TNamed { start: s, end: e } => true, TBool => false, TByte => false, TInt { width: w, signed: g } => false, TSeq => false, TSeqExact { element: t, length: n, length_valid: v } => false, TPoison => false };
}
// Construction pops one value per checked field occurrence and pushes the
// enum type. Field identity and value types belong to the checking step;
// like calls, the verifier checks arity discipline, not the signature.
fn verify_top_enum_construct<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, field_count: u64, params: BindList, variant_start: u64, variant_end: u64, start: u64, end: u64) -> (result: TDepth) {
    if is_poison(ty) || !(is_named_ty(ty)) || bind_count<P, N>(pages, stride, total, params) != field_count || !(enum_construct_source_valid<P, N>(pages, stride, total, ty, variant_start, variant_end, params, start, end)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    if st.depth < field_count { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    let popped: PopN = pop_tys<P, N>(pages, stride, total, st.stack, field_count);
    if !(popped.ok) || !(construct_operand_types_match<P, N>(pages, stride, total, st.stack, params)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: popped.rest }, depth: st.depth - field_count + 1, ok: true };
}
record ConstructOperandCheck { stack: TyStack, params: BindList, ok: bool }
fn construct_operand_types_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, stack: TyStack, params: BindList) -> (result: bool) {
    let reverse: BindList = reverse_binds<P, N>(pages, stride, total, params);
    iterate i up_to 1024 carrying st: ConstructOperandCheck = ConstructOperandCheck { stack: stack, params: reverse, ok: true } { next st = construct_operand_type_step<P, N>(pages, stride, total, st); }
    return st.ok && construct_operand_pairs_empty(st.stack, st.params);
}
fn construct_operand_type_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ConstructOperandCheck) -> (result: ConstructOperandCheck) {
    if !(st.ok) { return st; }
    return match st.stack {
        WNil => ConstructOperandCheck { ..st, ok: match st.params { BindList.BNil => true, BindList.BCons { head: h, tail: t } => false } },
        WCons { head: actual, tail: stack } => match st.params {
            BindList.BNil => ConstructOperandCheck { ..st, stack: stack, ok: false },
            BindList.BCons { head: parameter, tail: params } => ConstructOperandCheck { stack: stack, params: params, ok: sem_eq<P, N>(pages, stride, total, actual, parameter.ty) }
        }
    };
}
fn construct_operand_pairs_empty(stack: TyStack, params: BindList) -> (result: bool) {
    return match stack { WNil => match params { BindList.BNil => true, BindList.BCons { head: h, tail: t } => false }, WCons { head: h, tail: rest } => false };
}
record ConstructSourceCheck { fields: ConstructFieldList, params: BindList, ok: bool }
fn enum_construct_source_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: SemType, variant_start: u64, variant_end: u64, params: BindList, start: u64, end: u64) -> (result: bool) {
    let parsed: ExprParse = parse_expr<P, N>(pages, stride, total, start, true);
    if !(parsed.ok) || parsed.start != start || parsed.end != end { return false; }
    return match parsed.node {
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: fields, start: es, end: ee } => enum_construct_source_parts<P, N>(pages, stride, total, ty, variant_start, variant_end, params, start, end, ts, te, vs, ve, fields),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: fields, start: es, end: ee } => false,
        Project { base: base, field_start: fs, field_end: fe, start: es, end: ee, path: path } => enum_construct_project_source<P, N>(pages, stride, total, ty, variant_start, variant_end, params, start, end, base, fs, fe, path),
        Name { start: ns, end: ne } => false,
        Integer { start: ns, end: ne, value: value, overflow: overflow } => false,
        Boolean { start: ns, end: ne, value: value } => false,
        UnaryNot { value: value, start: ns, end: ne } => false,
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: ns, end: ne } => false,
        ScalarMatch { subject: subject, arms: arms, start: ns, end: ne } => false,
        Binary { op: op, left: left, right: right, start: ns, end: ne } => false,
        Call { name_start: ns, name_end: ne, args: args, targs: tg, start: es, end: ee } => false,
        FiniteMatch { subject: subject, arms: arms, start: ns, end: ne } => false,
        OpCall { slot: slot, name_start: ons, name_end: one, args: a, start: s, end: e } => false
    };
}
fn enum_construct_project_source<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: SemType, variant_start: u64, variant_end: u64, params: BindList, start: u64, end: u64, base: Expr, field_start: u64, field_end: u64, path: bool) -> (result: bool) {
    if !(path) { return false; }
    return match base {
        Name { start: type_start, end: type_end } => enum_construct_source_parts<P, N>(pages, stride, total, ty, variant_start, variant_end, params, start, end, type_start, type_end, field_start, field_end, ConstructFieldList.CNil),
        Integer { start: s, end: e, value: value, overflow: overflow } => false,
        Boolean { start: s, end: e, value: value } => false,
        UnaryNot { value: value, start: s, end: e } => false,
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => false,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => false,
        Binary { op: op, left: left, right: right, start: s, end: e } => false,
        Call { name_start: ns, name_end: ne, args: args, targs: tg, start: s, end: e } => false,
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => false,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => false,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: fields, start: s, end: e } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: fields, start: s, end: e } => false,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => false
    };
}
fn enum_construct_source_parts<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: SemType, variant_start: u64, variant_end: u64, params: BindList, start: u64, end: u64, type_start: u64, type_end: u64, source_variant_start: u64, source_variant_end: u64, fields: ConstructFieldList) -> (result: bool) {
    let type_ok: bool = match ty {
        TNamed { start: ts, end: te } => ts == type_start && te == type_end,
        TBool => false,
        TByte => false,
        TInt { width: width, signed: signed } => false,
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: valid } => false,
        TPoison => false
    };
    iterate i up_to 1024 carrying st: ConstructSourceCheck = ConstructSourceCheck { fields: fields, params: params, ok: true } { next st = construct_source_field_step<P, N>(pages, stride, total, st); }
    return type_ok && source_variant_start == variant_start && source_variant_end == variant_end && st.ok && construct_fields_empty(st.fields) && bind_list_empty(st.params);
}
fn construct_source_field_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ConstructSourceCheck) -> (result: ConstructSourceCheck) {
    if !(st.ok) { return st; }
    return match st.fields {
        CNil => ConstructSourceCheck { ..st, ok: bind_list_empty(st.params) },
        CCons { head: field, tail: rest } => construct_source_field_parameter<P, N>(pages, stride, total, st, field, rest)
    };
}
fn construct_source_field_parameter<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ConstructSourceCheck, field: ConstructField, rest: ConstructFieldList) -> (result: ConstructSourceCheck) {
    return match st.params {
        BindList.BNil => ConstructSourceCheck { ..st, fields: rest, ok: false },
        BindList.BCons { head: parameter, tail: params } => ConstructSourceCheck { fields: rest, params: params, ok: spans_equal<P, N>(pages, stride, total, field.field_start, field.field_end, parameter.start, parameter.end) }
    };
}
record BindCountScan { rest: BindList, count: u64 }
fn bind_list_empty(binds: BindList) -> (result: bool) { return match binds { BNil => true, BCons { head: h, tail: t } => false }; }
fn bind_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, binds: BindList) -> (result: u64) {
    iterate i up_to 1024 carrying st: BindCountScan = BindCountScan { rest: binds, count: 0 } {
        next st = bind_count_step(st);
    }
    return st.count;
}
fn bind_count_step(st: BindCountScan) -> (result: BindCountScan) {
    return match st.rest {
        BindList.BNil => st,
        BindList.BCons { head: h, tail: t } => BindCountScan { rest: t, count: st.count + 1 }
    };
}
// Arm operations are isolated proof frames (see verify_top_finite_match), so
// the parent stack consumes only the match subject; no arm-value popping
// remains.
fn verify_top_not<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType) -> (result: TDepth) {
    if !(sem_eq<P, N>(pages, stride, total, ty, SemType.TBool)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return match st.stack {
        WNil => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        WCons { head: operand, tail: rest } => verify_top_not_operand<P, N>(pages, stride, total, st, t, ty, operand, rest)
    };
}
fn verify_top_not_operand<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, operand: SemType, rest: TyStack) -> (result: TDepth) {
    if !(sem_eq<P, N>(pages, stride, total, operand, SemType.TBool)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: rest }, depth: st.depth, ok: true };
}
fn verify_top_push(st: TDepth, t: TOpList, ty: SemType) -> (result: TDepth) {
    if is_poison(ty) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: st.stack }, depth: st.depth + 1, ok: true };
}
fn verify_top_bin<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType) -> (result: TDepth) {
    if is_poison(ty) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return match st.stack {
        WNil => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        WCons { head: h1, tail: t1 } => verify_top_bin_inner<P, N>(pages, stride, total, st, t, ty, h1, t1)
    };
}
fn verify_top_bin_inner<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, h1: SemType, t1: TyStack) -> (result: TDepth) {
    return match t1 {
        WNil => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        WCons { head: h2, tail: t2 } => verify_top_bin_eq<P, N>(pages, stride, total, st, t, ty, h1, h2, t2)
    };
}
fn verify_top_bin_eq<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, h1: SemType, h2: SemType, t2: TyStack) -> (result: TDepth) {
    if !(sem_eq<P, N>(pages, stride, total, h1, h2)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: t2 }, depth: st.depth - 1, ok: true };
}
record PopN { rest: TyStack, n: u64, ok: bool }
fn pop_tys<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, stack: TyStack, n: u64) -> (result: PopN) {
    iterate i up_to 1024 carrying d: PopN = PopN { rest: stack, n: n, ok: true } {
        next d = pop_tys_step(d);
    }
    return d;
}
fn pop_tys_step(st: PopN) -> (result: PopN) {
    if !(st.ok) || st.n == 0 { return st; }
    return match st.rest {
        WNil => PopN { rest: TyStack.WNil, n: st.n, ok: false },
        WCons { head: h, tail: t } => PopN { rest: t, n: st.n - 1, ok: true }
    };
}
fn verify_top_call<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, ty: SemType, argc: u64, effects: EffectIdentityList, capabilities: CapabilityIdentityList) -> (result: TDepth) {
    if is_poison(ty) || !(signature_identity_valid<P, N>(pages, stride, total, effects, capabilities)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    if st.depth < argc { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    let popped: PopN = pop_tys<P, N>(pages, stride, total, st.stack, argc);
    if !(popped.ok) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: popped.rest }, depth: st.depth - argc + 1, ok: true };
}
fn verify_top_proj(st: TDepth, t: TOpList, ty: SemType) -> (result: TDepth) {
    if is_poison(ty) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return match st.stack {
        WNil => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        WCons { head: h, tail: t2 } => verify_top_proj_base(st, t, ty, h, t2)
    };
}
// Projection consumes a record-typed base: scalar, sequence, and poison
// bases are rejected even when the pushed result type looks plausible.
fn verify_top_proj_base(st: TDepth, t: TOpList, ty: SemType, base: SemType, rest: TyStack) -> (result: TDepth) {
    return match base {
        TNamed { start: ns, end: ne } => TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: rest }, depth: st.depth, ok: true },
        TBool => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        TByte => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        TInt { width: w, signed: g } => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        TSeq => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        TSeqExact { element: e, length: l, length_valid: v } => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false },
        TPoison => TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }
    };
}
fn finish_verify_tops<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, want: ExpTy) -> (result: bool) {
    if !(st.ok) { return false; }
    if st.depth != 1 { return false; }
    return match want {
        XNone => true,
        XSome { ty: ty } => finish_verify_want<P, N>(pages, stride, total, st, ty)
    };
}
fn finish_verify_want<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, ty: SemType) -> (result: bool) {
    return match st.stack {
        WNil => false,
        WCons { head: h, tail: t } => finish_verify_top<P, N>(pages, stride, total, h, ty)
    };
}
fn finish_verify_top<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, h: SemType, ty: SemType) -> (result: bool) {
    if is_poison(h) || is_poison(ty) { return false; }
    return sem_eq<P, N>(pages, stride, total, h, ty);
}
// Adversarial constructors: deliberately corrupted IR states built inside
// MNCS. Each must be rejected by its verifier; the sound sample must pass.
// The probe passes only source bytes, so no host-constructed values cross
// the boundary: construction and verdict both execute in MNCS.
fn sabotage_depth<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    let bad: FlatList = FlatList.ICons { head: FlatOp.PBin { op: 50 }, tail: FlatList.INil };
    return flat_ok<P, N>(pages, stride, total, bad);
}
fn sabotage_call_arity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    let bad: TOpList = TOpList.PCons { head: TOp.TCall { ty: SemType.TInt { width: 64, signed: false }, argc: 2, params: BindList.BNil, start: 0, end: 1, ns: 0, ne: 1, identity: invalid_semantic_identity(), effects: EffectIdentityList.EINil, capabilities: CapabilityIdentityList.CINil }, tail: TOpList.PNil };
    return verify_tops<P, N>(pages, stride, total, bad, ExpTy.XNone);
}
fn sabotage_bin_mismatch<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    let ints: SemType = SemType.TInt { width: 64, signed: false };
    let ops: TOpList = TOpList.PCons { head: TOp.TInt { value: 1, ty: ints, start: 0, end: 1 }, tail: TOpList.PCons { head: TOp.TBool { value: true, ty: SemType.TBool, start: 2, end: 6 }, tail: TOpList.PCons { head: TOp.TBin { op: 50, ty: ints, start: 0, end: 6 }, tail: TOpList.PNil } } };
    return verify_tops<P, N>(pages, stride, total, ops, ExpTy.XNone);
}
fn sabotage_final_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    let ops: TOpList = TOpList.PCons { head: TOp.TInt { value: 1, ty: SemType.TInt { width: 64, signed: false }, start: 0, end: 1 }, tail: TOpList.PNil };
    return verify_tops<P, N>(pages, stride, total, ops, ExpTy.XSome { ty: SemType.TBool });
}
fn sabotage_finite_match_arity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    let named: SemType = SemType.TNamed { start: 0, end: 1 };
    let arm_ops: TOpList = TOpList.PCons { head: TOp.TName { ty: SemType.TBool, start: 0, end: 1 }, tail: TOpList.PNil };
    let arm: TypedFiniteMatchArm = TypedFiniteMatchArm { variant_start: 0, variant_end: 1, has_payload: false, bindings: PayloadBindingList.YNil, pattern_start: 0, pattern_end: 1, payload_fields: BindList.BNil, ops: arm_ops, op_count: 1 };
    let arms: TypedFiniteMatchArmList = TypedFiniteMatchArmList.TFCons { head: arm, tail: TypedFiniteMatchArmList.TFNil };
    let ops: TOpList = TOpList.PCons { head: TOp.TName { ty: named, start: 0, end: 1 }, tail: TOpList.PCons { head: TOp.TFiniteMatch { ty: SemType.TBool, subject_ty: named, arms: arms, arm_count: 2, start: 0, end: 1 }, tail: TOpList.PNil } };
    return verify_tops<P, N>(pages, stride, total, ops, ExpTy.XNone);
}
fn sabotage_construct_arity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    let ops: TOpList = TOpList.PCons { head: TOp.TEnumConstruct { ty: SemType.TNamed { start: 0, end: 1 }, variant_start: 0, variant_end: 1, field_count: 1, params: BindList.BNil, start: 0, end: 1 }, tail: TOpList.PNil };
    return verify_tops<P, N>(pages, stride, total, ops, ExpTy.XNone);
}
fn sabotage_proj_base<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    let ints: SemType = SemType.TInt { width: 64, signed: false };
    let ops: TOpList = TOpList.PCons { head: TOp.TInt { value: 7, ty: ints, start: 0, end: 1 }, tail: TOpList.PCons { head: TOp.TProj { ty: ints, fstart: 0, fend: 1, field_index: 0, start: 0, end: 1 }, tail: TOpList.PNil } };
    return verify_tops<P, N>(pages, stride, total, ops, ExpTy.XNone);
}
fn sabotage_scalar_match_arity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    let ints: SemType = SemType.TInt { width: 64, signed: false };
    let arm_ops: TOpList = TOpList.PCons { head: TOp.TInt { value: 1, ty: ints, start: 0, end: 1 }, tail: TOpList.PNil };
    let arm: TypedScalarMatchArm = TypedScalarMatchArm { is_default: true, negative: false, value: 0, overflow: false, pattern_start: 0, pattern_end: 1, ops: arm_ops, op_count: 1 };
    let arms: TypedScalarMatchArmList = TypedScalarMatchArmList.TSCons { head: arm, tail: TypedScalarMatchArmList.TSNil };
    let ops: TOpList = TOpList.PCons { head: TOp.TName { ty: ints, start: 0, end: 1 }, tail: TOpList.PCons { head: TOp.TMatch { ty: ints, subject_ty: ints, arms: arms, arm_count: 2, default_count: 1, start: 0, end: 1 }, tail: TOpList.PNil } };
    return verify_tops<P, N>(pages, stride, total, ops, ExpTy.XNone);
}
fn sound_sample<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {

    let ints: SemType = SemType.TInt { width: 64, signed: false };
    let ops: TOpList = TOpList.PCons { head: TOp.TInt { value: 1, ty: ints, start: 0, end: 1 }, tail: TOpList.PCons { head: TOp.TInt { value: 2, ty: ints, start: 4, end: 5 }, tail: TOpList.PCons { head: TOp.TBin { op: 50, ty: ints, start: 0, end: 5 }, tail: TOpList.PNil } } };
    return verify_tops<P, N>(pages, stride, total, ops, ExpTy.XSome { ty: ints });
}

// Bidirectional expression checking as an explicit-stack machine (MNE130
// forbids the recursive descent this algorithm wants to be). Each job
// carries its required type downward; each continuation resumes the parent
// when a child type is established. A hard failure (unresolvable name,
// arity, class violation) drains the machine; a mismatch against a
// required type records its obligation and continues with the actual
// type, mirroring Stage-0 elaboration. Checking and typed lowering are
// fused: every established node emits its typed operation, so the typed
// IR is produced BY the proof, not after it.
record SemJob { e: Expr, exp: ExpTy }
enum JobList { JNil, JCons { head: SemJob, tail: JobList } }
// One checked construction field value: unknown-field values are never
// scheduled (Stage-0 skips them), so every job carries its requirement.
record ConstructJob { value: Expr, ty: SemType, vs: u64, ve: u64 }
enum ConstructJobList { CJNil, CJCons { head: ConstructJob, tail: ConstructJobList } }
enum SemKont {
    KTop,
    KNot { start: u64, end: u64, exp: ExpTy },
    KRepeat { count: u64, start: u64, end: u64, exp: ExpTy },
    KMatchArm { remaining: ScalarMatchArmList, current: ScalarMatchArm, completed: TypedScalarMatchArmList, prior_tops: u64, subject_ty: SemType, result_ty: SemType, arm_count: u64, default_count: u64, rs: u64, re: u64, start: u64, end: u64 },
    KFiniteSubject { arms: FiniteMatchArmList, result_ty: SemType, ss: u64, se: u64, start: u64, end: u64 },
    KFiniteArm { remaining: FiniteMatchArmList, all: FiniteMatchArmList, current: FiniteMatchArm, completed: TypedFiniteMatchArmList, payload_fields: BindList, prior_tops: u64, subject_ty: SemType, es: u64, ee: u64, result_ty: SemType, arm_count: u64, env: ScopeStack, rs: u64, re: u64, start: u64, end: u64 },
    KConstructField { remaining: ConstructJobList, total: u64, ty: SemType, params: BindList, vs: u64, ve: u64, cty: SemType, cvs: u64, cve: u64, shape_ok: bool, start: u64, end: u64, exp: ExpTy },
    KBinL { op: u64, right: Expr, start: u64, end: u64, exp: ExpTy },
    KBinR { op: u64, lty: SemType, start: u64, end: u64, rlit: bool, exp: ExpTy },
    KCallA { sig: Sig, args: ExprList, ptys: TyList, start: u64, end: u64, exp: ExpTy },
    KProj { fstart: u64, fend: u64, bstart: u64, bend: u64, start: u64, end: u64, exp: ExpTy },
    KOpA { slot: u64, ns: u64, ne: u64, args: ExprList, index: u64, start: u64, end: u64, exp: ExpTy }
}
enum KontList { QNil, QCons { head: SemKont, tail: KontList } }
record SemState { jobs: JobList, konts: KontList, obls: OblList, tops: TOpList, last_ty: SemType, top_ty: SemType, failed: bool, env: ScopeStack, sigs: SigTab, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList, effects: EffectIdentityList, caller_fx: EffectList, caller_caps: CapList, gparams: GenericParamList, total: u64 }
record ExprRes { ty: SemType, ok: bool, obls: OblList, tops: TOpList }
fn prove_expr<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, env: ScopeStack, sigs: SigTab, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList, effects: EffectIdentityList, caller_fx: EffectList, caller_caps: CapList, gparams: GenericParamList, e: Expr, exp: ExpTy) -> (result: ExprRes) {

    iterate i up_to 1024 carrying d: SemState = SemState { jobs: JobList.JCons { head: SemJob { e: e, exp: exp }, tail: JobList.JNil }, konts: KontList.QCons { head: SemKont.KTop, tail: KontList.QNil }, obls: OblList.LNil, tops: TOpList.PNil, last_ty: SemType.TPoison, top_ty: SemType.TPoison, failed: false, env: env, sigs: sigs, rectab: rectab, enumtab: enumtab, nominals: nominals, effects: effects, caller_fx: caller_fx, caller_caps: caller_caps, gparams: gparams, total: total } {
        next d = sem_step<P, N>(pages, stride, total, d);
    }
    return finish_prove_expr<P, N>(pages, stride, total, d);
}
fn finish_prove_expr<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState) -> (result: ExprRes) {
    if st.failed { return ExprRes { ty: SemType.TPoison, ok: false, obls: reverse_obls<P, N>(pages, stride, total, st.obls), tops: TOpList.PNil }; }
    return ExprRes { ty: st.top_ty, ok: true, obls: reverse_obls<P, N>(pages, stride, total, st.obls), tops: reverse_tops<P, N>(pages, stride, total, st.tops) };
}
fn sem_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState) -> (result: SemState) {
    if st.failed { return st; }
    return match st.jobs {
        JCons { head: j, tail: t } => sem_job<P, N>(pages, stride, total, SemState { ..st, jobs: t }, j),
        JNil => sem_kont_empty<P, N>(pages, stride, total, st)
    };
}
fn sem_kont_empty<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState) -> (result: SemState) {
    return match st.konts {
        QNil => st,
        QCons { head: k, tail: t } => apply_kont<P, N>(pages, stride, total, SemState { ..st, konts: t }, k)
    };
}
fn sem_emit(st: SemState, kind: u64, start: u64, end: u64, status: u64) -> (result: SemState) {
    return SemState { ..st, obls: OblList.LCons { head: Obligation { kind: kind, start: start, end: end, status: status }, tail: st.obls } };
}
fn sem_emit_top(st: SemState, top: TOp) -> (result: SemState) {
    return SemState { ..st, tops: TOpList.PCons { head: top, tail: st.tops } };
}
fn sem_drain(st: SemState) -> (result: SemState) {
    return SemState { ..st, jobs: JobList.JNil, konts: KontList.QNil, failed: true };
}
fn sem_accept(st: SemState, ty: SemType) -> (result: SemState) {
    return SemState { ..st, last_ty: ty };
}
fn sem_job<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, job: SemJob) -> (result: SemState) {
    return match job.e {
        Name { start: s, end: e } => finish_name<P, N>(pages, stride, total, st, s, e, job.exp),
        Integer { start: s, end: e, value: v, overflow: o } => finish_int(st, v, s, e, job.exp),
        Boolean { start: s, end: e, value: v } => finish_bool(st, v, s, e, job.exp),
        UnaryNot { value: value, start: s, end: e } => seed_not(st, value, s, e, job.exp),
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => seed_repeat<P, N>(pages, stride, total, st, value, cs, ce, ck, s, e, job.exp),
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => seed_scalar_match<P, N>(pages, stride, total, st, subject, arms, s, e, job.exp),
        Binary { op: o, left: l, right: r, start: s, end: e } => seed_binop(st, o, l, r, s, e, job.exp),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e } => seed_call<P, N>(pages, stride, total, st, ns, ne, a, tg, s, e, job.exp),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => seed_proj<P, N>(pages, stride, total, st, b, fs, fe, s, e, job.exp),
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => seed_finite_match<P, N>(pages, stride, total, st, subject, arms, s, e, job.exp),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => seed_enum_construct<P, N>(pages, stride, total, st, ts, te, vs, ve, f, s, e, job.exp),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => seed_record_construct(st, s, e),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => seed_op<P, N>(pages, stride, total, st, slot, ns, ne, a, s, e, job.exp)
    };
}
fn seed_scalar_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, subject: Expr, arms: ScalarMatchArmList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => sem_drain(sem_emit(st, 2, start, end, 1)),
        XSome { ty: result_ty } => seed_scalar_match_subject<P, N>(pages, stride, total, st, subject, arms, start, end, result_ty)
    };
}
fn seed_scalar_match_subject<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, subject: Expr, arms: ScalarMatchArmList, start: u64, end: u64, result_ty: SemType) -> (result: SemState) {
    return match subject {
        Name { start: ns, end: ne } => seed_scalar_match_name<P, N>(pages, stride, total, st, arms, start, end, result_ty, ns, ne),
        Integer { start: s, end: e, value: v, overflow: o } => sem_drain(sem_emit(st, 2, s, e, 1)),
        Boolean { start: s, end: e, value: v } => sem_drain(sem_emit(st, 2, s, e, 1)),
        UnaryNot { value: v, start: s, end: e } => sem_drain(sem_emit(st, 2, s, e, 1)),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => sem_drain(sem_emit(st, 2, s, e, 1)),
        ScalarMatch { subject: value, arms: nested, start: s, end: e } => sem_drain(sem_emit(st, 2, s, e, 1)),
        Binary { op: op, left: l, right: r, start: s, end: e } => sem_drain(sem_emit(st, 2, s, e, 1)),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e } => sem_drain(sem_emit(st, 2, s, e, 1)),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => sem_drain(sem_emit(st, 2, s, e, 1)),
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => sem_drain(sem_emit(st, 2, s, e, 1)),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => sem_drain(sem_emit(st, 2, s, e, 1)),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => sem_drain(sem_emit(st, 2, s, e, 1)),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => sem_drain(sem_emit(st, 2, s, e, 1))
    };
}
fn seed_scalar_match_name<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arms: ScalarMatchArmList, start: u64, end: u64, result_ty: SemType, ns: u64, ne: u64) -> (result: SemState) {
    let subject: LookupRes = env_lookup<P, N>(pages, stride, total, st.env, ns, ne);
    if !(subject.found) { return sem_drain(sem_emit(st, 1, ns, ne, 1)); }
    return seed_scalar_match_subject_ty<P, N>(pages, stride, total, st, arms, start, end, result_ty, subject.ty, ns, ne);
}
fn seed_scalar_match_subject_ty<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arms: ScalarMatchArmList, start: u64, end: u64, result_ty: SemType, subject_ty: SemType, ns: u64, ne: u64) -> (result: SemState) {
    return match subject_ty {
        TInt { width: w, signed: g } => seed_scalar_match_int<P, N>(pages, stride, total, st, arms, start, end, result_ty, subject_ty, ns, ne),
        TBool => sem_drain(sem_emit_scalar_arm_mismatch<P, N>(pages, stride, total, st, arms, start, end)),
        TNamed { start: es, end: ee } => seed_scalar_match_named<P, N>(pages, stride, total, st, arms, start, end, es, ee, ns, ne),
        TByte => sem_drain(sem_emit(st, 2, start, end, 1)),
        TSeq => sem_drain(sem_emit(st, 2, start, end, 1)),
        TSeqExact { element: element, length: length, length_valid: valid } => sem_drain(sem_emit(st, 2, start, end, 1)),
        TPoison => sem_drain(sem_emit(st, 2, start, end, 1))
    };
}
fn seed_scalar_match_named<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arms: ScalarMatchArmList, start: u64, end: u64, es: u64, ee: u64, ns: u64, ne: u64) -> (result: SemState) {
    let found: EnumFind = enum_lookup<P, N>(pages, stride, total, st.enumtab, es, ee);
    if found.found { return sem_drain(sem_emit_scalar_arm_mismatch<P, N>(pages, stride, total, st, arms, start, end)); }
    let rec: RecFind = rec_lookup<P, N>(pages, stride, total, st.rectab, es, ee);
    if rec.found { return sem_drain(sem_emit(st, 51, ns, ne, 1)); }
    return sem_drain(sem_emit(st, 2, start, end, 1));
}
fn seed_scalar_match_int<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arms: ScalarMatchArmList, start: u64, end: u64, result_ty: SemType, subject_ty: SemType, ns: u64, ne: u64) -> (result: SemState) {
    if !(scalar_match_patterns_ok<P, N>(pages, stride, total, arms, subject_ty)) { return sem_drain(sem_emit(st, 2, start, end, 1)); }
    let count: ScalarMatchCount = scalar_match_count<P, N>(pages, stride, total, arms);
    if count.defaults != 1 || count.n == 0 { return sem_drain(sem_emit(st, 2, start, end, 1)); }
    let subject_top: TOp = TOp.TName { ty: subject_ty, start: ns, end: ne };
    let st1: SemState = sem_emit_top(sem_accept(st, subject_ty), subject_top);
    return seed_scalar_match_arm<P, N>(pages, stride, total, st1, arms, subject_ty, result_ty, count.n, count.defaults, start, end);
}
// Scalar patterns against a bool or finite subject: every arm misfits and
// coverage fails, exactly the Stage-0 MNE138-per-arm plus MNE140 shape.
record ScalarMismatchScan { rest: ScalarMatchArmList, obls: OblList }
fn sem_emit_scalar_arm_mismatch<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arms: ScalarMatchArmList, start: u64, end: u64) -> (result: SemState) {
    iterate i up_to 1024 carrying d: ScalarMismatchScan = ScalarMismatchScan { rest: arms, obls: st.obls } {
        next d = scalar_mismatch_step(d);
    }
    return SemState { ..st, obls: OblList.LCons { head: Obligation { kind: 40, start: start, end: end, status: 1 }, tail: d.obls } };
}
fn scalar_mismatch_step(st: ScalarMismatchScan) -> (result: ScalarMismatchScan) {
    return match st.rest {
        MNil => st,
        MCons { head: arm, tail: rest } => ScalarMismatchScan { rest: rest, obls: OblList.LCons { head: Obligation { kind: 38, start: arm.pattern_start, end: arm.pattern_end, status: 1 }, tail: st.obls } }
    };
}
fn seed_scalar_match_arm<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, remaining: ScalarMatchArmList, subject_ty: SemType, result_ty: SemType, arm_count: u64, default_count: u64, start: u64, end: u64) -> (result: SemState) {
    return match remaining {
        MNil => sem_drain(st),
        MCons { head: arm, tail: rest } => push_scalar_match_job<P, N>(pages, stride, total, st, arm, rest, TypedScalarMatchArmList.TSNil, subject_ty, result_ty, arm_count, default_count, start, end)
    };
}
fn push_scalar_match_job<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arm: ScalarMatchArm, remaining: ScalarMatchArmList, completed: TypedScalarMatchArmList, subject_ty: SemType, result_ty: SemType, arm_count: u64, default_count: u64, start: u64, end: u64) -> (result: SemState) {
    let vsp: ExprSpan = expr_span(arm.result);
    let prior_tops: u64 = count_tops<P, N>(pages, stride, total, st.tops);
    let job: SemJob = SemJob { e: arm.result, exp: ExpTy.XSome { ty: result_ty } };
    let kont: SemKont = SemKont.KMatchArm { remaining: remaining, current: arm, completed: completed, prior_tops: prior_tops, subject_ty: subject_ty, result_ty: result_ty, arm_count: arm_count, default_count: default_count, rs: vsp.start, re: vsp.end, start: start, end: end };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn continue_scalar_match_arm<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, remaining: ScalarMatchArmList, current: ScalarMatchArm, completed: TypedScalarMatchArmList, prior_tops: u64, subject_ty: SemType, result_ty: SemType, arm_count: u64, default_count: u64, rs: u64, re: u64, start: u64, end: u64) -> (result: SemState) {
    let checked: SemState = arm_result_check<P, N>(pages, stride, total, st, result_ty, rs, re);
    let total_tops: u64 = count_tops<P, N>(pages, stride, total, checked.tops);
    let delta: u64 = select(total_tops >= prior_tops, total_tops - prior_tops, 0);
    let split: TopsPrefixSplit = split_tops_prefix<P, N>(pages, stride, total, checked.tops, delta);
    let arm_ops: TOpList = split.taken;
    let typed_arm: TypedScalarMatchArm = TypedScalarMatchArm { is_default: current.is_default, negative: current.negative, value: current.value, overflow: current.overflow, pattern_start: current.pattern_start, pattern_end: current.pattern_end, ops: arm_ops, op_count: count_tops<P, N>(pages, stride, total, arm_ops) };
    let completed_next: TypedScalarMatchArmList = TypedScalarMatchArmList.TSCons { head: typed_arm, tail: completed };
    let restored: SemState = SemState { ..checked, tops: split.rest, failed: checked.failed || total_tops < prior_tops || !(split.ok) };
    return match remaining {
        MNil => finish_scalar_match<P, N>(pages, stride, total, restored, completed_next, subject_ty, result_ty, arm_count, default_count, start, end),
        MCons { head: arm, tail: rest } => push_scalar_match_job<P, N>(pages, stride, total, restored, arm, rest, completed_next, subject_ty, result_ty, arm_count, default_count, start, end)
    };
}
// An arm result whose established type differs from the match requirement
// records MNE141 alongside the inner mismatch the child already reported.
fn arm_result_check<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, result_ty: SemType, rs: u64, re: u64) -> (result: SemState) {
    if sem_eq<P, N>(pages, stride, total, st.last_ty, result_ty) { return st; }
    return sem_emit(st, 41, rs, re, 1);
}
fn finish_scalar_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, completed: TypedScalarMatchArmList, subject_ty: SemType, result_ty: SemType, arm_count: u64, default_count: u64, start: u64, end: u64) -> (result: SemState) {
    let arms: TypedScalarMatchArmList = reverse_typed_scalar_match_arms<P, N>(pages, stride, total, completed);
    let top: TOp = TOp.TMatch { ty: result_ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, default_count: default_count, start: start, end: end };
    return sem_emit_top(sem_accept(st, result_ty), top);
}
// Finite-match checking. The subject proves as a general expression; the
// continuation dispatches on its established type. Arm patterns and
// coverage are fully checked before any arm result proves: a pattern or
// coverage failure drains without checking results, exactly the Stage-0
// shape (MNE138/MNE139/MNE179 arms never report result errors).
fn seed_finite_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, subject: Expr, arms: FiniteMatchArmList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => sem_drain(sem_emit(st, 2, start, end, 1)),
        XSome { ty: result_ty } => seed_finite_match_subject(st, subject, arms, result_ty, start, end)
    };
}
fn seed_finite_match_subject(st: SemState, subject: Expr, arms: FiniteMatchArmList, result_ty: SemType, start: u64, end: u64) -> (result: SemState) {
    let ssp: ExprSpan = expr_span(subject);
    let job: SemJob = SemJob { e: subject, exp: ExpTy.XNone };
    let kont: SemKont = SemKont.KFiniteSubject { arms: arms, result_ty: result_ty, ss: ssp.start, se: ssp.end, start: start, end: end };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn apply_finite_subject<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arms: FiniteMatchArmList, result_ty: SemType, ss: u64, se: u64, start: u64, end: u64) -> (result: SemState) {
    let sty: SemType = st.last_ty;
    if is_poison(sty) { return sem_drain(sem_emit(st, 2, ss, se, 1)); }
    return match sty {
        TNamed { start: ns, end: ne } => apply_finite_named<P, N>(pages, stride, total, st, arms, result_ty, sty, ns, ne, ss, se, start, end),
        TInt { width: w, signed: g } => sem_drain(sem_emit(st, 51, ss, se, 1)),
        TBool => sem_drain(sem_emit_finite_arm_mismatch<P, N>(pages, stride, total, st, arms, start, end)),
        TByte => sem_drain(sem_emit(st, 51, ss, se, 1)),
        TSeq => sem_drain(sem_emit(st, 51, ss, se, 1)),
        TSeqExact { element: element, length: length, length_valid: valid } => sem_drain(sem_emit(st, 51, ss, se, 1)),
        TPoison => sem_drain(sem_emit(st, 2, start, end, 1))
    };
}
fn apply_finite_named<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arms: FiniteMatchArmList, result_ty: SemType, sty: SemType, ns: u64, ne: u64, ss: u64, se: u64, start: u64, end: u64) -> (result: SemState) {
    let found: EnumFind = enum_lookup<P, N>(pages, stride, total, st.enumtab, ns, ne);
    if found.found { return check_finite_arms<P, N>(pages, stride, total, st, arms, found.decl, result_ty, sty, ns, ne, start, end); }
    let rec: RecFind = rec_lookup<P, N>(pages, stride, total, st.rectab, ns, ne);
    if rec.found { return sem_drain(sem_emit(st, 51, ss, se, 1)); }
    return sem_drain(sem_emit(st, 40, start, end, 1));
}
record FiniteMismatchScan { rest: FiniteMatchArmList, obls: OblList }
fn sem_emit_finite_arm_mismatch<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arms: FiniteMatchArmList, start: u64, end: u64) -> (result: SemState) {
    iterate i up_to 1024 carrying d: FiniteMismatchScan = FiniteMismatchScan { rest: arms, obls: st.obls } {
        next d = finite_mismatch_step(d);
    }
    return SemState { ..st, obls: OblList.LCons { head: Obligation { kind: 40, start: start, end: end, status: 1 }, tail: d.obls } };
}
fn finite_mismatch_step(st: FiniteMismatchScan) -> (result: FiniteMismatchScan) {
    return match st.rest {
        ANil => st,
        ACons { head: arm, tail: rest } => FiniteMismatchScan { rest: rest, obls: OblList.LCons { head: Obligation { kind: 38, start: arm.variant_start, end: arm.variant_end, status: 1 }, tail: st.obls } }
    };
}
// Arm pattern checking in source order: variant identity, duplicate arms,
// payload binding names, then payload shape. Coverage counts arms whose
// variant is established with a sound shape; field-level binding errors do
// not remove an arm from coverage, matching Stage-0.
record FiniteArmCheck { rest: FiniteMatchArmList, seen: NameList, covered: NameList, obls: OblList, failed: bool }
fn check_finite_arms<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arms: FiniteMatchArmList, decl: EnumDecl, result_ty: SemType, subject_ty: SemType, es: u64, ee: u64, start: u64, end: u64) -> (result: SemState) {
    iterate i up_to 1024 carrying d: FiniteArmCheck = FiniteArmCheck { rest: arms, seen: NameList.NNil, covered: NameList.NNil, obls: st.obls, failed: false } {
        next d = finite_arm_check_step<P, N>(pages, stride, total, d, decl);
    }
    let covered: FiniteArmCheck = finite_coverage_check<P, N>(pages, stride, total, d, decl, start, end);
    let st1: SemState = SemState { ..st, obls: covered.obls };
    if covered.failed { return sem_drain(st1); }
    let count: FiniteMatchCount = finite_match_count<P, N>(pages, stride, total, arms);
    return seed_finite_match_arm<P, N>(pages, stride, total, st1, arms, arms, decl, subject_ty, es, ee, result_ty, count.n, start, end);
}
fn finite_arm_check_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FiniteArmCheck, decl: EnumDecl) -> (result: FiniteArmCheck) {
    return match st.rest {
        ANil => st,
        ACons { head: arm, tail: rest } => check_one_finite_arm<P, N>(pages, stride, total, st, decl, arm, rest)
    };
}
fn check_one_finite_arm<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FiniteArmCheck, decl: EnumDecl, arm: FiniteMatchArm, rest: FiniteMatchArmList) -> (result: FiniteArmCheck) {
    let found: VariantScan = variant_scan<P, N>(pages, stride, total, decl.variants, arm.variant_start, arm.variant_end);
    if !(found.found) { return FiniteArmCheck { rest: rest, seen: st.seen, covered: st.covered, obls: OblList.LCons { head: Obligation { kind: 38, start: arm.variant_start, end: arm.variant_end, status: 1 }, tail: st.obls }, failed: true }; }
    if name_known<P, N>(pages, stride, total, st.seen, arm.variant_start, arm.variant_end) { return FiniteArmCheck { rest: rest, seen: st.seen, covered: st.covered, obls: OblList.LCons { head: Obligation { kind: 39, start: arm.variant_start, end: arm.variant_end, status: 1 }, tail: st.obls }, failed: true }; }
    let seen: NameList = NameList.NCons { head: NameSpan { start: arm.variant_start, end: arm.variant_end }, tail: st.seen };
    let bound: PayloadBound = check_payload_bindings<P, N>(pages, stride, total, found.variant.fields, arm.bindings);
    let obls: OblList = append_obls<P, N>(pages, stride, total, reverse_obls<P, N>(pages, stride, total, bound.obls), st.obls);
    let shape_ok: bool = payload_shape_ok<P, N>(pages, stride, total, found.variant.fields, bound.bound);
    if !(shape_ok) { return FiniteArmCheck { rest: rest, seen: seen, covered: st.covered, obls: OblList.LCons { head: Obligation { kind: 47, start: arm.variant_start, end: arm.variant_end, status: 1 }, tail: obls }, failed: true }; }
    let failed: bool = st.failed || bound.failed;
    let covered: NameList = NameList.NCons { head: NameSpan { start: arm.variant_start, end: arm.variant_end }, tail: st.covered };
    return FiniteArmCheck { rest: rest, seen: seen, covered: covered, obls: obls, failed: failed };
}
record PayloadBoundScan { rest: PayloadBindingList, bound: NameList, obls: OblList, failed: bool }
record PayloadBound { bound: NameList, obls: OblList, failed: bool }
fn check_payload_bindings<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList, bindings: PayloadBindingList) -> (result: PayloadBound) {
    iterate i up_to 1024 carrying d: PayloadBoundScan = PayloadBoundScan { rest: bindings, bound: NameList.NNil, obls: OblList.LNil, failed: false } {
        next d = payload_bound_step<P, N>(pages, stride, total, d, fields);
    }
    return PayloadBound { bound: d.bound, obls: d.obls, failed: d.failed };
}
fn payload_bound_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadBoundScan, fields: FieldList) -> (result: PayloadBoundScan) {
    return match st.rest {
        YNil => st,
        YCons { head: binding, tail: rest } => check_one_payload_binding<P, N>(pages, stride, total, st, fields, binding, rest)
    };
}
fn check_one_payload_binding<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadBoundScan, fields: FieldList, binding: PayloadBinding, rest: PayloadBindingList) -> (result: PayloadBoundScan) {
    let found: FieldScan = field_scan<P, N>(pages, stride, total, fields, binding.field_start, binding.field_end);
    if !(found.found) { return PayloadBoundScan { rest: rest, bound: st.bound, obls: OblList.LCons { head: Obligation { kind: 44, start: binding.field_start, end: binding.field_end, status: 1 }, tail: st.obls }, failed: true }; }
    if name_known<P, N>(pages, stride, total, st.bound, binding.field_start, binding.field_end) { return PayloadBoundScan { rest: rest, bound: st.bound, obls: OblList.LCons { head: Obligation { kind: 46, start: binding.field_start, end: binding.field_end, status: 1 }, tail: st.obls }, failed: true }; }
    let bound: NameList = NameList.NCons { head: NameSpan { start: binding.field_start, end: binding.field_end }, tail: st.bound };
    return PayloadBoundScan { rest: rest, bound: bound, obls: st.obls, failed: st.failed };
}
record PayloadShapeScan { rest: FieldList, bound: NameList, ok: bool }
fn payload_shape_ok<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList, bound: NameList) -> (result: bool) {
    iterate i up_to 1024 carrying d: PayloadShapeScan = PayloadShapeScan { rest: fields, bound: bound, ok: true } {
        next d = payload_shape_step<P, N>(pages, stride, total, d);
    }
    return d.ok;
}
fn payload_shape_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadShapeScan) -> (result: PayloadShapeScan) {
    if !(st.ok) { return st; }
    return match st.rest {
        FNil => st,
        FCons { head: field, tail: rest } => PayloadShapeScan { rest: rest, bound: st.bound, ok: name_known<P, N>(pages, stride, total, st.bound, field.name_start, field.name_end) }
    };
}
record PayloadTypeScan { rest: FieldList, acc: BindList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList }
fn payload_field_types<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: BindList) {
    iterate i up_to 1024 carrying st: PayloadTypeScan = PayloadTypeScan { rest: fields, acc: BindList.BNil, rectab: rectab, enumtab: enumtab, nominals: nominals } {
        next st = payload_field_type_step<P, N>(pages, stride, total, st);
    }
    return reverse_binds<P, N>(pages, stride, total, st.acc);
}
fn payload_field_type_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadTypeScan) -> (result: PayloadTypeScan) {
    return match st.rest {
        FNil => st,
        FCons { head: field, tail: rest } => payload_field_type_one<P, N>(pages, stride, total, st, field, rest)
    };
}
fn payload_field_type_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadTypeScan, field: Field, rest: FieldList) -> (result: PayloadTypeScan) {
    let resolved: TyRes = resolve_type<P, N>(pages, stride, total, field.type_kind, field.type_start, field.type_end, st.rectab, st.enumtab, st.nominals);
    let bind: Bind = Bind { start: field.name_start, end: field.name_end, ty: arm_binding_ty(resolved) };
    return PayloadTypeScan { rest: rest, acc: BindList.BCons { head: bind, tail: st.acc }, rectab: st.rectab, enumtab: st.enumtab, nominals: st.nominals };
}
record PayloadBindingCount { rest: PayloadBindingList, count: u64 }
fn payload_binding_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, bindings: PayloadBindingList) -> (result: u64) {
    iterate i up_to 1024 carrying st: PayloadBindingCount = PayloadBindingCount { rest: bindings, count: 0 } { next st = payload_binding_count_step(st); }
    return st.count;
}
fn payload_binding_count_step(st: PayloadBindingCount) -> (result: PayloadBindingCount) {
    return match st.rest { YNil => st, YCons { head: h, tail: t } => PayloadBindingCount { rest: t, count: st.count + 1 } };
}
record PayloadBindingMatch { rest: PayloadBindingList, fields: BindList, ok: bool }
fn payload_bindings_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, bindings: PayloadBindingList, fields: BindList) -> (result: bool) {
    iterate i up_to 1024 carrying st: PayloadBindingMatch = PayloadBindingMatch { rest: bindings, fields: fields, ok: true } { next st = payload_binding_match_step<P, N>(pages, stride, total, st); }
    return st.ok && payload_binding_list_empty(st.rest);
}
fn payload_binding_list_empty(bindings: PayloadBindingList) -> (result: bool) { return match bindings { YNil => true, YCons { head: h, tail: t } => false }; }
fn payload_binding_match_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadBindingMatch) -> (result: PayloadBindingMatch) {
    if !(st.ok) { return st; }
    return match st.rest {
        YNil => st,
        YCons { head: binding, tail: rest } => payload_binding_match_one<P, N>(pages, stride, total, st, binding, rest)
    };
}
fn payload_binding_match_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadBindingMatch, binding: PayloadBinding, rest: PayloadBindingList) -> (result: PayloadBindingMatch) {
    let found: bool = payload_field_binding_known<P, N>(pages, stride, total, st.fields, binding.field_start, binding.field_end);
    return PayloadBindingMatch { rest: rest, fields: st.fields, ok: found };
}
record PayloadFieldLookup { rest: BindList, start: u64, end: u64, found: bool }
fn payload_field_binding_known<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: BindList, start: u64, end: u64) -> (result: bool) {
    iterate i up_to 1024 carrying st: PayloadFieldLookup = PayloadFieldLookup { rest: fields, start: start, end: end, found: false } { next st = payload_field_binding_step<P, N>(pages, stride, total, st); }
    return st.found;
}
fn payload_field_binding_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadFieldLookup) -> (result: PayloadFieldLookup) {
    if st.found { return st; }
    return match st.rest {
        BNil => st,
        BCons { head: field, tail: rest } => PayloadFieldLookup { rest: rest, start: st.start, end: st.end, found: spans_equal<P, N>(pages, stride, total, field.start, field.end, st.start, st.end) }
    };
}
record CoverageScan { rest: VariantList, covered: NameList, ok: bool }
fn finite_coverage_check<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FiniteArmCheck, decl: EnumDecl, start: u64, end: u64) -> (result: FiniteArmCheck) {
    iterate i up_to 1024 carrying d: CoverageScan = CoverageScan { rest: decl.variants, covered: st.covered, ok: true } {
        next d = coverage_scan_step<P, N>(pages, stride, total, d);
    }
    if d.ok { return st; }
    return FiniteArmCheck { rest: FiniteMatchArmList.ANil, seen: st.seen, covered: st.covered, obls: OblList.LCons { head: Obligation { kind: 40, start: start, end: end, status: 1 }, tail: st.obls }, failed: true };
}
fn coverage_scan_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CoverageScan) -> (result: CoverageScan) {
    if !(st.ok) { return st; }
    return match st.rest {
        VNil => st,
        VCons { head: variant, tail: rest } => CoverageScan { rest: rest, covered: st.covered, ok: name_known<P, N>(pages, stride, total, st.covered, variant.name_start, variant.name_end) }
    };
}
// Arm results prove in order, each under a pushed scope carrying that arm's
// payload bindings. Bindings install in reverse so a repeated name keeps the
// LAST binding, matching Stage-0; the scope is discarded before the next
// arm, so bindings never leak across arms.
fn seed_finite_match_arm<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, remaining: FiniteMatchArmList, all: FiniteMatchArmList, decl: EnumDecl, subject_ty: SemType, es: u64, ee: u64, result_ty: SemType, arm_count: u64, start: u64, end: u64) -> (result: SemState) {
    return match remaining {
        ANil => sem_drain(sem_emit(st, 40, start, end, 1)),
        ACons { head: arm, tail: rest } => push_finite_match_job<P, N>(pages, stride, total, st, arm, rest, all, TypedFiniteMatchArmList.TFNil, decl, subject_ty, es, ee, result_ty, arm_count, start, end)
    };
}
fn push_finite_match_job<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arm: FiniteMatchArm, remaining: FiniteMatchArmList, all: FiniteMatchArmList, completed: TypedFiniteMatchArmList, decl: EnumDecl, subject_ty: SemType, es: u64, ee: u64, result_ty: SemType, arm_count: u64, start: u64, end: u64) -> (result: SemState) {
    let vsp: ExprSpan = expr_span(arm.result);
    let found: VariantScan = variant_scan<P, N>(pages, stride, total, decl.variants, arm.variant_start, arm.variant_end);
    let scoped: ScopeStack = bind_arm_scope<P, N>(pages, stride, total, push_scope(st.env), found.variant.fields, arm.bindings, st.rectab, st.enumtab, st.nominals);
    let payload_fields: BindList = payload_field_types<P, N>(pages, stride, total, found.variant.fields, st.rectab, st.enumtab, st.nominals);
    let prior_tops: u64 = count_tops<P, N>(pages, stride, total, st.tops);
    let job: SemJob = SemJob { e: arm.result, exp: ExpTy.XSome { ty: result_ty } };
    let kont: SemKont = SemKont.KFiniteArm { remaining: remaining, all: all, current: arm, completed: completed, payload_fields: payload_fields, prior_tops: prior_tops, subject_ty: subject_ty, es: es, ee: ee, result_ty: result_ty, arm_count: arm_count, env: st.env, rs: vsp.start, re: vsp.end, start: start, end: end };
    return SemState { ..st, env: scoped, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn continue_finite_match_arm<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, remaining: FiniteMatchArmList, all: FiniteMatchArmList, current: FiniteMatchArm, completed: TypedFiniteMatchArmList, payload_fields: BindList, prior_tops: u64, subject_ty: SemType, es: u64, ee: u64, result_ty: SemType, arm_count: u64, env: ScopeStack, rs: u64, re: u64, start: u64, end: u64) -> (result: SemState) {
    let checked: SemState = arm_result_check<P, N>(pages, stride, total, st, result_ty, rs, re);
    let total_tops: u64 = count_tops<P, N>(pages, stride, total, checked.tops);
    let delta: u64 = select(total_tops >= prior_tops, total_tops - prior_tops, 0);
    let split: TopsPrefixSplit = split_tops_prefix<P, N>(pages, stride, total, checked.tops, delta);
    // split_tops_prefix prepends each consumed operation, converting the
    // semantic accumulator's reverse order back to executable postfix order.
    let arm_ops: TOpList = split.taken;
    let typed_arm: TypedFiniteMatchArm = TypedFiniteMatchArm { variant_start: current.variant_start, variant_end: current.variant_end, has_payload: current.has_payload, bindings: current.bindings, pattern_start: current.pattern_start, pattern_end: current.pattern_end, payload_fields: payload_fields, ops: arm_ops, op_count: count_tops<P, N>(pages, stride, total, arm_ops) };
    let completed_next: TypedFiniteMatchArmList = TypedFiniteMatchArmList.TFCons { head: typed_arm, tail: completed };
    let restored: SemState = SemState { ..checked, tops: split.rest, env: env, failed: checked.failed || total_tops < prior_tops || !(split.ok) };
    return match remaining {
        ANil => finish_finite_match<P, N>(pages, stride, total, restored, completed_next, subject_ty, result_ty, arm_count, start, end),
        ACons { head: arm, tail: rest } => push_finite_match_next<P, N>(pages, stride, total, restored, arm, rest, all, completed_next, es, ee, subject_ty, result_ty, arm_count, start, end)
    };
}
fn push_finite_match_next<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arm: FiniteMatchArm, remaining: FiniteMatchArmList, all: FiniteMatchArmList, completed: TypedFiniteMatchArmList, es: u64, ee: u64, subject_ty: SemType, result_ty: SemType, arm_count: u64, start: u64, end: u64) -> (result: SemState) {
    let found: EnumFind = enum_lookup<P, N>(pages, stride, total, st.enumtab, es, ee);
    return push_finite_match_job<P, N>(pages, stride, total, st, arm, remaining, all, completed, found.decl, subject_ty, es, ee, result_ty, arm_count, start, end);
}
fn finish_finite_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, completed: TypedFiniteMatchArmList, subject_ty: SemType, result_ty: SemType, arm_count: u64, start: u64, end: u64) -> (result: SemState) {
    let arms: TypedFiniteMatchArmList = reverse_typed_finite_match_arms<P, N>(pages, stride, total, completed);
    let top: TOp = TOp.TFiniteMatch { ty: result_ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, start: start, end: end };
    return sem_emit_top(sem_accept(st, result_ty), top);
}
record ArmScopeScan { rest: PayloadBindingList, scope: ScopeStack }
fn bind_arm_scope<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, scope: ScopeStack, fields: FieldList, bindings: PayloadBindingList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: ScopeStack) {
    let rev: PayloadBindingList = reverse_payload_bindings<P, N>(pages, stride, total, bindings);
    iterate i up_to 1024 carrying d: ArmScopeScan = ArmScopeScan { rest: rev, scope: scope } {
        next d = bind_arm_scope_step<P, N>(pages, stride, total, d, fields, rectab, enumtab, nominals);
    }
    return d.scope;
}
fn bind_arm_scope_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ArmScopeScan, fields: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: ArmScopeScan) {
    return match st.rest {
        YNil => st,
        YCons { head: binding, tail: rest } => bind_one_arm_name<P, N>(pages, stride, total, st, fields, binding, rest, rectab, enumtab, nominals)
    };
}
fn bind_one_arm_name<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ArmScopeScan, fields: FieldList, binding: PayloadBinding, rest: PayloadBindingList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: ArmScopeScan) {
    let found: FieldScan = field_scan<P, N>(pages, stride, total, fields, binding.field_start, binding.field_end);
    if !(found.found) { return ArmScopeScan { rest: rest, scope: st.scope }; }
    let fty: TyRes = resolve_type<P, N>(pages, stride, total, found.field.type_kind, found.field.type_start, found.field.type_end, rectab, enumtab, nominals);
    let ty: SemType = arm_binding_ty(fty);
    let bound: BindRes = env_bind_current<P, N>(pages, stride, total, st.scope, binding.name_start, binding.name_end, ty);
    return ArmScopeScan { rest: rest, scope: bound.stack };
}
fn arm_binding_ty(fty: TyRes) -> (result: SemType) {
    if fty.ok { return fty.ty; }
    return SemType.TPoison;
}
// Record literals parse with oracle agreement, but checking a record value
// (field-set validation against the record table plus `..base` merging)
// belongs to the aggregate/nominal lowering step: fail the check here with
// an explicit span rather than emitting unmodeled typed IR.
fn seed_record_construct(st: SemState, start: u64, end: u64) -> (result: SemState) {
    return sem_drain(sem_emit(st, 2, start, end, 1));
}
fn seed_enum_construct<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, ts: u64, te: u64, vs: u64, ve: u64, fields: ConstructFieldList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let found: EnumFind = enum_lookup<P, N>(pages, stride, total, st.enumtab, ts, te);
    if !(found.found) { return sem_drain(sem_emit(st, 42, ts, te, 1)); }
    let variant: VariantScan = variant_scan<P, N>(pages, stride, total, found.decl.variants, vs, ve);
    if !(variant.found) { return sem_drain(sem_emit(st, 43, vs, ve, 1)); }
    return check_construct_fields<P, N>(pages, stride, total, st, found.decl, variant.variant, fields, ts, te, vs, ve, start, end, exp);
}
// Construction checking runs in three phases, exactly the Stage-0 order:
// field names first (unknown/duplicate), then known-field values in source
// order (a hard value failure aborts the rest), then payload shape. Unknown
// field values are never scheduled.
record BindRev { rest: BindList, acc: BindList }
fn reverse_binds<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, binds: BindList) -> (result: BindList) {
    iterate i up_to 1024 carrying d: BindRev = BindRev { rest: binds, acc: BindList.BNil } {
        next d = reverse_binds_step(d);
    }
    return d.acc;
}
fn reverse_binds_step(st: BindRev) -> (result: BindRev) {
    return match st.rest {
        BindList.BNil => st,
        BindList.BCons { head: h, tail: t } => BindRev { rest: t, acc: BindList.BCons { head: h, tail: st.acc } }
    };
}
record ConstructFieldCheck { rest: ConstructFieldList, seen: NameList, jobs: ConstructJobList, params: BindList, obls: OblList, failed: bool }
fn check_construct_fields<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, decl: EnumDecl, variant: Variant, fields: ConstructFieldList, ts: u64, te: u64, vs: u64, ve: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    iterate i up_to 1024 carrying d: ConstructFieldCheck = ConstructFieldCheck { rest: fields, seen: NameList.NNil, jobs: ConstructJobList.CJNil, params: BindList.BNil, obls: st.obls, failed: false } {
        next d = construct_field_check_step<P, N>(pages, stride, total, d, variant.fields, st.rectab, st.enumtab, st.nominals);
    }
    let jobs: ConstructJobList = reverse_construct_jobs<P, N>(pages, stride, total, d.jobs);
    let total_jobs: u64 = count_construct_jobs<P, N>(pages, stride, total, jobs);
    let st1: SemState = SemState { ..st, obls: d.obls };
    let ty: SemType = SemType.TNamed { start: ts, end: te };
    let params: BindList = reverse_binds<P, N>(pages, stride, total, d.params);
    let shape_ok: bool = payload_shape_ok<P, N>(pages, stride, total, variant.fields, d.seen);
    return seed_construct_jobs<P, N>(pages, stride, total, st1, jobs, total_jobs, ty, params, vs, ve, shape_ok, start, end, exp);
}
fn construct_field_check_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ConstructFieldCheck, declared: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: ConstructFieldCheck) {
    return match st.rest {
        CNil => st,
        CCons { head: field, tail: rest } => check_one_construct_field<P, N>(pages, stride, total, st, declared, field, rest, rectab, enumtab, nominals)
    };
}
fn check_one_construct_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ConstructFieldCheck, declared: FieldList, field: ConstructField, rest: ConstructFieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: ConstructFieldCheck) {
    let found: FieldScan = field_scan<P, N>(pages, stride, total, declared, field.field_start, field.field_end);
    if !(found.found) { return ConstructFieldCheck { rest: rest, seen: st.seen, jobs: st.jobs, params: st.params, obls: OblList.LCons { head: Obligation { kind: 45, start: field.field_start, end: field.field_end, status: 1 }, tail: st.obls }, failed: true }; }
    let seen: NameList = NameList.NCons { head: NameSpan { start: field.field_start, end: field.field_end }, tail: st.seen };
    let vsp: ExprSpan = expr_span(field.value);
    let fty: TyRes = resolve_type<P, N>(pages, stride, total, found.field.type_kind, found.field.type_start, found.field.type_end, rectab, enumtab, nominals);
    let job: ConstructJob = ConstructJob { value: field.value, ty: arm_binding_ty(fty), vs: vsp.start, ve: vsp.end };
    let jobs: ConstructJobList = ConstructJobList.CJCons { head: job, tail: st.jobs };
    let params: BindList = BindList.BCons { head: Bind { start: field.field_start, end: field.field_end, ty: arm_binding_ty(fty) }, tail: st.params };
    if name_known<P, N>(pages, stride, total, st.seen, field.field_start, field.field_end) { return ConstructFieldCheck { rest: rest, seen: seen, jobs: jobs, params: params, obls: OblList.LCons { head: Obligation { kind: 48, start: field.field_start, end: field.field_end, status: 1 }, tail: st.obls }, failed: true }; }
    return ConstructFieldCheck { rest: rest, seen: seen, jobs: jobs, params: params, obls: st.obls, failed: st.failed };
}
record ConstructJobRev { rest: ConstructJobList, acc: ConstructJobList }
fn reverse_construct_jobs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, jobs: ConstructJobList) -> (result: ConstructJobList) {
    iterate i up_to 1024 carrying d: ConstructJobRev = ConstructJobRev { rest: jobs, acc: ConstructJobList.CJNil } {
        if construct_jobs_empty(d.rest) { return d.acc; }
        next d = reverse_construct_jobs_step(d);
    }
    return d.acc;
}
fn reverse_construct_jobs_step(st: ConstructJobRev) -> (result: ConstructJobRev) {
    return match st.rest {
        CJNil => st,
        CJCons { head: h, tail: t } => ConstructJobRev { rest: t, acc: ConstructJobList.CJCons { head: h, tail: st.acc } }
    };
}
fn construct_jobs_empty(list: ConstructJobList) -> (result: bool) {
    return match list { CJNil => true, CJCons { head: head, tail: tail } => false };
}
record ConstructJobCount { rest: ConstructJobList, n: u64 }
fn count_construct_jobs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, jobs: ConstructJobList) -> (result: u64) {
    iterate i up_to 1024 carrying d: ConstructJobCount = ConstructJobCount { rest: jobs, n: 0 } {
        if construct_jobs_empty(d.rest) { return d.n; }
        next d = count_construct_jobs_step(d);
    }
    return d.n;
}
fn count_construct_jobs_step(st: ConstructJobCount) -> (result: ConstructJobCount) {
    return match st.rest {
        CJNil => st,
        CJCons { head: h, tail: t } => ConstructJobCount { rest: t, n: st.n + 1 }
    };
}
fn seed_construct_jobs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, jobs: ConstructJobList, job_total: u64, ty: SemType, params: BindList, vs: u64, ve: u64, shape_ok: bool, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match jobs {
        CJNil => finish_enum_construct<P, N>(pages, stride, total, st, job_total, ty, params, vs, ve, shape_ok, start, end, exp),
        CJCons { head: job, tail: rest } => push_construct_job(st, job, rest, job_total, ty, params, vs, ve, shape_ok, start, end, exp)
    };
}
fn push_construct_job(st: SemState, job: ConstructJob, remaining: ConstructJobList, total: u64, ty: SemType, params: BindList, vs: u64, ve: u64, shape_ok: bool, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let work: SemJob = SemJob { e: job.value, exp: ExpTy.XSome { ty: job.ty } };
    let kont: SemKont = SemKont.KConstructField { remaining: remaining, total: total, ty: ty, params: params, vs: vs, ve: ve, cty: job.ty, cvs: job.vs, cve: job.ve, shape_ok: shape_ok, start: start, end: end, exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: work, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn continue_construct_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, remaining: ConstructJobList, job_total: u64, ty: SemType, params: BindList, vs: u64, ve: u64, cty: SemType, cvs: u64, cve: u64, shape_ok: bool, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let checked: SemState = construct_value_check<P, N>(pages, stride, total, st, cty, cvs, cve);
    return match remaining {
        CJNil => finish_enum_construct<P, N>(pages, stride, total, checked, job_total, ty, params, vs, ve, shape_ok, start, end, exp),
        CJCons { head: job, tail: rest } => push_construct_job(checked, job, rest, job_total, ty, params, vs, ve, shape_ok, start, end, exp)
    };
}
fn construct_value_check<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, cty: SemType, cvs: u64, cve: u64) -> (result: SemState) {
    if sem_eq<P, N>(pages, stride, total, st.last_ty, cty) { return st; }
    return sem_emit(st, 50, cvs, cve, 1);
}
fn finish_enum_construct<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, job_total: u64, ty: SemType, params: BindList, vs: u64, ve: u64, shape_ok: bool, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let shaped: SemState = finish_construct_shape(st, shape_ok, start, end);
    let top: TOp = TOp.TEnumConstruct { ty: ty, variant_start: vs, variant_end: ve, field_count: job_total, params: params, start: start, end: end };
    let emitted: SemState = sem_emit_top(sem_accept(shaped, ty), top);
    return finish_construct_exp<P, N>(pages, stride, total, emitted, ty, start, end, exp);
}
fn finish_construct_shape(st: SemState, shape_ok: bool, start: u64, end: u64) -> (result: SemState) {
    if shape_ok { return st; }
    return sem_emit(st, 49, start, end, 1);
}
fn finish_construct_exp<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, ty: SemType, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => st,
        XSome { ty: want } => finish_construct_req<P, N>(pages, stride, total, st, ty, want, start, end)
    };
}
fn finish_construct_req<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, ty: SemType, want: SemType, start: u64, end: u64) -> (result: SemState) {
    if sem_eq<P, N>(pages, stride, total, ty, want) { return st; }
    return sem_emit(st, 52, start, end, 1);
}
fn seed_repeat<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, value: Expr, count_start: u64, count_end: u64, count_kind: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    if count_kind != 5 { return sem_drain(sem_emit(st, 2, count_start, count_end, 1)); }
    let parsed: IntVal = int_value<P, N>(pages, stride, total, count_start, count_end);
    if parsed.overflow { return sem_drain(sem_emit(st, 2, count_start, count_end, 1)); }
    return seed_repeat_expected<P, N>(pages, stride, total, st, value, parsed.value, start, end, exp);
}
fn seed_repeat_expected<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, value: Expr, count: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => seed_repeat_job(st, value, count, start, end, exp, ExpTy.XNone),
        XSome { ty: expected } => seed_repeat_type<P, N>(pages, stride, total, st, value, count, start, end, exp, expected)
    };
}
fn seed_repeat_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, value: Expr, count: u64, start: u64, end: u64, exp: ExpTy, expected: SemType) -> (result: SemState) {
    return match expected {
        TSeqExact { element: element, length: length, length_valid: valid } => seed_repeat_exact(st, value, count, length, valid, element, start, end, exp),
        TSeq => seed_repeat_job(st, value, count, start, end, exp, ExpTy.XNone),
        TBool => sem_drain(sem_emit(st, 2, start, end, 1)),
        TByte => sem_drain(sem_emit(st, 2, start, end, 1)),
        TInt { width: w, signed: g } => sem_drain(sem_emit(st, 2, start, end, 1)),
        TNamed { start: s, end: e } => sem_drain(sem_emit(st, 2, start, end, 1)),
        TPoison => sem_drain(sem_emit(st, 2, start, end, 1))
    };
}
fn seed_repeat_exact(st: SemState, value: Expr, count: u64, length: u64, valid: bool, element: SemType, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    if !(valid) || length != count { return sem_drain(sem_emit(st, 2, start, end, 1)); }
    return seed_repeat_job(st, value, count, start, end, exp, ExpTy.XSome { ty: element });
}
fn seed_repeat_job(st: SemState, value: Expr, count: u64, start: u64, end: u64, exp: ExpTy, element_exp: ExpTy) -> (result: SemState) {
    let job: SemJob = SemJob { e: value, exp: element_exp };
    let kont: SemKont = SemKont.KRepeat { count: count, start: start, end: end, exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn finish_name<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let got: LookupRes = env_lookup<P, N>(pages, stride, total, st.env, start, end);
    if !(got.found) { return sem_drain(sem_emit(st, 1, start, end, 1)); }
    return finish_name_exp<P, N>(pages, stride, total, st, got.ty, start, end, exp);
}
fn finish_name_exp<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, ty: SemType, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => sem_emit_top(sem_accept(st, ty), TOp.TName { ty: ty, start: start, end: end }),
        XSome { ty: r } => finish_name_req<P, N>(pages, stride, total, st, ty, r, start, end)
    };
}
fn finish_name_req<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, ty: SemType, r: SemType, start: u64, end: u64) -> (result: SemState) {
    if sem_eq<P, N>(pages, stride, total, ty, r) { return sem_emit_top(sem_accept(st, ty), TOp.TName { ty: ty, start: start, end: end }); }
    if seq_borrow_ok<P, N>(pages, stride, total, ty, r) { return sem_emit_top(sem_accept(st, r), TOp.TName { ty: r, start: start, end: end }); }
    return sem_emit_top(sem_accept(sem_emit(st, 2, start, end, 1), ty), TOp.TName { ty: ty, start: start, end: end });
}
fn finish_int(st: SemState, value: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => finish_int_plain(st, value, start, end),
        XSome { ty: r } => finish_int_req(st, value, r, start, end)
    };
}
fn finish_int_plain(st: SemState, value: u64, start: u64, end: u64) -> (result: SemState) {
    let ty: SemType = SemType.TInt { width: 64, signed: true };
    return sem_emit_top(sem_accept(st, ty), TOp.TInt { value: value, ty: ty, start: start, end: end });
}
fn finish_int_req(st: SemState, value: u64, r: SemType, start: u64, end: u64) -> (result: SemState) {
    return match r {
        TInt { width: w, signed: g } => sem_emit_top(sem_accept(st, r), TOp.TInt { value: value, ty: r, start: start, end: end }),
        TByte => finish_int_byte(st, value, start, end),
        TBool => finish_int_fail(st, value, start, end),
        TNamed { start: n, end: m } => finish_int_fail(st, value, start, end),
        TSeq => finish_int_fail(st, value, start, end),
        TSeqExact { element: element, length: length, length_valid: valid } => finish_int_fail(st, value, start, end),
        TPoison => finish_int_fail(st, value, start, end)
    };
}
fn finish_int_byte(st: SemState, value: u64, start: u64, end: u64) -> (result: SemState) {
    if value <= 255 { return sem_emit_top(sem_accept(st, SemType.TByte), TOp.TInt { value: value, ty: SemType.TByte, start: start, end: end }); }
    return sem_emit_top(sem_accept(sem_emit(st, 3, start, end, 1), SemType.TByte), TOp.TInt { value: value, ty: SemType.TByte, start: start, end: end });
}
fn finish_int_fail(st: SemState, value: u64, start: u64, end: u64) -> (result: SemState) {
    let ty: SemType = SemType.TInt { width: 64, signed: true };
    return sem_emit_top(sem_accept(sem_emit(st, 3, start, end, 1), ty), TOp.TInt { value: value, ty: ty, start: start, end: end });
}
fn finish_bool(st: SemState, value: bool, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => sem_emit_top(sem_accept(st, SemType.TBool), TOp.TBool { value: value, ty: SemType.TBool, start: start, end: end }),
        XSome { ty: r } => finish_bool_req(st, value, r, start, end)
    };
}
fn finish_bool_req(st: SemState, value: bool, r: SemType, start: u64, end: u64) -> (result: SemState) {
    return match r {
        TBool => sem_emit_top(sem_accept(st, SemType.TBool), TOp.TBool { value: value, ty: SemType.TBool, start: start, end: end }),
        TByte => finish_bool_fail(st, value, start, end),
        TInt { width: w, signed: g } => finish_bool_fail(st, value, start, end),
        TNamed { start: n, end: m } => finish_bool_fail(st, value, start, end),
        TSeq => finish_bool_fail(st, value, start, end),
        TSeqExact { element: element, length: length, length_valid: valid } => finish_bool_fail(st, value, start, end),
        TPoison => finish_bool_fail(st, value, start, end)
    };
}
fn finish_bool_fail(st: SemState, value: bool, start: u64, end: u64) -> (result: SemState) {
    return sem_emit_top(sem_accept(sem_emit(st, 4, start, end, 1), SemType.TBool), TOp.TBool { value: value, ty: SemType.TBool, start: start, end: end });
}
fn is_threaded(op: u64) -> (result: bool) {
    if op == 50 || op == 51 || op == 52 { return true; }
    if op == 55 || op == 56 || op == 57 { return true; }
    if op == 91 || op == 92 || op == 93 { return true; }
    if op == 94 || op == 95 || op == 96 { return true; }
    return false;
}
fn is_integer_literal(e: Expr) -> (result: bool) {
    return match e {
        Name { start: s, end: e2 } => false,
        Integer { start: s, end: e2, value: v, overflow: o } => true,
        Boolean { start: s, end: e2, value: v } => false,
        UnaryNot { value: value, start: s, end: e2 } => false,
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e2 } => false,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e2 } => false,
        Binary { op: o, left: l, right: r, start: s, end: e2 } => false,
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e2 } => false,
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e2, path: p } => false,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e2 } => false,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e2 } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e2 } => false,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e2 } => false
    };
}
fn bin_left_exp(op: u64, exp: ExpTy, left: Expr) -> (result: ExpTy) {
    if is_threaded(op) {
        if exp_is_poison(exp) && is_integer_literal(left) { return ExpTy.XNone; }
        return exp;
    }
    return ExpTy.XNone;
}
fn exp_is_poison(exp: ExpTy) -> (result: bool) {
    return match exp {
        XNone => false,
        XSome { ty: t } => is_poison(t)
    };
}
fn seed_binop(st: SemState, op: u64, left: Expr, right: Expr, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let lexp: ExpTy = bin_left_exp(op, exp, left);
    let job: SemJob = SemJob { e: left, exp: lexp };
    let kont: SemKont = SemKont.KBinL { op: op, right: right, start: start, end: end, exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn nonzero_lit(e: Expr) -> (result: bool) {
    return match e {
        Integer { start: s, end: e2, value: v, overflow: o } => nonzero_val(v),
        Name { start: s, end: e2 } => false,
        Boolean { start: s, end: e2, value: v } => false,
        UnaryNot { value: value, start: s, end: e2 } => false,
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e2 } => false,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e2 } => false,
        Binary { op: o, left: l, right: r, start: s, end: e2 } => false,
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e2 } => false,
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e2, path: p } => false,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e2 } => false,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e2 } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e2 } => false,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e2 } => false
    };
}
fn nonzero_val(v: u64) -> (result: bool) {
    if v == 0 { return false; }
    return true;
}
fn apply_repeat<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, count: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let element: SemType = st.last_ty;
    if is_poison(element) { return sem_drain(st); }
    let result_ty: SemType = SemType.TSeqExact { element: element, length: count, length_valid: true };
    return apply_repeat_expected<P, N>(pages, stride, total, st, count, start, end, exp, element, result_ty);
}
fn apply_repeat_expected<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, count: u64, start: u64, end: u64, exp: ExpTy, element: SemType, result_ty: SemType) -> (result: SemState) {
    return match exp {
        XNone => sem_emit_top(sem_accept(st, result_ty), TOp.TRepeat { ty: result_ty, element: element, count: count, start: start, end: end }),
        XSome { ty: expected } => apply_repeat_req<P, N>(pages, stride, total, st, count, start, end, element, result_ty, expected)
    };
}
fn apply_repeat_req<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, count: u64, start: u64, end: u64, element: SemType, result_ty: SemType, expected: SemType) -> (result: SemState) {
    if sem_eq<P, N>(pages, stride, total, result_ty, expected) { return sem_emit_top(sem_accept(st, result_ty), TOp.TRepeat { ty: result_ty, element: element, count: count, start: start, end: end }); }
    return sem_emit_top(sem_accept(sem_emit(st, 2, start, end, 1), result_ty), TOp.TRepeat { ty: result_ty, element: element, count: count, start: start, end: end });
}
fn apply_kont<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, k: SemKont) -> (result: SemState) {
    return match k {
        KTop => SemState { ..st, top_ty: st.last_ty },
        KNot { start: s, end: e, exp: x } => apply_not<P, N>(pages, stride, total, st, s, e, x),
        KRepeat { count: count, start: s, end: e, exp: x } => apply_repeat<P, N>(pages, stride, total, st, count, s, e, x),
        KMatchArm { remaining: remaining, current: current, completed: completed, prior_tops: prior_tops, subject_ty: subject_ty, result_ty: result_ty, arm_count: arm_count, default_count: default_count, rs: rs, re: re, start: s, end: e } => continue_scalar_match_arm<P, N>(pages, stride, total, st, remaining, current, completed, prior_tops, subject_ty, result_ty, arm_count, default_count, rs, re, s, e),
        KFiniteSubject { arms: arms, result_ty: result_ty, ss: ss, se: se, start: s, end: e } => apply_finite_subject<P, N>(pages, stride, total, st, arms, result_ty, ss, se, s, e),
        KFiniteArm { remaining: remaining, all: all, current: current, completed: completed, payload_fields: payload_fields, prior_tops: prior_tops, subject_ty: subject_ty, es: es, ee: ee, result_ty: result_ty, arm_count: arm_count, env: env, rs: rs, re: re, start: s, end: e } => continue_finite_match_arm<P, N>(pages, stride, total, st, remaining, all, current, completed, payload_fields, prior_tops, subject_ty, es, ee, result_ty, arm_count, env, rs, re, s, e),
        KConstructField { remaining: remaining, total: total, ty: ty, params: params, vs: vs, ve: ve, cty: cty, cvs: cvs, cve: cve, shape_ok: shape_ok, start: s, end: e, exp: x } => continue_construct_field<P, N>(pages, stride, total, st, remaining, total, ty, params, vs, ve, cty, cvs, cve, shape_ok, s, e, x),
        KBinL { op: o, right: r, start: s, end: e, exp: x } => apply_bin_l(st, o, r, s, e, x),
        KBinR { op: o, lty: l, start: s, end: e, rlit: q, exp: x } => apply_bin_r<P, N>(pages, stride, total, st, o, l, s, e, q, x),
        KCallA { sig: g, args: a, ptys: p, start: s, end: e, exp: x } => apply_call_a<P, N>(pages, stride, total, st, g, a, p, s, e, x),
        KProj { fstart: fs, fend: fe, bstart: bs, bend: be, start: s, end: e, exp: x } => apply_proj<P, N>(pages, stride, total, st, fs, fe, bs, be, s, e, x),
        KOpA { slot: slot, ns: ns, ne: ne, args: a, index: i, start: s, end: e, exp: x } => apply_op_a<P, N>(pages, stride, total, st, slot, ns, ne, a, i, s, e, x)
    };
}
fn seed_not(st: SemState, value: Expr, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let job: SemJob = SemJob { e: value, exp: ExpTy.XSome { ty: SemType.TBool } };
    let kont: SemKont = SemKont.KNot { start: start, end: end, exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn apply_not<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    if !(sem_eq<P, N>(pages, stride, total, st.last_ty, SemType.TBool)) { return sem_drain(sem_emit(st, 7, start, end, 1)); }
    let top: TOp = TOp.TNot { ty: SemType.TBool, start: start, end: end };
    return finish_not_exp<P, N>(pages, stride, total, st, top, start, end, exp);
}
fn finish_not_exp<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, top: TOp, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => sem_emit_top(sem_accept(st, SemType.TBool), top),
        XSome { ty: want } => finish_not_req<P, N>(pages, stride, total, st, top, start, end, want)
    };
}
fn finish_not_req<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, top: TOp, start: u64, end: u64, want: SemType) -> (result: SemState) {
    if sem_eq<P, N>(pages, stride, total, want, SemType.TBool) { return sem_emit_top(sem_accept(st, SemType.TBool), top); }
    return sem_emit_top(sem_accept(sem_emit(st, 4, start, end, 1), SemType.TBool), top);
}
fn apply_bin_l(st: SemState, op: u64, right: Expr, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let lty: SemType = st.last_ty;
    let job: SemJob = SemJob { e: right, exp: ExpTy.XSome { ty: lty } };
    let kont: SemKont = SemKont.KBinR { op: op, lty: lty, start: start, end: end, rlit: nonzero_lit(right), exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn apply_bin_r<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, op: u64, lty: SemType, start: u64, end: u64, rlit: bool, exp: ExpTy) -> (result: SemState) {
    let rty: SemType = st.last_ty;
    if !(sem_eq<P, N>(pages, stride, total, lty, rty)) {
        if exp_is_poison(exp) { return recover_poisoned_binop(st, op, lty, start, end); }
        return sem_drain(sem_emit(st, 7, start, end, 1));
    }
    return finish_bin_class<P, N>(pages, stride, total, st, op, lty, rty, start, end, rlit);
}
fn recover_poisoned_binop(st: SemState, op: u64, ty: SemType, start: u64, end: u64) -> (result: SemState) {
    // Preserve the child's type obligation and let the enclosing return
    // comparison report the result mismatch, as Stage-0 does for a poisoned
    // declared result. The enclosing proof remains failed by its obligation.
    return sem_emit_top(sem_accept(st, ty), TOp.TBin { op: op, ty: ty, start: start, end: end });
}
// Operator classes: 0 total arithmetic (checked, wrapping, saturating,
// bitwise), 1 division/modulo, 2 comparisons, 3 boolean connectives,
// 4 shifts. Anything else is unreachable from the parser and defended
// as an integer-arithmetic failure.
fn op_class(op: u64) -> (result: u64) {
    if op == 50 || op == 51 || op == 52 { return 0; }
    if op == 55 || op == 56 || op == 57 { return 0; }
    if op == 91 || op == 92 || op == 93 { return 0; }
    if op == 94 || op == 95 || op == 96 { return 0; }
    if op == 53 || op == 54 { return 1; }
    if op == 84 || op == 85 || op == 58 { return 2; }
    if op == 86 || op == 59 || op == 87 { return 2; }
    if op == 82 || op == 83 { return 3; }
    if op == 88 || op == 89 { return 4; }
    return 0;
}
fn finish_bin_class<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, op: u64, lty: SemType, rty: SemType, start: u64, end: u64, rlit: bool) -> (result: SemState) {
    let cls: u64 = op_class(op);
    if cls == 1 { return finish_bin_divmod(st, op, lty, start, end, rlit); }
    if cls == 2 { return finish_bin_cmp(st, op, lty, start, end); }
    if cls == 3 { return finish_bin_boolop(st, op, lty, start, end); }
    if cls == 4 { return finish_bin_shift(st, op, lty, start, end); }
    return finish_bin_arith(st, op, lty, start, end);
}
fn arith_int_or_byte(st: SemState, lty: SemType, start: u64, end: u64) -> (result: SemState) {
    return match lty {
        TInt { width: w, signed: g } => st,
        TByte => sem_emit(st, 12, start, end, 1),
        TBool => sem_emit(st, 8, start, end, 1),
        TNamed { start: n, end: m } => sem_emit(st, 8, start, end, 1),
        TSeq => sem_emit(st, 8, start, end, 1),
        TSeqExact { element: element, length: length, length_valid: valid } => sem_emit(st, 8, start, end, 1),
        TPoison => sem_emit(st, 8, start, end, 1)
    };
}
fn arith_failed(st: SemState, lty: SemType) -> (result: bool) {
    return match lty {
        TInt { width: w, signed: g } => false,
        TByte => true,
        TBool => true,
        TNamed { start: n, end: m } => true,
        TSeq => true,
        TSeqExact { element: element, length: length, length_valid: valid } => true,
        TPoison => true
    };
}
fn finish_bin_arith(st: SemState, op: u64, lty: SemType, start: u64, end: u64) -> (result: SemState) {
    if arith_failed(st, lty) { return sem_drain(arith_int_or_byte(st, lty, start, end)); }
    if op == 50 || op == 51 || op == 52 {
        return sem_emit_top(sem_accept(sem_emit(st, 13, start, end, 2), lty), TOp.TBin { op: op, ty: lty, start: start, end: end });
    }
    return sem_emit_top(sem_accept(st, lty), TOp.TBin { op: op, ty: lty, start: start, end: end });
}
fn finish_bin_divmod(st: SemState, op: u64, lty: SemType, start: u64, end: u64, rlit: bool) -> (result: SemState) {
    if arith_failed(st, lty) { return sem_drain(arith_int_or_byte(st, lty, start, end)); }
    if rlit { return sem_emit_top(sem_accept(st, lty), TOp.TBin { op: op, ty: lty, start: start, end: end }); }
    return sem_emit_top(sem_accept(sem_emit(st, 14, start, end, 2), lty), TOp.TBin { op: op, ty: lty, start: start, end: end });
}
fn finish_bin_cmp(st: SemState, op: u64, lty: SemType, start: u64, end: u64) -> (result: SemState) {
    return match lty {
        TInt { width: w, signed: g } => sem_emit_top(sem_accept(st, SemType.TBool), TOp.TBin { op: op, ty: SemType.TBool, start: start, end: end }),
        TByte => sem_emit_top(sem_accept(st, SemType.TBool), TOp.TBin { op: op, ty: SemType.TBool, start: start, end: end }),
        TBool => sem_drain(sem_emit(st, 9, start, end, 1)),
        TNamed { start: n, end: m } => sem_drain(sem_emit(st, 9, start, end, 1)),
        TSeq => sem_drain(sem_emit(st, 9, start, end, 1)),
        TSeqExact { element: element, length: length, length_valid: valid } => sem_drain(sem_emit(st, 9, start, end, 1)),
        TPoison => sem_drain(sem_emit(st, 9, start, end, 1))
    };
}
fn finish_bin_boolop(st: SemState, op: u64, lty: SemType, start: u64, end: u64) -> (result: SemState) {
    if is_bool_ty(lty) { return sem_emit_top(sem_accept(st, SemType.TBool), TOp.TBin { op: op, ty: SemType.TBool, start: start, end: end }); }
    return sem_drain(sem_emit(st, 10, start, end, 1));
}
fn finish_bin_shift(st: SemState, op: u64, lty: SemType, start: u64, end: u64) -> (result: SemState) {
    return match lty {
        TByte => sem_emit_top(sem_accept(st, SemType.TByte), TOp.TBin { op: op, ty: SemType.TByte, start: start, end: end }),
        TInt { width: w, signed: g } => sem_emit_top(sem_accept(st, lty), TOp.TBin { op: op, ty: lty, start: start, end: end }),
        TBool => sem_drain(sem_emit(st, 11, start, end, 1)),
        TNamed { start: n, end: m } => sem_drain(sem_emit(st, 11, start, end, 1)),
        TSeq => sem_drain(sem_emit(st, 11, start, end, 1)),
        TSeqExact { element: element, length: length, length_valid: valid } => sem_drain(sem_emit(st, 11, start, end, 1)),
        TPoison => sem_drain(sem_emit(st, 11, start, end, 1))
    };
}
// Callee signatures resolve by exact name bytes over the collected table.
record SigRes { found: bool, sig: Sig }
record SigScan { rest: SigTab, start: u64, end: u64, found: bool, sig: Sig }
fn sig_lookup<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, sigs: SigTab, start: u64, end: u64) -> (result: SigRes) {
    iterate i up_to 1024 carrying d: SigScan = SigScan { rest: sigs, start: start, end: end, found: false, sig: Sig { start: 0, end: 0, params: BindList.BNil, nparams: 0, generic_bounds: GenericBoundList.KNil, result: SemType.TPoison, fx: EffectList.XNil, raw_capabilities: CapList.ANil, effects: EffectIdentityList.EINil, capabilities: CapabilityIdentityList.CINil, identity: invalid_semantic_identity() } } {
        next d = sig_lookup_step<P, N>(pages, stride, total, d);
    }
    return SigRes { found: d.found, sig: d.sig };
}
fn sig_lookup_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SigScan) -> (result: SigScan) {
    if st.found { return st; }
    return match st.rest {
        HNil => st,
        HCons { head: h, tail: t } => sig_lookup_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn sig_lookup_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SigScan, h: Sig, t: SigTab) -> (result: SigScan) {
    if spans_equal<P, N>(pages, stride, total, h.start, h.end, st.start, st.end) {
        return SigScan { rest: SigTab.HNil, start: st.start, end: st.end, found: true, sig: h };
    }
    return SigScan { rest: t, start: st.start, end: st.end, found: false, sig: st.sig };
}
record TysAcc { rest: BindList, acc: TyList }
fn params_to_tys<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, params: BindList) -> (result: TyList) {
    iterate i up_to 1024 carrying d: TysAcc = TysAcc { rest: params, acc: TyList.TyNil } {
        next d = params_to_tys_step(d);
    }
    return reverse_tys<P, N>(pages, stride, total, d.acc);
}
fn params_to_tys_step(st: TysAcc) -> (result: TysAcc) {
    return match st.rest { BNil => st, BCons { head: h, tail: t } => TysAcc { rest: t, acc: TyList.TyCons { head: h.ty, tail: st.acc } } };
}
record TysRev { rest: TyList, acc: TyList }
fn reverse_tys<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: TyList) -> (result: TyList) {
    iterate i up_to 1024 carrying d: TysRev = TysRev { rest: list, acc: TyList.TyNil } {
        if type_list_empty(d.rest) { return d.acc; }
        next d = reverse_tys_step(d);
    }
    return d.acc;
}
fn reverse_tys_step(st: TysRev) -> (result: TysRev) {
    return match st.rest { TyNil => st, TyCons { head: h, tail: t } => TysRev { rest: t, acc: TyList.TyCons { head: h, tail: st.acc } } };
}
// Compiler-operation proof (CP-0019). Each operation slot carries a fixed
// contract mirroring Stage-0 elaboration: result typing (MNE261/MNE287/
// MNE292), exactly-one-effect plus authorizing-capability authorization
// (MNE257/MNE258, MNE288/MNE289, MNE293/MNE294), and per-operand typing
// (MNE262, MNE290/MNE291, MNE295/MNE296/MNE297). Checking order matches
// Stage-0: the required type first, authorization second, operands in
// source order. Obligation kinds 53-67 twin those codes in order.
fn is_u64_ty(ty: SemType) -> (result: bool) {
    return match ty {
        TInt { width: w, signed: s } => w == 64 && !(s),
        TBool => false,
        TByte => false,
        TNamed { start: s, end: e } => false,
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: valid } => false,
        TPoison => false
    };
}
// A structured path/schema operand is a byte sequence whose ceiling fits
// the operation bound. Exact bounds and up_to views share the TSeqExact
// representation (views carry length_valid=false with the bound length),
// and Stage-0 accepts both through the same ceiling check.
fn op_view_bound_ok(ty: SemType, max: u64) -> (result: bool) {
    return match ty {
        TSeqExact { element: element, length: length, length_valid: valid } => op_view_element_ok(element) && !(length > max),
        TBool => false,
        TByte => false,
        TInt { width: w, signed: s } => false,
        TNamed { start: s, end: e } => false,
        TSeq => false,
        TPoison => false
    };
}
fn op_view_element_ok(element: SemType) -> (result: bool) {
    return match element {
        TByte => true,
        TBool => false,
        TInt { width: w, signed: s } => false,
        TNamed { start: s, end: e } => false,
        TSeq => false,
        TSeqExact { element: e2, length: l2, length_valid: v2 } => false,
        TPoison => false
    };
}
// Operand contract per slot and source-order index. Returns the MNE-twinned
// obligation kind for a violation, or 0 when the operand type satisfies
// its contract. Slot 0 takes one u64 index; slots 1-2 take a path view
// (bound 1024) and a schema view (bound 64); slot 2 takes a third typed
// value operand that must be resolved.
fn op_operand_kind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, slot: u64, index: u64, ty: SemType, nominals: NominalTypeIdentityList, rectab: RecordList, enumtab: EnumList) -> (result: u64) {
    if slot == 1 { return op_read_operand_kind(index, ty); }
    if slot == 2 { return op_write_operand_kind<P, N>(pages, stride, total, index, ty, nominals, rectab, enumtab); }
    return op_fs_operand_kind(index, ty);
}
fn op_fs_operand_kind(index: u64, ty: SemType) -> (result: u64) {
    if index != 0 { return 56; }
    if is_u64_ty(ty) { return 0; }
    return 56;
}
fn op_read_operand_kind(index: u64, ty: SemType) -> (result: u64) {
    if index == 0 {
        if op_view_bound_ok(ty, 1024) { return 0; }
        return 60;
    }
    if op_view_bound_ok(ty, 64) { return 0; }
    return 61;
}
fn op_write_operand_kind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, index: u64, ty: SemType, nominals: NominalTypeIdentityList, rectab: RecordList, enumtab: EnumList) -> (result: u64) {
    if index == 0 {
        if op_view_bound_ok(ty, 1024) { return 0; }
        return 65;
    }
    if index == 1 {
        if op_view_bound_ok(ty, 64) { return 0; }
        return 66;
    }
    return op_value_resolved_kind<P, N>(pages, stride, total, ty, nominals, rectab, enumtab, 67);
}
// A structured value (read result, write value operand) is resolved when
// it is concrete or a nominal the unit declares or imports. Anything else
// (poison included) violates the operation with the given kind.
fn op_value_resolved_kind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: SemType, nominals: NominalTypeIdentityList, rectab: RecordList, enumtab: EnumList, kind: u64) -> (result: u64) {
    return match ty {
        TNamed { start: s, end: e } => op_named_resolved_kind<P, N>(pages, stride, total, nominals, rectab, enumtab, s, e, kind),
        TBool => 0,
        TByte => 0,
        TInt { width: w, signed: s } => 0,
        TSeq => 0,
        TSeqExact { element: element, length: length, length_valid: valid } => 0,
        TPoison => kind
    };
}
fn op_named_resolved_kind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: NominalTypeIdentityList, rectab: RecordList, enumtab: EnumList, s: u64, e: u64, kind: u64) -> (result: u64) {
    if op_nominal_resolved<P, N>(pages, stride, total, nominals, rectab, enumtab, s, e) { return 0; }
    return kind;
}
fn op_nominal_resolved<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: NominalTypeIdentityList, rectab: RecordList, enumtab: EnumList, start: u64, end: u64) -> (result: bool) {
    let imported: NominalLookup = nominal_identity_at<P, N>(pages, stride, total, nominals, start, end);
    if imported.found && imported.identity.valid { return true; }
    let local: NominalLookup = nominal_identity_by_name<P, N>(pages, stride, total, nominals, start, end);
    if local.found && local.identity.valid { return true; }
    let rec: RecFind = rec_lookup<P, N>(pages, stride, total, rectab, start, end);
    if rec.found { return true; }
    let en: EnumFind = enum_lookup<P, N>(pages, stride, total, enumtab, start, end);
    if en.found { return true; }
    return false;
}
// Authorization mirrors Stage-0 check_host_authority: the calling function
// must declare exactly one effect of the operation kind, and that effect's
// authorizing capability must be a declared capability. Returns the
// violation kind, or 0 when the call is authorized.
fn op_auth_kind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, slot: u64, fx: EffectList, caps: CapList) -> (result: u64) {
    let found: OpEffectScan = op_effect_scan<P, N>(pages, stride, total, slot, fx);
    if found.count == 0 { return op_auth_missing_kind(slot); }
    if found.count != 1 { return op_auth_double_kind(slot); }
    if cap_list_known<P, N>(pages, stride, total, caps, found.cap_start, found.cap_end) { return 0; }
    return op_auth_missing_kind(slot);
}
record OpEffectScan { count: u64, cap_start: u64, cap_end: u64 }
record OpEffectWalk { rest: EffectList, count: u64, cap_start: u64, cap_end: u64, slot: u64 }
fn op_effect_scan<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, slot: u64, fx: EffectList) -> (result: OpEffectScan) {
    iterate i up_to 1024 carrying st: OpEffectWalk = OpEffectWalk { rest: fx, count: 0, cap_start: 0, cap_end: 0, slot: slot } {
        next st = op_effect_step<P, N>(pages, stride, total, st);
    }
    return OpEffectScan { count: st.count, cap_start: st.cap_start, cap_end: st.cap_end };
}
fn op_effect_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: OpEffectWalk) -> (result: OpEffectWalk) {
    return match st.rest {
        XNil => st,
        XCons { head: h, tail: t } => op_effect_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn op_effect_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: OpEffectWalk, h: Effect, t: EffectList) -> (result: OpEffectWalk) {
    if op_effect_matches<P, N>(pages, stride, total, st.slot, h.kind_start, h.kind_end) {
        return OpEffectWalk { rest: t, count: st.count + 1, cap_start: h.cap_start, cap_end: h.cap_end, slot: st.slot };
    }
    return OpEffectWalk { rest: t, count: st.count, cap_start: st.cap_start, cap_end: st.cap_end, slot: st.slot };
}
fn op_effect_matches<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, slot: u64, ks: u64, ke: u64) -> (result: bool) {
    if ke < ks { return false; }
    if slot == 0 || slot == 3 || slot == 4 { return op_span_is_fs_list<P, N>(pages, stride, total, ks, ke); }
    if slot == 1 { return ke - ks == 15 && span_is_structured_read<P, N>(pages, stride, total, ks); }
    if slot == 2 { return ke - ks == 16 && span_is_structured_write<P, N>(pages, stride, total, ks); }
    return false;
}
fn op_span_is_fs_list<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ks: u64, ke: u64) -> (result: bool) {
    if ke - ks != 7 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, ks) != 102 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, ks + 1) != 115 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, ks + 2) != 95 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, ks + 3) != 108 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, ks + 4) != 105 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, ks + 5) != 115 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, ks + 6) != 116 { return false; }
    return true;
}
fn op_auth_missing_kind(slot: u64) -> (result: u64) {
    if slot == 1 { return 58; }
    if slot == 2 { return 63; }
    return 53;
}
fn op_auth_double_kind(slot: u64) -> (result: u64) {
    if slot == 1 { return 59; }
    if slot == 2 { return 64; }
    return 54;
}
record CapKnownWalk { rest: CapList, start: u64, end: u64, found: bool }
fn cap_list_known<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, caps: CapList, start: u64, end: u64) -> (result: bool) {
    iterate i up_to 1024 carrying st: CapKnownWalk = CapKnownWalk { rest: caps, start: start, end: end, found: false } {
        next st = cap_known_step<P, N>(pages, stride, total, st);
    }
    return st.found;
}
fn cap_known_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CapKnownWalk) -> (result: CapKnownWalk) {
    if st.found { return st; }
    return match st.rest {
        ANil => st,
        ACons { head: h, tail: t } => cap_known_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn cap_known_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CapKnownWalk, h: Cap, t: CapList) -> (result: CapKnownWalk) {
    if spans_equal<P, N>(pages, stride, total, h.start, h.end, st.start, st.end) { return CapKnownWalk { rest: CapList.ANil, start: st.start, end: st.end, found: true }; }
    return CapKnownWalk { rest: t, start: st.start, end: st.end, found: false };
}
fn seed_op<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, slot: u64, ns: u64, ne: u64, args: ExprList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    if slot > 4 { return sem_drain(sem_emit(st, 32, ns, ne, 1)); }
    return seed_op_expected<P, N>(pages, stride, total, st, slot, ns, ne, args, start, end, exp);
}
fn seed_op_expected<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, slot: u64, ns: u64, ne: u64, args: ExprList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    if slot == 1 { return seed_op_read<P, N>(pages, stride, total, st, ns, ne, args, start, end, exp); }
    return seed_op_u64<P, N>(pages, stride, total, st, slot, ns, ne, args, start, end, exp);
}
// Metadata operations produce u64; a required type must equal it (Stage-0
// MNE261/MNE292 at the operation span).
fn seed_op_u64<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, slot: u64, ns: u64, ne: u64, args: ExprList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => seed_op_auth<P, N>(pages, stride, total, st, slot, ns, ne, args, start, end, exp),
        XSome { ty: r } => seed_op_u64_req<P, N>(pages, stride, total, st, slot, ns, ne, args, start, end, exp, r)
    };
}
fn seed_op_u64_req<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, slot: u64, ns: u64, ne: u64, args: ExprList, start: u64, end: u64, exp: ExpTy, r: SemType) -> (result: SemState) {
    if is_u64_ty(r) { return seed_op_auth<P, N>(pages, stride, total, st, slot, ns, ne, args, start, end, exp); }
    return sem_drain(sem_emit(st, op_expected_kind(slot), start, end, 1));
}
fn op_expected_kind(slot: u64) -> (result: u64) {
    if slot == 2 { return 62; }
    return 55;
}
// Structured reads produce their required type, which must be present and
// resolved: a nominal the unit declares or imports, or bounded concrete
// (Stage-0 MNE287 at the operation span).
fn seed_op_read<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, ns: u64, ne: u64, args: ExprList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => sem_drain(sem_emit(st, 57, start, end, 1)),
        XSome { ty: r } => seed_op_read_req<P, N>(pages, stride, total, st, ns, ne, args, start, end, exp, r)
    };
}
fn seed_op_read_req<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, ns: u64, ne: u64, args: ExprList, start: u64, end: u64, exp: ExpTy, r: SemType) -> (result: SemState) {
    let bad: u64 = op_value_resolved_kind<P, N>(pages, stride, total, r, st.nominals, st.rectab, st.enumtab, 57);
    if bad != 0 { return sem_drain(sem_emit(st, bad, start, end, 1)); }
    return seed_op_auth<P, N>(pages, stride, total, st, 1, ns, ne, args, start, end, exp);
}
fn seed_op_auth<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, slot: u64, ns: u64, ne: u64, args: ExprList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let bad: u64 = op_auth_kind<P, N>(pages, stride, total, slot, st.caller_fx, st.caller_caps);
    if bad != 0 { return sem_drain(sem_emit(st, bad, start, end, 1)); }
    return seed_op_args<P, N>(pages, stride, total, st, slot, ns, ne, args, start, end, exp);
}
fn seed_op_args<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, slot: u64, ns: u64, ne: u64, args: ExprList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let argc: u64 = count_exprs<P, N>(pages, stride, total, args);
    if argc != op_arity(slot) { return sem_drain(sem_emit(st, 32, ns, ne, 1)); }
    return match args {
        ENil => sem_drain(sem_emit(st, 32, ns, ne, 1)),
        ECons { head: h, tail: t } => push_op_arg(st, slot, ns, ne, args, 0, h, start, end, exp)
    };
}
fn push_op_arg(st: SemState, slot: u64, ns: u64, ne: u64, args: ExprList, index: u64, h: Expr, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let job: SemJob = SemJob { e: h, exp: op_arg_exp(slot) };
    let kont: SemKont = SemKont.KOpA { slot: slot, ns: ns, ne: ne, args: args, index: index, start: start, end: end, exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
// The filesystem index elaborates against u64 (Stage-0 checks the binding
// afterwards); structured views and values elaborate unconstrained and the
// operation validates the established type at the operand span.
fn op_arg_exp(slot: u64) -> (result: ExpTy) {
    if slot == 0 || slot == 3 || slot == 4 { return ExpTy.XSome { ty: SemType.TInt { width: 64, signed: false } }; }
    return ExpTy.XNone;
}
fn apply_op_a<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, slot: u64, ns: u64, ne: u64, args: ExprList, index: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match args {
        ENil => finish_op<P, N>(pages, stride, total, st, slot, ns, ne, start, end, exp),
        ECons { head: h, tail: t } => check_op_arg<P, N>(pages, stride, total, st, slot, ns, ne, h, t, index, start, end, exp)
    };
}
fn check_op_arg<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, slot: u64, ns: u64, ne: u64, h: Expr, t: ExprList, index: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let asp: ExprSpan = expr_span(h);
    let bad: u64 = op_operand_kind<P, N>(pages, stride, total, slot, index, st.last_ty, st.nominals, st.rectab, st.enumtab);
    if bad != 0 { return sem_drain(sem_emit(st, bad, asp.start, asp.end, 1)); }
    return match t {
        ENil => finish_op<P, N>(pages, stride, total, st, slot, ns, ne, start, end, exp),
        ECons { head: nh, tail: nt } => push_op_arg(st, slot, ns, ne, t, index + 1, nh, start, end, exp)
    };
}
fn finish_op<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, slot: u64, ns: u64, ne: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match exp {
        XNone => finish_op_ty<P, N>(pages, stride, total, st, slot, ns, ne, start, end, op_default_result(slot)),
        XSome { ty: r } => finish_op_req<P, N>(pages, stride, total, st, slot, ns, ne, start, end, r)
    };
}
fn op_default_result(slot: u64) -> (result: SemType) {
    if slot == 1 { return SemType.TPoison; }
    return SemType.TInt { width: 64, signed: false };
}
fn finish_op_ty<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, slot: u64, ns: u64, ne: u64, start: u64, end: u64, ty: SemType) -> (result: SemState) {
    let top: TOp = TOp.TOp { slot: slot, ty: ty, argc: op_arity(slot), ns: ns, ne: ne, identity: canonical_operation_identity<P, N>(pages, stride, total, ns, ne), start: start, end: end };
    return sem_emit_top(sem_accept(st, ty), top);
}
fn finish_op_req<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, slot: u64, ns: u64, ne: u64, start: u64, end: u64, r: SemType) -> (result: SemState) {
    if slot == 1 { return finish_op_ty<P, N>(pages, stride, total, st, slot, ns, ne, start, end, r); }
    return finish_op_ty<P, N>(pages, stride, total, st, slot, ns, ne, start, end, op_u64_result());
}
fn op_u64_result() -> (result: SemType) {
    return SemType.TInt { width: 64, signed: false };
}
// Host-operation callable identity: stable per operation name (the same
// bytes at every call site), owner-free because operations are compiler
// facilities rather than module declarations.
fn canonical_operation_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ns: u64, ne: u64) -> (result: SemanticIdentity) {
    let prefix: [byte; 20] = [109 as byte, 110 as byte, 99 as byte, 115 as byte, 58 as byte, 48 as byte, 46 as byte, 50 as byte, 58 as byte, 111 as byte, 112 as byte, 101 as byte, 114 as byte, 97 as byte, 116 as byte, 105 as byte, 111 as byte, 110 as byte, 58 as byte, 58 as byte];
    let seed: SemanticIdentityBuild = SemanticIdentityBuild { bytes: [0 as byte; 512], len: 0, valid: true };
    iterate i over prefix carrying d: SemanticIdentityBuild = seed { next d = callable_identity_byte(d, prefix[i]); }
    let name: SemanticIdentityBuild = identity_component_span<P, N>(pages, stride, total, d, ns, ne);
    return SemanticIdentity { bytes: name.bytes, len: name.len, valid: name.valid && ne > ns };
}
// Typed operations pop their operands and push the operation result. Like
// calls, the verifier checks arity discipline and result shape rather than
// re-deriving the authorization proof; unlike calls, the operation node is
// source-anchored by re-parsing, mirroring construction verification.
fn verify_top_op<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TDepth, t: TOpList, slot: u64, ty: SemType, argc: u64, ns: u64, ne: u64, identity: SemanticIdentity, start: u64, end: u64) -> (result: TDepth) {
    if slot > 4 || argc != op_arity(slot) || is_poison(ty) || !(identity.valid) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    if !(op_verify_result_ok(slot, ty)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    if !(semantic_identity_equal(identity, canonical_operation_identity<P, N>(pages, stride, total, ns, ne))) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    if !(op_source_valid<P, N>(pages, stride, total, slot, ns, ne, argc, start, end)) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    if st.depth < argc { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    let popped: PopN = pop_tys<P, N>(pages, stride, total, st.stack, argc);
    if !(popped.ok) { return TDepth { rest: TOpList.PNil, stack: TyStack.WNil, depth: 0, ok: false }; }
    return TDepth { rest: t, stack: TyStack.WCons { head: ty, tail: popped.rest }, depth: st.depth - argc + 1, ok: true };
}
fn op_verify_result_ok(slot: u64, ty: SemType) -> (result: bool) {
    if slot == 1 { return !(is_poison(ty)); }
    return is_u64_ty(ty);
}
fn op_source_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, slot: u64, ns: u64, ne: u64, argc: u64, start: u64, end: u64) -> (result: bool) {
    let parsed: ExprParse = parse_expr<P, N>(pages, stride, total, start, true);
    if !(parsed.ok) || parsed.start != start || parsed.end != end { return false; }
    return match parsed.node {
        OpCall { slot: found, name_start: fns, name_end: fne, args: a, start: s, end: e } => found == slot && fns == ns && fne == ne && s == start && e == end && count_exprs<P, N>(pages, stride, total, a) == argc,
        Name { start: s, end: e } => false,
        Integer { start: s, end: e, value: v, overflow: o } => false,
        Boolean { start: s, end: e, value: v } => false,
        UnaryNot { value: v, start: s, end: e } => false,
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => false,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => false,
        Binary { op: o, left: l, right: r, start: s, end: e } => false,
        Call { name_start: cns, name_end: cne, args: a, targs: tg, start: s, end: e } => false,
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => false,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => false,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => false
    };
}
fn sabotage_op_arity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    let ops: TOpList = TOpList.PCons { head: TOp.TOp { slot: 0, ty: SemType.TInt { width: 64, signed: false }, argc: 2, ns: 0, ne: 1, identity: invalid_semantic_identity(), start: 0, end: 1 }, tail: TOpList.PNil };
    return verify_tops<P, N>(pages, stride, total, ops, ExpTy.XNone);
}
fn sabotage_op_source<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    let ty: SemType = SemType.TInt { width: 64, signed: false };
    let ops: TOpList = TOpList.PCons { head: TOp.TInt { value: 1, ty: ty, start: 0, end: 1 }, tail: TOpList.PCons { head: TOp.TOp { slot: 0, ty: ty, argc: 1, ns: 0, ne: 1, identity: canonical_operation_identity<P, N>(pages, stride, total, 0, 1), start: 0, end: 1 }, tail: TOpList.PNil } };
    return verify_tops<P, N>(pages, stride, total, ops, ExpTy.XNone);
}
fn seed_call<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, ns: u64, ne: u64, args: ExprList, tg: TypeArgList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let got: SigRes = sig_lookup<P, N>(pages, stride, total, st.sigs, ns, ne);
    if !(got.found) { return sem_drain(sem_emit(st, 32, ns, ne, 1)); }
    let checked: SemState = check_generic_apply<P, N>(pages, stride, total, st, got.sig, tg, ns, ne, start, end);
    if checked.failed { return checked; }
    let argc: u64 = count_exprs<P, N>(pages, stride, total, args);
    if argc != got.sig.nparams { return sem_drain(sem_emit(checked, 6, start, end, 1)); }
    return seed_call_args<P, N>(pages, stride, total, checked, got.sig, args, start, end, exp);
}
// Generic application checking (Stage-0 call elaboration order: generic
// validation precedes value arity). Missing arguments, arguments on a
// non-generic callee, and count mismatches fail at the callee span
// (MNE220/MNE222/MNE221); per-argument kind failures carry the argument
// span. A fully validated application still records one UNKNOWN
// obligation: type substitution into the callee signature is not modeled.
record TargCheck { kind: u64, start: u64, end: u64, extra: u64 }
record TargWalk { bounds: GenericBoundList, args: TypeArgList, kind: u64, start: u64, end: u64, extra: u64, done: bool }
fn check_generic_apply<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, sig: Sig, tg: TypeArgList, ns: u64, ne: u64, start: u64, end: u64) -> (result: SemState) {
    let ng: u64 = count_bounds(sig.generic_bounds);
    let nt: u64 = count_targs(tg);
    if nt == 0 && ng == 0 { return st; }
    if nt == 0 { return sem_drain(sem_emit(st, 68, ns, ne, 1)); }
    if ng == 0 { return sem_drain(sem_emit(st, 70, ns, ne, 1)); }
    if nt != ng { return sem_drain(sem_emit(st, 69, ns, ne, 1)); }
    let checked: TargCheck = check_targ_kinds<P, N>(pages, stride, total, st, sig.generic_bounds, tg);
    if checked.kind != 0 { return check_targ_fail<P, N>(pages, stride, total, st, checked); }
    return sem_emit(st, 71, start, end, 2);
}
fn check_targ_fail<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, checked: TargCheck) -> (result: SemState) {
    if checked.extra != 0 {
        return sem_drain(sem_emit(sem_emit(st, checked.extra, checked.start, checked.end, 1), checked.kind, checked.start, checked.end, 1));
    }
    return sem_drain(sem_emit(st, checked.kind, checked.start, checked.end, 1));
}
fn check_targ_kinds<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, bounds: GenericBoundList, args: TypeArgList) -> (result: TargCheck) {
    iterate i up_to 1024 carrying d: TargWalk = TargWalk { bounds: bounds, args: args, kind: 0, start: 0, end: 0, extra: 0, done: false } {
        next d = check_targ_kinds_step<P, N>(pages, stride, total, st, d);
    }
    return TargCheck { kind: d.kind, start: d.start, end: d.end, extra: d.extra };
}
fn check_targ_kinds_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, w: TargWalk) -> (result: TargWalk) {
    if w.done || w.kind != 0 { return TargWalk { bounds: GenericBoundList.KNil, args: TypeArgList.TNil, kind: w.kind, start: w.start, end: w.end, extra: w.extra, done: true }; }
    return match w.bounds {
        KNil => TargWalk { bounds: GenericBoundList.KNil, args: TypeArgList.TNil, kind: 0, start: 0, end: 0, extra: 0, done: true },
        KCons { head: bound, tail: rest } => check_targ_kinds_cons<P, N>(pages, stride, total, st, w, bound, rest)
    };
}
fn check_targ_kinds_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, w: TargWalk, bound: u64, rest: GenericBoundList) -> (result: TargWalk) {
    return match w.args {
        TNil => TargWalk { bounds: GenericBoundList.KNil, args: TypeArgList.TNil, kind: 0, start: 0, end: 0, extra: 0, done: true },
        TCons { head: arg, tail: more } => check_one_targ_kind<P, N>(pages, stride, total, st, rest, more, bound, arg)
    };
}
fn check_one_targ_kind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, rest: GenericBoundList, more: TypeArgList, bound: u64, arg: TypeArg) -> (result: TargWalk) {
    // Higher-kinded parameters cannot be applied. Same-unit definitions
    // already fail at the definition site; failing here too keeps
    // project-level consumption of such signatures sound.
    if bound == 2 { return TargWalk { bounds: GenericBoundList.KNil, args: TypeArgList.TNil, kind: 73, start: arg.start, end: arg.end, extra: 0, done: true }; }
    let verdict: TargCheck = targ_kind_verdict<P, N>(pages, stride, total, st, bound, arg);
    if verdict.kind != 0 { return TargWalk { bounds: GenericBoundList.KNil, args: TypeArgList.TNil, kind: verdict.kind, start: verdict.start, end: verdict.end, extra: verdict.extra, done: true }; }
    return TargWalk { bounds: rest, args: more, kind: 0, start: 0, end: 0, extra: 0, done: false };
}
// One type argument against its parameter bound kind. Integer literals
// are Nat values; scalar/sequence/qualified spellings are types; names
// resolve through the caller's generic parameters, then nominals.
fn targ_kind_verdict<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, bound: u64, arg: TypeArg) -> (result: TargCheck) {
    if bound == 0 {
        return targ_nat_verdict<P, N>(pages, stride, total, st, arg);
    }
    return targ_type_verdict<P, N>(pages, stride, total, st, arg);
}
fn targ_nat_verdict<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arg: TypeArg) -> (result: TargCheck) {
    if arg.kind == 10 { return TargCheck { kind: 0, start: 0, end: 0, extra: 0 }; }
    if arg.kind == 5 { return targ_nat_name_verdict<P, N>(pages, stride, total, st, arg); }
    return TargCheck { kind: 70, start: arg.start, end: arg.end, extra: 0 };
}
fn targ_nat_name_verdict<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arg: TypeArg) -> (result: TargCheck) {
    let found: GenericLookup = generic_param_lookup<P, N>(pages, stride, total, st.gparams, arg.start, arg.end);
    if found.found && found.kind == 0 { return TargCheck { kind: 0, start: 0, end: 0, extra: 0 }; }
    if found.found { return TargCheck { kind: 70, start: arg.start, end: arg.end, extra: 0 }; }
    if op_nominal_resolved<P, N>(pages, stride, total, st.nominals, st.rectab, st.enumtab, arg.start, arg.end) {
        return TargCheck { kind: 70, start: arg.start, end: arg.end, extra: 0 };
    }
    return TargCheck { kind: 74, start: arg.start, end: arg.end, extra: 0 };
}
fn targ_type_verdict<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arg: TypeArg) -> (result: TargCheck) {
    if arg.kind == 10 { return TargCheck { kind: 70, start: arg.start, end: arg.end, extra: 19 }; }
    if arg.kind == 5 { return targ_type_name_verdict<P, N>(pages, stride, total, st, arg); }
    return TargCheck { kind: 0, start: 0, end: 0, extra: 0 };
}
fn targ_type_name_verdict<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, arg: TypeArg) -> (result: TargCheck) {
    let found: GenericLookup = generic_param_lookup<P, N>(pages, stride, total, st.gparams, arg.start, arg.end);
    if found.found && found.kind == 0 { return TargCheck { kind: 72, start: arg.start, end: arg.end, extra: 0 }; }
    if found.found { return TargCheck { kind: 0, start: 0, end: 0, extra: 0 }; }
    if op_nominal_resolved<P, N>(pages, stride, total, st.nominals, st.rectab, st.enumtab, arg.start, arg.end) {
        return TargCheck { kind: 0, start: 0, end: 0, extra: 0 };
    }
    return TargCheck { kind: 19, start: arg.start, end: arg.end, extra: 0 };
}
fn seed_call_args<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, sig: Sig, args: ExprList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match args {
        ENil => finish_call<P, N>(pages, stride, total, st, sig, start, end, exp),
        ECons { head: h, tail: t } => seed_first_arg<P, N>(pages, stride, total, st, sig, args, h, start, end, exp)
    };
}
fn seed_first_arg<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, sig: Sig, args: ExprList, h: Expr, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let ptys: TyList = params_to_tys<P, N>(pages, stride, total, sig.params);
    return match ptys {
        TyNil => finish_call<P, N>(pages, stride, total, st, sig, start, end, exp),
        TyCons { head: p, tail: q } => push_first_arg(st, sig, args, ptys, h, p, start, end, exp)
    };
}
fn push_first_arg(st: SemState, sig: Sig, args: ExprList, ptys: TyList, h: Expr, p: SemType, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let job: SemJob = SemJob { e: h, exp: ExpTy.XSome { ty: p } };
    let kont: SemKont = SemKont.KCallA { sig: sig, args: args, ptys: ptys, start: start, end: end, exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
// Expression spans for diagnostics that point at a subexpression (MNE133
// at the argument, MNE161 at the projection base).
record ExprSpan { start: u64, end: u64 }
fn expr_span(e: Expr) -> (result: ExprSpan) {
    return match e {
        Name { start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        Integer { start: s, end: e2, value: v, overflow: o } => ExprSpan { start: s, end: e2 },
        Boolean { start: s, end: e2, value: v } => ExprSpan { start: s, end: e2 },
        UnaryNot { value: value, start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        ScalarMatch { subject: subject, arms: arms, start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        Binary { op: o, left: l, right: r, start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e2, path: ph } => ExprSpan { start: s, end: e2 },
        FiniteMatch { subject: subject, arms: arms, start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e2 } => ExprSpan { start: s, end: e2 },
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e2 } => ExprSpan { start: s, end: e2 }
    };
}
// Each argument is checked against its parameter as it completes, mirroring
// elaboration order: the argument's own obligations come first, then the
// match obligation at the argument span. A mismatch records ARG_MATCH and
// continues with the actual type; arity was already gated at seeding.
fn apply_call_a<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, sig: Sig, args: ExprList, ptys: TyList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match ptys {
        TyNil => finish_call<P, N>(pages, stride, total, st, sig, start, end, exp),
        TyCons { head: p, tail: q } => apply_call_arg<P, N>(pages, stride, total, st, sig, args, p, q, start, end, exp)
    };
}
fn apply_call_arg<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, sig: Sig, args: ExprList, p: SemType, q: TyList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match args {
        ENil => finish_call<P, N>(pages, stride, total, st, sig, start, end, exp),
        ECons { head: h, tail: t } => check_arg_cons<P, N>(pages, stride, total, st, sig, h, t, p, q, start, end, exp)
    };
}
fn check_arg_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, sig: Sig, h: Expr, t: ExprList, p: SemType, q: TyList, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let asp: ExprSpan = expr_span(h);
    let actual: SemType = st.last_ty;
    let st2: SemState = check_arg_ty<P, N>(pages, stride, total, st, actual, p, asp.start, asp.end);
    return match t {
        ENil => finish_call<P, N>(pages, stride, total, st2, sig, start, end, exp),
        ECons { head: nh, tail: nt } => advance_call_arg<P, N>(pages, stride, total, st2, sig, t, q, nh, start, end, exp)
    };
}
fn check_arg_ty<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, actual: SemType, p: SemType, astart: u64, aend: u64) -> (result: SemState) {
    if sem_eq<P, N>(pages, stride, total, actual, p) { return st; }
    return sem_emit(st, 26, astart, aend, 1);
}
fn advance_call_arg<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, sig: Sig, t: ExprList, q: TyList, nh: Expr, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    return match q {
        TyNil => finish_call<P, N>(pages, stride, total, st, sig, start, end, exp),
        TyCons { head: np, tail: nq } => push_next_arg(st, sig, t, q, nh, np, start, end, exp)
    };
}
fn push_next_arg(st: SemState, sig: Sig, args: ExprList, ptys: TyList, nh: Expr, np: SemType, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let job: SemJob = SemJob { e: nh, exp: ExpTy.XSome { ty: np } };
    let kont: SemKont = SemKont.KCallA { sig: sig, args: args, ptys: ptys, start: start, end: end, exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
// Effect coverage (MNE134) compares the imported signature's exact effect and
// capability grant keys with the caller's declared grants. Owner identities
// remain attached to the call; keys are only used for this coverage rule.
fn fx_cover_check<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, need: EffectIdentityList, start: u64, end: u64) -> (result: SemState) {
    if effects_covered<P, N>(pages, stride, total, st.effects, need) { return st; }
    return sem_drain(sem_emit(st, 15, start, end, 1));
}
fn finish_call<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, sig: Sig, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let st2: SemState = fx_cover_check<P, N>(pages, stride, total, st, sig.effects, start, end);
    if st2.failed { return st2; }
    return finish_call_res<P, N>(pages, stride, total, st2, sig, start, end, exp);
}
fn finish_call_res<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, sig: Sig, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let top: TOp = TOp.TCall { ty: sig.result, argc: sig.nparams, params: sig.params, start: start, end: end, ns: sig.start, ne: sig.end, identity: sig.identity, effects: sig.effects, capabilities: sig.capabilities };
    return match exp {
        XNone => sem_emit_top(sem_accept(st, sig.result), top),
        XSome { ty: r } => finish_call_req<P, N>(pages, stride, total, st, sig, top, r, start, end)
    };
}
fn finish_call_req<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, sig: Sig, top: TOp, r: SemType, start: u64, end: u64) -> (result: SemState) {
    if sem_eq<P, N>(pages, stride, total, sig.result, r) { return sem_emit_top(sem_accept(st, sig.result), top); }
    return sem_emit_top(sem_accept(sem_emit(st, 25, start, end, 1), sig.result), top);
}
// Projection seeds its base with no requirement; the record type is
// established when the base completes. Chained projections nest through
// the base job, so each level resolves against its own base type.
fn seed_proj<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, b: Expr, fs: u64, fe: u64, s: u64, e: u64, exp: ExpTy) -> (result: SemState) {
    return match b {
        Name { start: ns, end: ne } => seed_proj_name<P, N>(pages, stride, total, st, ns, ne, fs, fe, s, e, exp),
        Integer { start: x, end: y, value: v, overflow: o } => seed_proj_base(st, b, fs, fe, s, e, exp),
        Boolean { start: x, end: y, value: v } => seed_proj_base(st, b, fs, fe, s, e, exp),
        UnaryNot { value: v, start: x, end: y } => seed_proj_base(st, b, fs, fe, s, e, exp),
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: x, end: y } => seed_proj_base(st, b, fs, fe, s, e, exp),
        ScalarMatch { subject: subject, arms: arms, start: x, end: y } => seed_proj_base(st, b, fs, fe, s, e, exp),
        Binary { op: o, left: l, right: r, start: x, end: y } => seed_proj_base(st, b, fs, fe, s, e, exp),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: x, end: y } => seed_proj_base(st, b, fs, fe, s, e, exp),
        Project { base: q, field_start: gs, field_end: ge, start: x, end: y, path: p } => seed_proj_base(st, b, fs, fe, s, e, exp),
        FiniteMatch { subject: subject, arms: arms, start: x, end: y } => seed_proj_base(st, b, fs, fe, s, e, exp),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: x, end: y } => seed_proj_base(st, b, fs, fe, s, e, exp),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: x, end: y } => seed_proj_base(st, b, fs, fe, s, e, exp),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: x, end: y } => seed_proj_base(st, b, fs, fe, s, e, exp)
    };
}
// A name-rooted projection resolves the base as an enum type first: a
// declared enum always selects a variant, even when a value binding shares
// the name. Otherwise the base must be a bound value for field projection;
// an unbound base is an unknown construction type (MNE123), never MNE102.
fn seed_proj_name<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, ns: u64, ne: u64, fs: u64, fe: u64, s: u64, e: u64, exp: ExpTy) -> (result: SemState) {
    let found: EnumFind = enum_lookup<P, N>(pages, stride, total, st.enumtab, ns, ne);
    if found.found { return seed_variant_select<P, N>(pages, stride, total, st, found.decl, ns, ne, fs, fe, s, e, exp); }
    let bound: LookupRes = env_lookup<P, N>(pages, stride, total, st.env, ns, ne);
    if !(bound.found) { return sem_drain(sem_emit(st, 42, ns, ne, 1)); }
    let base: Expr = Expr.Name { start: ns, end: ne };
    return seed_proj_base(st, base, fs, fe, s, e, exp);
}
fn seed_variant_select<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, decl: EnumDecl, ns: u64, ne: u64, fs: u64, fe: u64, s: u64, e: u64, exp: ExpTy) -> (result: SemState) {
    let variant: VariantScan = variant_scan<P, N>(pages, stride, total, decl.variants, fs, fe);
    if !(variant.found) { return sem_drain(sem_emit(st, 43, fs, fe, 1)); }
    if variant_has_fields<P, N>(pages, stride, total, variant.variant.fields) { return sem_drain(sem_emit(st, 49, s, e, 1)); }
    let ty: SemType = SemType.TNamed { start: ns, end: ne };
    let top: TOp = TOp.TEnumConstruct { ty: ty, variant_start: fs, variant_end: fe, field_count: 0, params: BindList.BNil, start: s, end: e };
    let emitted: SemState = sem_emit_top(sem_accept(st, ty), top);
    return finish_construct_exp<P, N>(pages, stride, total, emitted, ty, s, e, exp);
}
record FieldPresent { rest: FieldList, found: bool }
fn variant_has_fields<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList) -> (result: bool) {
    iterate i up_to 1024 carrying d: FieldPresent = FieldPresent { rest: fields, found: false } {
        next d = variant_has_fields_step(d);
    }
    return d.found;
}
fn variant_has_fields_step(st: FieldPresent) -> (result: FieldPresent) {
    if st.found { return st; }
    return match st.rest {
        FNil => st,
        FCons { head: field, tail: rest } => FieldPresent { rest: FieldList.FNil, found: true }
    };
}
fn seed_proj_base(st: SemState, b: Expr, fs: u64, fe: u64, s: u64, e: u64, exp: ExpTy) -> (result: SemState) {
    let bsp: ExprSpan = expr_span(b);
    let job: SemJob = SemJob { e: b, exp: ExpTy.XNone };
    let kont: SemKont = SemKont.KProj { fstart: fs, fend: fe, bstart: bsp.start, bend: bsp.end, start: s, end: e, exp: exp };
    return SemState { ..st, jobs: JobList.JCons { head: job, tail: st.jobs }, konts: KontList.QCons { head: kont, tail: st.konts } };
}
fn apply_proj<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, fs: u64, fe: u64, bs: u64, be: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let bty: SemType = st.last_ty;
    if is_poison(bty) {
        return sem_emit_top(sem_accept(st, SemType.TPoison), TOp.TProj { ty: SemType.TPoison, fstart: fs, fend: fe, field_index: 0, start: start, end: end });
    }
    return match bty {
        TNamed { start: ns, end: ne } => proj_named<P, N>(pages, stride, total, st, ns, ne, fs, fe, bs, be, start, end, exp),
        TBool => sem_drain(sem_emit(st, 23, bs, be, 1)),
        TByte => sem_drain(sem_emit(st, 23, bs, be, 1)),
        TInt { width: w, signed: g } => sem_drain(sem_emit(st, 23, bs, be, 1)),
        TSeq => sem_drain(sem_emit(st, 23, bs, be, 1)),
        TSeqExact { element: element, length: length, length_valid: valid } => sem_drain(sem_emit(st, 23, bs, be, 1)),
        TPoison => sem_emit_top(sem_accept(st, SemType.TPoison), TOp.TProj { ty: SemType.TPoison, fstart: fs, fend: fe, field_index: 0, start: start, end: end })
    };
}
// Records resolve by exact name bytes over the collected table; fields
// resolve by exact name bytes within the record, first declaration wins.
record RecFind { rest: RecordList, ns: u64, ne: u64, found: bool, decl: RecordDecl }
record FieldScan { rest: FieldList, fs: u64, fe: u64, found: bool, field: Field, index: u64 }
fn rec_lookup<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, rectab: RecordList, ns: u64, ne: u64) -> (result: RecFind) {
    iterate i up_to 1024 carrying d: RecFind = RecFind { rest: rectab, ns: ns, ne: ne, found: false, decl: RecordDecl { ok: false, err_start: 0, err_end: 0, name_start: 0, name_end: 0, fields: FieldList.FNil, decl_start: 0, decl_end: 0, cursor: 0 } } {
        next d = rec_lookup_step<P, N>(pages, stride, total, d);
    }
    return d;
}
fn rec_lookup_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecFind) -> (result: RecFind) {
    if st.found { return st; }
    return match st.rest {
        RNil => st,
        RCons { head: h, tail: t } => rec_lookup_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn rec_lookup_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecFind, h: RecordDecl, t: RecordList) -> (result: RecFind) {
    if spans_equal<P, N>(pages, stride, total, h.name_start, h.name_end, st.ns, st.ne) {
        return RecFind { rest: RecordList.RNil, ns: st.ns, ne: st.ne, found: true, decl: h };
    }
    return RecFind { rest: t, ns: st.ns, ne: st.ne, found: false, decl: st.decl };
}
fn field_scan<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList, fs: u64, fe: u64) -> (result: FieldScan) {
    iterate i up_to 1024 carrying d: FieldScan = FieldScan { rest: fields, fs: fs, fe: fe, found: false, field: Field { name_start: 0, name_end: 0, type_start: 0, type_end: 0, type_kind: 9 }, index: 0 } {
        next d = field_scan_step<P, N>(pages, stride, total, d);
    }
    return d;
}
fn field_scan_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldScan) -> (result: FieldScan) {
    if st.found { return st; }
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => field_scan_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn field_scan_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldScan, h: Field, t: FieldList) -> (result: FieldScan) {
    if spans_equal<P, N>(pages, stride, total, h.name_start, h.name_end, st.fs, st.fe) {
        return FieldScan { rest: FieldList.FNil, fs: st.fs, fe: st.fe, found: true, field: h, index: st.index };
    }
    return FieldScan { rest: t, fs: st.fs, fe: st.fe, found: false, field: st.field, index: st.index + 1 };
}
// Enum/variant resolution mirrors record/field resolution: exact name bytes
// over the collected tables, first declaration wins.
record EnumFind { rest: EnumList, ns: u64, ne: u64, found: bool, decl: EnumDecl }
record VariantScan { rest: VariantList, vs: u64, ve: u64, found: bool, variant: Variant }
fn enum_lookup<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, enumtab: EnumList, ns: u64, ne: u64) -> (result: EnumFind) {
    iterate i up_to 1024 carrying d: EnumFind = EnumFind { rest: enumtab, ns: ns, ne: ne, found: false, decl: EnumDecl { ok: false, err_start: 0, err_end: 0, name_start: 0, name_end: 0, variants: VariantList.VNil, decl_start: 0, decl_end: 0, cursor: 0 } } {
        next d = enum_lookup_step<P, N>(pages, stride, total, d);
    }
    return d;
}
fn enum_lookup_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: EnumFind) -> (result: EnumFind) {
    if st.found { return st; }
    return match st.rest {
        GNil => st,
        GCons { head: h, tail: t } => enum_lookup_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn enum_lookup_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: EnumFind, h: EnumDecl, t: EnumList) -> (result: EnumFind) {
    if spans_equal<P, N>(pages, stride, total, h.name_start, h.name_end, st.ns, st.ne) {
        return EnumFind { rest: EnumList.GNil, ns: st.ns, ne: st.ne, found: true, decl: h };
    }
    return EnumFind { rest: t, ns: st.ns, ne: st.ne, found: false, decl: st.decl };
}
fn variant_scan<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, variants: VariantList, vs: u64, ve: u64) -> (result: VariantScan) {
    iterate i up_to 1024 carrying d: VariantScan = VariantScan { rest: variants, vs: vs, ve: ve, found: false, variant: Variant { name_start: 0, name_end: 0, fields: FieldList.FNil } } {
        next d = variant_scan_step<P, N>(pages, stride, total, d);
    }
    return d;
}
fn variant_scan_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: VariantScan) -> (result: VariantScan) {
    if st.found { return st; }
    return match st.rest {
        VNil => st,
        VCons { head: h, tail: t } => variant_scan_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn variant_scan_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: VariantScan, h: Variant, t: VariantList) -> (result: VariantScan) {
    if spans_equal<P, N>(pages, stride, total, h.name_start, h.name_end, st.vs, st.ve) {
        return VariantScan { rest: VariantList.VNil, vs: st.vs, ve: st.ve, found: true, variant: h };
    }
    return VariantScan { rest: t, vs: st.vs, ve: st.ve, found: false, variant: st.variant };
}
fn proj_named<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, ns: u64, ne: u64, fs: u64, fe: u64, bs: u64, be: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let got: RecFind = rec_lookup<P, N>(pages, stride, total, st.rectab, ns, ne);
    if !(got.found) { return sem_drain(sem_emit(st, 23, bs, be, 1)); }
    let fld: FieldScan = field_scan<P, N>(pages, stride, total, got.decl.fields, fs, fe);
    if !(fld.found) { return sem_drain(sem_emit(st, 22, fs, fe, 1)); }
    let fty: TyRes = resolve_type<P, N>(pages, stride, total, fld.field.type_kind, fld.field.type_start, fld.field.type_end, st.rectab, st.enumtab, st.nominals);
    if !(fty.ok) {
        return sem_emit_top(sem_accept(st, SemType.TPoison), TOp.TProj { ty: SemType.TPoison, fstart: fs, fend: fe, field_index: 0, start: start, end: end });
    }
    return finish_proj_exp<P, N>(pages, stride, total, st, fty.ty, fs, fe, fld.index, start, end, exp);
}
fn finish_proj_exp<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, fty: SemType, fs: u64, fe: u64, field_index: u64, start: u64, end: u64, exp: ExpTy) -> (result: SemState) {
    let top: TOp = TOp.TProj { ty: fty, fstart: fs, fend: fe, field_index: field_index, start: start, end: end };
    return match exp {
        XNone => sem_emit_top(sem_accept(st, fty), top),
        XSome { ty: r } => finish_proj_req<P, N>(pages, stride, total, st, fty, top, r, start, end)
    };
}
fn finish_proj_req<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SemState, fty: SemType, top: TOp, r: SemType, start: u64, end: u64) -> (result: SemState) {
    if sem_eq<P, N>(pages, stride, total, fty, r) { return sem_emit_top(sem_accept(st, fty), top); }
    return sem_emit_top(sem_accept(sem_emit(st, 35, start, end, 1), fty), top);
}
// Function bodies: statement proving over the expression machine (F12).
// Signatures are collected for the whole unit first (elaboration order is
// [all signatures] then [all bodies]); each body re-resolves its own
// parameter and result annotations, so declaration type failures surface
// twice, while scope duplicates stay signature-side. A body whose result
// list does not hold exactly one output is skipped after its signature:
// with no single output there is no expectation to prove against.
record StmtSpan { start: u64, end: u64 }
fn stmt_span(h: Stmt) -> (result: StmtSpan) {
    return match h {
        Let { name_start: a, name_end: b, type_start: c, type_end: d, type_kind: k, value: v, start: s, end: e } => StmtSpan { start: s, end: e },
        If { cond: c, then_b: tb, else_b: eb, start: s, end: e } => StmtSpan { start: s, end: e },
        Fail { mode_start: a, mode_end: b, start: s, end: e } => StmtSpan { start: s, end: e },
        Return { value: v, start: s, end: e } => StmtSpan { start: s, end: e },
        Iterate { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, body: b, next_start: xs, next_end: xe, next_value: nv, start: s, end: e } => StmtSpan { start: s, end: e }
    };
}
// Failure modes are raw name bytes matched exactly: isolated, atomic,
// fatal. Anything else records FAIL_MODE and behaves as a terminator.
fn fail_mode_ok<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, a: u64, b: u64) -> (result: bool) {
    if b < a { return false; }
    if b - a == 8 { return fail_is_isolated<P, N>(pages, stride, total, a); }
    if b - a == 6 { return fail_is_atomic<P, N>(pages, stride, total, a); }
    if b - a == 5 { return fail_is_fatal<P, N>(pages, stride, total, a); }
    return false;
}
fn fail_is_isolated<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, a: u64) -> (result: bool) {
    if segment.byte_at_global<P, N>(pages, stride, total, a) != 105 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 1) != 115 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 2) != 111 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 3) != 108 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 4) != 97 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 5) != 116 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 6) != 101 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 7) != 100 { return false; }
    return true;
}
fn fail_is_atomic<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, a: u64) -> (result: bool) {
    if segment.byte_at_global<P, N>(pages, stride, total, a) != 97 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 1) != 116 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 2) != 111 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 3) != 109 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 4) != 105 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 5) != 99 { return false; }
    return true;
}
fn fail_is_fatal<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, a: u64) -> (result: bool) {
    if segment.byte_at_global<P, N>(pages, stride, total, a) != 102 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 1) != 97 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 2) != 116 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 3) != 97 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 4) != 108 { return false; }
    return true;
}
// The type-stack verifier only guards clean lowerings: poison in the
// established or required type means a FAIL obligation already covers
// this proof, and poisoned IR is never verified. Statement sites verify
// shape only (XNone): the required-type comparison belongs to the match
// obligations, which stay non-fatal.
fn want_poison(w: ExpTy) -> (result: bool) {
    return match w { XNone => false, XSome { ty: t } => is_poison(t) };
}
record FldObl { rest: FieldList, obls: OblList }
fn field_type_obls<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: OblList) {
    iterate i up_to 1024 carrying d: FldObl = FldObl { rest: fields, obls: OblList.LNil } {
        next d = field_obls_step<P, N>(pages, stride, total, d, rectab, enumtab, nominals);
    }
    return reverse_obls<P, N>(pages, stride, total, d.obls);
}
fn field_obls_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FldObl, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: FldObl) {
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => field_obls_cons<P, N>(pages, stride, total, st, h, t, rectab, enumtab, nominals)
    };
}
fn field_obls_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FldObl, h: Field, t: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: FldObl) {
    let ty: TyRes = resolve_type<P, N>(pages, stride, total, h.type_kind, h.type_start, h.type_end, rectab, enumtab, nominals);
    let tob: OblList = param_type_obl(h, ty);
    return FldObl { rest: t, obls: append_obls<P, N>(pages, stride, total, st.obls, tob) };
}
record ResCount { rest: FieldList, n: u64 }
fn count_results_fields<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList) -> (result: u64) {
    iterate i up_to 1024 carrying d: ResCount = ResCount { rest: fields, n: 0 } {
        next d = count_results_step(d);
    }
    return d.n;
}
fn count_results_step(st: ResCount) -> (result: ResCount) {
    return match st.rest { FNil => st, FCons { head: h, tail: t } => ResCount { rest: t, n: st.n + 1 } };
}
// Statement proving as one iterative machine over an explicit frame stack:
// branch bodies cannot recurse (statement recursion is unavailable), so an
// `if` suspends its parent list in a frame while each arm proves in a
// pushed scope. Obligation lists stay in source order throughout: proved
// expressions arrive ordered, single obligations append behind them.
record StmtFrame { next: StmtList, saved_env: ScopeStack, else_b: StmtList, phase: u64 }
enum StmtFrames { BrNil, BrCons { head: StmtFrame, tail: StmtFrames } }
record StmtWalk { rest: StmtList, frames: StmtFrames, env: ScopeStack, closed: bool, ok: bool, obls: OblList, tops: TopsList, sig: Sig, gparams: GenericParamList, sigs: SigTab, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList, total: u64 }
fn prove_stmts<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, w: StmtWalk) -> (result: StmtWalk) {
    iterate i up_to 1024 carrying d: StmtWalk = w {
        next d = prove_stmt_step<P, N>(pages, stride, total, d);
    }
    return d;
}
fn prove_stmt_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk) -> (result: StmtWalk) {
    if !(st.ok) { return StmtWalk { ..st, rest: StmtList.SNil, frames: StmtFrames.BrNil }; }
    return match st.rest {
        SNil => unwind_or_done(st),
        SCons { head: h, tail: t } => prove_stmt_cons<P, N>(pages, stride, total, st, h, t)
    };
}
fn prove_stmt_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, h: Stmt, t: StmtList) -> (result: StmtWalk) {
    if st.closed {
        let sp: StmtSpan = stmt_span(h);
        let obl: OblList = OblList.LCons { head: Obligation { kind: 20, start: sp.start, end: sp.end, status: 1 }, tail: OblList.LNil };
        return StmtWalk { ..st, rest: StmtList.SNil, obls: append_obls<P, N>(pages, stride, total, st.obls, obl) };
    }
    return prove_one_stmt<P, N>(pages, stride, total, st, h, t);
}
fn unwind_or_done(st: StmtWalk) -> (result: StmtWalk) {
    return match st.frames {
        BrNil => st,
        BrCons { head: f, tail: t } => unwind_frame(st, f, t)
    };
}
fn unwind_frame(st: StmtWalk, f: StmtFrame, t: StmtFrames) -> (result: StmtWalk) {
    if f.phase == 0 {
        let frame: StmtFrame = StmtFrame { next: f.next, saved_env: f.saved_env, else_b: f.else_b, phase: 1 };
        return StmtWalk { ..st, rest: f.else_b, frames: StmtFrames.BrCons { head: frame, tail: t }, env: push_scope(f.saved_env), closed: false };
    }
    return StmtWalk { ..st, rest: f.next, frames: t, env: f.saved_env, closed: false };
}
fn close_and(a: bool, b: bool) -> (result: bool) {
    if !(a) { return false; }
    if !(b) { return false; }
    return true;
}
fn prove_one_stmt<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, h: Stmt, t: StmtList) -> (result: StmtWalk) {
    return match h {
        Let { name_start: a, name_end: b, type_start: c, type_end: d, type_kind: k, value: v, start: s, end: e } => prove_let<P, N>(pages, stride, total, st, t, a, b, c, d, k, v, s, e),
        If { cond: c, then_b: tb, else_b: eb, start: s, end: e } => prove_if<P, N>(pages, stride, total, st, t, c, tb, eb, s, e),
        Fail { mode_start: a, mode_end: b, start: s, end: e } => prove_fail<P, N>(pages, stride, total, st, t, a, b, s, e),
        Return { value: v, start: s, end: e } => prove_return_val<P, N>(pages, stride, total, st, v, t, s, e),
        Iterate { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, body: b, next_start: xs, next_end: xe, next_value: nv, start: s, end: e } => prove_iterate<P, N>(pages, stride, total, st, t, s, e)
    };
}
// Loop checking (carried-state fixed-point establishment over the body
// and transition) is unmodeled: fail the proof here with an explicit
// span rather than emitting unmodeled typed IR.
fn prove_iterate<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, t: StmtList, s: u64, e: u64) -> (result: StmtWalk) {
    let obl: OblList = OblList.LCons { head: Obligation { kind: 2, start: s, end: e, status: 1 }, tail: OblList.LNil };
    return StmtWalk { ..st, rest: StmtList.SNil, frames: StmtFrames.BrNil, ok: false, obls: append_obls<P, N>(pages, stride, total, st.obls, obl) };
}
fn prove_let<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, t: StmtList, a: u64, b: u64, c: u64, d: u64, k: u64, v: Expr, s: u64, e: u64) -> (result: StmtWalk) {
    let ty: TyRes = resolve_type<P, N>(pages, stride, total, k, c, d, st.rectab, st.enumtab, st.nominals);
    let tob: OblList = param_type_obl(Field { name_start: a, name_end: b, type_start: c, type_end: d, type_kind: k }, ty);
    let declared: SemType = param_bound_type(ty);
    let want: ExpTy = ExpTy.XSome { ty: declared };
    let res: ExprRes = prove_expr<P, N>(pages, stride, total, st.env, st.sigs, st.rectab, st.enumtab, st.nominals, st.sig.effects, st.sig.fx, st.sig.raw_capabilities, st.gparams, v, want);
    let obls1: OblList = append_obls<P, N>(pages, stride, total, append_obls<P, N>(pages, stride, total, st.obls, tob), res.obls);
    if !(res.ok) { return StmtWalk { ..st, rest: t, obls: obls1 }; }
    if !(skip_verify(res.ty, want)) {
        if !(verify_tops<P, N>(pages, stride, total, res.tops, ExpTy.XNone)) {
            return StmtWalk { ..st, rest: StmtList.SNil, frames: StmtFrames.BrNil, ok: false, obls: obls1, tops: TopsList.TLCons { head: res.tops, tail: st.tops } };
        }
    }
    return finish_let<P, N>(pages, stride, total, st, t, a, b, s, e, res, declared, obls1);
}
fn skip_verify(ty: SemType, want: ExpTy) -> (result: bool) {
    if is_poison(ty) { return true; }
    if want_poison(want) { return true; }
    return false;
}
fn finish_let<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, t: StmtList, a: u64, b: u64, s: u64, e: u64, res: ExprRes, declared: SemType, obls1: OblList) -> (result: StmtWalk) {
    let obls2: OblList = match_obl<P, N>(pages, stride, total, st, res.ty, declared, obls1, 28, s, e);
    let bind: BindRes = env_bind_current<P, N>(pages, stride, total, st.env, a, b, declared);
    let obls3: OblList = dup_obl<P, N>(pages, stride, total, st, bind, obls2, a, b);
    return StmtWalk { ..st, rest: t, env: bind.stack, obls: obls3, tops: TopsList.TLCons { head: res.tops, tail: st.tops } };
}
fn match_obl<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, actual: SemType, want_ty: SemType, obls: OblList, kind: u64, s: u64, e: u64) -> (result: OblList) {
    if sem_eq<P, N>(pages, stride, total, actual, want_ty) { return obls; }
    if seq_borrow_ok<P, N>(pages, stride, total, actual, want_ty) { return obls; }
    let obl: OblList = OblList.LCons { head: Obligation { kind: kind, start: s, end: e, status: 1 }, tail: OblList.LNil };
    return append_obls<P, N>(pages, stride, total, obls, obl);
}
fn dup_obl<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, bind: BindRes, obls: OblList, a: u64, b: u64) -> (result: OblList) {
    if !(bind.dup) { return obls; }
    let obl: OblList = OblList.LCons { head: Obligation { kind: 5, start: a, end: b, status: 1 }, tail: OblList.LNil };
    return append_obls<P, N>(pages, stride, total, obls, obl);
}
fn prove_if<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, t: StmtList, c: Expr, tb: StmtList, eb: StmtList, s: u64, e: u64) -> (result: StmtWalk) {
    let want: ExpTy = ExpTy.XSome { ty: SemType.TBool };
    let res: ExprRes = prove_expr<P, N>(pages, stride, total, st.env, st.sigs, st.rectab, st.enumtab, st.nominals, st.sig.effects, st.sig.fx, st.sig.raw_capabilities, st.gparams, c, want);
    let obls1: OblList = append_obls<P, N>(pages, stride, total, st.obls, res.obls);
    if !(res.ok) { return StmtWalk { ..st, rest: t, obls: obls1 }; }
    if !(skip_verify(res.ty, want)) {
        if !(verify_tops<P, N>(pages, stride, total, res.tops, ExpTy.XNone)) {
            return StmtWalk { ..st, rest: StmtList.SNil, frames: StmtFrames.BrNil, ok: false, obls: obls1, tops: TopsList.TLCons { head: res.tops, tail: st.tops } };
        }
    }
    let tops1: TopsList = TopsList.TLCons { head: res.tops, tail: st.tops };
    if sem_eq<P, N>(pages, stride, total, res.ty, SemType.TBool) {
        return prove_if_arms(st, t, tb, eb, obls1, tops1);
    }
    return prove_if_reject<P, N>(pages, stride, total, st, t, c, obls1, tops1);
}
fn prove_if_arms(st: StmtWalk, t: StmtList, tb: StmtList, eb: StmtList, obls1: OblList, tops1: TopsList) -> (result: StmtWalk) {
    let frame: StmtFrame = StmtFrame { next: t, saved_env: st.env, else_b: eb, phase: 0 };
    return StmtWalk { ..st, rest: tb, frames: StmtFrames.BrCons { head: frame, tail: st.frames }, env: push_scope(st.env), closed: false, obls: obls1, tops: tops1 };
}
fn prove_if_reject<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, t: StmtList, c: Expr, obls1: OblList, tops1: TopsList) -> (result: StmtWalk) {
    let csp: ExprSpan = expr_span(c);
    let obl: OblList = OblList.LCons { head: Obligation { kind: 24, start: csp.start, end: csp.end, status: 1 }, tail: OblList.LNil };
    return StmtWalk { ..st, rest: t, obls: append_obls<P, N>(pages, stride, total, obls1, obl), tops: tops1 };
}
fn prove_fail<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, t: StmtList, a: u64, b: u64, s: u64, e: u64) -> (result: StmtWalk) {
    if fail_mode_ok<P, N>(pages, stride, total, a, b) {
        return StmtWalk { ..st, rest: t, closed: true };
    }
    let obl: OblList = OblList.LCons { head: Obligation { kind: 21, start: s, end: e, status: 1 }, tail: OblList.LNil };
    return StmtWalk { ..st, rest: t, closed: true, obls: append_obls<P, N>(pages, stride, total, st.obls, obl) };
}
// A returned name resolves only: no requirement is checked against it, so
// NAME_TYPE never fires here; the output comparison below still applies.
// Any other tail value elaborates against the declared output.
fn prove_return_val<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, v: Expr, t: StmtList, qs: u64, qe: u64) -> (result: StmtWalk) {
    return match v {
        Name { start: ns, end: ne } => prove_return_name<P, N>(pages, stride, total, st, t, ns, ne, qs, qe),
        Integer { start: s, end: e2, value: vv, overflow: o } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe),
        Boolean { start: s, end: e2, value: vv } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe),
        UnaryNot { value: value, start: s, end: e2 } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe),
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e2 } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe),
        ScalarMatch { subject: subject, arms: arms, start: s, end: e2 } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe),
        Binary { op: o, left: l, right: r, start: s, end: e2 } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe),
        Call { name_start: ns, name_end: ne, args: a, targs: tg, start: s, end: e2 } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe),
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e2, path: ph } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe),
        FiniteMatch { subject: subject, arms: arms, start: s, end: e2 } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe),
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e2 } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe),
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e2 } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe),
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e2 } => prove_return_expr<P, N>(pages, stride, total, st, v, t, qs, qe)
    };
}
fn prove_return_name<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, t: StmtList, ns: u64, ne: u64, qs: u64, qe: u64) -> (result: StmtWalk) {
    let got: LookupRes = env_lookup<P, N>(pages, stride, total, st.env, ns, ne);
    if !(got.found) {
        let obl: OblList = OblList.LCons { head: Obligation { kind: 1, start: ns, end: ne, status: 1 }, tail: OblList.LNil };
        return StmtWalk { ..st, rest: t, obls: append_obls<P, N>(pages, stride, total, st.obls, obl) };
    }
    let top: TOp = TOp.TName { ty: got.ty, start: ns, end: ne };
    let tops1: TopsList = TopsList.TLCons { head: TOpList.PCons { head: top, tail: TOpList.PNil }, tail: st.tops };
    let obls1: OblList = match_obl<P, N>(pages, stride, total, st, got.ty, st.sig.result, st.obls, 27, qs, qe);
    return StmtWalk { ..st, rest: t, closed: true, obls: obls1, tops: tops1 };
}
fn prove_return_expr<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StmtWalk, v: Expr, t: StmtList, qs: u64, qe: u64) -> (result: StmtWalk) {
    let want: ExpTy = ExpTy.XSome { ty: st.sig.result };
    let res: ExprRes = prove_expr<P, N>(pages, stride, total, st.env, st.sigs, st.rectab, st.enumtab, st.nominals, st.sig.effects, st.sig.fx, st.sig.raw_capabilities, st.gparams, v, want);
    let obls1: OblList = append_obls<P, N>(pages, stride, total, st.obls, res.obls);
    if !(res.ok) { return StmtWalk { ..st, rest: t, obls: obls1 }; }
    if !(skip_verify(res.ty, want)) {
        if !(verify_tops<P, N>(pages, stride, total, res.tops, ExpTy.XNone)) {
            return StmtWalk { ..st, rest: StmtList.SNil, frames: StmtFrames.BrNil, ok: false, obls: obls1, tops: TopsList.TLCons { head: res.tops, tail: st.tops } };
        }
    }
    let obls2: OblList = match_obl<P, N>(pages, stride, total, st, res.ty, st.sig.result, obls1, 27, qs, qe);
    return StmtWalk { ..st, rest: t, closed: true, obls: obls2, tops: TopsList.TLCons { head: res.tops, tail: st.tops } };
}
fn prove_tail<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, w: StmtWalk, ret: Expr) -> (result: StmtWalk) {
    let sp: ExprSpan = expr_span(ret);
    if w.closed {
        let obl: OblList = OblList.LCons { head: Obligation { kind: 20, start: sp.start, end: sp.end, status: 1 }, tail: OblList.LNil };
        return StmtWalk { ..w, obls: append_obls<P, N>(pages, stride, total, w.obls, obl) };
    }
    return prove_return_val<P, N>(pages, stride, total, w, ret, StmtList.SNil, sp.start, sp.end);
}
record FnProve { ok: bool, obls: OblList, tops: TopsList }
fn prove_fn<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, h: FnDecl, sig: Sig, sigs: SigTab, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: FnProve) {

    let nres: u64 = count_results_fields<P, N>(pages, stride, total, h.sig.results);
    if nres != 1 { return FnProve { ok: true, obls: OblList.LNil, tops: TopsList.TLNil }; }
    let par: OblList = field_type_obls<P, N>(pages, stride, total, h.sig.params, rectab, enumtab, nominals);
    let res: OblList = field_type_obls<P, N>(pages, stride, total, h.sig.results, rectab, enumtab, nominals);
    let env0: ScopeStack = ScopeStack.ZCons { head: Scope { binds: sig.params }, tail: ScopeStack.ZNil };
    let w0: StmtWalk = StmtWalk { rest: h.body.body, frames: StmtFrames.BrNil, env: env0, closed: false, ok: true, obls: OblList.LNil, tops: TopsList.TLNil, sig: sig, gparams: h.sig.generics, sigs: sigs, rectab: rectab, enumtab: enumtab, nominals: nominals, total: total };
    let w1: StmtWalk = prove_stmts<P, N>(pages, stride, total, w0);
    if walk_stuck(w1) { return FnProve { ok: false, obls: append_obls<P, N>(pages, stride, total, par, append_obls<P, N>(pages, stride, total, res, w1.obls)), tops: topslist_reverse<P, N>(pages, stride, total, w1.tops) }; }
    let w2: StmtWalk = prove_tail<P, N>(pages, stride, total, w1, h.body.ret);
    return FnProve { ok: w2.ok, obls: append_obls<P, N>(pages, stride, total, par, append_obls<P, N>(pages, stride, total, res, w2.obls)), tops: topslist_reverse<P, N>(pages, stride, total, w2.tops) };
}
fn walk_stuck(w: StmtWalk) -> (result: bool) {
    return match w.rest {
        SNil => frames_stuck(w.frames),
        SCons { head: h, tail: t } => true
    };
}
fn frames_stuck(frames: StmtFrames) -> (result: bool) {
    return match frames { BrNil => false, BrCons { head: h, tail: t } => true };
}
record TopsLRev { rest: TopsList, acc: TopsList }
fn topslist_reverse<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: TopsList) -> (result: TopsList) {
    iterate i up_to 1024 carrying d: TopsLRev = TopsLRev { rest: list, acc: TopsList.TLNil } {
        next d = topslist_reverse_step(d);
    }
    return d.acc;
}
fn topslist_reverse_step(st: TopsLRev) -> (result: TopsLRev) {
    return match st.rest { TLNil => st, TLCons { head: h, tail: t } => TopsLRev { rest: t, acc: TopsList.TLCons { head: h, tail: st.acc } } };
}
record TopsLPrepend { rest: TopsList, acc: TopsList }
fn append_topslist<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, first: TopsList, second: TopsList) -> (result: TopsList) {
    let rev: TopsList = topslist_reverse<P, N>(pages, stride, total, first);
    iterate i up_to 1024 carrying d: TopsLPrepend = TopsLPrepend { rest: rev, acc: second } {
        next d = append_topslist_step(d);
    }
    return d.acc;
}
fn append_topslist_step(st: TopsLPrepend) -> (result: TopsLPrepend) {
    return match st.rest { TLNil => st, TLCons { head: h, tail: t } => TopsLPrepend { rest: t, acc: TopsList.TLCons { head: h, tail: st.acc } } };
}
// The unit proof runs in elaboration order: every signature first, then
// every body against the completed table. Table order is reverse-source
// (prepend accumulation), which lookup does not observe: after duplicate
// rejection each name resolves at most once.
record SigTabRep { tab: SigTab, obls: OblList }
record SigWalk { rest: FnList, tab: SigTab, obls: OblList, nominals: NominalTypeIdentityList }
fn collect_sigtab<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fns: FnList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: SigTabRep) {
    iterate i up_to 1024 carrying d: SigWalk = SigWalk { rest: fns, tab: SigTab.HNil, obls: OblList.LNil, nominals: nominals } {
        next d = collect_sigtab_step<P, N>(pages, stride, total, d, rectab, enumtab, nominals);
    }
    return SigTabRep { tab: d.tab, obls: d.obls };
}
fn collect_sigtab_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SigWalk, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: SigWalk) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => collect_one_sig<P, N>(pages, stride, total, st, h, t, rectab, enumtab, nominals)
    };
}
fn collect_one_sig<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SigWalk, h: FnDecl, t: FnList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: SigWalk) {
    let rep: SigRep = check_sig<P, N>(pages, stride, total, h, rectab, enumtab, nominals);
    let tob: OblList = obl_only_types<P, N>(pages, stride, total, rep.obls);
    return SigWalk { rest: t, tab: SigTab.HCons { head: rep.sig, tail: st.tab }, obls: append_obls<P, N>(pages, stride, total, st.obls, tob), nominals: nominals };
}
// Signature obligations split across elaboration passes: declaration type
// validity (TYPE_VALID/QUALIFIED) resolves for every function first; scope,
// count, authorization, and contract obligations stay per-function.
fn is_type_obl_kind(k: u64) -> (result: bool) {
    if k == 19 { return true; }
    if k == 31 { return true; }
    return false;
}
record OblKeep { rest: OblList, acc: OblList, keep: bool }
fn obl_filter_types<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, obls: OblList, keep: bool) -> (result: OblList) {
    iterate i up_to 1024 carrying d: OblKeep = OblKeep { rest: obls, acc: OblList.LNil, keep: keep } {
        next d = obl_filter_step(d);
    }
    return reverse_obls<P, N>(pages, stride, total, d.acc);
}
fn obl_filter_step(st: OblKeep) -> (result: OblKeep) {
    return match st.rest {
        LNil => st,
        LCons { head: h, tail: t } => obl_filter_cons(st, h, t)
    };
}
fn obl_filter_cons(st: OblKeep, h: Obligation, t: OblList) -> (result: OblKeep) {
    if is_type_obl_kind(h.kind) {
        if st.keep { return OblKeep { rest: t, acc: OblList.LCons { head: h, tail: st.acc }, keep: st.keep }; }
        return OblKeep { rest: t, acc: st.acc, keep: st.keep };
    }
    if st.keep { return OblKeep { rest: t, acc: st.acc, keep: st.keep }; }
    return OblKeep { rest: t, acc: OblList.LCons { head: h, tail: st.acc }, keep: st.keep };
}
fn obl_only_types<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, obls: OblList) -> (result: OblList) {

    return obl_filter_types<P, N>(pages, stride, total, obls, true);
}
record BodyWalk { rest: FnList, tab: SigTab, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList, total: u64, obls: OblList, tops: TopsList, ok: bool, n: u64 }
fn prove_bodies<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BodyWalk) -> (result: BodyWalk) {
    iterate i up_to 1024 carrying d: BodyWalk = st {
        next d = prove_bodies_step<P, N>(pages, stride, total, d);
    }
    return d;
}
fn prove_bodies_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BodyWalk) -> (result: BodyWalk) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => prove_one_body<P, N>(pages, stride, total, st, h, t)
    };
}
fn prove_one_body<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BodyWalk, h: FnDecl, t: FnList) -> (result: BodyWalk) {
    let nres: u64 = count_results_fields<P, N>(pages, stride, total, h.sig.results);
    if nres != 1 { return prove_body_skip<P, N>(pages, stride, total, st, h, t); }
    // The declaration pass already resolved this function into st.tab with
    // its project-owned callable/effect/capability identities. Reuse that fact
    // instead of rebuilding a raw signature during body proof.
    let callable: SigRes = sig_lookup<P, N>(pages, stride, total, st.tab, h.sig.name_start, h.sig.name_end);
    let rest: OblList = sig_rest_obls<P, N>(pages, stride, total, st, h);
    let rep: FnProve = prove_fn<P, N>(pages, stride, total, h, callable.sig, st.tab, st.rectab, st.enumtab, st.nominals);
    let obls1: OblList = append_obls<P, N>(pages, stride, total, st.obls, rest);
    return BodyWalk { ..st, rest: t, obls: append_obls<P, N>(pages, stride, total, obls1, rep.obls), tops: append_topslist<P, N>(pages, stride, total, st.tops, rep.tops), ok: close_and(st.ok, rep.ok), n: st.n + 1 };
}
// A result list without exactly one output ends the function after a
// single RESULT_ONE obligation: no clause, scope, or body work follows.
fn prove_body_skip<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BodyWalk, h: FnDecl, t: FnList) -> (result: BodyWalk) {
    let obl: OblList = OblList.LCons { head: Obligation { kind: 18, start: h.fn_start, end: h.fn_end, status: 1 }, tail: OblList.LNil };
    return BodyWalk { ..st, rest: t, obls: append_obls<P, N>(pages, stride, total, st.obls, obl), n: st.n + 1 };
}
// Per-function signature remainder in elaboration order: capabilities,
// effects, contracts, then parameter scope. Declaration type validity
// already resolved in the pre-pass; the count gate above owns RESULT_ONE.
fn sig_rest_obls<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BodyWalk, h: FnDecl) -> (result: OblList) {
    let sg: FnSig = h.sig;
    let gs: OblList = check_generic_bound_obls<P, N>(pages, stride, total, sg.generics);
    let cs: CapRep = check_caps<P, N>(pages, stride, total, sg.capabilities);
    let es: FxRep = check_effects<P, N>(pages, stride, total, sg.effects, cs.caps);
    let ks: OblList = check_contracts<P, N>(pages, stride, total, sg.contracts);
    let ps: ParamRep = check_params<P, N>(pages, stride, total, sg.params, st.rectab, st.enumtab, st.nominals);
    let dup5: OblList = obl_only_kind<P, N>(pages, stride, total, ps.obls, 5);
    let o0: OblList = append_obls<P, N>(pages, stride, total, gs, cs.obls);
    let o1: OblList = append_obls<P, N>(pages, stride, total, o0, es.obls);
    let o2: OblList = append_obls<P, N>(pages, stride, total, o1, ks);
    return append_obls<P, N>(pages, stride, total, o2, dup5);
}
// Higher-kinded generic parameters are rejected at the definition site
// (Stage-0 MNE229), spanning the parameter from its name to its bound end.
record GenericBoundWalk { rest: GenericParamList, acc: OblList }
fn check_generic_bound_obls<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: GenericParamList) -> (result: OblList) {
    iterate i up_to 1024 carrying d: GenericBoundWalk = GenericBoundWalk { rest: list, acc: OblList.LNil } {
        next d = check_generic_bound_obls_step<P, N>(pages, stride, total, d);
    }
    return reverse_obls<P, N>(pages, stride, total, d.acc);
}
fn check_generic_bound_obls_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: GenericBoundWalk) -> (result: GenericBoundWalk) {
    return match st.rest {
        GNil => st,
        GCons { head: h, tail: t } => check_generic_bound_obl<P, N>(pages, stride, total, st, h, t)
    };
}
fn check_generic_bound_obl<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: GenericBoundWalk, h: GenericParam, t: GenericParamList) -> (result: GenericBoundWalk) {
    if generic_bound_kind<P, N>(pages, stride, total, h) == 2 {
        return GenericBoundWalk { rest: t, acc: OblList.LCons { head: Obligation { kind: 73, start: h.name_start, end: h.bound_end, status: 1 }, tail: st.acc } };
    }
    return GenericBoundWalk { rest: t, acc: st.acc };
}
record OblKindKeep { rest: OblList, acc: OblList, want: u64 }
fn obl_only_kind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, obls: OblList, want: u64) -> (result: OblList) {
    iterate i up_to 1024 carrying d: OblKindKeep = OblKindKeep { rest: obls, acc: OblList.LNil, want: want } {
        next d = obl_kind_step(d);
    }
    return reverse_obls<P, N>(pages, stride, total, d.acc);
}
fn obl_kind_step(st: OblKindKeep) -> (result: OblKindKeep) {
    return match st.rest {
        LNil => st,
        LCons { head: h, tail: t } => obl_kind_cons(st, h, t)
    };
}
fn obl_kind_cons(st: OblKindKeep, h: Obligation, t: OblList) -> (result: OblKindKeep) {
    if h.kind == st.want { return OblKindKeep { rest: t, acc: OblList.LCons { head: h, tail: st.acc }, want: st.want }; }
    return OblKindKeep { rest: t, acc: st.acc, want: st.want };
}
record FailScan { rest: OblList, found: bool }
fn obl_has_fail<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, obls: OblList) -> (result: bool) {
    iterate i up_to 1024 carrying d: FailScan = FailScan { rest: obls, found: false } {
        next d = obl_fail_step(d);
    }
    return d.found;
}
fn obl_fail_step(st: FailScan) -> (result: FailScan) {
    if st.found { return st; }
    return match st.rest {
        LNil => st,
        LCons { head: h, tail: t } => obl_fail_cons(st, h, t)
    };
}
fn obl_fail_cons(st: FailScan, h: Obligation, t: OblList) -> (result: FailScan) {
    if h.status == 1 { return FailScan { rest: OblList.LNil, found: true }; }
    return FailScan { rest: t, found: false };
}
record UnitProve { ok: bool, err_start: u64, err_end: u64, unit: Unit, obls: OblList, tops: TopsList, fn_count: u64 }
fn prove_unit<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: UnitProve) {
    let u: Unit = parse_unit<P, N>(pages, stride, total);
    return prove_parsed_unit<P, N>(pages, stride, total, u, SigTab.HNil);
}
record SigMerge { rest: SigTab, acc: SigTab }
fn merge_sig_tables<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, local: SigTab, imported: SigTab) -> (result: SigTab) {
    iterate i up_to 1024 carrying st: SigMerge = SigMerge { rest: local, acc: imported } {
        next st = merge_sig_tables_step(st);
    }
    return st.acc;
}
fn merge_sig_tables_step(st: SigMerge) -> (result: SigMerge) {
    return match st.rest {
        HNil => st,
        HCons { head: sig, tail: rest } => SigMerge { rest: rest, acc: SigTab.HCons { head: sig, tail: st.acc } }
    };
}
fn prove_parsed_unit<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, u: Unit, imported: SigTab) -> (result: UnitProve) {
    return prove_parsed_unit_with_nominals<P, N>(pages, stride, total, u, imported, NominalTypeIdentityList.NINil);
}
fn prove_parsed_unit_with_nominals<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, u: Unit, imported: SigTab, nominals: NominalTypeIdentityList) -> (result: UnitProve) {
    if !(u.ok) { return UnitProve { ok: false, err_start: u.err_start, err_end: u.err_end, unit: u, obls: OblList.LNil, tops: TopsList.TLNil, fn_count: 0 }; }
    let names: NameList = collect_fn_names<P, N>(pages, stride, total, u.fns);
    let dup: DupReport = duplicate_fn_names<P, N>(pages, stride, total, names);
    if dup.found {
        let obl: OblList = OblList.LCons { head: Obligation { kind: 37, start: dup.start, end: dup.end, status: 1 }, tail: OblList.LNil };
        return UnitProve { ok: false, err_start: dup.start, err_end: dup.end, unit: u, obls: obl, tops: TopsList.TLNil, fn_count: 0 };
    }
    let sigs: SigTabRep = collect_sigtab<P, N>(pages, stride, total, u.fns, u.records, u.enums, nominals);
    let local_sigs: SigTab = bind_local_callable_identities<P, N>(pages, stride, total, u.header, sigs.tab);
    let all_sigs: SigTab = merge_sig_tables<P, N>(pages, stride, total, local_sigs, imported);
    let done: BodyWalk = prove_bodies<P, N>(pages, stride, total, BodyWalk { rest: u.fns, tab: all_sigs, rectab: u.records, enumtab: u.enums, nominals: nominals, total: total, obls: sigs.obls, tops: TopsList.TLNil, ok: true, n: 0 });
    let ok: bool = close_and(done.ok, !(obl_has_fail<P, N>(pages, stride, total, done.obls)));
    let err: ExprSpan = first_fail_span<P, N>(pages, stride, total, done.obls);
    return UnitProve { ok: ok, err_start: select(ok, 0, err.start), err_end: select(ok, 0, err.end), unit: u, obls: done.obls, tops: done.tops, fn_count: done.n };
}
record FailSpanScan { rest: OblList, start: u64, end: u64, found: bool }
fn first_fail_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, obls: OblList) -> (result: ExprSpan) {
    iterate i up_to 1024 carrying d: FailSpanScan = FailSpanScan { rest: obls, start: 0, end: 0, found: false } {
        next d = first_fail_span_step(d);
    }
    return ExprSpan { start: d.start, end: d.end };
}
fn first_fail_span_step(st: FailSpanScan) -> (result: FailSpanScan) {
    if st.found { return st; }
    return match st.rest {
        LNil => FailSpanScan { rest: OblList.LNil, start: st.start, end: st.end, found: true },
        LCons { head: obl, tail: rest } => first_fail_span_cons(st, obl, rest)
    };
}
fn first_fail_span_cons(st: FailSpanScan, obl: Obligation, rest: OblList) -> (result: FailSpanScan) {
    if obl.status == 1 { return FailSpanScan { rest: OblList.LNil, start: obl.start, end: obl.end, found: true }; }
    return FailSpanScan { rest: rest, start: st.start, end: st.end, found: false };
}
// Field type validity by declaration context (0 value, 1 record, 2 enum).
// Value positions accept scalars, declared nominals, and sequences with
// valid elements; record fields the same; enum payloads reject sequences
// outright. Qualified spellings fail with the context family.
fn check_field_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, kind: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList, ctx: u64, nominals: NominalTypeIdentityList) -> (result: OblList) {
    if kind == 1 || kind == 2 || kind == 3 || kind == 4 { return OblList.LNil; }
    if kind == 5 {
        let imported: NominalLookup = nominal_identity_at<P, N>(pages, stride, total, nominals, start, end);
        if imported.found { return OblList.LNil; }
        return check_named_field_type<P, N>(pages, stride, total, start, end, rectab, enumtab, ctx);
    }
    if kind == 6 {
        let found: NominalLookup = nominal_identity_at<P, N>(pages, stride, total, nominals, start, end);
        if found.found { return OblList.LNil; }
        return ctx_field_obl(kind_ctx_qualified(ctx), start, end);
    }
    if kind == 7 || kind == 8 { return check_seq_field_type<P, N>(pages, stride, total, start, end, rectab, enumtab, ctx, nominals); }
    return ctx_field_obl(kind_ctx_other(ctx), start, end);
}
fn kind_ctx_qualified(ctx: u64) -> (result: u64) {
    if ctx == 1 { return 29; }
    if ctx == 2 { return 30; }
    return 31;
}
fn kind_ctx_other(ctx: u64) -> (result: u64) {
    if ctx == 1 { return 29; }
    if ctx == 2 { return 30; }
    return 19;
}
fn ctx_field_obl(kind: u64, start: u64, end: u64) -> (result: OblList) {
    return OblList.LCons { head: Obligation { kind: kind, start: start, end: end, status: 1 }, tail: OblList.LNil };
}
fn check_named_field_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList, ctx: u64) -> (result: OblList) {
    let sc: SemType = scalar_sem<P, N>(pages, stride, total, start, end);
    return match sc {
        TNamed { start: n, end: m } => check_declared_field_type<P, N>(pages, stride, total, n, m, rectab, enumtab, ctx),
        TBool => OblList.LNil,
        TByte => OblList.LNil,
        TInt { width: w, signed: g } => OblList.LNil,
        TSeq => OblList.LNil,
        TSeqExact { element: element, length: length, length_valid: valid } => OblList.LNil,
        TPoison => OblList.LNil
    };
}
fn check_declared_field_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList, ctx: u64) -> (result: OblList) {
    if record_declared<P, N>(pages, stride, total, rectab, start, end) { return OblList.LNil; }
    if enum_declared<P, N>(pages, stride, total, enumtab, start, end) { return OblList.LNil; }
    return ctx_field_obl(kind_ctx_other(ctx), start, end);
}
fn check_seq_field_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, rectab: RecordList, enumtab: EnumList, ctx: u64, nominals: NominalTypeIdentityList) -> (result: OblList) {
    if ctx == 2 { return ctx_field_obl(30, start, end); }
    let inner: TyRes = resolve_seq_type<P, N>(pages, stride, total, 7, start, end, rectab, enumtab, nominals);
    if inner.ok { return OblList.LNil; }
    return ctx_field_obl(kind_ctx_other(ctx), start, end);
}
record RecCheckState { rest: RecordList, obls: OblList }
fn check_records<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, recs: RecordList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: OblList) {
    iterate i up_to 1024 carrying d: RecCheckState = RecCheckState { rest: recs, obls: OblList.LNil } {
        next d = check_records_step<P, N>(pages, stride, total, d, rectab, enumtab, nominals);
    }
    return reverse_obls<P, N>(pages, stride, total, d.obls);
}
fn check_records_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecCheckState, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: RecCheckState) {
    return match st.rest {
        RNil => st,
        RCons { head: h, tail: t } => check_one_record<P, N>(pages, stride, total, st, h, t, rectab, enumtab, nominals)
    };
}
fn check_one_record<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecCheckState, h: RecordDecl, t: RecordList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: RecCheckState) {
    let obls: OblList = check_record_fields<P, N>(pages, stride, total, h.fields, rectab, enumtab, nominals);
    return RecCheckState { rest: t, obls: append_obls<P, N>(pages, stride, total, st.obls, obls) };
}
record RecFieldState { rest: FieldList, seen: NameList, obls: OblList }
fn check_record_fields<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: OblList) {
    iterate i up_to 1024 carrying d: RecFieldState = RecFieldState { rest: fields, seen: NameList.NNil, obls: OblList.LNil } {
        next d = check_record_fields_step<P, N>(pages, stride, total, d, rectab, enumtab, nominals);
    }
    return reverse_obls<P, N>(pages, stride, total, d.obls);
}
fn check_record_fields_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecFieldState, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: RecFieldState) {
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => check_one_record_field<P, N>(pages, stride, total, st, h, t, rectab, enumtab, nominals)
    };
}
fn check_one_record_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecFieldState, h: Field, t: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: RecFieldState) {
    let tob: OblList = check_field_type<P, N>(pages, stride, total, h.type_kind, h.type_start, h.type_end, rectab, enumtab, 1, nominals);
    if name_known<P, N>(pages, stride, total, st.seen, h.name_start, h.name_end) {
        let dob: Obligation = Obligation { kind: 33, start: h.name_start, end: h.name_end, status: 1 };
        return RecFieldState { rest: t, seen: st.seen, obls: OblList.LCons { head: dob, tail: append_obls<P, N>(pages, stride, total, tob, st.obls) } };
    }
    let seen: NameList = NameList.NCons { head: NameSpan { start: h.name_start, end: h.name_end }, tail: st.seen };
    return RecFieldState { rest: t, seen: seen, obls: append_obls<P, N>(pages, stride, total, tob, st.obls) };
}
record EnumCheckState { rest: EnumList, obls: OblList }
fn check_enums<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, enums: EnumList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: OblList) {
    iterate i up_to 1024 carrying d: EnumCheckState = EnumCheckState { rest: enums, obls: OblList.LNil } {
        next d = check_enums_step<P, N>(pages, stride, total, d, rectab, enumtab, nominals);
    }
    return reverse_obls<P, N>(pages, stride, total, d.obls);
}
fn check_enums_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: EnumCheckState, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: EnumCheckState) {
    return match st.rest {
        GNil => st,
        GCons { head: h, tail: t } => check_one_enum<P, N>(pages, stride, total, st, h, t, rectab, enumtab, nominals)
    };
}
fn check_one_enum<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: EnumCheckState, h: EnumDecl, t: EnumList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: EnumCheckState) {
    let obls: OblList = check_variants<P, N>(pages, stride, total, h.variants, rectab, enumtab, nominals);
    return EnumCheckState { rest: t, obls: append_obls<P, N>(pages, stride, total, st.obls, obls) };
}
record VariantState { rest: VariantList, seen: NameList, obls: OblList }
fn check_variants<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, variants: VariantList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: OblList) {
    iterate i up_to 1024 carrying d: VariantState = VariantState { rest: variants, seen: NameList.NNil, obls: OblList.LNil } {
        next d = check_variants_step<P, N>(pages, stride, total, d, rectab, enumtab, nominals);
    }
    return reverse_obls<P, N>(pages, stride, total, d.obls);
}
fn check_variants_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: VariantState, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: VariantState) {
    return match st.rest {
        VNil => st,
        VCons { head: h, tail: t } => check_one_variant<P, N>(pages, stride, total, st, h, t, rectab, enumtab, nominals)
    };
}
fn check_one_variant<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: VariantState, h: Variant, t: VariantList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: VariantState) {
    let pobls: OblList = check_payload_fields<P, N>(pages, stride, total, h.fields, rectab, enumtab, nominals);
    if name_known<P, N>(pages, stride, total, st.seen, h.name_start, h.name_end) {
        let dob: Obligation = Obligation { kind: 34, start: h.name_start, end: h.name_end, status: 1 };
        return VariantState { rest: t, seen: st.seen, obls: OblList.LCons { head: dob, tail: append_obls<P, N>(pages, stride, total, pobls, st.obls) } };
    }
    let seen: NameList = NameList.NCons { head: NameSpan { start: h.name_start, end: h.name_end }, tail: st.seen };
    return VariantState { rest: t, seen: seen, obls: append_obls<P, N>(pages, stride, total, pobls, st.obls) };
}
fn check_payload_fields<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: OblList) {
    iterate i up_to 1024 carrying d: RecFieldState = RecFieldState { rest: fields, seen: NameList.NNil, obls: OblList.LNil } {
        next d = check_payload_fields_step<P, N>(pages, stride, total, d, rectab, enumtab, nominals);
    }
    return reverse_obls<P, N>(pages, stride, total, d.obls);
}
fn check_payload_fields_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecFieldState, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: RecFieldState) {
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => check_one_payload_field<P, N>(pages, stride, total, st, h, t, rectab, enumtab, nominals)
    };
}
fn check_one_payload_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecFieldState, h: Field, t: FieldList, rectab: RecordList, enumtab: EnumList, nominals: NominalTypeIdentityList) -> (result: RecFieldState) {
    let tob: OblList = check_field_type<P, N>(pages, stride, total, h.type_kind, h.type_start, h.type_end, rectab, enumtab, 2, nominals);
    if name_known<P, N>(pages, stride, total, st.seen, h.name_start, h.name_end) {
        let dob: Obligation = Obligation { kind: 33, start: h.name_start, end: h.name_end, status: 1 };
        return RecFieldState { rest: t, seen: st.seen, obls: OblList.LCons { head: dob, tail: append_obls<P, N>(pages, stride, total, tob, st.obls) } };
    }
    let seen: NameList = NameList.NCons { head: NameSpan { start: h.name_start, end: h.name_end }, tail: st.seen };
    return RecFieldState { rest: t, seen: seen, obls: append_obls<P, N>(pages, stride, total, tob, st.obls) };
}
