mncs 0.18;
module mncs.compiler.decl.v1;
use mncs.compiler.source.v1 as source;
use mncs.compiler.lexer.v1 as lexer;
use mncs.compiler.segment.v1 as segment;
use mncs.compiler.parser.v1 as parser;

// Bounded declaration-scale syntax facts over one exact source byte
// sequence. The caller chooses its capacity; every offset below is absolute.
// Project ingestion owns per-file provenance and supplies one source value
// per module, rather than imposing the early four-by-64-byte probe ABI.
//
// Representation rule: this module owns each declaration/expression tree
// type and its constructors/destructors. Byte, token, and compact record
// interfaces stay in their focused modules; consumers pass these recursive
// trees opaquely. Current Stage-0 supports linked finite payloads (CP-0014,
// CP-0016), so this placement is no longer an upstream workaround.
//
// Scope of the native grammar: the source module itself uses Profile 0.18,
// while each parsed unit carries its own version gate. It accepts `!`,
// signed integer atoms, exact sequence repeat literals, and scalar integer
// matches with an identifier subject and ordinary expression arm values from
// Profile 0.13 onward; integer patterns require one final `_` and are
// range/duplicate checked. Finite (enum-variant) matches and qualified enum
// construction (`Flag.Yes { set: s }`, bare `Flag.No`) are accepted at every
// profile, matching Stage-0; the first arm pattern selects the scalar or
// finite arm grammar. The reserved `next` token is accepted where current-profile field
// names are allowed. Record construction literals (`R { x: 1 }`,
// `R { ..base, x: 1 }`) open on a bare `Name {` exactly when the brace
// holds `..` or `field:`, mirroring the Stage-0 record-literal lookahead;
// any other `{` still closes the expression. Other header, declaration,
// statement, and expression forms remain bounded: function bodies with
// let/if-else/fail/terminal-return; names, integers, booleans, binary
// operators, direct calls, and projections. Bounded `iterate` statements
// (`up_to` literal and `over` traversal forms with an explicit trailing
// `next` transition) parse with Stage-0 agreement; checking a loop body
// belongs to a later semantic step.
// Deliberately deferred: boolean matches, nested
// match arm expressions,
// index/slice/cast, pure intrinsics
// (select/replace/vector/mask), nested type arguments (`f<G<H>>(x)`),
// sequence types nested deeper than two levels, and vec/mask
// types. Generic parameter lists, type-argument calls (qualified or
// direct), and two-level sequence types parse with Stage-0 agreement.
// The five compiler operations real family sources call
// (fs_entry_kind_at/size_at/mtime_at, structured_read/write) are parsed
// to OpCall nodes with parser-enforced arity and proven against their
// result/operand/authorization contract (CP-0019).
// Unsupported shapes fail with an explicit local error span; they are
// never silently accepted.
//
// Error policy: first failure wins. Every parse record carries ok plus the
// failing span. Nodes are valid only when ok is true; on failure records
// still carry a dummy node so callers can thread state without option
// types. Differential negative tests compare the first-error span against
// Stage-0, mirroring the header precedent.

// Type spelling classification. kind: 1 u64, 2 i64, 3 bool, 4 byte,
// 5 named, 6 qualified, 7 exact sequence, 8 viewed sequence, 9 other.
record TypeRef { kind: u64, start: u64, end: u64 }
record TypeParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, node: TypeRef, done: bool }

// Shared name:type pair shape for parameters, results, record fields, and
// enum payload fields. Source order is preserved (reversed during the
// fuel-loop accumulation, then restored).
record Field { name_start: u64, name_end: u64, type_start: u64, type_end: u64, type_kind: u64 }
enum FieldList { FNil, FCons { head: Field, tail: FieldList } }

// Generic parameter facts (`<N: Nat, T>` after a function name). The bound
// span covers the whole constraint text (`Type -> Type` for arrow bounds);
// `has_bound` distinguishes `<T>` from `<T: ...>`. Source order is
// preserved (reversed during accumulation, then restored).
record GenericParam { name_start: u64, name_end: u64, bound_start: u64, bound_end: u64, has_bound: bool }
enum GenericParamList { GNil, GCons { head: GenericParam, tail: GenericParamList } }
// Bound-kind facts for generic application checking: 0 Nat, 1 Type
// (unconstrained parameters behave as Type), 2 higher/other kinds the
// proof does not model. Kinds — never spans — cross unit boundaries in
// callee signatures, so project-level application checking stays sound.
enum GenericBoundList { KNil, KCons { head: u64, tail: GenericBoundList } }
record FieldsParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, list: FieldList, done: bool }

enum Stmt {
    Let { name_start: u64, name_end: u64, type_start: u64, type_end: u64, type_kind: u64, value: Expr, start: u64, end: u64 },
    If { cond: Expr, then_b: StmtList, else_b: StmtList, start: u64, end: u64 },
    Fail { mode_start: u64, mode_end: u64, start: u64, end: u64 },
    Return { value: Expr, start: u64, end: u64 },
    Iterate { name_start: u64, name_end: u64, over_source: Expr, has_over_source: bool, bound_start: u64, bound_end: u64, state_start: u64, state_end: u64, type_start: u64, type_end: u64, type_kind: u64, initial: Expr, body: StmtList, next_start: u64, next_end: u64, next_value: Expr, start: u64, end: u64 }
}
enum StmtList { SNil, SCons { head: Stmt, tail: StmtList } }
record StmtParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, node: Stmt }

record Clause { kind_start: u64, kind_end: u64, name_start: u64, name_end: u64 }
enum ClauseList { CNil, CCons { head: Clause, tail: ClauseList } }
record Effect { kind_start: u64, kind_end: u64, cap_start: u64, cap_end: u64 }
enum EffectList { XNil, XCons { head: Effect, tail: EffectList } }
record Cap { start: u64, end: u64 }
enum CapList { ANil, ACons { head: Cap, tail: CapList } }

record FnSig { name_start: u64, name_end: u64, generics: GenericParamList, params: FieldList, results: FieldList, contracts: ClauseList, effects: EffectList, capabilities: CapList }
record FnBody { body: StmtList, ret: Expr, has_ret: bool }
record FnDecl { ok: bool, err_start: u64, err_end: u64, sig: FnSig, body: FnBody, fn_start: u64, fn_end: u64, cursor: u64 }
enum FnList { DNil, DCons { head: FnDecl, tail: FnList } }

record UseDecl { ok: bool, err_start: u64, err_end: u64, module_start: u64, module_end: u64, alias_start: u64, alias_end: u64, has_alias: bool, cursor: u64 }
enum UseList { UNil, UCons { head: UseDecl, tail: UseList } }
record RecordDecl { ok: bool, err_start: u64, err_end: u64, name_start: u64, name_end: u64, fields: FieldList, decl_start: u64, decl_end: u64, cursor: u64 }
enum RecordList { RNil, RCons { head: RecordDecl, tail: RecordList } }
record Variant { name_start: u64, name_end: u64, fields: FieldList }
enum VariantList { VNil, VCons { head: Variant, tail: VariantList } }
record EnumDecl { ok: bool, err_start: u64, err_end: u64, name_start: u64, name_end: u64, variants: VariantList, decl_start: u64, decl_end: u64, cursor: u64 }
enum EnumList { GNil, GCons { head: EnumDecl, tail: EnumList } }

record Unit { ok: bool, err_start: u64, err_end: u64, header: parser.Header, uses: UseList, records: RecordList, enums: EnumList, fns: FnList, cursor: u64 }

enum Expr {
    Name { start: u64, end: u64 },
    Integer { start: u64, end: u64, value: u64, overflow: bool },
    Boolean { start: u64, end: u64, value: bool },
    UnaryNot { value: Expr, start: u64, end: u64 },
    Repeat { value: Expr, count_start: u64, count_end: u64, count_kind: u64, start: u64, end: u64 },
    ScalarMatch { subject: Expr, arms: ScalarMatchArmList, start: u64, end: u64 },
    Binary { op: u64, left: Expr, right: Expr, start: u64, end: u64 },
    Call { name_start: u64, name_end: u64, args: ExprList, targs: TypeArgList, start: u64, end: u64 },
    Project { base: Expr, field_start: u64, field_end: u64, start: u64, end: u64, path: bool },
    FiniteMatch { subject: Expr, arms: FiniteMatchArmList, start: u64, end: u64 },
    EnumConstruct { type_start: u64, type_end: u64, variant_start: u64, variant_end: u64, fields: ConstructFieldList, start: u64, end: u64 },
    OpCall { slot: u64, name_start: u64, name_end: u64, args: ExprList, start: u64, end: u64 },
    RecordConstruct { type_start: u64, type_end: u64, base: Expr, has_base: bool, fields: ConstructFieldList, start: u64, end: u64 }
}
record ScalarMatchArm { is_default: bool, negative: bool, value: u64, overflow: bool, pattern_start: u64, pattern_end: u64, result: Expr }
enum ScalarMatchArmList { MNil, MCons { head: ScalarMatchArm, tail: ScalarMatchArmList } }
// Finite (enum-variant) match arms. One arm names a variant of the matched
// enum; payload variants bind each payload field to a locally scoped name.
// `has_payload` distinguishes `No` from `No {}` so proof can apply the
// payload-shape rule exactly.
record PayloadBinding { field_start: u64, field_end: u64, name_start: u64, name_end: u64 }
enum PayloadBindingList { YNil, YCons { head: PayloadBinding, tail: PayloadBindingList } }
record FiniteMatchArm { variant_start: u64, variant_end: u64, has_payload: bool, bindings: PayloadBindingList, pattern_start: u64, pattern_end: u64, result: Expr }
enum FiniteMatchArmList { ANil, ACons { head: FiniteMatchArm, tail: FiniteMatchArmList } }
// Enum construction field values: `Flag.Yes { set: <expr> }`.
record ConstructField { field_start: u64, field_end: u64, value: Expr }
enum ConstructFieldList { CNil, CCons { head: ConstructField, tail: ConstructFieldList } }
record ScalarMatchArmRev { rest: ScalarMatchArmList, acc: ScalarMatchArmList }
record ScalarMatchResultScan { rest: ScalarMatchArmList, acc: ExprList }
enum ExprList { ENil, ECons { head: Expr, tail: ExprList } }
record ExprParse { cursor: u64, ok: bool, err_start: u64, err_end: u64, node: Expr, start: u64, end: u64 }

// Type-argument facts (`f<N>`, `a.b<P, N>`): the callee-side generic
// argument list. kind reuses the TypeRef classification (1-9) for type
// spellings; kind 10 is an integer literal argument. Only the spans are
// retained; elaboration of generic application is downstream work.
record TypeArg { start: u64, end: u64, kind: u64 }
enum TypeArgList { TNil, TCons { head: TypeArg, tail: TypeArgList } }

// Qualified call sites are exported as parsed facts for the native project
// resolver. Their spans remain relative to the declaring source unit.
record CallSite { start: u64, end: u64 }
enum CallSiteList { CNil, CCons { head: CallSite, tail: CallSiteList } }
record CallSiteRev { rest: CallSiteList, acc: CallSiteList }
record CallWalk { fns: FnList, stmts: StmtList, exprs: ExprList, calls: CallSiteList }

fn call_site_list_empty(calls: CallSiteList) -> (result: bool) {
    return match calls { CNil => true, CCons { head: head, tail: tail } => false };
}
fn call_walk_done(st: CallWalk) -> (result: bool) {
    return declared_fn_list_empty(st.fns) && stmt_list_empty(st.stmts) && expr_list_empty(st.exprs);
}
fn collect_call_sites<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fns: FnList) -> (result: CallSiteList) {
    iterate i up_to 1024 carrying st: CallWalk = CallWalk { fns: fns, stmts: StmtList.SNil, exprs: ExprList.ENil, calls: CallSiteList.CNil } {
        if call_walk_done(st) { return reverse_call_sites<P, N>(pages, stride, total, st.calls); }
        next st = collect_call_step<P, N>(pages, stride, total, st);
    }
    return reverse_call_sites<P, N>(pages, stride, total, st.calls);
}
fn reverse_call_sites<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, calls: CallSiteList) -> (result: CallSiteList) {
    iterate i up_to 1024 carrying rev: CallSiteRev = CallSiteRev { rest: calls, acc: CallSiteList.CNil } {
        if call_site_list_empty(rev.rest) { return rev.acc; }
        next rev = collect_call_reverse(rev);
    }
    return rev.acc;
}
fn collect_call_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CallWalk) -> (result: CallWalk) {
    return match st.exprs {
        ECons { head: e, tail: rest } => collect_call_expr<P, N>(pages, stride, total, st, e, rest),
        ENil => collect_call_without_expr<P, N>(pages, stride, total, st)
    };
}
fn collect_call_without_expr<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CallWalk) -> (result: CallWalk) {
    return match st.stmts {
        SCons { head: stmt, tail: rest } => collect_call_stmt<P, N>(pages, stride, total, st, stmt, rest),
        SNil => collect_call_next_fn(st)
    };
}
fn collect_call_next_fn(st: CallWalk) -> (result: CallWalk) {
    return match st.fns {
        DNil => st,
        DCons { head: fn_decl, tail: rest } => CallWalk {
            fns: rest,
            stmts: fn_decl.body.body,
            exprs: ExprList.ECons { head: fn_decl.body.ret, tail: ExprList.ENil },
            calls: st.calls
        }
    };
}
fn collect_call_stmt<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CallWalk, stmt: Stmt, rest: StmtList) -> (result: CallWalk) {
    return match stmt {
        Let { name_start: a, name_end: b, type_start: c, type_end: d, type_kind: k, value: value, start: s, end: e } => CallWalk { ..st, stmts: rest, exprs: ExprList.ECons { head: value, tail: st.exprs } },
        If { cond: cond, then_b: then_body, else_b: else_body, start: s, end: e } => CallWalk { ..st, stmts: append_stmts<P, N>(pages, stride, total, then_body, append_stmts<P, N>(pages, stride, total, else_body, rest)), exprs: ExprList.ECons { head: cond, tail: st.exprs } },
        Fail { mode_start: a, mode_end: b, start: s, end: e } => CallWalk { ..st, stmts: rest },
        Return { value: value, start: s, end: e } => CallWalk { ..st, stmts: rest, exprs: ExprList.ECons { head: value, tail: st.exprs } },
        Iterate { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, body: b, next_start: xs, next_end: xe, next_value: nv, start: s, end: e } => CallWalk { ..st, stmts: append_stmts<P, N>(pages, stride, total, b, rest), exprs: iterate_call_exprs(o, ho, init, nv, st.exprs) }
    };
}
// Iterate call collection in elaboration order: traversal source, initial
// state, then the next-state value. Body statements queue separately.
fn iterate_call_exprs(over_source: Expr, has_over_source: bool, initial: Expr, next_value: Expr, tail: ExprList) -> (result: ExprList) {
    let with_next: ExprList = ExprList.ECons { head: next_value, tail: tail };
    let with_init: ExprList = ExprList.ECons { head: initial, tail: with_next };
    if has_over_source { return ExprList.ECons { head: over_source, tail: with_init }; }
    return with_init;
}
fn collect_call_expr<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CallWalk, expr: Expr, rest: ExprList) -> (result: CallWalk) {
    return match expr {
        Name { start: s, end: e } => CallWalk { ..st, exprs: rest },
        Integer { start: s, end: e, value: v, overflow: o } => CallWalk { ..st, exprs: rest },
        Boolean { start: s, end: e, value: v } => CallWalk { ..st, exprs: rest },
        UnaryNot { value: value, start: s, end: e } => CallWalk { ..st, exprs: ExprList.ECons { head: value, tail: rest } },
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => CallWalk { ..st, exprs: ExprList.ECons { head: value, tail: rest } },
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => CallWalk { ..st, exprs: scalar_match_children<P, N>(pages, stride, total, subject, arms, rest) },
        Binary { op: op, left: left, right: right, start: s, end: e } => CallWalk { ..st, exprs: ExprList.ECons { head: left, tail: ExprList.ECons { head: right, tail: rest } } },
        Call { name_start: s, name_end: e, args: args, targs: tg, start: t, end: n } => CallWalk { ..st, exprs: append_exprs<P, N>(pages, stride, total, args, rest), calls: CallSiteList.CCons { head: CallSite { start: s, end: e }, tail: st.calls } },
        Project { base: base, field_start: fs, field_end: fe, start: s, end: e, path: p } => CallWalk { ..st, exprs: ExprList.ECons { head: base, tail: rest } },
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => CallWalk { ..st, exprs: finite_match_children<P, N>(pages, stride, total, subject, arms, rest) },
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => CallWalk { ..st, exprs: construct_children<P, N>(pages, stride, total, f, rest) },
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => CallWalk { ..st, exprs: record_children<P, N>(pages, stride, total, b, hb, f, rest) },
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => CallWalk { ..st, exprs: append_exprs<P, N>(pages, stride, total, a, rest) }
    };
}
fn collect_call_reverse(st: CallSiteRev) -> (result: CallSiteRev) {
    return match st.rest {
        CNil => st,
        CCons { head: call, tail: rest } => CallSiteRev { rest: rest, acc: CallSiteList.CCons { head: call, tail: st.acc } }
    };
}

// Profile 0.13 introduced prefix negation. The token is explicit so older
// profiles can keep their historical rejection while current units use it.

// Operator stack element. Real operators carry the token kind; markers use
// kind 1000 (parenthesized group) and 1001 (call with callee spans, the
// type-argument facts, and the arguments collected so far,
// innermost-first). Kind 1004 is an enum
// construction under construction: the EnumConstruct operand sits below the
// current field value, argc is the phase (0 expect field name or `}`, 1
// expect field value), and name_start/name_end hold the pending field span.
// Fields accumulate innermost-first into the node's field list, exactly like
// call arguments, so nested construction needs no parser recursion.
// Kind 1005 is a record construction under construction with the same
// field phases over a RecordConstruct operand. Kind 1006 marks a `..base`
// operand in progress: it sits above the 1005 frame while the base
// expression parses inline, then resolves into the node's base on `,` or
// `}`. The base participates in the same operator machine, so binary
// operators inside it reduce through the existing comma/close paths.
record Op { kind: u64, argc: u64, name_start: u64, name_end: u64, args: ExprList, targs: TypeArgList }
enum OpList { ONil, OCons { head: Op, tail: OpList } }

// Shunting-yard state. expect_operand distinguishes a leading/continued
// operand position from an operator/delimiter position so lexical failures
// and EOF land on the same spans Stage-0 reports.
record ExprState { ok: bool, err_start: u64, err_end: u64, cursor: u64, operands: ExprList, operators: OpList, depth: u64, done: bool, expect_operand: bool, profile_013: bool, allow_construct: bool }
record MatchScan { ok: bool, done: bool, err_start: u64, err_end: u64, cursor: u64, start: u64, end: u64, profile_013: bool, arms: ScalarMatchArmList }
record MatchPattern { ok: bool, is_default: bool, negative: bool, value: u64, overflow: bool, start: u64, end: u64, cursor: u64 }

fn expr_start(node: Expr) -> (result: u64) {
    return match node {
        Name { start: s, end: e } => s,
        Integer { start: s, end: e, value: v, overflow: o } => s,
        Boolean { start: s, end: e, value: v } => s,
        UnaryNot { value: v, start: s, end: e } => s,
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => s,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => s,
        Binary { op: o, left: l, right: r, start: s, end: e } => s,
        Call { name_start: s, name_end: e, args: a, targs: tg, start: t, end: n } => t,
        Project { base: b, field_start: f, field_end: g, start: s, end: e, path: p } => s,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => s,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => s,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => s,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => s
    };
}
fn expr_end(node: Expr) -> (result: u64) {
    return match node {
        Name { start: s, end: e } => e,
        Integer { start: s, end: e, value: v, overflow: o } => e,
        Boolean { start: s, end: e, value: v } => e,
        UnaryNot { value: v, start: s, end: e } => e,
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => e,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => e,
        Binary { op: o, left: l, right: r, start: s, end: e } => e,
        Call { name_start: s, name_end: e, args: a, targs: tg, start: t, end: n } => n,
        Project { base: b, field_start: f, field_end: g, start: s, end: e, path: p } => e,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => e,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: f, start: s, end: e } => e,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: f, start: s, end: e } => e,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => e
    };
}

// Stage-0 binary_operator precedence, keyed by our token kind. 0 means the
// token never continues a binary expression. Scalar `match` checks the
// table shape at elaboration (MNE140): a new operator kind without a row
// fails the build instead of silently parsing at precedence 0.
fn prec(kind: u64) -> (result: u64) {
    return match kind {
        83 => 1,
        82 => 2,
        56 => 3,
        57 => 4,
        55 => 5,
        84 => 6,
        85 => 6,
        58 => 7,
        86 => 7,
        59 => 7,
        87 => 7,
        88 => 8,
        89 => 8,
        50 => 9,
        51 => 9,
        91 => 9,
        92 => 9,
        94 => 9,
        95 => 9,
        52 => 10,
        93 => 10,
        96 => 10,
        53 => 10,
        54 => 10,
        _ => 0
    };
}

fn is_operand_start(kind: u64) -> (result: bool) {
    return match kind {
        5 => true,
        4 => true,
        25 => true,
        38 => true,
        39 => true,
        _ => false
    };
}

// One directed action per fuel step: shift exactly one token, reduce exactly
// one operator, or stop/fail. Every action either consumes input, shrinks a
// stack, or terminates, so byte-count fuel always suffices.
fn parse_expr<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: ExprParse) {
    let seed: ExprState = ExprState { ok: true, err_start: 0, err_end: 0, cursor: cursor, operands: ExprList.ENil, operators: OpList.ONil, depth: 0, done: false, expect_operand: true, profile_013: profile_013, allow_construct: true };
    // CP-0003: conditional chunk chain. Total fuel is unchanged (2080),
    // but a finished state machine returns early instead of running the
    // remaining no-op tails: typical expressions leave after the first
    // 64-step chunk. `done` is terminal (expr_fail + close_or_reduce set
    // it; expr_step preserves it), so skipping is semantics-preserving.
    iterate i up_to 64 carrying d0: ExprState = seed {
        next d0 = expr_step<P, N>(pages, stride, total, d0);
    }
    if d0.done { return finish_expr<P, N>(pages, stride, total, d0); }
    iterate i up_to 960 carrying d: ExprState = d0 {
        next d = expr_step<P, N>(pages, stride, total, d);
    }
    if d.done { return finish_expr<P, N>(pages, stride, total, d); }
    iterate i up_to 1024 carrying h: ExprState = d {
        next h = expr_step<P, N>(pages, stride, total, h);
    }
    if h.done { return finish_expr<P, N>(pages, stride, total, h); }
    iterate i up_to 32 carrying fin: ExprState = h {
        next fin = expr_step<P, N>(pages, stride, total, fin);
    }
    return finish_expr<P, N>(pages, stride, total, fin);
}
// Match arm values run the same expression machine via the explicit
// nested-match driver below (scalar_match_value): a `match` in any
// operand position suspends onto the driver frame stack instead of
// recursing through prefix_match, keeping the parser call graph acyclic
// while accepting matches nested to arbitrary depth below arm values.
// If conditions and match subjects sit directly before a statement-level or
// match-body `{`, so a top-level `{` after a projection there closes the
// expression instead of starting enum construction. Nested (parenthesized or
// call-argument) construction still parses: only depth 0 honors the flag.
fn parse_expr_noconstruct<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: ExprParse) {
    let seed: ExprState = ExprState { ok: true, err_start: 0, err_end: 0, cursor: cursor, operands: ExprList.ENil, operators: OpList.ONil, depth: 0, done: false, expect_operand: true, profile_013: profile_013, allow_construct: false };
    // CP-0003: conditional chunk chain. Total fuel is unchanged (2080),
    // but a finished state machine returns early instead of running the
    // remaining no-op tails: typical expressions leave after the first
    // 64-step chunk. `done` is terminal (expr_fail + close_or_reduce set
    // it; expr_step preserves it), so skipping is semantics-preserving.
    iterate i up_to 64 carrying d0: ExprState = seed {
        next d0 = expr_step<P, N>(pages, stride, total, d0);
    }
    if d0.done { return finish_expr<P, N>(pages, stride, total, d0); }
    iterate i up_to 960 carrying d: ExprState = d0 {
        next d = expr_step<P, N>(pages, stride, total, d);
    }
    if d.done { return finish_expr<P, N>(pages, stride, total, d); }
    iterate i up_to 1024 carrying h: ExprState = d {
        next h = expr_step<P, N>(pages, stride, total, h);
    }
    if h.done { return finish_expr<P, N>(pages, stride, total, h); }
    iterate i up_to 32 carrying fin: ExprState = h {
        next fin = expr_step<P, N>(pages, stride, total, fin);
    }
    return finish_expr<P, N>(pages, stride, total, fin);
}
fn parse_expr_base_noconstruct<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: ExprParse) {
    let seed: ExprState = ExprState { ok: true, err_start: 0, err_end: 0, cursor: cursor, operands: ExprList.ENil, operators: OpList.ONil, depth: 0, done: false, expect_operand: true, profile_013: profile_013, allow_construct: false };
    iterate i up_to 64 carrying d0: ExprState = seed { next d0 = expr_step_base<P, N>(pages, stride, total, d0); }
    if d0.done { return finish_expr<P, N>(pages, stride, total, d0); }
    iterate i up_to 960 carrying d: ExprState = d0 { next d = expr_step_base<P, N>(pages, stride, total, d); }
    if d.done { return finish_expr<P, N>(pages, stride, total, d); }
    iterate i up_to 1024 carrying h: ExprState = d { next h = expr_step_base<P, N>(pages, stride, total, h); }
    if h.done { return finish_expr<P, N>(pages, stride, total, h); }
    iterate i up_to 32 carrying fin: ExprState = h { next fin = expr_step_base<P, N>(pages, stride, total, fin); }
    return finish_expr<P, N>(pages, stride, total, fin);
}

fn expr_fail(st: ExprState, start: u64, end: u64) -> (result: ExprState) {
    return ExprState { ok: false, err_start: start, err_end: end, cursor: st.cursor, operands: st.operands, operators: st.operators, depth: st.depth, done: true, expect_operand: st.expect_operand, profile_013: st.profile_013, allow_construct: st.allow_construct };
}

fn expr_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState) -> (result: ExprState) {
    if !(st.ok) || st.done { return st; }
    let tok: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    // The version-neutral scanner preserves the historical unknown-token
    // fact for bare `!`; a Profile 0.13+ declaration body reinterprets that
    // exact byte as prefix negation after its header established the gate.
    if st.expect_operand && st.profile_013 && tok.kind == 7 && tok.diagnostic == 2 && tok.end == tok.start + 1 && source.byte_at_global<P, N>(pages, stride, total, tok.start) == 33 { return prefix_not(st, tok); }
    if st.expect_operand && tok.diagnostic == 0 && tok.kind == 30 { return prefix_match<P, N>(pages, stride, total, st, tok); }
    return expr_step_base<P, N>(pages, stride, total, st);
}
fn expr_step_base<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState) -> (result: ExprState) {
    if !(st.ok) || st.done { return st; }
    let tok: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if tok.diagnostic != 0 {
        if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
        return close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end);
    }
    if tok.kind == 0 {
        if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
        return close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end);
    }
    if st.expect_operand && tok.kind == 69 && st.profile_013 {
        return prefix_repeat(st, tok);
    }
    if is_operand_start(tok.kind) {
        if !(st.expect_operand) { return close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end); }
        return shift_operand<P, N>(pages, stride, total, st, tok);
    }
    if tok.kind == 65 {
        if !(st.expect_operand) { return path_call<P, N>(pages, stride, total, st, tok); }
        return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: st.operands, operators: OpList.OCons { head: Op { kind: 1000, argc: 0, name_start: 0, name_end: 0, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: st.operators }, depth: st.depth + 1, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct };
    }
    if tok.kind == 66 {
        return close_paren<P, N>(pages, stride, total, st, tok);
    }
    if tok.kind == 64 && st.depth == 0 {
        return close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end);
    }
    if tok.kind == 64 {
        return comma_step<P, N>(pages, stride, total, st, tok);
    }
    if tok.kind == 63 && top_repeat_marker(st.operators) {
        return finish_repeat<P, N>(pages, stride, total, st, tok);
    }
    if tok.kind == 61 {
        return project_step<P, N>(pages, stride, total, st, tok);
    }
    if tok.kind == 62 {
        return colon_step<P, N>(pages, stride, total, st, tok);
    }
    if tok.kind == 90 && st.expect_operand {
        return dotdot_step<P, N>(pages, stride, total, st, tok);
    }
    if tok.kind == 68 {
        return close_brace<P, N>(pages, stride, total, st, tok);
    }
    if tok.kind == 67 && !(st.expect_operand) && (st.allow_construct || st.depth > 0) {
        return construct_step<P, N>(pages, stride, total, st, tok);
    }
    if st.expect_operand && tok.kind == 51 {
        if st.profile_013 { return shift_negative_integer<P, N>(pages, stride, total, st, tok); }
        return expr_fail(st, tok.start, tok.end);
    }
    if tok.kind == 58 && !(st.expect_operand) {
        return lt_or_type_args<P, N>(pages, stride, total, st, tok);
    }
    if prec(tok.kind) > 0 {
        return operator_step(st, tok);
    }
    return close_or_reduce<P, N>(pages, stride, total, st, tok.start, tok.end);
}

fn prefix_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, match_token: lexer.Token) -> (result: ExprState) {
    let subject: ExprParse = parse_expr_base_noconstruct<P, N>(pages, stride, total, match_token.end, st.profile_013);
    if !(subject.ok) { return expr_fail(st, subject.err_start, subject.err_end); }
    let open: lexer.Token = segment.significant_global<P, N>(pages, stride, total, subject.cursor);
    if open.diagnostic != 0 || open.kind != 67 { return expr_fail(st, open.start, open.end); }
    let first: lexer.Token = segment.significant_global<P, N>(pages, stride, total, open.end);
    if first.diagnostic != 0 { return expr_fail(st, first.start, first.end); }
    if finite_pattern_start<P, N>(pages, stride, total, first) { return prefix_finite_match<P, N>(pages, stride, total, st, match_token, subject.node, open); }
    if !(st.profile_013) { return expr_fail(st, first.start, first.end); }
    return prefix_scalar_match<P, N>(pages, stride, total, st, match_token, subject.node, open);
}
fn finite_pattern_start<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, token: lexer.Token) -> (result: bool) {
    if token.kind != 4 { return false; }
    return !(scalar_match_underscore<P, N>(pages, stride, total, token.start, token.end));
}
fn prefix_scalar_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, match_token: lexer.Token, subject: Expr, open: lexer.Token) -> (result: ExprState) {
    let seed: MatchScan = MatchScan { ok: true, done: false, err_start: 0, err_end: 0, cursor: open.end, start: match_token.start, end: open.end, profile_013: st.profile_013, arms: ScalarMatchArmList.MNil };
    iterate i up_to 1024 carrying d: MatchScan = seed {
        next d = scalar_match_arm_step<P, N>(pages, stride, total, d);
    }
    if !(d.ok) || !(d.done) { return expr_fail(st, d.err_start, d.err_end); }
    let arms: ScalarMatchArmList = reverse_scalar_match_arms<P, N>(pages, stride, total, d.arms);
    let node: Expr = Expr.ScalarMatch { subject: subject, arms: arms, start: match_token.start, end: match_close_end<P, N>(pages, stride, total, d.cursor) };
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: d.cursor, operands: ExprList.ECons { head: node, tail: st.operands }, operators: st.operators, depth: st.depth, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
// A match node's end extends past its closing brace exactly like Stage-0:
// a following `;`, `)`, or `,` is included; anything else ends the node at
// the next token's start (trivia end). Whole-match diagnostics (MNE140)
// and the oracle AST both use this convention.
fn match_close_end<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64) -> (result: u64) {
    let after: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if after.diagnostic != 0 { return cursor; }
    if after.kind == 63 || after.kind == 66 || after.kind == 64 { return after.end; }
    return after.start;
}
record FiniteMatchScan { ok: bool, done: bool, err_start: u64, err_end: u64, cursor: u64, start: u64, end: u64, profile_013: bool, arms: FiniteMatchArmList }
record FiniteMatchPattern { ok: bool, variant_start: u64, variant_end: u64, has_payload: bool, bindings: PayloadBindingList, start: u64, end: u64, cursor: u64 }
fn prefix_finite_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, match_token: lexer.Token, subject: Expr, open: lexer.Token) -> (result: ExprState) {
    let seed: FiniteMatchScan = FiniteMatchScan { ok: true, done: false, err_start: 0, err_end: 0, cursor: open.end, start: match_token.start, end: open.end, profile_013: st.profile_013, arms: FiniteMatchArmList.ANil };
    iterate i up_to 1024 carrying d: FiniteMatchScan = seed {
        next d = finite_match_arm_step<P, N>(pages, stride, total, d);
    }
    if !(d.ok) || !(d.done) { return expr_fail(st, d.err_start, d.err_end); }
    let arms: FiniteMatchArmList = reverse_finite_match_arms<P, N>(pages, stride, total, d.arms);
    let node: Expr = Expr.FiniteMatch { subject: subject, arms: arms, start: match_token.start, end: match_close_end<P, N>(pages, stride, total, d.cursor) };
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: d.cursor, operands: ExprList.ECons { head: node, tail: st.operands }, operators: st.operators, depth: st.depth, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
fn finite_match_arm_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FiniteMatchScan) -> (result: FiniteMatchScan) {
    if !(st.ok) || st.done { return st; }
    let pattern_token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if pattern_token.diagnostic != 0 { return FiniteMatchScan { ..st, ok: false, err_start: pattern_token.start, err_end: pattern_token.end }; }
    if pattern_token.kind == 68 { return FiniteMatchScan { ..st, done: true, cursor: pattern_token.end, end: pattern_token.end }; }
    let pattern: FiniteMatchPattern = finite_match_pattern<P, N>(pages, stride, total, pattern_token);
    if !(pattern.ok) { return FiniteMatchScan { ..st, ok: false, err_start: pattern.start, err_end: pattern.end }; }
    let arrow: lexer.Token = segment.significant_global<P, N>(pages, stride, total, pattern.cursor);
    if arrow.diagnostic != 0 || arrow.kind != 81 { return FiniteMatchScan { ..st, ok: false, err_start: arrow.start, err_end: arrow.end }; }
    let value: ExprParse = scalar_match_value<P, N>(pages, stride, total, arrow.end, st.profile_013);
    if !(value.ok) { return FiniteMatchScan { ..st, ok: false, err_start: value.err_start, err_end: value.err_end }; }
    let delimiter: lexer.Token = segment.significant_global<P, N>(pages, stride, total, value.cursor);
    if delimiter.diagnostic != 0 || (delimiter.kind != 64 && delimiter.kind != 68) { return FiniteMatchScan { ..st, ok: false, err_start: delimiter.start, err_end: delimiter.end }; }
    let arm: FiniteMatchArm = FiniteMatchArm { variant_start: pattern.variant_start, variant_end: pattern.variant_end, has_payload: pattern.has_payload, bindings: pattern.bindings, pattern_start: pattern.start, pattern_end: pattern.end, result: value.node };
    let next_cursor: u64 = select(delimiter.kind == 64, delimiter.end, value.cursor);
    return FiniteMatchScan { ..st, cursor: next_cursor, end: delimiter.start, arms: FiniteMatchArmList.ACons { head: arm, tail: st.arms } };
}
fn finite_match_pattern<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, token: lexer.Token) -> (result: FiniteMatchPattern) {
    // Any identifier parses as a variant spelling, including `_`: proof
    // reports unknown spellings as MNE138 exactly like Stage-0 instead of
    // failing the parse with no elaboration comparison.
    if token.kind != 4 { return FiniteMatchPattern { ok: false, variant_start: token.start, variant_end: token.end, has_payload: false, bindings: PayloadBindingList.YNil, start: token.start, end: token.end, cursor: token.end }; }
    let brace: lexer.Token = segment.significant_global<P, N>(pages, stride, total, token.end);
    if brace.diagnostic != 0 { return FiniteMatchPattern { ok: false, variant_start: token.start, variant_end: token.end, has_payload: false, bindings: PayloadBindingList.YNil, start: brace.start, end: brace.end, cursor: brace.end }; }
    if brace.kind != 67 { return FiniteMatchPattern { ok: true, variant_start: token.start, variant_end: token.end, has_payload: false, bindings: PayloadBindingList.YNil, start: token.start, end: token.end, cursor: token.end }; }
    return finite_match_payload<P, N>(pages, stride, total, token.start, token.end, brace.end);
}
fn finite_match_payload<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, vs: u64, ve: u64, cursor: u64) -> (result: FiniteMatchPattern) {
    let seed: PayloadScan = PayloadScan { ok: true, done: false, err_start: 0, err_end: 0, cursor: cursor, start: vs, end: ve, bindings: PayloadBindingList.YNil };
    iterate i up_to 1024 carrying d: PayloadScan = seed {
        next d = payload_binding_step<P, N>(pages, stride, total, d);
    }
    if !(d.ok) || !(d.done) { return FiniteMatchPattern { ok: false, variant_start: vs, variant_end: ve, has_payload: true, bindings: PayloadBindingList.YNil, start: d.err_start, end: d.err_end, cursor: d.cursor }; }
    let bindings: PayloadBindingList = reverse_payload_bindings<P, N>(pages, stride, total, d.bindings);
    return FiniteMatchPattern { ok: true, variant_start: vs, variant_end: ve, has_payload: true, bindings: bindings, start: vs, end: d.end, cursor: d.cursor };
}
record PayloadScan { ok: bool, done: bool, err_start: u64, err_end: u64, cursor: u64, start: u64, end: u64, bindings: PayloadBindingList }
fn payload_binding_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadScan) -> (result: PayloadScan) {
    if !(st.ok) || st.done { return st; }
    let field_token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if field_token.diagnostic != 0 { return PayloadScan { ..st, ok: false, err_start: field_token.start, err_end: field_token.end }; }
    if field_token.kind == 68 { return PayloadScan { ..st, done: true, cursor: field_token.end, end: field_token.end }; }
    if field_token.kind != 4 { return PayloadScan { ..st, ok: false, err_start: field_token.start, err_end: field_token.end }; }
    let colon: lexer.Token = segment.significant_global<P, N>(pages, stride, total, field_token.end);
    if colon.diagnostic != 0 || colon.kind != 62 { return PayloadScan { ..st, ok: false, err_start: colon.start, err_end: colon.end }; }
    let name_token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, colon.end);
    if name_token.diagnostic != 0 || name_token.kind != 4 { return PayloadScan { ..st, ok: false, err_start: name_token.start, err_end: name_token.end }; }
    let delimiter: lexer.Token = segment.significant_global<P, N>(pages, stride, total, name_token.end);
    if delimiter.diagnostic != 0 || (delimiter.kind != 64 && delimiter.kind != 68) { return PayloadScan { ..st, ok: false, err_start: delimiter.start, err_end: delimiter.end }; }
    let binding: PayloadBinding = PayloadBinding { field_start: field_token.start, field_end: field_token.end, name_start: name_token.start, name_end: name_token.end };
    let next_cursor: u64 = select(delimiter.kind == 64, delimiter.end, name_token.end);
    return PayloadScan { ..st, cursor: next_cursor, end: delimiter.start, bindings: PayloadBindingList.YCons { head: binding, tail: st.bindings } };
}
record PayloadBindingRev { rest: PayloadBindingList, acc: PayloadBindingList }
fn reverse_payload_bindings<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, bindings: PayloadBindingList) -> (result: PayloadBindingList) {
    iterate i up_to 1024 carrying d: PayloadBindingRev = PayloadBindingRev { rest: bindings, acc: PayloadBindingList.YNil } {
        if payload_bindings_empty(d.rest) { return d.acc; }
        next d = reverse_payload_bindings_step(d);
    }
    return d.acc;
}
fn reverse_payload_bindings_step(st: PayloadBindingRev) -> (result: PayloadBindingRev) {
    return match st.rest {
        YNil => st,
        YCons { head: h, tail: t } => PayloadBindingRev { rest: t, acc: PayloadBindingList.YCons { head: h, tail: st.acc } }
    };
}
fn payload_bindings_empty(list: PayloadBindingList) -> (result: bool) {
    return match list { YNil => true, YCons { head: head, tail: tail } => false };
}
record FiniteMatchArmRev { rest: FiniteMatchArmList, acc: FiniteMatchArmList }
fn reverse_finite_match_arms<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: FiniteMatchArmList) -> (result: FiniteMatchArmList) {
    iterate i up_to 1024 carrying d: FiniteMatchArmRev = FiniteMatchArmRev { rest: arms, acc: FiniteMatchArmList.ANil } {
        if finite_match_arms_empty(d.rest) { return d.acc; }
        next d = reverse_finite_match_arms_step(d);
    }
    return d.acc;
}
fn reverse_finite_match_arms_step(st: FiniteMatchArmRev) -> (result: FiniteMatchArmRev) {
    return match st.rest {
        ANil => st,
        ACons { head: h, tail: t } => FiniteMatchArmRev { rest: t, acc: FiniteMatchArmList.ACons { head: h, tail: st.acc } }
    };
}
fn finite_match_arms_empty(list: FiniteMatchArmList) -> (result: bool) {
    return match list { ANil => true, ACons { head: head, tail: tail } => false };
}
fn scalar_match_arm_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchScan) -> (result: MatchScan) {
    if !(st.ok) || st.done { return st; }
    let pattern_token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, st.cursor);
    if pattern_token.diagnostic != 0 { return MatchScan { ..st, ok: false, err_start: pattern_token.start, err_end: pattern_token.end }; }
    if pattern_token.kind == 68 { return MatchScan { ..st, done: true, cursor: pattern_token.end, end: pattern_token.end }; }
    let pattern: MatchPattern = scalar_match_pattern<P, N>(pages, stride, total, pattern_token);
    if !(pattern.ok) { return MatchScan { ..st, ok: false, err_start: pattern.start, err_end: pattern.end }; }
    let arrow: lexer.Token = segment.significant_global<P, N>(pages, stride, total, pattern.cursor);
    if arrow.diagnostic != 0 || arrow.kind != 81 { return MatchScan { ..st, ok: false, err_start: arrow.start, err_end: arrow.end }; }
    let value: ExprParse = scalar_match_value<P, N>(pages, stride, total, arrow.end, st.profile_013);
    if !(value.ok) { return MatchScan { ..st, ok: false, err_start: value.err_start, err_end: value.err_end }; }
    let delimiter: lexer.Token = segment.significant_global<P, N>(pages, stride, total, value.cursor);
    if delimiter.diagnostic != 0 || (delimiter.kind != 64 && delimiter.kind != 68) { return MatchScan { ..st, ok: false, err_start: delimiter.start, err_end: delimiter.end }; }
    let arm: ScalarMatchArm = ScalarMatchArm { is_default: pattern.is_default, negative: pattern.negative, value: pattern.value, overflow: pattern.overflow, pattern_start: pattern.start, pattern_end: pattern.end, result: value.node };
    let next_cursor: u64 = select(delimiter.kind == 64, delimiter.end, value.cursor);
    return MatchScan { ..st, cursor: next_cursor, end: delimiter.start, arms: ScalarMatchArmList.MCons { head: arm, tail: st.arms } };
}
fn scalar_match_pattern<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, token: lexer.Token) -> (result: MatchPattern) {
    if token.kind == 5 {
        let parsed: IntVal = int_value<P, N>(pages, stride, total, token.start, token.end);
        return MatchPattern { ok: true, is_default: false, negative: false, value: parsed.value, overflow: parsed.overflow, start: token.start, end: token.end, cursor: token.end };
    }
    if token.kind == 51 {
        let literal: lexer.Token = segment.significant_global<P, N>(pages, stride, total, token.end);
        if literal.diagnostic != 0 || literal.kind != 5 { return MatchPattern { ok: false, is_default: false, negative: false, value: 0, overflow: false, start: token.start, end: literal.end, cursor: literal.end }; }
        let parsed: IntVal = int_value<P, N>(pages, stride, total, literal.start, literal.end);
        return MatchPattern { ok: true, is_default: false, negative: true, value: parsed.value, overflow: parsed.overflow, start: token.start, end: literal.end, cursor: literal.end };
    }
    if token.kind == 4 && scalar_match_underscore<P, N>(pages, stride, total, token.start, token.end) {
        return MatchPattern { ok: true, is_default: true, negative: false, value: 0, overflow: false, start: token.start, end: token.end, cursor: token.end };
    }
    return MatchPattern { ok: false, is_default: false, negative: false, value: 0, overflow: false, start: token.start, end: token.end, cursor: token.end };
}
fn scalar_match_underscore<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: bool) {
    return end == start + 1 && segment.byte_at_global<P, N>(pages, stride, total, start) == 95;
}
fn scalar_match_value<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: ExprParse) {
    return parse_nest_expr_value<P, N>(pages, stride, total, cursor, profile_013);
}
// Nested matches in arm position (CP-0011): a match arm result may itself
// be a match, to arbitrary depth, in any scalar/finite combination, in any
// operand position (arm head, binary operand, call argument, parenthesized).
// The call graph stays acyclic: instead of recursive expression dispatch,
// one driver loop micro-steps arm-value expressions and arm scans alike.
// A nested `match` suspends the current expression or arm scan onto an
// explicit frame stack; closing the nested match resumes the parent with
// the nested node as the operand or arm value. Match entry mirrors
// prefix_match exactly (subject, `{`, first-arm kind selection, same
// error spans); expression micro-steps are expr_step_base exactly, so a
// match-free arm value parses identically to the former direct call.
// Fuel: every step consumes an input byte, shrinks the operator or frame
// stack, or terminates the top (match/arm entry always consumes the head
// it suspends on), so three input passes plus slack always suffice.
record FiniteNestParent { scan: FiniteMatchScan, subject: Expr, match_start: u64, variant_start: u64, variant_end: u64, has_payload: bool, bindings: PayloadBindingList, pattern_start: u64, pattern_end: u64 }
record ScalarNestParent { scan: MatchScan, subject: Expr, match_start: u64, is_default: bool, negative: bool, value: u64, overflow: bool, pattern_start: u64, pattern_end: u64 }
record NestExprParent { est: ExprState }
enum MatchNestStack { NSNil, NSFinite { head: FiniteNestParent, tail: MatchNestStack }, NSScalar { head: ScalarNestParent, tail: MatchNestStack }, NSExpr { head: NestExprParent, tail: MatchNestStack } }
enum MatchNestTop { FiniteTop { scan: FiniteMatchScan, subject: Expr, match_start: u64 }, ScalarTop { scan: MatchScan, subject: Expr, match_start: u64 }, ExprTop { est: ExprState } }
record MatchNestParse { top: MatchNestTop, stack: MatchNestStack, ok: bool, done: bool, err_start: u64, err_end: u64, node: Expr, node_ok: bool, cursor: u64 }
record MatchOpen { ok: bool, err_start: u64, err_end: u64, subject: Expr, open_end: u64, is_finite: bool }
fn match_open_nested<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, match_token: lexer.Token, profile_013: bool) -> (result: MatchOpen) {
    let subject: ExprParse = parse_expr_base_noconstruct<P, N>(pages, stride, total, match_token.end, profile_013);
    if !(subject.ok) { return MatchOpen { ok: false, err_start: subject.err_start, err_end: subject.err_end, subject: Expr.Name { start: 0, end: 0 }, open_end: match_token.end, is_finite: false }; }
    let open: lexer.Token = segment.significant_global<P, N>(pages, stride, total, subject.cursor);
    if open.diagnostic != 0 || open.kind != 67 { return MatchOpen { ok: false, err_start: open.start, err_end: open.end, subject: subject.node, open_end: subject.cursor, is_finite: false }; }
    let first: lexer.Token = segment.significant_global<P, N>(pages, stride, total, open.end);
    if first.diagnostic != 0 { return MatchOpen { ok: false, err_start: first.start, err_end: first.end, subject: subject.node, open_end: open.end, is_finite: false }; }
    if finite_pattern_start<P, N>(pages, stride, total, first) { return MatchOpen { ok: true, err_start: 0, err_end: 0, subject: subject.node, open_end: open.end, is_finite: true }; }
    if !(profile_013) { return MatchOpen { ok: false, err_start: first.start, err_end: first.end, subject: subject.node, open_end: open.end, is_finite: false }; }
    return MatchOpen { ok: true, err_start: 0, err_end: 0, subject: subject.node, open_end: open.end, is_finite: false };
}
fn nest_expr_seed(cursor: u64, profile_013: bool) -> (result: ExprState) {
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: cursor, operands: ExprList.ENil, operators: OpList.ONil, depth: 0, done: false, expect_operand: true, profile_013: profile_013, allow_construct: true };
}
fn parse_nest_expr_value<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cursor: u64, profile_013: bool) -> (result: ExprParse) {
    let seed: MatchNestParse = MatchNestParse { top: MatchNestTop.ExprTop { est: nest_expr_seed(cursor, profile_013) }, stack: MatchNestStack.NSNil, ok: true, done: false, err_start: 0, err_end: 0, node: Expr.Name { start: cursor, end: cursor }, node_ok: false, cursor: cursor };
    iterate i up_to 1024 carrying a: MatchNestParse = seed {
        next a = match_nest_step<P, N>(pages, stride, total, a);
    }
    iterate i up_to 1024 carrying b: MatchNestParse = a {
        next b = match_nest_step<P, N>(pages, stride, total, b);
    }
    iterate i up_to 1024 carrying c: MatchNestParse = b {
        next c = match_nest_step<P, N>(pages, stride, total, c);
    }
    iterate i up_to 32 carrying d: MatchNestParse = c {
        next d = match_nest_step<P, N>(pages, stride, total, d);
    }
    let bad: Expr = Expr.Name { start: d.cursor, end: d.cursor };
    if !(d.ok) { return ExprParse { cursor: d.cursor, ok: false, err_start: d.err_start, err_end: d.err_end, node: bad, start: d.cursor, end: d.cursor }; }
    if !(d.done) || !(d.node_ok) { return ExprParse { cursor: d.cursor, ok: false, err_start: d.cursor, err_end: d.cursor, node: bad, start: d.cursor, end: d.cursor }; }
    return ExprParse { cursor: d.cursor, ok: true, err_start: 0, err_end: 0, node: d.node, start: expr_start(d.node), end: expr_end(d.node) };
}
fn match_nest_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse) -> (result: MatchNestParse) {
    if !(st.ok) || st.done { return st; }
    return match st.top {
        FiniteTop { scan: scan, subject: subject, match_start: ms } => finite_nest_step<P, N>(pages, stride, total, st, scan, subject, ms),
        ScalarTop { scan: scan, subject: subject, match_start: ms } => scalar_nest_step<P, N>(pages, stride, total, st, scan, subject, ms),
        ExprTop { est: est } => expr_nest_step<P, N>(pages, stride, total, st, est)
    };
}
fn expr_nest_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse, est: ExprState) -> (result: MatchNestParse) {
    if !(est.ok) || est.done { return expr_nest_done<P, N>(pages, stride, total, st, est); }
    let tok: lexer.Token = segment.significant_global<P, N>(pages, stride, total, est.cursor);
    if est.expect_operand && tok.diagnostic == 0 && tok.kind == 30 { return expr_nest_push_match<P, N>(pages, stride, total, st, est, tok); }
    let advanced: ExprState = expr_step_base<P, N>(pages, stride, total, est);
    return MatchNestParse { ..st, top: MatchNestTop.ExprTop { est: advanced }, cursor: advanced.cursor };
}
fn expr_nest_done<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse, est: ExprState) -> (result: MatchNestParse) {
    let finished: ExprParse = finish_expr<P, N>(pages, stride, total, est);
    if !(finished.ok) { return MatchNestParse { ..st, ok: false, err_start: finished.err_start, err_end: finished.err_end }; }
    return match st.stack {
        NSNil => MatchNestParse { ..st, done: true, node: finished.node, node_ok: true, cursor: finished.cursor },
        NSFinite { head: parent, tail: rest } => finite_nest_pop_parent<P, N>(pages, stride, total, st, parent, rest, finished.node, finished.cursor),
        NSScalar { head: parent, tail: rest } => scalar_nest_pop_parent<P, N>(pages, stride, total, st, parent, rest, finished.node, finished.cursor),
        NSExpr { head: frame, tail: rest } => MatchNestParse { ..st, ok: false, err_start: finished.cursor, err_end: finished.cursor }
    };
}
fn expr_nest_push_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse, est: ExprState, match_token: lexer.Token) -> (result: MatchNestParse) {
    let open: MatchOpen = match_open_nested<P, N>(pages, stride, total, match_token, est.profile_013);
    if !(open.ok) { return MatchNestParse { ..st, ok: false, err_start: open.err_start, err_end: open.err_end }; }
    let stack: MatchNestStack = MatchNestStack.NSExpr { head: NestExprParent { est: est }, tail: st.stack };
    if open.is_finite {
        let nested: FiniteMatchScan = FiniteMatchScan { ok: true, done: false, err_start: 0, err_end: 0, cursor: open.open_end, start: match_token.start, end: open.open_end, profile_013: est.profile_013, arms: FiniteMatchArmList.ANil };
        return MatchNestParse { top: MatchNestTop.FiniteTop { scan: nested, subject: open.subject, match_start: match_token.start }, stack: stack, ok: true, done: false, err_start: 0, err_end: 0, node: st.node, node_ok: false, cursor: open.open_end };
    }
    let nested: MatchScan = MatchScan { ok: true, done: false, err_start: 0, err_end: 0, cursor: open.open_end, start: match_token.start, end: open.open_end, profile_013: est.profile_013, arms: ScalarMatchArmList.MNil };
    return MatchNestParse { top: MatchNestTop.ScalarTop { scan: nested, subject: open.subject, match_start: match_token.start }, stack: stack, ok: true, done: false, err_start: 0, err_end: 0, node: st.node, node_ok: false, cursor: open.open_end };
}
fn expr_nest_resume<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse, frame: NestExprParent, rest: MatchNestStack, node: Expr, cursor: u64) -> (result: MatchNestParse) {
    let est: ExprState = frame.est;
    let resumed: ExprState = ExprState { ok: true, err_start: 0, err_end: 0, cursor: cursor, operands: ExprList.ECons { head: node, tail: est.operands }, operators: est.operators, depth: est.depth, done: false, expect_operand: false, profile_013: est.profile_013, allow_construct: est.allow_construct };
    return MatchNestParse { top: MatchNestTop.ExprTop { est: resumed }, stack: rest, ok: true, done: false, err_start: 0, err_end: 0, node: st.node, node_ok: false, cursor: cursor };
}
fn finite_nest_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse, scan: FiniteMatchScan, subject: Expr, match_start: u64) -> (result: MatchNestParse) {
    if !(scan.ok) { return MatchNestParse { ..st, ok: false, err_start: scan.err_start, err_end: scan.err_end }; }
    let pattern_token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, scan.cursor);
    if pattern_token.diagnostic != 0 { return MatchNestParse { ..st, ok: false, err_start: pattern_token.start, err_end: pattern_token.end }; }
    if pattern_token.kind == 68 { return finite_nest_close<P, N>(pages, stride, total, st, scan, subject, match_start, pattern_token); }
    let pattern: FiniteMatchPattern = finite_match_pattern<P, N>(pages, stride, total, pattern_token);
    if !(pattern.ok) { return MatchNestParse { ..st, ok: false, err_start: pattern.start, err_end: pattern.end }; }
    let arrow: lexer.Token = segment.significant_global<P, N>(pages, stride, total, pattern.cursor);
    if arrow.diagnostic != 0 || arrow.kind != 81 { return MatchNestParse { ..st, ok: false, err_start: arrow.start, err_end: arrow.end }; }
    let parent: FiniteNestParent = FiniteNestParent { scan: scan, subject: subject, match_start: match_start, variant_start: pattern.variant_start, variant_end: pattern.variant_end, has_payload: pattern.has_payload, bindings: pattern.bindings, pattern_start: pattern.start, pattern_end: pattern.end };
    let stack: MatchNestStack = MatchNestStack.NSFinite { head: parent, tail: st.stack };
    return MatchNestParse { top: MatchNestTop.ExprTop { est: nest_expr_seed(arrow.end, scan.profile_013) }, stack: stack, ok: true, done: false, err_start: 0, err_end: 0, node: st.node, node_ok: false, cursor: arrow.end };
}
fn finite_nest_close<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse, scan: FiniteMatchScan, subject: Expr, match_start: u64, close: lexer.Token) -> (result: MatchNestParse) {
    let arms: FiniteMatchArmList = reverse_finite_match_arms<P, N>(pages, stride, total, scan.arms);
    let node: Expr = Expr.FiniteMatch { subject: subject, arms: arms, start: match_start, end: match_close_end<P, N>(pages, stride, total, close.end) };
    return match_nest_pop<P, N>(pages, stride, total, st, node, close.end);
}
fn match_nest_pop<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse, node: Expr, cursor: u64) -> (result: MatchNestParse) {
    return match st.stack {
        NSNil => MatchNestParse { ..st, done: true, node: node, node_ok: true, cursor: cursor },
        NSFinite { head: parent, tail: rest } => finite_nest_pop_parent<P, N>(pages, stride, total, st, parent, rest, node, cursor),
        NSScalar { head: parent, tail: rest } => scalar_nest_pop_parent<P, N>(pages, stride, total, st, parent, rest, node, cursor),
        NSExpr { head: frame, tail: rest } => expr_nest_resume<P, N>(pages, stride, total, st, frame, rest, node, cursor)
    };
}
fn finite_nest_pop_parent<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse, parent: FiniteNestParent, rest: MatchNestStack, node: Expr, cursor: u64) -> (result: MatchNestParse) {
    let delimiter: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if delimiter.diagnostic != 0 || (delimiter.kind != 64 && delimiter.kind != 68) { return MatchNestParse { ..st, ok: false, err_start: delimiter.start, err_end: delimiter.end }; }
    let arm: FiniteMatchArm = FiniteMatchArm { variant_start: parent.variant_start, variant_end: parent.variant_end, has_payload: parent.has_payload, bindings: parent.bindings, pattern_start: parent.pattern_start, pattern_end: parent.pattern_end, result: node };
    let next_cursor: u64 = select(delimiter.kind == 64, delimiter.end, cursor);
    let scan: FiniteMatchScan = FiniteMatchScan { ..parent.scan, cursor: next_cursor, end: delimiter.start, arms: FiniteMatchArmList.ACons { head: arm, tail: parent.scan.arms } };
    return MatchNestParse { top: MatchNestTop.FiniteTop { scan: scan, subject: parent.subject, match_start: parent.match_start }, stack: rest, ok: true, done: false, err_start: 0, err_end: 0, node: st.node, node_ok: false, cursor: next_cursor };
}
fn scalar_nest_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse, scan: MatchScan, subject: Expr, match_start: u64) -> (result: MatchNestParse) {
    if !(scan.ok) { return MatchNestParse { ..st, ok: false, err_start: scan.err_start, err_end: scan.err_end }; }
    let pattern_token: lexer.Token = segment.significant_global<P, N>(pages, stride, total, scan.cursor);
    if pattern_token.diagnostic != 0 { return MatchNestParse { ..st, ok: false, err_start: pattern_token.start, err_end: pattern_token.end }; }
    if pattern_token.kind == 68 { return scalar_nest_close<P, N>(pages, stride, total, st, scan, subject, match_start, pattern_token); }
    let pattern: MatchPattern = scalar_match_pattern<P, N>(pages, stride, total, pattern_token);
    if !(pattern.ok) { return MatchNestParse { ..st, ok: false, err_start: pattern.start, err_end: pattern.end }; }
    let arrow: lexer.Token = segment.significant_global<P, N>(pages, stride, total, pattern.cursor);
    if arrow.diagnostic != 0 || arrow.kind != 81 { return MatchNestParse { ..st, ok: false, err_start: arrow.start, err_end: arrow.end }; }
    let parent: ScalarNestParent = ScalarNestParent { scan: scan, subject: subject, match_start: match_start, is_default: pattern.is_default, negative: pattern.negative, value: pattern.value, overflow: pattern.overflow, pattern_start: pattern.start, pattern_end: pattern.end };
    let stack: MatchNestStack = MatchNestStack.NSScalar { head: parent, tail: st.stack };
    return MatchNestParse { top: MatchNestTop.ExprTop { est: nest_expr_seed(arrow.end, scan.profile_013) }, stack: stack, ok: true, done: false, err_start: 0, err_end: 0, node: st.node, node_ok: false, cursor: arrow.end };
}
fn scalar_nest_close<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse, scan: MatchScan, subject: Expr, match_start: u64, close: lexer.Token) -> (result: MatchNestParse) {
    let arms: ScalarMatchArmList = reverse_scalar_match_arms<P, N>(pages, stride, total, scan.arms);
    let node: Expr = Expr.ScalarMatch { subject: subject, arms: arms, start: match_start, end: match_close_end<P, N>(pages, stride, total, close.end) };
    return match_nest_pop<P, N>(pages, stride, total, st, node, close.end);
}
fn scalar_nest_pop_parent<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: MatchNestParse, parent: ScalarNestParent, rest: MatchNestStack, node: Expr, cursor: u64) -> (result: MatchNestParse) {
    let delimiter: lexer.Token = segment.significant_global<P, N>(pages, stride, total, cursor);
    if delimiter.diagnostic != 0 || (delimiter.kind != 64 && delimiter.kind != 68) { return MatchNestParse { ..st, ok: false, err_start: delimiter.start, err_end: delimiter.end }; }
    let arm: ScalarMatchArm = ScalarMatchArm { is_default: parent.is_default, negative: parent.negative, value: parent.value, overflow: parent.overflow, pattern_start: parent.pattern_start, pattern_end: parent.pattern_end, result: node };
    let next_cursor: u64 = select(delimiter.kind == 64, delimiter.end, cursor);
    let scan: MatchScan = MatchScan { ..parent.scan, cursor: next_cursor, end: delimiter.start, arms: ScalarMatchArmList.MCons { head: arm, tail: parent.scan.arms } };
    return MatchNestParse { top: MatchNestTop.ScalarTop { scan: scan, subject: parent.subject, match_start: parent.match_start }, stack: rest, ok: true, done: false, err_start: 0, err_end: 0, node: st.node, node_ok: false, cursor: next_cursor };
}
fn scalar_match_arms_empty(list: ScalarMatchArmList) -> (result: bool) {
    return match list { MNil => true, MCons { head: head, tail: tail } => false };
}
fn expr_list_empty(list: ExprList) -> (result: bool) {
    return match list { ENil => true, ECons { head: head, tail: tail } => false };
}
fn variant_list_empty(list: VariantList) -> (result: bool) {
    return match list { VNil => true, VCons { head: head, tail: tail } => false };
}
fn stmt_list_empty(list: StmtList) -> (result: bool) {
    return match list { SNil => true, SCons { head: head, tail: tail } => false };
}
fn clause_list_empty(list: ClauseList) -> (result: bool) {
    return match list { CNil => true, CCons { head: head, tail: tail } => false };
}
fn effect_list_empty(list: EffectList) -> (result: bool) {
    return match list { XNil => true, XCons { head: head, tail: tail } => false };
}
fn cap_list_empty(list: CapList) -> (result: bool) {
    return match list { ANil => true, ACons { head: head, tail: tail } => false };
}
fn use_list_empty(list: UseList) -> (result: bool) {
    return match list { UNil => true, UCons { head: head, tail: tail } => false };
}
fn record_list_empty(list: RecordList) -> (result: bool) {
    return match list { RNil => true, RCons { head: head, tail: tail } => false };
}
fn enum_list_empty(list: EnumList) -> (result: bool) {
    return match list { GNil => true, GCons { head: head, tail: tail } => false };
}
fn declared_fn_list_empty(list: FnList) -> (result: bool) {
    return match list { DNil => true, DCons { head: head, tail: tail } => false };
}
fn name_list_empty(list: NameList) -> (result: bool) {
    return match list { NNil => true, NCons { head: head, tail: tail } => false };
}
fn obligation_list_empty(list: OblList) -> (result: bool) {
    return match list { LNil => true, LCons { head: head, tail: tail } => false };
}
fn top_list_empty(list: TOpList) -> (result: bool) {
    return match list { PNil => true, PCons { head: head, tail: tail } => false };
}
fn type_list_empty(list: TyList) -> (result: bool) {
    return match list { TyNil => true, TyCons { head: head, tail: tail } => false };
}
fn reverse_scalar_match_arms<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: ScalarMatchArmList) -> (result: ScalarMatchArmList) {
    iterate i up_to 1024 carrying d: ScalarMatchArmRev = ScalarMatchArmRev { rest: arms, acc: ScalarMatchArmList.MNil } {
        if scalar_match_arms_empty(d.rest) { return d.acc; }
        next d = reverse_scalar_match_arms_step(d);
    }
    return d.acc;
}
fn reverse_scalar_match_arms_step(st: ScalarMatchArmRev) -> (result: ScalarMatchArmRev) {
    return match st.rest {
        MNil => st,
        MCons { head: h, tail: t } => ScalarMatchArmRev { rest: t, acc: ScalarMatchArmList.MCons { head: h, tail: st.acc } }
    };
}
fn scalar_match_result_step(st: ScalarMatchResultScan) -> (result: ScalarMatchResultScan) {
    return match st.rest {
        MNil => st,
        MCons { head: h, tail: t } => ScalarMatchResultScan { rest: t, acc: ExprList.ECons { head: h.result, tail: st.acc } }
    };
}
fn scalar_match_results<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: ScalarMatchArmList) -> (result: ExprList) {
    iterate i up_to 1024 carrying d: ScalarMatchResultScan = ScalarMatchResultScan { rest: arms, acc: ExprList.ENil } {
        next d = scalar_match_result_step(d);
    }
    return reverse_exprs<P, N>(pages, stride, total, d.acc);
}
fn scalar_match_children<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, subject: Expr, arms: ScalarMatchArmList, rest: ExprList) -> (result: ExprList) {
    return ExprList.ECons { head: subject, tail: append_exprs<P, N>(pages, stride, total, scalar_match_results<P, N>(pages, stride, total, arms), rest) };
}
record FiniteMatchResultScan { rest: FiniteMatchArmList, acc: ExprList }
fn finite_match_result_step(st: FiniteMatchResultScan) -> (result: FiniteMatchResultScan) {
    return match st.rest {
        ANil => st,
        ACons { head: h, tail: t } => FiniteMatchResultScan { rest: t, acc: ExprList.ECons { head: h.result, tail: st.acc } }
    };
}
fn finite_match_results<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: FiniteMatchArmList) -> (result: ExprList) {
    iterate i up_to 1024 carrying d: FiniteMatchResultScan = FiniteMatchResultScan { rest: arms, acc: ExprList.ENil } {
        if finite_match_arms_empty(d.rest) { return d.acc; }
        next d = finite_match_result_step(d);
    }
    return d.acc;
}
fn finite_match_children<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, subject: Expr, arms: FiniteMatchArmList, rest: ExprList) -> (result: ExprList) {
    return ExprList.ECons { head: subject, tail: append_exprs<P, N>(pages, stride, total, finite_match_results<P, N>(pages, stride, total, arms), rest) };
}
record ConstructValueScan { rest: ConstructFieldList, acc: ExprList }
fn construct_value_step(st: ConstructValueScan) -> (result: ConstructValueScan) {
    return match st.rest {
        CNil => st,
        CCons { head: h, tail: t } => ConstructValueScan { rest: t, acc: ExprList.ECons { head: h.value, tail: st.acc } }
    };
}
fn construct_values<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: ConstructFieldList) -> (result: ExprList) {
    iterate i up_to 1024 carrying d: ConstructValueScan = ConstructValueScan { rest: fields, acc: ExprList.ENil } {
        if construct_fields_empty(d.rest) { return d.acc; }
        next d = construct_value_step(d);
    }
    return d.acc;
}
fn construct_children<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: ConstructFieldList, rest: ExprList) -> (result: ExprList) {
    return append_exprs<P, N>(pages, stride, total, construct_values<P, N>(pages, stride, total, fields), rest);
}
// Record children elaborate base-first, matching Stage-0 source order: the
// `..base` expression is established before the overriding field values.
fn record_children<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, base: Expr, has_base: bool, fields: ConstructFieldList, rest: ExprList) -> (result: ExprList) {
    if has_base { return ExprList.ECons { head: base, tail: construct_children<P, N>(pages, stride, total, fields, rest) }; }
    return construct_children<P, N>(pages, stride, total, fields, rest);
}
record FiniteMatchCount { rest: FiniteMatchArmList, n: u64 }
fn finite_match_count_step(st: FiniteMatchCount) -> (result: FiniteMatchCount) {
    return match st.rest {
        ANil => st,
        ACons { head: arm, tail: rest } => FiniteMatchCount { rest: rest, n: st.n + 1 }
    };
}
fn finite_match_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: FiniteMatchArmList) -> (result: FiniteMatchCount) {
    iterate i up_to 1024 carrying d: FiniteMatchCount = FiniteMatchCount { rest: arms, n: 0 } {
        if finite_match_arms_empty(d.rest) { return d; }
        next d = finite_match_count_step(d);
    }
    return d;
}
record ScalarMatchCount { rest: ScalarMatchArmList, n: u64, defaults: u64 }
enum PatternValues { VNil, VCons { head: u64, tail: PatternValues } }
record PatternCheck { rest: ScalarMatchArmList, seen: PatternValues, subject_ty: SemType, default_seen: bool, ok: bool }
record PatternFind { rest: PatternValues, value: u64, found: bool }
fn scalar_match_count_step(st: ScalarMatchCount) -> (result: ScalarMatchCount) {
    return match st.rest {
        MNil => st,
        MCons { head: arm, tail: rest } => ScalarMatchCount { rest: rest, n: st.n + 1, defaults: st.defaults + select(arm.is_default, 1, 0) }
    };
}
fn scalar_match_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: ScalarMatchArmList) -> (result: ScalarMatchCount) {
    iterate i up_to 1024 carrying d: ScalarMatchCount = ScalarMatchCount { rest: arms, n: 0, defaults: 0 } {
        next d = scalar_match_count_step(d);
    }
    return d;
}
fn pattern_find_step(st: PatternFind) -> (result: PatternFind) {
    if st.found { return st; }
    return match st.rest {
        VNil => st,
        VCons { head: value, tail: rest } => PatternFind { rest: rest, value: st.value, found: value == st.value }
    };
}
fn pattern_seen<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: PatternValues, value: u64) -> (result: bool) {
    iterate i up_to 1024 carrying d: PatternFind = PatternFind { rest: values, value: value, found: false } {
        next d = pattern_find_step(d);
    }
    return d.found;
}
fn scalar_pattern_valid(ty: SemType, negative: bool, value: u64, overflow: bool) -> (result: bool) {
    if overflow { return false; }
    return match ty {
        TInt { width: width, signed: signed } => scalar_pattern_valid_int(width, signed, negative, value),
        TBool => false,
        TByte => false,
        TNamed { start: s, end: e } => false,
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: valid } => false,
        TPoison => false
    };
}
fn scalar_pattern_valid_int(width: u64, signed: bool, negative: bool, value: u64) -> (result: bool) {
    if width != 64 { return false; }
    if negative {
        if !(signed) { return false; }
        return value <= 9223372036854775808;
    }
    if signed { return value <= 9223372036854775807; }
    return true;
}
fn scalar_match_pattern_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PatternCheck) -> (result: PatternCheck) {
    if !(st.ok) || st.default_seen { return st; }
    return match st.rest {
        MNil => st,
        MCons { head: arm, tail: rest } => scalar_match_pattern_check_arm<P, N>(pages, stride, total, st, arm, rest)
    };
}
fn scalar_match_pattern_check_arm<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PatternCheck, arm: ScalarMatchArm, rest: ScalarMatchArmList) -> (result: PatternCheck) {
    if arm.is_default {
        if !(matches_scalar_arms_empty(rest)) { return PatternCheck { ..st, rest: ScalarMatchArmList.MNil, ok: false }; }
        return PatternCheck { ..st, rest: ScalarMatchArmList.MNil, default_seen: true, ok: true };
    }
    if !(scalar_pattern_valid(st.subject_ty, arm.negative, arm.value, arm.overflow)) { return PatternCheck { ..st, rest: ScalarMatchArmList.MNil, ok: false }; }
    let payload: u64 = select(arm.negative, negative_payload(arm.value), arm.value);
    if pattern_seen<P, N>(pages, stride, total, st.seen, payload) { return PatternCheck { ..st, rest: ScalarMatchArmList.MNil, ok: false }; }
    return PatternCheck { rest: rest, seen: PatternValues.VCons { head: payload, tail: st.seen }, subject_ty: st.subject_ty, default_seen: false, ok: true };
}
fn matches_scalar_arms_empty(arms: ScalarMatchArmList) -> (result: bool) {
    return match arms { MNil => true, MCons { head: h, tail: t } => false };
}
fn scalar_match_patterns_ok<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: ScalarMatchArmList, subject_ty: SemType) -> (result: bool) {
    iterate i up_to 1024 carrying d: PatternCheck = PatternCheck { rest: arms, seen: PatternValues.VNil, subject_ty: subject_ty, default_seen: false, ok: true } {
        next d = scalar_match_pattern_step<P, N>(pages, stride, total, d);
    }
    return d.ok && d.default_seen;
}
// Same pattern rule over proof-emitted typed arms: default last and
// exactly once, valid width/signed ranges, no duplicate payloads.
record TypedPatternCheck { rest: TypedScalarMatchArmList, seen: PatternValues, subject_ty: SemType, default_seen: bool, ok: bool }
fn typed_scalar_match_pattern_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TypedPatternCheck) -> (result: TypedPatternCheck) {
    if !(st.ok) || st.default_seen { return st; }
    return match st.rest {
        TSNil => st,
        TSCons { head: arm, tail: rest } => typed_scalar_match_pattern_check_arm<P, N>(pages, stride, total, st, arm, rest)
    };
}
fn typed_scalar_match_pattern_check_arm<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: TypedPatternCheck, arm: TypedScalarMatchArm, rest: TypedScalarMatchArmList) -> (result: TypedPatternCheck) {
    if arm.is_default {
        if !(matches_typed_scalar_arms_empty(rest)) { return TypedPatternCheck { ..st, rest: TypedScalarMatchArmList.TSNil, ok: false }; }
        return TypedPatternCheck { ..st, rest: TypedScalarMatchArmList.TSNil, default_seen: true, ok: true };
    }
    if !(scalar_pattern_valid(st.subject_ty, arm.negative, arm.value, arm.overflow)) { return TypedPatternCheck { ..st, rest: TypedScalarMatchArmList.TSNil, ok: false }; }
    let payload: u64 = select(arm.negative, negative_payload(arm.value), arm.value);
    if pattern_seen<P, N>(pages, stride, total, st.seen, payload) { return TypedPatternCheck { ..st, rest: TypedScalarMatchArmList.TSNil, ok: false }; }
    return TypedPatternCheck { rest: rest, seen: PatternValues.VCons { head: payload, tail: st.seen }, subject_ty: st.subject_ty, default_seen: false, ok: true };
}
fn matches_typed_scalar_arms_empty(arms: TypedScalarMatchArmList) -> (result: bool) {
    return match arms { TSNil => true, TSCons { head: h, tail: t } => false };
}
fn typed_scalar_match_patterns_ok<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: TypedScalarMatchArmList, subject_ty: SemType) -> (result: bool) {
    iterate i up_to 1024 carrying d: TypedPatternCheck = TypedPatternCheck { rest: arms, seen: PatternValues.VNil, subject_ty: subject_ty, default_seen: false, ok: true } {
        next d = typed_scalar_match_pattern_step<P, N>(pages, stride, total, d);
    }
    return d.ok && d.default_seen;
}

fn prefix_not(st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: st.operands, operators: OpList.OCons { head: Op { kind: 1002, argc: 0, name_start: tok.start, name_end: tok.end, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: st.operators }, depth: st.depth, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
fn prefix_repeat(st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: st.operands, operators: OpList.OCons { head: Op { kind: 1003, argc: 0, name_start: tok.start, name_end: tok.end, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: st.operators }, depth: st.depth, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
fn top_repeat_marker(operators: OpList) -> (result: bool) {
    return match operators {
        ONil => false,
        OCons { head: op, tail: rest } => op.kind == 1003
    };
}
fn finish_repeat<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, semi: lexer.Token) -> (result: ExprState) {
    if st.depth != 0 || st.expect_operand { return expr_fail(st, semi.start, semi.end); }
    return match st.operators {
        ONil => expr_fail(st, semi.start, semi.end),
        OCons { head: marker, tail: rest } => finish_repeat_element<P, N>(pages, stride, total, st, semi, marker, rest)
    };
}
fn finish_repeat_element<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, semi: lexer.Token, marker: Op, rest: OpList) -> (result: ExprState) {
    if marker.kind != 1003 { return expr_fail(st, semi.start, semi.end); }
    let count: lexer.Token = segment.significant_global<P, N>(pages, stride, total, semi.end);
    if count.diagnostic != 0 || (count.kind != 5 && count.kind != 4) { return expr_fail(st, count.start, count.end); }
    let close: lexer.Token = segment.significant_global<P, N>(pages, stride, total, count.end);
    if close.diagnostic != 0 || close.kind != 70 { return expr_fail(st, close.start, close.end); }
    return match st.operands {
        ENil => expr_fail(st, semi.start, semi.end),
        ECons { head: element, tail: before } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: close.end, operands: ExprList.ECons { head: Expr.Repeat { value: element, count_start: count.start, count_end: count.end, count_kind: count.kind, start: marker.name_start, end: close.end }, tail: before }, operators: rest, depth: st.depth, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct }
    };
}

// Profile 0.18 admits a signed integer atom. Store its two's-complement
// payload in the existing integer node so proof and later scalar lowering
// keep the same typed-operation path as positive literals.
fn shift_negative_integer<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, minus: lexer.Token) -> (result: ExprState) {
    let literal: lexer.Token = segment.significant_global<P, N>(pages, stride, total, minus.end);
    if literal.diagnostic != 0 || literal.kind != 5 { return expr_fail(st, minus.start, minus.end); }
    let parsed: IntVal = int_value<P, N>(pages, stride, total, literal.start, literal.end);
    let negative: u64 = negative_payload(parsed.value);
    let node: Expr = Expr.Integer { start: minus.start, end: literal.end, value: negative, overflow: parsed.overflow };
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: literal.end, operands: ExprList.ECons { head: node, tail: st.operands }, operators: st.operators, depth: st.depth, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct };
}
fn negative_payload(magnitude: u64) -> (result: u64) {
    if magnitude == 0 { return 0; }
    return 18446744073709551615 - (magnitude - 1);
}

// A delimiter (or a second operand, or a closing paren context): drain one
// pending operator, or finish when the stacks allow it.
fn close_or_reduce<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, err_start: u64, err_end: u64) -> (result: ExprState) {
    if st.depth > 0 { return expr_fail(st, err_start, err_end); }
    return match st.operators {
        ONil => ExprState { ok: true, err_start: 0, err_end: 0, cursor: st.cursor, operands: st.operands, operators: st.operators, depth: st.depth, done: true, expect_operand: st.expect_operand, profile_013: st.profile_013, allow_construct: st.allow_construct },
        OCons { head: op, tail: rest } => reduce_or_fail(st, op, rest, err_start, err_end)
    };
}
fn reduce_or_fail(st: ExprState, op: Op, rest: OpList, err_start: u64, err_end: u64) -> (result: ExprState) {
    if op.kind >= 1000 && op.kind != 1002 { return expr_fail(st, err_start, err_end); }
    return reduce_one(st, op, rest, err_start, err_end);
}
fn reduce_one(st: ExprState, op: Op, rest: OpList, err_start: u64, err_end: u64) -> (result: ExprState) {
    if op.kind == 1002 { return reduce_not(st, op, rest, err_start, err_end); }
    return match st.operands {
        ENil => expr_fail(st, err_start, err_end),
        ECons { head: r, tail: t1 } => reduce_inner(st, op, rest, r, t1, err_start, err_end)
    };
}
fn reduce_not(st: ExprState, op: Op, rest: OpList, err_start: u64, err_end: u64) -> (result: ExprState) {
    return match st.operands {
        ENil => expr_fail(st, err_start, err_end),
        ECons { head: value, tail: before } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: st.cursor, operands: ExprList.ECons { head: Expr.UnaryNot { value: value, start: op.name_start, end: expr_end(value) }, tail: before }, operators: rest, depth: st.depth, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct }
    };
}
fn reduce_inner(st: ExprState, op: Op, rest: OpList, r: Expr, t1: ExprList, err_start: u64, err_end: u64) -> (result: ExprState) {
    return match t1 {
        ENil => expr_fail(st, err_start, err_end),
        ECons { head: l, tail: t2 } => ExprState { ok: true, err_start: 0, err_end: 0, cursor: st.cursor, operands: ExprList.ECons { head: Expr.Binary { op: op.kind, left: l, right: r, start: expr_start(l), end: expr_end(r) }, tail: t2 }, operators: rest, depth: st.depth, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct }
    };
}

fn shift_operand<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    if tok.kind == 5 {
        let value: IntVal = int_value<P, N>(pages, stride, total, tok.start, tok.end);
        let node: Expr = Expr.Integer { start: tok.start, end: tok.end, value: value.value, overflow: value.overflow };
        return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: st.operands }, operators: st.operators, depth: st.depth, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct };
    }
    if tok.kind == 38 || tok.kind == 39 {
        let node: Expr = Expr.Boolean { start: tok.start, end: tok.end, value: tok.kind == 38 };
        return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: st.operands }, operators: st.operators, depth: st.depth, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct };
    }
    let after: lexer.Token = segment.significant_global<P, N>(pages, stride, total, tok.end);
    let node: Expr = Expr.Name { start: tok.start, end: tok.end };
    if after.diagnostic == 0 && after.kind == 65 {
        return ExprState { ok: true, err_start: 0, err_end: 0, cursor: after.end, operands: ExprList.ECons { head: node, tail: st.operands }, operators: OpList.OCons { head: Op { kind: 1001, argc: 0, name_start: tok.start, name_end: tok.end, args: ExprList.ENil, targs: TypeArgList.TNil }, tail: st.operators }, depth: st.depth + 1, done: false, expect_operand: true, profile_013: st.profile_013, allow_construct: st.allow_construct };
    }
    return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: ExprList.ECons { head: node, tail: st.operands }, operators: st.operators, depth: st.depth, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct };
}

fn close_paren<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token) -> (result: ExprState) {
    return match st.operators {
        ONil => expr_fail(st, tok.start, tok.end),
        OCons { head: op, tail: rest } => close_paren_top<P, N>(pages, stride, total, st, tok, op, rest)
    };
}
fn close_paren_top<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprState, tok: lexer.Token, op: Op, rest: OpList) -> (result: ExprState) {
    if op.kind < 1000 { return reduce_one(st, op, rest, tok.start, tok.end); }
    if op.kind == 1002 { return reduce_one(st, op, rest, tok.start, tok.end); }
    if op.kind == 1000 {
        if st.expect_operand { return expr_fail(st, tok.start, tok.end); }
        return ExprState { ok: true, err_start: 0, err_end: 0, cursor: tok.end, operands: st.operands, operators: rest, depth: st.depth - 1, done: false, expect_operand: false, profile_013: st.profile_013, allow_construct: st.allow_construct };
    }
    if op.kind == 1004 || op.kind == 1005 || op.kind == 1006 { return expr_fail(st, tok.start, tok.end); }
    return close_call<P, N>(pages, stride, total, st, tok, op, rest);
}
// Compiler operations (CP-0019): the host operations real family sources
// call. Like Stage-0's intrinsic_selection, the parser reserves these
// names in call head position: a bare call whose name bytes match exactly
// becomes an OpCall node carrying its operation slot, never a plain Call.
// Arity is enforced here (Stage-0 reports MNP205/MNP218/MNP220 at parse);
// operand typing, result typing, and effect/capability authorization
// belong to the proof. Slots: 0 fs_entry_kind_at, 1 structured_read, 2
// structured_write, 3 fs_entry_size_at, 4 fs_entry_mtime_at; slot 5 means
// "not an operation".
fn op_slot_at<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ns: u64, ne: u64) -> (result: u64) {
    if ne < ns { return 5; }
    if ne - ns == 15 { return op_slot_len15<P, N>(pages, stride, total, ns); }
    if ne - ns == 16 { return op_slot_len16<P, N>(pages, stride, total, ns); }
    if ne - ns == 17 { return op_slot_len17<P, N>(pages, stride, total, ns); }
    return 5;
}
fn op_slot_len15<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ns: u64) -> (result: u64) {
    if span_is_structured_read<P, N>(pages, stride, total, ns) { return 1; }
    return 5;
}
fn op_slot_len16<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ns: u64) -> (result: u64) {
    if span_is_fs_entry_kind_at<P, N>(pages, stride, total, ns) { return 0; }
    if span_is_structured_write<P, N>(pages, stride, total, ns) { return 2; }
    if span_is_fs_entry_size_at<P, N>(pages, stride, total, ns) { return 3; }
    return 5;
}
fn op_slot_len17<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ns: u64) -> (result: u64) {
    if span_is_fs_entry_mtime_at<P, N>(pages, stride, total, ns) { return 4; }
    return 5;
}
fn span_is_fs_entry_kind_at<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, a: u64) -> (result: bool) {
    if segment.byte_at_global<P, N>(pages, stride, total, a) != 102 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 1) != 115 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 2) != 95 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 3) != 101 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 4) != 110 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 5) != 116 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 6) != 114 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 7) != 121 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 8) != 95 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 9) != 107 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 10) != 105 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 11) != 110 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 12) != 100 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 13) != 95 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 14) != 97 { return false; }
    if segment.byte_at_global<P, N>(pages, stride, total, a + 15) != 116 { return false; }
    return true;
}
