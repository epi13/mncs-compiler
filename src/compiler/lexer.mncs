// Two-character operators group under their first byte; the inner default is
// the single-character kind, and the outer default is unknown (kind 7).
// Scalar `match` checks exhaustiveness at elaboration (MNE140): adding a new
// two-byte operator without extending its first-byte arm fails the build
// instead of silently falling through.
fn punctuation(a: u64, b: u64) -> (result: u64) {
    return match a {
        45 => match b { 62 => 80, 37 => 92, 124 => 95, _ => 51 },
        61 => match b { 62 => 81, 61 => 84, _ => 60 },
        38 => match b { 38 => 82, _ => 55 },
        124 => match b { 124 => 83, _ => 56 },
        33 => match b { 61 => 85, _ => 7 },
        60 => match b { 61 => 86, 60 => 88, _ => 58 },
        62 => match b { 61 => 87, 62 => 89, _ => 59 },
        46 => match b { 46 => 90, _ => 61 },
        43 => match b { 37 => 91, 124 => 94, _ => 50 },
        42 => match b { 37 => 93, 124 => 96, _ => 52 },
        47 => 53,
        37 => 54,
        94 => 57,
        58 => 62,
        59 => 63,
        44 => 64,
        40 => 65,
        41 => 66,
        123 => 67,
        125 => 68,
        91 => 69,
        93 => 70,
        _ => 7
    };
}

fn next_token<N: Nat>(text: [byte; up_to N], start: u64) -> (result: Token) {
    if start > text.len { return Token { kind: 0, start: text.len, end: text.len, diagnostic: 4 }; }
    if start == text.len { return Token { kind: 0, start: start, end: start, diagnostic: 0 }; }
    let a: u64 = source.byte_at<N>(text, start);
    let b: u64 = source.byte_at<N>(text, start + 1);
    if a >= 128 { return Token { kind: 7, start: start, end: start + 1, diagnostic: 3 }; }
    let line: bool = a == 47 && b == 47;
    let block: bool = a == 47 && b == 42;
    let word: bool = letter(a);
    let number: bool = digit(a);
    let ws: bool = space(a);
    if line || block || word || number || ws {
        let seed: Scan = Scan { end: start + select(line || block, 2, 1), depth: select(block, 1, 0), dotted: false, done: false };
        iterate i over text[start..text.len] carrying st: Scan = seed {
            let advanced: Scan = scan_step<N>(text, st, line, block, word, number, ws);
            if advanced.done || advanced.end >= text.len {
                let kind: u64 = select(ws, 1, select(line, 2, select(block, 3, select(word, keyword<N>(text, start, advanced.end), select(advanced.dotted, 6, 5)))));
                return Token { kind: kind, start: start, end: advanced.end, diagnostic: select(block && advanced.depth > 0, 1, 0) };
            }
            next st = advanced;
        }
        let kind: u64 = select(ws, 1, select(line, 2, select(block, 3, select(word, keyword<N>(text, start, st.end), select(st.dotted, 6, 5)))));
        return Token { kind: kind, start: start, end: st.end, diagnostic: select(block && st.depth > 0, 1, 0) };
    }
    let kind: u64 = punctuation(a, b);
    return Token { kind: kind, start: start, end: start + select(kind >= 80, 2, 1), diagnostic: select(kind == 7, 2, 0) };
}

fn scan_step<N: Nat>(text: [byte; up_to N], st: Scan, line: bool, block: bool, word: bool, number: bool, ws: bool) -> (result: Scan) {
    if st.done || st.end >= text.len { return st; }
    let a: u64 = source.byte_at<N>(text, st.end);
    let b: u64 = source.byte_at<N>(text, st.end + 1);
    if block {
        if a == 47 && b == 42 { return Scan { ..st, end: st.end + 2, depth: st.depth + 1 }; }
        if a == 42 && b == 47 { return Scan { ..st, end: st.end + 2, depth: st.depth - 1, done: st.depth == 1 }; }
        return Scan { ..st, end: st.end + 1 };
    }
    // Preserve Stage-0's unusual continuation of dots after the first version dot.
    let dot: bool = number && a == 46 && (st.dotted || digit(b));
    let advance: bool = (line && a != 10) || (word && (letter(a) || digit(a))) || (number && (digit(a) || dot)) || (ws && space(a));
    return Scan { ..st, end: st.end + select(advance, 1, 0), dotted: st.dotted || dot, done: !advance };
}

// Significant-token request; lexical failure is never discarded as trivia.
fn significant<N: Nat>(text: [byte; up_to N], start: u64) -> (result: Token) {
    let first: Token = next_token<N>(text, start);
    if !(is_trivia(first)) { return first; }
    let second: Token = skip_trivia<N>(text, first);
    if !(is_trivia(second)) { return second; }
    iterate i over text[second.start..text.len] carrying token: Token = second {
        if !(is_trivia(token)) { return token; }
        next token = skip_trivia<N>(text, token);
    }
    return token;
}
fn is_trivia(token: Token) -> (result: bool) {
    return token.kind >= 1 && token.kind <= 3 && token.diagnostic == 0;
}
fn skip_trivia<N: Nat>(text: [byte; up_to N], token: Token) -> (result: Token) {
    if is_trivia(token) { return next_token<N>(text, token.end); }
    return token;
}

// Logical-source lexer (CP-0001): the same token rules over global offsets
// into a validated page composition. Scans continue across page boundaries
// transparently; spans are global and stride-stable. Diagnostics extend the
// single-view vocabulary: 5 marks a significant token that outruns the
// 8192-step per-call scan budget (word/number content past the budget is an
// honest bounded-lexer refusal, never a silent split), and 6 marks a trivia
// prefix whose remainder continues at its end (whitespace and comments may
// span pages arbitrarily; the host continues scanning trivia past them).
fn keyword_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: u64) {
    if end - start == 4 {
        if source.byte_at_global<P, N>(pages, stride, total, start + 0) == 109 && source.byte_at_global<P, N>(pages, stride, total, start + 1) == 110 && source.byte_at_global<P, N>(pages, stride, total, start + 2) == 99 && source.byte_at_global<P, N>(pages, stride, total, start + 3) == 115 { return 10; }
    }
    if end - start == 6 {
        if source.byte_at_global<P, N>(pages, stride, total, start + 0) == 109 && source.byte_at_global<P, N>(pages, stride, total, start + 1) == 111 && source.byte_at_global<P, N>(pages, stride, total, start + 2) == 100 && source.byte_at_global<P, N>(pages, stride, total, start + 3) == 117 && source.byte_at_global<P, N>(pages, stride, total, start + 4) == 108 && source.byte_at_global<P, N>(pages, stride, total, start + 5) == 101 { return 11; }
    }
    if end - start == 2 {
        if source.byte_at_global<P, N>(pages, stride, total, start + 0) == 102 && source.byte_at_global<P, N>(pages, stride, total, start + 1) == 110 { return 12; }
    }
    if end - start == 6 {
