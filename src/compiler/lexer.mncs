mncs 0.18;
module mncs.compiler.lexer.v1;
use mncs.compiler.source.v1 as source;

// Numeric kinds are a versioned wire vocabulary: src/compiler/token-kinds.json.
// diagnostic: 0 none, 1 MNL001, 2 MNL002, 3 unsupported non-ASCII,
// 4 invalid cursor. EOF is kind 0 and has an empty span.
record Token { kind: u64, start: u64, end: u64, diagnostic: u64 }
record Scan { end: u64, depth: u64, dotted: bool, done: bool }

fn digit(c: u64) -> (result: bool) { return c >= 48 && c <= 57; }
fn letter(c: u64) -> (result: bool) {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}
fn space(c: u64) -> (result: bool) {
    return c == 32 || (c >= 9 && c <= 13);
}
fn keyword<N: Nat>(text: [byte; up_to N], start: u64, end: u64) -> (result: u64) {
