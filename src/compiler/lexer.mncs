mncs 0.18;
module mncs.compiler.lexer.v1;
use mncs.compiler.source.v1 as source;

// Numeric kinds are a versioned wire vocabulary: src/compiler/token-kinds.json.
// diagnostic: 0 none, 1 MNL001, 2 MNL002, 3 unsupported non-ASCII,
// 4 invalid cursor. EOF is kind 0 and has an empty span.
record Token { kind: u64, start: u64, end: u64, diagnostic: u64 }
record Scan { end: u64, depth: u64, dotted: bool, done: bool }

fn digit(c: u64) -> (result: bool) { return c >= 48 && c <= 57; }
fn letter(c: u64) -> (result: bool) {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}
// Source text reaches the reference parser as UTF-8. A rejected non-ASCII
// scalar therefore occupies its full encoded width in the shared byte-span
// vocabulary, even though the MNCS token grammar is ASCII-only.
fn utf8_width(lead: u64) -> (result: u64) {
    if lead >= 194 && lead <= 223 { return 2; }
    if lead >= 224 && lead <= 239 { return 3; }
    if lead >= 240 && lead <= 244 { return 4; }
    return 1;
}
fn space(c: u64) -> (result: bool) {
    return c == 32 || (c >= 9 && c <= 13);
}
fn keyword<N: Nat>(text: [byte; up_to N], start: u64, end: u64) -> (result: u64) {
    let length: u64 = end - start;
    if length == 2 {
        let b0: u64 = source.byte_at<N>(text, start + 0);
        let b1: u64 = source.byte_at<N>(text, start + 1);
        if b0 == 102 && b1 == 110 { return 12; }
        if b0 == 105 && b1 == 102 { return 15; }
        if b0 == 97 && b1 == 115 { return 36; }
    }
    if length == 3 {
        let b0: u64 = source.byte_at<N>(text, start + 0);
        let b1: u64 = source.byte_at<N>(text, start + 1);
        let b2: u64 = source.byte_at<N>(text, start + 2);
        if b0 == 108 && b1 == 101 && b2 == 116 { return 14; }
        if b0 == 117 && b1 == 115 && b2 == 101 { return 28; }
    }
    if length == 4 {
        let b0: u64 = source.byte_at<N>(text, start + 0);
        let b1: u64 = source.byte_at<N>(text, start + 1);
        let b2: u64 = source.byte_at<N>(text, start + 2);
        let b3: u64 = source.byte_at<N>(text, start + 3);
        if b0 == 109 && b1 == 110 && b2 == 99 && b3 == 115 { return 10; }
        if b0 == 101 && b1 == 108 && b2 == 115 && b3 == 101 { return 16; }
        if b0 == 102 && b1 == 97 && b2 == 105 && b3 == 108 { return 17; }
        if b0 == 101 && b1 == 110 && b2 == 117 && b3 == 109 { return 27; }
        if b0 == 110 && b1 == 101 && b2 == 120 && b3 == 116 { return 34; }
        if b0 == 111 && b1 == 118 && b2 == 101 && b3 == 114 { return 35; }
        if b0 == 116 && b1 == 114 && b2 == 117 && b3 == 101 { return 38; }
    }
    if length == 5 {
        let b0: u64 = source.byte_at<N>(text, start + 0);
        let b1: u64 = source.byte_at<N>(text, start + 1);
        let b2: u64 = source.byte_at<N>(text, start + 2);
        let b3: u64 = source.byte_at<N>(text, start + 3);
        let b4: u64 = source.byte_at<N>(text, start + 4);
        if b0 == 109 && b1 == 97 && b2 == 116 && b3 == 99 && b4 == 104 { return 30; }
        if b0 == 117 && b1 == 112 && b2 == 95 && b3 == 116 && b4 == 111 { return 32; }
        if b0 == 119 && b1 == 104 && b2 == 105 && b3 == 108 && b4 == 101 { return 37; }
        if b0 == 102 && b1 == 97 && b2 == 108 && b3 == 115 && b4 == 101 { return 39; }
    }
    if length == 6 {
        let b0: u64 = source.byte_at<N>(text, start + 0);
        let b1: u64 = source.byte_at<N>(text, start + 1);
        let b2: u64 = source.byte_at<N>(text, start + 2);
        let b3: u64 = source.byte_at<N>(text, start + 3);
        let b4: u64 = source.byte_at<N>(text, start + 4);
        let b5: u64 = source.byte_at<N>(text, start + 5);
        if b0 == 109 && b1 == 111 && b2 == 100 && b3 == 117 && b4 == 108 && b5 == 101 { return 11; }
        if b0 == 114 && b1 == 101 && b2 == 116 && b3 == 117 && b4 == 114 && b5 == 110 { return 13; }
        if b0 == 101 && b1 == 102 && b2 == 102 && b3 == 101 && b4 == 99 && b5 == 116 { return 24; }
        if b0 == 114 && b1 == 101 && b2 == 99 && b3 == 111 && b4 == 114 && b5 == 100 { return 29; }
    }
    if length == 8 {
        let b0: u64 = source.byte_at<N>(text, start + 0);
        let b1: u64 = source.byte_at<N>(text, start + 1);
        let b2: u64 = source.byte_at<N>(text, start + 2);
        let b3: u64 = source.byte_at<N>(text, start + 3);
        let b4: u64 = source.byte_at<N>(text, start + 4);
        let b5: u64 = source.byte_at<N>(text, start + 5);
        let b6: u64 = source.byte_at<N>(text, start + 6);
        let b7: u64 = source.byte_at<N>(text, start + 7);
        if b0 == 114 && b1 == 101 && b2 == 113 && b3 == 117 && b4 == 105 && b5 == 114 && b6 == 101 && b7 == 115 { return 18; }
        if b0 == 112 && b1 == 114 && b2 == 111 && b3 == 112 && b4 == 101 && b5 == 114 && b6 == 116 && b7 == 121 { return 21; }
        if b0 == 99 && b1 == 97 && b2 == 114 && b3 == 114 && b4 == 121 && b5 == 105 && b6 == 110 && b7 == 103 { return 33; }
    }
    if length == 7 {
        let b0: u64 = source.byte_at<N>(text, start + 0);
        let b1: u64 = source.byte_at<N>(text, start + 1);
        let b2: u64 = source.byte_at<N>(text, start + 2);
        let b3: u64 = source.byte_at<N>(text, start + 3);
        let b4: u64 = source.byte_at<N>(text, start + 4);
        let b5: u64 = source.byte_at<N>(text, start + 5);
        let b6: u64 = source.byte_at<N>(text, start + 6);
        if b0 == 101 && b1 == 110 && b2 == 115 && b3 == 117 && b4 == 114 && b5 == 101 && b6 == 115 { return 19; }
        if b0 == 97 && b1 == 115 && b2 == 115 && b3 == 117 && b4 == 109 && b5 == 101 && b6 == 115 { return 20; }
        if b0 == 105 && b1 == 116 && b2 == 101 && b3 == 114 && b4 == 97 && b5 == 116 && b6 == 101 { return 31; }
    }
    if length == 9 {
        let b0: u64 = source.byte_at<N>(text, start + 0);
        let b1: u64 = source.byte_at<N>(text, start + 1);
        let b2: u64 = source.byte_at<N>(text, start + 2);
        let b3: u64 = source.byte_at<N>(text, start + 3);
        let b4: u64 = source.byte_at<N>(text, start + 4);
        let b5: u64 = source.byte_at<N>(text, start + 5);
        let b6: u64 = source.byte_at<N>(text, start + 6);
        let b7: u64 = source.byte_at<N>(text, start + 7);
        let b8: u64 = source.byte_at<N>(text, start + 8);
        if b0 == 105 && b1 == 110 && b2 == 118 && b3 == 97 && b4 == 114 && b5 == 105 && b6 == 97 && b7 == 110 && b8 == 116 { return 22; }
    }
    if length == 11 {
        let b0: u64 = source.byte_at<N>(text, start + 0);
        let b1: u64 = source.byte_at<N>(text, start + 1);
        let b2: u64 = source.byte_at<N>(text, start + 2);
        let b3: u64 = source.byte_at<N>(text, start + 3);
        let b4: u64 = source.byte_at<N>(text, start + 4);
        let b5: u64 = source.byte_at<N>(text, start + 5);
        let b6: u64 = source.byte_at<N>(text, start + 6);
        let b7: u64 = source.byte_at<N>(text, start + 7);
        let b8: u64 = source.byte_at<N>(text, start + 8);
        let b9: u64 = source.byte_at<N>(text, start + 9);
        let b10: u64 = source.byte_at<N>(text, start + 10);
        if b0 == 109 && b1 == 101 && b2 == 116 && b3 == 97 && b4 == 109 && b5 == 111 && b6 == 114 && b7 == 112 && b8 == 104 && b9 == 105 && b10 == 99 { return 23; }
    }
    if length == 10 {
        let b0: u64 = source.byte_at<N>(text, start + 0);
        let b1: u64 = source.byte_at<N>(text, start + 1);
        let b2: u64 = source.byte_at<N>(text, start + 2);
        let b3: u64 = source.byte_at<N>(text, start + 3);
        let b4: u64 = source.byte_at<N>(text, start + 4);
        let b5: u64 = source.byte_at<N>(text, start + 5);
        let b6: u64 = source.byte_at<N>(text, start + 6);
        let b7: u64 = source.byte_at<N>(text, start + 7);
        let b8: u64 = source.byte_at<N>(text, start + 8);
        let b9: u64 = source.byte_at<N>(text, start + 9);
        if b0 == 99 && b1 == 97 && b2 == 112 && b3 == 97 && b4 == 98 && b5 == 105 && b6 == 108 && b7 == 105 && b8 == 116 && b9 == 121 { return 25; }
    }
    if length == 13 {
        let b0: u64 = source.byte_at<N>(text, start + 0);
        let b1: u64 = source.byte_at<N>(text, start + 1);
        let b2: u64 = source.byte_at<N>(text, start + 2);
        let b3: u64 = source.byte_at<N>(text, start + 3);
        let b4: u64 = source.byte_at<N>(text, start + 4);
        let b5: u64 = source.byte_at<N>(text, start + 5);
        let b6: u64 = source.byte_at<N>(text, start + 6);
        let b7: u64 = source.byte_at<N>(text, start + 7);
        let b8: u64 = source.byte_at<N>(text, start + 8);
        let b9: u64 = source.byte_at<N>(text, start + 9);
        let b10: u64 = source.byte_at<N>(text, start + 10);
        let b11: u64 = source.byte_at<N>(text, start + 11);
        let b12: u64 = source.byte_at<N>(text, start + 12);
        if b0 == 97 && b1 == 117 && b2 == 116 && b3 == 104 && b4 == 111 && b5 == 114 && b6 == 105 && b7 == 122 && b8 == 101 && b9 == 100 && b10 == 95 && b11 == 98 && b12 == 121 { return 26; }
    }
    return 4;
}

// Two-character operators group under their first byte; the inner default is
// the single-character kind, and the outer default is unknown (kind 7).
// Scalar `match` checks exhaustiveness at elaboration (MNE140): adding a new
// two-byte operator without extending its first-byte arm fails the build
// instead of silently falling through.
fn punctuation(a: u64, b: u64) -> (result: u64) {
    return match a {
        45 => match b { 62 => 80, 37 => 92, 124 => 95, _ => 51 },
        61 => match b { 62 => 81, 61 => 84, _ => 60 },
        38 => match b { 38 => 82, _ => 55 },
        124 => match b { 124 => 83, _ => 56 },
        33 => match b { 61 => 85, _ => 40 },
        60 => match b { 61 => 86, 60 => 88, _ => 58 },
        62 => match b { 61 => 87, 62 => 89, _ => 59 },
        46 => match b { 46 => 90, _ => 61 },
        43 => match b { 37 => 91, 124 => 94, _ => 50 },
        42 => match b { 37 => 93, 124 => 96, _ => 52 },
        47 => 53,
        37 => 54,
        94 => 57,
        58 => 62,
        59 => 63,
        44 => 64,
        40 => 65,
        41 => 66,
        123 => 67,
        125 => 68,
        91 => 69,
        93 => 70,
        _ => 7
    };
}

fn next_token<N: Nat>(text: [byte; up_to N], start: u64) -> (result: Token) {
    if start > text.len { return Token { kind: 0, start: text.len, end: text.len, diagnostic: 4 }; }
    if start == text.len { return Token { kind: 0, start: start, end: start, diagnostic: 0 }; }
    let a: u64 = source.byte_at<N>(text, start);
    let b: u64 = source.byte_at<N>(text, start + 1);
    if a >= 128 {
        let width: u64 = utf8_width(a);
        let remaining: u64 = text.len - start;
        return Token { kind: 7, start: start, end: start + select(width <= remaining, width, remaining), diagnostic: 3 };
    }
    let line: bool = a == 47 && b == 47;
    let block: bool = a == 47 && b == 42;
    let word: bool = letter(a);
    let number: bool = digit(a);
    let ws: bool = space(a);
    if line || block || word || number || ws {
        let seed: Scan = Scan { end: start + select(line || block, 2, 1), depth: select(block, 1, 0), dotted: false, done: false };
        iterate i over text[start..text.len] carrying st: Scan = seed {
            let advanced: Scan = scan_step<N>(text, st, line, block, word, number, ws);
            if advanced.done || advanced.end >= text.len {
                let kind: u64 = select(ws, 1, select(line, 2, select(block, 3, select(word, keyword<N>(text, start, advanced.end), select(advanced.dotted, 6, 5)))));
                return Token { kind: kind, start: start, end: advanced.end, diagnostic: select(block && advanced.depth > 0, 1, 0) };
            }
            next st = advanced;
        }
        let kind: u64 = select(ws, 1, select(line, 2, select(block, 3, select(word, keyword<N>(text, start, st.end), select(st.dotted, 6, 5)))));
        return Token { kind: kind, start: start, end: st.end, diagnostic: select(block && st.depth > 0, 1, 0) };
    }
    let kind: u64 = punctuation(a, b);
    return Token { kind: kind, start: start, end: start + select(kind >= 80, 2, 1), diagnostic: select(kind == 7, 2, 0) };
}

fn scan_step<N: Nat>(text: [byte; up_to N], st: Scan, line: bool, block: bool, word: bool, number: bool, ws: bool) -> (result: Scan) {
    if st.done || st.end >= text.len { return st; }
    let a: u64 = source.byte_at<N>(text, st.end);
    if block {
        let b: u64 = source.byte_at<N>(text, st.end + 1);
        if a == 47 && b == 42 { return Scan { ..st, end: st.end + 2, depth: st.depth + 1 }; }
        if a == 42 && b == 47 { return Scan { ..st, end: st.end + 2, depth: st.depth - 1, done: st.depth == 1 }; }
        return Scan { ..st, end: st.end + 1 };
    }
    if line {
        let advance: bool = a != 10;
        return Scan { ..st, end: st.end + select(advance, 1, 0), done: !advance };
    }
    if word {
        let advance: bool = letter(a) || digit(a);
        return Scan { ..st, end: st.end + select(advance, 1, 0), done: !advance };
    }
    if ws {
        let advance: bool = space(a);
        return Scan { ..st, end: st.end + select(advance, 1, 0), done: !advance };
    }
    // Preserve Stage-0's unusual continuation of dots after the first version dot.
    if number {
        let b: u64 = source.byte_at<N>(text, st.end + 1);
        let dot: bool = a == 46 && (st.dotted || digit(b));
        let advance: bool = digit(a) || dot;
        return Scan { ..st, end: st.end + select(advance, 1, 0), dotted: st.dotted || dot, done: !advance };
    }
    return Scan { ..st, done: true };
}

// Significant-token request; lexical failure is never discarded as trivia.
fn significant<N: Nat>(text: [byte; up_to N], start: u64) -> (result: Token) {
    let first: Token = next_token<N>(text, start);
    if !(is_trivia(first)) { return first; }
    let second: Token = skip_trivia<N>(text, first);
    if !(is_trivia(second)) { return second; }
    iterate i over text[second.start..text.len] carrying token: Token = second {
        if !(is_trivia(token)) { return token; }
        next token = skip_trivia<N>(text, token);
    }
    return token;
}
fn is_trivia(token: Token) -> (result: bool) {
    return token.kind >= 1 && token.kind <= 3 && token.diagnostic == 0;
}
fn skip_trivia<N: Nat>(text: [byte; up_to N], token: Token) -> (result: Token) {
    if is_trivia(token) { return next_token<N>(text, token.end); }
    return token;
}

// Logical-source lexer (CP-0001): the same token rules over global offsets
// into a validated page composition. Scans continue across page boundaries
// transparently; spans are global and stride-stable. Diagnostics extend the
// single-view vocabulary: 5 marks a significant token that outruns the
// 8192-step per-call scan budget (word/number content past the budget is an
// honest bounded-lexer refusal, never a silent split), and 6 marks a trivia
// prefix whose remainder continues at its end (whitespace and comments may
// span pages arbitrarily; the host continues scanning trivia past them).
fn keyword_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: u64) {
    let length: u64 = end - start;
    // Keyword bytes usually stay inside the page where the word began. Read
    // that page directly so every character comparison does not transport
    // the full project page table through byte_at_global.
    if stride > 0 && start < end && end <= total {
        let address: source.GlobalPageAddress = source.global_page_address(stride, total, start);
        if address.page < pages.len {
            let page: [byte; up_to N] = pages[address.page];
            if address.intra < stride && address.intra < page.len {
                if length <= stride - address.intra && length <= page.len - address.intra {
                    return keyword<N>(page, address.intra, address.intra + length);
                }
            }
        }
    }
    if length == 4 {
        let b0: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 0);
        let b1: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 1);
        let b2: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 2);
        let b3: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 3);

        if b0 == 109 && b1 == 110 && b2 == 99 && b3 == 115 { return 10; }
        if b0 == 101 && b1 == 108 && b2 == 115 && b3 == 101 { return 16; }
        if b0 == 102 && b1 == 97 && b2 == 105 && b3 == 108 { return 17; }
        if b0 == 101 && b1 == 110 && b2 == 117 && b3 == 109 { return 27; }
        if b0 == 110 && b1 == 101 && b2 == 120 && b3 == 116 { return 34; }
        if b0 == 111 && b1 == 118 && b2 == 101 && b3 == 114 { return 35; }
        if b0 == 116 && b1 == 114 && b2 == 117 && b3 == 101 { return 38; }
    }
    if length == 6 {
        let b0: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 0);
        let b1: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 1);
        let b2: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 2);
        let b3: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 3);
        let b4: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 4);
        let b5: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 5);

        if b0 == 109 && b1 == 111 && b2 == 100 && b3 == 117 && b4 == 108 && b5 == 101 { return 11; }
        if b0 == 114 && b1 == 101 && b2 == 116 && b3 == 117 && b4 == 114 && b5 == 110 { return 13; }
        if b0 == 101 && b1 == 102 && b2 == 102 && b3 == 101 && b4 == 99 && b5 == 116 { return 24; }
        if b0 == 114 && b1 == 101 && b2 == 99 && b3 == 111 && b4 == 114 && b5 == 100 { return 29; }
    }
    if length == 2 {
        let b0: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 0);
        let b1: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 1);

        if b0 == 102 && b1 == 110 { return 12; }
        if b0 == 105 && b1 == 102 { return 15; }
        if b0 == 97 && b1 == 115 { return 36; }
    }
    if length == 3 {
        let b0: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 0);
        let b1: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 1);
        let b2: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 2);

        if b0 == 108 && b1 == 101 && b2 == 116 { return 14; }
        if b0 == 117 && b1 == 115 && b2 == 101 { return 28; }
    }
    if length == 8 {
        let b0: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 0);
        let b1: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 1);
        let b2: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 2);
        let b3: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 3);
        let b4: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 4);
        let b5: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 5);
        let b6: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 6);
        let b7: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 7);

        if b0 == 114 && b1 == 101 && b2 == 113 && b3 == 117 && b4 == 105 && b5 == 114 && b6 == 101 && b7 == 115 { return 18; }
        if b0 == 112 && b1 == 114 && b2 == 111 && b3 == 112 && b4 == 101 && b5 == 114 && b6 == 116 && b7 == 121 { return 21; }
        if b0 == 99 && b1 == 97 && b2 == 114 && b3 == 114 && b4 == 121 && b5 == 105 && b6 == 110 && b7 == 103 { return 33; }
    }
    if length == 7 {
        let b0: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 0);
        let b1: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 1);
        let b2: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 2);
        let b3: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 3);
        let b4: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 4);
        let b5: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 5);
        let b6: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 6);

        if b0 == 101 && b1 == 110 && b2 == 115 && b3 == 117 && b4 == 114 && b5 == 101 && b6 == 115 { return 19; }
        if b0 == 97 && b1 == 115 && b2 == 115 && b3 == 117 && b4 == 109 && b5 == 101 && b6 == 115 { return 20; }
        if b0 == 105 && b1 == 116 && b2 == 101 && b3 == 114 && b4 == 97 && b5 == 116 && b6 == 101 { return 31; }
    }
    if length == 9 {
        let b0: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 0);
        let b1: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 1);
        let b2: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 2);
        let b3: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 3);
        let b4: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 4);
        let b5: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 5);
        let b6: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 6);
        let b7: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 7);
        let b8: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 8);

        if b0 == 105 && b1 == 110 && b2 == 118 && b3 == 97 && b4 == 114 && b5 == 105 && b6 == 97 && b7 == 110 && b8 == 116 { return 22; }
    }
    if length == 11 {
        let b0: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 0);
        let b1: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 1);
        let b2: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 2);
        let b3: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 3);
        let b4: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 4);
        let b5: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 5);
        let b6: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 6);
        let b7: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 7);
        let b8: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 8);
        let b9: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 9);
        let b10: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 10);

        if b0 == 109 && b1 == 101 && b2 == 116 && b3 == 97 && b4 == 109 && b5 == 111 && b6 == 114 && b7 == 112 && b8 == 104 && b9 == 105 && b10 == 99 { return 23; }
    }
    if length == 10 {
        let b0: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 0);
        let b1: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 1);
        let b2: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 2);
        let b3: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 3);
        let b4: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 4);
        let b5: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 5);
        let b6: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 6);
        let b7: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 7);
        let b8: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 8);
        let b9: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 9);

        if b0 == 99 && b1 == 97 && b2 == 112 && b3 == 97 && b4 == 98 && b5 == 105 && b6 == 108 && b7 == 105 && b8 == 116 && b9 == 121 { return 25; }
    }
    if length == 13 {
        let b0: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 0);
        let b1: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 1);
        let b2: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 2);
        let b3: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 3);
        let b4: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 4);
        let b5: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 5);
        let b6: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 6);
        let b7: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 7);
        let b8: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 8);
        let b9: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 9);
        let b10: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 10);
        let b11: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 11);
        let b12: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 12);

        if b0 == 97 && b1 == 117 && b2 == 116 && b3 == 104 && b4 == 111 && b5 == 114 && b6 == 105 && b7 == 122 && b8 == 101 && b9 == 100 && b10 == 95 && b11 == 98 && b12 == 121 { return 26; }
    }
    if length == 5 {
        let b0: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 0);
        let b1: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 1);
        let b2: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 2);
        let b3: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 3);
        let b4: u64 = source.byte_at_global<P, N>(pages, stride, total, start + 4);

        if b0 == 109 && b1 == 97 && b2 == 116 && b3 == 99 && b4 == 104 { return 30; }
        if b0 == 117 && b1 == 112 && b2 == 95 && b3 == 116 && b4 == 111 { return 32; }
        if b0 == 119 && b1 == 104 && b2 == 105 && b3 == 108 && b4 == 101 { return 37; }
        if b0 == 102 && b1 == 97 && b2 == 108 && b3 == 115 && b4 == 101 { return 39; }
    }
    return 4;
}

fn token_from_word_scan_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, st: Scan) -> (result: Token) {
    let kind: u64 = keyword_global<P, N>(pages, stride, total, start, st.end);
    return Token { kind: kind, start: start, end: st.end, diagnostic: 0 };
}
fn token_from_nonword_scan(start: u64, st: Scan, line: bool, block: bool, ws: bool) -> (result: Token) {
    let diagnostic: u64 = select(block && st.depth > 0, 1, 0);
    if ws { return Token { kind: 1, start: start, end: st.end, diagnostic: diagnostic }; }
    if line { return Token { kind: 2, start: start, end: st.end, diagnostic: diagnostic }; }
    if block { return Token { kind: 3, start: start, end: st.end, diagnostic: diagnostic }; }
    return Token { kind: select(st.dotted, 6, 5), start: start, end: st.end, diagnostic: diagnostic };
}

fn scan_chunk_window(total: u64, window: source.ByteWindow4, st: Scan, line: bool, block: bool, word: bool, number: bool, ws: bool) -> (result: Scan) {
    let a0: u64 = window.b0;
    if block {
        let b0: u64 = window.b1;
        let open0: bool = a0 == 47 && b0 == 42;
        let close0: bool = a0 == 42 && b0 == 47;
        let end1: u64 = st.end + select(open0 || close0, 2, 1);
        let depth1: u64 = st.depth + select(open0, 1, 0) - select(close0, 1, 0);
        let first: Scan = Scan { ..st, end: end1, depth: depth1 };
        if close0 && st.depth == 1 { return Scan { ..first, done: true }; }
        if end1 >= total { return first; }
        let a1: u64 = select(open0 || close0, window.b2, b0);
        let b1: u64 = select(open0 || close0, window.b3, window.b2);
        let open1: bool = a1 == 47 && b1 == 42;
        let close1: bool = a1 == 42 && b1 == 47;
        let end2: u64 = end1 + select(open1 || close1, 2, 1);
        let depth2: u64 = depth1 + select(open1, 1, 0) - select(close1, 1, 0);
        let second: Scan = Scan { ..first, end: end2, depth: depth2 };
        if close1 && depth1 == 1 { return Scan { ..second, done: true }; }
        return second;
    }
    if line {
        if a0 == 10 { return Scan { ..st, done: true }; }
        let end1: u64 = st.end + 1;
        if end1 >= total { return Scan { ..st, end: end1 }; }
        let a1: u64 = window.b1;
        if a1 == 10 { return Scan { ..st, end: end1, done: true }; }
        let end2: u64 = st.end + 2;
        if end2 >= total { return Scan { ..st, end: end2 }; }
        let a2: u64 = window.b2;
        if a2 == 10 { return Scan { ..st, end: end2, done: true }; }
        let end3: u64 = st.end + 3;
        if end3 >= total { return Scan { ..st, end: end3 }; }
        let a3: u64 = window.b3;
        if a3 == 10 { return Scan { ..st, end: end3, done: true }; }
        return Scan { ..st, end: end3 + 1 };
    }
    if word {
        if !(letter(a0) || digit(a0)) { return Scan { ..st, done: true }; }
        let end1: u64 = st.end + 1;
        if end1 >= total { return Scan { ..st, end: end1 }; }
        let a1: u64 = window.b1;
        if !(letter(a1) || digit(a1)) { return Scan { ..st, end: end1, done: true }; }
        let end2: u64 = st.end + 2;
        if end2 >= total { return Scan { ..st, end: end2 }; }
        let a2: u64 = window.b2;
        if !(letter(a2) || digit(a2)) { return Scan { ..st, end: end2, done: true }; }
        let end3: u64 = st.end + 3;
        if end3 >= total { return Scan { ..st, end: end3 }; }
        let a3: u64 = window.b3;
        if !(letter(a3) || digit(a3)) { return Scan { ..st, end: end3, done: true }; }
        return Scan { ..st, end: end3 + 1 };
    }
    if ws {
        if !space(a0) { return Scan { ..st, done: true }; }
        let end1: u64 = st.end + 1;
        if end1 >= total { return Scan { ..st, end: end1 }; }
        let a1: u64 = window.b1;
        if !space(a1) { return Scan { ..st, end: end1, done: true }; }
        let end2: u64 = st.end + 2;
        if end2 >= total { return Scan { ..st, end: end2 }; }
        let a2: u64 = window.b2;
        if !space(a2) { return Scan { ..st, end: end2, done: true }; }
        let end3: u64 = st.end + 3;
        if end3 >= total { return Scan { ..st, end: end3 }; }
        let a3: u64 = window.b3;
        if !space(a3) { return Scan { ..st, end: end3, done: true }; }
        return Scan { ..st, end: end3 + 1 };
    }
    if number {
        let b0: u64 = window.b1;
        let dot0: bool = a0 == 46 && (st.dotted || digit(b0));
        let advance0: bool = digit(a0) || dot0;
        if !advance0 { return Scan { ..st, done: true }; }
        let end1: u64 = st.end + 1;
        let dotted1: bool = st.dotted || dot0;
        if end1 >= total { return Scan { ..st, end: end1, dotted: dotted1 }; }
        let a1: u64 = b0;
        let b1: u64 = window.b2;
        let dot1: bool = a1 == 46 && (dotted1 || digit(b1));
        let advance1: bool = digit(a1) || dot1;
        if !advance1 { return Scan { ..st, end: end1, dotted: dotted1, done: true }; }
        return Scan { ..st, end: end1 + 1, dotted: dotted1 || dot1 };
    }
    return Scan { ..st, done: true };
}

fn scan_chunk_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Scan, line: bool, block: bool, word: bool, number: bool, ws: bool) -> (result: Scan) {
    if st.done || st.end >= total { return st; }
    let window: source.ByteWindow4 = source.byte_window4_global<P, N>(pages, stride, total, st.end);
    return scan_chunk_window(total, window, st, line, block, word, number, ws);
}

fn next_token_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64) -> (result: Token) {
    if start > total { return Token { kind: 0, start: total, end: total, diagnostic: 4 }; }
    if start == total { return Token { kind: 0, start: start, end: start, diagnostic: 0 }; }
    // Resolve the first window from the selected page in this frame. Calling
    // byte_window4_global here once per token still transported the full page
    // table even after scan chunks had moved to page-local reads.
    if stride == 0 || pages.len == 0 {
        return Token { kind: 7, start: start, end: start + 1, diagnostic: 3 };
    }
    let initial_address: source.GlobalPageAddress = source.global_page_address(stride, total, start);
    if initial_address.page >= pages.len {
        return Token { kind: 7, start: start, end: start + 1, diagnostic: 3 };
    }
    let initial_page: [byte; up_to N] = pages[initial_address.page];
    if initial_address.intra >= initial_page.len {
        return Token { kind: 7, start: start, end: start + 1, diagnostic: 3 };
    }
    let initial_window: source.ByteWindow4 = match total - start >= 4 && stride - initial_address.intra >= 4 && initial_page.len - initial_address.intra >= 4 {
        true => source.ByteWindow4 { b0: initial_page[initial_address.intra + 0] as u64, b1: initial_page[initial_address.intra + 1] as u64, b2: initial_page[initial_address.intra + 2] as u64, b3: initial_page[initial_address.intra + 3] as u64 },
        false => source.byte_window4_global<P, N>(pages, stride, total, start)
    };
    let a: u64 = initial_window.b0;
    let b: u64 = initial_window.b1;
    if a >= 128 {
        let width: u64 = utf8_width(a);
        let remaining: u64 = total - start;
        return Token { kind: 7, start: start, end: start + select(width <= remaining, width, remaining), diagnostic: 3 };
    }
    let line: bool = a == 47 && b == 47;
    let block: bool = a == 47 && b == 42;
    let word: bool = letter(a);
    let number: bool = digit(a);
    let ws: bool = space(a);
    if line || block || word || number || ws {
        let seed: Scan = Scan { end: start + select(line || block, 2, 1), depth: select(block, 1, 0), dotted: false, done: false };
        // Keep each scan window in the current page when it fits. Passing the
        // entire page table to byte_window4_global for every chunk made frame
        // setup scale with the number of source pages; only page-edge and
        // malformed layouts need the total global fallback.
        iterate pass up_to 4 carrying outer: Scan = seed {
            iterate i up_to 1024 carrying inner: Scan = outer {
                if inner.done || inner.end >= total {
                    if word { return token_from_word_scan_global<P, N>(pages, stride, total, start, inner); }
                    return token_from_nonword_scan(start, inner, line, block, ws);
                }
                let address: source.GlobalPageAddress = source.global_page_address(stride, total, inner.end);
                // A scan can only enter this loop after the first byte was
                // resolved from a non-empty page table. Clamp an impossible
                // later page index to page zero; the guarded inline path uses
                // the total global reader for mismatches and page edges.
                let page_exists: bool = address.page < pages.len;
                let selected_page: u64 = select(page_exists, address.page, 0);
                let page: [byte; up_to N] = pages[selected_page];
                let window: source.ByteWindow4 = match page_exists {
                    true => match address.intra < page.len {
                        true => match total - inner.end >= 4 && stride - address.intra >= 4 && page.len - address.intra >= 4 {
                            true => source.ByteWindow4 { b0: page[address.intra + 0] as u64, b1: page[address.intra + 1] as u64, b2: page[address.intra + 2] as u64, b3: page[address.intra + 3] as u64 },
                            false => source.byte_window4_global<P, N>(pages, stride, total, inner.end)
                        },
                        false => source.byte_window4_global<P, N>(pages, stride, total, inner.end)
                    },
                    false => source.byte_window4_global<P, N>(pages, stride, total, inner.end)
                };
                let advanced: Scan = scan_chunk_window(total, window, inner, line, block, word, number, ws);
                if advanced.done || advanced.end >= total {
                    if word { return token_from_word_scan_global<P, N>(pages, stride, total, start, advanced); }
                    return token_from_nonword_scan(start, advanced, line, block, ws);
                }
                next inner = advanced;
            }
            if inner.done || inner.end >= total {
                if word { return token_from_word_scan_global<P, N>(pages, stride, total, start, inner); }
                return token_from_nonword_scan(start, inner, line, block, ws);
            }
            // Line, word, and whitespace chunks consume four bytes per
            // window, so their 8192-transition budget is two passes.
            if pass == 1 && (line || word || ws) {
                if line || ws {
                    return Token { kind: select(ws, 1, select(line, 2, 3)), start: start, end: inner.end, diagnostic: 6 };
                }
                return Token { kind: 7, start: start, end: inner.end, diagnostic: 5 };
            }
            // Number and block-comment chunks consume at most two bytes per
            // window and keep all four bounded passes (8192 transitions).
            if pass == 3 {
                if ws || line || block {
                    return Token { kind: select(ws, 1, select(line, 2, 3)), start: start, end: inner.end, diagnostic: 6 };
                }
                return Token { kind: 7, start: start, end: inner.end, diagnostic: 5 };
            }
            next outer = inner;
        }
        if word { return token_from_word_scan_global<P, N>(pages, stride, total, start, outer); }
        return token_from_nonword_scan(start, outer, line, block, ws);
    }
    let kind: u64 = punctuation(a, b);
    return Token { kind: kind, start: start, end: start + select(kind >= 80, 2, 1), diagnostic: select(kind == 7, 2, 0) };
}

// Significant-token request over global offsets; trivia prefixes (6) skip
// exactly like clean trivia, while lexical failures never do.
fn significant_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64) -> (result: Token) {
    let first: Token = next_token_global<P, N>(pages, stride, total, start);
    if !(is_trivia_cont(first)) { return first; }
    let second: Token = next_token_global<P, N>(pages, stride, total, first.end);
    if !(is_trivia_cont(second)) { return second; }
    iterate i up_to 1024 carrying token: Token = second {
        if !(is_trivia_cont(token)) { return token; }
        next token = next_token_global<P, N>(pages, stride, total, token.end);
    }
    iterate i up_to 1024 carrying token2: Token = token {
        if !(is_trivia_cont(token2)) { return token2; }
        next token2 = next_token_global<P, N>(pages, stride, total, token2.end);
    }
    return token2;
}
fn is_trivia_cont(token: Token) -> (result: bool) {
    return token.kind >= 1 && token.kind <= 3 && (token.diagnostic == 0 || token.diagnostic == 6);
}
fn skip_trivia_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, token: Token) -> (result: Token) {
    if is_trivia_cont(token) { return next_token_global<P, N>(pages, stride, total, token.end); }
    return token;
}

// Bounded batch traversal: up to 1024 tiling tokens from a global cursor.
// The host pages this call to walk sources no single call may span; every
// boundary and kind decision stays in MNCS. The batch stops at EOF, at an
// invalid cursor, or at an overlong significant token (diagnostic 5); the
// cursor always advances past the last returned token.
enum TokenList { TNil, TCons { head: Token, tail: TokenList } }
record BatchState { cursor: u64, tokens: TokenList, count: u64, done: bool, eof: bool }
record BatchResult { tokens: TokenList, next: u64, eof: bool, count: u64 }
fn lex_tokens_from<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64) -> (result: BatchResult) {
    let seed: BatchState = BatchState { cursor: start, tokens: TokenList.TNil, count: 0, done: false, eof: false };
    iterate i up_to 1024 carrying st: BatchState = seed {
        next st = batch_step<P, N>(pages, stride, total, st);
    }
    return BatchResult { tokens: reverse_tokens(st.tokens), next: st.cursor, eof: st.eof, count: st.count };
}
fn batch_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BatchState) -> (result: BatchState) {
    if st.done { return st; }
    let token: Token = next_token_global<P, N>(pages, stride, total, st.cursor);
    let tokens: TokenList = TokenList.TCons { head: token, tail: st.tokens };
    let count: u64 = st.count + 1;
    if token.kind == 0 { return BatchState { cursor: token.end, tokens: tokens, count: count, done: true, eof: token.diagnostic == 0 }; }
    if token.diagnostic == 5 { return BatchState { cursor: token.end, tokens: tokens, count: count, done: true, eof: false }; }
    return BatchState { cursor: token.end, tokens: tokens, count: count, done: false, eof: false };
}
record TokenReverse { rest: TokenList, acc: TokenList }
fn reverse_tokens(tokens: TokenList) -> (result: TokenList) {
    iterate i up_to 1024 carrying st: TokenReverse = TokenReverse { rest: tokens, acc: TokenList.TNil } {
        next st = reverse_token_step(st);
    }
    return st.acc;
}
fn reverse_token_step(st: TokenReverse) -> (result: TokenReverse) {
    return match st.rest {
        TNil => st,
        TCons { head: h, tail: t } => TokenReverse { rest: t, acc: TokenList.TCons { head: h, tail: st.acc } }
    };
}
