mncs 0.19;
module mncs.compiler.vm_emit.v1;
use mncs.compiler.decl.v1 as decl;
use mncs.compiler.lexer.v1 as lexer;
use mncs.compiler.parser.v1 as parser;
use mncs.compiler.project.v1 as project;
use mncs.compiler.source.v1 as source;
use mncs.compiler.ssa.v1 as ssa;

// Bounded native VM emission from verified Value SSA (`mncs.compiler.ssa.v1`)
// and multi-module Project SSA (`mncs.compiler.project.v1`).
//
// Owns concrete Nat specialization, bounded byte-view and nominal record type
// resolution, closure selection, executable VM lowering, and whole-closure
// signature/CFG verification 100% in MNCS. Unverified SSA, unresolved symbolic
// bounds, mismatched specializations, or unsupported constructs fail closed
// with a deterministic error code and anchor.

// Concrete VM type:
//  kind 1 = bool
//  kind 2 = byte
//  kind 3 = integer (bits: 8|16|32|64, signed)
//  kind 4 = bounded scalar sequence (bits: 0=byte, 1=bool, 8|16|32|64=integer; signed; bound_kind: 1=exact, 2=up_to; bound_value > 0)
//  kind 5 = nominal record (nominal_identity)
//  kind 6 = nested bounded scalar sequence ([[T; inner_bound]; outer_bound]:
//            bits/signed = inner scalar element type (0=byte, 1=bool, 8|16|32|64=integer),
//            inner_bound_kind: 1=exact/2=up_to, inner_bound_value > 0,
//            bound_kind: 1=exact/2=up_to, bound_value > 0)
//  kind 7 = nominal finite enum (nominal_identity)
record VmType {
    kind: u64,
    bits: u64,
    signed: bool,
    bound_kind: u64,
    bound_value: u64,
    inner_bound_kind: u64,
    inner_bound_value: u64,
    nominal_identity: decl.SemanticIdentity,
    valid: bool
}
record VmValue { id: u64, ty: VmType }
enum VmValueList { VVNil, VVCons { head: VmValue, tail: VmValueList } }
record VmValueRev { rest: VmValueList, acc: VmValueList }

record VmNatArg { value: u64 }
enum VmNatArgList { NANil, NACons { head: VmNatArg, tail: VmNatArgList } }
record VmNatArgRev { rest: VmNatArgList, acc: VmNatArgList }
record VmSpecKey { identity: decl.SemanticIdentity, nat_args: VmNatArgList }

enum VmNameList { VNNil, VNCons { head: decl.SemanticIdentity, tail: VmNameList } }
record VmNameRev { rest: VmNameList, acc: VmNameList }

record VmRecordField { name: decl.SemanticIdentity, ty: VmType }
enum VmRecordFieldList { VRFNil, VRFCons { head: VmRecordField, tail: VmRecordFieldList } }
record VmRecordFieldRev { rest: VmRecordFieldList, acc: VmRecordFieldList }
record VmRecordType { identity: decl.SemanticIdentity, name: decl.SemanticIdentity, fields: VmRecordFieldList }
enum VmRecordTypeList { VRTNil, VRTCons { head: VmRecordType, tail: VmRecordTypeList } }
record VmRecordTypeRev { rest: VmRecordTypeList, acc: VmRecordTypeList }

record VmFiniteVariant {
    identity: decl.SemanticIdentity,
    name: decl.SemanticIdentity,
    discriminant: u64,
    fields: VmRecordFieldList
}
enum VmFiniteVariantList { VFVNil, VFVCons { head: VmFiniteVariant, tail: VmFiniteVariantList } }
record VmFiniteVariantRev { rest: VmFiniteVariantList, acc: VmFiniteVariantList }
record VmFiniteType {
    identity: decl.SemanticIdentity,
    name: decl.SemanticIdentity,
    variants: VmFiniteVariantList
}
enum VmFiniteTypeList { VFTNil, VFTCons { head: VmFiniteType, tail: VmFiniteTypeList } }
record VmFiniteTypeRev { rest: VmFiniteTypeList, acc: VmFiniteTypeList }
record VmSchemas { records: VmRecordTypeList, finites: VmFiniteTypeList }

// VM instruction opcodes produced by this native emitter:
//  1 = Constant (integer/byte in imm_u64)
//  2 = ConstantBool (imm_bool)
//  3 = Integer (op_code 1..10, intent 1=checked/2=wrapping/3=saturating, from_ty = operand_type)
//  4 = IntegerCompare (op_code 1..6, from_ty = operand_type)
//  5 = ByteCompare (op_code 1..6)
//  6 = ByteBitwise (op_code 6=and/7=or/8=xor)
//  7 = ByteShift (op_code 9=shl/10=shr)
//  8 = BooleanOp (op_code 11=and/12=or)
//  9 = BooleanCompare (op_code 1=eq/2=ne)
// 10 = BooleanNot
// 11 = Convert (from_ty -> ty)
// 12 = Select (ty)
// 13 = Call (callee_identity + callee_nat_args)
// 14 = SequenceLength (from_ty = concrete byte sequence type)
// 15 = SequenceProject (from_ty = concrete byte sequence type)
// 16 = RecordConstruct (ty = record VmType, field_names = source-order field names)
// 17 = ViewConstruct (from_ty = source sequence VmType, ty = UpTo view VmType)
// 18 = RecordProject (from_ty = nominal record VmType, ty = field VmType, op_code = field_index, field_names = [field_name])
// 19 = SequenceConstruct (ty = exact scalar sequence VmType, from_ty = scalar element VmType, inputs = element value ids)
// 20 = FiniteConstruct (ty = finite VmType, callee_identity = variant_identity, op_code = discriminant, field_names = payload field names, inputs = payload value ids)
// 21 = FinitePayloadProject (from_ty = finite VmType, ty = field VmType, callee_identity = variant_identity, op_code = discriminant, field_names = [field_name], inputs = [subject])
// 22 = FiniteIsVariant (from_ty = finite VmType, ty = bool, callee_identity = variant_identity, op_code = discriminant, inputs = [subject])
record VmInstruction {
    id: u64,
    result: u64,
    opcode: u64,
    op_code: u64,
    intent: u64,
    imm_u64: u64,
    imm_bool: bool,
    ty: VmType,
    from_ty: VmType,
    inputs: ssa.IdList,
    callee_identity: decl.SemanticIdentity,
    callee_nat_args: VmNatArgList,
    field_names: VmNameList
}
enum VmInstructionList { VINil, VICons { head: VmInstruction, tail: VmInstructionList } }
record VmInstructionRev { rest: VmInstructionList, acc: VmInstructionList }

enum VmTerminator {
    VmReturn { value: u64 },
    VmBranch { target: u64, arguments: ssa.IdList },
    VmCondBranch { condition: u64, then_target: u64, then_arguments: ssa.IdList, else_target: u64, else_arguments: ssa.IdList },
    VmFailure
}

record VmBlock {
    id: u64,
    is_error_path: bool,
    parameters: VmValueList,
    instructions: VmInstructionList,
    terminator: VmTerminator,
    has_failure_target: bool,
    failure_target: u64
}
enum VmBlockList { VBNil, VBCons { head: VmBlock, tail: VmBlockList } }
record VmBlockRev { rest: VmBlockList, acc: VmBlockList }

// Bounded iteration metadata lowered from SSA loop blocks & resolved bounds:
//  domain_kind 1 = attempts (up_to N), domain_kind 2 = over_sequence
record VmBoundedIteration {
    header_block: u64,
    preheader_block: u64,
    body_entry_block: u64,
    backedge_block: u64,
    exit_block: u64,
    domain_kind: u64,
    bound: u64,
    sequence_bound: VmType,
    state_type: VmType,
    body_blocks: ssa.IdList
}
enum VmBoundedIterationList { VBINil, VBICons { head: VmBoundedIteration, tail: VmBoundedIterationList } }
record VmBoundedIterRev { rest: VmBoundedIterationList, acc: VmBoundedIterationList }

record VmFunction {
    identity: decl.SemanticIdentity,
    nat_args: VmNatArgList,
    inputs: VmValueList,
    result_type: VmType,
    blocks: VmBlockList,
    bounded_iterations: VmBoundedIterationList,
    block_count: u64,
    instruction_count: u64
}
enum VmFunctionList { VFNil, VFCons { head: VmFunction, tail: VmFunctionList } }
record VmFunctionRev { rest: VmFunctionList, acc: VmFunctionList }

// error_code:
//  0 = ok
//  1 = unverified or empty ValueSsaSummary / ProjectResult
//  2 = unverified/unsupported function or invalid function identity
//  3 = unsupported effect or capability on instruction
//  4 = unsupported or unresolved type / missing record schema
//  5 = unsupported instruction kind or operator
//  6 = unsupported terminator
//  7 = unresolved operand value or invalid operand/CFG arity or type
//  8 = invalid module header span
//  9 = missing callee in reachable closure
// 10 = callee signature (arity / argument type / result type / bound) mismatch
// 11 = unresolved, malformed, or mismatched generic specialization
// Structured emitter failure facts populated on refusal (empty on success).
// phase:
//   0 = none
//   1 = project_proof_or_ssa
//   2 = module_header_or_ssa_verify
//   3 = target_callable_selection
//   4 = specialization_nat_binding
//   5 = signature_type_lowering
//   6 = sequence_type_propagation
//   7 = block_param_type_lowering
//   8 = instruction_lowering
//   9 = terminator_lowering
//  10 = bounded_iteration_lowering
//  11 = cfg_type_verification
//  12 = provider_materialization
//  13 = closure_call_verification
//
// type_kind (expected / observed):
//   0 = unknown / none
//   1 = bool
//   2 = byte
//   3 = integer
//   4 = scalar_sequence
//   5 = nominal_record
//   6 = nested_scalar_sequence
//   7 = nominal_finite_enum
//   8 = supported_vm_type
record VmEmitFailureDetail {
    callable: decl.SemanticIdentity,
    phase: u64,
    ssa_kind: u64,
    expected_type_kind: u64,
    observed_type_kind: u64,
    observed_nominal: decl.SemanticIdentity,
    source_start: u64,
    source_end: u64
}

record VmEmitResult {
    ok: bool,
    error_code: u64,
    error_function: u64,
    error_block: u64,
    error_instruction: u64,
    error_detail: VmEmitFailureDetail,
    module_name_start: u64,
    module_name_end: u64,
    record_types: VmRecordTypeList,
    record_type_count: u64,
    finite_types: VmFiniteTypeList,
    finite_type_count: u64,
    functions: VmFunctionList,
    function_count: u64,
    block_count: u64,
    instruction_count: u64
}

// ---------------------------------------------------------------------------
// Type constructors, predicates, and list utilities
// ---------------------------------------------------------------------------

fn invalid_vm_type() -> (result: VmType) {
    return VmType { kind: 0, bits: 0, signed: false, bound_kind: 0, bound_value: 0, inner_bound_kind: 0, inner_bound_value: 0, nominal_identity: decl.invalid_semantic_identity(), valid: false };
}
fn bool_vm_type() -> (result: VmType) {
    return VmType { kind: 1, bits: 1, signed: false, bound_kind: 0, bound_value: 0, inner_bound_kind: 0, inner_bound_value: 0, nominal_identity: decl.invalid_semantic_identity(), valid: true };
}
fn byte_vm_type() -> (result: VmType) {
    return VmType { kind: 2, bits: 8, signed: false, bound_kind: 0, bound_value: 0, inner_bound_kind: 0, inner_bound_value: 0, nominal_identity: decl.invalid_semantic_identity(), valid: true };
}
fn int_vm_type(width: u64, signed: bool) -> (result: VmType) {
    let ok: bool = width == 8 || width == 16 || width == 32 || width == 64;
    if !(ok) { return invalid_vm_type(); }
    return VmType { kind: 3, bits: width, signed: signed, bound_kind: 0, bound_value: 0, inner_bound_kind: 0, inner_bound_value: 0, nominal_identity: decl.invalid_semantic_identity(), valid: true };
}
fn u64_vm_type() -> (result: VmType) {
    return int_vm_type(64, false);
}
fn scalar_seq_vm_type(elem: VmType, bound_kind: u64, bound_value: u64) -> (result: VmType) {
    if !(elem.valid) || (bound_kind != 1 && bound_kind != 2) || bound_value == 0 || bound_value > 65536 {
        return invalid_vm_type();
    }
    if elem.kind == 2 {
        return VmType { kind: 4, bits: 0, signed: false, bound_kind: bound_kind, bound_value: bound_value, inner_bound_kind: 0, inner_bound_value: 0, nominal_identity: decl.invalid_semantic_identity(), valid: true };
    }
    if elem.kind == 1 {
        return VmType { kind: 4, bits: 1, signed: false, bound_kind: bound_kind, bound_value: bound_value, inner_bound_kind: 0, inner_bound_value: 0, nominal_identity: decl.invalid_semantic_identity(), valid: true };
    }
    if elem.kind == 3 {
        return VmType { kind: 4, bits: elem.bits, signed: elem.signed, bound_kind: bound_kind, bound_value: bound_value, inner_bound_kind: 0, inner_bound_value: 0, nominal_identity: decl.invalid_semantic_identity(), valid: true };
    }
    return invalid_vm_type();
}
fn byte_seq_vm_type(bound_kind: u64, bound_value: u64) -> (result: VmType) {
    return scalar_seq_vm_type(byte_vm_type(), bound_kind, bound_value);
}
fn nested_seq_vm_type(inner: VmType, outer_bound_kind: u64, outer_bound_value: u64) -> (result: VmType) {
    if !(inner.valid) || inner.kind != 4 || (inner.bound_kind != 1 && inner.bound_kind != 2) || inner.bound_value == 0 || inner.bound_value > 65536 {
        return invalid_vm_type();
    }
    if (outer_bound_kind != 1 && outer_bound_kind != 2) || outer_bound_value == 0 || outer_bound_value > 65536 {
        return invalid_vm_type();
    }
    return VmType {
        kind: 6, bits: inner.bits, signed: inner.signed,
        bound_kind: outer_bound_kind, bound_value: outer_bound_value,
        inner_bound_kind: inner.bound_kind, inner_bound_value: inner.bound_value,
        nominal_identity: decl.invalid_semantic_identity(), valid: true
    };
}
fn is_seq_vm_type(ty: VmType) -> (result: bool) {
    return ty.valid && (ty.kind == 4 || ty.kind == 6);
}
fn is_seq_sem_type(ty: decl.SemType) -> (result: bool) {
    return match ty {
        TBool => false,
        TByte => false,
        TInt { width: w, signed: s } => false,
        TNamed { start: a, end: b } => false,
        TSeq => true,
        TSeqExact { element: el, length: n, length_valid: v } => true,
        TPoison => false
    };
}
fn record_vm_type(nominal_identity: decl.SemanticIdentity) -> (result: VmType) {
    if !(nominal_identity.valid) || nominal_identity.len == 0 { return invalid_vm_type(); }
    return VmType { kind: 5, bits: 0, signed: false, bound_kind: 0, bound_value: 0, inner_bound_kind: 0, inner_bound_value: 0, nominal_identity: nominal_identity, valid: true };
}
fn finite_vm_type(nominal_identity: decl.SemanticIdentity) -> (result: VmType) {
    if !(nominal_identity.valid) || nominal_identity.len == 0 { return invalid_vm_type(); }
    return VmType { kind: 7, bits: 0, signed: false, bound_kind: 0, bound_value: 0, inner_bound_kind: 0, inner_bound_value: 0, nominal_identity: nominal_identity, valid: true };
}
// Prefix check for canonical `mncs:0.2:finite-type:...` vs `mncs:0.2:record-type:...`.
fn is_finite_nominal_identity(id: decl.SemanticIdentity) -> (result: bool) {
    return id.valid && id.len > 21 && id.bytes[9] == (102 as byte) && id.bytes[10] == (105 as byte) && id.bytes[15] == (45 as byte);
}
fn is_record_nominal_identity(id: decl.SemanticIdentity) -> (result: bool) {
    return id.valid && id.len > 21 && id.bytes[9] == (114 as byte) && id.bytes[10] == (101 as byte) && id.bytes[15] == (45 as byte);
}
fn sem_type_to_vm_scalar(ty: decl.SemType) -> (result: VmType) {
    return match ty {
        TBool => bool_vm_type(),
        TByte => byte_vm_type(),
        TInt { width: w, signed: s } => int_vm_type(w, s),
        TNamed { start: a, end: b } => invalid_vm_type(),
        TSeq => invalid_vm_type(),
        TSeqExact { element: el, length: n, length_valid: v } => invalid_vm_type(),
        TPoison => invalid_vm_type()
    };
}
fn semantic_ids_equal(a: decl.SemanticIdentity, b: decl.SemanticIdentity) -> (result: bool) {
    if !(a.valid) || !(b.valid) || a.len != b.len || a.len > 512 { return false; }
    iterate i up_to 512 carrying idx: u64 = 0 {
        if idx >= a.len { return true; }
        if a.bytes[idx] != b.bytes[idx] { return false; }
        next idx = idx + 1;
    }
    return true;
}
fn vm_type_equal(a: VmType, b: VmType) -> (result: bool) {
    if !(a.valid) || !(b.valid) || a.kind != b.kind { return false; }
    if a.kind == 3 { return a.bits == b.bits && a.signed == b.signed; }
    if a.kind == 4 { return a.bits == b.bits && a.signed == b.signed && a.bound_kind == b.bound_kind && a.bound_value == b.bound_value; }
    if a.kind == 5 { return semantic_ids_equal(a.nominal_identity, b.nominal_identity); }
    if a.kind == 7 { return semantic_ids_equal(a.nominal_identity, b.nominal_identity); }
    if a.kind == 6 {
        return a.bits == b.bits && a.signed == b.signed
            && a.bound_kind == b.bound_kind && a.bound_value == b.bound_value
            && a.inner_bound_kind == b.inner_bound_kind && a.inner_bound_value == b.inner_bound_value;
    }
    return true;
}
fn seq_element_vm_type(seq_ty: VmType) -> (result: VmType) {
    if !(seq_ty.valid) || seq_ty.bound_value == 0 { return invalid_vm_type(); }
    if seq_ty.kind == 4 {
        if seq_ty.bits == 0 { return byte_vm_type(); }
        if seq_ty.bits == 1 { return bool_vm_type(); }
        return int_vm_type(seq_ty.bits, seq_ty.signed);
    }
    if seq_ty.kind == 6 {
        if (seq_ty.inner_bound_kind != 1 && seq_ty.inner_bound_kind != 2) || seq_ty.inner_bound_value == 0 || seq_ty.inner_bound_value > 65536 {
            return invalid_vm_type();
        }
        return VmType {
            kind: 4, bits: seq_ty.bits, signed: seq_ty.signed,
            bound_kind: seq_ty.inner_bound_kind, bound_value: seq_ty.inner_bound_value,
            inner_bound_kind: 0, inner_bound_value: 0,
            nominal_identity: decl.invalid_semantic_identity(), valid: true
        };
    }
    return invalid_vm_type();
}
fn exact_scalar_seq_vm_type(elem: VmType, length: u64) -> (result: VmType) {
    return scalar_seq_vm_type(elem, 1, length);
}
fn is_u64_vm_type(ty: VmType) -> (result: bool) {
    return ty.valid && ty.kind == 3 && ty.bits == 64 && !(ty.signed);
}
fn is_scalar_vm_type(ty: VmType) -> (result: bool) {
    return ty.valid && (ty.kind == 1 || ty.kind == 2 || ty.kind == 3);
}

fn effects_empty(fx: decl.EffectIdentityList) -> (result: bool) {
    return match fx { decl.EffectIdentityList.EINil => true, decl.EffectIdentityList.EICons { head: h, tail: t } => false };
}
fn capabilities_empty(caps: decl.CapabilityIdentityList) -> (result: bool) {
    return match caps { decl.CapabilityIdentityList.CINil => true, decl.CapabilityIdentityList.CICons { head: h, tail: t } => false };
}
fn vm_value_list_empty(values: VmValueList) -> (result: bool) {
    return match values { VVNil => true, VVCons { head: h, tail: t } => false };
}
fn vm_inst_list_empty(insts: VmInstructionList) -> (result: bool) {
    return match insts { VINil => true, VICons { head: h, tail: t } => false };
}
fn vm_block_list_empty(blocks: VmBlockList) -> (result: bool) {
    return match blocks { VBNil => true, VBCons { head: h, tail: t } => false };
}
fn vm_fn_list_empty(fns: VmFunctionList) -> (result: bool) {
    return match fns { VFNil => true, VFCons { head: h, tail: t } => false };
}
fn vm_nat_list_empty(args: VmNatArgList) -> (result: bool) {
    return match args { NANil => true, NACons { head: h, tail: t } => false };
}
fn vm_name_list_empty(names: VmNameList) -> (result: bool) {
    return match names { VNNil => true, VNCons { head: h, tail: t } => false };
}
fn vm_record_field_list_empty(fields: VmRecordFieldList) -> (result: bool) {
    return match fields { VRFNil => true, VRFCons { head: h, tail: t } => false };
}
fn vm_record_type_list_empty(recs: VmRecordTypeList) -> (result: bool) {
    return match recs { VRTNil => true, VRTCons { head: h, tail: t } => false };
}
fn ssa_value_list_empty(values: ssa.ValueList) -> (result: bool) {
    return match values { ssa.ValueList.VNil => true, ssa.ValueList.VCons { head: h, tail: t } => false };
}
fn ssa_inst_list_empty(insts: ssa.InstructionList) -> (result: bool) {
    return match insts { ssa.InstructionList.QNil => true, ssa.InstructionList.QCons { head: h, tail: t } => false };
}
fn ssa_block_list_empty(blocks: ssa.SsaBlockList) -> (result: bool) {
    return match blocks { ssa.SsaBlockList.LNil => true, ssa.SsaBlockList.LCons { head: h, tail: t } => false };
}
fn id_list_empty(ids: ssa.IdList) -> (result: bool) {
    return match ids { ssa.IdList.INil => true, ssa.IdList.ICons { head: h, tail: t } => false };
}
fn decl_generic_list_empty(gs: decl.GenericParamList) -> (result: bool) {
    return match gs { decl.GenericParamList.GNil => true, decl.GenericParamList.GCons { head: h, tail: t } => false };
}
fn decl_field_list_empty(fs: decl.FieldList) -> (result: bool) {
    return match fs { decl.FieldList.FNil => true, decl.FieldList.FCons { head: h, tail: t } => false };
}
fn decl_fn_list_empty(fns: decl.FnList) -> (result: bool) {
    return match fns { decl.FnList.DNil => true, decl.FnList.DCons { head: h, tail: t } => false };
}
fn decl_record_list_empty(recs: decl.RecordList) -> (result: bool) {
    return match recs { decl.RecordList.RNil => true, decl.RecordList.RCons { head: h, tail: t } => false };
}
fn decl_targ_list_empty(targs: decl.TypeArgList) -> (result: bool) {
    return match targs { decl.TypeArgList.TNil => true, decl.TypeArgList.TCons { head: h, tail: t } => false };
}
fn decl_bind_list_empty(binds: decl.BindList) -> (result: bool) {
    return match binds { decl.BindList.BNil => true, decl.BindList.BCons { head: h, tail: t } => false };
}
fn ssa_env_empty(env: ssa.Environment) -> (result: bool) {
    return match env { ssa.Environment.EnvNil => true, ssa.Environment.EnvCons { head: h, tail: t } => false };
}

fn reverse_vm_values(values: VmValueList) -> (result: VmValueList) {
    iterate i up_to 1024 carrying st: VmValueRev = VmValueRev { rest: values, acc: VmValueList.VVNil } {
        if vm_value_list_empty(st.rest) { return st.acc; }
        next st = reverse_vm_value_step(st);
    }
    return st.acc;
}
fn reverse_vm_value_step(st: VmValueRev) -> (result: VmValueRev) {
    return match st.rest {
        VVNil => st,
        VVCons { head: h, tail: t } => VmValueRev { rest: t, acc: VmValueList.VVCons { head: h, tail: st.acc } }
    };
}
fn reverse_vm_nat_args(args: VmNatArgList) -> (result: VmNatArgList) {
    iterate i up_to 64 carrying st: VmNatArgRev = VmNatArgRev { rest: args, acc: VmNatArgList.NANil } {
        if vm_nat_list_empty(st.rest) { return st.acc; }
        next st = reverse_vm_nat_arg_step(st);
    }
    return st.acc;
}
fn reverse_vm_nat_arg_step(st: VmNatArgRev) -> (result: VmNatArgRev) {
    return match st.rest {
        NANil => st,
        NACons { head: h, tail: t } => VmNatArgRev { rest: t, acc: VmNatArgList.NACons { head: h, tail: st.acc } }
    };
}
fn reverse_vm_names(names: VmNameList) -> (result: VmNameList) {
    iterate i up_to 128 carrying st: VmNameRev = VmNameRev { rest: names, acc: VmNameList.VNNil } {
        if vm_name_list_empty(st.rest) { return st.acc; }
        next st = reverse_vm_name_step(st);
    }
    return st.acc;
}
fn reverse_vm_name_step(st: VmNameRev) -> (result: VmNameRev) {
    return match st.rest {
        VNNil => st,
        VNCons { head: h, tail: t } => VmNameRev { rest: t, acc: VmNameList.VNCons { head: h, tail: st.acc } }
    };
}
fn reverse_vm_record_fields(fields: VmRecordFieldList) -> (result: VmRecordFieldList) {
    iterate i up_to 128 carrying st: VmRecordFieldRev = VmRecordFieldRev { rest: fields, acc: VmRecordFieldList.VRFNil } {
        if vm_record_field_list_empty(st.rest) { return st.acc; }
        next st = reverse_vm_record_field_step(st);
    }
    return st.acc;
}
fn reverse_vm_record_field_step(st: VmRecordFieldRev) -> (result: VmRecordFieldRev) {
    return match st.rest {
        VRFNil => st,
        VRFCons { head: h, tail: t } => VmRecordFieldRev { rest: t, acc: VmRecordFieldList.VRFCons { head: h, tail: st.acc } }
    };
}
// The working catalog can contain the full project nominal marker envelope.
// Only schemas referenced by the emitted closure go into the artifact.
fn reverse_vm_record_types(recs: VmRecordTypeList) -> (result: VmRecordTypeList) {
    iterate i up_to 1024 carrying st: VmRecordTypeRev = VmRecordTypeRev { rest: recs, acc: VmRecordTypeList.VRTNil } {
        if vm_record_type_list_empty(st.rest) { return st.acc; }
        next st = reverse_vm_record_type_step(st);
    }
    return st.acc;
}
fn reverse_vm_record_type_step(st: VmRecordTypeRev) -> (result: VmRecordTypeRev) {
    return match st.rest {
        VRTNil => st,
        VRTCons { head: h, tail: t } => VmRecordTypeRev { rest: t, acc: VmRecordTypeList.VRTCons { head: h, tail: st.acc } }
    };
}
fn reverse_vm_insts(insts: VmInstructionList) -> (result: VmInstructionList) {
    iterate i up_to 1024 carrying st: VmInstructionRev = VmInstructionRev { rest: insts, acc: VmInstructionList.VINil } {
        if vm_inst_list_empty(st.rest) { return st.acc; }
        next st = reverse_vm_inst_step(st);
    }
    return st.acc;
}
fn reverse_vm_inst_step(st: VmInstructionRev) -> (result: VmInstructionRev) {
    return match st.rest {
        VINil => st,
        VICons { head: h, tail: t } => VmInstructionRev { rest: t, acc: VmInstructionList.VICons { head: h, tail: st.acc } }
    };
}
fn reverse_vm_blocks(blocks: VmBlockList) -> (result: VmBlockList) {
    iterate i up_to 1024 carrying st: VmBlockRev = VmBlockRev { rest: blocks, acc: VmBlockList.VBNil } {
        if vm_block_list_empty(st.rest) { return st.acc; }
        next st = reverse_vm_block_step(st);
    }
    return st.acc;
}
fn reverse_vm_block_step(st: VmBlockRev) -> (result: VmBlockRev) {
    return match st.rest {
        VBNil => st,
        VBCons { head: h, tail: t } => VmBlockRev { rest: t, acc: VmBlockList.VBCons { head: h, tail: st.acc } }
    };
}
fn reverse_vm_fns(fns: VmFunctionList) -> (result: VmFunctionList) {
    iterate i up_to 1024 carrying st: VmFunctionRev = VmFunctionRev { rest: fns, acc: VmFunctionList.VFNil } {
        if vm_fn_list_empty(st.rest) { return st.acc; }
        next st = reverse_vm_fn_step(st);
    }
    return st.acc;
}
fn reverse_vm_fn_step(st: VmFunctionRev) -> (result: VmFunctionRev) {
    return match st.rest {
        VFNil => st,
        VFCons { head: h, tail: t } => VmFunctionRev { rest: t, acc: VmFunctionList.VFCons { head: h, tail: st.acc } }
    };
}

record SsaValRev { rest: ssa.ValueList, acc: ssa.ValueList }
fn reverse_ssa_values(values: ssa.ValueList) -> (result: ssa.ValueList) {
    iterate i up_to 1024 carrying st: SsaValRev = SsaValRev { rest: values, acc: ssa.ValueList.VNil } {
        if ssa_value_list_empty(st.rest) { return st.acc; }
        next st = reverse_ssa_value_step(st);
    }
    return st.acc;
}
fn reverse_ssa_value_step(st: SsaValRev) -> (result: SsaValRev) {
    return match st.rest {
        ssa.ValueList.VNil => st,
        ssa.ValueList.VCons { head: h, tail: t } => SsaValRev { rest: t, acc: ssa.ValueList.VCons { head: h, tail: st.acc } }
    };
}

record SsaIdRev { rest: ssa.IdList, acc: ssa.IdList }
fn reverse_ssa_ids(ids: ssa.IdList) -> (result: ssa.IdList) {
    iterate i up_to 1024 carrying st: SsaIdRev = SsaIdRev { rest: ids, acc: ssa.IdList.INil } {
        if id_list_empty(st.rest) { return st.acc; }
        next st = reverse_ssa_id_step(st);
    }
    return st.acc;
}
fn reverse_ssa_id_step(st: SsaIdRev) -> (result: SsaIdRev) {
    return match st.rest {
        ssa.IdList.INil => st,
        ssa.IdList.ICons { head: h, tail: t } => SsaIdRev { rest: t, acc: ssa.IdList.ICons { head: h, tail: st.acc } }
    };
}

fn id_list_head_eq(ids: ssa.IdList, wanted: u64) -> (result: bool) {
    return match ids { ssa.IdList.INil => false, ssa.IdList.ICons { head: h, tail: t } => h.value == wanted };
}
fn id_list_tail(ids: ssa.IdList) -> (result: ssa.IdList) {
    return match ids { ssa.IdList.INil => ssa.IdList.INil, ssa.IdList.ICons { head: h, tail: t } => t };
}
fn id_in_list(ids: ssa.IdList, wanted: u64) -> (result: bool) {
    iterate i up_to 1024 carrying rest: ssa.IdList = ids {
        if id_list_empty(rest) { return false; }
        if id_list_head_eq(rest, wanted) { return true; }
        next rest = id_list_tail(rest);
    }
    return false;
}

fn vm_bounded_iter_list_empty(iters: VmBoundedIterationList) -> (result: bool) {
    return match iters { VBINil => true, VBICons { head: h, tail: t } => false };
}
fn reverse_vm_bounded_iters(iters: VmBoundedIterationList) -> (result: VmBoundedIterationList) {
    iterate i up_to 128 carrying st: VmBoundedIterRev = VmBoundedIterRev { rest: iters, acc: VmBoundedIterationList.VBINil } {
        if vm_bounded_iter_list_empty(st.rest) { return st.acc; }
        next st = reverse_vm_bounded_iter_step(st);
    }
    return st.acc;
}
fn reverse_vm_bounded_iter_step(st: VmBoundedIterRev) -> (result: VmBoundedIterRev) {
    return match st.rest {
        VBINil => st,
        VBICons { head: h, tail: t } => VmBoundedIterRev { rest: t, acc: VmBoundedIterationList.VBICons { head: h, tail: st.acc } }
    };
}

record NatArgsEqWalk { a: VmNatArgList, b: VmNatArgList, ok: bool, done: bool }
fn nat_args_equal(a: VmNatArgList, b: VmNatArgList) -> (result: bool) {
    let initial: NatArgsEqWalk = NatArgsEqWalk { a: a, b: b, ok: true, done: false };
    iterate i up_to 64 carrying st: NatArgsEqWalk = initial {
        if st.done || !(st.ok) { return st.ok && st.done; }
        next st = nat_args_eq_step(st);
    }
    return st.ok && st.done;
}
fn nat_args_eq_step(st: NatArgsEqWalk) -> (result: NatArgsEqWalk) {
    return match st.a {
        NANil => NatArgsEqWalk { ..st, ok: vm_nat_list_empty(st.b), done: true },
        NACons { head: ah, tail: at } => nat_args_eq_pair(st, ah.value, at)
    };
}
fn nat_args_eq_pair(st: NatArgsEqWalk, av: u64, at: VmNatArgList) -> (result: NatArgsEqWalk) {
    return match st.b {
        NANil => NatArgsEqWalk { ..st, ok: false, done: true },
        NACons { head: bh, tail: bt } => NatArgsEqWalk { a: at, b: bt, ok: av == bh.value, done: false }
    };
}
fn spec_keys_equal(a: VmSpecKey, b: VmSpecKey) -> (result: bool) {
    return semantic_ids_equal(a.identity, b.identity) && nat_args_equal(a.nat_args, b.nat_args);
}

// Copy a source byte span [start..end] into a SemanticIdentity carrier.
fn span_to_ident<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: decl.SemanticIdentity) {
    if end <= start || end > total || end - start > 512 { return decl.invalid_semantic_identity(); }
    let seed: decl.SemanticIdentityBuild = decl.SemanticIdentityBuild { bytes: [0 as byte; 512], len: 0, valid: true };
    let built: decl.SemanticIdentityBuild = decl.callable_identity_span<P, N>(pages, stride, total, seed, start, end);
    return decl.SemanticIdentity { bytes: built.bytes, len: built.len, valid: built.valid && built.len == end - start };
}

// ---------------------------------------------------------------------------
// Generic Nat binding environment & source-backed concrete type resolution
// ---------------------------------------------------------------------------

record NatBinding { name_start: u64, name_end: u64, value: u64 }
enum NatEnv { NENil, NECons { head: NatBinding, tail: NatEnv } }
fn nat_env_empty(env: NatEnv) -> (result: bool) {
    return match env { NENil => true, NECons { head: h, tail: t } => false };
}

record NatEnvLookup { rest: NatEnv, start: u64, end: u64, found: bool, value: u64 }
fn lookup_nat_env<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, env: NatEnv, start: u64, end: u64) -> (result: NatEnvLookup) {
    let initial: NatEnvLookup = NatEnvLookup { rest: env, start: start, end: end, found: false, value: 0 };
    iterate i up_to 64 carrying st: NatEnvLookup = initial {
        if st.found || nat_env_empty(st.rest) { return st; }
        next st = lookup_nat_env_step<P, N>(pages, stride, total, st);
    }
    return st;
}
fn lookup_nat_env_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NatEnvLookup) -> (result: NatEnvLookup) {
    return match st.rest {
        NENil => st,
        NECons { head: b, tail: rest } => lookup_nat_env_one<P, N>(pages, stride, total, st, b, rest)
    };
}
fn lookup_nat_env_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NatEnvLookup, b: NatBinding, rest: NatEnv) -> (result: NatEnvLookup) {
    if decl.spans_equal<P, N>(pages, stride, total, b.name_start, b.name_end, st.start, st.end) {
        return NatEnvLookup { rest: NatEnv.NENil, start: st.start, end: st.end, found: true, value: b.value };
    }
    return NatEnvLookup { ..st, rest: rest };
}

record NatEnvBuild { params: decl.GenericParamList, args: VmNatArgList, env: NatEnv, ok: bool, done: bool }
fn build_nat_env<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, params: decl.GenericParamList, args: VmNatArgList) -> (result: NatEnvBuild) {
    let initial: NatEnvBuild = NatEnvBuild { params: params, args: args, env: NatEnv.NENil, ok: true, done: false };
    iterate i up_to 64 carrying st: NatEnvBuild = initial {
        if st.done || !(st.ok) { return st; }
        next st = build_nat_env_step<P, N>(pages, stride, total, st);
    }
    return NatEnvBuild { ..st, ok: st.ok && st.done };
}
fn build_nat_env_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NatEnvBuild) -> (result: NatEnvBuild) {
    return match st.params {
        decl.GenericParamList.GNil => NatEnvBuild { ..st, ok: vm_nat_list_empty(st.args), done: true },
        decl.GenericParamList.GCons { head: gp, tail: gp_rest } => build_nat_env_pair<P, N>(pages, stride, total, st, gp, gp_rest)
    };
}
fn build_nat_env_pair<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NatEnvBuild, gp: decl.GenericParam, gp_rest: decl.GenericParamList) -> (result: NatEnvBuild) {
    return match st.args {
        NANil => NatEnvBuild { ..st, ok: false, done: true },
        NACons { head: arg, tail: arg_rest } => build_nat_env_bind<P, N>(pages, stride, total, st, gp, gp_rest, arg.value, arg_rest)
    };
}
fn build_nat_env_bind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NatEnvBuild, gp: decl.GenericParam, gp_rest: decl.GenericParamList, val: u64, arg_rest: VmNatArgList) -> (result: NatEnvBuild) {
    let kind: u64 = decl.generic_bound_kind<P, N>(pages, stride, total, gp);
    if kind != 0 || val == 0 || val > 65536 {
        return NatEnvBuild { ..st, ok: false, done: true };
    }
    let next_env: NatEnv = NatEnv.NECons { head: NatBinding { name_start: gp.name_start, name_end: gp.name_end, value: val }, tail: st.env };
    return NatEnvBuild { params: gp_rest, args: arg_rest, env: next_env, ok: true, done: false };
}

// Resolve a literal integer or Nat parameter token into a bounded 1..=65536 ceiling.
record NatBoundResult { ok: bool, error_code: u64, value: u64 }
fn resolve_nat_token<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nat_env: NatEnv, tok: lexer.Token) -> (result: NatBoundResult) {
    if tok.diagnostic != 0 { return NatBoundResult { ok: false, error_code: 4, value: 0 }; }
    if tok.kind == 5 {
        let parsed: decl.IntVal = decl.int_value<P, N>(pages, stride, total, tok.start, tok.end);
        if parsed.overflow || parsed.value == 0 || parsed.value > 65536 {
            return NatBoundResult { ok: false, error_code: 11, value: 0 };
        }
        return NatBoundResult { ok: true, error_code: 0, value: parsed.value };
    }
    if tok.kind == 4 {
        let looked: NatEnvLookup = lookup_nat_env<P, N>(pages, stride, total, nat_env, tok.start, tok.end);
        if !(looked.found) || looked.value == 0 || looked.value > 65536 {
            return NatBoundResult { ok: false, error_code: 11, value: 0 };
        }
        return NatBoundResult { ok: true, error_code: 0, value: looked.value };
    }
    return NatBoundResult { ok: false, error_code: 4, value: 0 };
}

fn resolve_nat_bound_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, nat_env: NatEnv) -> (result: NatBoundResult) {
    if end <= start || end > total { return NatBoundResult { ok: false, error_code: 11, value: 0 }; }
    let tok: lexer.Token = lexer.significant_global<P, N>(pages, stride, total, start);
    if tok.diagnostic != 0 || tok.end > end {
        return NatBoundResult { ok: false, error_code: 11, value: 0 };
    }
    let res: NatBoundResult = resolve_nat_token<P, N>(pages, stride, total, nat_env, tok);
    if !(res.ok) { return NatBoundResult { ok: false, error_code: 11, value: 0 }; }
    return res;
}

// Parse concrete flat `[T; N]` / `[T; up_to N]` or nested `[[T; N]; P]` / `[[T; up_to N]; up_to P]`
// from a source type span, where T is a concrete scalar type (`byte`, `bool`, or integer).
record SeqTypeParseResult { ok: bool, error_code: u64, ty: VmType }
record SeqBoundCloseResult { ok: bool, error_code: u64, bound_kind: u64, bound_value: u64, close_end: u64 }
fn parse_seq_bound_after_semi<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, after_elem: u64, nat_env: NatEnv) -> (result: SeqBoundCloseResult) {
    let t_semi: lexer.Token = lexer.significant_global<P, N>(pages, stride, total, after_elem);
    if t_semi.diagnostic != 0 || t_semi.kind != 63 {
        return SeqBoundCloseResult { ok: false, error_code: 4, bound_kind: 0, bound_value: 0, close_end: 0 };
    }
    let t_b0: lexer.Token = lexer.significant_global<P, N>(pages, stride, total, t_semi.end);
    if t_b0.diagnostic != 0 {
        return SeqBoundCloseResult { ok: false, error_code: 4, bound_kind: 0, bound_value: 0, close_end: 0 };
    }
    let is_up_to: bool = t_b0.kind == 32;
    let bound_kind: u64 = select(is_up_to, 2, 1);
    let t_bound: lexer.Token = select_token(is_up_to, lexer.significant_global<P, N>(pages, stride, total, t_b0.end), t_b0);
    if t_bound.diagnostic != 0 {
        return SeqBoundCloseResult { ok: false, error_code: 4, bound_kind: 0, bound_value: 0, close_end: 0 };
    }
    let t_close: lexer.Token = lexer.significant_global<P, N>(pages, stride, total, t_bound.end);
    if t_close.diagnostic != 0 || t_close.kind != 70 {
        return SeqBoundCloseResult { ok: false, error_code: 4, bound_kind: 0, bound_value: 0, close_end: 0 };
    }
    let nat_res: NatBoundResult = resolve_nat_token<P, N>(pages, stride, total, nat_env, t_bound);
    if !(nat_res.ok) {
        return SeqBoundCloseResult { ok: false, error_code: nat_res.error_code, bound_kind: 0, bound_value: 0, close_end: 0 };
    }
    return SeqBoundCloseResult { ok: true, error_code: 0, bound_kind: bound_kind, bound_value: nat_res.value, close_end: t_close.end };
}
fn parse_scalar_elem_vm_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: VmType) {
    let sk: u64 = decl.scalar_kind<P, N>(pages, stride, total, start, end);
    if sk == 4 { return byte_vm_type(); }
    if sk == 3 { return bool_vm_type(); }
    if sk == 1 { return int_vm_type(64, false); }
    if sk == 2 { return int_vm_type(64, true); }
    let elem_sem: decl.SemType = decl.scalar_sem<P, N>(pages, stride, total, start, end);
    return sem_type_to_vm_scalar(elem_sem);
}
record FlatSeqParseWithEnd { ok: bool, error_code: u64, ty: VmType, close_end: u64 }
fn parse_flat_scalar_seq_at<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, t_elem: lexer.Token, nat_env: NatEnv) -> (result: FlatSeqParseWithEnd) {
    if t_elem.diagnostic != 0 || t_elem.kind != 4 {
        return FlatSeqParseWithEnd { ok: false, error_code: 4, ty: invalid_vm_type(), close_end: 0 };
    }
    let elem_ty: VmType = parse_scalar_elem_vm_type<P, N>(pages, stride, total, t_elem.start, t_elem.end);
    if !(elem_ty.valid) {
        return FlatSeqParseWithEnd { ok: false, error_code: 4, ty: invalid_vm_type(), close_end: 0 };
    }
    let bnd: SeqBoundCloseResult = parse_seq_bound_after_semi<P, N>(pages, stride, total, t_elem.end, nat_env);
    if !(bnd.ok) {
        return FlatSeqParseWithEnd { ok: false, error_code: bnd.error_code, ty: invalid_vm_type(), close_end: 0 };
    }
    let seq_ty: VmType = scalar_seq_vm_type(elem_ty, bnd.bound_kind, bnd.bound_value);
    if !(seq_ty.valid) {
        return FlatSeqParseWithEnd { ok: false, error_code: 4, ty: invalid_vm_type(), close_end: 0 };
    }
    return FlatSeqParseWithEnd { ok: true, error_code: 0, ty: seq_ty, close_end: bnd.close_end };
}
fn parse_byte_seq_vm_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, nat_env: NatEnv) -> (result: SeqTypeParseResult) {
    if end <= start || end > total { return SeqTypeParseResult { ok: false, error_code: 4, ty: invalid_vm_type() }; }
    let t_open: lexer.Token = lexer.significant_global<P, N>(pages, stride, total, start);
    if t_open.diagnostic != 0 || t_open.kind != 69 { return SeqTypeParseResult { ok: false, error_code: 4, ty: invalid_vm_type() }; }
    let t_next: lexer.Token = lexer.significant_global<P, N>(pages, stride, total, t_open.end);
    if t_next.diagnostic != 0 { return SeqTypeParseResult { ok: false, error_code: 4, ty: invalid_vm_type() }; }
    if t_next.kind == 69 {
        // Nested bounded sequence: `[[T; inner_bound]; outer_bound]`
        let t_inner_elem: lexer.Token = lexer.significant_global<P, N>(pages, stride, total, t_next.end);
        let inner: FlatSeqParseWithEnd = parse_flat_scalar_seq_at<P, N>(pages, stride, total, t_inner_elem, nat_env);
        if !(inner.ok) { return SeqTypeParseResult { ok: false, error_code: inner.error_code, ty: invalid_vm_type() }; }
        let outer_bnd: SeqBoundCloseResult = parse_seq_bound_after_semi<P, N>(pages, stride, total, inner.close_end, nat_env);
        if !(outer_bnd.ok) { return SeqTypeParseResult { ok: false, error_code: outer_bnd.error_code, ty: invalid_vm_type() }; }
        if outer_bnd.close_end != end { return SeqTypeParseResult { ok: false, error_code: 4, ty: invalid_vm_type() }; }
        let nested: VmType = nested_seq_vm_type(inner.ty, outer_bnd.bound_kind, outer_bnd.bound_value);
        if !(nested.valid) { return SeqTypeParseResult { ok: false, error_code: 4, ty: invalid_vm_type() }; }
        return SeqTypeParseResult { ok: true, error_code: 0, ty: nested };
    }
    let flat: FlatSeqParseWithEnd = parse_flat_scalar_seq_at<P, N>(pages, stride, total, t_next, nat_env);
    if !(flat.ok) { return SeqTypeParseResult { ok: false, error_code: flat.error_code, ty: invalid_vm_type() }; }
    if flat.close_end != end { return SeqTypeParseResult { ok: false, error_code: 4, ty: invalid_vm_type() }; }
    return SeqTypeParseResult { ok: true, error_code: 0, ty: flat.ty };
}
fn select_token(pick_first: bool, a: lexer.Token, b: lexer.Token) -> (result: lexer.Token) {
    if pick_first { return a; }
    return b;
}

// Parse concrete `<...>` generic Nat arguments on a Call expression span.
record CallHeadScan { cursor: u64, ok: bool, done: bool, has_targs: bool, targs_start: u64 }
fn scan_call_head<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64) -> (result: CallHeadScan) {
    let first: lexer.Token = lexer.significant_global<P, N>(pages, stride, total, start);
    if first.diagnostic != 0 || first.kind != 4 {
        return CallHeadScan { cursor: start, ok: false, done: true, has_targs: false, targs_start: 0 };
    }
    let initial: CallHeadScan = CallHeadScan { cursor: first.end, ok: true, done: false, has_targs: false, targs_start: 0 };
    iterate i up_to 16 carrying st: CallHeadScan = initial {
        if st.done || !(st.ok) { return st; }
        next st = scan_call_head_step<P, N>(pages, stride, total, st);
    }
    return CallHeadScan { ..st, ok: st.ok && st.done };
}
fn scan_call_head_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CallHeadScan) -> (result: CallHeadScan) {
    let tok: lexer.Token = lexer.significant_global<P, N>(pages, stride, total, st.cursor);
    if tok.diagnostic != 0 { return CallHeadScan { ..st, ok: false, done: true }; }
    if tok.kind == 65 { return CallHeadScan { cursor: tok.end, ok: true, done: true, has_targs: false, targs_start: 0 }; }
    if tok.kind == 58 { return CallHeadScan { cursor: tok.start, ok: true, done: true, has_targs: true, targs_start: tok.start }; }
    if tok.kind == 61 {
        let seg: lexer.Token = lexer.significant_global<P, N>(pages, stride, total, tok.end);
        if seg.diagnostic != 0 || seg.kind != 4 { return CallHeadScan { ..st, ok: false, done: true }; }
        return CallHeadScan { cursor: seg.end, ok: true, done: false, has_targs: false, targs_start: 0 };
    }
    return CallHeadScan { ..st, ok: false, done: true };
}

record CallNatArgsResult { ok: bool, error_code: u64, nat_args: VmNatArgList }
record CallNatArgsWalk { rest: decl.TypeArgList, acc: VmNatArgList, ok: bool }
fn parse_call_nat_args<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, nat_env: NatEnv) -> (result: CallNatArgsResult) {
    if end <= start || end > total { return CallNatArgsResult { ok: false, error_code: 5, nat_args: VmNatArgList.NANil }; }
    let head: CallHeadScan = scan_call_head<P, N>(pages, stride, total, start);
    if !(head.ok) { return CallNatArgsResult { ok: false, error_code: 5, nat_args: VmNatArgList.NANil }; }
    if !(head.has_targs) { return CallNatArgsResult { ok: true, error_code: 0, nat_args: VmNatArgList.NANil }; }
    let parsed: decl.TArgsParse = decl.parse_type_args<P, N>(pages, stride, total, head.targs_start);
    if !(parsed.ok) || decl_targ_list_empty(parsed.list) {
        return CallNatArgsResult { ok: false, error_code: 11, nat_args: VmNatArgList.NANil };
    }
    let after: lexer.Token = lexer.significant_global<P, N>(pages, stride, total, parsed.cursor);
    if after.diagnostic != 0 || after.kind != 65 {
        return CallNatArgsResult { ok: false, error_code: 11, nat_args: VmNatArgList.NANil };
    }
    let initial: CallNatArgsWalk = CallNatArgsWalk { rest: parsed.list, acc: VmNatArgList.NANil, ok: true };
    iterate i up_to 64 carrying st: CallNatArgsWalk = initial {
        if !(st.ok) || decl_targ_list_empty(st.rest) {
            return CallNatArgsResult { ok: st.ok && decl_targ_list_empty(st.rest), error_code: select(st.ok && decl_targ_list_empty(st.rest), 0, 11), nat_args: reverse_vm_nat_args(st.acc) };
        }
        next st = parse_call_nat_arg_step<P, N>(pages, stride, total, nat_env, st);
    }
    return CallNatArgsResult { ok: st.ok && decl_targ_list_empty(st.rest), error_code: select(st.ok && decl_targ_list_empty(st.rest), 0, 11), nat_args: reverse_vm_nat_args(st.acc) };
}
fn parse_call_nat_arg_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nat_env: NatEnv, st: CallNatArgsWalk) -> (result: CallNatArgsWalk) {
    return match st.rest {
        decl.TypeArgList.TNil => st,
        decl.TypeArgList.TCons { head: targ, tail: rest } => parse_call_nat_arg_one<P, N>(pages, stride, total, nat_env, st, targ, rest)
    };
}
fn parse_call_nat_arg_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nat_env: NatEnv, st: CallNatArgsWalk, targ: decl.TypeArg, rest: decl.TypeArgList) -> (result: CallNatArgsWalk) {
    if targ.kind == 10 {
        let iv: decl.IntVal = decl.int_value<P, N>(pages, stride, total, targ.start, targ.end);
        if iv.overflow || iv.value == 0 || iv.value > 65536 {
            return CallNatArgsWalk { rest: decl.TypeArgList.TNil, acc: st.acc, ok: false };
        }
        return CallNatArgsWalk { rest: rest, acc: VmNatArgList.NACons { head: VmNatArg { value: iv.value }, tail: st.acc }, ok: true };
    }
    let looked: NatEnvLookup = lookup_nat_env<P, N>(pages, stride, total, nat_env, targ.start, targ.end);
    if !(looked.found) || looked.value == 0 || looked.value > 65536 {
        return CallNatArgsWalk { rest: decl.TypeArgList.TNil, acc: st.acc, ok: false };
    }
    return CallNatArgsWalk { rest: rest, acc: VmNatArgList.NACons { head: VmNatArg { value: looked.value }, tail: st.acc }, ok: true };
}

// ---------------------------------------------------------------------------
// Record schema lookup and collection across reachable project modules
// ---------------------------------------------------------------------------

fn dummy_record_type() -> (result: VmRecordType) {
    return VmRecordType { identity: decl.invalid_semantic_identity(), name: decl.invalid_semantic_identity(), fields: VmRecordFieldList.VRFNil };
}
record RecordTypeLookup { found: bool, schema: VmRecordType }
fn rec_type_head_eq(recs: VmRecordTypeList, wanted: decl.SemanticIdentity) -> (result: bool) {
    return match recs { VRTNil => false, VRTCons { head: rec, tail: t } => semantic_ids_equal(rec.identity, wanted) };
}
fn rec_type_head(recs: VmRecordTypeList) -> (result: VmRecordType) {
    return match recs { VRTNil => dummy_record_type(), VRTCons { head: rec, tail: t } => rec };
}
fn rec_type_tail(recs: VmRecordTypeList) -> (result: VmRecordTypeList) {
    return match recs { VRTNil => VmRecordTypeList.VRTNil, VRTCons { head: rec, tail: t } => t };
}
fn find_vm_record_type(recs: VmRecordTypeList, wanted: decl.SemanticIdentity) -> (result: RecordTypeLookup) {
    iterate i up_to 1024 carrying rest: VmRecordTypeList = recs {
        if vm_record_type_list_empty(rest) { return RecordTypeLookup { found: false, schema: dummy_record_type() }; }
        if rec_type_head_eq(rest, wanted) { return RecordTypeLookup { found: true, schema: rec_type_head(rest) }; }
        next rest = rec_type_tail(rest);
    }
    return RecordTypeLookup { found: false, schema: dummy_record_type() };
}

record RecordFieldLookup { found: bool, ty: VmType }
fn rec_field_head_eq(fields: VmRecordFieldList, wanted: decl.SemanticIdentity) -> (result: bool) {
    return match fields { VRFNil => false, VRFCons { head: fld, tail: t } => semantic_ids_equal(fld.name, wanted) };
}
fn rec_field_head_ty(fields: VmRecordFieldList) -> (result: VmType) {
    return match fields { VRFNil => invalid_vm_type(), VRFCons { head: fld, tail: t } => fld.ty };
}
fn rec_field_head_name(fields: VmRecordFieldList) -> (result: decl.SemanticIdentity) {
    return match fields { VRFNil => decl.invalid_semantic_identity(), VRFCons { head: fld, tail: t } => fld.name };
}
fn rec_field_tail(fields: VmRecordFieldList) -> (result: VmRecordFieldList) {
    return match fields { VRFNil => VmRecordFieldList.VRFNil, VRFCons { head: fld, tail: t } => t };
}
fn find_vm_record_field(fields: VmRecordFieldList, wanted: decl.SemanticIdentity) -> (result: RecordFieldLookup) {
    iterate i up_to 128 carrying rest: VmRecordFieldList = fields {
        if vm_record_field_list_empty(rest) { return RecordFieldLookup { found: false, ty: invalid_vm_type() }; }
        if rec_field_head_eq(rest, wanted) { return RecordFieldLookup { found: true, ty: rec_field_head_ty(rest) }; }
        next rest = rec_field_tail(rest);
    }
    return RecordFieldLookup { found: false, ty: invalid_vm_type() };
}

record RecordFieldAtLookup { found: bool, name: decl.SemanticIdentity, ty: VmType }
fn find_vm_record_field_at(fields: VmRecordFieldList, target_index: u64) -> (result: RecordFieldAtLookup) {
    iterate i up_to 128 carrying rest: VmRecordFieldList = fields {
        if vm_record_field_list_empty(rest) {
            return RecordFieldAtLookup { found: false, name: decl.invalid_semantic_identity(), ty: invalid_vm_type() };
        }
        if i == target_index {
            return RecordFieldAtLookup { found: true, name: rec_field_head_name(rest), ty: rec_field_head_ty(rest) };
        }
        next rest = rec_field_tail(rest);
    }
    return RecordFieldAtLookup { found: false, name: decl.invalid_semantic_identity(), ty: invalid_vm_type() };
}

record NameContainsWalk { rest: VmNameList, wanted: decl.SemanticIdentity, found: bool }
fn vm_name_list_contains(names: VmNameList, wanted: decl.SemanticIdentity) -> (result: bool) {
    let initial: NameContainsWalk = NameContainsWalk { rest: names, wanted: wanted, found: false };
    iterate i up_to 128 carrying st: NameContainsWalk = initial {
        if st.found || vm_name_list_empty(st.rest) { return st.found; }
        next st = vm_name_list_contains_step(st);
    }
    return st.found;
}
fn vm_name_list_contains_step(st: NameContainsWalk) -> (result: NameContainsWalk) {
    return match st.rest {
        VNNil => st,
        VNCons { head: n, tail: rest } => NameContainsWalk { rest: rest, wanted: st.wanted, found: semantic_ids_equal(n, st.wanted) }
    };
}

record FieldCountWalk { rest: VmRecordFieldList, count: u64 }
fn count_vm_record_fields(fields: VmRecordFieldList) -> (result: u64) {
    iterate i up_to 128 carrying st: FieldCountWalk = FieldCountWalk { rest: fields, count: 0 } {
        if vm_record_field_list_empty(st.rest) { return st.count; }
        next st = count_vm_record_field_step(st);
    }
    return st.count;
}
fn count_vm_record_field_step(st: FieldCountWalk) -> (result: FieldCountWalk) {
    return match st.rest {
        VRFNil => st,
        VRFCons { head: h, tail: t } => FieldCountWalk { rest: t, count: st.count + 1 }
    };
}

record RecordFieldsLowerWalk { rest: decl.FieldList, acc: VmRecordFieldList, ok: bool }
fn lower_record_decl_fields<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: decl.FieldList, nominals: decl.NominalTypeIdentityList) -> (result: RecordFieldsLowerWalk) {
    let initial: RecordFieldsLowerWalk = RecordFieldsLowerWalk { rest: fields, acc: VmRecordFieldList.VRFNil, ok: true };
    iterate i up_to 128 carrying st: RecordFieldsLowerWalk = initial {
        if !(st.ok) || decl_field_list_empty(st.rest) {
            return RecordFieldsLowerWalk { rest: st.rest, acc: reverse_vm_record_fields(st.acc), ok: st.ok && decl_field_list_empty(st.rest) };
        }
        next st = lower_record_decl_field_step<P, N>(pages, stride, total, nominals, st);
    }
    return RecordFieldsLowerWalk { rest: st.rest, acc: reverse_vm_record_fields(st.acc), ok: st.ok && decl_field_list_empty(st.rest) };
}
fn lower_record_decl_field_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, st: RecordFieldsLowerWalk) -> (result: RecordFieldsLowerWalk) {
    return match st.rest {
        decl.FieldList.FNil => st,
        decl.FieldList.FCons { head: fld, tail: rest } => lower_record_decl_field_one<P, N>(pages, stride, total, nominals, st, fld, rest)
    };
}
fn lookup_nominal_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, start: u64, end: u64) -> (result: decl.NominalLookup) {
    let by_ref: decl.NominalLookup = decl.nominal_identity_at<P, N>(pages, stride, total, nominals, start, end);
    if by_ref.found && by_ref.identity.valid { return by_ref; }
    return decl.nominal_identity_by_name<P, N>(pages, stride, total, nominals, start, end);
}

fn field_scalar_vm_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fld: decl.Field) -> (result: VmType) {
    if fld.type_kind == 3 { return bool_vm_type(); }
    if fld.type_kind == 4 { return byte_vm_type(); }
    if fld.type_kind == 1 { return int_vm_type(64, false); }
    if fld.type_kind == 2 { return int_vm_type(64, true); }
    let scalar: decl.SemType = decl.scalar_sem<P, N>(pages, stride, total, fld.type_start, fld.type_end);
    return sem_type_to_vm_scalar(scalar);
}

fn lower_record_decl_field_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, st: RecordFieldsLowerWalk, fld: decl.Field, rest: decl.FieldList) -> (result: RecordFieldsLowerWalk) {
    let fname: decl.SemanticIdentity = span_to_ident<P, N>(pages, stride, total, fld.name_start, fld.name_end);
    if !(fname.valid) { return RecordFieldsLowerWalk { rest: decl.FieldList.FNil, acc: st.acc, ok: false }; }
    let vt_scalar: VmType = field_scalar_vm_type<P, N>(pages, stride, total, fld);
    if vt_scalar.valid {
        return RecordFieldsLowerWalk { rest: rest, acc: VmRecordFieldList.VRFCons { head: VmRecordField { name: fname, ty: vt_scalar }, tail: st.acc }, ok: true };
    }
    let seq_res: SeqTypeParseResult = parse_byte_seq_vm_type<P, N>(pages, stride, total, fld.type_start, fld.type_end, NatEnv.NENil);
    if seq_res.ok {
        return RecordFieldsLowerWalk { rest: rest, acc: VmRecordFieldList.VRFCons { head: VmRecordField { name: fname, ty: seq_res.ty }, tail: st.acc }, ok: true };
    }
    let nom: decl.NominalLookup = lookup_nominal_identity<P, N>(pages, stride, total, nominals, fld.type_start, fld.type_end);
    if nom.found && nom.identity.valid {
        if is_finite_nominal_identity(nom.identity) {
            return RecordFieldsLowerWalk { rest: rest, acc: VmRecordFieldList.VRFCons { head: VmRecordField { name: fname, ty: finite_vm_type(nom.identity) }, tail: st.acc }, ok: true };
        }
        if is_record_nominal_identity(nom.identity) {
            return RecordFieldsLowerWalk { rest: rest, acc: VmRecordFieldList.VRFCons { head: VmRecordField { name: fname, ty: record_vm_type(nom.identity) }, tail: st.acc }, ok: true };
        }
    }
    return RecordFieldsLowerWalk { rest: decl.FieldList.FNil, acc: st.acc, ok: false };
}

fn first_fn_nominals(summary: ssa.ValueSsaSummary) -> (result: decl.NominalTypeIdentityList) {
    if summary.function_count == 0 { return decl.NominalTypeIdentityList.NINil; }
    let lookup: ssa.ValueSsaFunctionLookup = ssa.value_ssa_function_at(summary, 0);
    if !(lookup.found) { return decl.NominalTypeIdentityList.NINil; }
    return lookup.function.nominals;
}

record ModRecordsCollectWalk { rest: decl.RecordList, acc: VmRecordTypeList }
fn collect_module_record_types<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, unit: decl.Unit, nominals: decl.NominalTypeIdentityList, acc: VmRecordTypeList) -> (result: VmRecordTypeList) {
    let initial: ModRecordsCollectWalk = ModRecordsCollectWalk { rest: unit.records, acc: acc };
    iterate i up_to 1024 carrying st: ModRecordsCollectWalk = initial {
        if decl_record_list_empty(st.rest) { return st.acc; }
        next st = collect_module_record_step<P, N>(pages, stride, total, unit.header, nominals, st);
    }
    return st.acc;
}
fn collect_module_record_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, nominals: decl.NominalTypeIdentityList, st: ModRecordsCollectWalk) -> (result: ModRecordsCollectWalk) {
    return match st.rest {
        decl.RecordList.RNil => st,
        decl.RecordList.RCons { head: rec, tail: rest } => collect_module_record_one<P, N>(pages, stride, total, header, nominals, st, rec, rest)
    };
}
fn collect_module_record_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, nominals: decl.NominalTypeIdentityList, st: ModRecordsCollectWalk, rec: decl.RecordDecl, rest: decl.RecordList) -> (result: ModRecordsCollectWalk) {
    let rec_id: decl.SemanticIdentity = decl.canonical_record_type_identity<P, N>(pages, stride, total, header.module_start, header.module_end, rec, nominals);
    let rec_name: decl.SemanticIdentity = span_to_ident<P, N>(pages, stride, total, rec.name_start, rec.name_end);
    if !(rec_id.valid) || !(rec_name.valid) { return ModRecordsCollectWalk { rest: rest, acc: st.acc }; }
    let existing: RecordTypeLookup = find_vm_record_type(st.acc, rec_id);
    if existing.found { return ModRecordsCollectWalk { rest: rest, acc: st.acc }; }
    let lowered_fields: RecordFieldsLowerWalk = lower_record_decl_fields<P, N>(pages, stride, total, rec.fields, nominals);
    if !(lowered_fields.ok) { return ModRecordsCollectWalk { rest: rest, acc: st.acc }; }
    let schema: VmRecordType = VmRecordType { identity: rec_id, name: rec_name, fields: lowered_fields.acc };
    return ModRecordsCollectWalk { rest: rest, acc: VmRecordTypeList.VRTCons { head: schema, tail: st.acc } };
}

record AllModRecordsWalk { rest: project.ProjectModuleList, reachable: [bool; 64], acc: VmRecordTypeList }
fn collect_reachable_record_types<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], modules: project.ProjectModuleList, reachable: [bool; 64]) -> (result: VmRecordTypeList) {
    let initial: AllModRecordsWalk = AllModRecordsWalk { rest: modules, reachable: reachable, acc: VmRecordTypeList.VRTNil };
    iterate i up_to 64 carrying st: AllModRecordsWalk = initial {
        if project_module_list_empty(st.rest) { return reverse_vm_record_types(st.acc); }
        next st = collect_reachable_record_step<M, N>(snapshot, flat_pages, st);
    }
    return reverse_vm_record_types(st.acc);
}
fn collect_reachable_record_step<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], st: AllModRecordsWalk) -> (result: AllModRecordsWalk) {
    return match st.rest {
        project.ProjectModuleList.PNil => st,
        project.ProjectModuleList.PCons { head: mod_item, tail: rest } => collect_reachable_record_one<M, N>(snapshot, flat_pages, st, mod_item, rest)
    };
}
fn collect_reachable_record_one<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], st: AllModRecordsWalk, mod_item: project.ProjectModule, rest: project.ProjectModuleList) -> (result: AllModRecordsWalk) {
    if mod_item.source_index >= 64 || !(st.reachable[mod_item.source_index]) {
        return AllModRecordsWalk { ..st, rest: rest };
    }
    let pages: [[byte; up_to N]; up_to 1024] = project.module_pages<M, N>(snapshot.sources, flat_pages, mod_item.source_index);
    let stride: u64 = project.module_stride(snapshot.sources, mod_item.source_index);
    let total: u64 = project.module_total(snapshot.sources, mod_item.source_index);
    let noms: decl.NominalTypeIdentityList = first_fn_nominals(mod_item.value_ssa);
    let next_acc: VmRecordTypeList = collect_module_record_types<1024, N>(pages, stride, total, mod_item.flow.proof.unit, noms, st.acc);
    return AllModRecordsWalk { rest: rest, reachable: st.reachable, acc: next_acc };
}

// Retain only record schemas actually referenced by emitted functions.
record RecordUsageAdd { all_recs: VmRecordTypeList, used: VmRecordTypeList, count: u64 }
fn add_used_record_type(st: RecordUsageAdd, ty: VmType) -> (result: RecordUsageAdd) {
    if !(ty.valid) || ty.kind != 5 { return st; }
    let already: RecordTypeLookup = find_vm_record_type(st.used, ty.nominal_identity);
    if already.found { return st; }
    let found: RecordTypeLookup = find_vm_record_type(st.all_recs, ty.nominal_identity);
    if !(found.found) { return st; }
    return RecordUsageAdd { all_recs: st.all_recs, used: VmRecordTypeList.VRTCons { head: found.schema, tail: st.used }, count: st.count + 1 };
}
record ValueUsageWalk { rest: VmValueList, st: RecordUsageAdd }
fn collect_used_records_in_values(values: VmValueList, st: RecordUsageAdd) -> (result: RecordUsageAdd) {
    iterate i up_to 1024 carrying w: ValueUsageWalk = ValueUsageWalk { rest: values, st: st } {
        if vm_value_list_empty(w.rest) { return w.st; }
        next w = collect_used_records_in_value_step(w);
    }
    return w.st;
}
fn collect_used_records_in_value_step(w: ValueUsageWalk) -> (result: ValueUsageWalk) {
    return match w.rest {
        VVNil => w,
        VVCons { head: v, tail: rest } => ValueUsageWalk { rest: rest, st: add_used_record_type(w.st, v.ty) }
    };
}
record InstUsageWalk { rest: VmInstructionList, st: RecordUsageAdd }
fn collect_used_records_in_insts(insts: VmInstructionList, st: RecordUsageAdd) -> (result: RecordUsageAdd) {
    iterate i up_to 1024 carrying w: InstUsageWalk = InstUsageWalk { rest: insts, st: st } {
        if vm_inst_list_empty(w.rest) { return w.st; }
        next w = collect_used_records_in_inst_step(w);
    }
    return w.st;
}
fn collect_used_records_in_inst_step(w: InstUsageWalk) -> (result: InstUsageWalk) {
    return match w.rest {
        VINil => w,
        VICons { head: inst, tail: rest } => ValueUsageInstHelper(w.st, inst, rest)
    };
}
fn ValueUsageInstHelper(st: RecordUsageAdd, inst: VmInstruction, rest: VmInstructionList) -> (result: InstUsageWalk) {
    let s1: RecordUsageAdd = add_used_record_type(st, inst.ty);
    let s2: RecordUsageAdd = add_used_record_type(s1, inst.from_ty);
    return InstUsageWalk { rest: rest, st: s2 };
}
record BlockUsageWalk { rest: VmBlockList, st: RecordUsageAdd }
fn collect_used_records_in_blocks(blocks: VmBlockList, st: RecordUsageAdd) -> (result: RecordUsageAdd) {
    iterate i up_to 1024 carrying w: BlockUsageWalk = BlockUsageWalk { rest: blocks, st: st } {
        if vm_block_list_empty(w.rest) { return w.st; }
        next w = collect_used_records_in_block_step(w);
    }
    return w.st;
}
fn collect_used_records_in_block_step(w: BlockUsageWalk) -> (result: BlockUsageWalk) {
    return match w.rest {
        VBNil => w,
        VBCons { head: blk, tail: rest } => collect_used_records_in_block_one(w.st, blk, rest)
    };
}
fn collect_used_records_in_block_one(st: RecordUsageAdd, blk: VmBlock, rest: VmBlockList) -> (result: BlockUsageWalk) {
    let s1: RecordUsageAdd = collect_used_records_in_values(blk.parameters, st);
    let s2: RecordUsageAdd = collect_used_records_in_insts(blk.instructions, s1);
    return BlockUsageWalk { rest: rest, st: s2 };
}
record FnUsageWalk { rest: VmFunctionList, st: RecordUsageAdd }
fn retain_referenced_record_types(all_recs: VmRecordTypeList, fns: VmFunctionList) -> (result: RecordUsageAdd) {
    let initial: FnUsageWalk = FnUsageWalk { rest: fns, st: RecordUsageAdd { all_recs: all_recs, used: VmRecordTypeList.VRTNil, count: 0 } };
    iterate i up_to 1024 carrying w: FnUsageWalk = initial {
        if vm_fn_list_empty(w.rest) { return RecordUsageAdd { all_recs: all_recs, used: reverse_vm_record_types(w.st.used), count: w.st.count }; }
        next w = retain_referenced_record_step(w);
    }
    return RecordUsageAdd { all_recs: all_recs, used: reverse_vm_record_types(w.st.used), count: w.st.count };
}
fn retain_referenced_record_step(w: FnUsageWalk) -> (result: FnUsageWalk) {
    return match w.rest {
        VFNil => w,
        VFCons { head: fn_item, tail: rest } => retain_referenced_record_one(w.st, fn_item, rest)
    };
}
fn retain_referenced_record_one(st: RecordUsageAdd, fn_item: VmFunction, rest: VmFunctionList) -> (result: FnUsageWalk) {
    let s1: RecordUsageAdd = add_used_record_type(st, fn_item.result_type);
    let s2: RecordUsageAdd = collect_used_records_in_values(fn_item.inputs, s1);
    let s3: RecordUsageAdd = collect_used_records_in_blocks(fn_item.blocks, s2);
    return FnUsageWalk { rest: rest, st: s3 };
}

// ---------------------------------------------------------------------------
// Nominal finite enum schemas, zero-allocation lookup, and transitive retention
// ---------------------------------------------------------------------------

fn decl_enum_list_empty(enums: decl.EnumList) -> (result: bool) {
    return match enums { decl.EnumList.GNil => true, decl.EnumList.GCons { head: h, tail: t } => false };
}
fn decl_variant_list_empty(vars: decl.VariantList) -> (result: bool) {
    return match vars { decl.VariantList.VNil => true, decl.VariantList.VCons { head: h, tail: t } => false };
}
fn vm_finite_variant_list_empty(vars: VmFiniteVariantList) -> (result: bool) {
    return match vars { VFVNil => true, VFVCons { head: h, tail: t } => false };
}
fn vm_finite_type_list_empty(fins: VmFiniteTypeList) -> (result: bool) {
    return match fins { VFTNil => true, VFTCons { head: h, tail: t } => false };
}
fn reverse_vm_finite_variants(vars: VmFiniteVariantList) -> (result: VmFiniteVariantList) {
    iterate i up_to 256 carrying st: VmFiniteVariantRev = VmFiniteVariantRev { rest: vars, acc: VmFiniteVariantList.VFVNil } {
        if vm_finite_variant_list_empty(st.rest) { return st.acc; }
        next st = reverse_vm_finite_variants_step(st);
    }
    return st.acc;
}
fn reverse_vm_finite_variants_step(st: VmFiniteVariantRev) -> (result: VmFiniteVariantRev) {
    return match st.rest {
        VFVNil => st,
        VFVCons { head: h, tail: t } => VmFiniteVariantRev { rest: t, acc: VmFiniteVariantList.VFVCons { head: h, tail: st.acc } }
    };
}
fn reverse_vm_finite_types(fins: VmFiniteTypeList) -> (result: VmFiniteTypeList) {
    iterate i up_to 256 carrying st: VmFiniteTypeRev = VmFiniteTypeRev { rest: fins, acc: VmFiniteTypeList.VFTNil } {
        if vm_finite_type_list_empty(st.rest) { return st.acc; }
        next st = reverse_vm_finite_types_step(st);
    }
    return st.acc;
}
fn reverse_vm_finite_types_step(st: VmFiniteTypeRev) -> (result: VmFiniteTypeRev) {
    return match st.rest {
        VFTNil => st,
        VFTCons { head: h, tail: t } => VmFiniteTypeRev { rest: t, acc: VmFiniteTypeList.VFTCons { head: h, tail: st.acc } }
    };
}
fn dummy_vm_finite_variant() -> (result: VmFiniteVariant) {
    return VmFiniteVariant {
        identity: decl.invalid_semantic_identity(),
        name: decl.invalid_semantic_identity(),
        discriminant: 0,
        fields: VmRecordFieldList.VRFNil
    };
}
fn dummy_vm_finite_type() -> (result: VmFiniteType) {
    return VmFiniteType {
        identity: decl.invalid_semantic_identity(),
        name: decl.invalid_semantic_identity(),
        variants: VmFiniteVariantList.VFVNil
    };
}

record FiniteTypeLookup { found: bool, schema: VmFiniteType }
fn vm_fin_head_id_eq(fins: VmFiniteTypeList, wanted: decl.SemanticIdentity) -> (result: bool) {
    return match fins { VFTNil => false, VFTCons { head: s, tail: t } => semantic_ids_equal(s.identity, wanted) };
}
fn vm_fin_head(fins: VmFiniteTypeList) -> (result: VmFiniteType) {
    return match fins { VFTNil => dummy_vm_finite_type(), VFTCons { head: s, tail: t } => s };
}
fn vm_fin_tail(fins: VmFiniteTypeList) -> (result: VmFiniteTypeList) {
    return match fins { VFTNil => VmFiniteTypeList.VFTNil, VFTCons { head: s, tail: t } => t };
}
fn find_vm_finite_type(fins: VmFiniteTypeList, wanted: decl.SemanticIdentity) -> (result: FiniteTypeLookup) {
    iterate i up_to 256 carrying rest: VmFiniteTypeList = fins {
        if vm_finite_type_list_empty(rest) { return FiniteTypeLookup { found: false, schema: dummy_vm_finite_type() }; }
        if vm_fin_head_id_eq(rest, wanted) { return FiniteTypeLookup { found: true, schema: vm_fin_head(rest) }; }
        next rest = vm_fin_tail(rest);
    }
    return FiniteTypeLookup { found: false, schema: dummy_vm_finite_type() };
}

record FiniteVariantLookup { found: bool, variant: VmFiniteVariant }
fn vm_var_head_name_eq(vars: VmFiniteVariantList, wanted: decl.SemanticIdentity) -> (result: bool) {
    return match vars { VFVNil => false, VFVCons { head: v, tail: t } => semantic_ids_equal(v.name, wanted) };
}
fn vm_var_head(vars: VmFiniteVariantList) -> (result: VmFiniteVariant) {
    return match vars { VFVNil => dummy_vm_finite_variant(), VFVCons { head: v, tail: t } => v };
}
fn vm_var_tail(vars: VmFiniteVariantList) -> (result: VmFiniteVariantList) {
    return match vars { VFVNil => VmFiniteVariantList.VFVNil, VFVCons { head: v, tail: t } => t };
}
fn find_vm_finite_variant(vars: VmFiniteVariantList, wanted_name: decl.SemanticIdentity) -> (result: FiniteVariantLookup) {
    iterate i up_to 256 carrying rest: VmFiniteVariantList = vars {
        if vm_finite_variant_list_empty(rest) { return FiniteVariantLookup { found: false, variant: dummy_vm_finite_variant() }; }
        if vm_var_head_name_eq(rest, wanted_name) { return FiniteVariantLookup { found: true, variant: vm_var_head(rest) }; }
        next rest = vm_var_tail(rest);
    }
    return FiniteVariantLookup { found: false, variant: dummy_vm_finite_variant() };
}

// Build `mncs:0.2:finite-variant:<module>::<Enum>::<Variant>` from source spans.
record IdentCopyWalk { bytes: [byte; 512], len: u64, ok: bool }
fn append_ident_byte(st: IdentCopyWalk, b: byte) -> (result: IdentCopyWalk) {
    if !(st.ok) || st.len >= 512 { return IdentCopyWalk { ..st, ok: false }; }
    return IdentCopyWalk { bytes: replace(st.bytes, st.len, b), len: st.len + 1, ok: true };
}
fn append_ident_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, seed: IdentCopyWalk, start: u64, end: u64) -> (result: IdentCopyWalk) {
    if !(seed.ok) || end <= start || end > total { return IdentCopyWalk { ..seed, ok: false }; }
    let span_len: u64 = end - start;
    if span_len > 256 || seed.len + span_len > 512 { return IdentCopyWalk { ..seed, ok: false }; }
    iterate i up_to 256 carrying st: IdentCopyWalk = seed {
        if i >= span_len { return st; }
        let b: u64 = source.byte_at_global<P, N>(pages, stride, total, start + i);
        if b >= 256 { return IdentCopyWalk { ..st, ok: false }; }
        next st = append_ident_byte(st, b as byte);
    }
    return st;
}
fn canonical_finite_variant_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, mod_start: u64, mod_end: u64, enum_start: u64, enum_end: u64, var_start: u64, var_end: u64) -> (result: decl.SemanticIdentity) {
    // "mncs:0.2:finite-variant:" (24 bytes)
    let prefix: [byte; 24] = [
        109 as byte, 110 as byte, 99 as byte, 115 as byte, 58 as byte,
        48 as byte, 46 as byte, 50 as byte, 58 as byte,
        102 as byte, 105 as byte, 110 as byte, 105 as byte, 116 as byte, 101 as byte, 45 as byte,
        118 as byte, 97 as byte, 114 as byte, 105 as byte, 97 as byte, 110 as byte, 116 as byte, 58 as byte
    ];
    let seed: IdentCopyWalk = IdentCopyWalk { bytes: [0 as byte; 512], len: 0, ok: true };
    iterate i over prefix carrying w: IdentCopyWalk = seed { next w = append_ident_byte(w, prefix[i]); }
    let w1: IdentCopyWalk = append_ident_span<P, N>(pages, stride, total, w, mod_start, mod_end);
    let w2: IdentCopyWalk = append_ident_byte(append_ident_byte(w1, 58 as byte), 58 as byte);
    let w3: IdentCopyWalk = append_ident_span<P, N>(pages, stride, total, w2, enum_start, enum_end);
    let w4: IdentCopyWalk = append_ident_byte(append_ident_byte(w3, 58 as byte), 58 as byte);
    let w5: IdentCopyWalk = append_ident_span<P, N>(pages, stride, total, w4, var_start, var_end);
    return decl.SemanticIdentity { bytes: w5.bytes, len: w5.len, valid: w5.ok && w5.len > 24 };
}

record FiniteVariantsLowerWalk { rest: decl.VariantList, disc: u64, acc: VmFiniteVariantList, ok: bool }
fn lower_enum_decl_variants<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, enum_decl: decl.EnumDecl, nominals: decl.NominalTypeIdentityList) -> (result: FiniteVariantsLowerWalk) {
    let initial: FiniteVariantsLowerWalk = FiniteVariantsLowerWalk { rest: enum_decl.variants, disc: 0, acc: VmFiniteVariantList.VFVNil, ok: true };
    iterate i up_to 256 carrying st: FiniteVariantsLowerWalk = initial {
        if !(st.ok) || decl_variant_list_empty(st.rest) {
            return FiniteVariantsLowerWalk { rest: st.rest, disc: st.disc, acc: reverse_vm_finite_variants(st.acc), ok: st.ok && decl_variant_list_empty(st.rest) && st.disc > 0 };
        }
        next st = lower_enum_decl_variant_step<P, N>(pages, stride, total, header, enum_decl, nominals, st);
    }
    return FiniteVariantsLowerWalk { rest: st.rest, disc: st.disc, acc: reverse_vm_finite_variants(st.acc), ok: st.ok && decl_variant_list_empty(st.rest) && st.disc > 0 };
}
fn lower_enum_decl_variant_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, enum_decl: decl.EnumDecl, nominals: decl.NominalTypeIdentityList, st: FiniteVariantsLowerWalk) -> (result: FiniteVariantsLowerWalk) {
    return match st.rest {
        decl.VariantList.VNil => st,
        decl.VariantList.VCons { head: v, tail: rest } => lower_enum_decl_variant_one<P, N>(pages, stride, total, header, enum_decl, nominals, st, v, rest)
    };
}
fn lower_enum_decl_variant_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, enum_decl: decl.EnumDecl, nominals: decl.NominalTypeIdentityList, st: FiniteVariantsLowerWalk, v: decl.Variant, rest: decl.VariantList) -> (result: FiniteVariantsLowerWalk) {
    let vname: decl.SemanticIdentity = span_to_ident<P, N>(pages, stride, total, v.name_start, v.name_end);
    let vid: decl.SemanticIdentity = canonical_finite_variant_identity<P, N>(pages, stride, total, header.module_start, header.module_end, enum_decl.name_start, enum_decl.name_end, v.name_start, v.name_end);
    if !(vname.valid) || !(vid.valid) {
        return FiniteVariantsLowerWalk { rest: decl.VariantList.VNil, disc: st.disc, acc: st.acc, ok: false };
    }
    let lowered_fields: RecordFieldsLowerWalk = lower_record_decl_fields<P, N>(pages, stride, total, v.fields, nominals);
    if !(lowered_fields.ok) {
        return FiniteVariantsLowerWalk { rest: decl.VariantList.VNil, disc: st.disc, acc: st.acc, ok: false };
    }
    let item: VmFiniteVariant = VmFiniteVariant { identity: vid, name: vname, discriminant: st.disc, fields: lowered_fields.acc };
    return FiniteVariantsLowerWalk { rest: rest, disc: st.disc + 1, acc: VmFiniteVariantList.VFVCons { head: item, tail: st.acc }, ok: true };
}

record ModFinitesCollectWalk { rest: decl.EnumList, acc: VmFiniteTypeList }
fn collect_module_finite_types<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, unit: decl.Unit, nominals: decl.NominalTypeIdentityList, acc: VmFiniteTypeList) -> (result: VmFiniteTypeList) {
    let initial: ModFinitesCollectWalk = ModFinitesCollectWalk { rest: unit.enums, acc: acc };
    iterate i up_to 256 carrying st: ModFinitesCollectWalk = initial {
        if decl_enum_list_empty(st.rest) { return st.acc; }
        next st = collect_module_finite_step<P, N>(pages, stride, total, unit.header, nominals, st);
    }
    return st.acc;
}
fn collect_module_finite_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, nominals: decl.NominalTypeIdentityList, st: ModFinitesCollectWalk) -> (result: ModFinitesCollectWalk) {
    return match st.rest {
        decl.EnumList.GNil => st,
        decl.EnumList.GCons { head: ed, tail: rest } => collect_module_finite_one<P, N>(pages, stride, total, header, nominals, st, ed, rest)
    };
}
fn collect_module_finite_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, nominals: decl.NominalTypeIdentityList, st: ModFinitesCollectWalk, ed: decl.EnumDecl, rest: decl.EnumList) -> (result: ModFinitesCollectWalk) {
    let fid: decl.SemanticIdentity = decl.canonical_finite_type_identity<P, N>(pages, stride, total, header.module_start, header.module_end, ed.name_start, ed.name_end);
    let fname: decl.SemanticIdentity = span_to_ident<P, N>(pages, stride, total, ed.name_start, ed.name_end);
    if !(fid.valid) || !(fname.valid) { return ModFinitesCollectWalk { rest: rest, acc: st.acc }; }
    let existing: FiniteTypeLookup = find_vm_finite_type(st.acc, fid);
    if existing.found { return ModFinitesCollectWalk { rest: rest, acc: st.acc }; }
    let lowered_vars: FiniteVariantsLowerWalk = lower_enum_decl_variants<P, N>(pages, stride, total, header, ed, nominals);
    if !(lowered_vars.ok) { return ModFinitesCollectWalk { rest: rest, acc: st.acc }; }
    let schema: VmFiniteType = VmFiniteType { identity: fid, name: fname, variants: lowered_vars.acc };
    return ModFinitesCollectWalk { rest: rest, acc: VmFiniteTypeList.VFTCons { head: schema, tail: st.acc } };
}

record AllModFinitesWalk { rest: project.ProjectModuleList, reachable: [bool; 64], acc: VmFiniteTypeList }
fn collect_reachable_finite_types<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], modules: project.ProjectModuleList, reachable: [bool; 64]) -> (result: VmFiniteTypeList) {
    let initial: AllModFinitesWalk = AllModFinitesWalk { rest: modules, reachable: reachable, acc: VmFiniteTypeList.VFTNil };
    iterate i up_to 64 carrying st: AllModFinitesWalk = initial {
        if project_module_list_empty(st.rest) { return reverse_vm_finite_types(st.acc); }
        next st = collect_reachable_finite_step<M, N>(snapshot, flat_pages, st);
    }
    return reverse_vm_finite_types(st.acc);
}
fn collect_reachable_finite_step<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], st: AllModFinitesWalk) -> (result: AllModFinitesWalk) {
    return match st.rest {
        project.ProjectModuleList.PNil => st,
        project.ProjectModuleList.PCons { head: mod_item, tail: rest } => collect_reachable_finite_one<M, N>(snapshot, flat_pages, st, mod_item, rest)
    };
}
fn collect_reachable_finite_one<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], st: AllModFinitesWalk, mod_item: project.ProjectModule, rest: project.ProjectModuleList) -> (result: AllModFinitesWalk) {
    if mod_item.source_index >= 64 || !(st.reachable[mod_item.source_index]) {
        return AllModFinitesWalk { ..st, rest: rest };
    }
    let pages: [[byte; up_to N]; up_to 1024] = project.module_pages<M, N>(snapshot.sources, flat_pages, mod_item.source_index);
    let stride: u64 = project.module_stride(snapshot.sources, mod_item.source_index);
    let total: u64 = project.module_total(snapshot.sources, mod_item.source_index);
    let noms: decl.NominalTypeIdentityList = first_fn_nominals(mod_item.value_ssa);
    let next_acc: VmFiniteTypeList = collect_module_finite_types<1024, N>(pages, stride, total, mod_item.flow.proof.unit, noms, st.acc);
    return AllModFinitesWalk { rest: rest, reachable: st.reachable, acc: next_acc };
}

// Transitively retain record AND finite schemas referenced by emitted functions
// and by retained record fields / finite variant payloads.
record SchemaUsageState {
    all_recs: VmRecordTypeList,
    all_fins: VmFiniteTypeList,
    used_recs: VmRecordTypeList,
    rec_count: u64,
    used_fins: VmFiniteTypeList,
    fin_count: u64
}
fn add_used_schema_type(st: SchemaUsageState, ty: VmType) -> (result: SchemaUsageState) {
    if !(ty.valid) { return st; }
    if ty.kind == 5 {
        let already: RecordTypeLookup = find_vm_record_type(st.used_recs, ty.nominal_identity);
        if already.found { return st; }
        let found: RecordTypeLookup = find_vm_record_type(st.all_recs, ty.nominal_identity);
        if !(found.found) { return st; }
        return SchemaUsageState { ..st, used_recs: VmRecordTypeList.VRTCons { head: found.schema, tail: st.used_recs }, rec_count: st.rec_count + 1 };
    }
    if ty.kind == 7 {
        let already_f: FiniteTypeLookup = find_vm_finite_type(st.used_fins, ty.nominal_identity);
        if already_f.found { return st; }
        let found_f: FiniteTypeLookup = find_vm_finite_type(st.all_fins, ty.nominal_identity);
        if !(found_f.found) { return st; }
        return SchemaUsageState { ..st, used_fins: VmFiniteTypeList.VFTCons { head: found_f.schema, tail: st.used_fins }, fin_count: st.fin_count + 1 };
    }
    return st;
}
record SchemaValWalk { rest: VmValueList, st: SchemaUsageState }
fn collect_used_schemas_in_values(values: VmValueList, st: SchemaUsageState) -> (result: SchemaUsageState) {
    iterate i up_to 1024 carrying w: SchemaValWalk = SchemaValWalk { rest: values, st: st } {
        if vm_value_list_empty(w.rest) { return w.st; }
        next w = collect_used_schemas_in_val_step(w);
    }
    return w.st;
}
fn collect_used_schemas_in_val_step(w: SchemaValWalk) -> (result: SchemaValWalk) {
    return match w.rest {
        VVNil => w,
        VVCons { head: v, tail: rest } => SchemaValWalk { rest: rest, st: add_used_schema_type(w.st, v.ty) }
    };
}
record SchemaInstWalk { rest: VmInstructionList, st: SchemaUsageState }
fn collect_used_schemas_in_insts(insts: VmInstructionList, st: SchemaUsageState) -> (result: SchemaUsageState) {
    iterate i up_to 1024 carrying w: SchemaInstWalk = SchemaInstWalk { rest: insts, st: st } {
        if vm_inst_list_empty(w.rest) { return w.st; }
        next w = collect_used_schemas_in_inst_step(w);
    }
    return w.st;
}
fn collect_used_schemas_in_inst_step(w: SchemaInstWalk) -> (result: SchemaInstWalk) {
    return match w.rest {
        VINil => w,
        VICons { head: inst, tail: rest } => SchemaInstWalk { rest: rest, st: add_used_schema_type(add_used_schema_type(w.st, inst.ty), inst.from_ty) }
    };
}
record SchemaBlkWalk { rest: VmBlockList, st: SchemaUsageState }
fn collect_used_schemas_in_blocks(blocks: VmBlockList, st: SchemaUsageState) -> (result: SchemaUsageState) {
    iterate i up_to 1024 carrying w: SchemaBlkWalk = SchemaBlkWalk { rest: blocks, st: st } {
        if vm_block_list_empty(w.rest) { return w.st; }
        next w = collect_used_schemas_in_blk_step(w);
    }
    return w.st;
}
fn collect_used_schemas_in_blk_step(w: SchemaBlkWalk) -> (result: SchemaBlkWalk) {
    return match w.rest {
        VBNil => w,
        VBCons { head: blk, tail: rest } => SchemaBlkWalk { rest: rest, st: collect_used_schemas_in_insts(blk.instructions, collect_used_schemas_in_values(blk.parameters, w.st)) }
    };
}
record SchemaFnWalk { rest: VmFunctionList, st: SchemaUsageState }
fn collect_used_schemas_in_fns(fns: VmFunctionList, st: SchemaUsageState) -> (result: SchemaUsageState) {
    iterate i up_to 1024 carrying w: SchemaFnWalk = SchemaFnWalk { rest: fns, st: st } {
        if vm_fn_list_empty(w.rest) { return w.st; }
        next w = collect_used_schemas_in_fn_step(w);
    }
    return w.st;
}
fn collect_used_schemas_in_fn_step(w: SchemaFnWalk) -> (result: SchemaFnWalk) {
    return match w.rest {
        VFNil => w,
        VFCons { head: fn_item, tail: rest } => SchemaFnWalk { rest: rest, st: collect_used_schemas_in_blocks(fn_item.blocks, collect_used_schemas_in_values(fn_item.inputs, add_used_schema_type(w.st, fn_item.result_type))) }
    };
}
record SchemaFieldsWalk { rest: VmRecordFieldList, st: SchemaUsageState }
fn collect_used_schemas_in_fields(fields: VmRecordFieldList, st: SchemaUsageState) -> (result: SchemaUsageState) {
    iterate i up_to 128 carrying w: SchemaFieldsWalk = SchemaFieldsWalk { rest: fields, st: st } {
        if vm_record_field_list_empty(w.rest) { return w.st; }
        next w = collect_used_schemas_in_field_step(w);
    }
    return w.st;
}
fn collect_used_schemas_in_field_step(w: SchemaFieldsWalk) -> (result: SchemaFieldsWalk) {
    return match w.rest {
        VRFNil => w,
        VRFCons { head: f, tail: rest } => SchemaFieldsWalk { rest: rest, st: add_used_schema_type(w.st, f.ty) }
    };
}
record SchemaRecCloseWalk { rest: VmRecordTypeList, st: SchemaUsageState }
fn close_used_records_once(st: SchemaUsageState) -> (result: SchemaUsageState) {
    iterate i up_to 256 carrying w: SchemaRecCloseWalk = SchemaRecCloseWalk { rest: st.used_recs, st: st } {
        if vm_record_type_list_empty(w.rest) { return w.st; }
        next w = close_used_records_step(w);
    }
    return w.st;
}
fn close_used_records_step(w: SchemaRecCloseWalk) -> (result: SchemaRecCloseWalk) {
    return match w.rest {
        VRTNil => w,
        VRTCons { head: rec, tail: rest } => SchemaRecCloseWalk { rest: rest, st: collect_used_schemas_in_fields(rec.fields, w.st) }
    };
}
record SchemaVarsCloseWalk { rest: VmFiniteVariantList, st: SchemaUsageState }
fn collect_used_schemas_in_variants(vars: VmFiniteVariantList, st: SchemaUsageState) -> (result: SchemaUsageState) {
    iterate i up_to 256 carrying w: SchemaVarsCloseWalk = SchemaVarsCloseWalk { rest: vars, st: st } {
        if vm_finite_variant_list_empty(w.rest) { return w.st; }
        next w = collect_used_schemas_in_var_step(w);
    }
    return w.st;
}
fn collect_used_schemas_in_var_step(w: SchemaVarsCloseWalk) -> (result: SchemaVarsCloseWalk) {
    return match w.rest {
        VFVNil => w,
        VFVCons { head: v, tail: rest } => SchemaVarsCloseWalk { rest: rest, st: collect_used_schemas_in_fields(v.fields, w.st) }
    };
}
record SchemaFinCloseWalk { rest: VmFiniteTypeList, st: SchemaUsageState }
fn close_used_finites_once(st: SchemaUsageState) -> (result: SchemaUsageState) {
    iterate i up_to 256 carrying w: SchemaFinCloseWalk = SchemaFinCloseWalk { rest: st.used_fins, st: st } {
        if vm_finite_type_list_empty(w.rest) { return w.st; }
        next w = close_used_finites_step(w);
    }
    return w.st;
}
fn close_used_finites_step(w: SchemaFinCloseWalk) -> (result: SchemaFinCloseWalk) {
    return match w.rest {
        VFTNil => w,
        VFTCons { head: ft, tail: rest } => SchemaFinCloseWalk { rest: rest, st: collect_used_schemas_in_variants(ft.variants, w.st) }
    };
}
fn retain_referenced_schemas(schemas: VmSchemas, fns: VmFunctionList) -> (result: SchemaUsageState) {
    let seed: SchemaUsageState = SchemaUsageState {
        all_recs: schemas.records, all_fins: schemas.finites,
        used_recs: VmRecordTypeList.VRTNil, rec_count: 0,
        used_fins: VmFiniteTypeList.VFTNil, fin_count: 0
    };
    let direct: SchemaUsageState = collect_used_schemas_in_fns(fns, seed);
    iterate round up_to 16 carrying st: SchemaUsageState = direct {
        let s1: SchemaUsageState = close_used_records_once(st);
        let s2: SchemaUsageState = close_used_finites_once(s1);
        if s2.rec_count == st.rec_count && s2.fin_count == st.fin_count {
            return SchemaUsageState { ..s2, used_recs: reverse_vm_record_types(s2.used_recs), used_fins: reverse_vm_finite_types(s2.used_fins) };
        }
        next st = s2;
    }
    return SchemaUsageState { ..st, used_recs: reverse_vm_record_types(st.used_recs), used_fins: reverse_vm_finite_types(st.used_fins) };
}

// ---------------------------------------------------------------------------
// Value type maps & pure-scalar lowering helpers (preserved for single-module)
// ---------------------------------------------------------------------------

record VmValTypeLookup { found: bool, ty: VmType }
fn vm_val_head_id_eq(values: VmValueList, wanted: u64) -> (result: bool) {
    return match values { VVNil => false, VVCons { head: v, tail: t } => v.id == wanted };
}
fn vm_val_head_ty(values: VmValueList) -> (result: VmType) {
    return match values { VVNil => invalid_vm_type(), VVCons { head: v, tail: t } => v.ty };
}
fn vm_val_tail(values: VmValueList) -> (result: VmValueList) {
    return match values { VVNil => VmValueList.VVNil, VVCons { head: v, tail: t } => t };
}
fn lookup_vm_value_type(values: VmValueList, wanted: u64) -> (result: VmValTypeLookup) {
    iterate chunk up_to 8 carrying cur: VmValueList = values {
        if vm_value_list_empty(cur) { return VmValTypeLookup { found: false, ty: invalid_vm_type() }; }
        iterate i up_to 1024 carrying rest: VmValueList = cur {
            if vm_value_list_empty(rest) { return VmValTypeLookup { found: false, ty: invalid_vm_type() }; }
            if vm_val_head_id_eq(rest, wanted) { return VmValTypeLookup { found: true, ty: vm_val_head_ty(rest) }; }
            next rest = vm_val_tail(rest);
        }
        next cur = rest;
    }
    return VmValTypeLookup { found: false, ty: invalid_vm_type() };
}

record LowerValuesWalk { rest: ssa.ValueList, acc: VmValueList, ok: bool }
fn lower_vm_scalar_values(values: ssa.ValueList, reverse_output: bool) -> (result: LowerValuesWalk) {
    iterate i up_to 1024 carrying st: LowerValuesWalk = LowerValuesWalk { rest: values, acc: VmValueList.VVNil, ok: true } {
        if !(st.ok) || ssa_value_list_empty(st.rest) {
            return LowerValuesWalk { rest: st.rest, acc: select_vm_values(reverse_output, st.acc, reverse_vm_values(st.acc)), ok: st.ok && ssa_value_list_empty(st.rest) };
        }
        next st = lower_vm_scalar_value_step(st);
    }
    return LowerValuesWalk { rest: st.rest, acc: select_vm_values(reverse_output, st.acc, reverse_vm_values(st.acc)), ok: st.ok && ssa_value_list_empty(st.rest) };
}
fn select_vm_values(keep_reversed: bool, reversed: VmValueList, forward: VmValueList) -> (result: VmValueList) {
    if keep_reversed { return reversed; }
    return forward;
}
fn lower_vm_scalar_value_step(st: LowerValuesWalk) -> (result: LowerValuesWalk) {
    return match st.rest {
        ssa.ValueList.VNil => st,
        ssa.ValueList.VCons { head: v, tail: rest } => lower_vm_scalar_value_one(st, v, rest)
    };
}
fn lower_vm_scalar_value_one(st: LowerValuesWalk, v: ssa.Value, rest: ssa.ValueList) -> (result: LowerValuesWalk) {
    let vt: VmType = sem_type_to_vm_scalar(v.ty);
    if !(vt.valid) { return LowerValuesWalk { rest: rest, acc: st.acc, ok: false }; }
    return LowerValuesWalk { rest: rest, acc: VmValueList.VVCons { head: VmValue { id: v.id, ty: vt }, tail: st.acc }, ok: true };
}

// ---------------------------------------------------------------------------
// Instruction lowering (scalar + Call + SequenceLength + SequenceProject + RecordConstruct)
// ---------------------------------------------------------------------------

record InstLowerResult { ok: bool, error_code: u64, inst: VmInstruction }
fn dummy_vm_inst() -> (result: VmInstruction) {
    return VmInstruction {
        id: 0, result: 0, opcode: 0, op_code: 0, intent: 0, imm_u64: 0, imm_bool: false,
        ty: invalid_vm_type(), from_ty: invalid_vm_type(),
        inputs: ssa.IdList.INil, callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
    };
}
fn inst_error(code: u64) -> (result: InstLowerResult) {
    return InstLowerResult { ok: false, error_code: code, inst: dummy_vm_inst() };
}

fn compare_predicate_code(op: u64) -> (result: u64) {
    return match op {
        84 => 1,
        85 => 2,
        58 => 3,
        86 => 4,
        59 => 5,
        87 => 6,
        _ => 0
    };
}
fn integer_arith_op_code(op: u64) -> (result: u64) {
    return match op {
        50 => 1,
        91 => 1,
        94 => 1,
        51 => 2,
        92 => 2,
        95 => 2,
        52 => 3,
        93 => 3,
        96 => 3,
        53 => 4,
        54 => 5,
        55 => 6,
        56 => 7,
        57 => 8,
        88 => 9,
        89 => 10,
        _ => 0
    };
}
fn integer_arith_intent(op: u64) -> (result: u64) {
    return match op {
        55 => 2,
        56 => 2,
        57 => 2,
        88 => 2,
        89 => 2,
        91 => 2,
        92 => 2,
        93 => 2,
        94 => 3,
        95 => 3,
        96 => 3,
        _ => 1
    };
}

fn lower_vm_common_instruction(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType, callee_nat_args: VmNatArgList) -> (result: InstLowerResult) {
    if inst.kind == 0 {
        if !(id_list_empty(inst.inputs)) || (res_ty.kind != 2 && res_ty.kind != 3) { return inst_error(7); }
        return InstLowerResult {
            ok: true, error_code: 0,
            inst: VmInstruction {
                id: inst.id, result: inst.result, opcode: 1, op_code: 0, intent: 0,
                imm_u64: inst.operator, imm_bool: false,
                ty: res_ty, from_ty: invalid_vm_type(),
                inputs: ssa.IdList.INil, callee_identity: decl.invalid_semantic_identity(),
                callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
            }
        };
    }
    if inst.kind == 1 {
        if !(id_list_empty(inst.inputs)) || res_ty.kind != 1 { return inst_error(7); }
        return InstLowerResult {
            ok: true, error_code: 0,
            inst: VmInstruction {
                id: inst.id, result: inst.result, opcode: 2, op_code: 0, intent: 0,
                imm_u64: 0, imm_bool: inst.operator != 0,
                ty: res_ty, from_ty: invalid_vm_type(),
                inputs: ssa.IdList.INil, callee_identity: decl.invalid_semantic_identity(),
                callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
            }
        };
    }
    if inst.kind == 2 { return lower_vm_binary(val_types, inst, res_ty); }
    if inst.kind == 3 {
        if !(inst.identity.valid) || inst.identity.len == 0 { return inst_error(5); }
        return InstLowerResult {
            ok: true, error_code: 0,
            inst: VmInstruction {
                id: inst.id, result: inst.result, opcode: 13, op_code: 0, intent: 0,
                imm_u64: 0, imm_bool: false,
                ty: res_ty, from_ty: invalid_vm_type(),
                inputs: inst.inputs, callee_identity: inst.identity,
                callee_nat_args: callee_nat_args, field_names: VmNameList.VNNil
            }
        };
    }
    if inst.kind == 4 {
        if res_ty.kind != 1 || inst.argc != 1 { return inst_error(7); }
        return InstLowerResult {
            ok: true, error_code: 0,
            inst: VmInstruction {
                id: inst.id, result: inst.result, opcode: 10, op_code: 0, intent: 0,
                imm_u64: 0, imm_bool: false,
                ty: res_ty, from_ty: bool_vm_type(),
                inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
                callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
            }
        };
    }
    if inst.kind == 9 && inst.operator == 8 {
        if inst.argc != 3 { return inst_error(7); }
        return InstLowerResult {
            ok: true, error_code: 0,
            inst: VmInstruction {
                id: inst.id, result: inst.result, opcode: 12, op_code: 0, intent: 0,
                imm_u64: 0, imm_bool: false,
                ty: res_ty, from_ty: res_ty,
                inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
                callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
            }
        };
    }
    if inst.kind == 10 { return lower_vm_seq_length(val_types, inst, res_ty); }
    if inst.kind == 11 { return lower_vm_seq_index(val_types, inst, res_ty); }
    if inst.kind == 12 { return lower_vm_cast(val_types, inst, res_ty); }
    return inst_error(5);
}

fn lower_vm_seq_length(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType) -> (result: InstLowerResult) {
    if !(is_u64_vm_type(res_ty)) || inst.argc != 1 { return inst_error(7); }
    return match inst.inputs {
        ssa.IdList.INil => inst_error(7),
        ssa.IdList.ICons { head: base_id, tail: rest } => lower_vm_seq_length_one(val_types, inst, res_ty, base_id.value, rest)
    };
}
fn lower_vm_seq_length_one(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType, base_id: u64, rest: ssa.IdList) -> (result: InstLowerResult) {
    if !(id_list_empty(rest)) { return inst_error(7); }
    let base: VmValTypeLookup = lookup_vm_value_type(val_types, base_id);
    if !(base.found) || !(is_seq_vm_type(base.ty)) || base.ty.bound_value == 0 {
        return inst_error(7);
    }
    return InstLowerResult {
        ok: true, error_code: 0,
        inst: VmInstruction {
            id: inst.id, result: inst.result, opcode: 14, op_code: 0, intent: 0,
            imm_u64: 0, imm_bool: false,
            ty: res_ty, from_ty: base.ty,
            inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
            callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
        }
    };
}

fn lower_vm_seq_index(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType) -> (result: InstLowerResult) {
    let valid_res: bool = res_ty.valid && (is_scalar_vm_type(res_ty) || res_ty.kind == 4);
    if !(valid_res) || inst.argc != 2 { return inst_error(7); }
    return match inst.inputs {
        ssa.IdList.INil => inst_error(7),
        ssa.IdList.ICons { head: base_id, tail: rest } => lower_vm_seq_index_idx(val_types, inst, res_ty, base_id.value, rest)
    };
}
fn lower_vm_seq_index_idx(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType, base_id: u64, rest: ssa.IdList) -> (result: InstLowerResult) {
    return match rest {
        ssa.IdList.INil => inst_error(7),
        ssa.IdList.ICons { head: idx_id, tail: trailing } => lower_vm_seq_index_pair(val_types, inst, res_ty, base_id, idx_id.value, trailing)
    };
}
fn lower_vm_seq_index_pair(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType, base_id: u64, idx_id: u64, trailing: ssa.IdList) -> (result: InstLowerResult) {
    if !(id_list_empty(trailing)) { return inst_error(7); }
    let base: VmValTypeLookup = lookup_vm_value_type(val_types, base_id);
    let idx: VmValTypeLookup = lookup_vm_value_type(val_types, idx_id);
    if !(base.found) || !(is_seq_vm_type(base.ty)) || base.ty.bound_value == 0 { return inst_error(7); }
    let elem_ty: VmType = seq_element_vm_type(base.ty);
    if !(vm_type_equal(elem_ty, res_ty)) { return inst_error(7); }
    if !(idx.found) || !(is_u64_vm_type(idx.ty)) { return inst_error(7); }
    return InstLowerResult {
        ok: true, error_code: 0,
        inst: VmInstruction {
            id: inst.id, result: inst.result, opcode: 15, op_code: 0, intent: 0,
            imm_u64: 0, imm_bool: false,
            ty: res_ty, from_ty: base.ty,
            inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
            callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
        }
    };
}

record SeqConstructCheck {
    val_types: VmValueList,
    elem_ty: VmType,
    inputs: ssa.IdList,
    count: u64,
    ok: bool,
    done: bool
}
fn lower_vm_seq_construct(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType) -> (result: InstLowerResult) {
    if !(res_ty.valid) || res_ty.kind != 4 || res_ty.bound_kind != 1 || res_ty.bound_value == 0 {
        return inst_error(4);
    }
    if inst.argc != res_ty.bound_value || inst.operator != res_ty.bound_value {
        return inst_error(7);
    }
    let elem_ty: VmType = seq_element_vm_type(res_ty);
    if !(elem_ty.valid) { return inst_error(4); }
    let initial: SeqConstructCheck = SeqConstructCheck {
        val_types: val_types, elem_ty: elem_ty,
        inputs: inst.inputs, count: 0, ok: true, done: false
    };
    iterate i up_to 1024 carrying st: SeqConstructCheck = initial {
        if st.done || !(st.ok) {
            return finish_seq_construct(inst, res_ty, elem_ty, st);
        }
        next st = lower_vm_seq_construct_step(st);
    }
    return finish_seq_construct(inst, res_ty, elem_ty, st);
}
fn finish_seq_construct(inst: ssa.Instruction, res_ty: VmType, elem_ty: VmType, st: SeqConstructCheck) -> (result: InstLowerResult) {
    if !(st.ok) || !(st.done) || st.count != res_ty.bound_value { return inst_error(7); }
    return InstLowerResult {
        ok: true, error_code: 0,
        inst: VmInstruction {
            id: inst.id, result: inst.result, opcode: 19, op_code: 0, intent: 0,
            imm_u64: res_ty.bound_value, imm_bool: false,
            ty: res_ty, from_ty: elem_ty,
            inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
            callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
        }
    };
}
fn lower_vm_seq_construct_step(st: SeqConstructCheck) -> (result: SeqConstructCheck) {
    return match st.inputs {
        ssa.IdList.INil => SeqConstructCheck { ..st, ok: true, done: true },
        ssa.IdList.ICons { head: arg_id, tail: rest } => lower_vm_seq_construct_one(st, arg_id.value, rest)
    };
}
fn lower_vm_seq_construct_one(st: SeqConstructCheck, arg_id: u64, rest: ssa.IdList) -> (result: SeqConstructCheck) {
    let arg_lk: VmValTypeLookup = lookup_vm_value_type(st.val_types, arg_id);
    if !(arg_lk.found) || !(vm_type_equal(arg_lk.ty, st.elem_ty)) {
        return SeqConstructCheck { ..st, ok: false, done: true };
    }
    return SeqConstructCheck {
        val_types: st.val_types, elem_ty: st.elem_ty,
        inputs: rest, count: st.count + 1, ok: true, done: false
    };
}

record RecordConstructCheck {
    val_types: VmValueList,
    schema_fields: VmRecordFieldList,
    inputs: ssa.IdList,
    params: decl.BindList,
    names_acc: VmNameList,
    count: u64,
    ok: bool,
    done: bool
}
fn lower_vm_record_construct<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, val_types: VmValueList, all_recs: VmRecordTypeList, inst: ssa.Instruction, res_ty: VmType) -> (result: InstLowerResult) {
    if !(inst.nominal_identity.valid) || res_ty.kind != 5 || !(semantic_ids_equal(res_ty.nominal_identity, inst.nominal_identity)) {
        return inst_error(4);
    }
    let schema_lk: RecordTypeLookup = find_vm_record_type(all_recs, inst.nominal_identity);
    if !(schema_lk.found) { return inst_error(4); }
    let expected_fields: u64 = count_vm_record_fields(schema_lk.schema.fields);
    if inst.argc != expected_fields { return inst_error(7); }
    let initial: RecordConstructCheck = RecordConstructCheck {
        val_types: val_types, schema_fields: schema_lk.schema.fields,
        inputs: inst.inputs, params: inst.params,
        names_acc: VmNameList.VNNil, count: 0, ok: true, done: false
    };
    iterate i up_to 128 carrying st: RecordConstructCheck = initial {
        if st.done || !(st.ok) {
            return finish_record_construct(inst, res_ty, expected_fields, st);
        }
        next st = lower_vm_record_construct_step<P, N>(pages, stride, total, st);
    }
    return finish_record_construct(inst, res_ty, expected_fields, st);
}
fn finish_record_construct(inst: ssa.Instruction, res_ty: VmType, expected_fields: u64, st: RecordConstructCheck) -> (result: InstLowerResult) {
    if !(st.ok) || !(st.done) || st.count != expected_fields { return inst_error(7); }
    return InstLowerResult {
        ok: true, error_code: 0,
        inst: VmInstruction {
            id: inst.id, result: inst.result, opcode: 16, op_code: 0, intent: 0,
            imm_u64: 0, imm_bool: false,
            ty: res_ty, from_ty: invalid_vm_type(),
            inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
            callee_nat_args: VmNatArgList.NANil, field_names: reverse_vm_names(st.names_acc)
        }
    };
}
fn lower_vm_record_construct_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecordConstructCheck) -> (result: RecordConstructCheck) {
    return match st.inputs {
        ssa.IdList.INil => RecordConstructCheck { ..st, ok: decl_bind_list_empty(st.params), done: true },
        ssa.IdList.ICons { head: arg_id, tail: arg_rest } => lower_vm_record_construct_pair<P, N>(pages, stride, total, st, arg_id.value, arg_rest)
    };
}
fn lower_vm_record_construct_pair<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecordConstructCheck, arg_id: u64, arg_rest: ssa.IdList) -> (result: RecordConstructCheck) {
    return match st.params {
        decl.BindList.BNil => RecordConstructCheck { ..st, ok: false, done: true },
        decl.BindList.BCons { head: bind, tail: bind_rest } => lower_vm_record_construct_one<P, N>(pages, stride, total, st, arg_id, arg_rest, bind, bind_rest)
    };
}
fn lower_vm_record_construct_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecordConstructCheck, arg_id: u64, arg_rest: ssa.IdList, bind: decl.Bind, bind_rest: decl.BindList) -> (result: RecordConstructCheck) {
    let fname: decl.SemanticIdentity = span_to_ident<P, N>(pages, stride, total, bind.start, bind.end);
    if !(fname.valid) || vm_name_list_contains(st.names_acc, fname) {
        return RecordConstructCheck { ..st, ok: false, done: true };
    }
    let fld_lk: RecordFieldLookup = find_vm_record_field(st.schema_fields, fname);
    let arg_lk: VmValTypeLookup = lookup_vm_value_type(st.val_types, arg_id);
    if !(fld_lk.found) || !(arg_lk.found) || !(vm_type_equal(arg_lk.ty, fld_lk.ty)) {
        return RecordConstructCheck { ..st, ok: false, done: true };
    }
    return RecordConstructCheck {
        val_types: st.val_types, schema_fields: st.schema_fields,
        inputs: arg_rest, params: bind_rest,
        names_acc: VmNameList.VNCons { head: fname, tail: st.names_acc },
        count: st.count + 1, ok: true, done: false
    };
}

// Functional record update (`Rec { ..base, f1: v1, ... }`, kind 16 operator 1):
// validates base owner and every override against the nominal record schema,
// projects unchanged fields from `base` via canonical `RecordProject` (opcode 18),
// and emits a full `RecordConstruct` (opcode 16) in canonical schema field order.
record RecordOverride { name: decl.SemanticIdentity, val_id: u64 }
enum RecordOverrideList { RONil, ROCons { head: RecordOverride, tail: RecordOverrideList } }
fn record_override_list_empty(xs: RecordOverrideList) -> (result: bool) {
    return match xs { RONil => true, ROCons { head: h, tail: t } => false };
}
record RecordOverrideLookup { found: bool, val_id: u64 }
record RecordOverrideSearch { rest: RecordOverrideList, wanted: decl.SemanticIdentity, found: bool, val_id: u64 }
fn find_record_override(overrides: RecordOverrideList, wanted: decl.SemanticIdentity) -> (result: RecordOverrideLookup) {
    let initial: RecordOverrideSearch = RecordOverrideSearch { rest: overrides, wanted: wanted, found: false, val_id: 0 };
    iterate i up_to 128 carrying st: RecordOverrideSearch = initial {
        if st.found || record_override_list_empty(st.rest) {
            return RecordOverrideLookup { found: st.found, val_id: st.val_id };
        }
        next st = find_record_override_step(st);
    }
    return RecordOverrideLookup { found: st.found, val_id: st.val_id };
}
fn find_record_override_step(st: RecordOverrideSearch) -> (result: RecordOverrideSearch) {
    return match st.rest {
        RONil => st,
        ROCons { head: item, tail: rest } => find_record_override_one(st, item, rest)
    };
}
fn find_record_override_one(st: RecordOverrideSearch, item: RecordOverride, rest: RecordOverrideList) -> (result: RecordOverrideSearch) {
    if semantic_ids_equal(item.name, st.wanted) {
        return RecordOverrideSearch { rest: RecordOverrideList.RONil, wanted: st.wanted, found: true, val_id: item.val_id };
    }
    return RecordOverrideSearch { ..st, rest: rest };
}

record RecordUpdateOverrideCheck {
    val_types: VmValueList,
    schema_fields: VmRecordFieldList,
    inputs: ssa.IdList,
    params: decl.BindList,
    names_seen: VmNameList,
    overrides: RecordOverrideList,
    count: u64,
    ok: bool,
    done: bool
}
fn check_record_update_overrides<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, val_types: VmValueList, schema_fields: VmRecordFieldList, override_inputs: ssa.IdList, params: decl.BindList) -> (result: RecordUpdateOverrideCheck) {
    let initial: RecordUpdateOverrideCheck = RecordUpdateOverrideCheck {
        val_types: val_types, schema_fields: schema_fields,
        inputs: override_inputs, params: params,
        names_seen: VmNameList.VNNil, overrides: RecordOverrideList.RONil,
        count: 0, ok: true, done: false
    };
    iterate i up_to 128 carrying st: RecordUpdateOverrideCheck = initial {
        if st.done || !(st.ok) { return st; }
        next st = check_record_update_override_step<P, N>(pages, stride, total, st);
    }
    return st;
}
fn check_record_update_override_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecordUpdateOverrideCheck) -> (result: RecordUpdateOverrideCheck) {
    return match st.inputs {
        ssa.IdList.INil => RecordUpdateOverrideCheck { ..st, ok: decl_bind_list_empty(st.params), done: true },
        ssa.IdList.ICons { head: arg_id, tail: arg_rest } => check_record_update_override_pair<P, N>(pages, stride, total, st, arg_id.value, arg_rest)
    };
}
fn check_record_update_override_pair<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecordUpdateOverrideCheck, arg_id: u64, arg_rest: ssa.IdList) -> (result: RecordUpdateOverrideCheck) {
    return match st.params {
        decl.BindList.BNil => RecordUpdateOverrideCheck { ..st, ok: false, done: true },
        decl.BindList.BCons { head: bind, tail: bind_rest } => check_record_update_override_one<P, N>(pages, stride, total, st, arg_id, arg_rest, bind, bind_rest)
    };
}
fn check_record_update_override_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: RecordUpdateOverrideCheck, arg_id: u64, arg_rest: ssa.IdList, bind: decl.Bind, bind_rest: decl.BindList) -> (result: RecordUpdateOverrideCheck) {
    let fname: decl.SemanticIdentity = span_to_ident<P, N>(pages, stride, total, bind.start, bind.end);
    if !(fname.valid) || vm_name_list_contains(st.names_seen, fname) {
        return RecordUpdateOverrideCheck { ..st, ok: false, done: true };
    }
    let fld_lk: RecordFieldLookup = find_vm_record_field(st.schema_fields, fname);
    let arg_lk: VmValTypeLookup = lookup_vm_value_type(st.val_types, arg_id);
    if !(fld_lk.found) || !(arg_lk.found) || !(vm_type_equal(arg_lk.ty, fld_lk.ty)) {
        return RecordUpdateOverrideCheck { ..st, ok: false, done: true };
    }
    return RecordUpdateOverrideCheck {
        val_types: st.val_types, schema_fields: st.schema_fields,
        inputs: arg_rest, params: bind_rest,
        names_seen: VmNameList.VNCons { head: fname, tail: st.names_seen },
        overrides: RecordOverrideList.ROCons { head: RecordOverride { name: fname, val_id: arg_id }, tail: st.overrides },
        count: st.count + 1, ok: true, done: false
    };
}

record RecordUpdateEmitWalk {
    rest_fields: VmRecordFieldList,
    field_index: u64,
    base_id: u64,
    base_ty: VmType,
    overrides: RecordOverrideList,
    val_types: VmValueList,
    inst_acc: VmInstructionList,
    inst_count: u64,
    next_val_id: u64,
    next_inst_id: u64,
    construct_inputs_rev: ssa.IdList,
    construct_names_rev: VmNameList
}
fn emit_record_update_fields(initial: RecordUpdateEmitWalk) -> (result: RecordUpdateEmitWalk) {
    iterate i up_to 128 carrying w: RecordUpdateEmitWalk = initial {
        if vm_record_field_list_empty(w.rest_fields) { return w; }
        next w = emit_record_update_field_step(w);
    }
    return w;
}
fn emit_record_update_field_step(w: RecordUpdateEmitWalk) -> (result: RecordUpdateEmitWalk) {
    return match w.rest_fields {
        VRFNil => w,
        VRFCons { head: fld, tail: rest } => emit_record_update_field_one(w, fld, rest)
    };
}
fn emit_record_update_field_one(w: RecordUpdateEmitWalk, fld: VmRecordField, rest: VmRecordFieldList) -> (result: RecordUpdateEmitWalk) {
    let ov: RecordOverrideLookup = find_record_override(w.overrides, fld.name);
    if ov.found {
        return RecordUpdateEmitWalk {
            ..w,
            rest_fields: rest,
            field_index: w.field_index + 1,
            construct_inputs_rev: ssa.IdList.ICons { head: ssa.Id { value: ov.val_id }, tail: w.construct_inputs_rev },
            construct_names_rev: VmNameList.VNCons { head: fld.name, tail: w.construct_names_rev }
        };
    }
    let proj_val_id: u64 = w.next_val_id;
    let proj_inst_id: u64 = w.next_inst_id;
    let proj_inst: VmInstruction = VmInstruction {
        id: proj_inst_id, result: proj_val_id, opcode: 18, op_code: w.field_index, intent: 0,
        imm_u64: 0, imm_bool: false,
        ty: fld.ty, from_ty: w.base_ty,
        inputs: ssa.IdList.ICons { head: ssa.Id { value: w.base_id }, tail: ssa.IdList.INil },
        callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil,
        field_names: VmNameList.VNCons { head: fld.name, tail: VmNameList.VNNil }
    };
    return RecordUpdateEmitWalk {
        rest_fields: rest,
        field_index: w.field_index + 1,
        base_id: w.base_id,
        base_ty: w.base_ty,
        overrides: w.overrides,
        val_types: VmValueList.VVCons { head: VmValue { id: proj_val_id, ty: fld.ty }, tail: w.val_types },
        inst_acc: VmInstructionList.VICons { head: proj_inst, tail: w.inst_acc },
        inst_count: w.inst_count + 1,
        next_val_id: proj_val_id + 1,
        next_inst_id: proj_inst_id + 1,
        construct_inputs_rev: ssa.IdList.ICons { head: ssa.Id { value: proj_val_id }, tail: w.construct_inputs_rev },
        construct_names_rev: VmNameList.VNCons { head: fld.name, tail: w.construct_names_rev }
    };
}

fn lower_vm_record_update<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, all_recs: VmRecordTypeList, st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, res_ty: VmType) -> (result: SpecInstListWalk) {
    if !(inst.nominal_identity.valid) || res_ty.kind != 5 || !(semantic_ids_equal(res_ty.nominal_identity, inst.nominal_identity)) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 4, error_inst: inst.id };
    }
    let schema_lk: RecordTypeLookup = find_vm_record_type(all_recs, inst.nominal_identity);
    if !(schema_lk.found) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 4, error_inst: inst.id };
    }
    if inst.argc < 1 {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id };
    }
    return match inst.inputs {
        ssa.IdList.INil => SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id },
        ssa.IdList.ICons { head: base_id, tail: override_inputs } => lower_vm_record_update_body<P, N>(pages, stride, total, schema_lk.schema, st, inst, rest, res_ty, base_id.value, override_inputs)
    };
}
fn lower_vm_record_update_body<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, schema: VmRecordType, st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, res_ty: VmType, base_id: u64, override_inputs: ssa.IdList) -> (result: SpecInstListWalk) {
    let base_lk: VmValTypeLookup = lookup_vm_value_type(st.val_types, base_id);
    if !(base_lk.found) || !(base_lk.ty.valid) || base_lk.ty.kind != 5 || !(semantic_ids_equal(base_lk.ty.nominal_identity, inst.nominal_identity)) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id };
    }
    let checked: RecordUpdateOverrideCheck = check_record_update_overrides<P, N>(pages, stride, total, st.val_types, schema.fields, override_inputs, inst.params);
    if !(checked.ok) || !(checked.done) || checked.count + 1 != inst.argc {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id };
    }
    let built: RecordUpdateEmitWalk = emit_record_update_fields(RecordUpdateEmitWalk {
        rest_fields: schema.fields,
        field_index: 0,
        base_id: base_id,
        base_ty: base_lk.ty,
        overrides: checked.overrides,
        val_types: st.val_types,
        inst_acc: st.acc,
        inst_count: st.count,
        next_val_id: st.next_val_id,
        next_inst_id: st.next_inst_id,
        construct_inputs_rev: ssa.IdList.INil,
        construct_names_rev: VmNameList.VNNil
    });
    let rc_inst: VmInstruction = VmInstruction {
        id: inst.id, result: inst.result, opcode: 16, op_code: 0, intent: 0,
        imm_u64: 0, imm_bool: false,
        ty: res_ty, from_ty: invalid_vm_type(),
        inputs: reverse_ssa_ids(built.construct_inputs_rev),
        callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil,
        field_names: reverse_vm_names(built.construct_names_rev)
    };
    return SpecInstListWalk {
        rest: rest,
        val_types: built.val_types,
        acc: VmInstructionList.VICons { head: rc_inst, tail: built.inst_acc },
        count: built.inst_count + 1,
        next_val_id: built.next_val_id,
        next_inst_id: built.next_inst_id,
        ok: true, error_code: 0, error_inst: 0
    };
}

fn lower_vm_record_project<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, val_types: VmValueList, all_recs: VmRecordTypeList, inst: ssa.Instruction, res_ty: VmType) -> (result: InstLowerResult) {
    if inst.argc != 1 || !(inst.nominal_identity.valid) || inst.binding_end <= inst.binding_start {
        return inst_error(7);
    }
    return match inst.inputs {
        ssa.IdList.INil => inst_error(7),
        ssa.IdList.ICons { head: base_id, tail: rest } => lower_vm_record_project_one<P, N>(pages, stride, total, val_types, all_recs, inst, res_ty, base_id.value, rest)
    };
}
fn lower_vm_record_project_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, val_types: VmValueList, all_recs: VmRecordTypeList, inst: ssa.Instruction, res_ty: VmType, base_id: u64, rest: ssa.IdList) -> (result: InstLowerResult) {
    if !(id_list_empty(rest)) { return inst_error(7); }
    let base_lk: VmValTypeLookup = lookup_vm_value_type(val_types, base_id);
    if !(base_lk.found) || !(base_lk.ty.valid) || base_lk.ty.kind != 5 || !(base_lk.ty.nominal_identity.valid) {
        return inst_error(4);
    }
    if !(semantic_ids_equal(base_lk.ty.nominal_identity, inst.nominal_identity)) {
        return inst_error(7);
    }
    let schema_lk: RecordTypeLookup = find_vm_record_type(all_recs, inst.nominal_identity);
    if !(schema_lk.found) { return inst_error(4); }
    let fname: decl.SemanticIdentity = span_to_ident<P, N>(pages, stride, total, inst.binding_start, inst.binding_end);
    if !(fname.valid) { return inst_error(7); }
    let fld_at: RecordFieldAtLookup = find_vm_record_field_at(schema_lk.schema.fields, inst.operator);
    if !(fld_at.found) || !(semantic_ids_equal(fld_at.name, fname)) {
        return inst_error(7);
    }
    if !(res_ty.valid) || !(vm_type_equal(res_ty, fld_at.ty)) {
        return inst_error(7);
    }
    return InstLowerResult {
        ok: true, error_code: 0,
        inst: VmInstruction {
            id: inst.id, result: inst.result, opcode: 18, op_code: inst.operator, intent: 0,
            imm_u64: 0, imm_bool: false,
            ty: res_ty, from_ty: base_lk.ty,
            inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
            callee_nat_args: VmNatArgList.NANil,
            field_names: VmNameList.VNCons { head: fld_at.name, tail: VmNameList.VNNil }
        }
    };
}

fn lower_vm_finite_construct<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, val_types: VmValueList, all_fins: VmFiniteTypeList, inst: ssa.Instruction, res_ty: VmType) -> (result: InstLowerResult) {
    if !(inst.nominal_identity.valid) || res_ty.kind != 7 || !(semantic_ids_equal(res_ty.nominal_identity, inst.nominal_identity)) {
        return inst_error(4);
    }
    if inst.variant_end <= inst.variant_start { return inst_error(7); }
    let schema_lk: FiniteTypeLookup = find_vm_finite_type(all_fins, inst.nominal_identity);
    if !(schema_lk.found) { return inst_error(4); }
    let vname: decl.SemanticIdentity = span_to_ident<P, N>(pages, stride, total, inst.variant_start, inst.variant_end);
    if !(vname.valid) { return inst_error(7); }
    let var_lk: FiniteVariantLookup = find_vm_finite_variant(schema_lk.schema.variants, vname);
    if !(var_lk.found) { return inst_error(7); }
    let expected_fields: u64 = count_vm_record_fields(var_lk.variant.fields);
    if inst.argc != expected_fields { return inst_error(7); }
    let initial: RecordConstructCheck = RecordConstructCheck {
        val_types: val_types, schema_fields: var_lk.variant.fields,
        inputs: inst.inputs, params: inst.params,
        names_acc: VmNameList.VNNil, count: 0, ok: true, done: false
    };
    iterate i up_to 128 carrying st: RecordConstructCheck = initial {
        if st.done || !(st.ok) {
            return finish_finite_construct(inst, res_ty, var_lk.variant, expected_fields, st);
        }
        next st = lower_vm_record_construct_step<P, N>(pages, stride, total, st);
    }
    return finish_finite_construct(inst, res_ty, var_lk.variant, expected_fields, st);
}
fn finish_finite_construct(inst: ssa.Instruction, res_ty: VmType, variant: VmFiniteVariant, expected_fields: u64, st: RecordConstructCheck) -> (result: InstLowerResult) {
    if !(st.ok) || !(st.done) || st.count != expected_fields { return inst_error(7); }
    return InstLowerResult {
        ok: true, error_code: 0,
        inst: VmInstruction {
            id: inst.id, result: inst.result, opcode: 20, op_code: variant.discriminant, intent: 0,
            imm_u64: 0, imm_bool: false,
            ty: res_ty, from_ty: invalid_vm_type(),
            inputs: inst.inputs, callee_identity: variant.identity,
            callee_nat_args: VmNatArgList.NANil, field_names: reverse_vm_names(st.names_acc)
        }
    };
}

fn lower_vm_finite_payload_project<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, val_types: VmValueList, all_fins: VmFiniteTypeList, inst: ssa.Instruction, res_ty: VmType) -> (result: InstLowerResult) {
    if inst.argc != 1 || !(inst.nominal_identity.valid) || inst.variant_end <= inst.variant_start {
        return inst_error(7);
    }
    return match inst.inputs {
        ssa.IdList.INil => inst_error(7),
        ssa.IdList.ICons { head: base_id, tail: rest } => lower_vm_finite_payload_project_param<P, N>(pages, stride, total, val_types, all_fins, inst, res_ty, base_id.value, rest)
    };
}
fn lower_vm_finite_payload_project_param<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, val_types: VmValueList, all_fins: VmFiniteTypeList, inst: ssa.Instruction, res_ty: VmType, base_id: u64, rest: ssa.IdList) -> (result: InstLowerResult) {
    if !(id_list_empty(rest)) { return inst_error(7); }
    return match inst.params {
        decl.BindList.BNil => inst_error(7),
        decl.BindList.BCons { head: bind, tail: prest } => lower_vm_finite_payload_project_one<P, N>(pages, stride, total, val_types, all_fins, inst, res_ty, base_id, bind, prest)
    };
}
fn lower_vm_finite_payload_project_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, val_types: VmValueList, all_fins: VmFiniteTypeList, inst: ssa.Instruction, res_ty: VmType, base_id: u64, bind: decl.Bind, prest: decl.BindList) -> (result: InstLowerResult) {
    if !(decl_bind_list_empty(prest)) { return inst_error(7); }
    let base_lk: VmValTypeLookup = lookup_vm_value_type(val_types, base_id);
    if !(base_lk.found) || !(base_lk.ty.valid) || base_lk.ty.kind != 7 || !(base_lk.ty.nominal_identity.valid) {
        return inst_error(4);
    }
    if !(semantic_ids_equal(base_lk.ty.nominal_identity, inst.nominal_identity)) {
        return inst_error(7);
    }
    let schema_lk: FiniteTypeLookup = find_vm_finite_type(all_fins, inst.nominal_identity);
    if !(schema_lk.found) { return inst_error(4); }
    let vname: decl.SemanticIdentity = span_to_ident<P, N>(pages, stride, total, inst.variant_start, inst.variant_end);
    if !(vname.valid) { return inst_error(7); }
    let var_lk: FiniteVariantLookup = find_vm_finite_variant(schema_lk.schema.variants, vname);
    if !(var_lk.found) { return inst_error(7); }
    let fname: decl.SemanticIdentity = span_to_ident<P, N>(pages, stride, total, bind.start, bind.end);
    if !(fname.valid) { return inst_error(7); }
    let fld_lk: RecordFieldLookup = find_vm_record_field(var_lk.variant.fields, fname);
    if !(fld_lk.found) || !(res_ty.valid) || !(vm_type_equal(res_ty, fld_lk.ty)) {
        return inst_error(7);
    }
    return InstLowerResult {
        ok: true, error_code: 0,
        inst: VmInstruction {
            id: inst.id, result: inst.result, opcode: 21, op_code: var_lk.variant.discriminant, intent: 0,
            imm_u64: 0, imm_bool: false,
            ty: res_ty, from_ty: base_lk.ty,
            inputs: inst.inputs, callee_identity: var_lk.variant.identity,
            callee_nat_args: VmNatArgList.NANil,
            field_names: VmNameList.VNCons { head: fname, tail: VmNameList.VNNil }
        }
    };
}

fn lower_vm_cast(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType) -> (result: InstLowerResult) {
    if !(is_scalar_vm_type(res_ty)) { return inst_error(4); }
    return match inst.inputs {
        ssa.IdList.INil => inst_error(7),
        ssa.IdList.ICons { head: src, tail: rest } => lower_vm_cast_one(val_types, inst, res_ty, src, rest)
    };
}
fn lower_vm_cast_one(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType, src: ssa.Id, rest: ssa.IdList) -> (result: InstLowerResult) {
    if !(id_list_empty(rest)) { return inst_error(7); }
    let src_ty: VmValTypeLookup = lookup_vm_value_type(val_types, src.value);
    if !(src_ty.found) || !(is_scalar_vm_type(src_ty.ty)) { return inst_error(7); }
    return InstLowerResult {
        ok: true, error_code: 0,
        inst: VmInstruction {
            id: inst.id, result: inst.result, opcode: 11, op_code: 0, intent: 0,
            imm_u64: 0, imm_bool: false,
            ty: res_ty, from_ty: src_ty.ty,
            inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
            callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
        }
    };
}

fn lower_vm_binary(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType) -> (result: InstLowerResult) {
    return match inst.inputs {
        ssa.IdList.INil => inst_error(7),
        ssa.IdList.ICons { head: left, tail: rest } => lower_vm_binary_right(val_types, inst, res_ty, left, rest)
    };
}
fn lower_vm_binary_right(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType, left: ssa.Id, rest: ssa.IdList) -> (result: InstLowerResult) {
    return match rest {
        ssa.IdList.INil => inst_error(7),
        ssa.IdList.ICons { head: right, tail: trailing } => lower_vm_binary_pair(val_types, inst, res_ty, left, right, trailing)
    };
}
fn lower_vm_binary_pair(val_types: VmValueList, inst: ssa.Instruction, res_ty: VmType, left: ssa.Id, right: ssa.Id, trailing: ssa.IdList) -> (result: InstLowerResult) {
    if !(id_list_empty(trailing)) { return inst_error(7); }
    let lhs: VmValTypeLookup = lookup_vm_value_type(val_types, left.value);
    let rhs: VmValTypeLookup = lookup_vm_value_type(val_types, right.value);
    if !(lhs.found) || !(rhs.found) || !(vm_type_equal(lhs.ty, rhs.ty)) { return inst_error(7); }
    let op: u64 = inst.operator;
    if lhs.ty.kind == 1 {
        if op == 82 || op == 83 {
            let code: u64 = select(op == 82, 11, 12);
            return InstLowerResult {
                ok: true, error_code: 0,
                inst: VmInstruction {
                    id: inst.id, result: inst.result, opcode: 8, op_code: code, intent: 0,
                    imm_u64: 0, imm_bool: false, ty: res_ty, from_ty: lhs.ty,
                    inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
                    callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
                }
            };
        }
        if op == 84 || op == 85 {
            let pred: u64 = select(op == 84, 1, 2);
            return InstLowerResult {
                ok: true, error_code: 0,
                inst: VmInstruction {
                    id: inst.id, result: inst.result, opcode: 9, op_code: pred, intent: 0,
                    imm_u64: 0, imm_bool: false, ty: res_ty, from_ty: lhs.ty,
                    inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
                    callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
                }
            };
        }
        return inst_error(5);
    }
    if lhs.ty.kind == 2 {
        let pred: u64 = compare_predicate_code(op);
        if pred > 0 {
            return InstLowerResult {
                ok: true, error_code: 0,
                inst: VmInstruction {
                    id: inst.id, result: inst.result, opcode: 5, op_code: pred, intent: 0,
                    imm_u64: 0, imm_bool: false, ty: res_ty, from_ty: lhs.ty,
                    inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
                    callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
                }
            };
        }
        if op == 55 || op == 56 || op == 57 {
            let bit: u64 = select(op == 55, 6, select(op == 56, 7, 8));
            return InstLowerResult {
                ok: true, error_code: 0,
                inst: VmInstruction {
                    id: inst.id, result: inst.result, opcode: 6, op_code: bit, intent: 0,
                    imm_u64: 0, imm_bool: false, ty: res_ty, from_ty: lhs.ty,
                    inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
                    callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
                }
            };
        }
        if op == 88 || op == 89 {
            let sh: u64 = select(op == 88, 9, 10);
            return InstLowerResult {
                ok: true, error_code: 0,
                inst: VmInstruction {
                    id: inst.id, result: inst.result, opcode: 7, op_code: sh, intent: 0,
                    imm_u64: 0, imm_bool: false, ty: res_ty, from_ty: lhs.ty,
                    inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
                    callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
                }
            };
        }
        return inst_error(5);
    }
    if lhs.ty.kind == 3 {
        let pred: u64 = compare_predicate_code(op);
        if pred > 0 {
            return InstLowerResult {
                ok: true, error_code: 0,
                inst: VmInstruction {
                    id: inst.id, result: inst.result, opcode: 4, op_code: pred, intent: 0,
                    imm_u64: 0, imm_bool: false, ty: res_ty, from_ty: lhs.ty,
                    inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
                    callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
                }
            };
        }
        let arith: u64 = integer_arith_op_code(op);
        if arith > 0 {
            return InstLowerResult {
                ok: true, error_code: 0,
                inst: VmInstruction {
                    id: inst.id, result: inst.result, opcode: 3, op_code: arith, intent: integer_arith_intent(op),
                    imm_u64: 0, imm_bool: false, ty: res_ty, from_ty: lhs.ty,
                    inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
                    callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
                }
            };
        }
        return inst_error(5);
    }
    return inst_error(4);
}

record TermLowerResult { ok: bool, error_code: u64, term: VmTerminator, is_error_path: bool }
fn lower_vm_terminator(term: ssa.Terminator) -> (result: TermLowerResult) {
    return match term {
        ssa.Terminator.Return { value: v } => TermLowerResult { ok: true, error_code: 0, term: VmTerminator.VmReturn { value: v }, is_error_path: false },
        ssa.Terminator.Jump { target: tgt, arguments: args } => TermLowerResult { ok: true, error_code: 0, term: VmTerminator.VmBranch { target: tgt, arguments: args }, is_error_path: false },
        ssa.Terminator.Branch { condition: cond, yes: yes_t, no: no_t, yes_args: ya, no_args: na } => TermLowerResult { ok: true, error_code: 0, term: VmTerminator.VmCondBranch { condition: cond, then_target: yes_t, then_arguments: ya, else_target: no_t, else_arguments: na }, is_error_path: false },
        ssa.Terminator.Fail => TermLowerResult { ok: true, error_code: 0, term: VmTerminator.VmFailure, is_error_path: true },
        ssa.Terminator.FiniteSwitch { subject: s, subject_ty: st, nominal_identity: ni, result_type: rt, source_start: ss, source_end: se, arm_count: ac, join_target: jt, cases: cs } => TermLowerResult { ok: false, error_code: 6, term: VmTerminator.VmFailure, is_error_path: false },
        ssa.Terminator.ScalarSwitch { subject: s, subject_ty: st, result_type: rt, source_start: ss, source_end: se, arm_count: ac, default_target: dt, join_target: jt, cases: cs } => TermLowerResult { ok: false, error_code: 6, term: VmTerminator.VmFailure, is_error_path: false }
    };
}

// ---------------------------------------------------------------------------
// ScalarSwitch lowering into canonical VM Constant + Compare + CondBranch chain
// ---------------------------------------------------------------------------

fn scalar_cases_empty(cases: ssa.ScalarMatchCaseList) -> (result: bool) {
    return match cases {
        ssa.ScalarMatchCaseList.SCNil => true,
        ssa.ScalarMatchCaseList.SCCons { head: h, tail: t } => false
    };
}
fn dummy_scalar_case() -> (result: ssa.ScalarMatchCase) {
    return ssa.ScalarMatchCase {
        is_default: false, negative: false, value: 0, overflow: false,
        pattern_start: 0, pattern_end: 0, target: 0, arguments: ssa.IdList.INil
    };
}
record ScalarCaseRev { rest: ssa.ScalarMatchCaseList, acc: ssa.ScalarMatchCaseList }
fn reverse_scalar_cases(cases: ssa.ScalarMatchCaseList) -> (result: ssa.ScalarMatchCaseList) {
    iterate i up_to 1024 carrying st: ScalarCaseRev = ScalarCaseRev { rest: cases, acc: ssa.ScalarMatchCaseList.SCNil } {
        if scalar_cases_empty(st.rest) { return st.acc; }
        next st = reverse_scalar_case_step(st);
    }
    return st.acc;
}
fn reverse_scalar_case_step(st: ScalarCaseRev) -> (result: ScalarCaseRev) {
    return match st.rest {
        ssa.ScalarMatchCaseList.SCNil => st,
        ssa.ScalarMatchCaseList.SCCons { head: h, tail: t } => ScalarCaseRev { rest: t, acc: ssa.ScalarMatchCaseList.SCCons { head: h, tail: st.acc } }
    };
}

fn scalar_case_value_fits(ty: VmType, val: u64) -> (result: bool) {
    if !(ty.valid) { return false; }
    if ty.kind == 2 { return val <= 255; }
    if ty.kind != 3 { return false; }
    if !(ty.signed) {
        if ty.bits == 8 { return val <= 255; }
        if ty.bits == 16 { return val <= 65535; }
        if ty.bits == 32 { return val <= 4294967295; }
        return ty.bits == 64;
    }
    if ty.bits == 8 { return val <= 127; }
    if ty.bits == 16 { return val <= 32767; }
    if ty.bits == 32 { return val <= 2147483647; }
    if ty.bits == 64 { return val <= 9223372036854775807; }
    return false;
}

fn append_two_vm_insts(insts: VmInstructionList, first: VmInstruction, second: VmInstruction) -> (result: VmInstructionList) {
    let rev: VmInstructionList = reverse_vm_insts(insts);
    let rev1: VmInstructionList = VmInstructionList.VICons { head: first, tail: rev };
    let rev2: VmInstructionList = VmInstructionList.VICons { head: second, tail: rev1 };
    return reverse_vm_insts(rev2);
}

fn make_scalar_const_inst(inst_id: u64, val_id: u64, ty: VmType, value: u64) -> (result: VmInstruction) {
    return VmInstruction {
        id: inst_id, result: val_id, opcode: 1, op_code: 0, intent: 0,
        imm_u64: value, imm_bool: false, ty: ty, from_ty: invalid_vm_type(),
        inputs: ssa.IdList.INil, callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
    };
}
fn make_scalar_eq_inst(inst_id: u64, val_id: u64, subj_ty: VmType, subject: u64, rhs_val: u64) -> (result: VmInstruction) {
    let cmp_opcode: u64 = select(subj_ty.kind == 2, 5, 4);
    let cmp_inputs: ssa.IdList = ssa.IdList.ICons {
        head: ssa.Id { value: subject },
        tail: ssa.IdList.ICons { head: ssa.Id { value: rhs_val }, tail: ssa.IdList.INil }
    };
    return VmInstruction {
        id: inst_id, result: val_id, opcode: cmp_opcode, op_code: 1, intent: 0,
        imm_u64: 0, imm_bool: false, ty: bool_vm_type(), from_ty: subj_ty,
        inputs: cmp_inputs, callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
    };
}

fn verify_scalar_switch_arm_target(all_blocks: ssa.SsaBlockList, target: u64, join_target: u64) -> (result: bool) {
    let blk_lk: SsaBlkLookup = find_ssa_block_by_id(all_blocks, target);
    if !(blk_lk.found) { return false; }
    return match blk_lk.blk.terminator {
        ssa.Terminator.Jump { target: tgt, arguments: args } => tgt == join_target,
        ssa.Terminator.Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => true,
        ssa.Terminator.ScalarSwitch { subject: s, subject_ty: st, result_type: rt, source_start: ss, source_end: se, arm_count: ac, default_target: dt, join_target: inner_jt, cases: cs } => verify_nested_scalar_join(all_blocks, inner_jt, join_target),
        ssa.Terminator.FiniteSwitch { subject: s, subject_ty: st, nominal_identity: ni, result_type: rt, source_start: ss, source_end: se, arm_count: ac, join_target: inner_jt, cases: cs } => false,
        ssa.Terminator.Return { value: v } => false,
        ssa.Terminator.Fail => false
    };
}
fn verify_nested_scalar_join(all_blocks: ssa.SsaBlockList, inner_jt: u64, outer_jt: u64) -> (result: bool) {
    let blk_lk: SsaBlkLookup = find_ssa_block_by_id(all_blocks, inner_jt);
    if !(blk_lk.found) { return false; }
    return match blk_lk.blk.terminator {
        ssa.Terminator.Jump { target: tgt, arguments: args } => tgt == outer_jt,
        ssa.Terminator.Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => false,
        ssa.Terminator.ScalarSwitch { subject: s, subject_ty: st, result_type: rt, source_start: ss, source_end: se, arm_count: ac, default_target: dt, join_target: jt, cases: cs } => false,
        ssa.Terminator.FiniteSwitch { subject: s, subject_ty: st, nominal_identity: ni, result_type: rt, source_start: ss, source_end: se, arm_count: ac, join_target: jt, cases: cs } => false,
        ssa.Terminator.Return { value: v } => false,
        ssa.Terminator.Fail => false
    };
}

fn verify_scalar_switch_join_head(all_blocks: ssa.SsaBlockList, val_types: VmValueList, blk_id: u64, join_target: u64, res_vm_ty: VmType, res_is_seq: bool) -> (result: bool) {
    if join_target == blk_id { return false; }
    let join_lk: SsaBlkLookup = find_ssa_block_by_id(all_blocks, join_target);
    if !(join_lk.found) { return false; }
    return match join_lk.blk.parameters {
        ssa.ValueList.VNil => false,
        ssa.ValueList.VCons { head: jres, tail: rest } => verify_join_head_value(val_types, jres.id, res_vm_ty, res_is_seq)
    };
}
fn verify_join_head_value(val_types: VmValueList, jres_id: u64, res_vm_ty: VmType, res_is_seq: bool) -> (result: bool) {
    let jlk: VmValTypeLookup = lookup_vm_value_type(val_types, jres_id);
    if !(jlk.found) || !(jlk.ty.valid) { return false; }
    if res_is_seq { return is_seq_vm_type(jlk.ty); }
    return res_vm_ty.valid && vm_type_equal(jlk.ty, res_vm_ty);
}

record ScalarSwitchScan {
    rest: ssa.ScalarMatchCaseList,
    seen_targets: ssa.IdList,
    seen_values: ssa.IdList,
    non_defaults_rev: ssa.ScalarMatchCaseList,
    default_case: ssa.ScalarMatchCase,
    default_count: u64,
    total_count: u64,
    ok: bool,
    error_code: u64
}
fn scan_scalar_switch_cases(all_blocks: ssa.SsaBlockList, blk_id: u64, subj_ty: VmType, arm_count: u64, default_target: u64, join_target: u64, cases: ssa.ScalarMatchCaseList) -> (result: ScalarSwitchScan) {
    let initial: ScalarSwitchScan = ScalarSwitchScan {
        rest: cases, seen_targets: ssa.IdList.INil, seen_values: ssa.IdList.INil,
        non_defaults_rev: ssa.ScalarMatchCaseList.SCNil, default_case: dummy_scalar_case(),
        default_count: 0, total_count: 0, ok: true, error_code: 0
    };
    if arm_count == 0 {
        return ScalarSwitchScan { ..initial, ok: false, error_code: 6 };
    }
    iterate i up_to 1024 carrying st: ScalarSwitchScan = initial {
        if !(st.ok) || scalar_cases_empty(st.rest) {
            return finish_scalar_switch_scan(st, arm_count);
        }
        next st = scan_scalar_switch_step(all_blocks, blk_id, subj_ty, default_target, join_target, st);
    }
    return finish_scalar_switch_scan(st, arm_count);
}
fn finish_scalar_switch_scan(st: ScalarSwitchScan, arm_count: u64) -> (result: ScalarSwitchScan) {
    if !(st.ok) { return st; }
    if !(scalar_cases_empty(st.rest)) || st.total_count != arm_count || st.default_count != 1 {
        return ScalarSwitchScan { ..st, ok: false, error_code: 7 };
    }
    return ScalarSwitchScan { ..st, non_defaults_rev: reverse_scalar_cases(st.non_defaults_rev) };
}
fn scan_scalar_switch_step(all_blocks: ssa.SsaBlockList, blk_id: u64, subj_ty: VmType, default_target: u64, join_target: u64, st: ScalarSwitchScan) -> (result: ScalarSwitchScan) {
    return match st.rest {
        ssa.ScalarMatchCaseList.SCNil => st,
        ssa.ScalarMatchCaseList.SCCons { head: cs, tail: rest } => scan_scalar_switch_one(all_blocks, blk_id, subj_ty, default_target, join_target, st, cs, rest)
    };
}
fn scan_scalar_switch_one(all_blocks: ssa.SsaBlockList, blk_id: u64, subj_ty: VmType, default_target: u64, join_target: u64, st: ScalarSwitchScan, cs: ssa.ScalarMatchCase, rest: ssa.ScalarMatchCaseList) -> (result: ScalarSwitchScan) {
    if cs.target == blk_id || cs.target == join_target || id_in_list(st.seen_targets, cs.target) {
        return ScalarSwitchScan { ..st, rest: ssa.ScalarMatchCaseList.SCNil, ok: false, error_code: 7 };
    }
    if !(verify_scalar_switch_arm_target(all_blocks, cs.target, join_target)) {
        return ScalarSwitchScan { ..st, rest: ssa.ScalarMatchCaseList.SCNil, ok: false, error_code: 7 };
    }
    let next_targets: ssa.IdList = ssa.IdList.ICons { head: ssa.Id { value: cs.target }, tail: st.seen_targets };
    if cs.is_default {
        if st.default_count > 0 || cs.target != default_target {
            return ScalarSwitchScan { ..st, rest: ssa.ScalarMatchCaseList.SCNil, ok: false, error_code: 7 };
        }
        return ScalarSwitchScan {
            rest: rest, seen_targets: next_targets, seen_values: st.seen_values,
            non_defaults_rev: st.non_defaults_rev, default_case: cs,
            default_count: st.default_count + 1, total_count: st.total_count + 1,
            ok: true, error_code: 0
        };
    }
    if cs.overflow || !(scalar_case_value_fits(subj_ty, cs.value)) {
        return ScalarSwitchScan { ..st, rest: ssa.ScalarMatchCaseList.SCNil, ok: false, error_code: 7 };
    }
    if cs.negative {
        return ScalarSwitchScan { ..st, rest: ssa.ScalarMatchCaseList.SCNil, ok: false, error_code: 6 };
    }
    if id_in_list(st.seen_values, cs.value) {
        return ScalarSwitchScan { ..st, rest: ssa.ScalarMatchCaseList.SCNil, ok: false, error_code: 7 };
    }
    let next_values: ssa.IdList = ssa.IdList.ICons { head: ssa.Id { value: cs.value }, tail: st.seen_values };
    return ScalarSwitchScan {
        rest: rest, seen_targets: next_targets, seen_values: next_values,
        non_defaults_rev: ssa.ScalarMatchCaseList.SCCons { head: cs, tail: st.non_defaults_rev },
        default_case: st.default_case, default_count: st.default_count,
        total_count: st.total_count + 1, ok: true, error_code: 0
    };
}

record ScalarSwitchLowerResult {
    ok: bool,
    error_code: u64,
    val_types: VmValueList,
    acc: VmBlockList,
    block_count: u64,
    inst_count: u64,
    next_val_id: u64,
    next_inst_id: u64,
    next_blk_id: u64
}
record DispatchChainWalk {
    rest: ssa.ScalarMatchCaseList,
    cur_blk_id: u64,
    val_types: VmValueList,
    acc: VmBlockList,
    block_count: u64,
    inst_count: u64,
    next_val_id: u64,
    next_inst_id: u64,
    next_blk_id: u64
}
fn emit_scalar_dispatch_chain(subject: u64, subj_ty: VmType, default_case: ssa.ScalarMatchCase, initial: DispatchChainWalk) -> (result: DispatchChainWalk) {
    iterate i up_to 1024 carrying st: DispatchChainWalk = initial {
        if scalar_cases_empty(st.rest) { return st; }
        next st = emit_scalar_dispatch_step(subject, subj_ty, default_case, st);
    }
    return st;
}
fn emit_scalar_dispatch_step(subject: u64, subj_ty: VmType, default_case: ssa.ScalarMatchCase, st: DispatchChainWalk) -> (result: DispatchChainWalk) {
    return match st.rest {
        ssa.ScalarMatchCaseList.SCNil => st,
        ssa.ScalarMatchCaseList.SCCons { head: cs, tail: more } => emit_scalar_dispatch_one(subject, subj_ty, default_case, st, cs, more)
    };
}
fn emit_scalar_dispatch_one(subject: u64, subj_ty: VmType, default_case: ssa.ScalarMatchCase, st: DispatchChainWalk, cs: ssa.ScalarMatchCase, more: ssa.ScalarMatchCaseList) -> (result: DispatchChainWalk) {
    let const_val_id: u64 = st.next_val_id;
    let cmp_val_id: u64 = st.next_val_id + 1;
    let c_inst: VmInstruction = make_scalar_const_inst(st.next_inst_id, const_val_id, subj_ty, cs.value);
    let eq_inst: VmInstruction = make_scalar_eq_inst(st.next_inst_id + 1, cmp_val_id, subj_ty, subject, const_val_id);
    let disp_insts: VmInstructionList = VmInstructionList.VICons {
        head: c_inst,
        tail: VmInstructionList.VICons { head: eq_inst, tail: VmInstructionList.VINil }
    };
    let vt1: VmValueList = VmValueList.VVCons { head: VmValue { id: const_val_id, ty: subj_ty }, tail: st.val_types };
    let vt2: VmValueList = VmValueList.VVCons { head: VmValue { id: cmp_val_id, ty: bool_vm_type() }, tail: vt1 };
    let is_last: bool = scalar_cases_empty(more);
    let else_tgt: u64 = select(is_last, default_case.target, st.next_blk_id);
    let else_args: ssa.IdList = select_id_list(is_last, default_case.arguments, ssa.IdList.INil);
    let next_blk_alloc: u64 = select(is_last, st.next_blk_id, st.next_blk_id + 1);
    let disp_term: VmTerminator = VmTerminator.VmCondBranch {
        condition: cmp_val_id,
        then_target: cs.target, then_arguments: cs.arguments,
        else_target: else_tgt, else_arguments: else_args
    };
    let disp_blk: VmBlock = VmBlock {
        id: st.cur_blk_id, is_error_path: false, parameters: VmValueList.VVNil,
        instructions: disp_insts, terminator: disp_term,
        has_failure_target: false, failure_target: 0
    };
    return DispatchChainWalk {
        rest: more, cur_blk_id: else_tgt, val_types: vt2,
        acc: VmBlockList.VBCons { head: disp_blk, tail: st.acc },
        block_count: st.block_count + 1, inst_count: st.inst_count + 2,
        next_val_id: st.next_val_id + 2, next_inst_id: st.next_inst_id + 2,
        next_blk_id: next_blk_alloc
    };
}
fn select_id_list(pick_first: bool, a: ssa.IdList, b: ssa.IdList) -> (result: ssa.IdList) {
    if pick_first { return a; }
    return b;
}

fn lower_scalar_switch_block(
    all_blocks: ssa.SsaBlockList,
    blk_id: u64,
    params: VmValueList,
    insts: VmInstructionList,
    blk_inst_count: u64,
    has_failure_target: bool,
    failure_target: u64,
    val_types: VmValueList,
    blocks_acc: VmBlockList,
    block_count: u64,
    inst_count: u64,
    next_val_id: u64,
    next_inst_id: u64,
    next_blk_id: u64,
    subject: u64,
    subject_ty: decl.SemType,
    res_vm_ty: VmType,
    res_is_seq: bool,
    arm_count: u64,
    default_target: u64,
    join_target: u64,
    cases: ssa.ScalarMatchCaseList
) -> (result: ScalarSwitchLowerResult) {
    let subj_ty: VmType = sem_type_to_vm_scalar(subject_ty);
    if !(subj_ty.valid) || (subj_ty.kind != 2 && subj_ty.kind != 3) {
        return ScalarSwitchLowerResult { ok: false, error_code: 4, val_types: val_types, acc: blocks_acc, block_count: block_count, inst_count: inst_count, next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id };
    }
    let subj_lk: VmValTypeLookup = lookup_vm_value_type(val_types, subject);
    if !(subj_lk.found) || !(vm_type_equal(subj_lk.ty, subj_ty)) {
        return ScalarSwitchLowerResult { ok: false, error_code: 7, val_types: val_types, acc: blocks_acc, block_count: block_count, inst_count: inst_count, next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id };
    }
    if !(verify_scalar_switch_join_head(all_blocks, val_types, blk_id, join_target, res_vm_ty, res_is_seq)) {
        return ScalarSwitchLowerResult { ok: false, error_code: 7, val_types: val_types, acc: blocks_acc, block_count: block_count, inst_count: inst_count, next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id };
    }
    let scanned: ScalarSwitchScan = scan_scalar_switch_cases(all_blocks, blk_id, subj_ty, arm_count, default_target, join_target, cases);
    if !(scanned.ok) {
        return ScalarSwitchLowerResult { ok: false, error_code: scanned.error_code, val_types: val_types, acc: blocks_acc, block_count: block_count, inst_count: inst_count, next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id };
    }
    return match scanned.non_defaults_rev {
        ssa.ScalarMatchCaseList.SCNil => emit_scalar_switch_default_only(blk_id, params, insts, blk_inst_count, has_failure_target, failure_target, val_types, blocks_acc, block_count, inst_count, next_val_id, next_inst_id, next_blk_id, scanned.default_case),
        ssa.ScalarMatchCaseList.SCCons { head: first_case, tail: rest_cases } => emit_scalar_switch_with_arms(blk_id, params, insts, blk_inst_count, has_failure_target, failure_target, val_types, blocks_acc, block_count, inst_count, next_val_id, next_inst_id, next_blk_id, subject, subj_ty, first_case, rest_cases, scanned.default_case)
    };
}
fn emit_scalar_switch_default_only(
    blk_id: u64, params: VmValueList, insts: VmInstructionList, blk_inst_count: u64,
    has_failure_target: bool, failure_target: u64, val_types: VmValueList, blocks_acc: VmBlockList,
    block_count: u64, inst_count: u64, next_val_id: u64, next_inst_id: u64, next_blk_id: u64,
    default_case: ssa.ScalarMatchCase
) -> (result: ScalarSwitchLowerResult) {
    let vm_blk: VmBlock = VmBlock {
        id: blk_id, is_error_path: false, parameters: params, instructions: insts,
        terminator: VmTerminator.VmBranch { target: default_case.target, arguments: default_case.arguments },
        has_failure_target: has_failure_target, failure_target: failure_target
    };
    return ScalarSwitchLowerResult {
        ok: true, error_code: 0, val_types: val_types,
        acc: VmBlockList.VBCons { head: vm_blk, tail: blocks_acc },
        block_count: block_count + 1, inst_count: inst_count + blk_inst_count,
        next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id
    };
}
fn emit_scalar_switch_with_arms(
    blk_id: u64, params: VmValueList, insts: VmInstructionList, blk_inst_count: u64,
    has_failure_target: bool, failure_target: u64, val_types: VmValueList, blocks_acc: VmBlockList,
    block_count: u64, inst_count: u64, next_val_id: u64, next_inst_id: u64, next_blk_id: u64,
    subject: u64, subj_ty: VmType, first_case: ssa.ScalarMatchCase, rest_cases: ssa.ScalarMatchCaseList,
    default_case: ssa.ScalarMatchCase
) -> (result: ScalarSwitchLowerResult) {
    let c0_val: u64 = next_val_id;
    let eq0_val: u64 = next_val_id + 1;
    let c0_inst: VmInstruction = make_scalar_const_inst(next_inst_id, c0_val, subj_ty, first_case.value);
    let eq0_inst: VmInstruction = make_scalar_eq_inst(next_inst_id + 1, eq0_val, subj_ty, subject, c0_val);
    let head_insts: VmInstructionList = append_two_vm_insts(insts, c0_inst, eq0_inst);
    let vt1: VmValueList = VmValueList.VVCons { head: VmValue { id: c0_val, ty: subj_ty }, tail: val_types };
    let vt2: VmValueList = VmValueList.VVCons { head: VmValue { id: eq0_val, ty: bool_vm_type() }, tail: vt1 };
    let is_single: bool = scalar_cases_empty(rest_cases);
    let else_tgt: u64 = select(is_single, default_case.target, next_blk_id);
    let else_args: ssa.IdList = select_id_list(is_single, default_case.arguments, ssa.IdList.INil);
    let alloc_blk: u64 = select(is_single, next_blk_id, next_blk_id + 1);
    let head_blk: VmBlock = VmBlock {
        id: blk_id, is_error_path: false, parameters: params, instructions: head_insts,
        terminator: VmTerminator.VmCondBranch {
            condition: eq0_val,
            then_target: first_case.target, then_arguments: first_case.arguments,
            else_target: else_tgt, else_arguments: else_args
        },
        has_failure_target: has_failure_target, failure_target: failure_target
    };
    let acc1: VmBlockList = VmBlockList.VBCons { head: head_blk, tail: blocks_acc };
    let bc1: u64 = block_count + 1;
    let ic1: u64 = inst_count + blk_inst_count + 2;
    if is_single {
        return ScalarSwitchLowerResult {
            ok: true, error_code: 0, val_types: vt2, acc: acc1,
            block_count: bc1, inst_count: ic1,
            next_val_id: next_val_id + 2, next_inst_id: next_inst_id + 2, next_blk_id: alloc_blk
        };
    }
    let chain_init: DispatchChainWalk = DispatchChainWalk {
        rest: rest_cases, cur_blk_id: else_tgt, val_types: vt2, acc: acc1,
        block_count: bc1, inst_count: ic1,
        next_val_id: next_val_id + 2, next_inst_id: next_inst_id + 2, next_blk_id: alloc_blk
    };
    let done: DispatchChainWalk = emit_scalar_dispatch_chain(subject, subj_ty, default_case, chain_init);
    return ScalarSwitchLowerResult {
        ok: true, error_code: 0, val_types: done.val_types, acc: done.acc,
        block_count: done.block_count, inst_count: done.inst_count,
        next_val_id: done.next_val_id, next_inst_id: done.next_inst_id, next_blk_id: done.next_blk_id
    };
}

// ---------------------------------------------------------------------------
// FiniteSwitch lowering: FiniteIsVariant + ConditionalBranch chain -> VmFailure
// ---------------------------------------------------------------------------

record ResolvedFiniteCase {
    variant_identity: decl.SemanticIdentity,
    discriminant: u64,
    target: u64,
    arguments: ssa.IdList
}
enum ResolvedFiniteCaseList { RFCNil, RFCCons { head: ResolvedFiniteCase, tail: ResolvedFiniteCaseList } }
record ResolvedFiniteCaseRev { rest: ResolvedFiniteCaseList, acc: ResolvedFiniteCaseList }
fn resolved_finite_cases_empty(cs: ResolvedFiniteCaseList) -> (result: bool) {
    return match cs { RFCNil => true, RFCCons { head: h, tail: t } => false };
}
fn reverse_resolved_finite_cases(cs: ResolvedFiniteCaseList) -> (result: ResolvedFiniteCaseList) {
    iterate i up_to 256 carrying st: ResolvedFiniteCaseRev = ResolvedFiniteCaseRev { rest: cs, acc: ResolvedFiniteCaseList.RFCNil } {
        if resolved_finite_cases_empty(st.rest) { return st.acc; }
        next st = reverse_resolved_finite_cases_step(st);
    }
    return st.acc;
}
fn reverse_resolved_finite_cases_step(st: ResolvedFiniteCaseRev) -> (result: ResolvedFiniteCaseRev) {
    return match st.rest {
        RFCNil => st,
        RFCCons { head: h, tail: t } => ResolvedFiniteCaseRev { rest: t, acc: ResolvedFiniteCaseList.RFCCons { head: h, tail: st.acc } }
    };
}
fn finite_cases_empty(cs: ssa.FiniteMatchCaseList) -> (result: bool) {
    return match cs { ssa.FiniteMatchCaseList.MCNil => true, ssa.FiniteMatchCaseList.MCCons { head: h, tail: t } => false };
}
fn make_finite_is_variant_inst(inst_id: u64, res_id: u64, subj_ty: VmType, subject: u64, var_id: decl.SemanticIdentity, disc: u64) -> (result: VmInstruction) {
    return VmInstruction {
        id: inst_id, result: res_id, opcode: 22, op_code: disc, intent: 0,
        imm_u64: 0, imm_bool: false,
        ty: bool_vm_type(), from_ty: subj_ty,
        inputs: ssa.IdList.ICons { head: ssa.Id { value: subject }, tail: ssa.IdList.INil },
        callee_identity: var_id,
        callee_nat_args: VmNatArgList.NANil,
        field_names: VmNameList.VNNil
    };
}
fn append_one_vm_inst(insts: VmInstructionList, extra: VmInstruction) -> (result: VmInstructionList) {
    let rev: VmInstructionList = reverse_vm_insts(insts);
    return reverse_vm_insts(VmInstructionList.VICons { head: extra, tail: rev });
}

record FiniteSwitchScan {
    rest: ssa.FiniteMatchCaseList,
    seen_names: VmNameList,
    resolved_rev: ResolvedFiniteCaseList,
    count: u64,
    ok: bool,
    error_code: u64
}
fn scan_finite_switch_cases<P: Nat, N: Nat>(
    pages: [[byte; up_to N]; up_to P], stride: u64, total: u64,
    all_blocks: ssa.SsaBlockList, blk_id: u64, schema: VmFiniteType, arm_count: u64,
    cases: ssa.FiniteMatchCaseList
) -> (result: FiniteSwitchScan) {
    let initial: FiniteSwitchScan = FiniteSwitchScan {
        rest: cases, seen_names: VmNameList.VNNil, resolved_rev: ResolvedFiniteCaseList.RFCNil,
        count: 0, ok: true, error_code: 0
    };
    iterate i up_to 256 carrying st: FiniteSwitchScan = initial {
        if !(st.ok) || finite_cases_empty(st.rest) {
            return finish_finite_switch_scan(st, arm_count);
        }
        next st = scan_finite_switch_step<P, N>(pages, stride, total, all_blocks, blk_id, schema, st);
    }
    return finish_finite_switch_scan(st, arm_count);
}
fn finish_finite_switch_scan(st: FiniteSwitchScan, arm_count: u64) -> (result: FiniteSwitchScan) {
    if !(st.ok) { return st; }
    if !(finite_cases_empty(st.rest)) || st.count == 0 || st.count != arm_count {
        return FiniteSwitchScan { ..st, ok: false, error_code: 7 };
    }
    return FiniteSwitchScan { ..st, resolved_rev: reverse_resolved_finite_cases(st.resolved_rev) };
}
fn scan_finite_switch_step<P: Nat, N: Nat>(
    pages: [[byte; up_to N]; up_to P], stride: u64, total: u64,
    all_blocks: ssa.SsaBlockList, blk_id: u64, schema: VmFiniteType, st: FiniteSwitchScan
) -> (result: FiniteSwitchScan) {
    return match st.rest {
        ssa.FiniteMatchCaseList.MCNil => st,
        ssa.FiniteMatchCaseList.MCCons { head: cs, tail: rest } => scan_finite_switch_one<P, N>(pages, stride, total, all_blocks, blk_id, schema, st, cs, rest)
    };
}
fn scan_finite_switch_one<P: Nat, N: Nat>(
    pages: [[byte; up_to N]; up_to P], stride: u64, total: u64,
    all_blocks: ssa.SsaBlockList, blk_id: u64, schema: VmFiniteType, st: FiniteSwitchScan,
    cs: ssa.FiniteMatchCase, rest: ssa.FiniteMatchCaseList
) -> (result: FiniteSwitchScan) {
    if cs.target == blk_id || cs.variant_end <= cs.variant_start {
        return FiniteSwitchScan { ..st, rest: ssa.FiniteMatchCaseList.MCNil, ok: false, error_code: 7 };
    }
    let tgt_lk: SsaBlkLookup = find_ssa_block_by_id(all_blocks, cs.target);
    if !(tgt_lk.found) {
        return FiniteSwitchScan { ..st, rest: ssa.FiniteMatchCaseList.MCNil, ok: false, error_code: 7 };
    }
    let vname: decl.SemanticIdentity = span_to_ident<P, N>(pages, stride, total, cs.variant_start, cs.variant_end);
    if !(vname.valid) || vm_name_list_contains(st.seen_names, vname) {
        return FiniteSwitchScan { ..st, rest: ssa.FiniteMatchCaseList.MCNil, ok: false, error_code: 7 };
    }
    let var_lk: FiniteVariantLookup = find_vm_finite_variant(schema.variants, vname);
    if !(var_lk.found) {
        return FiniteSwitchScan { ..st, rest: ssa.FiniteMatchCaseList.MCNil, ok: false, error_code: 7 };
    }
    let item: ResolvedFiniteCase = ResolvedFiniteCase {
        variant_identity: var_lk.variant.identity,
        discriminant: var_lk.variant.discriminant,
        target: cs.target,
        arguments: cs.arguments
    };
    return FiniteSwitchScan {
        rest: rest,
        seen_names: VmNameList.VNCons { head: vname, tail: st.seen_names },
        resolved_rev: ResolvedFiniteCaseList.RFCCons { head: item, tail: st.resolved_rev },
        count: st.count + 1,
        ok: true, error_code: 0
    };
}

record FiniteDispatchChainWalk {
    rest: ResolvedFiniteCaseList,
    cur_blk_id: u64,
    val_types: VmValueList,
    acc: VmBlockList,
    block_count: u64,
    inst_count: u64,
    next_val_id: u64,
    next_inst_id: u64,
    next_blk_id: u64
}
fn emit_finite_dispatch_chain(subject: u64, subj_ty: VmType, fail_blk_id: u64, initial: FiniteDispatchChainWalk) -> (result: FiniteDispatchChainWalk) {
    iterate i up_to 256 carrying st: FiniteDispatchChainWalk = initial {
        if resolved_finite_cases_empty(st.rest) { return st; }
        next st = emit_finite_dispatch_step(subject, subj_ty, fail_blk_id, st);
    }
    return st;
}
fn emit_finite_dispatch_step(subject: u64, subj_ty: VmType, fail_blk_id: u64, st: FiniteDispatchChainWalk) -> (result: FiniteDispatchChainWalk) {
    return match st.rest {
        RFCNil => st,
        RFCCons { head: cs, tail: rest } => emit_finite_dispatch_one(subject, subj_ty, fail_blk_id, st, cs, rest)
    };
}
fn emit_finite_dispatch_one(subject: u64, subj_ty: VmType, fail_blk_id: u64, st: FiniteDispatchChainWalk, cs: ResolvedFiniteCase, rest: ResolvedFiniteCaseList) -> (result: FiniteDispatchChainWalk) {
    let cond_val: u64 = st.next_val_id;
    let is_inst: VmInstruction = make_finite_is_variant_inst(st.next_inst_id, cond_val, subj_ty, subject, cs.variant_identity, cs.discriminant);
    let is_last: bool = resolved_finite_cases_empty(rest);
    let else_tgt: u64 = select(is_last, fail_blk_id, st.next_blk_id);
    let next_alloc: u64 = select(is_last, st.next_blk_id, st.next_blk_id + 1);
    let blk: VmBlock = VmBlock {
        id: st.cur_blk_id, is_error_path: false,
        parameters: VmValueList.VVNil,
        instructions: VmInstructionList.VICons { head: is_inst, tail: VmInstructionList.VINil },
        terminator: VmTerminator.VmCondBranch {
            condition: cond_val,
            then_target: cs.target, then_arguments: cs.arguments,
            else_target: else_tgt, else_arguments: ssa.IdList.INil
        },
        has_failure_target: false, failure_target: 0
    };
    return FiniteDispatchChainWalk {
        rest: rest, cur_blk_id: else_tgt,
        val_types: VmValueList.VVCons { head: VmValue { id: cond_val, ty: bool_vm_type() }, tail: st.val_types },
        acc: VmBlockList.VBCons { head: blk, tail: st.acc },
        block_count: st.block_count + 1, inst_count: st.inst_count + 1,
        next_val_id: st.next_val_id + 1, next_inst_id: st.next_inst_id + 1, next_blk_id: next_alloc
    };
}

fn lower_finite_switch_block<P: Nat, N: Nat>(
    pages: [[byte; up_to N]; up_to P], stride: u64, total: u64,
    all_blocks: ssa.SsaBlockList, all_fins: VmFiniteTypeList,
    blk_id: u64, params: VmValueList, insts: VmInstructionList, blk_inst_count: u64,
    has_failure_target: bool, failure_target: u64,
    val_types: VmValueList, blocks_acc: VmBlockList,
    block_count: u64, inst_count: u64,
    next_val_id: u64, next_inst_id: u64, next_blk_id: u64,
    subject: u64, nominal_identity: decl.SemanticIdentity,
    res_vm_ty: VmType, res_is_seq: bool, arm_count: u64, join_target: u64,
    cases: ssa.FiniteMatchCaseList
) -> (result: ScalarSwitchLowerResult) {
    let subj_lk: VmValTypeLookup = lookup_vm_value_type(val_types, subject);
    if !(subj_lk.found) || !(subj_lk.ty.valid) || subj_lk.ty.kind != 7 || !(semantic_ids_equal(subj_lk.ty.nominal_identity, nominal_identity)) {
        return ScalarSwitchLowerResult { ok: false, error_code: 4, val_types: val_types, acc: blocks_acc, block_count: block_count, inst_count: inst_count, next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id };
    }
    let schema_lk: FiniteTypeLookup = find_vm_finite_type(all_fins, nominal_identity);
    if !(schema_lk.found) {
        return ScalarSwitchLowerResult { ok: false, error_code: 4, val_types: val_types, acc: blocks_acc, block_count: block_count, inst_count: inst_count, next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id };
    }
    if !(verify_scalar_switch_join_head(all_blocks, val_types, blk_id, join_target, res_vm_ty, res_is_seq)) {
        return ScalarSwitchLowerResult { ok: false, error_code: 7, val_types: val_types, acc: blocks_acc, block_count: block_count, inst_count: inst_count, next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id };
    }
    let scanned: FiniteSwitchScan = scan_finite_switch_cases<P, N>(pages, stride, total, all_blocks, blk_id, schema_lk.schema, arm_count, cases);
    if !(scanned.ok) {
        return ScalarSwitchLowerResult { ok: false, error_code: scanned.error_code, val_types: val_types, acc: blocks_acc, block_count: block_count, inst_count: inst_count, next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id };
    }
    return match scanned.resolved_rev {
        RFCNil => ScalarSwitchLowerResult { ok: false, error_code: 7, val_types: val_types, acc: blocks_acc, block_count: block_count, inst_count: inst_count, next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id },
        RFCCons { head: first_cs, tail: rest_cs } => emit_finite_switch_with_arms(blk_id, params, insts, blk_inst_count, has_failure_target, failure_target, val_types, blocks_acc, block_count, inst_count, next_val_id, next_inst_id, next_blk_id, subject, subj_lk.ty, first_cs, rest_cs)
    };
}
fn emit_finite_switch_with_arms(
    blk_id: u64, params: VmValueList, insts: VmInstructionList, blk_inst_count: u64,
    has_failure_target: bool, failure_target: u64,
    val_types: VmValueList, blocks_acc: VmBlockList,
    block_count: u64, inst_count: u64,
    next_val_id: u64, next_inst_id: u64, next_blk_id: u64,
    subject: u64, subj_ty: VmType, first_cs: ResolvedFiniteCase, rest_cs: ResolvedFiniteCaseList
) -> (result: ScalarSwitchLowerResult) {
    let fail_blk_id: u64 = next_blk_id;
    let fail_blk: VmBlock = VmBlock {
        id: fail_blk_id, is_error_path: true,
        parameters: VmValueList.VVNil,
        instructions: VmInstructionList.VINil,
        terminator: VmTerminator.VmFailure,
        has_failure_target: false, failure_target: 0
    };
    let cond0: u64 = next_val_id;
    let is0: VmInstruction = make_finite_is_variant_inst(next_inst_id, cond0, subj_ty, subject, first_cs.variant_identity, first_cs.discriminant);
    let head_insts: VmInstructionList = append_one_vm_inst(insts, is0);
    let vt1: VmValueList = VmValueList.VVCons { head: VmValue { id: cond0, ty: bool_vm_type() }, tail: val_types };
    let is_single: bool = resolved_finite_cases_empty(rest_cs);
    let else_tgt: u64 = select(is_single, fail_blk_id, next_blk_id + 1);
    let alloc_blk: u64 = select(is_single, next_blk_id + 1, next_blk_id + 2);
    let head_blk: VmBlock = VmBlock {
        id: blk_id, is_error_path: false, parameters: params, instructions: head_insts,
        terminator: VmTerminator.VmCondBranch {
            condition: cond0,
            then_target: first_cs.target, then_arguments: first_cs.arguments,
            else_target: else_tgt, else_arguments: ssa.IdList.INil
        },
        has_failure_target: has_failure_target, failure_target: failure_target
    };
    let acc1: VmBlockList = VmBlockList.VBCons { head: fail_blk, tail: VmBlockList.VBCons { head: head_blk, tail: blocks_acc } };
    let bc1: u64 = block_count + 2;
    let ic1: u64 = inst_count + blk_inst_count + 1;
    if is_single {
        return ScalarSwitchLowerResult {
            ok: true, error_code: 0, val_types: vt1, acc: acc1,
            block_count: bc1, inst_count: ic1,
            next_val_id: next_val_id + 1, next_inst_id: next_inst_id + 1, next_blk_id: alloc_blk
        };
    }
    let chain_init: FiniteDispatchChainWalk = FiniteDispatchChainWalk {
        rest: rest_cs, cur_blk_id: else_tgt, val_types: vt1, acc: acc1,
        block_count: bc1, inst_count: ic1,
        next_val_id: next_val_id + 1, next_inst_id: next_inst_id + 1, next_blk_id: alloc_blk
    };
    let done: FiniteDispatchChainWalk = emit_finite_dispatch_chain(subject, subj_ty, fail_blk_id, chain_init);
    return ScalarSwitchLowerResult {
        ok: true, error_code: 0, val_types: done.val_types, acc: done.acc,
        block_count: done.block_count, inst_count: done.inst_count,
        next_val_id: done.next_val_id, next_inst_id: done.next_inst_id, next_blk_id: done.next_blk_id
    };
}

// ---------------------------------------------------------------------------
// Scalar-only lowering (used by standalone & wire-only entry points)
// ---------------------------------------------------------------------------

record ScalarInstListWalk { rest: ssa.InstructionList, val_types: VmValueList, acc: VmInstructionList, count: u64, ok: bool, error_code: u64, error_inst: u64 }
fn lower_vm_scalar_instructions(val_types: VmValueList, insts: ssa.InstructionList) -> (result: ScalarInstListWalk) {
    iterate i up_to 1024 carrying st: ScalarInstListWalk = ScalarInstListWalk { rest: insts, val_types: val_types, acc: VmInstructionList.VINil, count: 0, ok: true, error_code: 0, error_inst: 0 } {
        if !(st.ok) || ssa_inst_list_empty(st.rest) {
            return ScalarInstListWalk { ..st, acc: reverse_vm_insts(st.acc) };
        }
        next st = lower_vm_scalar_inst_step(st);
    }
    return ScalarInstListWalk { ..st, acc: reverse_vm_insts(st.acc), ok: st.ok && ssa_inst_list_empty(st.rest), error_code: select(st.ok && !(ssa_inst_list_empty(st.rest)), 5, st.error_code) };
}
fn lower_vm_scalar_inst_step(st: ScalarInstListWalk) -> (result: ScalarInstListWalk) {
    return match st.rest {
        ssa.InstructionList.QNil => st,
        ssa.InstructionList.QCons { head: inst, tail: rest } => lower_vm_scalar_inst_one(st, inst, rest)
    };
}
fn lower_vm_scalar_inst_one(st: ScalarInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList) -> (result: ScalarInstListWalk) {
    if !(effects_empty(inst.effects)) || !(capabilities_empty(inst.capabilities)) {
        return ScalarInstListWalk { ..st, rest: rest, ok: false, error_code: 3, error_inst: inst.id };
    }
    let res_ty: VmType = sem_type_to_vm_scalar(inst.ty);
    if !(res_ty.valid) {
        return ScalarInstListWalk { ..st, rest: rest, ok: false, error_code: 4, error_inst: inst.id };
    }
    let lowered: InstLowerResult = lower_vm_common_instruction(st.val_types, inst, res_ty, VmNatArgList.NANil);
    if !(lowered.ok) {
        return ScalarInstListWalk { ..st, rest: rest, ok: false, error_code: lowered.error_code, error_inst: inst.id };
    }
    return ScalarInstListWalk { rest: rest, val_types: st.val_types, acc: VmInstructionList.VICons { head: lowered.inst, tail: st.acc }, count: st.count + 1, ok: true, error_code: 0, error_inst: 0 };
}

record ScalarBlockListWalk { rest: ssa.SsaBlockList, val_types: VmValueList, acc: VmBlockList, block_count: u64, inst_count: u64, next_val_id: u64, next_inst_id: u64, next_blk_id: u64, ok: bool, error_code: u64, error_block: u64, error_inst: u64 }
fn lower_vm_scalar_blocks(all_blocks: ssa.SsaBlockList, val_types: VmValueList, next_val_id: u64, next_inst_id: u64, next_blk_id: u64) -> (result: ScalarBlockListWalk) {
    let initial: ScalarBlockListWalk = ScalarBlockListWalk {
        rest: all_blocks, val_types: val_types, acc: VmBlockList.VBNil,
        block_count: 0, inst_count: 0,
        next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id,
        ok: true, error_code: 0, error_block: 0, error_inst: 0
    };
    iterate i up_to 1024 carrying st: ScalarBlockListWalk = initial {
        if !(st.ok) || ssa_block_list_empty(st.rest) {
            return ScalarBlockListWalk { ..st, acc: reverse_vm_blocks(st.acc) };
        }
        next st = lower_vm_scalar_block_step(all_blocks, st);
    }
    return ScalarBlockListWalk { ..st, acc: reverse_vm_blocks(st.acc), ok: st.ok && ssa_block_list_empty(st.rest), error_code: select(st.ok && !(ssa_block_list_empty(st.rest)), 2, st.error_code) };
}
fn lower_vm_scalar_block_step(all_blocks: ssa.SsaBlockList, st: ScalarBlockListWalk) -> (result: ScalarBlockListWalk) {
    return match st.rest {
        ssa.SsaBlockList.LNil => st,
        ssa.SsaBlockList.LCons { head: blk, tail: rest } => lower_vm_scalar_block_one(all_blocks, st, blk, rest)
    };
}
fn lower_vm_scalar_block_one(all_blocks: ssa.SsaBlockList, st: ScalarBlockListWalk, blk: ssa.SsaBlock, rest: ssa.SsaBlockList) -> (result: ScalarBlockListWalk) {
    if !(blk.lowering_ok) {
        return ScalarBlockListWalk { ..st, rest: rest, ok: false, error_code: 2, error_block: blk.id, error_inst: 0 };
    }
    let params: LowerValuesWalk = lower_vm_scalar_values(blk.parameters, false);
    if !(params.ok) {
        return ScalarBlockListWalk { ..st, rest: rest, ok: false, error_code: 4, error_block: blk.id, error_inst: 0 };
    }
    let insts: ScalarInstListWalk = lower_vm_scalar_instructions(st.val_types, blk.instructions);
    if !(insts.ok) {
        return ScalarBlockListWalk { ..st, rest: rest, ok: false, error_code: insts.error_code, error_block: blk.id, error_inst: insts.error_inst };
    }
    return lower_vm_scalar_block_term(all_blocks, st, blk, rest, params.acc, insts.acc, insts.count);
}
fn lower_vm_scalar_block_term(all_blocks: ssa.SsaBlockList, st: ScalarBlockListWalk, blk: ssa.SsaBlock, rest: ssa.SsaBlockList, params: VmValueList, insts: VmInstructionList, blk_inst_count: u64) -> (result: ScalarBlockListWalk) {
    return match blk.terminator {
        ssa.Terminator.ScalarSwitch { subject: subj, subject_ty: subj_ty, result_type: res_ty, source_start: ss, source_end: se, arm_count: ac, default_target: dt, join_target: jt, cases: cs } => lower_vm_scalar_switch_finish(all_blocks, st, blk, rest, params, insts, blk_inst_count, subj, subj_ty, res_ty, ac, dt, jt, cs),
        ssa.Terminator.Return { value: v } => lower_vm_scalar_plain_term(st, blk, rest, params, insts, blk_inst_count),
        ssa.Terminator.Jump { target: tgt, arguments: args } => lower_vm_scalar_plain_term(st, blk, rest, params, insts, blk_inst_count),
        ssa.Terminator.Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => lower_vm_scalar_plain_term(st, blk, rest, params, insts, blk_inst_count),
        ssa.Terminator.Fail => lower_vm_scalar_plain_term(st, blk, rest, params, insts, blk_inst_count),
        ssa.Terminator.FiniteSwitch { subject: s, subject_ty: sty, nominal_identity: ni, result_type: rt, source_start: ss, source_end: se, arm_count: ac, join_target: jt, cases: cs } => ScalarBlockListWalk { ..st, rest: rest, ok: false, error_code: 6, error_block: blk.id, error_inst: 0 }
    };
}
fn lower_vm_scalar_switch_finish(all_blocks: ssa.SsaBlockList, st: ScalarBlockListWalk, blk: ssa.SsaBlock, rest: ssa.SsaBlockList, params: VmValueList, insts: VmInstructionList, blk_inst_count: u64, subject: u64, subject_ty: decl.SemType, res_ty: decl.SemType, arm_count: u64, default_target: u64, join_target: u64, cases: ssa.ScalarMatchCaseList) -> (result: ScalarBlockListWalk) {
    let res_vm: VmType = sem_type_to_vm_scalar(res_ty);
    let sw: ScalarSwitchLowerResult = lower_scalar_switch_block(
        all_blocks, blk.id, params, insts, blk_inst_count,
        blk.has_failure_target, blk.failure_target,
        st.val_types, st.acc, st.block_count, st.inst_count,
        st.next_val_id, st.next_inst_id, st.next_blk_id,
        subject, subject_ty, res_vm, false, arm_count, default_target, join_target, cases
    );
    if !(sw.ok) {
        return ScalarBlockListWalk { ..st, rest: rest, ok: false, error_code: sw.error_code, error_block: blk.id, error_inst: 0 };
    }
    return ScalarBlockListWalk {
        rest: rest, val_types: sw.val_types, acc: sw.acc,
        block_count: sw.block_count, inst_count: sw.inst_count,
        next_val_id: sw.next_val_id, next_inst_id: sw.next_inst_id, next_blk_id: sw.next_blk_id,
        ok: true, error_code: 0, error_block: 0, error_inst: 0
    };
}
fn lower_vm_scalar_plain_term(st: ScalarBlockListWalk, blk: ssa.SsaBlock, rest: ssa.SsaBlockList, params: VmValueList, insts: VmInstructionList, blk_inst_count: u64) -> (result: ScalarBlockListWalk) {
    let term: TermLowerResult = lower_vm_terminator(blk.terminator);
    if !(term.ok) {
        return ScalarBlockListWalk { ..st, rest: rest, ok: false, error_code: term.error_code, error_block: blk.id, error_inst: 0 };
    }
    let vm_blk: VmBlock = VmBlock {
        id: blk.id, is_error_path: term.is_error_path,
        parameters: params, instructions: insts, terminator: term.term,
        has_failure_target: blk.has_failure_target, failure_target: blk.failure_target
    };
    return ScalarBlockListWalk {
        rest: rest, val_types: st.val_types,
        acc: VmBlockList.VBCons { head: vm_blk, tail: st.acc },
        block_count: st.block_count + 1, inst_count: st.inst_count + blk_inst_count,
        next_val_id: st.next_val_id, next_inst_id: st.next_inst_id, next_blk_id: st.next_blk_id,
        ok: true, error_code: 0, error_block: 0, error_inst: 0
    };
}

record FnEmitWalk {
    index: u64,
    acc: VmFunctionList,
    fn_count: u64,
    block_count: u64,
    inst_count: u64,
    ok: bool,
    error_code: u64,
    error_function: u64,
    error_block: u64,
    error_inst: u64,
    error_detail: VmEmitFailureDetail
}
fn empty_failure_detail() -> (result: VmEmitFailureDetail) {
    return VmEmitFailureDetail {
        callable: decl.invalid_semantic_identity(),
        phase: 0,
        ssa_kind: 0,
        expected_type_kind: 0,
        observed_type_kind: 0,
        observed_nominal: decl.invalid_semantic_identity(),
        source_start: 0,
        source_end: 0
    };
}
fn phase_failure_detail(callable: decl.SemanticIdentity, phase: u64, ssa_kind: u64, exp_kind: u64, obs_kind: u64, obs_nom: decl.SemanticIdentity, src_start: u64, src_end: u64) -> (result: VmEmitFailureDetail) {
    return VmEmitFailureDetail {
        callable: callable,
        phase: phase,
        ssa_kind: ssa_kind,
        expected_type_kind: exp_kind,
        observed_type_kind: obs_kind,
        observed_nominal: obs_nom,
        source_start: src_start,
        source_end: src_end
    };
}
fn lower_vm_scalar_functions(summary: ssa.ValueSsaSummary) -> (result: FnEmitWalk) {
    iterate i up_to 1024 carrying st: FnEmitWalk = FnEmitWalk {
        index: 0, acc: VmFunctionList.VFNil, fn_count: 0, block_count: 0, inst_count: 0,
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0,
        error_detail: empty_failure_detail()
    } {
        if !(st.ok) || st.index >= summary.function_count {
            return FnEmitWalk { ..st, acc: reverse_vm_fns(st.acc) };
        }
        next st = lower_vm_scalar_fn_step(summary, st);
    }
    return FnEmitWalk { ..st, acc: reverse_vm_fns(st.acc), ok: st.ok && st.index >= summary.function_count, error_code: select(st.ok && st.index < summary.function_count, 2, st.error_code) };
}
fn lower_vm_scalar_fn_step(summary: ssa.ValueSsaSummary, st: FnEmitWalk) -> (result: FnEmitWalk) {
    let lookup: ssa.ValueSsaFunctionLookup = ssa.value_ssa_function_at(summary, st.index);
    if !(lookup.found) {
        return FnEmitWalk { ..st, ok: false, error_code: 2, error_function: st.index, error_block: 0, error_inst: 0, error_detail: empty_failure_detail() };
    }
    let lowered: SingleFnLowerResult = lower_single_scalar_ssa_fn(lookup.function);
    if !(lowered.ok) {
        return FnEmitWalk { ..st, ok: false, error_code: lowered.error_code, error_function: st.index, error_block: lowered.error_block, error_inst: lowered.error_inst, error_detail: lowered.error_detail };
    }
    return FnEmitWalk {
        index: st.index + 1,
        acc: VmFunctionList.VFCons { head: lowered.vm_fn, tail: st.acc },
        fn_count: st.fn_count + 1,
        block_count: st.block_count + lowered.vm_fn.block_count,
        inst_count: st.inst_count + lowered.vm_fn.instruction_count,
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0,
        error_detail: empty_failure_detail()
    };
}

record SingleFnLowerResult { ok: bool, error_code: u64, error_block: u64, error_inst: u64, error_detail: VmEmitFailureDetail, vm_fn: VmFunction }
fn single_fn_fail(code: u64, blk_id: u64, inst_id: u64, detail: VmEmitFailureDetail) -> (result: SingleFnLowerResult) {
    return SingleFnLowerResult { ok: false, error_code: code, error_block: blk_id, error_inst: inst_id, error_detail: detail, vm_fn: dummy_vm_function() };
}
fn lower_single_scalar_ssa_fn(func: ssa.Function) -> (result: SingleFnLowerResult) {
    if !(func.supported) || !(func.verified) || !(func.identity.valid) || func.identity.len == 0 || func.block_count == 0 {
        return single_fn_fail(2, 0, 0, phase_failure_detail(func.identity, 2, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let res_ty: VmType = sem_type_to_vm_scalar(func.result_type);
    if !(res_ty.valid) {
        return single_fn_fail(4, 0, 0, phase_failure_detail(func.identity, 5, 0, 8, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let all_vals: LowerValuesWalk = lower_vm_scalar_values(func.values, false);
    if !(all_vals.ok) {
        return single_fn_fail(4, 0, 0, phase_failure_detail(func.identity, 5, 0, 8, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let inputs: LowerValuesWalk = lower_vm_scalar_values(func.inputs, true);
    if !(inputs.ok) {
        return single_fn_fail(4, 0, 0, phase_failure_detail(func.identity, 5, 0, 8, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let max_ids: FnMaxIds = max_fn_val_inst_ids(func);
    let blocks: ScalarBlockListWalk = lower_vm_scalar_blocks(func.blocks, all_vals.acc, max_ids.next_val, max_ids.next_inst, max_ids.next_blk);
    if !(blocks.ok) {
        return single_fn_fail(blocks.error_code, blocks.error_block, blocks.error_inst, phase_failure_detail(func.identity, 8, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let ordered: EntryOrderResult = place_entry_block_first(blocks.acc);
    if !(ordered.ok) {
        return single_fn_fail(7, 0, 0, phase_failure_detail(func.identity, 11, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let vm_fn: VmFunction = VmFunction {
        identity: func.identity,
        nat_args: VmNatArgList.NANil,
        inputs: inputs.acc,
        result_type: res_ty,
        blocks: ordered.blocks,
        bounded_iterations: VmBoundedIterationList.VBINil,
        block_count: blocks.block_count,
        instruction_count: blocks.inst_count
    };
    let cfg_ok: CfgVerifyWalk = verify_vm_fn_cfg_types(vm_fn, blocks.val_types);
    if !(cfg_ok.ok) {
        return single_fn_fail(7, cfg_ok.error_block, 0, phase_failure_detail(func.identity, 11, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    return SingleFnLowerResult { ok: true, error_code: 0, error_block: 0, error_inst: 0, error_detail: empty_failure_detail(), vm_fn: vm_fn };
}

// ---------------------------------------------------------------------------
// Source-backed specialized function lowering (concrete Nat + byte view + record)
// ---------------------------------------------------------------------------

record FnDeclLookup { found: bool, fn_decl: decl.FnDecl }
fn dummy_fn_decl() -> (result: decl.FnDecl) {
    let empty_sig: decl.FnSig = decl.FnSig {
        name_start: 0, name_end: 0, generics: decl.GenericParamList.GNil,
        params: decl.FieldList.FNil, results: decl.FieldList.FNil,
        contracts: decl.ClauseList.CNil, effects: decl.EffectList.XNil, capabilities: decl.CapList.ANil
    };
    let empty_body: decl.FnBody = decl.FnBody { body: decl.StmtList.SNil, ret: decl.Expr.Integer { start: 0, end: 0, value: 0, overflow: false }, has_ret: false };
    return decl.FnDecl { ok: false, err_start: 0, err_end: 0, sig: empty_sig, body: empty_body, fn_start: 0, fn_end: 0, cursor: 0 };
}
record FnDeclSearch { rest: decl.FnList, wanted: decl.SemanticIdentity, found: bool, ambiguous: bool, fn_decl: decl.FnDecl }
fn find_fn_decl_by_id<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, fns: decl.FnList, wanted: decl.SemanticIdentity) -> (result: FnDeclLookup) {
    let initial: FnDeclSearch = FnDeclSearch { rest: fns, wanted: wanted, found: false, ambiguous: false, fn_decl: dummy_fn_decl() };
    iterate chunk up_to 64 carrying st: FnDeclSearch = initial {
        if st.ambiguous || decl_fn_list_empty(st.rest) { return FnDeclLookup { found: st.found && !(st.ambiguous), fn_decl: st.fn_decl }; }
        next st = find_fn_decl_chunk<P, N>(pages, stride, total, header, st);
    }
    return FnDeclLookup { found: st.found && !(st.ambiguous) && decl_fn_list_empty(st.rest), fn_decl: st.fn_decl };
}
fn find_fn_decl_chunk<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, initial: FnDeclSearch) -> (result: FnDeclSearch) {
    iterate i up_to 1024 carrying st: FnDeclSearch = initial {
        if st.ambiguous || decl_fn_list_empty(st.rest) { return st; }
        next st = find_fn_decl_step<P, N>(pages, stride, total, header, st);
    }
    return st;
}
fn find_fn_decl_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, st: FnDeclSearch) -> (result: FnDeclSearch) {
    return match st.rest {
        decl.FnList.DNil => st,
        decl.FnList.DCons { head: fd, tail: rest } => find_fn_decl_one<P, N>(pages, stride, total, header, st, fd, rest)
    };
}
fn find_fn_decl_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, st: FnDeclSearch, fd: decl.FnDecl, rest: decl.FnList) -> (result: FnDeclSearch) {
    if !(identity_function_name_matches<P, N>(pages, stride, total, st.wanted, fd.sig.name_start, fd.sig.name_end)) {
        return FnDeclSearch { ..st, rest: rest };
    }
    let fid: decl.SemanticIdentity = decl.canonical_function_identity<P, N>(pages, stride, total, header.module_start, header.module_end, fd.sig.name_start, fd.sig.name_end);
    if semantic_ids_equal(fid, st.wanted) {
        return FnDeclSearch { ..st, rest: rest, found: true, ambiguous: st.found, fn_decl: fd };
    }
    return FnDeclSearch { ..st, rest: rest };
}
fn identity_function_name_matches<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, wanted: decl.SemanticIdentity, start: u64, end: u64) -> (result: bool) {
    if !(wanted.valid) || wanted.len > wanted.bytes.len || start >= end || end > total { return false; }
    let size: u64 = end - start;
    if size >= wanted.len { return false; }
    let offset: u64 = wanted.len - size;
    if wanted.bytes[offset - 1] != 58 { return false; }
    iterate i up_to 512 carrying n: u64 = 0 {
        if n >= size { return true; }
        if (source.byte_at_global<P, N>(pages, stride, total, start + n) as byte) != wanted.bytes[offset + n] { return false; }
        next n = n + 1;
    }
    return n == size;
}

fn resolve_sem_type_non_seq<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: decl.SemType, nominals: decl.NominalTypeIdentityList, schemas: VmSchemas) -> (result: VmType) {
    let scalar: VmType = sem_type_to_vm_scalar(ty);
    if scalar.valid { return scalar; }
    return match ty {
        TNamed { start: s, end: e } => resolve_named_vm_type<P, N>(pages, stride, total, s, e, nominals, schemas),
        TBool => bool_vm_type(),
        TByte => byte_vm_type(),
        TInt { width: w, signed: sg } => int_vm_type(w, sg),
        TSeq => invalid_vm_type(),
        TSeqExact { element: el, length: n, length_valid: v } => resolve_exact_scalar_seq_vm_type(el, n, v),
        TPoison => invalid_vm_type()
    };
}
fn resolve_exact_scalar_seq_vm_type(element: decl.SemType, length: u64, length_valid: bool) -> (result: VmType) {
    if !(length_valid) || length == 0 { return invalid_vm_type(); }
    let elem_ty: VmType = sem_type_to_vm_scalar(element);
    return exact_scalar_seq_vm_type(elem_ty, length);
}
fn resolve_named_vm_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, nominals: decl.NominalTypeIdentityList, schemas: VmSchemas) -> (result: VmType) {
    let nom: decl.NominalLookup = lookup_nominal_identity<P, N>(pages, stride, total, nominals, start, end);
    if !(nom.found) || !(nom.identity.valid) { return invalid_vm_type(); }
    if is_finite_nominal_identity(nom.identity) {
        let fin_schema: FiniteTypeLookup = find_vm_finite_type(schemas.finites, nom.identity);
        if !(fin_schema.found) { return invalid_vm_type(); }
        return finite_vm_type(nom.identity);
    }
    let rec_schema: RecordTypeLookup = find_vm_record_type(schemas.records, nom.identity);
    if !(rec_schema.found) { return invalid_vm_type(); }
    return record_vm_type(nom.identity);
}

// Lookup a parameter Field by variable name span in `fn_decl.sig.params`.
record FieldSpanLookup { found: bool, fld: decl.Field }
fn dummy_decl_field() -> (result: decl.Field) {
    return decl.Field { name_start: 0, name_end: 0, type_start: 0, type_end: 0, type_kind: 0 };
}
record FieldSpanSearch { rest: decl.FieldList, start: u64, end: u64, found: bool, fld: decl.Field }
fn find_field_by_name_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: decl.FieldList, start: u64, end: u64) -> (result: FieldSpanLookup) {
    let initial: FieldSpanSearch = FieldSpanSearch { rest: fields, start: start, end: end, found: false, fld: dummy_decl_field() };
    iterate i up_to 128 carrying st: FieldSpanSearch = initial {
        if st.found || decl_field_list_empty(st.rest) { return FieldSpanLookup { found: st.found, fld: st.fld }; }
        next st = find_field_by_name_step<P, N>(pages, stride, total, st);
    }
    return FieldSpanLookup { found: st.found, fld: st.fld };
}
fn find_field_by_name_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldSpanSearch) -> (result: FieldSpanSearch) {
    return match st.rest {
        decl.FieldList.FNil => st,
        decl.FieldList.FCons { head: fld, tail: rest } => find_field_by_name_one<P, N>(pages, stride, total, st, fld, rest)
    };
}
fn find_field_by_name_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FieldSpanSearch, fld: decl.Field, rest: decl.FieldList) -> (result: FieldSpanSearch) {
    if decl.spans_equal<P, N>(pages, stride, total, fld.name_start, fld.name_end, st.start, st.end) {
        return FieldSpanSearch { rest: decl.FieldList.FNil, start: st.start, end: st.end, found: true, fld: fld };
    }
    return FieldSpanSearch { ..st, rest: rest };
}

record EnvValIdLookup { found: bool, name_start: u64, name_end: u64 }
record EnvValIdSearch { rest: ssa.Environment, wanted: u64, found: bool, name_start: u64, name_end: u64 }
fn find_env_binding_by_val_id(env: ssa.Environment, wanted: u64) -> (result: EnvValIdLookup) {
    let initial: EnvValIdSearch = EnvValIdSearch { rest: env, wanted: wanted, found: false, name_start: 0, name_end: 0 };
    iterate i up_to 1024 carrying st: EnvValIdSearch = initial {
        if st.found || ssa_env_empty(st.rest) { return EnvValIdLookup { found: st.found, name_start: st.name_start, name_end: st.name_end }; }
        next st = find_env_binding_by_val_step(st);
    }
    return EnvValIdLookup { found: st.found, name_start: st.name_start, name_end: st.name_end };
}
fn find_env_binding_by_val_step(st: EnvValIdSearch) -> (result: EnvValIdSearch) {
    return match st.rest {
        ssa.Environment.EnvNil => st,
        ssa.Environment.EnvCons { head: b, tail: rest } => find_env_binding_by_val_one(st, b, rest)
    };
}
fn find_env_binding_by_val_one(st: EnvValIdSearch, b: ssa.Binding, rest: ssa.Environment) -> (result: EnvValIdSearch) {
    if b.value == st.wanted {
        return EnvValIdSearch { rest: ssa.Environment.EnvNil, wanted: st.wanted, found: true, name_start: b.name_start, name_end: b.name_end };
    }
    return EnvValIdSearch { ..st, rest: rest };
}

// Lower function inputs by zipping source-order `func.inputs` with `fn_decl.sig.params`.
record SpecInputsWalk {
    ssa_vals: ssa.ValueList,
    fields: decl.FieldList,
    acc: VmValueList,
    ok: bool,
    error_code: u64,
    done: bool
}
fn lower_spec_inputs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, nat_env: NatEnv, schemas: VmSchemas) -> (result: SpecInputsWalk) {
    let src_inputs: ssa.ValueList = reverse_ssa_values(func.inputs);
    let initial: SpecInputsWalk = SpecInputsWalk { ssa_vals: src_inputs, fields: fn_decl.sig.params, acc: VmValueList.VVNil, ok: true, error_code: 0, done: false };
    iterate i up_to 128 carrying st: SpecInputsWalk = initial {
        if st.done || !(st.ok) {
            return SpecInputsWalk { ..st, acc: reverse_vm_values(st.acc) };
        }
        next st = lower_spec_inputs_step<P, N>(pages, stride, total, func.nominals, nat_env, schemas, st);
    }
    return SpecInputsWalk { ..st, acc: reverse_vm_values(st.acc), ok: st.ok && st.done };
}
fn lower_spec_inputs_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, nat_env: NatEnv, schemas: VmSchemas, st: SpecInputsWalk) -> (result: SpecInputsWalk) {
    return match st.ssa_vals {
        ssa.ValueList.VNil => SpecInputsWalk { ..st, ok: decl_field_list_empty(st.fields), error_code: select(decl_field_list_empty(st.fields), 0, 7), done: true },
        ssa.ValueList.VCons { head: v, tail: v_rest } => lower_spec_inputs_pair<P, N>(pages, stride, total, nominals, nat_env, schemas, st, v, v_rest)
    };
}
fn lower_spec_inputs_pair<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, nat_env: NatEnv, schemas: VmSchemas, st: SpecInputsWalk, v: ssa.Value, v_rest: ssa.ValueList) -> (result: SpecInputsWalk) {
    return match st.fields {
        decl.FieldList.FNil => SpecInputsWalk { ..st, ok: false, error_code: 7, done: true },
        decl.FieldList.FCons { head: fld, tail: f_rest } => lower_spec_input_one<P, N>(pages, stride, total, nominals, nat_env, schemas, st, v, v_rest, fld, f_rest)
    };
}
fn lower_spec_input_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, nat_env: NatEnv, schemas: VmSchemas, st: SpecInputsWalk, v: ssa.Value, v_rest: ssa.ValueList, fld: decl.Field, f_rest: decl.FieldList) -> (result: SpecInputsWalk) {
    let non_seq: VmType = resolve_sem_type_non_seq<P, N>(pages, stride, total, v.ty, nominals, schemas);
    if non_seq.valid {
        return SpecInputsWalk { ssa_vals: v_rest, fields: f_rest, acc: VmValueList.VVCons { head: VmValue { id: v.id, ty: non_seq }, tail: st.acc }, ok: true, error_code: 0, done: false };
    }
    let seq_res: SeqTypeParseResult = parse_byte_seq_vm_type<P, N>(pages, stride, total, fld.type_start, fld.type_end, nat_env);
    if seq_res.ok {
        return SpecInputsWalk { ssa_vals: v_rest, fields: f_rest, acc: VmValueList.VVCons { head: VmValue { id: v.id, ty: seq_res.ty }, tail: st.acc }, ok: true, error_code: 0, done: false };
    }
    return SpecInputsWalk { ..st, ok: false, error_code: seq_res.error_code, done: true };
}

fn resolve_spec_result_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, nat_env: NatEnv, schemas: VmSchemas) -> (result: SeqTypeParseResult) {
    let non_seq: VmType = resolve_sem_type_non_seq<P, N>(pages, stride, total, func.result_type, func.nominals, schemas);
    if non_seq.valid { return SeqTypeParseResult { ok: true, error_code: 0, ty: non_seq }; }
    return match fn_decl.sig.results {
        decl.FieldList.FNil => SeqTypeParseResult { ok: false, error_code: 4, ty: invalid_vm_type() },
        decl.FieldList.FCons { head: rfld, tail: rest } => parse_byte_seq_vm_type<P, N>(pages, stride, total, rfld.type_start, rfld.type_end, nat_env)
    };
}

// Find an SSA block by numeric block ID.
record SsaBlkLookup { found: bool, blk: ssa.SsaBlock }
fn dummy_ssa_block() -> (result: ssa.SsaBlock) {
    return ssa.SsaBlock {
        id: 0, parameters: ssa.ValueList.VNil, parameter_bindings: ssa.Environment.EnvNil,
        instructions: ssa.InstructionList.QNil, terminator: ssa.Terminator.Fail,
        reachable: false, has_failure_target: false, failure_target: 0,
        lowering_ok: false, lowering_failure_kind: 0
    };
}
fn ssa_blk_head_id_eq(blocks: ssa.SsaBlockList, target: u64) -> (result: bool) {
    return match blocks { ssa.SsaBlockList.LNil => false, ssa.SsaBlockList.LCons { head: b, tail: t } => b.id == target };
}
fn ssa_blk_head(blocks: ssa.SsaBlockList) -> (result: ssa.SsaBlock) {
    return match blocks { ssa.SsaBlockList.LNil => dummy_ssa_block(), ssa.SsaBlockList.LCons { head: b, tail: t } => b };
}
fn ssa_blk_tail(blocks: ssa.SsaBlockList) -> (result: ssa.SsaBlockList) {
    return match blocks { ssa.SsaBlockList.LNil => ssa.SsaBlockList.LNil, ssa.SsaBlockList.LCons { head: b, tail: t } => t };
}
fn find_ssa_block_by_id(blocks: ssa.SsaBlockList, target: u64) -> (result: SsaBlkLookup) {
    iterate i up_to 1024 carrying rest: ssa.SsaBlockList = blocks {
        if ssa_block_list_empty(rest) { return SsaBlkLookup { found: false, blk: dummy_ssa_block() }; }
        if ssa_blk_head_id_eq(rest, target) { return SsaBlkLookup { found: true, blk: ssa_blk_head(rest) }; }
        next rest = ssa_blk_tail(rest);
    }
    return SsaBlkLookup { found: false, blk: dummy_ssa_block() };
}

// Compute disjoint fresh value/instruction/block IDs for expanded loop & switch lowerings.
record FnMaxIds { next_val: u64, next_inst: u64, next_blk: u64 }
record MaxValsWalk { rest: ssa.ValueList, next_val: u64 }
fn max_u64(a: u64, b: u64) -> (result: u64) {
    if a >= b { return a; }
    return b;
}
fn max_val_ids_in_values(values: ssa.ValueList, seed: u64) -> (result: u64) {
    iterate chunk up_to 8 carrying st: MaxValsWalk = MaxValsWalk { rest: values, next_val: seed } {
        if ssa_value_list_empty(st.rest) { return st.next_val; }
        next st = max_val_ids_chunk(st);
    }
    return st.next_val;
}
fn max_val_ids_chunk(initial: MaxValsWalk) -> (result: MaxValsWalk) {
    iterate i up_to 1024 carrying st: MaxValsWalk = initial {
        if ssa_value_list_empty(st.rest) { return st; }
        next st = max_val_ids_step(st);
    }
    return st;
}
fn max_val_ids_step(st: MaxValsWalk) -> (result: MaxValsWalk) {
    return match st.rest {
        ssa.ValueList.VNil => st,
        ssa.ValueList.VCons { head: v, tail: rest } => MaxValsWalk { rest: rest, next_val: max_u64(st.next_val, v.id + 1) }
    };
}
record MaxInstsWalk { rest: ssa.InstructionList, next_val: u64, next_inst: u64 }
fn max_ids_in_insts(insts: ssa.InstructionList, seed: FnMaxIds) -> (result: FnMaxIds) {
    let init: MaxInstsWalk = MaxInstsWalk { rest: insts, next_val: seed.next_val, next_inst: seed.next_inst };
    iterate i up_to 1024 carrying st: MaxInstsWalk = init {
        if ssa_inst_list_empty(st.rest) { return FnMaxIds { next_val: st.next_val, next_inst: st.next_inst, next_blk: seed.next_blk }; }
        next st = max_ids_in_inst_step(st);
    }
    return FnMaxIds { next_val: st.next_val, next_inst: st.next_inst, next_blk: seed.next_blk };
}
fn max_ids_in_inst_step(st: MaxInstsWalk) -> (result: MaxInstsWalk) {
    return match st.rest {
        ssa.InstructionList.QNil => st,
        ssa.InstructionList.QCons { head: inst, tail: rest } => MaxInstsWalk {
            rest: rest,
            next_val: max_u64(st.next_val, inst.result + 1),
            next_inst: max_u64(st.next_inst, inst.id + 1)
        }
    };
}
record MaxBlkIdsWalk { rest: ssa.SsaBlockList, ids: FnMaxIds }
fn max_fn_val_inst_ids(func: ssa.Function) -> (result: FnMaxIds) {
    let seed_val: u64 = max_u64(func.value_count + 1, max_val_ids_in_values(func.values, 1));
    let seed_blk: u64 = max_u64(func.block_count, 1);
    let init: MaxBlkIdsWalk = MaxBlkIdsWalk { rest: func.blocks, ids: FnMaxIds { next_val: seed_val, next_inst: 1, next_blk: seed_blk } };
    iterate i up_to 1024 carrying st: MaxBlkIdsWalk = init {
        if ssa_block_list_empty(st.rest) { return st.ids; }
        next st = max_blk_ids_step(st);
    }
    return st.ids;
}
fn max_blk_ids_step(st: MaxBlkIdsWalk) -> (result: MaxBlkIdsWalk) {
    return match st.rest {
        ssa.SsaBlockList.LNil => st,
        ssa.SsaBlockList.LCons { head: blk, tail: rest } => max_blk_ids_one(st.ids, blk, rest)
    };
}
fn max_blk_ids_one(ids: FnMaxIds, blk: ssa.SsaBlock, rest: ssa.SsaBlockList) -> (result: MaxBlkIdsWalk) {
    let nv: u64 = max_val_ids_in_values(blk.parameters, ids.next_val);
    let nb: u64 = max_u64(ids.next_blk, blk.id + 1);
    let updated: FnMaxIds = max_ids_in_insts(blk.instructions, FnMaxIds { next_val: nv, next_inst: ids.next_inst, next_blk: nb });
    return MaxBlkIdsWalk { rest: rest, ids: updated };
}

// Seed sequence-typed inputs and propagate bounded byte-sequence VmTypes across
// SequenceView instructions and CFG block-parameter edges to a fixed point.
record SeqSeedWalk { rest: VmValueList, acc: VmValueList }
fn seed_seq_inputs(inputs: VmValueList) -> (result: VmValueList) {
    iterate i up_to 128 carrying st: SeqSeedWalk = SeqSeedWalk { rest: inputs, acc: VmValueList.VVNil } {
        if vm_value_list_empty(st.rest) { return st.acc; }
        next st = seed_seq_input_step(st);
    }
    return st.acc;
}
fn seed_seq_input_step(st: SeqSeedWalk) -> (result: SeqSeedWalk) {
    return match st.rest {
        VVNil => st,
        VVCons { head: v, tail: rest } => seed_seq_input_one(st, v, rest)
    };
}
fn seed_seq_input_one(st: SeqSeedWalk, v: VmValue, rest: VmValueList) -> (result: SeqSeedWalk) {
    if is_seq_vm_type(v.ty) {
        return SeqSeedWalk { rest: rest, acc: VmValueList.VVCons { head: v, tail: st.acc } };
    }
    return SeqSeedWalk { rest: rest, acc: st.acc };
}

record SeqPropState {
    blocks: ssa.SsaBlockList,
    seq_vals: VmValueList,
    changed: bool,
    ok: bool,
    error_code: u64,
    error_block: u64,
    error_inst: u64
}
fn record_seq_val(st: SeqPropState, id: u64, ty: VmType, blk_id: u64, inst_id: u64) -> (result: SeqPropState) {
    let lk: VmValTypeLookup = lookup_vm_value_type(st.seq_vals, id);
    if lk.found {
        if vm_type_equal(lk.ty, ty) { return st; }
        return SeqPropState { ..st, ok: false, error_code: 7, error_block: blk_id, error_inst: inst_id };
    }
    return SeqPropState {
        ..st,
        seq_vals: VmValueList.VVCons { head: VmValue { id: id, ty: ty }, tail: st.seq_vals },
        changed: true
    };
}

record PropBlkInstsWalk { prop: SeqPropState, blk_id: u64, rest: ssa.InstructionList }
fn prop_seq_blk_insts(prop: SeqPropState, blk_id: u64, insts: ssa.InstructionList) -> (result: SeqPropState) {
    let init: PropBlkInstsWalk = PropBlkInstsWalk { prop: prop, blk_id: blk_id, rest: insts };
    iterate i up_to 1024 carrying w: PropBlkInstsWalk = init {
        if !(w.prop.ok) || ssa_inst_list_empty(w.rest) { return w.prop; }
        next w = prop_seq_blk_inst_step(w);
    }
    return w.prop;
}
fn prop_seq_blk_inst_step(w: PropBlkInstsWalk) -> (result: PropBlkInstsWalk) {
    return match w.rest {
        ssa.InstructionList.QNil => w,
        ssa.InstructionList.QCons { head: inst, tail: rest } => prop_seq_blk_inst_one(w.prop, w.blk_id, inst, rest)
    };
}
fn prop_seq_blk_inst_one(prop: SeqPropState, blk_id: u64, inst: ssa.Instruction, rest: ssa.InstructionList) -> (result: PropBlkInstsWalk) {
    if inst.kind == 11 && inst.argc == 2 {
        return match inst.inputs {
            ssa.IdList.INil => PropBlkInstsWalk { prop: prop, blk_id: blk_id, rest: rest },
            ssa.IdList.ICons { head: base_id, tail: trailing } => prop_seq_project_from_base(prop, blk_id, inst, rest, base_id.value)
        };
    }
    if inst.kind != 17 || inst.operator != 9 || inst.argc != 3 {
        return PropBlkInstsWalk { prop: prop, blk_id: blk_id, rest: rest };
    }
    return match inst.inputs {
        ssa.IdList.INil => PropBlkInstsWalk { prop: prop, blk_id: blk_id, rest: rest },
        ssa.IdList.ICons { head: base_id, tail: trailing } => prop_seq_view_from_base(prop, blk_id, inst, rest, base_id.value)
    };
}
fn prop_seq_project_from_base(prop: SeqPropState, blk_id: u64, inst: ssa.Instruction, rest: ssa.InstructionList, base_id: u64) -> (result: PropBlkInstsWalk) {
    let base: VmValTypeLookup = lookup_vm_value_type(prop.seq_vals, base_id);
    if !(base.found) || !(base.ty.valid) || base.ty.kind != 6 {
        return PropBlkInstsWalk { prop: prop, blk_id: blk_id, rest: rest };
    }
    let elem_ty: VmType = seq_element_vm_type(base.ty);
    if !(elem_ty.valid) || elem_ty.kind != 4 {
        return PropBlkInstsWalk { prop: SeqPropState { ..prop, ok: false, error_code: 4, error_block: blk_id, error_inst: inst.id }, blk_id: blk_id, rest: ssa.InstructionList.QNil };
    }
    let next_prop: SeqPropState = record_seq_val(prop, inst.result, elem_ty, blk_id, inst.id);
    return PropBlkInstsWalk { prop: next_prop, blk_id: blk_id, rest: rest };
}
fn seq_view_up_to_type(base_ty: VmType) -> (result: VmType) {
    if !(is_seq_vm_type(base_ty)) || base_ty.bound_value == 0 || base_ty.bound_value > 65536 {
        return invalid_vm_type();
    }
    if base_ty.kind == 4 {
        return VmType { ..base_ty, bound_kind: 2 };
    }
    return nested_seq_vm_type(seq_element_vm_type(base_ty), 2, base_ty.bound_value);
}
fn prop_seq_view_from_base(prop: SeqPropState, blk_id: u64, inst: ssa.Instruction, rest: ssa.InstructionList, base_id: u64) -> (result: PropBlkInstsWalk) {
    let base: VmValTypeLookup = lookup_vm_value_type(prop.seq_vals, base_id);
    if !(base.found) || !(is_seq_vm_type(base.ty)) || base.ty.bound_value == 0 {
        return PropBlkInstsWalk { prop: prop, blk_id: blk_id, rest: rest };
    }
    let view_ty: VmType = seq_view_up_to_type(base.ty);
    if !(view_ty.valid) {
        return PropBlkInstsWalk { prop: SeqPropState { ..prop, ok: false, error_code: 4, error_block: blk_id, error_inst: inst.id }, blk_id: blk_id, rest: ssa.InstructionList.QNil };
    }
    let next_prop: SeqPropState = record_seq_val(prop, inst.result, view_ty, blk_id, inst.id);
    return PropBlkInstsWalk { prop: next_prop, blk_id: blk_id, rest: rest };
}

record PropEdgeZipWalk { prop: SeqPropState, from_blk: u64, tgt_blk: u64, args: ssa.IdList, params: ssa.ValueList, done: bool }
fn prop_seq_edge(prop: SeqPropState, from_blk: u64, target: u64, args: ssa.IdList) -> (result: SeqPropState) {
    let blk_lk: SsaBlkLookup = find_ssa_block_by_id(prop.blocks, target);
    if !(blk_lk.found) {
        return SeqPropState { ..prop, ok: false, error_code: 7, error_block: from_blk, error_inst: 0 };
    }
    let init: PropEdgeZipWalk = PropEdgeZipWalk { prop: prop, from_blk: from_blk, tgt_blk: target, args: args, params: blk_lk.blk.parameters, done: false };
    iterate i up_to 128 carrying w: PropEdgeZipWalk = init {
        if !(w.prop.ok) || w.done { return w.prop; }
        next w = prop_seq_edge_step(w);
    }
    return w.prop;
}
fn prop_seq_edge_step(w: PropEdgeZipWalk) -> (result: PropEdgeZipWalk) {
    return match w.args {
        ssa.IdList.INil => prop_edge_end(w),
        ssa.IdList.ICons { head: aid, tail: arest } => prop_edge_pair(w, aid.value, arest)
    };
}
fn prop_edge_end(w: PropEdgeZipWalk) -> (result: PropEdgeZipWalk) {
    if !(ssa_value_list_empty(w.params)) {
        return PropEdgeZipWalk { ..w, prop: SeqPropState { ..w.prop, ok: false, error_code: 7, error_block: w.from_blk, error_inst: 0 }, done: true };
    }
    return PropEdgeZipWalk { ..w, done: true };
}
fn prop_edge_pair(w: PropEdgeZipWalk, aid: u64, arest: ssa.IdList) -> (result: PropEdgeZipWalk) {
    return match w.params {
        ssa.ValueList.VNil => PropEdgeZipWalk { ..w, prop: SeqPropState { ..w.prop, ok: false, error_code: 7, error_block: w.from_blk, error_inst: 0 }, done: true },
        ssa.ValueList.VCons { head: param, tail: prest } => prop_edge_one(w, aid, arest, param, prest)
    };
}
fn prop_edge_one(w: PropEdgeZipWalk, aid: u64, arest: ssa.IdList, param: ssa.Value, prest: ssa.ValueList) -> (result: PropEdgeZipWalk) {
    if !(is_seq_sem_type(param.ty)) {
        return PropEdgeZipWalk { ..w, args: arest, params: prest };
    }
    let arg_lk: VmValTypeLookup = lookup_vm_value_type(w.prop.seq_vals, aid);
    if !(arg_lk.found) {
        return PropEdgeZipWalk { ..w, args: arest, params: prest };
    }
    let next_prop: SeqPropState = record_seq_val(w.prop, param.id, arg_lk.ty, w.tgt_blk, 0);
    return PropEdgeZipWalk { ..w, prop: next_prop, args: arest, params: prest };
}

fn prop_seq_blk_term(prop: SeqPropState, blk: ssa.SsaBlock) -> (result: SeqPropState) {
    return match blk.terminator {
        ssa.Terminator.Jump { target: tgt, arguments: args } => prop_seq_edge(prop, blk.id, tgt, args),
        ssa.Terminator.Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => prop_seq_branch(prop, blk.id, y, ya, n, na),
        ssa.Terminator.Return { value: v } => prop,
        ssa.Terminator.Fail => prop,
        ssa.Terminator.FiniteSwitch { subject: s, subject_ty: st, nominal_identity: ni, result_type: rt, source_start: ss, source_end: se, arm_count: ac, join_target: jt, cases: cs } => prop_seq_finite_switch_cases(prop, blk.id, cs),
        ssa.Terminator.ScalarSwitch { subject: s, subject_ty: st, result_type: rt, source_start: ss, source_end: se, arm_count: ac, default_target: dt, join_target: jt, cases: cs } => prop_seq_scalar_switch_cases(prop, blk.id, cs)
    };
}
record PropFiniteCasesWalk { prop: SeqPropState, blk_id: u64, rest: ssa.FiniteMatchCaseList }
fn prop_seq_finite_switch_cases(prop: SeqPropState, blk_id: u64, cases: ssa.FiniteMatchCaseList) -> (result: SeqPropState) {
    let init: PropFiniteCasesWalk = PropFiniteCasesWalk { prop: prop, blk_id: blk_id, rest: cases };
    iterate i up_to 256 carrying w: PropFiniteCasesWalk = init {
        if !(w.prop.ok) || finite_cases_empty(w.rest) { return w.prop; }
        next w = prop_seq_finite_case_step(w);
    }
    return w.prop;
}
fn prop_seq_finite_case_step(w: PropFiniteCasesWalk) -> (result: PropFiniteCasesWalk) {
    return match w.rest {
        ssa.FiniteMatchCaseList.MCNil => w,
        ssa.FiniteMatchCaseList.MCCons { head: cs, tail: rest } => PropFiniteCasesWalk { prop: prop_seq_edge(w.prop, w.blk_id, cs.target, cs.arguments), blk_id: w.blk_id, rest: rest }
    };
}
record PropScalarCasesWalk { prop: SeqPropState, blk_id: u64, rest: ssa.ScalarMatchCaseList }
fn prop_seq_scalar_switch_cases(prop: SeqPropState, blk_id: u64, cases: ssa.ScalarMatchCaseList) -> (result: SeqPropState) {
    let init: PropScalarCasesWalk = PropScalarCasesWalk { prop: prop, blk_id: blk_id, rest: cases };
    iterate i up_to 1024 carrying w: PropScalarCasesWalk = init {
        if !(w.prop.ok) || scalar_cases_empty(w.rest) { return w.prop; }
        next w = prop_seq_scalar_case_step(w);
    }
    return w.prop;
}
fn prop_seq_scalar_case_step(w: PropScalarCasesWalk) -> (result: PropScalarCasesWalk) {
    return match w.rest {
        ssa.ScalarMatchCaseList.SCNil => w,
        ssa.ScalarMatchCaseList.SCCons { head: cs, tail: rest } => PropScalarCasesWalk { prop: prop_seq_edge(w.prop, w.blk_id, cs.target, cs.arguments), blk_id: w.blk_id, rest: rest }
    };
}
fn prop_seq_branch(prop: SeqPropState, blk_id: u64, yes_t: u64, ya: ssa.IdList, no_t: u64, na: ssa.IdList) -> (result: SeqPropState) {
    let p1: SeqPropState = prop_seq_edge(prop, blk_id, yes_t, ya);
    if !(p1.ok) { return p1; }
    return prop_seq_edge(p1, blk_id, no_t, na);
}

record PropSeqBlksWalk { prop: SeqPropState, rest: ssa.SsaBlockList }
fn prop_seq_blocks_pass(prop: SeqPropState) -> (result: SeqPropState) {
    let init: PropSeqBlksWalk = PropSeqBlksWalk { prop: SeqPropState { ..prop, changed: false }, rest: prop.blocks };
    iterate i up_to 1024 carrying w: PropSeqBlksWalk = init {
        if !(w.prop.ok) || ssa_block_list_empty(w.rest) { return w.prop; }
        next w = prop_seq_block_step(w);
    }
    return w.prop;
}
fn prop_seq_block_step(w: PropSeqBlksWalk) -> (result: PropSeqBlksWalk) {
    return match w.rest {
        ssa.SsaBlockList.LNil => w,
        ssa.SsaBlockList.LCons { head: blk, tail: rest } => prop_seq_block_one(w.prop, blk, rest)
    };
}
fn prop_seq_block_one(prop: SeqPropState, blk: ssa.SsaBlock, rest: ssa.SsaBlockList) -> (result: PropSeqBlksWalk) {
    let p1: SeqPropState = prop_seq_blk_insts(prop, blk.id, blk.instructions);
    if !(p1.ok) { return PropSeqBlksWalk { prop: p1, rest: ssa.SsaBlockList.LNil }; }
    let p2: SeqPropState = prop_seq_blk_term(p1, blk);
    return PropSeqBlksWalk { prop: p2, rest: rest };
}

fn propagate_spec_seq_types(blocks: ssa.SsaBlockList, fn_inputs: VmValueList) -> (result: SeqPropState) {
    let seeded: VmValueList = seed_seq_inputs(fn_inputs);
    let init: SeqPropState = SeqPropState { blocks: blocks, seq_vals: seeded, changed: true, ok: true, error_code: 0, error_block: 0, error_inst: 0 };
    iterate pass up_to 128 carrying st: SeqPropState = init {
        if !(st.ok) || !(st.changed) { return st; }
        next st = prop_seq_blocks_pass(st);
    }
    return st;
}

// Lower one block's parameters to concrete VmType values.
record SpecBlkParamsWalk { rest: ssa.ValueList, acc: VmValueList, ok: bool, error_code: u64 }
fn lower_spec_block_params<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, blk: ssa.SsaBlock, func: ssa.Function, fn_decl: decl.FnDecl, nat_env: NatEnv, schemas: VmSchemas, seq_vals: VmValueList) -> (result: SpecBlkParamsWalk) {
    let initial: SpecBlkParamsWalk = SpecBlkParamsWalk { rest: blk.parameters, acc: VmValueList.VVNil, ok: true, error_code: 0 };
    iterate i up_to 1024 carrying st: SpecBlkParamsWalk = initial {
        if !(st.ok) || ssa_value_list_empty(st.rest) {
            return SpecBlkParamsWalk { rest: st.rest, acc: reverse_vm_values(st.acc), ok: st.ok && ssa_value_list_empty(st.rest), error_code: st.error_code };
        }
        next st = lower_spec_block_param_step<P, N>(pages, stride, total, blk.parameter_bindings, func.nominals, fn_decl.sig.params, nat_env, schemas, seq_vals, st);
    }
    return SpecBlkParamsWalk { rest: st.rest, acc: reverse_vm_values(st.acc), ok: st.ok && ssa_value_list_empty(st.rest), error_code: st.error_code };
}
fn lower_spec_block_param_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, pbinds: ssa.Environment, nominals: decl.NominalTypeIdentityList, fn_params: decl.FieldList, nat_env: NatEnv, schemas: VmSchemas, seq_vals: VmValueList, st: SpecBlkParamsWalk) -> (result: SpecBlkParamsWalk) {
    return match st.rest {
        ssa.ValueList.VNil => st,
        ssa.ValueList.VCons { head: v, tail: rest } => lower_spec_block_param_one<P, N>(pages, stride, total, pbinds, nominals, fn_params, nat_env, schemas, seq_vals, st, v, rest)
    };
}
fn lower_spec_block_param_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, pbinds: ssa.Environment, nominals: decl.NominalTypeIdentityList, fn_params: decl.FieldList, nat_env: NatEnv, schemas: VmSchemas, seq_vals: VmValueList, st: SpecBlkParamsWalk, v: ssa.Value, rest: ssa.ValueList) -> (result: SpecBlkParamsWalk) {
    let non_seq: VmType = resolve_sem_type_non_seq<P, N>(pages, stride, total, v.ty, nominals, schemas);
    if non_seq.valid {
        return SpecBlkParamsWalk { rest: rest, acc: VmValueList.VVCons { head: VmValue { id: v.id, ty: non_seq }, tail: st.acc }, ok: true, error_code: 0 };
    }
    let prop_seq: VmValTypeLookup = lookup_vm_value_type(seq_vals, v.id);
    if prop_seq.found && prop_seq.ty.valid {
        return SpecBlkParamsWalk { rest: rest, acc: VmValueList.VVCons { head: VmValue { id: v.id, ty: prop_seq.ty }, tail: st.acc }, ok: true, error_code: 0 };
    }
    let env_lk: EnvValIdLookup = find_env_binding_by_val_id(pbinds, v.id);
    if !(env_lk.found) { return SpecBlkParamsWalk { rest: ssa.ValueList.VNil, acc: st.acc, ok: false, error_code: 4 }; }
    let fld_lk: FieldSpanLookup = find_field_by_name_span<P, N>(pages, stride, total, fn_params, env_lk.name_start, env_lk.name_end);
    if !(fld_lk.found) { return SpecBlkParamsWalk { rest: ssa.ValueList.VNil, acc: st.acc, ok: false, error_code: 4 }; }
    let seq_res: SeqTypeParseResult = parse_byte_seq_vm_type<P, N>(pages, stride, total, fld_lk.fld.type_start, fld_lk.fld.type_end, nat_env);
    if !(seq_res.ok) { return SpecBlkParamsWalk { rest: ssa.ValueList.VNil, acc: st.acc, ok: false, error_code: seq_res.error_code }; }
    return SpecBlkParamsWalk { rest: rest, acc: VmValueList.VVCons { head: VmValue { id: v.id, ty: seq_res.ty }, tail: st.acc }, ok: true, error_code: 0 };
}

// Pre-build complete ValueId -> concrete VmType map for a specialized function.
record AppendVmValsWalk { rest: VmValueList, acc: VmValueList }
fn append_unique_vm_values(front: VmValueList, back: VmValueList) -> (result: VmValueList) {
    iterate i up_to 1024 carrying st: AppendVmValsWalk = AppendVmValsWalk { rest: front, acc: back } {
        if vm_value_list_empty(st.rest) { return st.acc; }
        next st = append_unique_vm_values_step(st);
    }
    return st.acc;
}
fn append_unique_vm_values_step(st: AppendVmValsWalk) -> (result: AppendVmValsWalk) {
    return match st.rest {
        VVNil => st,
        VVCons { head: h, tail: t } => append_unique_vm_values_one(h, t, st.acc)
    };
}
fn append_unique_vm_values_one(h: VmValue, t: VmValueList, acc: VmValueList) -> (result: AppendVmValsWalk) {
    let existing: VmValTypeLookup = lookup_vm_value_type(acc, h.id);
    if existing.found { return AppendVmValsWalk { rest: t, acc: acc }; }
    return AppendVmValsWalk { rest: t, acc: VmValueList.VVCons { head: h, tail: acc } };
}

record NonSeqValMapWalk { rest: ssa.ValueList, acc: VmValueList }
fn add_non_seq_ssa_values<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ssa.ValueList, nominals: decl.NominalTypeIdentityList, schemas: VmSchemas, acc: VmValueList) -> (result: VmValueList) {
    iterate chunk up_to 8 carrying st: NonSeqValMapWalk = NonSeqValMapWalk { rest: values, acc: acc } {
        if ssa_value_list_empty(st.rest) { return st.acc; }
        next st = add_non_seq_ssa_chunk<P, N>(pages, stride, total, nominals, schemas, st);
    }
    return st.acc;
}
fn add_non_seq_ssa_chunk<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, schemas: VmSchemas, initial: NonSeqValMapWalk) -> (result: NonSeqValMapWalk) {
    iterate i up_to 1024 carrying st: NonSeqValMapWalk = initial {
        if ssa_value_list_empty(st.rest) { return st; }
        next st = add_non_seq_ssa_step<P, N>(pages, stride, total, nominals, schemas, st);
    }
    return st;
}
fn add_non_seq_ssa_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, schemas: VmSchemas, st: NonSeqValMapWalk) -> (result: NonSeqValMapWalk) {
    return match st.rest {
        ssa.ValueList.VNil => st,
        ssa.ValueList.VCons { head: v, tail: rest } => add_non_seq_ssa_one<P, N>(pages, stride, total, nominals, schemas, st, v, rest)
    };
}
fn add_non_seq_ssa_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, schemas: VmSchemas, st: NonSeqValMapWalk, v: ssa.Value, rest: ssa.ValueList) -> (result: NonSeqValMapWalk) {
    let vt: VmType = resolve_sem_type_non_seq<P, N>(pages, stride, total, v.ty, nominals, schemas);
    if vt.valid {
        return NonSeqValMapWalk { rest: rest, acc: VmValueList.VVCons { head: VmValue { id: v.id, ty: vt }, tail: st.acc } };
    }
    return NonSeqValMapWalk { rest: rest, acc: st.acc };
}

record CollectBlkParamTypesWalk { rest: ssa.SsaBlockList, acc: VmValueList, ok: bool, error_code: u64, error_block: u64 }
fn collect_all_spec_block_param_types<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, nat_env: NatEnv, schemas: VmSchemas, seq_vals: VmValueList, seed: VmValueList) -> (result: CollectBlkParamTypesWalk) {
    let initial: CollectBlkParamTypesWalk = CollectBlkParamTypesWalk { rest: func.blocks, acc: seed, ok: true, error_code: 0, error_block: 0 };
    iterate i up_to 1024 carrying st: CollectBlkParamTypesWalk = initial {
        if !(st.ok) || ssa_block_list_empty(st.rest) { return st; }
        next st = collect_all_spec_block_param_step<P, N>(pages, stride, total, func, fn_decl, nat_env, schemas, seq_vals, st);
    }
    return st;
}
fn collect_all_spec_block_param_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, nat_env: NatEnv, schemas: VmSchemas, seq_vals: VmValueList, st: CollectBlkParamTypesWalk) -> (result: CollectBlkParamTypesWalk) {
    return match st.rest {
        ssa.SsaBlockList.LNil => st,
        ssa.SsaBlockList.LCons { head: blk, tail: rest } => collect_all_spec_block_param_one<P, N>(pages, stride, total, func, fn_decl, nat_env, schemas, seq_vals, st, blk, rest)
    };
}
fn collect_all_spec_block_param_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, nat_env: NatEnv, schemas: VmSchemas, seq_vals: VmValueList, st: CollectBlkParamTypesWalk, blk: ssa.SsaBlock, rest: ssa.SsaBlockList) -> (result: CollectBlkParamTypesWalk) {
    let lp: SpecBlkParamsWalk = lower_spec_block_params<P, N>(pages, stride, total, blk, func, fn_decl, nat_env, schemas, seq_vals);
    if !(lp.ok) {
        return CollectBlkParamTypesWalk { rest: ssa.SsaBlockList.LNil, acc: st.acc, ok: false, error_code: lp.error_code, error_block: blk.id };
    }
    return CollectBlkParamTypesWalk { rest: rest, acc: append_unique_vm_values(lp.acc, st.acc), ok: true, error_code: 0, error_block: 0 };
}

record SpecInstListWalk {
    rest: ssa.InstructionList,
    val_types: VmValueList,
    acc: VmInstructionList,
    count: u64,
    next_val_id: u64,
    next_inst_id: u64,
    ok: bool,
    error_code: u64,
    error_inst: u64
}
fn lower_spec_seq_view(st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList) -> (result: SpecInstListWalk) {
    if inst.operator != 9 { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 5, error_inst: inst.id }; }
    if inst.argc != 3 { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id }; }
    return match inst.inputs {
        ssa.IdList.INil => SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id },
        ssa.IdList.ICons { head: base_id, tail: after_base } => lower_spec_seq_view_start(st, inst, rest, base_id.value, after_base)
    };
}
fn lower_spec_seq_view_start(st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, base_id: u64, after_base: ssa.IdList) -> (result: SpecInstListWalk) {
    return match after_base {
        ssa.IdList.INil => SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id },
        ssa.IdList.ICons { head: start_id, tail: after_start } => lower_spec_seq_view_end(st, inst, rest, base_id, start_id.value, after_start)
    };
}
fn lower_spec_seq_view_end(st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, base_id: u64, start_id: u64, after_start: ssa.IdList) -> (result: SpecInstListWalk) {
    return match after_start {
        ssa.IdList.INil => SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id },
        ssa.IdList.ICons { head: end_id, tail: trailing } => lower_spec_seq_view_emit(st, inst, rest, base_id, start_id, end_id.value, trailing)
    };
}
fn lower_spec_seq_view_emit(st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, base_id: u64, start_id: u64, end_id: u64, trailing: ssa.IdList) -> (result: SpecInstListWalk) {
    if !(id_list_empty(trailing)) { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id }; }
    let base: VmValTypeLookup = lookup_vm_value_type(st.val_types, base_id);
    let start_v: VmValTypeLookup = lookup_vm_value_type(st.val_types, start_id);
    let end_v: VmValTypeLookup = lookup_vm_value_type(st.val_types, end_id);
    if !(base.found) || !(is_seq_vm_type(base.ty)) || base.ty.bound_value == 0 {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id };
    }
    if !(start_v.found) || !(is_u64_vm_type(start_v.ty)) || !(end_v.found) || !(is_u64_vm_type(end_v.ty)) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id };
    }
    let view_ty: VmType = seq_view_up_to_type(base.ty);
    if !(view_ty.valid) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 4, error_inst: inst.id };
    }
    let res_lk: VmValTypeLookup = lookup_vm_value_type(st.val_types, inst.result);
    if res_lk.found && !(vm_type_equal(res_lk.ty, view_ty)) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id };
    }
    let next_vals: VmValueList = select_vm_values(res_lk.found, st.val_types, VmValueList.VVCons { head: VmValue { id: inst.result, ty: view_ty }, tail: st.val_types });
    let vm_inst: VmInstruction = VmInstruction {
        id: inst.id, result: inst.result, opcode: 17, op_code: 0, intent: 0,
        imm_u64: 0, imm_bool: false,
        ty: view_ty, from_ty: base.ty,
        inputs: inst.inputs, callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
    };
    return SpecInstListWalk {
        ..st, rest: rest, val_types: next_vals,
        acc: VmInstructionList.VICons { head: vm_inst, tail: st.acc },
        count: st.count + 1, ok: true, error_code: 0, error_inst: 0
    };
}

fn lower_vm_loop_index_init(st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, res_ty: VmType) -> (result: SpecInstListWalk) {
    if inst.operator != 0 || inst.argc != 0 || !(id_list_empty(inst.inputs)) || !(is_u64_vm_type(res_ty)) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id };
    }
    let vm_inst: VmInstruction = VmInstruction {
        id: inst.id, result: inst.result, opcode: 1, op_code: 0, intent: 0,
        imm_u64: 0, imm_bool: false,
        ty: u64_vm_type(), from_ty: invalid_vm_type(),
        inputs: ssa.IdList.INil, callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
    };
    return SpecInstListWalk {
        ..st, rest: rest,
        acc: VmInstructionList.VICons { head: vm_inst, tail: st.acc },
        count: st.count + 1, ok: true, error_code: 0, error_inst: 0
    };
}

fn lower_vm_loop_index_advance(st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, res_ty: VmType) -> (result: SpecInstListWalk) {
    if inst.operator != 0 || inst.argc != 1 || !(is_u64_vm_type(res_ty)) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id };
    }
    return match inst.inputs {
        ssa.IdList.INil => SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id },
        ssa.IdList.ICons { head: idx_id, tail: trailing } => lower_vm_loop_advance_emit(st, inst, rest, idx_id.value, trailing)
    };
}
fn lower_vm_loop_advance_emit(st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, idx_id: u64, trailing: ssa.IdList) -> (result: SpecInstListWalk) {
    if !(id_list_empty(trailing)) { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id }; }
    let idx: VmValTypeLookup = lookup_vm_value_type(st.val_types, idx_id);
    if !(idx.found) || !(is_u64_vm_type(idx.ty)) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id };
    }
    let u64_ty: VmType = u64_vm_type();
    let one_id: u64 = st.next_val_id;
    let one_inst: VmInstruction = VmInstruction {
        id: st.next_inst_id, result: one_id, opcode: 1, op_code: 0, intent: 0,
        imm_u64: 1, imm_bool: false, ty: u64_ty, from_ty: invalid_vm_type(),
        inputs: ssa.IdList.INil, callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
    };
    let add_inputs: ssa.IdList = ssa.IdList.ICons { head: ssa.Id { value: idx_id }, tail: ssa.IdList.ICons { head: ssa.Id { value: one_id }, tail: ssa.IdList.INil } };
    let add_inst: VmInstruction = VmInstruction {
        id: st.next_inst_id + 1, result: inst.result, opcode: 3, op_code: 1, intent: 1,
        imm_u64: 0, imm_bool: false, ty: u64_ty, from_ty: u64_ty,
        inputs: add_inputs, callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
    };
    let acc1: VmInstructionList = VmInstructionList.VICons { head: one_inst, tail: st.acc };
    let acc2: VmInstructionList = VmInstructionList.VICons { head: add_inst, tail: acc1 };
    let next_vals: VmValueList = VmValueList.VVCons { head: VmValue { id: one_id, ty: u64_ty }, tail: st.val_types };
    return SpecInstListWalk {
        rest: rest, val_types: next_vals, acc: acc2,
        count: st.count + 2, next_val_id: st.next_val_id + 1, next_inst_id: st.next_inst_id + 2,
        ok: true, error_code: 0, error_inst: 0
    };
}

fn lower_vm_loop_guard<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nat_env: NatEnv, st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, res_ty: VmType) -> (result: SpecInstListWalk) {
    if res_ty.kind != 1 { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id }; }
    if inst.operator == 2 {
        if inst.argc != 2 { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id }; }
        return match inst.inputs {
            ssa.IdList.INil => SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id },
            ssa.IdList.ICons { head: idx_id, tail: after_idx } => lower_vm_seq_guard_seq(st, inst, rest, idx_id.value, after_idx)
        };
    }
    if inst.operator == 1 {
        if inst.argc != 1 { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id }; }
        return match inst.inputs {
            ssa.IdList.INil => SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id },
            ssa.IdList.ICons { head: idx_id, tail: trailing } => lower_vm_up_to_guard_emit<P, N>(pages, stride, total, nat_env, st, inst, rest, idx_id.value, trailing)
        };
    }
    return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 5, error_inst: inst.id };
}
fn lower_vm_seq_guard_seq(st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, idx_id: u64, after_idx: ssa.IdList) -> (result: SpecInstListWalk) {
    return match after_idx {
        ssa.IdList.INil => SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id },
        ssa.IdList.ICons { head: seq_id, tail: trailing } => lower_vm_seq_guard_emit(st, inst, rest, idx_id, seq_id.value, trailing)
    };
}
fn lower_vm_seq_guard_emit(st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, idx_id: u64, seq_id: u64, trailing: ssa.IdList) -> (result: SpecInstListWalk) {
    if !(id_list_empty(trailing)) { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id }; }
    let idx: VmValTypeLookup = lookup_vm_value_type(st.val_types, idx_id);
    let seq: VmValTypeLookup = lookup_vm_value_type(st.val_types, seq_id);
    if !(idx.found) || !(is_u64_vm_type(idx.ty)) || !(seq.found) || !(is_seq_vm_type(seq.ty)) || seq.ty.bound_value == 0 {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id };
    }
    let u64_ty: VmType = u64_vm_type();
    let len_id: u64 = st.next_val_id;
    let len_inst: VmInstruction = VmInstruction {
        id: st.next_inst_id, result: len_id, opcode: 14, op_code: 0, intent: 0,
        imm_u64: 0, imm_bool: false, ty: u64_ty, from_ty: seq.ty,
        inputs: ssa.IdList.ICons { head: ssa.Id { value: seq_id }, tail: ssa.IdList.INil },
        callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
    };
    let cmp_inputs: ssa.IdList = ssa.IdList.ICons { head: ssa.Id { value: idx_id }, tail: ssa.IdList.ICons { head: ssa.Id { value: len_id }, tail: ssa.IdList.INil } };
    let cmp_inst: VmInstruction = VmInstruction {
        id: st.next_inst_id + 1, result: inst.result, opcode: 4, op_code: 3, intent: 0,
        imm_u64: 0, imm_bool: false, ty: bool_vm_type(), from_ty: u64_ty,
        inputs: cmp_inputs, callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
    };
    let acc1: VmInstructionList = VmInstructionList.VICons { head: len_inst, tail: st.acc };
    let acc2: VmInstructionList = VmInstructionList.VICons { head: cmp_inst, tail: acc1 };
    let next_vals: VmValueList = VmValueList.VVCons { head: VmValue { id: len_id, ty: u64_ty }, tail: st.val_types };
    return SpecInstListWalk {
        rest: rest, val_types: next_vals, acc: acc2,
        count: st.count + 2, next_val_id: st.next_val_id + 1, next_inst_id: st.next_inst_id + 2,
        ok: true, error_code: 0, error_inst: 0
    };
}
fn lower_vm_up_to_guard_emit<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nat_env: NatEnv, st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList, idx_id: u64, trailing: ssa.IdList) -> (result: SpecInstListWalk) {
    if !(id_list_empty(trailing)) { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id }; }
    let idx: VmValTypeLookup = lookup_vm_value_type(st.val_types, idx_id);
    if !(idx.found) || !(is_u64_vm_type(idx.ty)) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 7, error_inst: inst.id };
    }
    let bound_res: NatBoundResult = resolve_nat_bound_span<P, N>(pages, stride, total, inst.variant_start, inst.variant_end, nat_env);
    if !(bound_res.ok) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: bound_res.error_code, error_inst: inst.id };
    }
    let u64_ty: VmType = u64_vm_type();
    let bound_id: u64 = st.next_val_id;
    let bound_inst: VmInstruction = VmInstruction {
        id: st.next_inst_id, result: bound_id, opcode: 1, op_code: 0, intent: 0,
        imm_u64: bound_res.value, imm_bool: false, ty: u64_ty, from_ty: invalid_vm_type(),
        inputs: ssa.IdList.INil, callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
    };
    let cmp_inputs: ssa.IdList = ssa.IdList.ICons { head: ssa.Id { value: idx_id }, tail: ssa.IdList.ICons { head: ssa.Id { value: bound_id }, tail: ssa.IdList.INil } };
    let cmp_inst: VmInstruction = VmInstruction {
        id: st.next_inst_id + 1, result: inst.result, opcode: 4, op_code: 3, intent: 0,
        imm_u64: 0, imm_bool: false, ty: bool_vm_type(), from_ty: u64_ty,
        inputs: cmp_inputs, callee_identity: decl.invalid_semantic_identity(),
        callee_nat_args: VmNatArgList.NANil, field_names: VmNameList.VNNil
    };
    let acc1: VmInstructionList = VmInstructionList.VICons { head: bound_inst, tail: st.acc };
    let acc2: VmInstructionList = VmInstructionList.VICons { head: cmp_inst, tail: acc1 };
    let next_vals: VmValueList = VmValueList.VVCons { head: VmValue { id: bound_id, ty: u64_ty }, tail: st.val_types };
    return SpecInstListWalk {
        rest: rest, val_types: next_vals, acc: acc2,
        count: st.count + 2, next_val_id: st.next_val_id + 1, next_inst_id: st.next_inst_id + 2,
        ok: true, error_code: 0, error_inst: 0
    };
}

fn lower_spec_instructions<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, nat_env: NatEnv, schemas: VmSchemas, val_types: VmValueList, insts: ssa.InstructionList, next_val_id: u64, next_inst_id: u64) -> (result: SpecInstListWalk) {
    let initial: SpecInstListWalk = SpecInstListWalk { rest: insts, val_types: val_types, acc: VmInstructionList.VINil, count: 0, next_val_id: next_val_id, next_inst_id: next_inst_id, ok: true, error_code: 0, error_inst: 0 };
    iterate i up_to 1024 carrying st: SpecInstListWalk = initial {
        if !(st.ok) || ssa_inst_list_empty(st.rest) {
            return SpecInstListWalk { ..st, acc: reverse_vm_insts(st.acc) };
        }
        next st = lower_spec_inst_step<P, N>(pages, stride, total, func.nominals, nat_env, schemas, st);
    }
    return SpecInstListWalk { ..st, acc: reverse_vm_insts(st.acc), ok: st.ok && ssa_inst_list_empty(st.rest), error_code: select(st.ok && !(ssa_inst_list_empty(st.rest)), 5, st.error_code) };
}
fn lower_spec_inst_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, nat_env: NatEnv, schemas: VmSchemas, st: SpecInstListWalk) -> (result: SpecInstListWalk) {
    return match st.rest {
        ssa.InstructionList.QNil => st,
        ssa.InstructionList.QCons { head: inst, tail: rest } => lower_spec_inst_one<P, N>(pages, stride, total, nominals, nat_env, schemas, st, inst, rest)
    };
}
fn resolve_spec_inst_result_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, inst: ssa.Instruction, nominals: decl.NominalTypeIdentityList, schemas: VmSchemas, val_types: VmValueList) -> (result: VmType) {
    let non_seq: VmType = resolve_sem_type_non_seq<P, N>(pages, stride, total, inst.ty, nominals, schemas);
    if non_seq.valid { return non_seq; }
    if is_seq_sem_type(inst.ty) {
        let seq_lk: VmValTypeLookup = lookup_vm_value_type(val_types, inst.result);
        if seq_lk.found && is_seq_vm_type(seq_lk.ty) {
            return seq_lk.ty;
        }
    }
    return invalid_vm_type();
}
fn lower_spec_inst_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, nat_env: NatEnv, schemas: VmSchemas, st: SpecInstListWalk, inst: ssa.Instruction, rest: ssa.InstructionList) -> (result: SpecInstListWalk) {
    if !(effects_empty(inst.effects)) || !(capabilities_empty(inst.capabilities)) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 3, error_inst: inst.id };
    }
    if inst.kind == 17 {
        return lower_spec_seq_view(st, inst, rest);
    }
    let res_ty: VmType = resolve_spec_inst_result_type<P, N>(pages, stride, total, inst, nominals, schemas, st.val_types);
    if !(res_ty.valid) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 4, error_inst: inst.id };
    }
    if inst.kind == 5 {
        let fc: InstLowerResult = lower_vm_finite_construct<P, N>(pages, stride, total, st.val_types, schemas.finites, inst, res_ty);
        if !(fc.ok) { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: fc.error_code, error_inst: inst.id }; }
        return SpecInstListWalk { ..st, rest: rest, acc: VmInstructionList.VICons { head: fc.inst, tail: st.acc }, count: st.count + 1, ok: true, error_code: 0, error_inst: 0 };
    }
    if inst.kind == 6 {
        let fp: InstLowerResult = lower_vm_finite_payload_project<P, N>(pages, stride, total, st.val_types, schemas.finites, inst, res_ty);
        if !(fp.ok) { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: fp.error_code, error_inst: inst.id }; }
        return SpecInstListWalk { ..st, rest: rest, acc: VmInstructionList.VICons { head: fp.inst, tail: st.acc }, count: st.count + 1, ok: true, error_code: 0, error_inst: 0 };
    }
    if inst.kind == 8 {
        let rp: InstLowerResult = lower_vm_record_project<P, N>(pages, stride, total, st.val_types, schemas.records, inst, res_ty);
        if !(rp.ok) { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: rp.error_code, error_inst: inst.id }; }
        return SpecInstListWalk { ..st, rest: rest, acc: VmInstructionList.VICons { head: rp.inst, tail: st.acc }, count: st.count + 1, ok: true, error_code: 0, error_inst: 0 };
    }
    if inst.kind == 18 {
        let sc: InstLowerResult = lower_vm_seq_construct(st.val_types, inst, res_ty);
        if !(sc.ok) { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: sc.error_code, error_inst: inst.id }; }
        return SpecInstListWalk { ..st, rest: rest, acc: VmInstructionList.VICons { head: sc.inst, tail: st.acc }, count: st.count + 1, ok: true, error_code: 0, error_inst: 0 };
    }
    if inst.kind == 16 {
        if inst.operator == 1 {
            return lower_vm_record_update<P, N>(pages, stride, total, schemas.records, st, inst, rest, res_ty);
        }
        if inst.operator != 0 {
            return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: 5, error_inst: inst.id };
        }
        let rc: InstLowerResult = lower_vm_record_construct<P, N>(pages, stride, total, st.val_types, schemas.records, inst, res_ty);
        if !(rc.ok) { return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: rc.error_code, error_inst: inst.id }; }
        return SpecInstListWalk { ..st, rest: rest, acc: VmInstructionList.VICons { head: rc.inst, tail: st.acc }, count: st.count + 1, ok: true, error_code: 0, error_inst: 0 };
    }
    if inst.kind == 15 {
        return lower_vm_loop_index_init(st, inst, rest, res_ty);
    }
    if inst.kind == 14 {
        return lower_vm_loop_index_advance(st, inst, rest, res_ty);
    }
    if inst.kind == 13 {
        return lower_vm_loop_guard<P, N>(pages, stride, total, nat_env, st, inst, rest, res_ty);
    }
    let call_nats: CallNatArgsResult = select_call_nat_args<P, N>(pages, stride, total, inst, nat_env);
    if !(call_nats.ok) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: call_nats.error_code, error_inst: inst.id };
    }
    let lowered: InstLowerResult = lower_vm_common_instruction(st.val_types, inst, res_ty, call_nats.nat_args);
    if !(lowered.ok) {
        return SpecInstListWalk { ..st, rest: rest, ok: false, error_code: lowered.error_code, error_inst: inst.id };
    }
    return SpecInstListWalk { ..st, rest: rest, acc: VmInstructionList.VICons { head: lowered.inst, tail: st.acc }, count: st.count + 1, ok: true, error_code: 0, error_inst: 0 };
}
fn select_call_nat_args<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, inst: ssa.Instruction, nat_env: NatEnv) -> (result: CallNatArgsResult) {
    if inst.kind != 3 { return CallNatArgsResult { ok: true, error_code: 0, nat_args: VmNatArgList.NANil }; }
    return parse_call_nat_args<P, N>(pages, stride, total, inst.start, inst.end, nat_env);
}

record SpecBlockListWalk {
    rest: ssa.SsaBlockList,
    val_types: VmValueList,
    acc: VmBlockList,
    block_count: u64,
    inst_count: u64,
    next_val_id: u64,
    next_inst_id: u64,
    next_blk_id: u64,
    ok: bool,
    error_code: u64,
    error_block: u64,
    error_inst: u64
}
fn lower_spec_blocks<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, nat_env: NatEnv, schemas: VmSchemas, seq_vals: VmValueList, val_types: VmValueList, next_val_id: u64, next_inst_id: u64, next_blk_id: u64) -> (result: SpecBlockListWalk) {
    let initial: SpecBlockListWalk = SpecBlockListWalk {
        rest: func.blocks, val_types: val_types, acc: VmBlockList.VBNil,
        block_count: 0, inst_count: 0, next_val_id: next_val_id, next_inst_id: next_inst_id, next_blk_id: next_blk_id,
        ok: true, error_code: 0, error_block: 0, error_inst: 0
    };
    iterate i up_to 1024 carrying st: SpecBlockListWalk = initial {
        if !(st.ok) || ssa_block_list_empty(st.rest) {
            return SpecBlockListWalk { ..st, acc: reverse_vm_blocks(st.acc) };
        }
        next st = lower_spec_block_step<P, N>(pages, stride, total, func, fn_decl, nat_env, schemas, seq_vals, st);
    }
    return SpecBlockListWalk { ..st, acc: reverse_vm_blocks(st.acc), ok: st.ok && ssa_block_list_empty(st.rest), error_code: select(st.ok && !(ssa_block_list_empty(st.rest)), 2, st.error_code) };
}
fn lower_spec_block_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, nat_env: NatEnv, schemas: VmSchemas, seq_vals: VmValueList, st: SpecBlockListWalk) -> (result: SpecBlockListWalk) {
    return match st.rest {
        ssa.SsaBlockList.LNil => st,
        ssa.SsaBlockList.LCons { head: blk, tail: rest } => lower_spec_block_one<P, N>(pages, stride, total, func, fn_decl, nat_env, schemas, seq_vals, st, blk, rest)
    };
}
fn lower_spec_block_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, nat_env: NatEnv, schemas: VmSchemas, seq_vals: VmValueList, st: SpecBlockListWalk, blk: ssa.SsaBlock, rest: ssa.SsaBlockList) -> (result: SpecBlockListWalk) {
    if !(blk.lowering_ok) {
        return SpecBlockListWalk { ..st, rest: rest, ok: false, error_code: 2, error_block: blk.id, error_inst: 0 };
    }
    let params: SpecBlkParamsWalk = lower_spec_block_params<P, N>(pages, stride, total, blk, func, fn_decl, nat_env, schemas, seq_vals);
    if !(params.ok) {
        return SpecBlockListWalk { ..st, rest: rest, ok: false, error_code: params.error_code, error_block: blk.id, error_inst: 0 };
    }
    let insts: SpecInstListWalk = lower_spec_instructions<P, N>(pages, stride, total, func, nat_env, schemas, st.val_types, blk.instructions, st.next_val_id, st.next_inst_id);
    if !(insts.ok) {
        return SpecBlockListWalk { ..st, rest: rest, ok: false, error_code: insts.error_code, error_block: blk.id, error_inst: insts.error_inst };
    }
    return lower_spec_block_term<P, N>(pages, stride, total, func, schemas, st, blk, rest, params.acc, insts);
}
fn lower_spec_block_term<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, schemas: VmSchemas, st: SpecBlockListWalk, blk: ssa.SsaBlock, rest: ssa.SsaBlockList, params: VmValueList, insts: SpecInstListWalk) -> (result: SpecBlockListWalk) {
    return match blk.terminator {
        ssa.Terminator.ScalarSwitch { subject: subj, subject_ty: subj_ty, result_type: res_ty, source_start: ss, source_end: se, arm_count: ac, default_target: dt, join_target: jt, cases: cs } => lower_spec_scalar_switch_finish<P, N>(pages, stride, total, func, schemas, st, blk, rest, params, insts, subj, subj_ty, res_ty, ac, dt, jt, cs),
        ssa.Terminator.Return { value: v } => lower_spec_plain_term(st, blk, rest, params, insts),
        ssa.Terminator.Jump { target: tgt, arguments: args } => lower_spec_plain_term(st, blk, rest, params, insts),
        ssa.Terminator.Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => lower_spec_plain_term(st, blk, rest, params, insts),
        ssa.Terminator.Fail => lower_spec_plain_term(st, blk, rest, params, insts),
        ssa.Terminator.FiniteSwitch { subject: s, subject_ty: sty, nominal_identity: ni, result_type: rt, source_start: ss, source_end: se, arm_count: ac, join_target: jt, cases: cs } => lower_spec_finite_switch_finish<P, N>(pages, stride, total, func, schemas, st, blk, rest, params, insts, s, ni, rt, ac, jt, cs)
    };
}
fn lower_spec_finite_switch_finish<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, schemas: VmSchemas, st: SpecBlockListWalk, blk: ssa.SsaBlock, rest: ssa.SsaBlockList, params: VmValueList, insts: SpecInstListWalk, subject: u64, nominal_identity: decl.SemanticIdentity, res_ty: decl.SemType, arm_count: u64, join_target: u64, cases: ssa.FiniteMatchCaseList) -> (result: SpecBlockListWalk) {
    let res_is_seq: bool = is_seq_sem_type(res_ty);
    let res_vm: VmType = resolve_sem_type_non_seq<P, N>(pages, stride, total, res_ty, func.nominals, schemas);
    let sw: ScalarSwitchLowerResult = lower_finite_switch_block<P, N>(
        pages, stride, total,
        func.blocks, schemas.finites, blk.id, params, insts.acc, insts.count,
        blk.has_failure_target, blk.failure_target,
        insts.val_types, st.acc, st.block_count, st.inst_count,
        insts.next_val_id, insts.next_inst_id, st.next_blk_id,
        subject, nominal_identity, res_vm, res_is_seq, arm_count, join_target, cases
    );
    if !(sw.ok) {
        return SpecBlockListWalk { ..st, rest: rest, ok: false, error_code: sw.error_code, error_block: blk.id, error_inst: 0 };
    }
    return SpecBlockListWalk {
        rest: rest, val_types: sw.val_types, acc: sw.acc,
        block_count: sw.block_count, inst_count: sw.inst_count,
        next_val_id: sw.next_val_id, next_inst_id: sw.next_inst_id, next_blk_id: sw.next_blk_id,
        ok: true, error_code: 0, error_block: 0, error_inst: 0
    };
}
fn lower_spec_scalar_switch_finish<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, schemas: VmSchemas, st: SpecBlockListWalk, blk: ssa.SsaBlock, rest: ssa.SsaBlockList, params: VmValueList, insts: SpecInstListWalk, subject: u64, subject_ty: decl.SemType, res_ty: decl.SemType, arm_count: u64, default_target: u64, join_target: u64, cases: ssa.ScalarMatchCaseList) -> (result: SpecBlockListWalk) {
    let res_is_seq: bool = is_seq_sem_type(res_ty);
    let res_vm: VmType = resolve_sem_type_non_seq<P, N>(pages, stride, total, res_ty, func.nominals, schemas);
    let sw: ScalarSwitchLowerResult = lower_scalar_switch_block(
        func.blocks, blk.id, params, insts.acc, insts.count,
        blk.has_failure_target, blk.failure_target,
        insts.val_types, st.acc, st.block_count, st.inst_count,
        insts.next_val_id, insts.next_inst_id, st.next_blk_id,
        subject, subject_ty, res_vm, res_is_seq, arm_count, default_target, join_target, cases
    );
    if !(sw.ok) {
        return SpecBlockListWalk { ..st, rest: rest, ok: false, error_code: sw.error_code, error_block: blk.id, error_inst: 0 };
    }
    return SpecBlockListWalk {
        rest: rest, val_types: sw.val_types, acc: sw.acc,
        block_count: sw.block_count, inst_count: sw.inst_count,
        next_val_id: sw.next_val_id, next_inst_id: sw.next_inst_id, next_blk_id: sw.next_blk_id,
        ok: true, error_code: 0, error_block: 0, error_inst: 0
    };
}
fn lower_spec_plain_term(st: SpecBlockListWalk, blk: ssa.SsaBlock, rest: ssa.SsaBlockList, params: VmValueList, insts: SpecInstListWalk) -> (result: SpecBlockListWalk) {
    let term: TermLowerResult = lower_vm_terminator(blk.terminator);
    if !(term.ok) {
        return SpecBlockListWalk { ..st, rest: rest, ok: false, error_code: term.error_code, error_block: blk.id, error_inst: 0 };
    }
    let vm_blk: VmBlock = VmBlock {
        id: blk.id, is_error_path: term.is_error_path,
        parameters: params, instructions: insts.acc, terminator: term.term,
        has_failure_target: blk.has_failure_target, failure_target: blk.failure_target
    };
    return SpecBlockListWalk {
        rest: rest, val_types: insts.val_types,
        acc: VmBlockList.VBCons { head: vm_blk, tail: st.acc },
        block_count: st.block_count + 1, inst_count: st.inst_count + insts.count,
        next_val_id: insts.next_val_id, next_inst_id: insts.next_inst_id, next_blk_id: st.next_blk_id,
        ok: true, error_code: 0, error_block: 0, error_inst: 0
    };
}

// Verify every CFG Branch/CondBranch argument and Return value inside a lowered VmFunction.
record VmBlkLookup { found: bool, blk: VmBlock }
fn dummy_vm_block() -> (result: VmBlock) {
    return VmBlock { id: 0, is_error_path: false, parameters: VmValueList.VVNil, instructions: VmInstructionList.VINil, terminator: VmTerminator.VmFailure, has_failure_target: false, failure_target: 0 };
}
fn vm_blk_head_id_eq(blocks: VmBlockList, target: u64) -> (result: bool) {
    return match blocks { VBNil => false, VBCons { head: b, tail: t } => b.id == target };
}
fn vm_blk_head(blocks: VmBlockList) -> (result: VmBlock) {
    return match blocks { VBNil => dummy_vm_block(), VBCons { head: b, tail: t } => b };
}
fn vm_blk_tail(blocks: VmBlockList) -> (result: VmBlockList) {
    return match blocks { VBNil => VmBlockList.VBNil, VBCons { head: b, tail: t } => t };
}
fn find_vm_block_by_id(blocks: VmBlockList, target: u64) -> (result: VmBlkLookup) {
    iterate i up_to 1024 carrying rest: VmBlockList = blocks {
        if vm_block_list_empty(rest) { return VmBlkLookup { found: false, blk: dummy_vm_block() }; }
        if vm_blk_head_id_eq(rest, target) { return VmBlkLookup { found: true, blk: vm_blk_head(rest) }; }
        next rest = vm_blk_tail(rest);
    }
    return VmBlkLookup { found: false, blk: dummy_vm_block() };
}

record VmBlkFilterWalk { rest: VmBlockList, skip_id: u64, acc: VmBlockList }
fn remove_vm_block_by_id(blocks: VmBlockList, skip_id: u64) -> (result: VmBlockList) {
    let initial: VmBlkFilterWalk = VmBlkFilterWalk { rest: blocks, skip_id: skip_id, acc: VmBlockList.VBNil };
    iterate i up_to 1024 carrying st: VmBlkFilterWalk = initial {
        if vm_block_list_empty(st.rest) { return reverse_vm_blocks(st.acc); }
        next st = remove_vm_block_step(st);
    }
    return reverse_vm_blocks(st.acc);
}
fn remove_vm_block_step(st: VmBlkFilterWalk) -> (result: VmBlkFilterWalk) {
    return match st.rest {
        VBNil => st,
        VBCons { head: blk, tail: rest } => remove_vm_block_one(st, blk, rest)
    };
}
fn remove_vm_block_one(st: VmBlkFilterWalk, blk: VmBlock, rest: VmBlockList) -> (result: VmBlkFilterWalk) {
    if blk.id == st.skip_id { return VmBlkFilterWalk { rest: rest, skip_id: st.skip_id, acc: st.acc }; }
    return VmBlkFilterWalk { rest: rest, skip_id: st.skip_id, acc: VmBlockList.VBCons { head: blk, tail: st.acc } };
}
record EntryOrderResult { ok: bool, blocks: VmBlockList }
fn place_entry_block_first(blocks: VmBlockList) -> (result: EntryOrderResult) {
    let entry: VmBlkLookup = find_vm_block_by_id(blocks, 0);
    if !(entry.found) || !(vm_value_list_empty(entry.blk.parameters)) {
        return EntryOrderResult { ok: false, blocks: blocks };
    }
    return EntryOrderResult { ok: true, blocks: VmBlockList.VBCons { head: entry.blk, tail: remove_vm_block_by_id(blocks, 0) } };
}

record EdgeTypesWalk { val_types: VmValueList, args: ssa.IdList, params: VmValueList, ok: bool, done: bool }
fn verify_edge_arg_types(val_types: VmValueList, args: ssa.IdList, params: VmValueList) -> (result: bool) {
    let initial: EdgeTypesWalk = EdgeTypesWalk { val_types: val_types, args: args, params: params, ok: true, done: false };
    iterate i up_to 1024 carrying st: EdgeTypesWalk = initial {
        if st.done || !(st.ok) { return st.ok && st.done; }
        next st = verify_edge_arg_step(st);
    }
    return st.ok && st.done;
}
fn verify_edge_arg_step(st: EdgeTypesWalk) -> (result: EdgeTypesWalk) {
    return match st.args {
        ssa.IdList.INil => EdgeTypesWalk { ..st, ok: vm_value_list_empty(st.params), done: true },
        ssa.IdList.ICons { head: aid, tail: arest } => verify_edge_arg_pair(st, aid.value, arest)
    };
}
fn verify_edge_arg_pair(st: EdgeTypesWalk, aid: u64, arest: ssa.IdList) -> (result: EdgeTypesWalk) {
    return match st.params {
        VVNil => EdgeTypesWalk { ..st, ok: false, done: true },
        VVCons { head: param, tail: prest } => verify_edge_arg_one(st, aid, arest, param, prest)
    };
}
fn verify_edge_arg_one(st: EdgeTypesWalk, aid: u64, arest: ssa.IdList, param: VmValue, prest: VmValueList) -> (result: EdgeTypesWalk) {
    let lk: VmValTypeLookup = lookup_vm_value_type(st.val_types, aid);
    if !(lk.found) || !(vm_type_equal(lk.ty, param.ty)) {
        return EdgeTypesWalk { ..st, ok: false, done: true };
    }
    return EdgeTypesWalk { val_types: st.val_types, args: arest, params: prest, ok: true, done: false };
}

fn verify_cfg_target_edge(blocks: VmBlockList, val_types: VmValueList, target: u64, args: ssa.IdList) -> (result: bool) {
    let blk_lk: VmBlkLookup = find_vm_block_by_id(blocks, target);
    if !(blk_lk.found) { return false; }
    return verify_edge_arg_types(val_types, args, blk_lk.blk.parameters);
}
fn verify_one_vm_terminator(fn_item: VmFunction, val_types: VmValueList, term: VmTerminator) -> (result: bool) {
    return match term {
        VmReturn { value: v } => verify_vm_return_type(val_types, v, fn_item.result_type),
        VmBranch { target: tgt, arguments: args } => verify_cfg_target_edge(fn_item.blocks, val_types, tgt, args),
        VmCondBranch { condition: cond, then_target: tt, then_arguments: ta, else_target: et, else_arguments: ea } => verify_vm_cond_branch(fn_item.blocks, val_types, cond, tt, ta, et, ea),
        VmFailure => true
    };
}
fn verify_vm_return_type(val_types: VmValueList, v: u64, expected: VmType) -> (result: bool) {
    let lk: VmValTypeLookup = lookup_vm_value_type(val_types, v);
    return lk.found && vm_type_equal(lk.ty, expected);
}
fn verify_vm_cond_branch(blocks: VmBlockList, val_types: VmValueList, cond: u64, tt: u64, ta: ssa.IdList, et: u64, ea: ssa.IdList) -> (result: bool) {
    let clk: VmValTypeLookup = lookup_vm_value_type(val_types, cond);
    if !(clk.found) || clk.ty.kind != 1 { return false; }
    return verify_cfg_target_edge(blocks, val_types, tt, ta) && verify_cfg_target_edge(blocks, val_types, et, ea);
}

record CfgVerifyWalk { rest: VmBlockList, ok: bool, error_block: u64 }
fn verify_vm_fn_cfg_types(fn_item: VmFunction, val_types: VmValueList) -> (result: CfgVerifyWalk) {
    let initial: CfgVerifyWalk = CfgVerifyWalk { rest: fn_item.blocks, ok: true, error_block: 0 };
    iterate i up_to 1024 carrying st: CfgVerifyWalk = initial {
        if !(st.ok) || vm_block_list_empty(st.rest) { return st; }
        next st = verify_vm_fn_cfg_step(fn_item, val_types, st);
    }
    return st;
}
fn verify_vm_fn_cfg_step(fn_item: VmFunction, val_types: VmValueList, st: CfgVerifyWalk) -> (result: CfgVerifyWalk) {
    return match st.rest {
        VBNil => st,
        VBCons { head: blk, tail: rest } => verify_vm_fn_cfg_one(fn_item, val_types, st, blk, rest)
    };
}
fn verify_vm_fn_cfg_one(fn_item: VmFunction, val_types: VmValueList, st: CfgVerifyWalk, blk: VmBlock, rest: VmBlockList) -> (result: CfgVerifyWalk) {
    if !(verify_one_vm_terminator(fn_item, val_types, blk.terminator)) {
        return CfgVerifyWalk { rest: VmBlockList.VBNil, ok: false, error_block: blk.id };
    }
    return CfgVerifyWalk { rest: rest, ok: true, error_block: 0 };
}

// Collect bounded-iteration region metadata from verified SSA loop blocks.
record BlockHasKindWalk { found: bool, inst: ssa.Instruction }
fn dummy_ssa_inst() -> (result: ssa.Instruction) {
    return ssa.Instruction {
        id: 0, sequence: 0, kind: 0, operator: 0, result: 0, ty: decl.SemType.TPoison,
        inputs: ssa.IdList.INil, argc: 0, params: decl.BindList.BNil,
        identity: decl.invalid_semantic_identity(), nominal_identity: decl.invalid_semantic_identity(),
        variant_start: 0, variant_end: 0, binding_start: 0, binding_end: 0,
        effects: decl.EffectIdentityList.EINil, capabilities: decl.CapabilityIdentityList.CINil, start: 0, end: 0
    };
}
fn ssa_inst_head_kind_eq(insts: ssa.InstructionList, kind: u64) -> (result: bool) {
    return match insts { ssa.InstructionList.QNil => false, ssa.InstructionList.QCons { head: inst, tail: t } => inst.kind == kind };
}
fn ssa_inst_head(insts: ssa.InstructionList) -> (result: ssa.Instruction) {
    return match insts { ssa.InstructionList.QNil => dummy_ssa_inst(), ssa.InstructionList.QCons { head: inst, tail: t } => inst };
}
fn ssa_inst_tail(insts: ssa.InstructionList) -> (result: ssa.InstructionList) {
    return match insts { ssa.InstructionList.QNil => ssa.InstructionList.QNil, ssa.InstructionList.QCons { head: inst, tail: t } => t };
}
fn find_inst_of_kind_in_list(insts: ssa.InstructionList, kind: u64) -> (result: BlockHasKindWalk) {
    iterate i up_to 1024 carrying rest: ssa.InstructionList = insts {
        if ssa_inst_list_empty(rest) { return BlockHasKindWalk { found: false, inst: dummy_ssa_inst() }; }
        if ssa_inst_head_kind_eq(rest, kind) { return BlockHasKindWalk { found: true, inst: ssa_inst_head(rest) }; }
        next rest = ssa_inst_tail(rest);
    }
    return BlockHasKindWalk { found: false, inst: dummy_ssa_inst() };
}

record JumpMatchLookup { found: bool, block_id: u64 }
record JumpMatchWalk { rest: ssa.SsaBlockList, target: u64, inst_kind: u64, found: bool, block_id: u64 }
fn find_jump_predecessor_with_inst(blocks: ssa.SsaBlockList, target: u64, inst_kind: u64) -> (result: JumpMatchLookup) {
    let init: JumpMatchWalk = JumpMatchWalk { rest: blocks, target: target, inst_kind: inst_kind, found: false, block_id: 0 };
    iterate i up_to 1024 carrying w: JumpMatchWalk = init {
        if w.found || ssa_block_list_empty(w.rest) { return JumpMatchLookup { found: w.found, block_id: w.block_id }; }
        next w = find_jump_pred_step(w);
    }
    return JumpMatchLookup { found: w.found, block_id: w.block_id };
}
fn find_jump_pred_step(w: JumpMatchWalk) -> (result: JumpMatchWalk) {
    return match w.rest {
        ssa.SsaBlockList.LNil => w,
        ssa.SsaBlockList.LCons { head: blk, tail: rest } => find_jump_pred_one(w, blk, rest)
    };
}
fn find_jump_pred_one(w: JumpMatchWalk, blk: ssa.SsaBlock, rest: ssa.SsaBlockList) -> (result: JumpMatchWalk) {
    let jumps_to_target: bool = match blk.terminator {
        ssa.Terminator.Jump { target: tgt, arguments: args } => tgt == w.target,
        ssa.Terminator.Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => false,
        ssa.Terminator.Return { value: v } => false,
        ssa.Terminator.Fail => false,
        ssa.Terminator.FiniteSwitch { subject: s, subject_ty: st, nominal_identity: ni, result_type: rt, source_start: ss, source_end: se, arm_count: ac, join_target: jt, cases: cs } => false,
        ssa.Terminator.ScalarSwitch { subject: s, subject_ty: st, result_type: rt, source_start: ss, source_end: se, arm_count: ac, default_target: dt, join_target: jt, cases: cs } => false
    };
    if jumps_to_target && find_inst_of_kind_in_list(blk.instructions, w.inst_kind).found {
        return JumpMatchWalk { rest: ssa.SsaBlockList.LNil, target: w.target, inst_kind: w.inst_kind, found: true, block_id: blk.id };
    }
    return JumpMatchWalk { ..w, rest: rest };
}

record BodyReachState { blocks: ssa.SsaBlockList, header_id: u64, exit_id: u64, acc: ssa.IdList, changed: bool }
fn maybe_add_body_block(st: BodyReachState, target: u64) -> (result: BodyReachState) {
    if target == st.header_id || target == st.exit_id || id_in_list(st.acc, target) { return st; }
    if !(find_ssa_block_by_id(st.blocks, target).found) { return st; }
    return BodyReachState { ..st, acc: ssa.IdList.ICons { head: ssa.Id { value: target }, tail: st.acc }, changed: true };
}
fn expand_body_term(st: BodyReachState, term: ssa.Terminator) -> (result: BodyReachState) {
    return match term {
        ssa.Terminator.Jump { target: tgt, arguments: args } => maybe_add_body_block(st, tgt),
        ssa.Terminator.Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => maybe_add_body_block(maybe_add_body_block(st, y), n),
        ssa.Terminator.Return { value: v } => st,
        ssa.Terminator.Fail => st,
        ssa.Terminator.FiniteSwitch { subject: s, subject_ty: sty, nominal_identity: ni, result_type: rt, source_start: ss, source_end: se, arm_count: ac, join_target: jt, cases: cs } => expand_body_finite_switch_cases(maybe_add_body_block(st, jt), cs),
        ssa.Terminator.ScalarSwitch { subject: s, subject_ty: sty, result_type: rt, source_start: ss, source_end: se, arm_count: ac, default_target: dt, join_target: jt, cases: cs } => expand_body_scalar_switch_cases(maybe_add_body_block(st, jt), cs)
    };
}
record BodyFiniteCasesWalk { state: BodyReachState, rest: ssa.FiniteMatchCaseList }
fn expand_body_finite_switch_cases(st: BodyReachState, cases: ssa.FiniteMatchCaseList) -> (result: BodyReachState) {
    let init: BodyFiniteCasesWalk = BodyFiniteCasesWalk { state: st, rest: cases };
    iterate i up_to 256 carrying w: BodyFiniteCasesWalk = init {
        if finite_cases_empty(w.rest) { return w.state; }
        next w = expand_body_finite_case_step(w);
    }
    return w.state;
}
fn expand_body_finite_case_step(w: BodyFiniteCasesWalk) -> (result: BodyFiniteCasesWalk) {
    return match w.rest {
        ssa.FiniteMatchCaseList.MCNil => w,
        ssa.FiniteMatchCaseList.MCCons { head: cs, tail: rest } => BodyFiniteCasesWalk { state: maybe_add_body_block(w.state, cs.target), rest: rest }
    };
}
record BodyScalarCasesWalk { state: BodyReachState, rest: ssa.ScalarMatchCaseList }
fn expand_body_scalar_switch_cases(st: BodyReachState, cases: ssa.ScalarMatchCaseList) -> (result: BodyReachState) {
    let init: BodyScalarCasesWalk = BodyScalarCasesWalk { state: st, rest: cases };
    iterate i up_to 1024 carrying w: BodyScalarCasesWalk = init {
        if scalar_cases_empty(w.rest) { return w.state; }
        next w = expand_body_scalar_case_step(w);
    }
    return w.state;
}
fn expand_body_scalar_case_step(w: BodyScalarCasesWalk) -> (result: BodyScalarCasesWalk) {
    return match w.rest {
        ssa.ScalarMatchCaseList.SCNil => w,
        ssa.ScalarMatchCaseList.SCCons { head: cs, tail: rest } => BodyScalarCasesWalk { state: maybe_add_body_block(w.state, cs.target), rest: rest }
    };
}
record BodyScanWalk { state: BodyReachState, rest: ssa.SsaBlockList }
fn collect_body_blocks_pass(st: BodyReachState) -> (result: BodyReachState) {
    let init: BodyScanWalk = BodyScanWalk { state: BodyReachState { ..st, changed: false }, rest: st.blocks };
    iterate i up_to 1024 carrying w: BodyScanWalk = init {
        if ssa_block_list_empty(w.rest) { return w.state; }
        next w = collect_body_blocks_step(w);
    }
    return w.state;
}
fn collect_body_blocks_step(w: BodyScanWalk) -> (result: BodyScanWalk) {
    return match w.rest {
        ssa.SsaBlockList.LNil => w,
        ssa.SsaBlockList.LCons { head: blk, tail: rest } => collect_body_blocks_one(w.state, blk, rest)
    };
}
fn collect_body_blocks_one(st: BodyReachState, blk: ssa.SsaBlock, rest: ssa.SsaBlockList) -> (result: BodyScanWalk) {
    if id_in_list(st.acc, blk.id) {
        return BodyScanWalk { state: expand_body_term(st, blk.terminator), rest: rest };
    }
    return BodyScanWalk { state: st, rest: rest };
}
fn collect_loop_body_blocks(blocks: ssa.SsaBlockList, header_id: u64, body_entry: u64, exit_id: u64) -> (result: ssa.IdList) {
    if body_entry == header_id || body_entry == exit_id || !(find_ssa_block_by_id(blocks, body_entry).found) {
        return ssa.IdList.INil;
    }
    let init: BodyReachState = BodyReachState {
        blocks: blocks, header_id: header_id, exit_id: exit_id,
        acc: ssa.IdList.ICons { head: ssa.Id { value: body_entry }, tail: ssa.IdList.INil },
        changed: true
    };
    iterate pass up_to 128 carrying st: BodyReachState = init {
        if !(st.changed) { return reverse_ssa_ids(st.acc); }
        next st = collect_body_blocks_pass(st);
    }
    return reverse_ssa_ids(st.acc);
}

record LoopStatePickWalk { rest: ssa.ValueList, val_types: VmValueList, index_id: u64, found_bool: bool, bool_ty: VmType, found_scalar: bool, scalar_ty: VmType }
fn pick_loop_state_type(params: ssa.ValueList, val_types: VmValueList, index_id: u64) -> (result: VmType) {
    let init: LoopStatePickWalk = LoopStatePickWalk { rest: params, val_types: val_types, index_id: index_id, found_bool: false, bool_ty: invalid_vm_type(), found_scalar: false, scalar_ty: invalid_vm_type() };
    iterate i up_to 128 carrying w: LoopStatePickWalk = init {
        if w.found_bool || ssa_value_list_empty(w.rest) {
            if w.found_bool { return w.bool_ty; }
            if w.found_scalar { return w.scalar_ty; }
            return bool_vm_type();
        }
        next w = pick_loop_state_step(w);
    }
    if w.found_bool { return w.bool_ty; }
    if w.found_scalar { return w.scalar_ty; }
    return bool_vm_type();
}
fn pick_loop_state_step(w: LoopStatePickWalk) -> (result: LoopStatePickWalk) {
    return match w.rest {
        ssa.ValueList.VNil => w,
        ssa.ValueList.VCons { head: v, tail: rest } => pick_loop_state_one(w, v, rest)
    };
}
fn pick_loop_state_one(w: LoopStatePickWalk, v: ssa.Value, rest: ssa.ValueList) -> (result: LoopStatePickWalk) {
    if v.id == w.index_id { return LoopStatePickWalk { ..w, rest: rest }; }
    let lk: VmValTypeLookup = lookup_vm_value_type(w.val_types, v.id);
    if !(lk.found) || !(lk.ty.valid) || is_seq_vm_type(lk.ty) { return LoopStatePickWalk { ..w, rest: rest }; }
    if lk.ty.kind == 1 {
        return LoopStatePickWalk { ..w, rest: ssa.ValueList.VNil, found_bool: true, bool_ty: lk.ty };
    }
    if !(w.found_scalar) {
        return LoopStatePickWalk { ..w, rest: rest, found_scalar: true, scalar_ty: lk.ty };
    }
    return LoopStatePickWalk { ..w, rest: rest };
}

record GuardBranchTargets { ok: bool, body_entry: u64, exit_block: u64 }
fn guard_branch_targets(term: ssa.Terminator, cond_id: u64) -> (result: GuardBranchTargets) {
    return match term {
        ssa.Terminator.Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => GuardBranchTargets { ok: c == cond_id, body_entry: y, exit_block: n },
        ssa.Terminator.Jump { target: t, arguments: a } => GuardBranchTargets { ok: false, body_entry: 0, exit_block: 0 },
        ssa.Terminator.Return { value: v } => GuardBranchTargets { ok: false, body_entry: 0, exit_block: 0 },
        ssa.Terminator.Fail => GuardBranchTargets { ok: false, body_entry: 0, exit_block: 0 },
        ssa.Terminator.FiniteSwitch { subject: s, subject_ty: sty, nominal_identity: ni, result_type: rt, source_start: ss, source_end: se, arm_count: ac, join_target: jt, cases: cs } => GuardBranchTargets { ok: false, body_entry: 0, exit_block: 0 },
        ssa.Terminator.ScalarSwitch { subject: s, subject_ty: sty, result_type: rt, source_start: ss, source_end: se, arm_count: ac, default_target: dt, join_target: jt, cases: cs } => GuardBranchTargets { ok: false, body_entry: 0, exit_block: 0 }
    };
}

record BoundedItersCollect { rest: ssa.SsaBlockList, acc: VmBoundedIterationList, ok: bool, error_code: u64, error_block: u64, error_inst: u64 }
fn collect_vm_bounded_iterations<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, nat_env: NatEnv, val_types: VmValueList) -> (result: BoundedItersCollect) {
    let init: BoundedItersCollect = BoundedItersCollect { rest: func.blocks, acc: VmBoundedIterationList.VBINil, ok: true, error_code: 0, error_block: 0, error_inst: 0 };
    iterate i up_to 1024 carrying w: BoundedItersCollect = init {
        if !(w.ok) || ssa_block_list_empty(w.rest) {
            return BoundedItersCollect { ..w, acc: reverse_vm_bounded_iters(w.acc) };
        }
        next w = collect_bounded_iter_step<P, N>(pages, stride, total, func.blocks, nat_env, val_types, w);
    }
    return BoundedItersCollect { ..w, acc: reverse_vm_bounded_iters(w.acc) };
}
fn collect_bounded_iter_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, all_blocks: ssa.SsaBlockList, nat_env: NatEnv, val_types: VmValueList, w: BoundedItersCollect) -> (result: BoundedItersCollect) {
    return match w.rest {
        ssa.SsaBlockList.LNil => w,
        ssa.SsaBlockList.LCons { head: blk, tail: rest } => collect_bounded_iter_block<P, N>(pages, stride, total, all_blocks, nat_env, val_types, w, blk, rest)
    };
}
fn collect_bounded_iter_block<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, all_blocks: ssa.SsaBlockList, nat_env: NatEnv, val_types: VmValueList, w: BoundedItersCollect, blk: ssa.SsaBlock, rest: ssa.SsaBlockList) -> (result: BoundedItersCollect) {
    let glk: BlockHasKindWalk = find_inst_of_kind_in_list(blk.instructions, 13);
    if !(glk.found) { return BoundedItersCollect { ..w, rest: rest }; }
    let tgts: GuardBranchTargets = guard_branch_targets(blk.terminator, glk.inst.result);
    if !(tgts.ok) {
        return BoundedItersCollect { ..w, rest: rest, ok: false, error_code: 6, error_block: blk.id, error_inst: glk.inst.id };
    }
    let pre: JumpMatchLookup = find_jump_predecessor_with_inst(all_blocks, blk.id, 15);
    if !(pre.found) {
        return BoundedItersCollect { ..w, rest: rest, ok: false, error_code: 6, error_block: blk.id, error_inst: glk.inst.id };
    }
    let back: JumpMatchLookup = find_jump_predecessor_with_inst(all_blocks, blk.id, 14);
    let back_blk: u64 = select(back.found, back.block_id, tgts.body_entry);
    let idx_id: u64 = match glk.inst.inputs { ssa.IdList.INil => 0, ssa.IdList.ICons { head: h, tail: t } => h.value };
    let state_ty: VmType = pick_loop_state_type(blk.parameters, val_types, idx_id);
    let body_blks: ssa.IdList = collect_loop_body_blocks(all_blocks, blk.id, tgts.body_entry, tgts.exit_block);
    if glk.inst.operator == 1 {
        let bound_res: NatBoundResult = resolve_nat_bound_span<P, N>(pages, stride, total, glk.inst.variant_start, glk.inst.variant_end, nat_env);
        if !(bound_res.ok) {
            return BoundedItersCollect { ..w, rest: rest, ok: false, error_code: bound_res.error_code, error_block: blk.id, error_inst: glk.inst.id };
        }
        let region: VmBoundedIteration = VmBoundedIteration {
            header_block: blk.id, preheader_block: pre.block_id,
            body_entry_block: tgts.body_entry, backedge_block: back_blk, exit_block: tgts.exit_block,
            domain_kind: 1, bound: bound_res.value, sequence_bound: invalid_vm_type(),
            state_type: state_ty, body_blocks: body_blks
        };
        return BoundedItersCollect { ..w, rest: rest, acc: VmBoundedIterationList.VBICons { head: region, tail: w.acc } };
    }
    if glk.inst.operator == 2 {
        return collect_bounded_seq_iter(w, blk, rest, glk.inst, pre.block_id, tgts, back_blk, state_ty, body_blks, val_types);
    }
    return BoundedItersCollect { ..w, rest: rest, ok: false, error_code: 5, error_block: blk.id, error_inst: glk.inst.id };
}
fn collect_bounded_seq_iter(w: BoundedItersCollect, blk: ssa.SsaBlock, rest: ssa.SsaBlockList, guard: ssa.Instruction, pre_id: u64, tgts: GuardBranchTargets, back_id: u64, state_ty: VmType, body_blks: ssa.IdList, val_types: VmValueList) -> (result: BoundedItersCollect) {
    let seq_id: u64 = match guard.inputs {
        ssa.IdList.INil => 0,
        ssa.IdList.ICons { head: h, tail: after } => match after { ssa.IdList.INil => 0, ssa.IdList.ICons { head: s, tail: t } => s.value }
    };
    let seq_lk: VmValTypeLookup = lookup_vm_value_type(val_types, seq_id);
    if !(seq_lk.found) || !(is_seq_vm_type(seq_lk.ty)) || seq_lk.ty.bound_value == 0 {
        return BoundedItersCollect { ..w, rest: rest, ok: false, error_code: 7, error_block: blk.id, error_inst: guard.id };
    }
    let region: VmBoundedIteration = VmBoundedIteration {
        header_block: blk.id, preheader_block: pre_id,
        body_entry_block: tgts.body_entry, backedge_block: back_id, exit_block: tgts.exit_block,
        domain_kind: 2, bound: seq_lk.ty.bound_value, sequence_bound: seq_lk.ty,
        state_type: state_ty, body_blocks: body_blks
    };
    return BoundedItersCollect { ..w, rest: rest, acc: VmBoundedIterationList.VBICons { head: region, tail: w.acc } };
}

// Failure-only diagnostic extraction helpers (never called on success path).
record SsaInstIdLookup { found: bool, inst: ssa.Instruction }
fn ssa_inst_head_id_eq(insts: ssa.InstructionList, wanted: u64) -> (result: bool) {
    return match insts { ssa.InstructionList.QNil => false, ssa.InstructionList.QCons { head: h, tail: t } => h.id == wanted };
}
fn find_ssa_inst_by_id(insts: ssa.InstructionList, wanted: u64) -> (result: SsaInstIdLookup) {
    iterate i up_to 1024 carrying rest: ssa.InstructionList = insts {
        if ssa_inst_list_empty(rest) { return SsaInstIdLookup { found: false, inst: dummy_ssa_inst() }; }
        if ssa_inst_head_id_eq(rest, wanted) { return SsaInstIdLookup { found: true, inst: ssa_inst_head(rest) }; }
        next rest = ssa_inst_tail(rest);
    }
    return SsaInstIdLookup { found: false, inst: dummy_ssa_inst() };
}
fn resolve_sem_type_nominal_id<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: decl.SemType, nominals: decl.NominalTypeIdentityList) -> (result: decl.SemanticIdentity) {
    return match ty {
        TNamed { start: s, end: e } => lookup_nominal_identity<P, N>(pages, stride, total, nominals, s, e).identity,
        TBool => decl.invalid_semantic_identity(),
        TByte => decl.invalid_semantic_identity(),
        TInt { width: w, signed: sg } => decl.invalid_semantic_identity(),
        TSeq => decl.invalid_semantic_identity(),
        TSeqExact { element: el, length: n, length_valid: v } => decl.invalid_semantic_identity(),
        TPoison => decl.invalid_semantic_identity()
    };
}
fn classify_sem_type_kind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: decl.SemType, nominals: decl.NominalTypeIdentityList, schemas: VmSchemas) -> (result: u64) {
    return match ty {
        TBool => 1,
        TByte => 2,
        TInt { width: w, signed: sg } => 3,
        TSeq => 4,
        TSeqExact { element: el, length: n, length_valid: v } => 4,
        TNamed { start: s, end: e } => classify_named_sem_type<P, N>(pages, stride, total, s, e, nominals, schemas),
        TPoison => 0
    };
}
fn classify_named_sem_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, nominals: decl.NominalTypeIdentityList, schemas: VmSchemas) -> (result: u64) {
    let lk: decl.NominalLookup = lookup_nominal_identity<P, N>(pages, stride, total, nominals, start, end);
    if !(lk.found) || !(lk.identity.valid) { return 0; }
    let rec_lk: RecordTypeLookup = find_vm_record_type(schemas.records, lk.identity);
    if rec_lk.found { return 5; }
    let fin_lk: FiniteTypeLookup = find_vm_finite_type(schemas.finites, lk.identity);
    if fin_lk.found || is_finite_nominal_identity(lk.identity) { return 7; }
    return 0;
}
fn terminator_failure_detail(callable: decl.SemanticIdentity, blk: ssa.SsaBlock, fn_decl: decl.FnDecl) -> (result: VmEmitFailureDetail) {
    return match blk.terminator {
        ssa.Terminator.Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => phase_failure_detail(callable, 9, 101, 0, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end),
        ssa.Terminator.Jump { target: t, arguments: a } => phase_failure_detail(callable, 9, 102, 0, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end),
        ssa.Terminator.Return { value: v } => phase_failure_detail(callable, 9, 103, 0, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end),
        ssa.Terminator.Fail => phase_failure_detail(callable, 9, 104, 0, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end),
        ssa.Terminator.FiniteSwitch { subject: s, subject_ty: sty, nominal_identity: ni, result_type: rt, source_start: ss, source_end: se, arm_count: ac, join_target: jt, cases: cs } => phase_failure_detail(callable, 9, 105, 8, 7, ni, ss, se),
        ssa.Terminator.ScalarSwitch { subject: s, subject_ty: sty, result_type: rt, source_start: ss, source_end: se, arm_count: ac, default_target: dt, join_target: jt, cases: cs } => phase_failure_detail(callable, 9, 106, 0, 0, decl.invalid_semantic_identity(), ss, se)
    };
}
fn find_first_unsupported_blk_param_detail<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, schemas: VmSchemas, blk: ssa.SsaBlock) -> (result: VmEmitFailureDetail) {
    iterate i up_to 256 carrying rest: ssa.ValueList = blk.parameters {
        if ssa_value_list_empty(rest) {
            return phase_failure_detail(func.identity, 7, 0, 8, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end);
        }
        let v: ssa.Value = ssa_value_head(rest);
        let non_seq: VmType = resolve_sem_type_non_seq<P, N>(pages, stride, total, v.ty, func.nominals, schemas);
        if !(non_seq.valid) && !(is_seq_sem_type(v.ty)) {
            let obs_nom: decl.SemanticIdentity = resolve_sem_type_nominal_id<P, N>(pages, stride, total, v.ty, func.nominals);
            let obs_kind: u64 = classify_sem_type_kind<P, N>(pages, stride, total, v.ty, func.nominals, schemas);
            return phase_failure_detail(func.identity, 7, 0, 8, obs_kind, obs_nom, fn_decl.sig.name_start, fn_decl.sig.name_end);
        }
        next rest = ssa_value_tail(rest);
    }
    return phase_failure_detail(func.identity, 7, 0, 8, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end);
}
fn ssa_value_head(vs: ssa.ValueList) -> (result: ssa.Value) {
    return match vs {
        ssa.ValueList.VNil => ssa.Value { id: 0, ty: decl.SemType.TPoison, owner_block: 0, kind: 0, index: 0 },
        ssa.ValueList.VCons { head: h, tail: t } => h
    };
}
fn ssa_value_tail(vs: ssa.ValueList) -> (result: ssa.ValueList) {
    return match vs { ssa.ValueList.VNil => ssa.ValueList.VNil, ssa.ValueList.VCons { head: h, tail: t } => t };
}
fn build_fn_failure_detail<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, schemas: VmSchemas, phase: u64, error_code: u64, error_block: u64, error_inst: u64) -> (result: VmEmitFailureDetail) {
    let exp_kind: u64 = select(error_code == 4, 8, 0);
    if phase == 5 {
        let obs_nom: decl.SemanticIdentity = resolve_sem_type_nominal_id<P, N>(pages, stride, total, func.result_type, func.nominals);
        let obs_kind: u64 = classify_sem_type_kind<P, N>(pages, stride, total, func.result_type, func.nominals, schemas);
        return phase_failure_detail(func.identity, 5, 0, exp_kind, obs_kind, obs_nom, fn_decl.sig.name_start, fn_decl.sig.name_end);
    }
    let blk_lk: SsaBlkLookup = find_ssa_block_by_id(func.blocks, error_block);
    if !(blk_lk.found) {
        return phase_failure_detail(func.identity, phase, 0, exp_kind, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end);
    }
    if phase == 7 {
        return find_first_unsupported_blk_param_detail<P, N>(pages, stride, total, func, fn_decl, schemas, blk_lk.blk);
    }
    if phase == 8 || phase == 6 {
        let inst_lk: SsaInstIdLookup = find_ssa_inst_by_id(blk_lk.blk.instructions, error_inst);
        if inst_lk.found {
            let inst: ssa.Instruction = inst_lk.inst;
            let obs_nom: decl.SemanticIdentity = select_identity(inst.nominal_identity.valid, inst.nominal_identity, resolve_sem_type_nominal_id<P, N>(pages, stride, total, inst.ty, func.nominals));
            let obs_kind: u64 = classify_sem_type_kind<P, N>(pages, stride, total, inst.ty, func.nominals, schemas);
            return phase_failure_detail(func.identity, phase, inst.kind, exp_kind, obs_kind, obs_nom, inst.start, inst.end);
        }
        if error_code == 6 {
            return terminator_failure_detail(func.identity, blk_lk.blk, fn_decl);
        }
    }
    return phase_failure_detail(func.identity, phase, 0, exp_kind, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end);
}

fn lower_ssa_fn_specialized<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, nat_args: VmNatArgList, all_recs: VmRecordTypeList) -> (result: SingleFnLowerResult) {
    return lower_ssa_fn_specialized_with_schemas<P, N>(pages, stride, total, func, fn_decl, nat_args, VmSchemas { records: all_recs, finites: VmFiniteTypeList.VFTNil });
}
fn lower_ssa_fn_specialized_with_schemas<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, func: ssa.Function, fn_decl: decl.FnDecl, nat_args: VmNatArgList, schemas: VmSchemas) -> (result: SingleFnLowerResult) {
    if !(func.supported) || !(func.verified) || !(func.identity.valid) || func.identity.len == 0 || func.block_count == 0 {
        return single_fn_fail(2, 0, 0, phase_failure_detail(func.identity, 2, 0, 0, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end));
    }
    let nat_built: NatEnvBuild = build_nat_env<P, N>(pages, stride, total, fn_decl.sig.generics, nat_args);
    if !(nat_built.ok) {
        return single_fn_fail(11, 0, 0, phase_failure_detail(func.identity, 4, 0, 0, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end));
    }
    let res_ty: SeqTypeParseResult = resolve_spec_result_type<P, N>(pages, stride, total, func, fn_decl, nat_built.env, schemas);
    if !(res_ty.ok) {
        return single_fn_fail(res_ty.error_code, 0, 0, build_fn_failure_detail<P, N>(pages, stride, total, func, fn_decl, schemas, 5, res_ty.error_code, 0, 0));
    }
    let inputs: SpecInputsWalk = lower_spec_inputs<P, N>(pages, stride, total, func, fn_decl, nat_built.env, schemas);
    if !(inputs.ok) {
        return single_fn_fail(inputs.error_code, 0, 0, phase_failure_detail(func.identity, 5, 0, select(inputs.error_code == 4, 8, 0), 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end));
    }
    let seq_prop: SeqPropState = propagate_spec_seq_types(func.blocks, inputs.acc);
    if !(seq_prop.ok) {
        return single_fn_fail(seq_prop.error_code, seq_prop.error_block, seq_prop.error_inst, build_fn_failure_detail<P, N>(pages, stride, total, func, fn_decl, schemas, 6, seq_prop.error_code, seq_prop.error_block, seq_prop.error_inst));
    }
    let non_seq_vals: VmValueList = add_non_seq_ssa_values<P, N>(pages, stride, total, func.values, func.nominals, schemas, inputs.acc);
    let base_val_types: VmValueList = append_unique_vm_values(seq_prop.seq_vals, non_seq_vals);
    let blk_val_types: CollectBlkParamTypesWalk = collect_all_spec_block_param_types<P, N>(pages, stride, total, func, fn_decl, nat_built.env, schemas, seq_prop.seq_vals, base_val_types);
    if !(blk_val_types.ok) {
        return single_fn_fail(blk_val_types.error_code, blk_val_types.error_block, 0, build_fn_failure_detail<P, N>(pages, stride, total, func, fn_decl, schemas, 7, blk_val_types.error_code, blk_val_types.error_block, 0));
    }
    let max_ids: FnMaxIds = max_fn_val_inst_ids(func);
    let blocks: SpecBlockListWalk = lower_spec_blocks<P, N>(pages, stride, total, func, fn_decl, nat_built.env, schemas, seq_prop.seq_vals, blk_val_types.acc, max_ids.next_val, max_ids.next_inst, max_ids.next_blk);
    if !(blocks.ok) {
        let bphase: u64 = select(blocks.error_code == 6, 9, 8);
        return single_fn_fail(blocks.error_code, blocks.error_block, blocks.error_inst, build_fn_failure_detail<P, N>(pages, stride, total, func, fn_decl, schemas, bphase, blocks.error_code, blocks.error_block, blocks.error_inst));
    }
    let iters: BoundedItersCollect = collect_vm_bounded_iterations<P, N>(pages, stride, total, func, nat_built.env, blocks.val_types);
    if !(iters.ok) {
        return single_fn_fail(iters.error_code, iters.error_block, iters.error_inst, build_fn_failure_detail<P, N>(pages, stride, total, func, fn_decl, schemas, 10, iters.error_code, iters.error_block, iters.error_inst));
    }
    let ordered: EntryOrderResult = place_entry_block_first(blocks.acc);
    if !(ordered.ok) {
        return single_fn_fail(7, 0, 0, phase_failure_detail(func.identity, 11, 0, 0, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end));
    }
    let vm_fn: VmFunction = VmFunction {
        identity: func.identity,
        nat_args: nat_args,
        inputs: inputs.acc,
        result_type: res_ty.ty,
        blocks: ordered.blocks,
        bounded_iterations: iters.acc,
        block_count: blocks.block_count,
        instruction_count: blocks.inst_count
    };
    let cfg_ok: CfgVerifyWalk = verify_vm_fn_cfg_types(vm_fn, blocks.val_types);
    if !(cfg_ok.ok) {
        return single_fn_fail(7, cfg_ok.error_block, 0, phase_failure_detail(func.identity, 11, 0, 0, 0, decl.invalid_semantic_identity(), fn_decl.sig.name_start, fn_decl.sig.name_end));
    }
    return SingleFnLowerResult { ok: true, error_code: 0, error_block: 0, error_inst: 0, error_detail: empty_failure_detail(), vm_fn: vm_fn };
}

// ---------------------------------------------------------------------------
// Whole-closure callable identity, specialization reachability, and call check
// ---------------------------------------------------------------------------

fn emit_failure_detailed(code: u64, fn_idx: u64, blk_id: u64, inst_id: u64, detail: VmEmitFailureDetail) -> (result: VmEmitResult) {
    return VmEmitResult {
        ok: false, error_code: code, error_function: fn_idx, error_block: blk_id, error_instruction: inst_id,
        error_detail: detail,
        module_name_start: 0, module_name_end: 0,
        record_types: VmRecordTypeList.VRTNil, record_type_count: 0,
        finite_types: VmFiniteTypeList.VFTNil, finite_type_count: 0,
        functions: VmFunctionList.VFNil, function_count: 0, block_count: 0, instruction_count: 0
    };
}
fn emit_failure(code: u64, fn_idx: u64, blk_id: u64, inst_id: u64) -> (result: VmEmitResult) {
    return emit_failure_detailed(code, fn_idx, blk_id, inst_id, empty_failure_detail());
}
fn dummy_vm_function() -> (result: VmFunction) {
    return VmFunction {
        identity: decl.invalid_semantic_identity(),
        nat_args: VmNatArgList.NANil,
        inputs: VmValueList.VVNil,
        result_type: invalid_vm_type(),
        blocks: VmBlockList.VBNil,
        bounded_iterations: VmBoundedIterationList.VBINil,
        block_count: 0,
        instruction_count: 0
    };
}

record VmFnLookup { found: bool, fn_item: VmFunction }
fn vm_fn_head_spec_eq(fns: VmFunctionList, wanted: VmSpecKey) -> (result: bool) {
    return match fns {
        VFNil => false,
        VFCons { head: fn_item, tail: t } => spec_keys_equal(VmSpecKey { identity: fn_item.identity, nat_args: fn_item.nat_args }, wanted)
    };
}
fn vm_fn_head(fns: VmFunctionList) -> (result: VmFunction) {
    return match fns { VFNil => dummy_vm_function(), VFCons { head: fn_item, tail: t } => fn_item };
}
fn vm_fn_tail(fns: VmFunctionList) -> (result: VmFunctionList) {
    return match fns { VFNil => VmFunctionList.VFNil, VFCons { head: fn_item, tail: t } => t };
}
fn find_vm_fn_by_spec(fns: VmFunctionList, wanted: VmSpecKey) -> (result: VmFnLookup) {
    iterate i up_to 1024 carrying rest: VmFunctionList = fns {
        if vm_fn_list_empty(rest) { return VmFnLookup { found: false, fn_item: dummy_vm_function() }; }
        if vm_fn_head_spec_eq(rest, wanted) { return VmFnLookup { found: true, fn_item: vm_fn_head(rest) }; }
        next rest = vm_fn_tail(rest);
    }
    return VmFnLookup { found: false, fn_item: dummy_vm_function() };
}

enum PendingSpecList { PSNil, PSCons { head: VmSpecKey, tail: PendingSpecList } }
fn pending_spec_list_empty(ids: PendingSpecList) -> (result: bool) {
    return match ids { PSNil => true, PSCons { head: h, tail: t } => false };
}
record PendingSpecRev { rest: PendingSpecList, acc: PendingSpecList }
fn reverse_pending_specs(ids: PendingSpecList) -> (result: PendingSpecList) {
    iterate i up_to 1024 carrying st: PendingSpecRev = PendingSpecRev { rest: ids, acc: PendingSpecList.PSNil } {
        if pending_spec_list_empty(st.rest) { return st.acc; }
        next st = reverse_pending_spec_step(st);
    }
    return st.acc;
}
fn reverse_pending_spec_step(st: PendingSpecRev) -> (result: PendingSpecRev) {
    return match st.rest {
        PSNil => st,
        PSCons { head: h, tail: t } => PendingSpecRev { rest: t, acc: PendingSpecList.PSCons { head: h, tail: st.acc } }
    };
}
record PendingSpecAppend { rest: PendingSpecList, tail: PendingSpecList }
fn append_pending_specs(front: PendingSpecList, back: PendingSpecList) -> (result: PendingSpecList) {
    let rev: PendingSpecList = reverse_pending_specs(front);
    iterate i up_to 1024 carrying st: PendingSpecAppend = PendingSpecAppend { rest: rev, tail: back } {
        if pending_spec_list_empty(st.rest) { return st.tail; }
        next st = append_pending_spec_step(st);
    }
    return st.tail;
}
fn append_pending_spec_step(st: PendingSpecAppend) -> (result: PendingSpecAppend) {
    return match st.rest {
        PSNil => st,
        PSCons { head: h, tail: t } => PendingSpecAppend { rest: t, tail: PendingSpecList.PSCons { head: h, tail: st.tail } }
    };
}

record InstCalleeCollect { rest: VmInstructionList, acc: PendingSpecList }
fn collect_inst_callees(insts: VmInstructionList, acc: PendingSpecList) -> (result: PendingSpecList) {
    iterate i up_to 1024 carrying st: InstCalleeCollect = InstCalleeCollect { rest: insts, acc: acc } {
        if vm_inst_list_empty(st.rest) { return st.acc; }
        next st = collect_inst_callee_step(st);
    }
    return st.acc;
}
fn collect_inst_callee_step(st: InstCalleeCollect) -> (result: InstCalleeCollect) {
    return match st.rest {
        VINil => st,
        VICons { head: inst, tail: rest } => collect_inst_callee_one(st, inst, rest)
    };
}
fn collect_inst_callee_one(st: InstCalleeCollect, inst: VmInstruction, rest: VmInstructionList) -> (result: InstCalleeCollect) {
    if inst.opcode == 13 {
        let key: VmSpecKey = VmSpecKey { identity: inst.callee_identity, nat_args: inst.callee_nat_args };
        return InstCalleeCollect { rest: rest, acc: PendingSpecList.PSCons { head: key, tail: st.acc } };
    }
    return InstCalleeCollect { rest: rest, acc: st.acc };
}

record BlockCalleeCollect { rest: VmBlockList, acc: PendingSpecList }
fn collect_fn_callees_in_order(fn_item: VmFunction) -> (result: PendingSpecList) {
    iterate i up_to 1024 carrying st: BlockCalleeCollect = BlockCalleeCollect { rest: fn_item.blocks, acc: PendingSpecList.PSNil } {
        if vm_block_list_empty(st.rest) { return reverse_pending_specs(st.acc); }
        next st = collect_block_callee_step(st);
    }
    return reverse_pending_specs(st.acc);
}
fn collect_block_callee_step(st: BlockCalleeCollect) -> (result: BlockCalleeCollect) {
    return match st.rest {
        VBNil => st,
        VBCons { head: blk, tail: rest } => BlockCalleeCollect { rest: rest, acc: collect_inst_callees(blk.instructions, st.acc) }
    };
}

record FnsCalleeCollect { rest: VmFunctionList, acc: PendingSpecList }
fn collect_fns_callees_in_order(fns: VmFunctionList) -> (result: PendingSpecList) {
    iterate i up_to 1024 carrying st: FnsCalleeCollect = FnsCalleeCollect { rest: fns, acc: PendingSpecList.PSNil } {
        if vm_fn_list_empty(st.rest) { return st.acc; }
        next st = collect_fns_callee_step(st);
    }
    return st.acc;
}
fn collect_fns_callee_step(st: FnsCalleeCollect) -> (result: FnsCalleeCollect) {
    return match st.rest {
        VFNil => st,
        VFCons { head: fn_item, tail: rest } => FnsCalleeCollect {
            rest: rest,
            acc: append_pending_specs(st.acc, collect_fn_callees_in_order(fn_item))
        }
    };
}

// Value-type lookup inside a lowered VmFunction (inputs, block params, inst results).
record VmInstTypeWalk { rest: VmInstructionList, wanted: u64, found: bool, ty: VmType }
fn vm_inst_list_find_type(insts: VmInstructionList, wanted: u64) -> (result: VmType) {
    let initial: VmInstTypeWalk = VmInstTypeWalk { rest: insts, wanted: wanted, found: false, ty: invalid_vm_type() };
    iterate i up_to 1024 carrying st: VmInstTypeWalk = initial {
        if st.found || vm_inst_list_empty(st.rest) { return st.ty; }
        next st = vm_inst_list_find_step(st);
    }
    return st.ty;
}
fn vm_inst_list_find_step(st: VmInstTypeWalk) -> (result: VmInstTypeWalk) {
    return match st.rest {
        VINil => st,
        VICons { head: inst, tail: rest } => vm_inst_list_find_one(st, inst, rest)
    };
}
fn vm_inst_list_find_one(st: VmInstTypeWalk, inst: VmInstruction, rest: VmInstructionList) -> (result: VmInstTypeWalk) {
    if inst.result == st.wanted { return VmInstTypeWalk { rest: VmInstructionList.VINil, wanted: st.wanted, found: true, ty: inst.ty }; }
    return VmInstTypeWalk { ..st, rest: rest };
}

record VmBlockTypeWalk { rest: VmBlockList, wanted: u64, found: bool, ty: VmType }
fn vm_fn_find_value_type(fn_item: VmFunction, wanted: u64) -> (result: VmType) {
    let from_inputs: VmValTypeLookup = lookup_vm_value_type(fn_item.inputs, wanted);
    if from_inputs.found && from_inputs.ty.valid { return from_inputs.ty; }
    let initial: VmBlockTypeWalk = VmBlockTypeWalk { rest: fn_item.blocks, wanted: wanted, found: false, ty: invalid_vm_type() };
    iterate i up_to 1024 carrying st: VmBlockTypeWalk = initial {
        if st.found || vm_block_list_empty(st.rest) { return st.ty; }
        next st = vm_block_type_find_step(st);
    }
    return st.ty;
}
fn vm_block_type_find_step(st: VmBlockTypeWalk) -> (result: VmBlockTypeWalk) {
    return match st.rest {
        VBNil => st,
        VBCons { head: blk, tail: rest } => vm_block_type_find_one(st, blk, rest)
    };
}
fn vm_block_type_find_one(st: VmBlockTypeWalk, blk: VmBlock, rest: VmBlockList) -> (result: VmBlockTypeWalk) {
    let from_params: VmValTypeLookup = lookup_vm_value_type(blk.parameters, st.wanted);
    if from_params.found && from_params.ty.valid { return VmBlockTypeWalk { rest: VmBlockList.VBNil, wanted: st.wanted, found: true, ty: from_params.ty }; }
    let from_insts: VmType = vm_inst_list_find_type(blk.instructions, st.wanted);
    if from_insts.valid { return VmBlockTypeWalk { rest: VmBlockList.VBNil, wanted: st.wanted, found: true, ty: from_insts }; }
    return VmBlockTypeWalk { ..st, rest: rest };
}

record CallArgsMatchWalk { caller: VmFunction, args: ssa.IdList, params: VmValueList, ok: bool, done: bool }
fn call_args_match_callee(caller: VmFunction, args: ssa.IdList, params: VmValueList) -> (result: bool) {
    let initial: CallArgsMatchWalk = CallArgsMatchWalk { caller: caller, args: args, params: params, ok: true, done: false };
    iterate i up_to 128 carrying st: CallArgsMatchWalk = initial {
        if st.done || !(st.ok) { return st.ok && st.done; }
        next st = call_args_match_step(st);
    }
    return st.ok && st.done;
}
fn call_args_match_step(st: CallArgsMatchWalk) -> (result: CallArgsMatchWalk) {
    return match st.args {
        ssa.IdList.INil => CallArgsMatchWalk { ..st, ok: vm_value_list_empty(st.params), done: true },
        ssa.IdList.ICons { head: arg_id, tail: arg_rest } => call_args_match_pair(st, arg_id.value, arg_rest)
    };
}
fn call_args_match_pair(st: CallArgsMatchWalk, arg_val_id: u64, arg_rest: ssa.IdList) -> (result: CallArgsMatchWalk) {
    return match st.params {
        VVNil => CallArgsMatchWalk { ..st, ok: false, done: true },
        VVCons { head: param, tail: param_rest } => call_args_match_check(st, arg_val_id, arg_rest, param, param_rest)
    };
}
fn call_args_match_check(st: CallArgsMatchWalk, arg_val_id: u64, arg_rest: ssa.IdList, param: VmValue, param_rest: VmValueList) -> (result: CallArgsMatchWalk) {
    let arg_ty: VmType = vm_fn_find_value_type(st.caller, arg_val_id);
    if !(vm_type_equal(arg_ty, param.ty)) {
        return CallArgsMatchWalk { ..st, ok: false, done: true };
    }
    return CallArgsMatchWalk { caller: st.caller, args: arg_rest, params: param_rest, ok: true, done: false };
}

record CallVerifyResult { ok: bool, error_code: u64, error_function: u64, error_block: u64, error_inst: u64, error_detail: VmEmitFailureDetail }
record CallVerifyInstWalk { all_fns: VmFunctionList, caller: VmFunction, fn_idx: u64, blk_id: u64, rest: VmInstructionList, ok: bool, error_code: u64, error_inst: u64 }
fn verify_block_calls(all_fns: VmFunctionList, caller: VmFunction, fn_idx: u64, blk: VmBlock) -> (result: CallVerifyResult) {
    let initial: CallVerifyInstWalk = CallVerifyInstWalk { all_fns: all_fns, caller: caller, fn_idx: fn_idx, blk_id: blk.id, rest: blk.instructions, ok: true, error_code: 0, error_inst: 0 };
    iterate i up_to 1024 carrying st: CallVerifyInstWalk = initial {
        if !(st.ok) || vm_inst_list_empty(st.rest) {
            let det: VmEmitFailureDetail = phase_failure_detail(caller.identity, 13, 3, 0, 0, decl.invalid_semantic_identity(), 0, 0);
            return CallVerifyResult { ok: st.ok, error_code: st.error_code, error_function: fn_idx, error_block: blk.id, error_inst: st.error_inst, error_detail: det };
        }
        next st = verify_block_call_step(st);
    }
    let det_end: VmEmitFailureDetail = phase_failure_detail(caller.identity, 13, 3, 0, 0, decl.invalid_semantic_identity(), 0, 0);
    return CallVerifyResult { ok: st.ok, error_code: st.error_code, error_function: fn_idx, error_block: blk.id, error_inst: st.error_inst, error_detail: det_end };
}
fn verify_block_call_step(st: CallVerifyInstWalk) -> (result: CallVerifyInstWalk) {
    return match st.rest {
        VINil => st,
        VICons { head: inst, tail: rest } => verify_block_call_one(st, inst, rest)
    };
}
fn verify_block_call_one(st: CallVerifyInstWalk, inst: VmInstruction, rest: VmInstructionList) -> (result: CallVerifyInstWalk) {
    if inst.opcode != 13 { return CallVerifyInstWalk { ..st, rest: rest }; }
    let key: VmSpecKey = VmSpecKey { identity: inst.callee_identity, nat_args: inst.callee_nat_args };
    let callee: VmFnLookup = find_vm_fn_by_spec(st.all_fns, key);
    if !(callee.found) {
        return CallVerifyInstWalk { ..st, rest: VmInstructionList.VINil, ok: false, error_code: 9, error_inst: inst.id };
    }
    if !(vm_type_equal(inst.ty, callee.fn_item.result_type)) {
        return CallVerifyInstWalk { ..st, rest: VmInstructionList.VINil, ok: false, error_code: 10, error_inst: inst.id };
    }
    if !(call_args_match_callee(st.caller, inst.inputs, callee.fn_item.inputs)) {
        return CallVerifyInstWalk { ..st, rest: VmInstructionList.VINil, ok: false, error_code: 10, error_inst: inst.id };
    }
    return CallVerifyInstWalk { ..st, rest: rest };
}

record CallVerifyBlockWalk { all_fns: VmFunctionList, caller: VmFunction, fn_idx: u64, rest: VmBlockList, ok: bool, error_code: u64, error_block: u64, error_inst: u64, error_detail: VmEmitFailureDetail }
fn verify_fn_calls(all_fns: VmFunctionList, caller: VmFunction, fn_idx: u64) -> (result: CallVerifyResult) {
    let initial: CallVerifyBlockWalk = CallVerifyBlockWalk { all_fns: all_fns, caller: caller, fn_idx: fn_idx, rest: caller.blocks, ok: true, error_code: 0, error_block: 0, error_inst: 0, error_detail: empty_failure_detail() };
    iterate i up_to 1024 carrying st: CallVerifyBlockWalk = initial {
        if !(st.ok) || vm_block_list_empty(st.rest) {
            return CallVerifyResult { ok: st.ok, error_code: st.error_code, error_function: fn_idx, error_block: st.error_block, error_inst: st.error_inst, error_detail: st.error_detail };
        }
        next st = verify_fn_call_block_step(st);
    }
    return CallVerifyResult { ok: st.ok, error_code: st.error_code, error_function: fn_idx, error_block: st.error_block, error_inst: st.error_inst, error_detail: st.error_detail };
}
fn verify_fn_call_block_step(st: CallVerifyBlockWalk) -> (result: CallVerifyBlockWalk) {
    return match st.rest {
        VBNil => st,
        VBCons { head: blk, tail: rest } => verify_fn_call_block_one(st, blk, rest)
    };
}
fn verify_fn_call_block_one(st: CallVerifyBlockWalk, blk: VmBlock, rest: VmBlockList) -> (result: CallVerifyBlockWalk) {
    let checked: CallVerifyResult = verify_block_calls(st.all_fns, st.caller, st.fn_idx, blk);
    if !(checked.ok) {
        return CallVerifyBlockWalk { ..st, rest: VmBlockList.VBNil, ok: false, error_code: checked.error_code, error_block: checked.error_block, error_inst: checked.error_inst, error_detail: checked.error_detail };
    }
    return CallVerifyBlockWalk { ..st, rest: rest };
}

record CallVerifyFnWalk { all_fns: VmFunctionList, rest: VmFunctionList, index: u64, ok: bool, error_code: u64, error_function: u64, error_block: u64, error_inst: u64, error_detail: VmEmitFailureDetail }
fn verify_closure_calls(all_fns: VmFunctionList) -> (result: CallVerifyResult) {
    let initial: CallVerifyFnWalk = CallVerifyFnWalk { all_fns: all_fns, rest: all_fns, index: 0, ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0, error_detail: empty_failure_detail() };
    iterate i up_to 1024 carrying st: CallVerifyFnWalk = initial {
        if !(st.ok) || vm_fn_list_empty(st.rest) {
            return CallVerifyResult { ok: st.ok, error_code: st.error_code, error_function: st.error_function, error_block: st.error_block, error_inst: st.error_inst, error_detail: st.error_detail };
        }
        next st = verify_closure_calls_step(st);
    }
    return CallVerifyResult { ok: st.ok, error_code: st.error_code, error_function: st.error_function, error_block: st.error_block, error_inst: st.error_inst, error_detail: st.error_detail };
}
fn verify_closure_calls_step(st: CallVerifyFnWalk) -> (result: CallVerifyFnWalk) {
    return match st.rest {
        VFNil => st,
        VFCons { head: caller, tail: rest } => verify_closure_calls_one(st, caller, rest)
    };
}
fn verify_closure_calls_one(st: CallVerifyFnWalk, caller: VmFunction, rest: VmFunctionList) -> (result: CallVerifyFnWalk) {
    let checked: CallVerifyResult = verify_fn_calls(st.all_fns, caller, st.index);
    if !(checked.ok) {
        return CallVerifyFnWalk { ..st, rest: VmFunctionList.VFNil, ok: false, error_code: checked.error_code, error_function: checked.error_function, error_block: checked.error_block, error_inst: checked.error_inst, error_detail: checked.error_detail };
    }
    return CallVerifyFnWalk { ..st, rest: rest, index: st.index + 1 };
}

// ---------------------------------------------------------------------------
// Single-module entry points
// ---------------------------------------------------------------------------

fn emit_verified_ssa<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, summary: ssa.ValueSsaSummary, header: parser.Header) -> (result: VmEmitResult) {
    if !(summary.valid) || summary.function_count == 0 || summary.verified_function_count != summary.function_count || summary.unsupported_block_count > 0 {
        return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(decl.invalid_semantic_identity(), 2, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    if header.code != 0 || header.state != 8 || header.module_end <= header.module_start || header.module_end > total {
        return emit_failure_detailed(8, 0, 0, 0, phase_failure_detail(decl.invalid_semantic_identity(), 2, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let lowered: FnEmitWalk = lower_vm_scalar_functions(summary);
    if !(lowered.ok) || lowered.fn_count != summary.function_count {
        return emit_failure_detailed(select(lowered.ok, 2, lowered.error_code), lowered.error_function, lowered.error_block, lowered.error_inst, lowered.error_detail);
    }
    let verified_calls: CallVerifyResult = verify_closure_calls(lowered.acc);
    if !(verified_calls.ok) {
        return emit_failure_detailed(verified_calls.error_code, verified_calls.error_function, verified_calls.error_block, verified_calls.error_inst, verified_calls.error_detail);
    }
    return VmEmitResult {
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_instruction: 0,
        error_detail: empty_failure_detail(),
        module_name_start: header.module_start, module_name_end: header.module_end,
        record_types: VmRecordTypeList.VRTNil, record_type_count: 0,
        finite_types: VmFiniteTypeList.VFTNil, finite_type_count: 0,
        functions: lowered.acc,
        function_count: lowered.fn_count,
        block_count: lowered.block_count,
        instruction_count: lowered.inst_count
    };
}

fn compile_and_emit_vm_module<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: VmEmitResult) {
    let header: parser.Header = parser.header_global<P, N>(pages, stride, total);
    if header.code != 0 || header.state != 8 { return emit_failure(8, 0, 0, 0); }
    let value_ssa: ssa.ValueSsaSummary = ssa.lower_flow_unit_value_ssa<P, N>(pages, stride, total);
    return emit_verified_ssa<P, N>(pages, stride, total, value_ssa, header);
}

// ---------------------------------------------------------------------------
// Multi-module Project SSA closure selection and VM emission (100% in MNCS)
// ---------------------------------------------------------------------------

fn project_module_list_empty(modules: project.ProjectModuleList) -> (result: bool) {
    return match modules {
        project.ProjectModuleList.PNil => true,
        project.ProjectModuleList.PCons { head: h, tail: t } => false
    };
}
fn empty_header() -> (result: parser.Header) {
    return parser.Header { code: 1, start: 0, end: 0, version_start: 0, version_end: 0, module_start: 0, module_end: 0, next_offset: 0, state: 0 };
}
fn empty_unit() -> (result: decl.Unit) {
    return decl.Unit { ok: false, err_start: 0, err_end: 0, header: empty_header(), uses: decl.UseList.UNil, records: decl.RecordList.RNil, enums: decl.EnumList.GNil, fns: decl.FnList.DNil, cursor: 0 };
}

record ReachableModulesCheck {
    rest: project.ProjectModuleList,
    reachable: [bool; 64],
    target_source_index: u64,
    all_verified: bool,
    target_found: bool,
    target_header: parser.Header,
    target_unit: decl.Unit,
    target_ssa: ssa.ValueSsaSummary
}
fn inspect_reachable_project_modules(modules: project.ProjectModuleList, reachable: [bool; 64], target_source_index: u64) -> (result: ReachableModulesCheck) {
    let initial: ReachableModulesCheck = ReachableModulesCheck {
        rest: modules, reachable: reachable, target_source_index: target_source_index,
        all_verified: true, target_found: false, target_header: empty_header(),
        target_unit: empty_unit(), target_ssa: ssa.empty_ssa_summary(false)
    };
    iterate i up_to 64 carrying st: ReachableModulesCheck = initial {
        if !(st.all_verified) || project_module_list_empty(st.rest) { return st; }
        next st = inspect_reachable_project_module_step(st);
    }
    return st;
}
fn inspect_reachable_project_module_step(st: ReachableModulesCheck) -> (result: ReachableModulesCheck) {
    return match st.rest {
        project.ProjectModuleList.PNil => st,
        project.ProjectModuleList.PCons { head: mod_item, tail: rest } => inspect_reachable_project_module_one(st, mod_item, rest)
    };
}
fn inspect_reachable_project_module_one(st: ReachableModulesCheck, mod_item: project.ProjectModule, rest: project.ProjectModuleList) -> (result: ReachableModulesCheck) {
    if mod_item.source_index >= 64 || !(st.reachable[mod_item.source_index]) {
        return ReachableModulesCheck { ..st, rest: rest };
    }
    let mod_ok: bool = mod_item.flow.valid && mod_item.flow.proof.ok
        && mod_item.value_ssa.valid
        && mod_item.value_ssa.verified_function_count == mod_item.value_ssa.function_count
        && mod_item.value_ssa.unsupported_block_count == 0;
    if !(mod_ok) {
        return ReachableModulesCheck { ..st, rest: project.ProjectModuleList.PNil, all_verified: false };
    }
    if mod_item.source_index == st.target_source_index {
        return ReachableModulesCheck {
            ..st, rest: rest,
            target_found: true,
            target_header: mod_item.flow.proof.unit.header,
            target_unit: mod_item.flow.proof.unit,
            target_ssa: mod_item.value_ssa
        };
    }
    return ReachableModulesCheck { ..st, rest: rest };
}

record ReachableSsaFnLookup { found: bool, source_index: u64, unit: decl.Unit, func: ssa.Function }
record SsaSummaryIdSearch { index: u64, found: bool, func: ssa.Function }
fn find_ssa_fn_in_summary_by_id(summary: ssa.ValueSsaSummary, wanted: decl.SemanticIdentity) -> (result: SsaSummaryIdSearch) {
    let initial: SsaSummaryIdSearch = SsaSummaryIdSearch { index: 0, found: false, func: ssa.empty_ssa_function() };
    iterate i up_to 1024 carrying st: SsaSummaryIdSearch = initial {
        if st.found || st.index >= summary.function_count { return st; }
        next st = find_ssa_fn_in_summary_step(summary, wanted, st);
    }
    return st;
}
fn find_ssa_fn_in_summary_step(summary: ssa.ValueSsaSummary, wanted: decl.SemanticIdentity, st: SsaSummaryIdSearch) -> (result: SsaSummaryIdSearch) {
    let lookup: ssa.ValueSsaFunctionLookup = ssa.value_ssa_function_at(summary, st.index);
    if !(lookup.found) { return SsaSummaryIdSearch { ..st, index: summary.function_count }; }
    if semantic_ids_equal(lookup.function.identity, wanted) {
        return SsaSummaryIdSearch { index: st.index + 1, found: true, func: lookup.function };
    }
    return SsaSummaryIdSearch { ..st, index: st.index + 1 };
}

record ReachableModuleFnSearch { rest: project.ProjectModuleList, reachable: [bool; 64], wanted: decl.SemanticIdentity, found: bool, source_index: u64, unit: decl.Unit, func: ssa.Function }
fn find_ssa_fn_in_reachable_modules(modules: project.ProjectModuleList, reachable: [bool; 64], wanted: decl.SemanticIdentity) -> (result: ReachableSsaFnLookup) {
    let initial: ReachableModuleFnSearch = ReachableModuleFnSearch { rest: modules, reachable: reachable, wanted: wanted, found: false, source_index: 0, unit: empty_unit(), func: ssa.empty_ssa_function() };
    iterate i up_to 256 carrying st: ReachableModuleFnSearch = initial {
        if st.found || project_module_list_empty(st.rest) {
            return ReachableSsaFnLookup { found: st.found, source_index: st.source_index, unit: st.unit, func: st.func };
        }
        next st = find_ssa_fn_in_reachable_module_step(st);
    }
    return ReachableSsaFnLookup { found: st.found, source_index: st.source_index, unit: st.unit, func: st.func };
}
fn find_ssa_fn_in_reachable_module_step(st: ReachableModuleFnSearch) -> (result: ReachableModuleFnSearch) {
    return match st.rest {
        project.ProjectModuleList.PNil => st,
        project.ProjectModuleList.PCons { head: mod_item, tail: rest } => find_ssa_fn_in_reachable_module_one(st, mod_item, rest)
    };
}
fn find_ssa_fn_in_reachable_module_one(st: ReachableModuleFnSearch, mod_item: project.ProjectModule, rest: project.ProjectModuleList) -> (result: ReachableModuleFnSearch) {
    if mod_item.source_index >= 64 || !(st.reachable[mod_item.source_index]) {
        return ReachableModuleFnSearch { ..st, rest: rest };
    }
    let found: SsaSummaryIdSearch = find_ssa_fn_in_summary_by_id(mod_item.value_ssa, st.wanted);
    if found.found {
        return ReachableModuleFnSearch {
            rest: project.ProjectModuleList.PNil, reachable: st.reachable, wanted: st.wanted,
            found: true, source_index: mod_item.source_index, unit: mod_item.flow.proof.unit, func: found.func
        };
    }
    return ReachableModuleFnSearch { ..st, rest: rest };
}

// Wire-only scalar multi-module closure expansion (for `emit_verified_project_ssa` wire tests).
record ProjectClosureWalk {
    emitted_rev: VmFunctionList,
    pending: PendingSpecList,
    fn_count: u64,
    block_count: u64,
    inst_count: u64,
    ok: bool,
    error_code: u64,
    error_function: u64,
    error_block: u64,
    error_inst: u64,
    error_detail: VmEmitFailureDetail
}
fn expand_project_vm_closure_scalar(modules: project.ProjectModuleList, reachable: [bool; 64], root_fns: VmFunctionList, root_fn_count: u64, root_block_count: u64, root_inst_count: u64) -> (result: ProjectClosureWalk) {
    let seeded_pending: PendingSpecList = collect_fns_callees_in_order(root_fns);
    let initial: ProjectClosureWalk = ProjectClosureWalk {
        emitted_rev: reverse_vm_fns(root_fns), pending: seeded_pending,
        fn_count: root_fn_count, block_count: root_block_count, inst_count: root_inst_count,
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0,
        error_detail: empty_failure_detail()
    };
    iterate step up_to 256 carrying st: ProjectClosureWalk = initial {
        if !(st.ok) || pending_spec_list_empty(st.pending) {
            return ProjectClosureWalk { ..st, emitted_rev: reverse_vm_fns(st.emitted_rev) };
        }
        next st = expand_project_vm_closure_scalar_step(modules, reachable, st);
    }
    return ProjectClosureWalk {
        ..st, emitted_rev: reverse_vm_fns(st.emitted_rev),
        ok: st.ok && pending_spec_list_empty(st.pending),
        error_code: select(st.ok && !(pending_spec_list_empty(st.pending)), 9, st.error_code)
    };
}
fn expand_project_vm_closure_scalar_step(modules: project.ProjectModuleList, reachable: [bool; 64], st: ProjectClosureWalk) -> (result: ProjectClosureWalk) {
    return match st.pending {
        PSNil => st,
        PSCons { head: spec_key, tail: rest } => expand_project_vm_closure_scalar_one(modules, reachable, st, spec_key, rest)
    };
}
fn expand_project_vm_closure_scalar_one(modules: project.ProjectModuleList, reachable: [bool; 64], st: ProjectClosureWalk, spec_key: VmSpecKey, rest: PendingSpecList) -> (result: ProjectClosureWalk) {
    if !(vm_nat_list_empty(spec_key.nat_args)) {
        return ProjectClosureWalk { ..st, pending: PendingSpecList.PSNil, ok: false, error_code: 11, error_function: st.fn_count, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(spec_key.identity, 4, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    let existing: VmFnLookup = find_vm_fn_by_spec(st.emitted_rev, spec_key);
    if existing.found { return ProjectClosureWalk { ..st, pending: rest }; }
    let located: ReachableSsaFnLookup = find_ssa_fn_in_reachable_modules(modules, reachable, spec_key.identity);
    if !(located.found) {
        return ProjectClosureWalk { ..st, pending: PendingSpecList.PSNil, ok: false, error_code: 9, error_function: st.fn_count, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(spec_key.identity, 12, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    let lowered: SingleFnLowerResult = lower_single_scalar_ssa_fn(located.func);
    if !(lowered.ok) {
        return ProjectClosureWalk { ..st, pending: PendingSpecList.PSNil, ok: false, error_code: lowered.error_code, error_function: st.fn_count, error_block: lowered.error_block, error_inst: lowered.error_inst, error_detail: lowered.error_detail };
    }
    let child_callees: PendingSpecList = collect_fn_callees_in_order(lowered.vm_fn);
    return ProjectClosureWalk {
        emitted_rev: VmFunctionList.VFCons { head: lowered.vm_fn, tail: st.emitted_rev },
        pending: append_pending_specs(rest, child_callees),
        fn_count: st.fn_count + 1,
        block_count: st.block_count + lowered.vm_fn.block_count,
        inst_count: st.inst_count + lowered.vm_fn.instruction_count,
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0,
        error_detail: empty_failure_detail()
    };
}

fn emit_verified_project_ssa(compiled: project.ProjectResult, target_source_index: u64) -> (result: VmEmitResult) {
    if !(compiled.valid) || !(compiled.value_ssa_valid) || compiled.module_count == 0
        || target_source_index >= compiled.source_count || target_source_index >= 64 {
        return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(decl.invalid_semantic_identity(), 1, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let closure: project.ProjectImportClosure = project.project_import_closure(compiled.imports, target_source_index, compiled.source_count);
    let inspected: ReachableModulesCheck = inspect_reachable_project_modules(compiled.modules, closure.reachable, target_source_index);
    if !(inspected.all_verified) || !(inspected.target_found) { return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(decl.invalid_semantic_identity(), 1, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0)); }
    if inspected.target_header.code != 0 || inspected.target_header.state != 8
        || inspected.target_header.module_end <= inspected.target_header.module_start {
        return emit_failure_detailed(8, 0, 0, 0, phase_failure_detail(decl.invalid_semantic_identity(), 2, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    if !(inspected.target_ssa.valid) || inspected.target_ssa.function_count == 0
        || inspected.target_ssa.verified_function_count != inspected.target_ssa.function_count
        || inspected.target_ssa.unsupported_block_count > 0 {
        return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(decl.invalid_semantic_identity(), 2, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let root_lowered: FnEmitWalk = lower_vm_scalar_functions(inspected.target_ssa);
    if !(root_lowered.ok) || root_lowered.fn_count != inspected.target_ssa.function_count {
        return emit_failure_detailed(select(root_lowered.ok, 2, root_lowered.error_code), root_lowered.error_function, root_lowered.error_block, root_lowered.error_inst, root_lowered.error_detail);
    }
    let expanded: ProjectClosureWalk = expand_project_vm_closure_scalar(
        compiled.modules, closure.reachable,
        root_lowered.acc, root_lowered.fn_count, root_lowered.block_count, root_lowered.inst_count
    );
    if !(expanded.ok) {
        return emit_failure_detailed(expanded.error_code, expanded.error_function, expanded.error_block, expanded.error_inst, expanded.error_detail);
    }
    let verified_calls: CallVerifyResult = verify_closure_calls(expanded.emitted_rev);
    if !(verified_calls.ok) {
        return emit_failure_detailed(verified_calls.error_code, verified_calls.error_function, verified_calls.error_block, verified_calls.error_inst, verified_calls.error_detail);
    }
    return VmEmitResult {
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_instruction: 0,
        error_detail: empty_failure_detail(),
        module_name_start: inspected.target_header.module_start,
        module_name_end: inspected.target_header.module_end,
        record_types: VmRecordTypeList.VRTNil, record_type_count: 0,
        finite_types: VmFiniteTypeList.VFTNil, finite_type_count: 0,
        functions: expanded.emitted_rev,
        function_count: expanded.fn_count,
        block_count: expanded.block_count,
        instruction_count: expanded.inst_count
    };
}

// Source-backed multi-module closure lowering with concrete Nat specialization,
// bounded byte-view lowering, nominal records, and nominal finite enums.
fn lower_target_concrete_functions<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, unit: decl.Unit, summary: ssa.ValueSsaSummary, schemas: VmSchemas) -> (result: FnEmitWalk) {
    iterate i up_to 1024 carrying st: FnEmitWalk = FnEmitWalk {
        index: 0, acc: VmFunctionList.VFNil, fn_count: 0, block_count: 0, inst_count: 0,
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0,
        error_detail: empty_failure_detail()
    } {
        if !(st.ok) || st.index >= summary.function_count {
            return FnEmitWalk { ..st, acc: reverse_vm_fns(st.acc) };
        }
        next st = lower_target_concrete_fn_step<P, N>(pages, stride, total, unit, summary, schemas, st);
    }
    return FnEmitWalk { ..st, acc: reverse_vm_fns(st.acc), ok: st.ok && st.index >= summary.function_count, error_code: select(st.ok && st.index < summary.function_count, 2, st.error_code) };
}
fn lower_target_concrete_fn_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, unit: decl.Unit, summary: ssa.ValueSsaSummary, schemas: VmSchemas, st: FnEmitWalk) -> (result: FnEmitWalk) {
    let lookup: ssa.ValueSsaFunctionLookup = ssa.value_ssa_function_at(summary, st.index);
    if !(lookup.found) {
        return FnEmitWalk { ..st, ok: false, error_code: 2, error_function: st.index, error_block: 0, error_inst: 0, error_detail: empty_failure_detail() };
    }
    let decl_lk: FnDeclLookup = find_fn_decl_by_id<P, N>(pages, stride, total, unit.header, unit.fns, lookup.function.identity);
    if !(decl_lk.found) {
        return FnEmitWalk { ..st, ok: false, error_code: 2, error_function: st.index, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(lookup.function.identity, 3, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    // Generic templates in the target module are only instantiated at concrete call sites.
    if !(decl_generic_list_empty(decl_lk.fn_decl.sig.generics)) {
        return FnEmitWalk { ..st, index: st.index + 1 };
    }
    let lowered: SingleFnLowerResult = lower_ssa_fn_specialized_with_schemas<P, N>(pages, stride, total, lookup.function, decl_lk.fn_decl, VmNatArgList.NANil, schemas);
    if !(lowered.ok) {
        return FnEmitWalk { ..st, ok: false, error_code: lowered.error_code, error_function: st.index, error_block: lowered.error_block, error_inst: lowered.error_inst, error_detail: lowered.error_detail };
    }
    return FnEmitWalk {
        index: st.index + 1,
        acc: VmFunctionList.VFCons { head: lowered.vm_fn, tail: st.acc },
        fn_count: st.fn_count + 1,
        block_count: st.block_count + lowered.vm_fn.block_count,
        inst_count: st.inst_count + lowered.vm_fn.instruction_count,
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0,
        error_detail: empty_failure_detail()
    };
}

fn expand_project_vm_closure_with_sources<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], modules: project.ProjectModuleList, reachable: [bool; 64], schemas: VmSchemas, root_fns: VmFunctionList, root_fn_count: u64, root_block_count: u64, root_inst_count: u64) -> (result: ProjectClosureWalk) {
    let seeded_pending: PendingSpecList = collect_fns_callees_in_order(root_fns);
    let initial: ProjectClosureWalk = ProjectClosureWalk {
        emitted_rev: reverse_vm_fns(root_fns), pending: seeded_pending,
        fn_count: root_fn_count, block_count: root_block_count, inst_count: root_inst_count,
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0,
        error_detail: empty_failure_detail()
    };
    iterate step up_to 256 carrying st: ProjectClosureWalk = initial {
        if !(st.ok) || pending_spec_list_empty(st.pending) {
            return ProjectClosureWalk { ..st, emitted_rev: reverse_vm_fns(st.emitted_rev) };
        }
        next st = expand_project_vm_closure_src_step<M, N>(snapshot, flat_pages, modules, reachable, schemas, st);
    }
    return ProjectClosureWalk {
        ..st, emitted_rev: reverse_vm_fns(st.emitted_rev),
        ok: st.ok && pending_spec_list_empty(st.pending),
        error_code: select(st.ok && !(pending_spec_list_empty(st.pending)), 9, st.error_code)
    };
}
fn expand_project_vm_closure_src_step<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], modules: project.ProjectModuleList, reachable: [bool; 64], schemas: VmSchemas, st: ProjectClosureWalk) -> (result: ProjectClosureWalk) {
    return match st.pending {
        PSNil => st,
        PSCons { head: spec_key, tail: rest } => expand_project_vm_closure_src_one<M, N>(snapshot, flat_pages, modules, reachable, schemas, st, spec_key, rest)
    };
}
fn expand_project_vm_closure_src_one<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], modules: project.ProjectModuleList, reachable: [bool; 64], schemas: VmSchemas, st: ProjectClosureWalk, spec_key: VmSpecKey, rest: PendingSpecList) -> (result: ProjectClosureWalk) {
    let existing: VmFnLookup = find_vm_fn_by_spec(st.emitted_rev, spec_key);
    if existing.found { return ProjectClosureWalk { ..st, pending: rest }; }
    let located: ReachableSsaFnLookup = find_ssa_fn_in_reachable_modules(modules, reachable, spec_key.identity);
    if !(located.found) {
        return ProjectClosureWalk { ..st, pending: PendingSpecList.PSNil, ok: false, error_code: 9, error_function: st.fn_count, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(spec_key.identity, 12, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    let pages: [[byte; up_to N]; up_to 1024] = project.module_pages<M, N>(snapshot.sources, flat_pages, located.source_index);
    let stride: u64 = project.module_stride(snapshot.sources, located.source_index);
    let total: u64 = project.module_total(snapshot.sources, located.source_index);
    let decl_lk: FnDeclLookup = find_fn_decl_by_id<1024, N>(pages, stride, total, located.unit.header, located.unit.fns, located.func.identity);
    if !(decl_lk.found) {
        return ProjectClosureWalk { ..st, pending: PendingSpecList.PSNil, ok: false, error_code: 2, error_function: st.fn_count, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(located.func.identity, 3, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    let lowered: SingleFnLowerResult = lower_ssa_fn_specialized_with_schemas<1024, N>(pages, stride, total, located.func, decl_lk.fn_decl, spec_key.nat_args, schemas);
    if !(lowered.ok) {
        return ProjectClosureWalk { ..st, pending: PendingSpecList.PSNil, ok: false, error_code: lowered.error_code, error_function: st.fn_count, error_block: lowered.error_block, error_inst: lowered.error_inst, error_detail: lowered.error_detail };
    }
    let child_callees: PendingSpecList = collect_fn_callees_in_order(lowered.vm_fn);
    return ProjectClosureWalk {
        emitted_rev: VmFunctionList.VFCons { head: lowered.vm_fn, tail: st.emitted_rev },
        pending: append_pending_specs(rest, child_callees),
        fn_count: st.fn_count + 1,
        block_count: st.block_count + lowered.vm_fn.block_count,
        inst_count: st.inst_count + lowered.vm_fn.instruction_count,
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0,
        error_detail: empty_failure_detail()
    };
}

fn emit_verified_project_ssa_with_sources<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], compiled: project.ProjectResult, target_source_index: u64) -> (result: VmEmitResult) {
    if !(compiled.valid) || !(compiled.value_ssa_valid) || compiled.module_count == 0
        || target_source_index >= compiled.source_count || target_source_index >= 64 {
        return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(decl.invalid_semantic_identity(), 1, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let closure: project.ProjectImportClosure = project.project_import_closure(compiled.imports, target_source_index, compiled.source_count);
    let inspected: ReachableModulesCheck = inspect_reachable_project_modules(compiled.modules, closure.reachable, target_source_index);
    if !(inspected.all_verified) || !(inspected.target_found) { return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(decl.invalid_semantic_identity(), 1, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0)); }
    if inspected.target_header.code != 0 || inspected.target_header.state != 8
        || inspected.target_header.module_end <= inspected.target_header.module_start {
        return emit_failure_detailed(8, 0, 0, 0, phase_failure_detail(decl.invalid_semantic_identity(), 2, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    if !(inspected.target_ssa.valid) || inspected.target_ssa.function_count == 0
        || inspected.target_ssa.verified_function_count != inspected.target_ssa.function_count
        || inspected.target_ssa.unsupported_block_count > 0 {
        return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(decl.invalid_semantic_identity(), 2, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let all_recs: VmRecordTypeList = collect_reachable_record_types<M, N>(snapshot, flat_pages, compiled.modules, closure.reachable);
    let all_fins: VmFiniteTypeList = collect_reachable_finite_types<M, N>(snapshot, flat_pages, compiled.modules, closure.reachable);
    let schemas: VmSchemas = VmSchemas { records: all_recs, finites: all_fins };
    let root_pages: [[byte; up_to N]; up_to 1024] = project.module_pages<M, N>(snapshot.sources, flat_pages, target_source_index);
    let root_stride: u64 = project.module_stride(snapshot.sources, target_source_index);
    let root_total: u64 = project.module_total(snapshot.sources, target_source_index);
    let root_lowered: FnEmitWalk = lower_target_concrete_functions<1024, N>(root_pages, root_stride, root_total, inspected.target_unit, inspected.target_ssa, schemas);
    if !(root_lowered.ok) {
        return emit_failure_detailed(root_lowered.error_code, root_lowered.error_function, root_lowered.error_block, root_lowered.error_inst, root_lowered.error_detail);
    }
    if root_lowered.fn_count == 0 {
        return emit_failure_detailed(11, 0, 0, 0, phase_failure_detail(decl.invalid_semantic_identity(), 3, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let expanded: ProjectClosureWalk = expand_project_vm_closure_with_sources<M, N>(
        snapshot, flat_pages, compiled.modules, closure.reachable, schemas,
        root_lowered.acc, root_lowered.fn_count, root_lowered.block_count, root_lowered.inst_count
    );
    if !(expanded.ok) {
        return emit_failure_detailed(expanded.error_code, expanded.error_function, expanded.error_block, expanded.error_inst, expanded.error_detail);
    }
    let verified_calls: CallVerifyResult = verify_closure_calls(expanded.emitted_rev);
    if !(verified_calls.ok) {
        return emit_failure_detailed(verified_calls.error_code, verified_calls.error_function, verified_calls.error_block, verified_calls.error_inst, verified_calls.error_detail);
    }
    let retained: SchemaUsageState = retain_referenced_schemas(schemas, expanded.emitted_rev);
    return VmEmitResult {
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_instruction: 0,
        error_detail: empty_failure_detail(),
        module_name_start: inspected.target_header.module_start,
        module_name_end: inspected.target_header.module_end,
        record_types: retained.used_recs,
        record_type_count: retained.rec_count,
        finite_types: retained.used_fins,
        finite_type_count: retained.fin_count,
        functions: expanded.emitted_rev,
        function_count: expanded.fn_count,
        block_count: expanded.block_count,
        instruction_count: expanded.inst_count
    };
}

// Targeted single-callable lowering in a verified target module.
fn lower_target_selected_callable<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, unit: decl.Unit, summary: ssa.ValueSsaSummary, schemas: VmSchemas, target_callable: decl.SemanticIdentity) -> (result: FnEmitWalk) {
    if !(target_callable.valid) || target_callable.len == 0 {
        return FnEmitWalk { index: 0, acc: VmFunctionList.VFNil, fn_count: 0, block_count: 0, inst_count: 0, ok: false, error_code: 9, error_function: 0, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(target_callable, 3, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    let found: SsaSummaryIdSearch = find_ssa_fn_in_summary_by_id(summary, target_callable);
    if !(found.found) {
        return FnEmitWalk { index: 0, acc: VmFunctionList.VFNil, fn_count: 0, block_count: 0, inst_count: 0, ok: false, error_code: 9, error_function: 0, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(target_callable, 3, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    let fn_idx: u64 = select(found.index > 0, found.index - 1, 0);
    let decl_lk: FnDeclLookup = find_fn_decl_by_id<P, N>(pages, stride, total, unit.header, unit.fns, found.func.identity);
    if !(decl_lk.found) {
        return FnEmitWalk { index: fn_idx, acc: VmFunctionList.VFNil, fn_count: 0, block_count: 0, inst_count: 0, ok: false, error_code: 2, error_function: fn_idx, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(found.func.identity, 3, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    if !(decl_generic_list_empty(decl_lk.fn_decl.sig.generics)) {
        return FnEmitWalk { index: fn_idx, acc: VmFunctionList.VFNil, fn_count: 0, block_count: 0, inst_count: 0, ok: false, error_code: 11, error_function: fn_idx, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(found.func.identity, 4, 0, 0, 0, decl.invalid_semantic_identity(), decl_lk.fn_decl.sig.name_start, decl_lk.fn_decl.sig.name_end) };
    }
    let lowered: SingleFnLowerResult = lower_ssa_fn_specialized_with_schemas<P, N>(pages, stride, total, found.func, decl_lk.fn_decl, VmNatArgList.NANil, schemas);
    if !(lowered.ok) {
        return FnEmitWalk { index: fn_idx, acc: VmFunctionList.VFNil, fn_count: 0, block_count: 0, inst_count: 0, ok: false, error_code: lowered.error_code, error_function: fn_idx, error_block: lowered.error_block, error_inst: lowered.error_inst, error_detail: lowered.error_detail };
    }
    return FnEmitWalk {
        index: fn_idx + 1,
        acc: VmFunctionList.VFCons { head: lowered.vm_fn, tail: VmFunctionList.VFNil },
        fn_count: 1,
        block_count: lowered.vm_fn.block_count,
        inst_count: lowered.vm_fn.instruction_count,
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0,
        error_detail: empty_failure_detail()
    };
}

fn emit_verified_project_ssa_callable_with_sources<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], compiled: project.ProjectResult, target_source_index: u64, target_callable: decl.SemanticIdentity) -> (result: VmEmitResult) {
    if !(compiled.valid) || !(compiled.value_ssa_valid) || compiled.module_count == 0
        || target_source_index >= compiled.source_count || target_source_index >= 64 {
        return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(target_callable, 1, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let closure: project.ProjectImportClosure = project.project_import_closure(compiled.imports, target_source_index, compiled.source_count);
    let inspected: ReachableModulesCheck = inspect_reachable_project_modules(compiled.modules, closure.reachable, target_source_index);
    if !(inspected.all_verified) || !(inspected.target_found) { return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(target_callable, 1, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0)); }
    if inspected.target_header.code != 0 || inspected.target_header.state != 8
        || inspected.target_header.module_end <= inspected.target_header.module_start {
        return emit_failure_detailed(8, 0, 0, 0, phase_failure_detail(target_callable, 2, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    if !(inspected.target_ssa.valid) || inspected.target_ssa.function_count == 0
        || inspected.target_ssa.verified_function_count != inspected.target_ssa.function_count
        || inspected.target_ssa.unsupported_block_count > 0 {
        return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(target_callable, 2, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let all_recs: VmRecordTypeList = collect_reachable_record_types<M, N>(snapshot, flat_pages, compiled.modules, closure.reachable);
    let all_fins: VmFiniteTypeList = collect_reachable_finite_types<M, N>(snapshot, flat_pages, compiled.modules, closure.reachable);
    let schemas: VmSchemas = VmSchemas { records: all_recs, finites: all_fins };
    let root_pages: [[byte; up_to N]; up_to 1024] = project.module_pages<M, N>(snapshot.sources, flat_pages, target_source_index);
    let root_stride: u64 = project.module_stride(snapshot.sources, target_source_index);
    let root_total: u64 = project.module_total(snapshot.sources, target_source_index);
    let root_lowered: FnEmitWalk = lower_target_selected_callable<1024, N>(root_pages, root_stride, root_total, inspected.target_unit, inspected.target_ssa, schemas, target_callable);
    if !(root_lowered.ok) {
        return emit_failure_detailed(root_lowered.error_code, root_lowered.error_function, root_lowered.error_block, root_lowered.error_inst, root_lowered.error_detail);
    }
    let expanded: ProjectClosureWalk = expand_project_vm_closure_with_sources<M, N>(
        snapshot, flat_pages, compiled.modules, closure.reachable, schemas,
        root_lowered.acc, root_lowered.fn_count, root_lowered.block_count, root_lowered.inst_count
    );
    if !(expanded.ok) {
        return emit_failure_detailed(expanded.error_code, expanded.error_function, expanded.error_block, expanded.error_inst, expanded.error_detail);
    }
    let verified_calls: CallVerifyResult = verify_closure_calls(expanded.emitted_rev);
    if !(verified_calls.ok) {
        return emit_failure_detailed(verified_calls.error_code, verified_calls.error_function, verified_calls.error_block, verified_calls.error_inst, verified_calls.error_detail);
    }
    let retained: SchemaUsageState = retain_referenced_schemas(schemas, expanded.emitted_rev);
    return VmEmitResult {
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_instruction: 0,
        error_detail: empty_failure_detail(),
        module_name_start: inspected.target_header.module_start,
        module_name_end: inspected.target_header.module_end,
        record_types: retained.used_recs,
        record_type_count: retained.rec_count,
        finite_types: retained.used_fins,
        finite_type_count: retained.fin_count,
        functions: expanded.emitted_rev,
        function_count: expanded.fn_count,
        block_count: expanded.block_count,
        instruction_count: expanded.inst_count
    };
}

// Compile a multi-module MNCS project natively into verified Project SSA.
fn compile_project_for_emit<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M]) -> (result: project.ProjectResult) {
    return project.compile_project<M, N>(snapshot, flat_pages);
}

// Compile a single target module inside a multi-module MNCS project natively
// into verified Project SSA (retaining all other modules as providers).
fn compile_project_target_for_emit<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], target_source_index: u64) -> (result: project.ProjectResult) {
    return project.compile_project_target<M, N>(snapshot, flat_pages, target_source_index);
}

// Compile a multi-module MNCS project natively (Project -> decl -> flow ->
// verified Value SSA) and emit the verified reachable VM SSA closure for
// `target_source_index` (including concrete Nat specializations, bounded
// byte views, and nominal records).
fn compile_and_emit_project_vm_module<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], target_source_index: u64) -> (result: VmEmitResult) {
    let compiled: project.ProjectResult = project.compile_project<M, N>(snapshot, flat_pages);
    return emit_verified_project_ssa_with_sources<M, N>(snapshot, flat_pages, compiled, target_source_index);
}

// ---------------------------------------------------------------------------
// On-demand provider schema & verified-body handoff for selected callables
// ---------------------------------------------------------------------------

fn parsed_module_list_empty(modules: project.ModuleList) -> (result: bool) {
    return match modules {
        project.ModuleList.MNil => true,
        project.ModuleList.MCons { head: h, tail: t } => false
    };
}

record ContextRecordsWalk {
    rest: project.ModuleList,
    dep_nominals: project.NominalModuleList,
    all_markers: decl.NominalTypeIdentityList,
    reachable: [bool; 64],
    acc: VmRecordTypeList
}
fn collect_context_record_types<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], dep_modules: project.ModuleList, dep_nominals: project.NominalModuleList, reachable: [bool; 64]) -> (result: VmRecordTypeList) {
    let all_markers: decl.NominalTypeIdentityList = project.project_nominal_markers(dep_nominals);
    let initial: ContextRecordsWalk = ContextRecordsWalk {
        rest: dep_modules, dep_nominals: dep_nominals, all_markers: all_markers,
        reachable: reachable, acc: VmRecordTypeList.VRTNil
    };
    iterate i up_to 64 carrying st: ContextRecordsWalk = initial {
        if parsed_module_list_empty(st.rest) { return reverse_vm_record_types(st.acc); }
        next st = collect_context_record_step<M, N>(snapshot, flat_pages, st);
    }
    return reverse_vm_record_types(st.acc);
}
fn collect_context_record_step<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], st: ContextRecordsWalk) -> (result: ContextRecordsWalk) {
    return match st.rest {
        project.ModuleList.MNil => st,
        project.ModuleList.MCons { head: parsed, tail: rest } => collect_context_record_one<M, N>(snapshot, flat_pages, st, parsed, rest)
    };
}
fn collect_context_record_one<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], st: ContextRecordsWalk, parsed: project.ParsedModule, rest: project.ModuleList) -> (result: ContextRecordsWalk) {
    if parsed.source_index >= 64 || !(st.reachable[parsed.source_index]) {
        return ContextRecordsWalk { ..st, rest: rest };
    }
    let pages: [[byte; up_to N]; up_to 1024] = project.module_pages<M, N>(snapshot.sources, flat_pages, parsed.source_index);
    let stride: u64 = project.module_stride(snapshot.sources, parsed.source_index);
    let total: u64 = project.module_total(snapshot.sources, parsed.source_index);
    let facts: project.NominalModuleLookup = project.nominal_module_by_index<M, N>(snapshot.sources, flat_pages, st.dep_nominals, parsed.source_index);
    let noms: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(pages, stride, total, st.all_markers, facts.facts.resolved);
    let next_acc: VmRecordTypeList = collect_module_record_types<1024, N>(pages, stride, total, parsed.unit, noms, st.acc);
    return ContextRecordsWalk { ..st, rest: rest, acc: next_acc };
}

record ContextFinitesWalk {
    rest: project.ModuleList,
    dep_nominals: project.NominalModuleList,
    all_markers: decl.NominalTypeIdentityList,
    reachable: [bool; 64],
    acc: VmFiniteTypeList
}
fn collect_context_finite_types<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], dep_modules: project.ModuleList, dep_nominals: project.NominalModuleList, reachable: [bool; 64]) -> (result: VmFiniteTypeList) {
    let all_markers: decl.NominalTypeIdentityList = project.project_nominal_markers(dep_nominals);
    let initial: ContextFinitesWalk = ContextFinitesWalk {
        rest: dep_modules, dep_nominals: dep_nominals, all_markers: all_markers,
        reachable: reachable, acc: VmFiniteTypeList.VFTNil
    };
    iterate i up_to 64 carrying st: ContextFinitesWalk = initial {
        if parsed_module_list_empty(st.rest) { return reverse_vm_finite_types(st.acc); }
        next st = collect_context_finite_step<M, N>(snapshot, flat_pages, st);
    }
    return reverse_vm_finite_types(st.acc);
}
fn collect_context_finite_step<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], st: ContextFinitesWalk) -> (result: ContextFinitesWalk) {
    return match st.rest {
        project.ModuleList.MNil => st,
        project.ModuleList.MCons { head: parsed, tail: rest } => collect_context_finite_one<M, N>(snapshot, flat_pages, st, parsed, rest)
    };
}
fn collect_context_finite_one<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], st: ContextFinitesWalk, parsed: project.ParsedModule, rest: project.ModuleList) -> (result: ContextFinitesWalk) {
    if parsed.source_index >= 64 || !(st.reachable[parsed.source_index]) {
        return ContextFinitesWalk { ..st, rest: rest };
    }
    let pages: [[byte; up_to N]; up_to 1024] = project.module_pages<M, N>(snapshot.sources, flat_pages, parsed.source_index);
    let stride: u64 = project.module_stride(snapshot.sources, parsed.source_index);
    let total: u64 = project.module_total(snapshot.sources, parsed.source_index);
    let facts: project.NominalModuleLookup = project.nominal_module_by_index<M, N>(snapshot.sources, flat_pages, st.dep_nominals, parsed.source_index);
    let noms: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(pages, stride, total, st.all_markers, facts.facts.resolved);
    let next_acc: VmFiniteTypeList = collect_module_finite_types<1024, N>(pages, stride, total, parsed.unit, noms, st.acc);
    return ContextFinitesWalk { ..st, rest: rest, acc: next_acc };
}

record ProviderCallableLookup { found: bool, source_index: u64, start: u64, end: u64 }
record ProviderCallableSearch {
    rest: project.ModuleList,
    reachable: [bool; 64],
    wanted: decl.SemanticIdentity,
    found: bool,
    source_index: u64,
    start: u64,
    end: u64
}
fn find_provider_source_for_callable<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], dep_modules: project.ModuleList, reachable: [bool; 64], wanted: decl.SemanticIdentity) -> (result: ProviderCallableLookup) {
    let initial: ProviderCallableSearch = ProviderCallableSearch {
        rest: dep_modules, reachable: reachable, wanted: wanted, found: false, source_index: 0, start: 0, end: 0
    };
    iterate i up_to 64 carrying st: ProviderCallableSearch = initial {
        if st.found || parsed_module_list_empty(st.rest) {
            return ProviderCallableLookup { found: st.found, source_index: st.source_index, start: st.start, end: st.end };
        }
        next st = find_provider_source_step<M, N>(snapshot, flat_pages, st);
    }
    return ProviderCallableLookup { found: st.found, source_index: st.source_index, start: st.start, end: st.end };
}
fn find_provider_source_step<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], st: ProviderCallableSearch) -> (result: ProviderCallableSearch) {
    return match st.rest {
        project.ModuleList.MNil => st,
        project.ModuleList.MCons { head: parsed, tail: rest } => find_provider_source_one<M, N>(snapshot, flat_pages, st, parsed, rest)
    };
}
fn find_provider_source_one<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], st: ProviderCallableSearch, parsed: project.ParsedModule, rest: project.ModuleList) -> (result: ProviderCallableSearch) {
    if parsed.source_index >= 64 || !(st.reachable[parsed.source_index]) {
        return ProviderCallableSearch { ..st, rest: rest };
    }
    let pages: [[byte; up_to N]; up_to 1024] = project.module_pages<M, N>(snapshot.sources, flat_pages, parsed.source_index);
    let stride: u64 = project.module_stride(snapshot.sources, parsed.source_index);
    let total: u64 = project.module_total(snapshot.sources, parsed.source_index);
    let decl_lk: FnDeclLookup = find_fn_decl_by_id<1024, N>(pages, stride, total, parsed.unit.header, parsed.unit.fns, st.wanted);
    if decl_lk.found {
        return ProviderCallableSearch {
            rest: project.ModuleList.MNil, reachable: st.reachable, wanted: st.wanted,
            found: true, source_index: parsed.source_index, start: decl_lk.fn_decl.fn_start, end: decl_lk.fn_decl.fn_end
        };
    }
    return ProviderCallableSearch { ..st, rest: rest };
}

record OnDemandClosureWalk {
    loaded_modules: project.ProjectModuleList,
    provider_schemas: project.TargetSchemaState,
    has_provider_schemas: bool,
    emitted_rev: VmFunctionList,
    pending: PendingSpecList,
    fn_count: u64,
    block_count: u64,
    inst_count: u64,
    ok: bool,
    error_code: u64,
    error_function: u64,
    error_block: u64,
    error_inst: u64,
    error_detail: VmEmitFailureDetail
}
fn project_module_verified_for_emit(mod_item: project.ProjectModule) -> (result: bool) {
    return mod_item.flow.valid && mod_item.flow.proof.ok
        && mod_item.value_ssa.valid
        && mod_item.value_ssa.verified_function_count == mod_item.value_ssa.function_count
        && mod_item.value_ssa.unsupported_block_count == 0;
}
fn expand_project_vm_closure_on_demand<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: project.SelectedProjectContext, schemas: VmSchemas, root_fns: VmFunctionList, root_fn_count: u64, root_block_count: u64, root_inst_count: u64) -> (result: OnDemandClosureWalk) {
    let seeded_pending: PendingSpecList = collect_fns_callees_in_order(root_fns);
    let initial: OnDemandClosureWalk = OnDemandClosureWalk {
        loaded_modules: ctx.result.modules,
        provider_schemas: project.TargetSchemaState {
            wanted_markers: decl.NominalTypeIdentityList.NINil,
            records: decl.ImportedRecordList.IRNil, enums: decl.ImportedEnumList.IENil, changed: false
        },
        has_provider_schemas: false,
        emitted_rev: reverse_vm_fns(root_fns),
        pending: seeded_pending,
        fn_count: root_fn_count, block_count: root_block_count, inst_count: root_inst_count,
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0,
        error_detail: empty_failure_detail()
    };
    iterate step up_to 256 carrying st: OnDemandClosureWalk = initial {
        if !(st.ok) || pending_spec_list_empty(st.pending) {
            return OnDemandClosureWalk { ..st, emitted_rev: reverse_vm_fns(st.emitted_rev) };
        }
        next st = expand_project_vm_closure_od_step<M, N>(snapshot, flat_pages, ctx, schemas, st);
    }
    return OnDemandClosureWalk {
        ..st, emitted_rev: reverse_vm_fns(st.emitted_rev),
        ok: st.ok && pending_spec_list_empty(st.pending),
        error_code: select(st.ok && !(pending_spec_list_empty(st.pending)), 9, st.error_code)
    };
}
fn expand_project_vm_closure_od_step<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: project.SelectedProjectContext, schemas: VmSchemas, st: OnDemandClosureWalk) -> (result: OnDemandClosureWalk) {
    return match st.pending {
        PSNil => st,
        PSCons { head: spec_key, tail: rest } => expand_project_vm_closure_od_one<M, N>(snapshot, flat_pages, ctx, schemas, st, spec_key, rest)
    };
}
fn expand_project_vm_closure_od_one<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: project.SelectedProjectContext, schemas: VmSchemas, st: OnDemandClosureWalk, spec_key: VmSpecKey, rest: PendingSpecList) -> (result: OnDemandClosureWalk) {
    let existing: VmFnLookup = find_vm_fn_by_spec(st.emitted_rev, spec_key);
    if existing.found { return OnDemandClosureWalk { ..st, pending: rest }; }
    let located: ReachableSsaFnLookup = find_ssa_fn_in_reachable_modules(st.loaded_modules, ctx.reachable, spec_key.identity);
    if located.found {
        return lower_od_located_callee<M, N>(snapshot, flat_pages, schemas, st, spec_key, rest, located);
    }
    let prov: ProviderCallableLookup = find_provider_source_for_callable<M, N>(snapshot, flat_pages, ctx.dependency_modules, ctx.reachable, spec_key.identity);
    if !(prov.found) {
        return OnDemandClosureWalk { ..st, pending: PendingSpecList.PSNil, ok: false, error_code: 9, error_function: st.fn_count, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(spec_key.identity, 12, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    let ready: OnDemandClosureWalk = prepare_provider_schemas<M, N>(snapshot, flat_pages, ctx, st);
    let built: project.MaterializedProviderBuild = project.materialize_provider_callable<M, N>(snapshot, flat_pages, ctx, ready.provider_schemas, prov.source_index, prov.start, prov.end);
    if !(built.ok) {
        return OnDemandClosureWalk { ..ready, pending: PendingSpecList.PSNil, ok: false, error_code: 1, error_function: st.fn_count, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(spec_key.identity, 12, 0, 0, 0, decl.invalid_semantic_identity(), built.start, built.end) };
    }
    return attach_and_lower_od_provider<M, N>(snapshot, flat_pages, ctx, schemas, ready, spec_key, rest, built.modules);
}
fn prepare_provider_schemas<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: project.SelectedProjectContext, st: OnDemandClosureWalk) -> (result: OnDemandClosureWalk) {
    if st.has_provider_schemas { return st; }
    let schemas: project.TargetSchemaState = project.project_provider_schemas<M, N>(snapshot, flat_pages, ctx);
    return OnDemandClosureWalk { ..st, provider_schemas: schemas, has_provider_schemas: true };
}
fn attach_and_lower_od_provider<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: project.SelectedProjectContext, schemas: VmSchemas, st: OnDemandClosureWalk, spec_key: VmSpecKey, rest: PendingSpecList, built_modules: project.ProjectModuleList) -> (result: OnDemandClosureWalk) {
    return match built_modules {
        project.ProjectModuleList.PNil => OnDemandClosureWalk { ..st, pending: PendingSpecList.PSNil, ok: false, error_code: 1, error_function: st.fn_count, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(spec_key.identity, 12, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) },
        project.ProjectModuleList.PCons { head: mod_item, tail: ignored_tail } => attach_and_lower_od_provider_one<M, N>(snapshot, flat_pages, ctx, schemas, st, spec_key, rest, mod_item)
    };
}
fn attach_and_lower_od_provider_one<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: project.SelectedProjectContext, schemas: VmSchemas, st: OnDemandClosureWalk, spec_key: VmSpecKey, rest: PendingSpecList, mod_item: project.ProjectModule) -> (result: OnDemandClosureWalk) {
    if !(project_module_verified_for_emit(mod_item)) {
        return OnDemandClosureWalk { ..st, pending: PendingSpecList.PSNil, ok: false, error_code: 1, error_function: st.fn_count, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(spec_key.identity, 12, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    let next_loaded: project.ProjectModuleList = project.ProjectModuleList.PCons { head: mod_item, tail: st.loaded_modules };
    let updated_st: OnDemandClosureWalk = OnDemandClosureWalk { ..st, loaded_modules: next_loaded };
    let located: ReachableSsaFnLookup = find_ssa_fn_in_reachable_modules(project.ProjectModuleList.PCons { head: mod_item, tail: project.ProjectModuleList.PNil }, ctx.reachable, spec_key.identity);
    if !(located.found) {
        return OnDemandClosureWalk { ..updated_st, pending: PendingSpecList.PSNil, ok: false, error_code: 9, error_function: st.fn_count, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(spec_key.identity, 12, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    return lower_od_located_callee<M, N>(snapshot, flat_pages, schemas, updated_st, spec_key, rest, located);
}
fn lower_od_located_callee<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], schemas: VmSchemas, st: OnDemandClosureWalk, spec_key: VmSpecKey, rest: PendingSpecList, located: ReachableSsaFnLookup) -> (result: OnDemandClosureWalk) {
    let pages: [[byte; up_to N]; up_to 1024] = project.module_pages<M, N>(snapshot.sources, flat_pages, located.source_index);
    let stride: u64 = project.module_stride(snapshot.sources, located.source_index);
    let total: u64 = project.module_total(snapshot.sources, located.source_index);
    let decl_lk: FnDeclLookup = find_fn_decl_by_id<1024, N>(pages, stride, total, located.unit.header, located.unit.fns, located.func.identity);
    if !(decl_lk.found) {
        return OnDemandClosureWalk { ..st, pending: PendingSpecList.PSNil, ok: false, error_code: 2, error_function: st.fn_count, error_block: 0, error_inst: 0, error_detail: phase_failure_detail(located.func.identity, 3, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0) };
    }
    let lowered: SingleFnLowerResult = lower_ssa_fn_specialized_with_schemas<1024, N>(pages, stride, total, located.func, decl_lk.fn_decl, spec_key.nat_args, schemas);
    if !(lowered.ok) {
        return OnDemandClosureWalk { ..st, pending: PendingSpecList.PSNil, ok: false, error_code: lowered.error_code, error_function: st.fn_count, error_block: lowered.error_block, error_inst: lowered.error_inst, error_detail: lowered.error_detail };
    }
    let child_callees: PendingSpecList = collect_fn_callees_in_order(lowered.vm_fn);
    return OnDemandClosureWalk {
        ..st,
        emitted_rev: VmFunctionList.VFCons { head: lowered.vm_fn, tail: st.emitted_rev },
        pending: append_pending_specs(rest, child_callees),
        fn_count: st.fn_count + 1,
        block_count: st.block_count + lowered.vm_fn.block_count,
        inst_count: st.inst_count + lowered.vm_fn.instruction_count,
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_inst: 0,
        error_detail: empty_failure_detail()
    };
}

fn emit_verified_selected_project_callable<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: project.SelectedProjectContext, target_source_index: u64, target_callable: decl.SemanticIdentity) -> (result: VmEmitResult) {
    let compiled: project.ProjectResult = ctx.result;
    if !(compiled.valid) || !(compiled.value_ssa_valid) || compiled.module_count == 0
        || target_source_index >= compiled.source_count || target_source_index >= 64 {
        return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(target_callable, 1, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let inspected: ReachableModulesCheck = inspect_reachable_project_modules(compiled.modules, ctx.reachable, target_source_index);
    if !(inspected.all_verified) || !(inspected.target_found) { return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(target_callable, 1, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0)); }
    if inspected.target_header.code != 0 || inspected.target_header.state != 8
        || inspected.target_header.module_end <= inspected.target_header.module_start {
        return emit_failure_detailed(8, 0, 0, 0, phase_failure_detail(target_callable, 2, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    if !(inspected.target_ssa.valid) || inspected.target_ssa.function_count == 0
        || inspected.target_ssa.verified_function_count != inspected.target_ssa.function_count
        || inspected.target_ssa.unsupported_block_count > 0 {
        return emit_failure_detailed(1, 0, 0, 0, phase_failure_detail(target_callable, 2, 0, 0, 0, decl.invalid_semantic_identity(), 0, 0));
    }
    let all_recs: VmRecordTypeList = collect_context_record_types<M, N>(snapshot, flat_pages, ctx.dependency_modules, ctx.dependency_nominal_modules, ctx.reachable);
    let all_fins: VmFiniteTypeList = collect_context_finite_types<M, N>(snapshot, flat_pages, ctx.dependency_modules, ctx.dependency_nominal_modules, ctx.reachable);
    let schemas: VmSchemas = VmSchemas { records: all_recs, finites: all_fins };
    let root_pages: [[byte; up_to N]; up_to 1024] = project.module_pages<M, N>(snapshot.sources, flat_pages, target_source_index);
    let root_stride: u64 = project.module_stride(snapshot.sources, target_source_index);
    let root_total: u64 = project.module_total(snapshot.sources, target_source_index);
    let root_lowered: FnEmitWalk = lower_target_selected_callable<1024, N>(root_pages, root_stride, root_total, inspected.target_unit, inspected.target_ssa, schemas, target_callable);
    if !(root_lowered.ok) {
        return emit_failure_detailed(root_lowered.error_code, root_lowered.error_function, root_lowered.error_block, root_lowered.error_inst, root_lowered.error_detail);
    }
    let expanded: OnDemandClosureWalk = expand_project_vm_closure_on_demand<M, N>(
        snapshot, flat_pages, ctx, schemas,
        root_lowered.acc, root_lowered.fn_count, root_lowered.block_count, root_lowered.inst_count
    );
    if !(expanded.ok) {
        return emit_failure_detailed(expanded.error_code, expanded.error_function, expanded.error_block, expanded.error_inst, expanded.error_detail);
    }
    let verified_calls: CallVerifyResult = verify_closure_calls(expanded.emitted_rev);
    if !(verified_calls.ok) {
        return emit_failure_detailed(verified_calls.error_code, verified_calls.error_function, verified_calls.error_block, verified_calls.error_inst, verified_calls.error_detail);
    }
    let retained: SchemaUsageState = retain_referenced_schemas(schemas, expanded.emitted_rev);
    return VmEmitResult {
        ok: true, error_code: 0, error_function: 0, error_block: 0, error_instruction: 0,
        error_detail: empty_failure_detail(),
        module_name_start: inspected.target_header.module_start,
        module_name_end: inspected.target_header.module_end,
        record_types: retained.used_recs,
        record_type_count: retained.rec_count,
        finite_types: retained.used_fins,
        finite_type_count: retained.fin_count,
        functions: expanded.emitted_rev,
        function_count: expanded.fn_count,
        block_count: expanded.block_count,
        instruction_count: expanded.inst_count
    };
}

// Compile a target module inside a multi-module MNCS project natively into
// verified Value SSA and emit only `target_callable` plus its verified
// reachable callees, materializing provider schemas and bodies on demand.
fn compile_and_emit_project_vm_callable<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], target_source_index: u64, target_callable: decl.SemanticIdentity) -> (result: VmEmitResult) {
    let ctx: project.SelectedProjectContext = project.compile_project_target_with_context<M, N>(snapshot, flat_pages, target_source_index);
    return emit_verified_selected_project_callable<M, N>(snapshot, flat_pages, ctx, target_source_index, target_callable);
}

// Whole-project differential control: compiles every module eagerly via
// `project.compile_project` and selects `target_callable` + reachable callees.
fn compile_and_emit_project_vm_callable_whole_project<M: Nat, N: Nat>(snapshot: project.ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], target_source_index: u64, target_callable: decl.SemanticIdentity) -> (result: VmEmitResult) {
    let compiled: project.ProjectResult = project.compile_project<M, N>(snapshot, flat_pages);
    return emit_verified_project_ssa_callable_with_sources<M, N>(snapshot, flat_pages, compiled, target_source_index, target_callable);
}
