        if byte_at(s0, s1, s2, s3, total, start + 0) == 109 && byte_at(s0, s1, s2, s3, total, start + 1) == 101 && byte_at(s0, s1, s2, s3, total, start + 2) == 116 && byte_at(s0, s1, s2, s3, total, start + 3) == 97 && byte_at(s0, s1, s2, s3, total, start + 4) == 109 && byte_at(s0, s1, s2, s3, total, start + 5) == 111 && byte_at(s0, s1, s2, s3, total, start + 6) == 114 && byte_at(s0, s1, s2, s3, total, start + 7) == 112 && byte_at(s0, s1, s2, s3, total, start + 8) == 104 && byte_at(s0, s1, s2, s3, total, start + 9) == 105 && byte_at(s0, s1, s2, s3, total, start + 10) == 99 { return 23; }
    }
    if end - start == 6 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 101 && byte_at(s0, s1, s2, s3, total, start + 1) == 102 && byte_at(s0, s1, s2, s3, total, start + 2) == 102 && byte_at(s0, s1, s2, s3, total, start + 3) == 101 && byte_at(s0, s1, s2, s3, total, start + 4) == 99 && byte_at(s0, s1, s2, s3, total, start + 5) == 116 { return 24; }
    }
    if end - start == 10 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 99 && byte_at(s0, s1, s2, s3, total, start + 1) == 97 && byte_at(s0, s1, s2, s3, total, start + 2) == 112 && byte_at(s0, s1, s2, s3, total, start + 3) == 97 && byte_at(s0, s1, s2, s3, total, start + 4) == 98 && byte_at(s0, s1, s2, s3, total, start + 5) == 105 && byte_at(s0, s1, s2, s3, total, start + 6) == 108 && byte_at(s0, s1, s2, s3, total, start + 7) == 105 && byte_at(s0, s1, s2, s3, total, start + 8) == 116 && byte_at(s0, s1, s2, s3, total, start + 9) == 121 { return 25; }
    }
    if end - start == 13 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 97 && byte_at(s0, s1, s2, s3, total, start + 1) == 117 && byte_at(s0, s1, s2, s3, total, start + 2) == 116 && byte_at(s0, s1, s2, s3, total, start + 3) == 104 && byte_at(s0, s1, s2, s3, total, start + 4) == 111 && byte_at(s0, s1, s2, s3, total, start + 5) == 114 && byte_at(s0, s1, s2, s3, total, start + 6) == 105 && byte_at(s0, s1, s2, s3, total, start + 7) == 122 && byte_at(s0, s1, s2, s3, total, start + 8) == 101 && byte_at(s0, s1, s2, s3, total, start + 9) == 100 && byte_at(s0, s1, s2, s3, total, start + 10) == 95 && byte_at(s0, s1, s2, s3, total, start + 11) == 98 && byte_at(s0, s1, s2, s3, total, start + 12) == 121 { return 26; }
    }
    if end - start == 4 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 101 && byte_at(s0, s1, s2, s3, total, start + 1) == 110 && byte_at(s0, s1, s2, s3, total, start + 2) == 117 && byte_at(s0, s1, s2, s3, total, start + 3) == 109 { return 27; }
    }
    if end - start == 3 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 117 && byte_at(s0, s1, s2, s3, total, start + 1) == 115 && byte_at(s0, s1, s2, s3, total, start + 2) == 101 { return 28; }
    }
    if end - start == 6 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 114 && byte_at(s0, s1, s2, s3, total, start + 1) == 101 && byte_at(s0, s1, s2, s3, total, start + 2) == 99 && byte_at(s0, s1, s2, s3, total, start + 3) == 111 && byte_at(s0, s1, s2, s3, total, start + 4) == 114 && byte_at(s0, s1, s2, s3, total, start + 5) == 100 { return 29; }
