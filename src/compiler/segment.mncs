mncs 0.18;
module mncs.compiler.segment.v1;
use mncs.compiler.source.v1 as source;
use mncs.compiler.lexer.v1 as lexer;

// The old four-buffer segmenter duplicated lexer semantics and capped
// project source at 256 bytes. This module now supplies the stable compiler
// cursor surface over a generic bounded source view and delegates token rules
// to the single lexer implementation.
fn byte_at<N: Nat>(text: [byte; up_to N], offset: u64) -> (result: u64) {
    return source.byte_at<N>(text, offset);
}

fn ascii<N: Nat>(text: [byte; up_to N]) -> (result: bool) {
    return source.ascii<N>(text);
}

fn span_valid<N: Nat>(text: [byte; up_to N], start: u64, end: u64) -> (result: bool) {
    return source.span_valid<N>(text, start, end);
}

fn next_token<N: Nat>(text: [byte; up_to N], start: u64) -> (result: lexer.Token) {
    return lexer.next_token<N>(text, start);
}

fn significant<N: Nat>(text: [byte; up_to N], start: u64) -> (result: lexer.Token) {
    return lexer.significant<N>(text, start);
}

// Logical-source cursor surface (CP-0001): the same stable surface over
// global offsets into a validated page composition. Token rules stay in the
// single lexer implementation; validation, identity, and rendering stay in
// the source module and are called there directly.
fn byte_at_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offset: u64) -> (result: u64) {
    return source.byte_at_global<P, N>(pages, stride, total, offset);
}

fn ascii_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    return source.ascii_global<P, N>(pages, stride, total);
}

fn span_valid_global(total: u64, start: u64, end: u64) -> (result: bool) {
    return source.span_valid_global(total, start, end);
}

fn next_token_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64) -> (result: lexer.Token) {
    return lexer.next_token_global<P, N>(pages, stride, total, start);
}

fn significant_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64) -> (result: lexer.Token) {
    return lexer.significant_global<P, N>(pages, stride, total, start);
}

fn lex_batch_from<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64) -> (result: lexer.BatchResult) {
    return lexer.lex_tokens_from<P, N>(pages, stride, total, start);
}
