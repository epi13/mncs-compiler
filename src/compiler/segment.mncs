    }
    if end - start == 8 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 99 && byte_at(s0, s1, s2, s3, total, start + 1) == 97 && byte_at(s0, s1, s2, s3, total, start + 2) == 114 && byte_at(s0, s1, s2, s3, total, start + 3) == 114 && byte_at(s0, s1, s2, s3, total, start + 4) == 121 && byte_at(s0, s1, s2, s3, total, start + 5) == 105 && byte_at(s0, s1, s2, s3, total, start + 6) == 110 && byte_at(s0, s1, s2, s3, total, start + 7) == 103 { return 33; }
    }
