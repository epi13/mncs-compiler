mncs 0.13;
module mncs.compiler.segment.v1;
use mncs.compiler.source.v1 as source;
use mncs.compiler.lexer.v1 as lexer;

// Logical bounded source: the concatenation of four exact caller-supplied
// chunks with a caller-declared total length. Offsets in every compiler
// request below are absolute offsets into this logical source.
//
// This is a deliberately bounded bootstrap/fragment representation, not the
// intended whole-module source API (see CP-0001). The single-chunk
// `source`/`lexer` modules remain the tested primitive path; this module
// mirrors their exact semantics over absolute offsets so declaration-scale
// programs (up to 256 bytes) can pressure deeper compiler layers while the
// upstream storage pressure stays open and honestly labeled.

// The total must not exceed the bytes the caller actually supplied.
fn total_valid(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64) -> (result: bool) {
    return total <= s0.len + s1.len + s2.len + s3.len;
}

// Absolute byte fetch. Out-of-range reads yield sentinel 256, mirroring
// `source.byte_at`: the sentinel is distinct from every byte value.
fn byte_at(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, offset: u64) -> (result: u64) {
    if offset >= total {
        return 256;
    }
    let l0: u64 = s0.len;
    let l1: u64 = s1.len;
    let l2: u64 = s2.len;
    if offset < l0 {
        return source.byte_at(s0, offset);
    }
    if offset < l0 + l1 {
        return source.byte_at(s1, offset - l0);
    }
    if offset < l0 + l1 + l2 {
        return source.byte_at(s2, offset - l0 - l1);
    }
    return source.byte_at(s3, offset - l0 - l1 - l2);
}

record AsciiState { valid: bool, index: u64 }
fn ascii_step(total: u64, st: AsciiState, byte: u64) -> (result: AsciiState) {
    if st.index >= total { return AsciiState { valid: st.valid, index: st.index + 1 }; }
    return AsciiState { valid: st.valid && byte < 128, index: st.index + 1 };
}

fn ascii(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64) -> (result: bool) {
    // Sequential links reuse one index name (profile 0.13 records them
    // hygienically); the chunk is named by the `over` sequence.
    iterate i over s0 carrying a: AsciiState = AsciiState { valid: true, index: 0 } {
        next a = ascii_step(total, a, source.byte_at(s0, i) as u64);
    }
    iterate i over s1 carrying b: AsciiState = a {
        next b = ascii_step(total, b, source.byte_at(s1, i) as u64);
    }
    iterate i over s2 carrying c: AsciiState = b {
        next c = ascii_step(total, c, source.byte_at(s2, i) as u64);
    }
    iterate i over s3 carrying d: AsciiState = c {
        next d = ascii_step(total, d, source.byte_at(s3, i) as u64);
    }
    return d.valid;
}

fn span_valid(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64) -> (result: bool) {
    return start <= end && end <= total;
}

// Word classification over absolute offsets. Mirrors `lexer.keyword`
// exactly; duplicated because the single-chunk fetch cannot cross chunk
// boundaries. Any divergence from `lexer.keyword` is a compiler bug.
fn keyword(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64, end: u64) -> (result: u64) {
    if end - start == 4 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 109 && byte_at(s0, s1, s2, s3, total, start + 1) == 110 && byte_at(s0, s1, s2, s3, total, start + 2) == 99 && byte_at(s0, s1, s2, s3, total, start + 3) == 115 { return 10; }
    }
    if end - start == 6 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 109 && byte_at(s0, s1, s2, s3, total, start + 1) == 111 && byte_at(s0, s1, s2, s3, total, start + 2) == 100 && byte_at(s0, s1, s2, s3, total, start + 3) == 117 && byte_at(s0, s1, s2, s3, total, start + 4) == 108 && byte_at(s0, s1, s2, s3, total, start + 5) == 101 { return 11; }
    }
    if end - start == 2 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 102 && byte_at(s0, s1, s2, s3, total, start + 1) == 110 { return 12; }
    }
    if end - start == 6 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 114 && byte_at(s0, s1, s2, s3, total, start + 1) == 101 && byte_at(s0, s1, s2, s3, total, start + 2) == 116 && byte_at(s0, s1, s2, s3, total, start + 3) == 117 && byte_at(s0, s1, s2, s3, total, start + 4) == 114 && byte_at(s0, s1, s2, s3, total, start + 5) == 110 { return 13; }
    }
    if end - start == 3 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 108 && byte_at(s0, s1, s2, s3, total, start + 1) == 101 && byte_at(s0, s1, s2, s3, total, start + 2) == 116 { return 14; }
    }
    if end - start == 2 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 105 && byte_at(s0, s1, s2, s3, total, start + 1) == 102 { return 15; }
    }
    if end - start == 4 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 101 && byte_at(s0, s1, s2, s3, total, start + 1) == 108 && byte_at(s0, s1, s2, s3, total, start + 2) == 115 && byte_at(s0, s1, s2, s3, total, start + 3) == 101 { return 16; }
    }
    if end - start == 4 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 102 && byte_at(s0, s1, s2, s3, total, start + 1) == 97 && byte_at(s0, s1, s2, s3, total, start + 2) == 105 && byte_at(s0, s1, s2, s3, total, start + 3) == 108 { return 17; }
    }
    if end - start == 8 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 114 && byte_at(s0, s1, s2, s3, total, start + 1) == 101 && byte_at(s0, s1, s2, s3, total, start + 2) == 113 && byte_at(s0, s1, s2, s3, total, start + 3) == 117 && byte_at(s0, s1, s2, s3, total, start + 4) == 105 && byte_at(s0, s1, s2, s3, total, start + 5) == 114 && byte_at(s0, s1, s2, s3, total, start + 6) == 101 && byte_at(s0, s1, s2, s3, total, start + 7) == 115 { return 18; }
    }
    if end - start == 7 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 101 && byte_at(s0, s1, s2, s3, total, start + 1) == 110 && byte_at(s0, s1, s2, s3, total, start + 2) == 115 && byte_at(s0, s1, s2, s3, total, start + 3) == 117 && byte_at(s0, s1, s2, s3, total, start + 4) == 114 && byte_at(s0, s1, s2, s3, total, start + 5) == 101 && byte_at(s0, s1, s2, s3, total, start + 6) == 115 { return 19; }
    }
    if end - start == 7 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 97 && byte_at(s0, s1, s2, s3, total, start + 1) == 115 && byte_at(s0, s1, s2, s3, total, start + 2) == 115 && byte_at(s0, s1, s2, s3, total, start + 3) == 117 && byte_at(s0, s1, s2, s3, total, start + 4) == 109 && byte_at(s0, s1, s2, s3, total, start + 5) == 101 && byte_at(s0, s1, s2, s3, total, start + 6) == 115 { return 20; }
    }
    if end - start == 8 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 112 && byte_at(s0, s1, s2, s3, total, start + 1) == 114 && byte_at(s0, s1, s2, s3, total, start + 2) == 111 && byte_at(s0, s1, s2, s3, total, start + 3) == 112 && byte_at(s0, s1, s2, s3, total, start + 4) == 101 && byte_at(s0, s1, s2, s3, total, start + 5) == 114 && byte_at(s0, s1, s2, s3, total, start + 6) == 116 && byte_at(s0, s1, s2, s3, total, start + 7) == 121 { return 21; }
    }
    if end - start == 9 {
        if byte_at(s0, s1, s2, s3, total, start + 0) == 105 && byte_at(s0, s1, s2, s3, total, start + 1) == 110 && byte_at(s0, s1, s2, s3, total, start + 2) == 118 && byte_at(s0, s1, s2, s3, total, start + 3) == 97 && byte_at(s0, s1, s2, s3, total, start + 4) == 114 && byte_at(s0, s1, s2, s3, total, start + 5) == 105 && byte_at(s0, s1, s2, s3, total, start + 6) == 97 && byte_at(s0, s1, s2, s3, total, start + 7) == 110 && byte_at(s0, s1, s2, s3, total, start + 8) == 116 { return 22; }
    }
