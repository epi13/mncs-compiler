mncs 0.18;
module mncs.compiler.segment.v1;
use mncs.compiler.source.v1 as source;
use mncs.compiler.lexer.v1 as lexer;

// The old four-buffer segmenter duplicated lexer semantics and capped
// project source at 256 bytes. This module now supplies the stable compiler
// cursor surface over a generic bounded source view and delegates token rules
// to the single lexer implementation.
fn byte_at<N: Nat>(text: [byte; up_to N], offset: u64) -> (result: u64) {
    return source.byte_at<N>(text, offset);
}

fn ascii<N: Nat>(text: [byte; up_to N]) -> (result: bool) {
    return source.ascii<N>(text);
}

fn span_valid<N: Nat>(text: [byte; up_to N], start: u64, end: u64) -> (result: bool) {
    return source.span_valid<N>(text, start, end);
}

fn next_token<N: Nat>(text: [byte; up_to N], start: u64) -> (result: lexer.Token) {
    return lexer.next_token<N>(text, start);
}

fn significant<N: Nat>(text: [byte; up_to N], start: u64) -> (result: lexer.Token) {
    return lexer.significant<N>(text, start);
}
