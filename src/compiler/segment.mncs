// One scan advance over absolute offsets. Mirrors `lexer.scan_step`; the
// sentinel 256 never satisfies a byte continuation, and `st.end >= total`
// freezes the scan exactly like the single-chunk EOF guard.
fn scan_step(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: lexer.Scan, line: bool, block: bool, word: bool, number: bool, ws: bool) -> (result: lexer.Scan) {
    if st.done || st.end >= total { return st; }
    let a: u64 = byte_at(s0, s1, s2, s3, total, st.end);
    let b: u64 = byte_at(s0, s1, s2, s3, total, st.end + 1);
    if block {
        if a == 47 && b == 42 { return lexer.Scan { ..st, end: st.end + 2, depth: st.depth + 1 }; }
        if a == 42 && b == 47 { return lexer.Scan { ..st, end: st.end + 2, depth: st.depth - 1, done: st.depth == 1 }; }
        return lexer.Scan { ..st, end: st.end + 1 };
    }
    // Preserve Stage-0's unusual continuation of dots after the first version dot.
    let dot: bool = number && a == 46 && (st.dotted || lexer.digit(b));
    let advance: bool = (line && a != 10) || (word && (lexer.letter(a) || lexer.digit(a))) || (number && (lexer.digit(a) || dot)) || (ws && lexer.space(a));
    return lexer.Scan { ..st, end: st.end + select(advance, 1, 0), dotted: st.dotted || dot, done: !advance };
}

fn scan_fuel(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, st: lexer.Scan, line: bool, block: bool, word: bool, number: bool, ws: bool) -> (result: lexer.Scan) {
    iterate i over s0 carrying a: lexer.Scan = st {
        next a = scan_step(s0, s1, s2, s3, total, a, line, block, word, number, ws);
    }
    iterate i over s1 carrying b: lexer.Scan = a {
        next b = scan_step(s0, s1, s2, s3, total, b, line, block, word, number, ws);
    }
    iterate i over s2 carrying c: lexer.Scan = b {
        next c = scan_step(s0, s1, s2, s3, total, c, line, block, word, number, ws);
    }
    iterate i over s3 carrying d: lexer.Scan = c {
        next d = scan_step(s0, s1, s2, s3, total, d, line, block, word, number, ws);
    }
    return d;
}

// Absolute-offset twin of `lexer.next_token` with identical kind and
// diagnostic rules. Spans are absolute logical-source offsets.
fn next_token(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64) -> (result: lexer.Token) {
    if start > total { return lexer.Token { kind: 0, start: total, end: total, diagnostic: 4 }; }
    if start == total { return lexer.Token { kind: 0, start: start, end: start, diagnostic: 0 }; }
    let a: u64 = byte_at(s0, s1, s2, s3, total, start);
    let b: u64 = byte_at(s0, s1, s2, s3, total, start + 1);
    if a >= 128 { return lexer.Token { kind: 7, start: start, end: start + 1, diagnostic: 3 }; }
    let line: bool = a == 47 && b == 47;
    let block: bool = a == 47 && b == 42;
    let word: bool = lexer.letter(a);
    let number: bool = lexer.digit(a);
    let ws: bool = lexer.space(a);
    if line || block || word || number || ws {
        let seed: lexer.Scan = lexer.Scan { end: start + select(line || block, 2, 1), depth: select(block, 1, 0), dotted: false, done: false };
        let st: lexer.Scan = scan_fuel(s0, s1, s2, s3, total, seed, line, block, word, number, ws);
        let kind: u64 = select(ws, 1, select(line, 2, select(block, 3, select(word, keyword(s0, s1, s2, s3, total, start, st.end), select(st.dotted, 6, 5)))));
        return lexer.Token { kind: kind, start: start, end: st.end, diagnostic: select(block && st.depth > 0, 1, 0) };
    }
    let kind: u64 = lexer.punctuation(a, b);
    return lexer.Token { kind: kind, start: start, end: start + select(kind >= 80, 2, 1), diagnostic: select(kind == 7, 2, 0) };
}

// Significant-token request over absolute offsets; lexical failure is never
// discarded as trivia. Mirrors `lexer.significant`.
fn significant(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, start: u64) -> (result: lexer.Token) {
    let first: lexer.Token = next_token(s0, s1, s2, s3, total, start);
    iterate i over s0 carrying a: lexer.Token = first {
        next a = skip_trivia(s0, s1, s2, s3, total, a);
    }
    iterate i over s1 carrying b: lexer.Token = a {
        next b = skip_trivia(s0, s1, s2, s3, total, b);
    }
    iterate i over s2 carrying c: lexer.Token = b {
        next c = skip_trivia(s0, s1, s2, s3, total, c);
    }
    iterate i over s3 carrying d: lexer.Token = c {
        next d = skip_trivia(s0, s1, s2, s3, total, d);
    }
    return d;
}

fn skip_trivia(s0: [byte; up_to 64], s1: [byte; up_to 64], s2: [byte; up_to 64], s3: [byte; up_to 64], total: u64, token: lexer.Token) -> (result: lexer.Token) {
    if token.kind >= 1 && token.kind <= 3 && token.diagnostic == 0 { return next_token(s0, s1, s2, s3, total, token.end); }
    return token;
}
