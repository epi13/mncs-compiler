mncs 0.18;
module mncs.compiler.flow.v1;
use mncs.compiler.decl.v1 as decl;

// Control-flow lowering for the declaration/semantic vertical. Each block
// retains the typed postfix expression operations produced and verified by
// decl.prove_unit, alongside explicit branch/jump/return/failure edges. The
// verifier is limited to statement forms admitted by decl.mncs today.


// kind: 0 open builder, 1 branch, 2 jump, 3 return, 4 fail. `instructions`
// counts retained typed-stack operations in `expressions`.
// role: 1 let-value, 2 branch condition, 3 returned value.
record TypedExpr { role: u64, start: u64, end: u64, binding_start: u64, binding_end: u64, ops: decl.TOpList, op_count: u64 }
enum TypedExprList { ENil, ECons { head: TypedExpr, tail: TypedExprList } }
record TypedExprRev { rest: TypedExprList, acc: TypedExprList }
record Block {
    id: u64,
    kind: u64,
    term_start: u64,
    term_end: u64,
    succ0: u64,
    succ1: u64,
    succ_count: u64,
    instructions: u64,
    expressions: TypedExprList,
    reachable: bool,
    is_join: bool
}
enum BlockList { BNil, BCons { head: Block, tail: BlockList } }
record BlockRev { rest: BlockList, acc: BlockList }

record FlowFrame {
    next: decl.StmtList,
    else_body: decl.StmtList,
    else_id: u64,
    join_id: u64,
    phase: u64,
    parent_live: bool,
    then_falls: bool
}
enum FlowFrames { FNil, FCons { head: FlowFrame, tail: FlowFrames } }

record Diagnostic { code: u64, start: u64, end: u64 }
enum DiagnosticList { DNil, DCons { head: Diagnostic, tail: DiagnosticList } }
record DiagRev { rest: DiagnosticList, acc: DiagnosticList }

record Build {
    rest: decl.StmtList,
    typed_rest: decl.TopsList,
    frames: FlowFrames,
    current: Block,
    blocks: BlockList,
    diagnostics: DiagnosticList,
    next_id: u64,
    done: bool,
    ok: bool,
    fn_start: u64,
    fn_end: u64,
    source_end: u64,
    tail: decl.Expr,
    has_tail: bool
}

record TargetCheck { rest: BlockList, limit: u64, ok: bool }
record BlockCount { rest: BlockList, count: u64 }
record DiagCount { rest: DiagnosticList, count: u64 }
record FunctionFlow {
    fn_start: u64,
    fn_end: u64,
    entry: u64,
    blocks: BlockList,
    block_count: u64,
    unreachable_joins: u64,
    verified: bool
}
enum FunctionList { QNil, QCons { head: FunctionFlow, tail: FunctionList } }
record FnWalk {
    rest: decl.FnList,
    typed_rest: decl.TopsList,
    acc: FunctionList,
    diagnostics: DiagnosticList,
    block_count: u64,
    ok: bool
}
record FnRev { rest: FunctionList, acc: FunctionList }
record LoweredUnit {
    valid: bool,
    graph_ok: bool,
    proof: decl.UnitProve,
    functions: FunctionList,
    diagnostics: DiagnosticList,
    block_count: u64
}

// Narrow accessors used by the value-SSA consumer. They keep the linked
// function/block collections inside this module's record authority instead
// of making downstream consumers reconstruct their storage layout.
record SsaFunctionCount { rest: FunctionList, count: u64 }
fn ssa_function_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, lowered: LoweredUnit) -> (result: u64) {
    iterate i up_to 1024 carrying st: SsaFunctionCount = SsaFunctionCount { rest: lowered.functions, count: 0 } { next st = ssa_function_count_step(st); }
    return st.count;
}
fn ssa_function_count_step(st: SsaFunctionCount) -> (result: SsaFunctionCount) {
    return match st.rest { QNil => st, QCons { head: h, tail: t } => SsaFunctionCount { rest: t, count: st.count + 1 } };
}
record SsaFunctionLookup { rest: FunctionList, index: u64, wanted: u64, found: bool, function: FunctionFlow }
fn ssa_function_at<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, lowered: LoweredUnit, wanted: u64) -> (result: FunctionFlow) {
    let empty: FunctionFlow = FunctionFlow { fn_start: 0, fn_end: 0, entry: 0, blocks: BlockList.BNil, block_count: 0, unreachable_joins: 0, verified: false };
    iterate i up_to 1024 carrying st: SsaFunctionLookup = SsaFunctionLookup { rest: lowered.functions, index: 0, wanted: wanted, found: false, function: empty } { next st = ssa_function_lookup_step(st); }
    return st.function;
}
fn ssa_function_lookup_step(st: SsaFunctionLookup) -> (result: SsaFunctionLookup) {
    if st.found { return st; }
    return match st.rest { QNil => st, QCons { head: h, tail: t } => SsaFunctionLookup { rest: t, index: st.index + 1, wanted: st.wanted, found: st.index == st.wanted, function: h } };
}
fn ssa_cfg_blocks(function: FunctionFlow) -> (result: BlockList) { return function.blocks; }
fn ssa_cfg_entry(function: FunctionFlow) -> (result: u64) { return function.entry; }
fn ssa_cfg_verified(function: FunctionFlow) -> (result: bool) { return function.verified; }
fn ssa_flow_valid(lowered: LoweredUnit) -> (result: bool) { return lowered.valid && lowered.graph_ok; }

fn empty_block(id: u64, live: bool, join: bool) -> (result: Block) {
    return Block {
        id: id, kind: 0, term_start: 0, term_end: 0,
        succ0: 0, succ1: 0, succ_count: 0, instructions: 0,
        expressions: TypedExprList.ENil,
        reachable: live, is_join: join
    };
}

fn lower_unit<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: LoweredUnit) {
    let proof: decl.UnitProve = decl.prove_unit<P, N>(pages, stride, total);
    return lower_proven_unit<P, N>(pages, stride, total, proof);
}

// Reuse authoritative proof facts supplied by the project pipeline. This is
// also the one implementation path used by the standalone adapter above.
fn lower_proven_unit<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, proof: decl.UnitProve) -> (result: LoweredUnit) {
    if !(proof.ok) {
        return LoweredUnit {
            valid: false, graph_ok: false, proof: proof,
            functions: FunctionList.QNil, diagnostics: DiagnosticList.DNil,
            block_count: 0
        };
    }
    let unit: decl.Unit = proof.unit;
    let fns: FnWalk = lower_functions<P, N>(pages, stride, total, unit.fns, proof.tops);
    let count: u64 = diagnostic_count<P, N>(pages, stride, total, fns.diagnostics);
    return LoweredUnit {
        valid: fns.ok && tops_empty(fns.typed_rest) && count == 0,
        graph_ok: fns.ok && tops_empty(fns.typed_rest), proof: proof,
        functions: reverse_functions<P, N>(pages, stride, total, fns.acc),
        diagnostics: reverse_diagnostics<P, N>(pages, stride, total, fns.diagnostics),
        block_count: fns.block_count
    };
}

// First flow diagnostic for project-level reporting: the head diagnostic,
// or a zero code/span triple when lowering failed without emitting one.
fn first_diagnostic(lowered: LoweredUnit) -> (result: Diagnostic) {
    return match lowered.diagnostics {
        DNil => Diagnostic { code: 0, start: 0, end: 0 },
        DCons { head: diag, tail: rest } => diag
    };
}

fn lower_functions<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fns: decl.FnList, tops: decl.TopsList) -> (result: FnWalk) {
    iterate i up_to 1024 carrying d: FnWalk = FnWalk { rest: fns, typed_rest: tops, acc: FunctionList.QNil, diagnostics: DiagnosticList.DNil, block_count: 0, ok: true } { next d = lower_fn_step<P, N>(pages, stride, total, d); }
    return d;
}
fn lower_fn_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FnWalk) -> (result: FnWalk) {
    return match st.rest {
        decl.FnList.DNil => st,
        decl.FnList.DCons { head: h, tail: t } => lower_one_fn<P, N>(pages, stride, total, st, h, t)
    };
}
fn lower_one_fn<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FnWalk, h: decl.FnDecl, t: decl.FnList) -> (result: FnWalk) {
    let initial: Build = Build {
        rest: h.body.body, typed_rest: st.typed_rest, frames: FlowFrames.FNil,
        current: empty_block(0, true, false), blocks: BlockList.BNil,
        diagnostics: DiagnosticList.DNil, next_id: 1, done: false, ok: h.ok,
        fn_start: h.fn_start, fn_end: h.fn_end,
        source_end: total,
        tail: h.body.ret, has_tail: h.body.has_ret
    };
    let walked: Build = walk<P, N>(pages, stride, total, initial);
    let finished: Build = finish_build(walked);
    let blocks: BlockList = reverse_blocks<P, N>(pages, stride, total, finished.blocks);
    let n: u64 = block_count<P, N>(pages, stride, total, blocks);
    let targets: bool = verify_targets<P, N>(pages, stride, total, blocks, finished.next_id);
    let verified: bool = finished.ok && targets && n == finished.next_id;
    let joins: u64 = diagnostic_count<P, N>(pages, stride, total, finished.diagnostics);
    let flow: FunctionFlow = FunctionFlow {
        fn_start: h.fn_start, fn_end: h.fn_end, entry: 0,
        blocks: blocks, block_count: n, unreachable_joins: joins,
        verified: verified
    };
    return FnWalk {
        rest: t, typed_rest: finished.typed_rest,
        acc: FunctionList.QCons { head: flow, tail: st.acc },
        diagnostics: append_diagnostics<P, N>(pages, stride, total, st.diagnostics, finished.diagnostics),
        block_count: st.block_count + n, ok: st.ok && verified
    };
}

fn walk<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, initial: Build) -> (result: Build) {
    iterate i up_to 1024 carrying d: Build = initial { next d = step<P, N>(pages, stride, total, d); }
    return d;
}
fn step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build) -> (result: Build) {
    if st.done || !(st.ok) { return st; }
    return match st.rest {
        decl.StmtList.SNil => step_empty<P, N>(pages, stride, total, st),
        decl.StmtList.SCons { head: h, tail: t } => step_stmt<P, N>(pages, stride, total, st, h, t)
    };
}
fn step_empty<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build) -> (result: Build) {
    return match st.frames {
        FlowFrames.FNil => finish_tail<P, N>(pages, stride, total, st),
        FlowFrames.FCons { head: f, tail: t } => unwind<P, N>(pages, stride, total, st, f, t)
    };
}
fn step_stmt<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, h: decl.Stmt, t: decl.StmtList) -> (result: Build) {
    if st.current.kind != 0 { return Build { ..st, done: true, ok: false }; }
    return match h {
        decl.Stmt.Let { name_start: a, name_end: b, type_start: c, type_end: d, type_kind: k, value: v, start: s, end: e } => add_let<P, N>(pages, stride, total, st, t, v, a, b),
        decl.Stmt.If { cond: c, then_b: tb, else_b: eb, start: s, end: e } => add_branch<P, N>(pages, stride, total, st, t, c, tb, eb),
        decl.Stmt.Fail { mode_start: a, mode_end: b, start: s, end: e } => add_fail<P, N>(pages, stride, total, st, t, s, e),
        decl.Stmt.Return { value: v, start: s, end: e } => add_return<P, N>(pages, stride, total, st, t, v, s, e),
        decl.Stmt.Iterate { name_start: ns, name_end: ne, over_source: o, has_over_source: ho, bound_start: bs, bound_end: be, state_start: ss, state_end: se, type_start: ts, type_end: te, type_kind: tk, initial: init, body: b, next_start: xs, next_end: xe, next_value: nv, start: s, end: e } => add_iterate<P, N>(pages, stride, total, st, t)
    };
}
// Loop control-flow (back-edge construction over the carried state) is
// unmodeled: fail the build here rather than emitting a wrong graph.
fn add_iterate<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, t: decl.StmtList) -> (result: Build) {
    return Build { ..st, done: true, ok: false };
}
fn add_let<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, t: decl.StmtList, value: decl.Expr, name_start: u64, name_end: u64) -> (result: Build) {
    let attached: Build = attach_expression<P, N>(pages, stride, total, st, value, 1, name_start, name_end);
    return Build { ..attached, rest: t };
}
fn add_branch<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, t: decl.StmtList, cond: decl.Expr, then_b: decl.StmtList, else_b: decl.StmtList) -> (result: Build) {
    let attached: Build = attach_expression<P, N>(pages, stride, total, st, cond, 2, 0, 0);
    let yes: u64 = attached.next_id;
    let no: u64 = attached.next_id + 1;
    let join: u64 = attached.next_id + 2;
    let branch: Block = Block {
        ..attached.current, kind: 1,
        expressions: reverse_typed_expressions<P, N>(pages, stride, total, attached.current.expressions),
        term_start: decl.expr_start(cond), term_end: decl.expr_end(cond),
        succ0: yes, succ1: no, succ_count: 2
    };
    let frame: FlowFrame = FlowFrame { next: t, else_body: else_b, else_id: no, join_id: join, phase: 0, parent_live: attached.current.reachable, then_falls: false };
    return Build {
        ..attached, rest: then_b,
        frames: FlowFrames.FCons { head: frame, tail: st.frames },
        current: empty_block(yes, attached.current.reachable, false),
        blocks: BlockList.BCons { head: branch, tail: st.blocks },
        next_id: attached.next_id + 3
    };
}
fn add_return<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, t: decl.StmtList, value: decl.Expr, s: u64, e: u64) -> (result: Build) {
    let attached: Build = attach_expression<P, N>(pages, stride, total, st, value, 3, 0, 0);
    let source_order: TypedExprList = reverse_typed_expressions<P, N>(pages, stride, total, attached.current.expressions);
    let b: Block = Block { ..attached.current, kind: 3, expressions: source_order, term_start: decl.expr_start(value), term_end: decl.expr_end(value) };
    return Build { ..attached, rest: t, current: b, blocks: BlockList.BCons { head: b, tail: attached.blocks } };
}
fn add_fail<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, t: decl.StmtList, s: u64, e: u64) -> (result: Build) {
    let b: Block = Block { ..st.current, kind: 4, expressions: reverse_typed_expressions<P, N>(pages, stride, total, st.current.expressions), term_start: s, term_end: e };
    return Build { ..st, rest: t, current: b, blocks: BlockList.BCons { head: b, tail: st.blocks } };
}

fn unwind<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, f: FlowFrame, tail: FlowFrames) -> (result: Build) {
    if f.phase == 0 { return unwind_then<P, N>(pages, stride, total, st, f, tail); }
    return unwind_else<P, N>(pages, stride, total, st, f, tail);
}
fn unwind_then<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, f: FlowFrame, tail: FlowFrames) -> (result: Build) {
    let falls: bool = st.current.kind == 0 && st.current.reachable;
    let first: Build = close_to_join<P, N>(pages, stride, total, st, f.join_id);
    let changed: FlowFrame = FlowFrame { ..f, phase: 1, then_falls: falls };
    return Build {
        ..first, rest: f.else_body,
        frames: FlowFrames.FCons { head: changed, tail: tail },
        current: empty_block(f.else_id, f.parent_live, false)
    };
}
fn unwind_else<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, f: FlowFrame, tail: FlowFrames) -> (result: Build) {
    let falls: bool = st.current.kind == 0 && st.current.reachable;
    let second: Build = close_to_join<P, N>(pages, stride, total, st, f.join_id);
    let join_live: bool = f.then_falls || falls;
    let diags: DiagnosticList = add_join_diagnostic(second, join_live, 0, st.source_end);
    return Build {
        ..second, rest: f.next, frames: tail,
        current: empty_block(f.join_id, join_live, true),
        diagnostics: diags
    };
}
fn add_join_diagnostic(st: Build, live: bool, start: u64, end: u64) -> (result: DiagnosticList) {
    if live { return st.diagnostics; }
    return DiagnosticList.DCons { head: Diagnostic { code: 38, start: start, end: end }, tail: st.diagnostics };
}
fn close_to_join<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, join_id: u64) -> (result: Build) {
    if st.current.kind != 0 { return st; }
    let source_order: TypedExprList = reverse_typed_expressions<P, N>(pages, stride, total, st.current.expressions);
    let b: Block = Block { ..st.current, kind: 2, expressions: source_order, succ0: join_id, succ_count: 1 };
    return Build { ..st, current: b, blocks: BlockList.BCons { head: b, tail: st.blocks } };
}
fn finish_tail<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build) -> (result: Build) {
    if !(st.has_tail) { return Build { ..st, done: true, ok: false }; }
    if st.current.kind != 0 { return Build { ..st, done: true }; }
    let attached: Build = attach_expression<P, N>(pages, stride, total, st, st.tail, 3, 0, 0);
    let source_order: TypedExprList = reverse_typed_expressions<P, N>(pages, stride, total, attached.current.expressions);
    let b: Block = Block { ..attached.current, kind: 3, expressions: source_order, term_start: decl.expr_start(attached.tail), term_end: decl.expr_end(attached.tail) };
    return Build { ..attached, current: b, blocks: BlockList.BCons { head: b, tail: attached.blocks }, done: true };
}
fn attach_expression<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, expression: decl.Expr, role: u64, binding_start: u64, binding_end: u64) -> (result: Build) {
    return match st.typed_rest {
        decl.TopsList.TLNil => Build { ..st, done: true, ok: false },
        decl.TopsList.TLCons { head: ops, tail: rest } => attach_typed_ops<P, N>(pages, stride, total, st, expression, role, binding_start, binding_end, ops, rest)
    };
}
fn attach_typed_ops<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: Build, expression: decl.Expr, role: u64, binding_start: u64, binding_end: u64, ops: decl.TOpList, rest: decl.TopsList) -> (result: Build) {
    let n: u64 = decl.count_tops<P, N>(pages, stride, total, ops);
    if n == 0 { return Build { ..st, done: true, ok: false }; }
    let typed: TypedExpr = TypedExpr { role: role, start: decl.expr_start(expression), end: decl.expr_end(expression), binding_start: binding_start, binding_end: binding_end, ops: ops, op_count: n };
    let exprs: TypedExprList = TypedExprList.ECons { head: typed, tail: st.current.expressions };
    let current: Block = Block { ..st.current, instructions: st.current.instructions + n, expressions: exprs };
    return Build { ..st, typed_rest: rest, current: current };
}
fn tops_empty(tops: decl.TopsList) -> (result: bool) {
    return match tops {
        decl.TopsList.TLNil => true,
        decl.TopsList.TLCons { head: h, tail: t } => false
    };
}
fn reverse_typed_expressions<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, expressions: TypedExprList) -> (result: TypedExprList) {
    iterate i up_to 1024 carrying d: TypedExprRev = TypedExprRev { rest: expressions, acc: TypedExprList.ENil } { next d = reverse_typed_expression_step(d); }
    return d.acc;
}
fn reverse_typed_expression_step(st: TypedExprRev) -> (result: TypedExprRev) {
    return match st.rest {
        TypedExprList.ENil => st,
        TypedExprList.ECons { head: h, tail: t } => TypedExprRev { rest: t, acc: TypedExprList.ECons { head: h, tail: st.acc } }
    };
}
fn finish_build(st: Build) -> (result: Build) {
    if st.done { return st; }
    return Build { ..st, done: true, ok: false };
}

fn reverse_blocks<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: BlockList) -> (result: BlockList) {
    iterate i up_to 1024 carrying d: BlockRev = BlockRev { rest: list, acc: BlockList.BNil } { next d = reverse_block_step(d); }
    return d.acc;
}
fn reverse_block_step(st: BlockRev) -> (result: BlockRev) {
    return match st.rest {
        BNil => st,
        BCons { head: h, tail: t } => BlockRev { rest: t, acc: BlockList.BCons { head: h, tail: st.acc } }
    };
}
fn block_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, blocks: BlockList) -> (result: u64) {
    iterate i up_to 1024 carrying d: BlockCount = BlockCount { rest: blocks, count: 0 } { next d = block_count_step(d); }
    return d.count;
}
fn block_count_step(st: BlockCount) -> (result: BlockCount) {
    return match st.rest {
        BNil => st,
        BCons { head: h, tail: t } => BlockCount { rest: t, count: st.count + 1 }
    };
}
fn verify_targets<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, blocks: BlockList, limit: u64) -> (result: bool) {
    iterate i up_to 1024 carrying d: TargetCheck = TargetCheck { rest: blocks, limit: limit, ok: true } { next d = target_step(d); }
    return d.ok && block_list_empty(d.rest);
}
fn block_list_empty(list: BlockList) -> (result: bool) {
    return match list { BNil => true, BCons { head: h, tail: t } => false };
}
fn target_step(st: TargetCheck) -> (result: TargetCheck) {
    if !(st.ok) { return st; }
    return match st.rest {
        BNil => st,
        BCons { head: h, tail: t } => target_check_block(st, h, t)
    };
}
fn target_check_block(st: TargetCheck, h: Block, t: BlockList) -> (result: TargetCheck) {
    if h.kind == 1 { return TargetCheck { ..st, rest: t, ok: h.succ_count == 2 && h.succ0 < st.limit && h.succ1 < st.limit }; }
    if h.kind == 2 { return TargetCheck { ..st, rest: t, ok: h.succ_count == 1 && h.succ0 < st.limit }; }
    if h.kind == 3 || h.kind == 4 { return TargetCheck { ..st, rest: t, ok: h.succ_count == 0 }; }
    return TargetCheck { ..st, rest: t, ok: false };
}

fn diagnostic_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: DiagnosticList) -> (result: u64) {
    iterate i up_to 1024 carrying d: DiagCount = DiagCount { rest: list, count: 0 } { next d = count_diag_step(d); }
    return d.count;
}
fn count_diag_step(st: DiagCount) -> (result: DiagCount) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => DiagCount { rest: t, count: st.count + 1 }
    };
}

fn append_diagnostics<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, first: DiagnosticList, second: DiagnosticList) -> (result: DiagnosticList) {
    let rev: DiagnosticList = reverse_diagnostics<P, N>(pages, stride, total, first);
    iterate i up_to 1024 carrying d: DiagRev = DiagRev { rest: rev, acc: second } { next d = prepend_diag_step(d); }
    return d.acc;
}
fn reverse_diagnostics<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: DiagnosticList) -> (result: DiagnosticList) {
    iterate i up_to 1024 carrying d: DiagRev = DiagRev { rest: list, acc: DiagnosticList.DNil } { next d = reverse_diag_step(d); }
    return d.acc;
}
fn reverse_diag_step(st: DiagRev) -> (result: DiagRev) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => DiagRev { rest: t, acc: DiagnosticList.DCons { head: h, tail: st.acc } }
    };
}
fn prepend_diag_step(st: DiagRev) -> (result: DiagRev) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => DiagRev { rest: t, acc: DiagnosticList.DCons { head: h, tail: st.acc } }
    };
}

fn reverse_functions<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, list: FunctionList) -> (result: FunctionList) {
    iterate i up_to 1024 carrying d: FnRev = FnRev { rest: list, acc: FunctionList.QNil } { next d = reverse_fn_step(d); }
    return d.acc;
}
fn reverse_fn_step(st: FnRev) -> (result: FnRev) {
    return match st.rest {
        QNil => st,
        QCons { head: h, tail: t } => FnRev { rest: t, acc: FunctionList.QCons { head: h, tail: st.acc } }
    };
}
