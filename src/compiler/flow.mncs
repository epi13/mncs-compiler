mncs 0.18;
module mncs.compiler.flow.v1;
use mncs.compiler.decl.v1 as decl;

// Control-flow lowering for the declaration/semantic vertical. Each block
// retains the typed postfix expression operations produced and verified by
// decl.prove_unit, alongside explicit branch/jump/return/failure edges. The
// verifier is limited to statement forms admitted by decl.mncs today.


// kind: 0 open builder, 1 branch, 2 jump, 3 return, 4 fail. `instructions`
// counts retained typed-stack operations in `expressions`.
// role: 1 let-value, 2 branch condition, 3 returned value.
record TypedExpr { role: u64, start: u64, end: u64, ops: decl.TOpList, op_count: u64 }
enum TypedExprList { ENil, ECons { head: TypedExpr, tail: TypedExprList } }
record TypedExprRev { rest: TypedExprList, acc: TypedExprList }
record Block {
    id: u64,
    kind: u64,
    term_start: u64,
    term_end: u64,
    succ0: u64,
    succ1: u64,
    succ_count: u64,
    instructions: u64,
    expressions: TypedExprList,
    reachable: bool,
    is_join: bool
}
enum BlockList { BNil, BCons { head: Block, tail: BlockList } }
record BlockRev { rest: BlockList, acc: BlockList }

record Frame {
    next: decl.StmtList,
    else_body: decl.StmtList,
    else_id: u64,
    join_id: u64,
    phase: u64,
    parent_live: bool,
    then_falls: bool
}
enum Frames { FNil, FCons { head: Frame, tail: Frames } }

record Diagnostic { code: u64, start: u64, end: u64 }
enum DiagnosticList { DNil, DCons { head: Diagnostic, tail: DiagnosticList } }
record DiagRev { rest: DiagnosticList, acc: DiagnosticList }

record Build {
    rest: decl.StmtList,
    typed_rest: decl.TopsList,
    frames: Frames,
    current: Block,
    blocks: BlockList,
    diagnostics: DiagnosticList,
    next_id: u64,
    done: bool,
    ok: bool,
    fn_start: u64,
    fn_end: u64,
    source_end: u64,
    tail: decl.Expr,
    has_tail: bool
}

record TargetCheck { rest: BlockList, limit: u64, ok: bool }
record BlockCount { rest: BlockList, count: u64 }
record DiagCount { rest: DiagnosticList, count: u64 }
record FunctionFlow {
    fn_start: u64,
    fn_end: u64,
    entry: u64,
    blocks: BlockList,
    block_count: u64,
    unreachable_joins: u64,
    verified: bool
}
enum FunctionList { QNil, QCons { head: FunctionFlow, tail: FunctionList } }
record FnWalk {
    rest: decl.FnList,
    typed_rest: decl.TopsList,
    acc: FunctionList,
    diagnostics: DiagnosticList,
    block_count: u64,
    ok: bool
}
record FnRev { rest: FunctionList, acc: FunctionList }
record LoweredUnit {
    valid: bool,
    graph_ok: bool,
    proof: decl.UnitProve,
    functions: FunctionList,
    diagnostics: DiagnosticList,
    block_count: u64
}

fn empty_block(id: u64, live: bool, join: bool) -> (result: Block) {
    return Block {
        id: id, kind: 0, term_start: 0, term_end: 0,
        succ0: 0, succ1: 0, succ_count: 0, instructions: 0,
        expressions: TypedExprList.ENil,
        reachable: live, is_join: join
    };
}

fn lower_unit<N: Nat>(input: [byte; up_to N]) -> (result: LoweredUnit) {
    let proof: decl.UnitProve = decl.prove_unit<N>(input);
    return lower_proven_unit<N>(input, proof);
}

// Reuse authoritative proof facts supplied by the project pipeline. This is
// also the one implementation path used by the standalone adapter above.
fn lower_proven_unit<N: Nat>(input: [byte; up_to N], proof: decl.UnitProve) -> (result: LoweredUnit) {
    if !(proof.ok) {
        return LoweredUnit {
            valid: false, graph_ok: false, proof: proof,
            functions: FunctionList.QNil, diagnostics: DiagnosticList.DNil,
            block_count: 0
        };
    }
    let unit: decl.Unit = proof.unit;
    let fns: FnWalk = lower_functions<N>(input, unit.fns, proof.tops);
    let count: u64 = diagnostic_count<N>(input, fns.diagnostics);
    return LoweredUnit {
        valid: fns.ok && tops_empty(fns.typed_rest) && count == 0,
        graph_ok: fns.ok && tops_empty(fns.typed_rest), proof: proof,
        functions: reverse_functions<N>(input, fns.acc),
        diagnostics: reverse_diagnostics<N>(input, fns.diagnostics),
        block_count: fns.block_count
    };
}

fn lower_functions<N: Nat>(input: [byte; up_to N], fns: decl.FnList, tops: decl.TopsList) -> (result: FnWalk) {
    iterate i over input carrying d: FnWalk = FnWalk { rest: fns, typed_rest: tops, acc: FunctionList.QNil, diagnostics: DiagnosticList.DNil, block_count: 0, ok: true } { next d = lower_fn_step<N>(input, d); }
    return d;
}
fn lower_fn_step<N: Nat>(input: [byte; up_to N], st: FnWalk) -> (result: FnWalk) {
    return match st.rest {
        decl.FnList.DNil => st,
        decl.FnList.DCons { head: h, tail: t } => lower_one_fn<N>(input, st, h, t)
    };
}
fn lower_one_fn<N: Nat>(input: [byte; up_to N], st: FnWalk, h: decl.FnDecl, t: decl.FnList) -> (result: FnWalk) {
    let initial: Build = Build {
        rest: h.body.body, typed_rest: st.typed_rest, frames: Frames.FNil,
        current: empty_block(0, true, false), blocks: BlockList.BNil,
        diagnostics: DiagnosticList.DNil, next_id: 1, done: false, ok: h.ok,
        fn_start: h.fn_start, fn_end: h.fn_end,
        source_end: input.len,
        tail: h.body.ret, has_tail: h.body.has_ret
    };
    let walked: Build = walk<N>(input, initial);
    let finished: Build = finish_build(walked);
    let blocks: BlockList = reverse_blocks<N>(input, finished.blocks);
    let n: u64 = block_count<N>(input, blocks);
    let targets: bool = verify_targets<N>(input, blocks, finished.next_id);
    let verified: bool = finished.ok && targets && n == finished.next_id;
    let joins: u64 = diagnostic_count<N>(input, finished.diagnostics);
    let flow: FunctionFlow = FunctionFlow {
        fn_start: h.fn_start, fn_end: h.fn_end, entry: 0,
        blocks: blocks, block_count: n, unreachable_joins: joins,
        verified: verified
    };
    return FnWalk {
        rest: t, typed_rest: finished.typed_rest,
        acc: FunctionList.QCons { head: flow, tail: st.acc },
        diagnostics: append_diagnostics<N>(input, st.diagnostics, finished.diagnostics),
        block_count: st.block_count + n, ok: st.ok && verified
    };
}

fn walk<N: Nat>(input: [byte; up_to N], initial: Build) -> (result: Build) {
    iterate i over input carrying d: Build = initial { next d = step<N>(input, d); }
    return d;
}
fn step<N: Nat>(input: [byte; up_to N], st: Build) -> (result: Build) {
    if st.done || !(st.ok) { return st; }
    return match st.rest {
        decl.StmtList.SNil => step_empty<N>(input, st),
        decl.StmtList.SCons { head: h, tail: t } => step_stmt<N>(input, st, h, t)
    };
}
fn step_empty<N: Nat>(input: [byte; up_to N], st: Build) -> (result: Build) {
    return match st.frames {
        Frames.FNil => finish_tail<N>(input, st),
        Frames.FCons { head: f, tail: t } => unwind<N>(input, st, f, t)
    };
}
fn step_stmt<N: Nat>(input: [byte; up_to N], st: Build, h: decl.Stmt, t: decl.StmtList) -> (result: Build) {
    if st.current.kind != 0 { return Build { ..st, done: true, ok: false }; }
    return match h {
        decl.Stmt.Let { name_start: a, name_end: b, type_start: c, type_end: d, type_kind: k, value: v, start: s, end: e } => add_let<N>(input, st, t, v),
        decl.Stmt.If { cond: c, then_b: tb, else_b: eb, start: s, end: e } => add_branch<N>(input, st, t, c, tb, eb),
        decl.Stmt.Fail { mode_start: a, mode_end: b, start: s, end: e } => add_fail<N>(input, st, t, s, e),
        decl.Stmt.Return { value: v, start: s, end: e } => add_return<N>(input, st, t, v, s, e)
    };
}
fn add_let<N: Nat>(input: [byte; up_to N], st: Build, t: decl.StmtList, value: decl.Expr) -> (result: Build) {
    let attached: Build = attach_expression<N>(input, st, value, 1);
    return Build { ..attached, rest: t };
}
fn add_branch<N: Nat>(input: [byte; up_to N], st: Build, t: decl.StmtList, cond: decl.Expr, then_b: decl.StmtList, else_b: decl.StmtList) -> (result: Build) {
    let attached: Build = attach_expression<N>(input, st, cond, 2);
    let yes: u64 = attached.next_id;
    let no: u64 = attached.next_id + 1;
    let join: u64 = attached.next_id + 2;
    let branch: Block = Block {
        ..attached.current, kind: 1,
        expressions: reverse_typed_expressions<N>(input, attached.current.expressions),
        term_start: decl.expr_start(cond), term_end: decl.expr_end(cond),
        succ0: yes, succ1: no, succ_count: 2
    };
    let frame: Frame = Frame { next: t, else_body: else_b, else_id: no, join_id: join, phase: 0, parent_live: attached.current.reachable, then_falls: false };
    return Build {
        ..attached, rest: then_b,
        frames: Frames.FCons { head: frame, tail: st.frames },
        current: empty_block(yes, attached.current.reachable, false),
        blocks: BlockList.BCons { head: branch, tail: st.blocks },
        next_id: attached.next_id + 3
    };
}
fn add_return<N: Nat>(input: [byte; up_to N], st: Build, t: decl.StmtList, value: decl.Expr, s: u64, e: u64) -> (result: Build) {
    let attached: Build = attach_expression<N>(input, st, value, 3);
    let source_order: TypedExprList = reverse_typed_expressions<N>(input, attached.current.expressions);
    let b: Block = Block { ..attached.current, kind: 3, expressions: source_order, term_start: decl.expr_start(value), term_end: decl.expr_end(value) };
    return Build { ..attached, rest: t, current: b, blocks: BlockList.BCons { head: b, tail: attached.blocks } };
}
fn add_fail<N: Nat>(input: [byte; up_to N], st: Build, t: decl.StmtList, s: u64, e: u64) -> (result: Build) {
    let b: Block = Block { ..st.current, kind: 4, expressions: reverse_typed_expressions<N>(input, st.current.expressions), term_start: s, term_end: e };
    return Build { ..st, rest: t, current: b, blocks: BlockList.BCons { head: b, tail: st.blocks } };
}

fn unwind<N: Nat>(input: [byte; up_to N], st: Build, f: Frame, tail: Frames) -> (result: Build) {
    if f.phase == 0 { return unwind_then<N>(input, st, f, tail); }
    return unwind_else<N>(input, st, f, tail);
}
fn unwind_then<N: Nat>(input: [byte; up_to N], st: Build, f: Frame, tail: Frames) -> (result: Build) {
    let falls: bool = st.current.kind == 0 && st.current.reachable;
    let first: Build = close_to_join<N>(input, st, f.join_id);
    let changed: Frame = Frame { ..f, phase: 1, then_falls: falls };
    return Build {
        ..first, rest: f.else_body,
        frames: Frames.FCons { head: changed, tail: tail },
        current: empty_block(f.else_id, f.parent_live, false)
    };
}
fn unwind_else<N: Nat>(input: [byte; up_to N], st: Build, f: Frame, tail: Frames) -> (result: Build) {
    let falls: bool = st.current.kind == 0 && st.current.reachable;
    let second: Build = close_to_join<N>(input, st, f.join_id);
    let join_live: bool = f.then_falls || falls;
    let diags: DiagnosticList = add_join_diagnostic(second, join_live, 0, st.source_end);
    return Build {
        ..second, rest: f.next, frames: tail,
        current: empty_block(f.join_id, join_live, true),
        diagnostics: diags
    };
}
fn add_join_diagnostic(st: Build, live: bool, start: u64, end: u64) -> (result: DiagnosticList) {
    if live { return st.diagnostics; }
    return DiagnosticList.DCons { head: Diagnostic { code: 38, start: start, end: end }, tail: st.diagnostics };
}
fn close_to_join<N: Nat>(input: [byte; up_to N], st: Build, join_id: u64) -> (result: Build) {
    if st.current.kind != 0 { return st; }
    let source_order: TypedExprList = reverse_typed_expressions<N>(input, st.current.expressions);
    let b: Block = Block { ..st.current, kind: 2, expressions: source_order, succ0: join_id, succ_count: 1 };
    return Build { ..st, current: b, blocks: BlockList.BCons { head: b, tail: st.blocks } };
}
fn finish_tail<N: Nat>(input: [byte; up_to N], st: Build) -> (result: Build) {
    if !(st.has_tail) { return Build { ..st, done: true, ok: false }; }
    if st.current.kind != 0 { return Build { ..st, done: true }; }
    let attached: Build = attach_expression<N>(input, st, st.tail, 3);
    let source_order: TypedExprList = reverse_typed_expressions<N>(input, attached.current.expressions);
    let b: Block = Block { ..attached.current, kind: 3, expressions: source_order, term_start: decl.expr_start(attached.tail), term_end: decl.expr_end(attached.tail) };
    return Build { ..attached, current: b, blocks: BlockList.BCons { head: b, tail: attached.blocks }, done: true };
}
fn attach_expression<N: Nat>(input: [byte; up_to N], st: Build, expression: decl.Expr, role: u64) -> (result: Build) {
    return match st.typed_rest {
        decl.TopsList.TLNil => Build { ..st, done: true, ok: false },
        decl.TopsList.TLCons { head: ops, tail: rest } => attach_typed_ops<N>(input, st, expression, role, ops, rest)
    };
}
fn attach_typed_ops<N: Nat>(input: [byte; up_to N], st: Build, expression: decl.Expr, role: u64, ops: decl.TOpList, rest: decl.TopsList) -> (result: Build) {
    let n: u64 = decl.count_tops<N>(input, ops);
    if n == 0 { return Build { ..st, done: true, ok: false }; }
    let typed: TypedExpr = TypedExpr { role: role, start: decl.expr_start(expression), end: decl.expr_end(expression), ops: ops, op_count: n };
    let exprs: TypedExprList = TypedExprList.ECons { head: typed, tail: st.current.expressions };
    let current: Block = Block { ..st.current, instructions: st.current.instructions + n, expressions: exprs };
    return Build { ..st, typed_rest: rest, current: current };
}
fn tops_empty(tops: decl.TopsList) -> (result: bool) {
    return match tops {
        decl.TopsList.TLNil => true,
        decl.TopsList.TLCons { head: h, tail: t } => false
    };
}
fn reverse_typed_expressions<N: Nat>(input: [byte; up_to N], expressions: TypedExprList) -> (result: TypedExprList) {
    iterate i over input carrying d: TypedExprRev = TypedExprRev { rest: expressions, acc: TypedExprList.ENil } { next d = reverse_typed_expression_step(d); }
    return d.acc;
}
fn reverse_typed_expression_step(st: TypedExprRev) -> (result: TypedExprRev) {
    return match st.rest {
        TypedExprList.ENil => st,
        TypedExprList.ECons { head: h, tail: t } => TypedExprRev { rest: t, acc: TypedExprList.ECons { head: h, tail: st.acc } }
    };
}
fn finish_build(st: Build) -> (result: Build) {
    if st.done { return st; }
    return Build { ..st, done: true, ok: false };
}

fn reverse_blocks<N: Nat>(input: [byte; up_to N], list: BlockList) -> (result: BlockList) {
    iterate i over input carrying d: BlockRev = BlockRev { rest: list, acc: BlockList.BNil } { next d = reverse_block_step(d); }
    return d.acc;
}
fn reverse_block_step(st: BlockRev) -> (result: BlockRev) {
    return match st.rest {
        BNil => st,
        BCons { head: h, tail: t } => BlockRev { rest: t, acc: BlockList.BCons { head: h, tail: st.acc } }
    };
}
fn block_count<N: Nat>(input: [byte; up_to N], blocks: BlockList) -> (result: u64) {
    iterate i over input carrying d: BlockCount = BlockCount { rest: blocks, count: 0 } { next d = block_count_step(d); }
    return d.count;
}
fn block_count_step(st: BlockCount) -> (result: BlockCount) {
    return match st.rest {
        BNil => st,
        BCons { head: h, tail: t } => BlockCount { rest: t, count: st.count + 1 }
    };
}
fn verify_targets<N: Nat>(input: [byte; up_to N], blocks: BlockList, limit: u64) -> (result: bool) {
    iterate i over input carrying d: TargetCheck = TargetCheck { rest: blocks, limit: limit, ok: true } { next d = target_step(d); }
    return d.ok && block_list_empty(d.rest);
}
fn block_list_empty(list: BlockList) -> (result: bool) {
    return match list { BNil => true, BCons { head: h, tail: t } => false };
}
fn target_step(st: TargetCheck) -> (result: TargetCheck) {
    if !(st.ok) { return st; }
    return match st.rest {
        BNil => st,
        BCons { head: h, tail: t } => target_check_block(st, h, t)
    };
}
fn target_check_block(st: TargetCheck, h: Block, t: BlockList) -> (result: TargetCheck) {
    if h.kind == 1 { return TargetCheck { ..st, rest: t, ok: h.succ_count == 2 && h.succ0 < st.limit && h.succ1 < st.limit }; }
    if h.kind == 2 { return TargetCheck { ..st, rest: t, ok: h.succ_count == 1 && h.succ0 < st.limit }; }
    if h.kind == 3 || h.kind == 4 { return TargetCheck { ..st, rest: t, ok: h.succ_count == 0 }; }
    return TargetCheck { ..st, rest: t, ok: false };
}

fn diagnostic_count<N: Nat>(input: [byte; up_to N], list: DiagnosticList) -> (result: u64) {
    iterate i over input carrying d: DiagCount = DiagCount { rest: list, count: 0 } { next d = count_diag_step(d); }
    return d.count;
}
fn count_diag_step(st: DiagCount) -> (result: DiagCount) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => DiagCount { rest: t, count: st.count + 1 }
    };
}

fn append_diagnostics<N: Nat>(input: [byte; up_to N], first: DiagnosticList, second: DiagnosticList) -> (result: DiagnosticList) {
    let rev: DiagnosticList = reverse_diagnostics<N>(input, first);
    iterate i over input carrying d: DiagRev = DiagRev { rest: rev, acc: second } { next d = prepend_diag_step(d); }
    return d.acc;
}
fn reverse_diagnostics<N: Nat>(input: [byte; up_to N], list: DiagnosticList) -> (result: DiagnosticList) {
    iterate i over input carrying d: DiagRev = DiagRev { rest: list, acc: DiagnosticList.DNil } { next d = reverse_diag_step(d); }
    return d.acc;
}
fn reverse_diag_step(st: DiagRev) -> (result: DiagRev) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => DiagRev { rest: t, acc: DiagnosticList.DCons { head: h, tail: st.acc } }
    };
}
fn prepend_diag_step(st: DiagRev) -> (result: DiagRev) {
    return match st.rest {
        DNil => st,
        DCons { head: h, tail: t } => DiagRev { rest: t, acc: DiagnosticList.DCons { head: h, tail: st.acc } }
    };
}

fn reverse_functions<N: Nat>(input: [byte; up_to N], list: FunctionList) -> (result: FunctionList) {
    iterate i over input carrying d: FnRev = FnRev { rest: list, acc: FunctionList.QNil } { next d = reverse_fn_step(d); }
    return d.acc;
}
fn reverse_fn_step(st: FnRev) -> (result: FnRev) {
    return match st.rest {
        QNil => st,
        QCons { head: h, tail: t } => FnRev { rest: t, acc: FunctionList.QCons { head: h, tail: st.acc } }
    };
}
