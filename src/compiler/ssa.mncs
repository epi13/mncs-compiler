mncs 0.18;
module mncs.compiler.ssa.v1;
use mncs.compiler.decl.v1 as decl;
use mncs.compiler.flow.v1 as flow;
use mncs.compiler.parser.v1 as parser;
use mncs.compiler.source.v1 as source;

// First value-carrying lowering over the existing typed CFG. This slice
// admits scalar values, immutable scalar locals, direct calls and structured
// branch/jump/return blocks. Values crossing an edge are explicit block
// arguments; joins receive typed block parameters. Unsupported typed
// operations fail this SSA report closed while leaving the upstream proof
// and CFG facts intact.
record Value { id: u64, ty: decl.SemType, owner_block: u64, kind: u64, index: u64 }
enum ValueList { VNil, VCons { head: Value, tail: ValueList } }
record Id { value: u64 }
enum IdList { INil, ICons { head: Id, tail: IdList } }
enum ValueStack { WNil, WCons { head: Value, tail: ValueStack } }

record Binding { name_start: u64, name_end: u64, value: u64, ty: decl.SemType }
enum Environment { EnvNil, EnvCons { head: Binding, tail: Environment } }
record Edge { source: u64, target: u64, bindings: Environment, arguments: IdList }
enum EdgeList { ENil, ECons { head: Edge, tail: EdgeList } }
record FiniteMatchCase { variant_start: u64, variant_end: u64, target: u64, arguments: IdList }
enum FiniteMatchCaseList { MCNil, MCCons { head: FiniteMatchCase, tail: FiniteMatchCaseList } }
record ScalarMatchCase { is_default: bool, negative: bool, value: u64, overflow: bool, pattern_start: u64, pattern_end: u64, target: u64, arguments: IdList }
enum ScalarMatchCaseList { SCNil, SCCons { head: ScalarMatchCase, tail: ScalarMatchCaseList } }

record Instruction {
    id: u64,
    sequence: u64,
    kind: u64,
    operator: u64,
    result: u64,
    ty: decl.SemType,
    inputs: IdList,
    argc: u64,
    params: decl.BindList,
    identity: decl.SemanticIdentity,
    nominal_identity: decl.SemanticIdentity,
    variant_start: u64,
    variant_end: u64,
    binding_start: u64,
    binding_end: u64,
    effects: decl.EffectIdentityList,
    capabilities: decl.CapabilityIdentityList,
    start: u64,
    end: u64
}
enum InstructionList { QNil, QCons { head: Instruction, tail: InstructionList } }
record InstructionRev { rest: InstructionList, acc: InstructionList }

enum Terminator {
    Branch { condition: u64, yes: u64, no: u64, yes_args: IdList, no_args: IdList },
    Jump { target: u64, arguments: IdList },
    Return { value: u64 },
    Fail,
    FiniteSwitch { subject: u64, subject_ty: decl.SemType, nominal_identity: decl.SemanticIdentity, result_type: decl.SemType, source_start: u64, source_end: u64, arm_count: u64, join_target: u64, cases: FiniteMatchCaseList },
    ScalarSwitch { subject: u64, subject_ty: decl.SemType, result_type: decl.SemType, source_start: u64, source_end: u64, arm_count: u64, default_target: u64, join_target: u64, cases: ScalarMatchCaseList }
}
record SsaBlock { id: u64, parameters: ValueList, instructions: InstructionList, terminator: Terminator, reachable: bool, lowering_ok: bool, lowering_failure_kind: u64 }
enum SsaBlockList { LNil, LCons { head: SsaBlock, tail: SsaBlockList } }
record SsaBlockRev { rest: SsaBlockList, acc: SsaBlockList }

record Function {
    identity: decl.SemanticIdentity,
    nominals: decl.NominalTypeIdentityList,
    inputs: ValueList,
    result_type: decl.SemType,
    blocks: SsaBlockList,
    values: ValueList,
    value_count: u64,
    supported: bool,
    verified: bool
}
enum FunctionList { FNil, FCons { head: Function, tail: FunctionList } }
record ValueSsaSummary {
    functions: FunctionList,
    valid: bool,
    function_count: u64,
    supported_function_count: u64,
    verified_function_count: u64,
    value_count: u64,
    instruction_count: u64,
    block_count: u64,
    block_parameter_count: u64,
    unsupported_block_count: u64,
    first_unsupported_function: u64,
    first_unsupported_block: u64,
    first_unsupported_kind: u64,
    call_count: u64,
    has_call: bool,
    first_call_identity: decl.SemanticIdentity
}

record ParamBuild { rest: decl.FieldList, env: Environment, inputs: ValueList, values: ValueList, next_value: u64, ok: bool }
record Incoming { found: bool, ok: bool, count: u64, bindings: Environment }
record IncomingScan { rest: EdgeList, target: u64, found: bool, ok: bool, count: u64, bindings: Environment }
record BlockParamBuild { rest: Environment, env: Environment, params: ValueList, values: ValueList, next_value: u64, parameter_index: u64, block: u64, nominals: decl.NominalTypeIdentityList, ok: bool }
record MatchContextBuild { env: Environment, stack: ValueStack, parameters: ValueList, values: ValueList, next_value: u64, parameter_index: u64, block: u64, nominals: decl.NominalTypeIdentityList, ok: bool }
record StackParamBuild { rest: ValueStack, parameters_rev: ValueList, stack_rev: ValueStack, values: ValueList, next_value: u64, index: u64, block: u64, nominals: decl.NominalTypeIdentityList, ok: bool }
record ValueListReverse { rest: ValueList, acc: ValueList }
record ValueStackReverse { rest: ValueStack, acc: ValueStack }
record IdListReverse { rest: IdList, acc: IdList }
record PayloadLowerBuild { rest: decl.PayloadBindingList, fields: decl.BindList, env: Environment, subject: u64, variant_start: u64, variant_end: u64, nominal: decl.SemanticIdentity, match_start: u64, match_end: u64, instructions: InstructionList, values: ValueList, next_value: u64, next_instruction: u64, sequence: u64, block: u64, nominals: decl.NominalTypeIdentityList, ok: bool }
record FiniteArmBuild { rest: decl.TypedFiniteMatchArmList, source: ExprBuild, cases: FiniteMatchCaseList, arm_blocks: SsaBlockList, arm_index: u64, arm_count: u64, join_id: u64, join_env: Environment, join_stack: ValueStack, join_params: ValueList, join_result: Value, source_arguments: IdList, nominal: decl.SemanticIdentity, subject: Value, subject_ty: decl.SemType, result_ty: decl.SemType, match_start: u64, match_end: u64, next_value: u64, next_instruction: u64, next_block: u64, ok: bool }
record FiniteArmPrepared { arm: decl.TypedFiniteMatchArm, source: ExprBuild, arm_id: u64, arm_params: ValueList, arm_env: Environment, base_env: Environment, base_stack: ValueStack, subject: Value, nominal: decl.SemanticIdentity, join_id: u64, join_env: Environment, join_stack: ValueStack, join_params: ValueList, result_ty: decl.SemType, match_start: u64, match_end: u64, next_value: u64, next_instruction: u64, ok: bool }
record ScalarArmBuild { rest: decl.TypedScalarMatchArmList, source: ExprBuild, cases: ScalarMatchCaseList, arm_blocks: SsaBlockList, arm_index: u64, arm_count: u64, join_id: u64, join_env: Environment, join_stack: ValueStack, join_params: ValueList, join_result: Value, source_arguments: IdList, default_target: u64, subject: Value, subject_ty: decl.SemType, result_ty: decl.SemType, match_start: u64, match_end: u64, next_value: u64, next_instruction: u64, next_block: u64, ok: bool }
// Nested matches in arm position lower through an explicit suspension
// stack (CP-0011): a match op suspends the current op sequence, lowers
// the nested match's arms as further frames, and resumes with the nested
// join as the current block. A match op may sit anywhere in the arm op
// sequence (the parser accepts matches in any arm-value operand
// position); trailing ops continue lowering in the nested join block
// exactly like a mid-sequence match in a function body. Outer arm/join
// IDs stay precomputed exactly as before, so numbering is unchanged
// when no nesting occurs; nested blocks allocate above the outer join
// through the bump pointer below.
record NestFiniteFrame { match_ctx: FiniteArmBuild, arm: decl.TypedFiniteMatchArm, prepared_env: Environment, prepared_stack: ValueStack }
record NestScalarFrame { match_ctx: ScalarArmBuild, arm: decl.TypedScalarMatchArm, prepared_env: Environment, prepared_stack: ValueStack }
enum NestFrameList { NFNil, NFFinite { head: NestFiniteFrame, tail: NestFrameList }, NFScalar { head: NestScalarFrame, tail: NestFrameList } }
record NestDriver { build: ExprBuild, frames: NestFrameList, done: bool }

record ExprBuild {
    rest: decl.TOpList,
    env: Environment,
    stack: ValueStack,
    instructions: InstructionList,
    values: ValueList,
    next_value: u64,
    next_instruction: u64,
    sequence: u64,
    block: u64,
    parameters: ValueList,
    generated_blocks: SsaBlockList,
    next_block_id: u64,
    nominals: decl.NominalTypeIdentityList,
    ok: bool,
    failure_op: u64
}
record PopArgs { stack: ValueStack, remaining: u64, arguments: IdList, ok: bool }
record ExpressionBuild {
    rest: flow.TypedExprList,
    env: Environment,
    instructions: InstructionList,
    values: ValueList,
    next_value: u64,
    next_instruction: u64,
    sequence: u64,
    block: u64,
    parameters: ValueList,
    generated_blocks: SsaBlockList,
    next_block_id: u64,
    branch_value: u64,
    return_value: u64,
    has_branch: bool,
    has_return: bool,
    nominals: decl.NominalTypeIdentityList,
    ok: bool,
    failure_op: u64
}
record SsaBuild {
    rest: flow.BlockList,
    edges: EdgeList,
    blocks: SsaBlockList,
    values: ValueList,
    inputs: ValueList,
    entry_env: Environment,
    next_value: u64,
    next_instruction: u64,
    next_block_id: u64,
    result_type: decl.SemType,
    identity: decl.SemanticIdentity,
    nominals: decl.NominalTypeIdentityList,
    entry: u64,
    supported: bool,
    initial_failure_kind: u64
}
record FunctionWalk { fns: decl.FnList, lowered: flow.LoweredUnit, index: u64, acc: FunctionList, count: u64, nominals: decl.NominalTypeIdentityList, ok: bool }
record FunctionSummaryScan { rest: FunctionList, valid: bool, functions: u64, supported: u64, verified: u64, values: u64, instructions: u64, blocks: u64, parameters: u64, calls: u64, has_call: bool, first_identity: decl.SemanticIdentity, unsupported: u64, first_bad_function: u64, first_bad_block: u64, first_bad_kind: u64 }
record FunctionShape { blocks: u64, parameters: u64, instructions: u64, calls: u64, has_call: bool, first_identity: decl.SemanticIdentity, unsupported: u64, first_bad_block: u64, first_bad_kind: u64 }
record BlockShapeScan { rest: SsaBlockList, blocks: u64, parameters: u64, instructions: u64, calls: u64, has_call: bool, first_identity: decl.SemanticIdentity, unsupported: u64, first_bad_block: u64, first_bad_kind: u64 }
record InstructionShapeScan { rest: InstructionList, instructions: u64, calls: u64, has_call: bool, first_identity: decl.SemanticIdentity }

fn invalid_identity() -> (result: decl.SemanticIdentity) {
    return decl.invalid_semantic_identity();
}

fn scalar_type(ty: decl.SemType) -> (result: bool) {
    return match ty {
        TBool => true,
        TByte => true,
        TInt { width: w, signed: s } => true,
        TNamed { start: a, end: b } => false,
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: valid } => false,
        TPoison => false
    };
}
fn supported_sequence_element<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: decl.SemType, nominals: decl.NominalTypeIdentityList) -> (result: bool) {
    return match ty {
        TBool => true,
        TByte => true,
        TInt { width: w, signed: s } => true,
        TNamed { start: a, end: b } => nominal_value_type_bound<P, N>(pages, stride, total, nominals, a, b),
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: valid } => false,
        TPoison => false
    };
}
fn supported_value_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: decl.SemType, nominals: decl.NominalTypeIdentityList) -> (result: bool) {
    return match ty {
        TBool => true,
        TByte => true,
        TInt { width: w, signed: s } => true,
        TNamed { start: a, end: b } => nominal_value_type_bound<P, N>(pages, stride, total, nominals, a, b),
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: valid } => supported_sequence_element<P, N>(pages, stride, total, element, nominals),
        TPoison => false
    };
}
fn nominal_value_type_bound<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, start: u64, end: u64) -> (result: bool) {
    let imported: decl.NominalLookup = decl.nominal_identity_at<P, N>(pages, stride, total, nominals, start, end);
    let local: decl.NominalLookup = decl.nominal_identity_by_name<P, N>(pages, stride, total, nominals, start, end);
    return (imported.found && imported.identity.valid) || (local.found && local.identity.valid);
}

fn lower_value_ssa<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, lowered: flow.LoweredUnit, nominals: decl.NominalTypeIdentityList) -> (result: ValueSsaSummary) {
    if !(flow.ssa_flow_valid(lowered)) {
        return empty_ssa_summary(false);
    }
    iterate i up_to 1024 carrying st: FunctionWalk = FunctionWalk { fns: lowered.proof.unit.fns, lowered: lowered, index: 0, acc: FunctionList.FNil, count: 0, nominals: nominals, ok: true } {
        next st = lower_function_step<P, N>(pages, stride, total, st, lowered.proof.unit.header);
    }
    let functions: FunctionList = reverse_functions<P, N>(pages, stride, total, st.acc);
    let summary: FunctionSummaryScan = summarize_functions<P, N>(pages, stride, total, functions, st.ok && function_list_ended<P, N>(pages, stride, total, st));
    return ValueSsaSummary { functions: functions, valid: summary.valid, function_count: summary.functions, supported_function_count: summary.supported, verified_function_count: summary.verified, value_count: summary.values, instruction_count: summary.instructions, block_count: summary.blocks, block_parameter_count: summary.parameters, unsupported_block_count: summary.unsupported, first_unsupported_function: summary.first_bad_function, first_unsupported_block: summary.first_bad_block, first_unsupported_kind: summary.first_bad_kind, call_count: summary.calls, has_call: summary.has_call, first_call_identity: summary.first_identity };
}
fn empty_ssa_summary(valid: bool) -> (result: ValueSsaSummary) {
    return ValueSsaSummary { functions: FunctionList.FNil, valid: valid, function_count: 0, supported_function_count: 0, verified_function_count: 0, value_count: 0, instruction_count: 0, block_count: 0, block_parameter_count: 0, unsupported_block_count: 0, first_unsupported_function: 0, first_unsupported_block: 0, first_unsupported_kind: 0, call_count: 0, has_call: false, first_call_identity: invalid_identity() };
}
fn function_list_ended<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FunctionWalk) -> (result: bool) {
    return match st.fns { DNil => st.index == flow.ssa_function_count<P, N>(pages, stride, total, st.lowered), DCons { head: h, tail: t } => false };
}
fn summarize_functions<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, functions: FunctionList, source_ok: bool) -> (result: FunctionSummaryScan) {
    iterate i up_to 1024 carrying st: FunctionSummaryScan = FunctionSummaryScan { rest: functions, valid: source_ok, functions: 0, supported: 0, verified: 0, values: 0, instructions: 0, blocks: 0, parameters: 0, calls: 0, has_call: false, first_identity: invalid_identity(), unsupported: 0, first_bad_function: 0, first_bad_block: 0, first_bad_kind: 0 } { next st = summarize_function_step<P, N>(pages, stride, total, st); }
    return st;
}
fn summarize_function_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FunctionSummaryScan) -> (result: FunctionSummaryScan) {
    return match st.rest { FNil => st, FCons { head: function, tail: rest } => summarize_function<P, N>(pages, stride, total, st, function, rest) };
}
fn summarize_function<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FunctionSummaryScan, function: Function, rest: FunctionList) -> (result: FunctionSummaryScan) {
    let shape: FunctionShape = summarize_blocks<P, N>(pages, stride, total, function.blocks);
    let has_call: bool = st.has_call || shape.has_call;
    let first: decl.SemanticIdentity = select_identity(st.has_call, st.first_identity, shape.first_identity);
    let first_bad: bool = st.unsupported == 0 && shape.unsupported > 0;
    return FunctionSummaryScan { rest: rest, valid: st.valid && function.verified, functions: st.functions + 1, supported: st.supported + select(function.supported, 1, 0), verified: st.verified + select(function.verified, 1, 0), values: st.values + function.value_count, instructions: st.instructions + shape.instructions, blocks: st.blocks + shape.blocks, parameters: st.parameters + shape.parameters, calls: st.calls + shape.calls, has_call: has_call, first_identity: first, unsupported: st.unsupported + shape.unsupported, first_bad_block: select(first_bad, shape.first_bad_block, st.first_bad_block), first_bad_kind: select(first_bad, shape.first_bad_kind, st.first_bad_kind), first_bad_function: select(first_bad, st.functions, st.first_bad_function) };
}
fn select_identity(already: bool, prior: decl.SemanticIdentity, candidate: decl.SemanticIdentity) -> (result: decl.SemanticIdentity) {
    if already { return prior; }
    return candidate;
}
fn summarize_blocks<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, blocks: SsaBlockList) -> (result: FunctionShape) {
    iterate i up_to 1024 carrying st: BlockShapeScan = BlockShapeScan { rest: blocks, blocks: 0, parameters: 0, instructions: 0, calls: 0, has_call: false, first_identity: invalid_identity(), unsupported: 0, first_bad_block: 0, first_bad_kind: 0 } { next st = summarize_block_step<P, N>(pages, stride, total, st); }
    return FunctionShape { blocks: st.blocks, parameters: st.parameters, instructions: st.instructions, calls: st.calls, has_call: st.has_call, first_identity: st.first_identity, unsupported: st.unsupported, first_bad_block: st.first_bad_block, first_bad_kind: st.first_bad_kind };
}
fn summarize_block_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockShapeScan) -> (result: BlockShapeScan) {
    return match st.rest { SsaBlockList.LNil => st, SsaBlockList.LCons { head: block, tail: rest } => summarize_block<P, N>(pages, stride, total, st, block, rest) };
}
fn summarize_block<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockShapeScan, block: SsaBlock, rest: SsaBlockList) -> (result: BlockShapeScan) {
    let instruction_shape: InstructionShapeScan = summarize_instructions<P, N>(pages, stride, total, block.instructions);
    let first: decl.SemanticIdentity = select_identity(st.has_call, st.first_identity, instruction_shape.first_identity);
    let is_bad: bool = !(block.lowering_ok);
    let first_bad: bool = st.unsupported == 0 && is_bad;
    return BlockShapeScan { rest: rest, blocks: st.blocks + 1, parameters: st.parameters + value_count<P, N>(pages, stride, total, block.parameters), instructions: st.instructions + instruction_shape.instructions, calls: st.calls + instruction_shape.calls, has_call: st.has_call || instruction_shape.has_call, first_identity: first, unsupported: st.unsupported + select(is_bad, 1, 0), first_bad_block: select(first_bad, block.id, st.first_bad_block), first_bad_kind: select(first_bad, block.lowering_failure_kind, st.first_bad_kind) };
}
record ValueCountScan { rest: ValueList, count: u64 }
fn value_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList) -> (result: u64) {
    iterate i up_to 1024 carrying st: ValueCountScan = ValueCountScan { rest: values, count: 0 } { next st = value_count_step(st); }
    return st.count;
}
fn value_count_step(st: ValueCountScan) -> (result: ValueCountScan) { return match st.rest { ValueList.VNil => st, ValueList.VCons { head: h, tail: t } => ValueCountScan { rest: t, count: st.count + 1 } }; }
fn summarize_instructions<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, instructions: InstructionList) -> (result: InstructionShapeScan) {
    iterate i up_to 1024 carrying st: InstructionShapeScan = InstructionShapeScan { rest: instructions, instructions: 0, calls: 0, has_call: false, first_identity: invalid_identity() } { next st = summarize_instruction_step(st); }
    return st;
}
fn summarize_instruction_step(st: InstructionShapeScan) -> (result: InstructionShapeScan) {
    return match st.rest { InstructionList.QNil => st, InstructionList.QCons { head: instruction, tail: rest } => summarize_instruction(st, instruction, rest) };
}
fn summarize_instruction(st: InstructionShapeScan, instruction: Instruction, rest: InstructionList) -> (result: InstructionShapeScan) {
    let is_call: bool = instruction.kind == 3;
    let first: decl.SemanticIdentity = select_identity(st.has_call, st.first_identity, instruction.identity);
    return InstructionShapeScan { rest: rest, instructions: st.instructions + 1, calls: st.calls + select(is_call, 1, 0), has_call: st.has_call || is_call, first_identity: first };
}
fn lower_function_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FunctionWalk, header: parser.Header) -> (result: FunctionWalk) {
    return match st.fns {
        DNil => st,
        DCons { head: fn_decl, tail: fns } => lower_flow_step<P, N>(pages, stride, total, st, header, fn_decl, fns)
    };
}
fn lower_flow_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FunctionWalk, header: parser.Header, fn_decl: decl.FnDecl, fns: decl.FnList) -> (result: FunctionWalk) {
    let cfg: flow.FunctionFlow = flow.ssa_function_at<P, N>(pages, stride, total, st.lowered, st.index);
    return finish_function_step<P, N>(pages, stride, total, st, header, fn_decl, fns, cfg);
}
fn finish_function_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FunctionWalk, header: parser.Header, fn_decl: decl.FnDecl, fns: decl.FnList, cfg: flow.FunctionFlow) -> (result: FunctionWalk) {
    let lowered: Function = lower_function<P, N>(pages, stride, total, header, fn_decl, cfg, st.lowered.proof.unit.records, st.lowered.proof.unit.enums, st.nominals);
    return FunctionWalk { fns: fns, lowered: st.lowered, index: st.index + 1, acc: FunctionList.FCons { head: lowered, tail: st.acc }, count: st.count + 1, nominals: st.nominals, ok: st.ok && lowered.verified };
}
fn reverse_functions<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, functions: FunctionList) -> (result: FunctionList) {
    iterate i up_to 1024 carrying st: FunctionReverse = FunctionReverse { rest: functions, acc: FunctionList.FNil } { next st = reverse_function_step(st); }
    return st.acc;
}
record FunctionReverse { rest: FunctionList, acc: FunctionList }
fn reverse_function_step(st: FunctionReverse) -> (result: FunctionReverse) {
    return match st.rest {
        FNil => st,
        FCons { head: h, tail: t } => FunctionReverse { rest: t, acc: FunctionList.FCons { head: h, tail: st.acc } }
    };
}

fn lower_function<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, header: parser.Header, fn_decl: decl.FnDecl, cfg: flow.FunctionFlow, records: decl.RecordList, enums: decl.EnumList, nominals: decl.NominalTypeIdentityList) -> (result: Function) {
    let identity: decl.SemanticIdentity = decl.canonical_function_identity<P, N>(pages, stride, total, header.module_start, header.module_end, fn_decl.sig.name_start, fn_decl.sig.name_end);
    let parameters: ParamBuild = function_parameters<P, N>(pages, stride, total, fn_decl.sig.params, records, enums, nominals);
    let result_type: decl.SemType = function_result_type<P, N>(pages, stride, total, fn_decl.sig.results, records, enums, nominals);
    let cfg_ok: bool = flow.ssa_cfg_verified(cfg);
    let result_ok: bool = supported_value_type<P, N>(pages, stride, total, result_type, nominals);
    let initial_failure: u64 = function_support_failure(cfg_ok, parameters.ok, result_ok, identity.valid);
    let initial: SsaBuild = SsaBuild {
        rest: flow.ssa_cfg_blocks(cfg), edges: EdgeList.ENil, blocks: SsaBlockList.LNil,
        values: parameters.values, inputs: parameters.inputs, entry_env: parameters.env,
        next_value: parameters.next_value, next_instruction: 0, next_block_id: cfg.block_count,
        result_type: result_type, identity: identity, nominals: nominals, entry: flow.ssa_cfg_entry(cfg),
        supported: cfg_ok && parameters.ok && result_ok && identity.valid,
        initial_failure_kind: initial_failure
    };
    iterate i up_to 1024 carrying st: SsaBuild = initial { next st = lower_block_step<P, N>(pages, stride, total, st); }
    let blocks: SsaBlockList = reverse_blocks<P, N>(pages, stride, total, st.blocks);
    let candidate: Function = Function {
        identity: st.identity, nominals: st.nominals, inputs: st.inputs, result_type: st.result_type,
        blocks: blocks, values: st.values, value_count: st.next_value,
        supported: st.supported, verified: false
    };
    let verified: bool = st.supported && verify_function<P, N>(pages, stride, total, candidate);
    return Function { ..candidate, verified: verified };
}
fn function_support_failure(cfg_ok: bool, parameters_ok: bool, result_ok: bool, identity_ok: bool) -> (result: u64) {
    if !(cfg_ok) { return 6; }
    if !(parameters_ok) { return 7; }
    if !(result_ok) { return 8; }
    if !(identity_ok) { return 9; }
    return 0;
}
fn function_parameters<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: decl.FieldList, records: decl.RecordList, enums: decl.EnumList, nominals: decl.NominalTypeIdentityList) -> (result: ParamBuild) {
    iterate i up_to 1024 carrying st: ParamBuild = ParamBuild { rest: fields, env: Environment.EnvNil, inputs: ValueList.VNil, values: ValueList.VNil, next_value: 0, ok: true } { next st = function_parameter_step<P, N>(pages, stride, total, st, records, enums, nominals); }
    return st;
}
fn function_parameter_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ParamBuild, records: decl.RecordList, enums: decl.EnumList, nominals: decl.NominalTypeIdentityList) -> (result: ParamBuild) {
    return match st.rest {
        decl.FieldList.FNil => st,
        decl.FieldList.FCons { head: field, tail: rest } => add_function_parameter<P, N>(pages, stride, total, st, field, rest, records, enums, nominals)
    };
}
fn add_function_parameter<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ParamBuild, field: decl.Field, rest: decl.FieldList, records: decl.RecordList, enums: decl.EnumList, nominals: decl.NominalTypeIdentityList) -> (result: ParamBuild) {
    let ty: decl.SemType = ssa_field_type<P, N>(pages, stride, total, field, records, enums, nominals);
    let value: Value = Value { id: st.next_value, ty: ty, owner_block: 0, kind: 0, index: 0 };
    let binding: Binding = Binding { name_start: field.name_start, name_end: field.name_end, value: value.id, ty: ty };
    return ParamBuild { rest: rest, env: Environment.EnvCons { head: binding, tail: st.env }, inputs: ValueList.VCons { head: value, tail: st.inputs }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, ok: st.ok && supported_value_type<P, N>(pages, stride, total, ty, nominals) };
}
fn function_result_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: decl.FieldList, records: decl.RecordList, enums: decl.EnumList, nominals: decl.NominalTypeIdentityList) -> (result: decl.SemType) {
    return match fields {
        decl.FieldList.FNil => SemType.TPoison,
        decl.FieldList.FCons { head: field, tail: rest } => ssa_field_type<P, N>(pages, stride, total, field, records, enums, nominals)
    };
}
fn ssa_field_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, field: decl.Field, records: decl.RecordList, enums: decl.EnumList, nominals: decl.NominalTypeIdentityList) -> (result: decl.SemType) {
    let resolved: decl.TyRes = decl.resolve_type<P, N>(pages, stride, total, field.type_kind, field.type_start, field.type_end, records, enums, nominals);
    return resolved.ty;
}
fn nominal_identity_for_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, ty: decl.SemType) -> (result: decl.SemanticIdentity) {
    return match ty {
        TNamed { start: start, end: end } => nominal_identity_for_span<P, N>(pages, stride, total, nominals, start, end),
        TBool => invalid_identity(),
        TByte => invalid_identity(),
        TInt { width: width, signed: signed } => invalid_identity(),
        TSeq => invalid_identity(),
        TSeqExact { element: element, length: length, length_valid: valid } => invalid_identity(),
        TPoison => invalid_identity()
    };
}
fn nominal_identity_for_span<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, start: u64, end: u64) -> (result: decl.SemanticIdentity) {
    let reference: decl.NominalLookup = decl.nominal_identity_at<P, N>(pages, stride, total, nominals, start, end);
    if reference.found { return reference.identity; }
    let local: decl.NominalLookup = decl.nominal_identity_by_name<P, N>(pages, stride, total, nominals, start, end);
    if local.found { return local.identity; }
    return invalid_identity();
}
record ConstructSourceCheck { fields: decl.ConstructFieldList, params: decl.BindList, ok: bool }
fn enum_construct_source_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: decl.SemType, variant_start: u64, variant_end: u64, params: decl.BindList, start: u64, end: u64) -> (result: bool) {
    let parsed: decl.ExprParse = decl.parse_expr<P, N>(pages, stride, total, start, true);
    if !(parsed.ok) || parsed.start != start || parsed.end != end { return false; }
    return match parsed.node {
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: fields, start: es, end: ee } => enum_construct_source_parts<P, N>(pages, stride, total, ty, variant_start, variant_end, params, start, end, ts, te, vs, ve, fields),
        Index { base: ib, index: ii, start: is, end: ie } => false,
        Cast { value: cv, type_start: cts, type_end: cte, type_kind: ctk, start: cs, end: ce } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: fields, start: es, end: ee } => false,
        Name { start: ns, end: ne } => false,
        Integer { start: ns, end: ne, value: value, overflow: overflow } => false,
        Boolean { start: ns, end: ne, value: value } => false,
        UnaryNot { value: value, start: ns, end: ne } => false,
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: ns, end: ne } => false,
        ScalarMatch { subject: subject, arms: arms, start: ns, end: ne } => false,
        Binary { op: op, left: left, right: right, start: ns, end: ne } => false,
        Call { name_start: ns, name_end: ne, args: args, targs: tg, start: es, end: ee } => false,
        Project { base: base, field_start: fs, field_end: fe, start: es, end: ee, path: path } => enum_construct_project_source<P, N>(pages, stride, total, ty, variant_start, variant_end, params, start, end, base, fs, fe, path),
        FiniteMatch { subject: subject, arms: arms, start: ns, end: ne } => false,
        OpCall { slot: slot, name_start: ons, name_end: one, args: a, start: s, end: e } => false
    };
}
fn enum_construct_project_source<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: decl.SemType, variant_start: u64, variant_end: u64, params: decl.BindList, start: u64, end: u64, base: decl.Expr, field_start: u64, field_end: u64, path: bool) -> (result: bool) {
    if !(path) { return false; }
    return match base {
        Name { start: type_start, end: type_end } => enum_construct_source_parts<P, N>(pages, stride, total, ty, variant_start, variant_end, params, start, end, type_start, type_end, field_start, field_end, decl.ConstructFieldList.CNil),
        Integer { start: s, end: e, value: value, overflow: overflow } => false,
        Boolean { start: s, end: e, value: value } => false,
        UnaryNot { value: value, start: s, end: e } => false,
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => false,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => false,
        Binary { op: op, left: left, right: right, start: s, end: e } => false,
        Call { name_start: ns, name_end: ne, args: args, targs: tg, start: s, end: e } => false,
        Project { base: b, field_start: fs, field_end: fe, start: s, end: e, path: p } => false,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => false,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: fields, start: s, end: e } => false,
        Index { base: ib, index: ii, start: is, end: ie } => false,
        Cast { value: cv, type_start: cts, type_end: cte, type_kind: ctk, start: cs, end: ce } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: fields, start: s, end: e } => false,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => false
    };
}
fn enum_construct_source_parts<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: decl.SemType, variant_start: u64, variant_end: u64, params: decl.BindList, start: u64, end: u64, type_start: u64, type_end: u64, source_variant_start: u64, source_variant_end: u64, fields: decl.ConstructFieldList) -> (result: bool) {
    let type_ok: bool = match ty {
        TNamed { start: ts, end: te } => ts == type_start && te == type_end,
        TBool => false,
        TByte => false,
        TInt { width: width, signed: signed } => false,
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: valid } => false,
        TPoison => false
    };
    let scan: ConstructSourceCheck = ConstructSourceCheck { fields: fields, params: params, ok: true };
    iterate i up_to 1024 carrying st: ConstructSourceCheck = scan { next st = construct_source_field_step<P, N>(pages, stride, total, st); }
    return type_ok && source_variant_start == variant_start && source_variant_end == variant_end && st.ok && decl.construct_fields_empty(st.fields) && bind_list_empty(st.params);
}
fn construct_source_field_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ConstructSourceCheck) -> (result: ConstructSourceCheck) {
    if !(st.ok) { return st; }
    return match st.fields {
        decl.ConstructFieldList.CNil => ConstructSourceCheck { ..st, ok: bind_list_empty(st.params) },
        decl.ConstructFieldList.CCons { head: field, tail: rest } => construct_source_field_parameter<P, N>(pages, stride, total, st, field, rest)
    };
}
fn construct_source_field_parameter<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ConstructSourceCheck, field: decl.ConstructField, rest: decl.ConstructFieldList) -> (result: ConstructSourceCheck) {
    return match st.params {
        decl.BindList.BNil => ConstructSourceCheck { ..st, fields: rest, ok: false },
        decl.BindList.BCons { head: parameter, tail: params } => ConstructSourceCheck { fields: rest, params: params, ok: decl.spans_equal<P, N>(pages, stride, total, field.field_start, field.field_end, parameter.start, parameter.end) }
    };
}

fn lower_block_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SsaBuild) -> (result: SsaBuild) {
    return match st.rest {
        flow.BlockList.BNil => st,
        flow.BlockList.BCons { head: block, tail: rest } => lower_one_block<P, N>(pages, stride, total, st, block, rest)
    };
}
fn lower_one_block<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: SsaBuild, block: flow.Block, rest: flow.BlockList) -> (result: SsaBuild) {
    let incoming: Incoming = incoming_for<P, N>(pages, stride, total, block.id, st.edges);
    let prepared: BlockParamBuild = prepare_block_environment<P, N>(pages, stride, total, block.id, incoming, st.next_value, st.values, st.nominals);
    // Entry inputs already carry the parameter environment; non-entry blocks
    // get fresh, typed block parameters matched against predecessor edges.
    let actual_env: Environment = entry_or_parameters(block.id, st.entry, st.entry_env, incoming, prepared.env);
    let params: ValueList = select_block_parameters(block.id, st.entry, prepared.params);
    let expression_seed: ExpressionBuild = ExpressionBuild {
        rest: block.expressions, env: actual_env, instructions: InstructionList.QNil,
        values: prepared.values, next_value: prepared.next_value,
        next_instruction: st.next_instruction, sequence: 0, block: block.id,
        branch_value: 0, return_value: 0, has_branch: false, has_return: false,
        parameters: params, generated_blocks: SsaBlockList.LNil, next_block_id: st.next_block_id,
        nominals: st.nominals,
        ok: st.supported && (block.id == st.entry || (incoming.found && incoming.ok)),
        failure_op: 0
    };
    iterate i up_to 1024 carrying exprs: ExpressionBuild = expression_seed { next exprs = lower_expression_step<P, N>(pages, stride, total, exprs); }
    let instructions: InstructionList = reverse_instructions<P, N>(pages, stride, total, exprs.instructions);
    let term: Terminator = make_terminator<P, N>(pages, stride, total, block, exprs);
    let edges: EdgeList = add_block_edges_from<P, N>(pages, stride, total, st.edges, exprs.block, block, term, exprs.env);
    let block_ok: bool = exprs.ok && terminator_shape(block, term);
    let local_failure: u64 = classify_block_failure(block, st.entry, incoming, exprs, term, st.supported);
    let failure_kind: u64 = select(st.initial_failure_kind > 0, st.initial_failure_kind, local_failure);
    let ssa_block: SsaBlock = SsaBlock { id: exprs.block, parameters: exprs.parameters, instructions: instructions, terminator: term, reachable: block.reachable, lowering_ok: block_ok, lowering_failure_kind: failure_kind };
    let prior_blocks: SsaBlockList = prepend_generated_blocks<P, N>(pages, stride, total, exprs.generated_blocks, st.blocks);
    return SsaBuild {
        rest: rest, edges: edges, blocks: SsaBlockList.LCons { head: ssa_block, tail: prior_blocks },
        values: exprs.values, inputs: st.inputs, entry_env: st.entry_env, next_value: exprs.next_value,
        next_instruction: exprs.next_instruction, next_block_id: exprs.next_block_id, result_type: st.result_type,
        identity: st.identity, nominals: st.nominals, entry: st.entry, supported: block_ok,
        initial_failure_kind: st.initial_failure_kind
    };
}
record GeneratedBlockPrepend { rest: SsaBlockList, blocks: SsaBlockList }
fn prepend_generated_blocks<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, generated: SsaBlockList, blocks: SsaBlockList) -> (result: SsaBlockList) {
    iterate i up_to 1024 carrying st: GeneratedBlockPrepend = GeneratedBlockPrepend { rest: generated, blocks: blocks } { next st = prepend_generated_step(st); }
    return st.blocks;
}
fn prepend_generated_step(st: GeneratedBlockPrepend) -> (result: GeneratedBlockPrepend) {
    return match st.rest { LNil => st, LCons { head: block, tail: rest } => GeneratedBlockPrepend { rest: rest, blocks: SsaBlockList.LCons { head: block, tail: st.blocks } } };
}
// Block failure taxonomy: 0 ok, 1 missing incoming, 2 bad incoming,
// 3 other expression failure, 4 terminator shape, 5 prior unsupported,
// 6 repeat literal, 7 scalar match, 8 field projection, 9 finite match,
// 10 enum construction. Kinds 6-10 name the first explicitly deferred
// typed operation in the block.
fn classify_block_failure(block: flow.Block, entry: u64, incoming: Incoming, exprs: ExpressionBuild, term: Terminator, prior_supported: bool) -> (result: u64) {
    if !(prior_supported) { return 5; }
    if block.id != entry && !(incoming.found) { return 1; }
    if block.id != entry && !(incoming.ok) { return 2; }
    if !(exprs.ok) {
        if exprs.failure_op > 0 { return 5 + exprs.failure_op; }
        return 3;
    }
    if !(terminator_shape(block, term)) { return 4; }
    return 0;
}
fn select_block_parameters(block: u64, entry: u64, params: ValueList) -> (result: ValueList) {
    if block == entry { return ValueList.VNil; }
    return params;
}
fn entry_or_parameters(block: u64, entry: u64, entry_env: Environment, incoming: Incoming, env: Environment) -> (result: Environment) {
    if block == entry { return entry_env; }
    if !(incoming.found) || !(incoming.ok) { return Environment.EnvNil; }
    return env;
}

fn prepare_block_environment<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, block: u64, incoming: Incoming, next_value: u64, values: ValueList, nominals: decl.NominalTypeIdentityList) -> (result: BlockParamBuild) {
    if !(incoming.found) || !(incoming.ok) { return BlockParamBuild { rest: Environment.EnvNil, env: Environment.EnvNil, params: ValueList.VNil, values: values, next_value: next_value, parameter_index: 0, block: block, nominals: nominals, ok: block == 0 }; }
    iterate i up_to 1024 carrying built: BlockParamBuild = BlockParamBuild { rest: incoming.bindings, env: Environment.EnvNil, params: ValueList.VNil, values: values, next_value: next_value, parameter_index: 0, block: block, nominals: nominals, ok: true } { next built = block_parameter_step<P, N>(pages, stride, total, built); }
    return BlockParamBuild { ..built, env: reverse_environment<P, N>(pages, stride, total, built.env) };
}
record EnvironmentReverse { rest: Environment, acc: Environment }
fn reverse_environment<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, env: Environment) -> (result: Environment) {
    iterate i up_to 1024 carrying st: EnvironmentReverse = EnvironmentReverse { rest: env, acc: Environment.EnvNil } { next st = reverse_environment_step(st); }
    return st.acc;
}
fn reverse_environment_step(st: EnvironmentReverse) -> (result: EnvironmentReverse) {
    return match st.rest { Environment.EnvNil => st, Environment.EnvCons { head: binding, tail: rest } => EnvironmentReverse { rest: rest, acc: Environment.EnvCons { head: binding, tail: st.acc } } };
}
fn block_parameter_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockParamBuild) -> (result: BlockParamBuild) {
    return match st.rest {
        EnvNil => st,
        EnvCons { head: binding, tail: rest } => add_block_parameter<P, N>(pages, stride, total, st, binding, rest)
    };
}
fn add_block_parameter<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockParamBuild, binding: Binding, rest: Environment) -> (result: BlockParamBuild) {
    let value: Value = Value { id: st.next_value, ty: binding.ty, owner_block: st.block, kind: 1, index: st.parameter_index };
    let mapped: Binding = Binding { name_start: binding.name_start, name_end: binding.name_end, value: value.id, ty: binding.ty };
    return BlockParamBuild { rest: rest, env: Environment.EnvCons { head: mapped, tail: st.env }, params: ValueList.VCons { head: value, tail: st.params }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, parameter_index: st.parameter_index + 1, block: st.block, nominals: st.nominals, ok: st.ok && supported_value_type<P, N>(pages, stride, total, binding.ty, st.nominals) };
}

fn incoming_for<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, target: u64, edges: EdgeList) -> (result: Incoming) {
    iterate i up_to 1024 carrying st: IncomingScan = IncomingScan { rest: edges, target: target, found: false, ok: true, count: 0, bindings: Environment.EnvNil } { next st = incoming_step<P, N>(pages, stride, total, st); }
    return Incoming { found: st.found, ok: st.ok, count: st.count, bindings: st.bindings };
}
fn incoming_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: IncomingScan) -> (result: IncomingScan) {
    return match st.rest {
        ENil => st,
        ECons { head: edge, tail: rest } => incoming_cons<P, N>(pages, stride, total, st, edge, rest)
    };
}
fn incoming_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: IncomingScan, edge: Edge, rest: EdgeList) -> (result: IncomingScan) {
    if edge.target != st.target { return IncomingScan { ..st, rest: rest }; }
    if !(st.found) { return IncomingScan { rest: rest, target: st.target, found: true, ok: st.ok, count: 1, bindings: edge.bindings }; }
    return IncomingScan { rest: rest, target: st.target, found: true, ok: st.ok && same_binding_shape<P, N>(pages, stride, total, edge.bindings, st.bindings), count: st.count + 1, bindings: st.bindings };
}
record BindingPairCheck { left: Environment, right: Environment, ok: bool }
fn same_binding_shape<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, left: Environment, right: Environment) -> (result: bool) {
    iterate i up_to 1024 carrying st: BindingPairCheck = BindingPairCheck { left: left, right: right, ok: true } { next st = binding_pair_step<P, N>(pages, stride, total, st); }
    return st.ok && binding_list_empty(st.left) && binding_list_empty(st.right);
}
fn binding_list_empty(bindings: Environment) -> (result: bool) { return match bindings { EnvNil => true, EnvCons { head: h, tail: t } => false }; }
fn binding_pair_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BindingPairCheck) -> (result: BindingPairCheck) {
    if !(st.ok) { return st; }
    return match st.left {
        EnvNil => BindingPairCheck { ..st, ok: binding_list_empty(st.right) },
        EnvCons { head: a, tail: ar } => binding_pair_right<P, N>(pages, stride, total, st, a, ar)
    };
}
fn binding_pair_right<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BindingPairCheck, a: Binding, ar: Environment) -> (result: BindingPairCheck) {
    return match st.right {
        EnvNil => BindingPairCheck { left: ar, right: Environment.EnvNil, ok: false },
        EnvCons { head: b, tail: br } => BindingPairCheck { left: ar, right: br, ok: a.name_start == b.name_start && a.name_end == b.name_end && decl.sem_eq<P, N>(pages, stride, total, a.ty, b.ty) }
    };
}

fn lower_expression_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExpressionBuild) -> (result: ExpressionBuild) {
    return match st.rest {
        flow.TypedExprList.ENil => st,
        flow.TypedExprList.ECons { head: expression, tail: rest } => lower_expression<P, N>(pages, stride, total, st, expression, rest)
    };
}
fn lower_expression<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExpressionBuild, expression: flow.TypedExpr, rest: flow.TypedExprList) -> (result: ExpressionBuild) {
    let seed: ExprBuild = ExprBuild { rest: expression.ops, env: st.env, stack: ValueStack.WNil, instructions: st.instructions, values: st.values, next_value: st.next_value, next_instruction: st.next_instruction, sequence: st.sequence, block: st.block, parameters: st.parameters, generated_blocks: st.generated_blocks, next_block_id: st.next_block_id, nominals: st.nominals, ok: st.ok, failure_op: 0 };
    iterate i up_to 1024 carrying built: ExprBuild = seed { next built = lower_operation_step<P, N>(pages, stride, total, built); }
    let value: Value = expression_value(built.stack);
    let one_value: bool = expression_stack_single(built.stack);
    let env: Environment = bind_let_result(expression, st.env, value);
    let branch_value: u64 = select(expression.role == 2, value.id, st.branch_value);
    let return_value: u64 = select(expression.role == 3, value.id, st.return_value);
    return ExpressionBuild {
        rest: rest, env: env, instructions: built.instructions, values: built.values,
        next_value: built.next_value, next_instruction: built.next_instruction,
        sequence: built.sequence, block: built.block, branch_value: branch_value,
        return_value: return_value, has_branch: st.has_branch || expression.role == 2,
        has_return: st.has_return || expression.role == 3,
        parameters: built.parameters, generated_blocks: built.generated_blocks, next_block_id: built.next_block_id,
        nominals: st.nominals,
        ok: built.ok && one_value && (expression.role != 1 || expression.binding_end > expression.binding_start),
        failure_op: select(st.failure_op > 0, st.failure_op, built.failure_op)
    };
}
fn bind_let_result(expression: flow.TypedExpr, env: Environment, value: Value) -> (result: Environment) {
    if expression.role != 1 { return env; }
    return Environment.EnvCons { head: Binding { name_start: expression.binding_start, name_end: expression.binding_end, value: value.id, ty: value.ty }, tail: env };
}
fn expression_stack_single(stack: ValueStack) -> (result: bool) {
    return match stack { WNil => false, WCons { head: h, tail: t } => match t { WNil => true, WCons { head: x, tail: xs } => false } };
}
fn expression_value(stack: ValueStack) -> (result: Value) {
    return match stack { WNil => Value { id: 0, ty: decl.SemType.TPoison, owner_block: 0, kind: 0, index: 0 }, WCons { head: h, tail: t } => h };
}
fn expression_stack_tail(stack: ValueStack) -> (result: ValueStack) {
    return match stack { WNil => ValueStack.WNil, WCons { head: h, tail: t } => t };
}
// Arm jumps carry the join's context from the block the arm actually
// finished in. Straight-line arms finish in their entry block, where the
// prepared context is available unchanged; an arm containing a nested
// match finishes in that match's join, where only the join's rebound
// context (current env plus the stack below the result) is available.
// Anything else keeps the prepared shape and fails closed as before.
fn arm_jump_args<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, moved: bool, current_ok: bool, current_env: Environment, current_stack: ValueStack, result_id: u64, prepared_env: Environment, prepared_stack: ValueStack) -> (result: IdList) {
    if moved && current_ok {
        return append_ids<P, N>(pages, stride, total, IdList.ICons { head: Id { value: result_id }, tail: IdList.INil }, match_context_ids<P, N>(pages, stride, total, current_env, expression_stack_tail(current_stack)));
    }
    return append_ids<P, N>(pages, stride, total, IdList.ICons { head: Id { value: result_id }, tail: IdList.INil }, match_context_ids<P, N>(pages, stride, total, prepared_env, prepared_stack));
}

fn lower_operation_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild) -> (result: ExprBuild) {
    return match st.rest {
        decl.TOpList.PNil => st,
        decl.TOpList.PCons { head: operation, tail: rest } => lower_operation<P, N>(pages, stride, total, st, operation, rest)
    };
}
fn lower_operation<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, operation: decl.TOp, rest: decl.TOpList) -> (result: ExprBuild) {
    return match operation {
        TInt { value: v, ty: ty, start: s, end: e } => emit_constant(st, rest, 0, v, false, ty, s, e),
        TBool { value: v, ty: ty, start: s, end: e } => emit_constant(st, rest, 1, 0, v, ty, s, e),
        TName { ty: ty, start: s, end: e } => lower_name<P, N>(pages, stride, total, st, rest, ty, s, e),
        TNot { ty: ty, start: s, end: e } => lower_not<P, N>(pages, stride, total, st, rest, ty, s, e),
        TRepeat { ty: ty, element: element, count: count, start: s, end: e } => lower_repeat<P, N>(pages, stride, total, st, rest, ty, element, count, s, e),
        TMatch { ty: ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, default_count: default_count, start: s, end: e } => lower_scalar_match<P, N>(pages, stride, total, st, rest, ty, subject_ty, arms, arm_count, default_count, s, e),
        TFiniteMatch { ty: ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, start: s, end: e } => lower_finite_match<P, N>(pages, stride, total, st, rest, ty, subject_ty, arms, arm_count, s, e),
        TEnumConstruct { ty: ty, variant_start: vs, variant_end: ve, field_count: f, params: params, start: s, end: e } => lower_enum_construct<P, N>(pages, stride, total, st, rest, ty, vs, ve, f, params, s, e),
        TBin { op: op, ty: ty, start: s, end: e } => lower_binary<P, N>(pages, stride, total, st, rest, op, ty, s, e),
        TCall { ty: ty, argc: argc, params: params, start: s, end: e, ns: ns, ne: ne, identity: identity, effects: effects, capabilities: capabilities } => lower_call<P, N>(pages, stride, total, st, rest, ty, argc, params, identity, effects, capabilities, s, e),
        TProj { ty: ty, fstart: fs, fend: fe, field_index: index, start: s, end: e } => lower_project<P, N>(pages, stride, total, st, rest, ty, fs, fe, index, s, e),
        TOp { slot: slot, ty: ty, argc: argc, ns: ns, ne: ne, identity: identity, start: s, end: e } => lower_top_op<P, N>(pages, stride, total, st, rest, ty, slot, argc, ns, ne, identity, s, e)
    };
}
fn lower_finite_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, result_ty: decl.SemType, subject_ty: decl.SemType, arms: decl.TypedFiniteMatchArmList, arm_count: u64, start: u64, end: u64) -> (result: ExprBuild) {
    return match st.stack {
        WNil => ExprBuild { ..st, rest: rest, ok: false, failure_op: select(st.failure_op > 0, st.failure_op, 4) },
        WCons { head: subject, tail: base_stack } => lower_finite_match_subject<P, N>(pages, stride, total, st, rest, result_ty, subject_ty, arms, arm_count, start, end, subject, base_stack)
    };
}
fn lower_finite_match_subject<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, result_ty: decl.SemType, subject_ty: decl.SemType, arms: decl.TypedFiniteMatchArmList, arm_count: u64, start: u64, end: u64, subject: Value, base_stack: ValueStack) -> (result: ExprBuild) {
    let nominal: decl.SemanticIdentity = nominal_identity_for_type<P, N>(pages, stride, total, st.nominals, subject_ty);
    let actual_count: u64 = decl.typed_finite_match_count<P, N>(pages, stride, total, arms);
    let basic_ok: bool = nominal.valid && actual_count == arm_count && arm_count > 0 && decl.sem_eq<P, N>(pages, stride, total, subject.ty, subject_ty) && supported_value_type<P, N>(pages, stride, total, result_ty, st.nominals);
    if !(basic_ok) { return ExprBuild { ..st, rest: rest, ok: false, failure_op: select(st.failure_op > 0, st.failure_op, 4) }; }
    let join_id: u64 = st.next_block_id + arm_count;
    let join_context: MatchContextBuild = match_context_parameters<P, N>(pages, stride, total, st.env, base_stack, join_id, st.next_value, st.values, st.nominals);
    let join_result: Value = Value { id: join_context.next_value, ty: result_ty, owner_block: join_id, kind: 1, index: join_context.parameter_index };
    let join_params: ValueList = ValueList.VCons { head: join_result, tail: join_context.parameters };
    let join_values: ValueList = ValueList.VCons { head: join_result, tail: join_context.values };
    let source_args: IdList = append_ids<P, N>(pages, stride, total, IdList.ICons { head: Id { value: subject.id }, tail: IdList.INil }, match_context_ids<P, N>(pages, stride, total, st.env, base_stack));
    let source: ExprBuild = ExprBuild { ..st, rest: rest, stack: base_stack, values: join_values, next_value: join_context.next_value + 1, next_instruction: st.next_instruction, next_block_id: st.next_block_id };
    let initial: FiniteArmBuild = FiniteArmBuild { rest: arms, source: source, cases: FiniteMatchCaseList.MCNil, arm_blocks: SsaBlockList.LNil, arm_index: 0, arm_count: arm_count, join_id: join_id, join_env: join_context.env, join_stack: join_context.stack, join_params: join_params, join_result: join_result, source_arguments: source_args, nominal: nominal, subject: subject, subject_ty: subject_ty, result_ty: result_ty, match_start: start, match_end: end, next_value: join_context.next_value + 1, next_instruction: st.next_instruction, next_block: join_id + 1, ok: join_context.ok };
    iterate i up_to 1024 carrying built: FiniteArmBuild = initial { next built = finite_arm_step<P, N>(pages, stride, total, built); }
    let ordered_cases: FiniteMatchCaseList = reverse_finite_match_cases<P, N>(pages, stride, total, built.cases);
    let source_term: Terminator = Terminator.FiniteSwitch { subject: subject.id, subject_ty: subject_ty, nominal_identity: nominal, result_type: result_ty, source_start: start, source_end: end, arm_count: arm_count, join_target: join_id, cases: ordered_cases };
    let source_block: SsaBlock = SsaBlock { id: st.block, parameters: st.parameters, instructions: reverse_instructions<P, N>(pages, stride, total, st.instructions), terminator: source_term, reachable: true, lowering_ok: st.ok && built.ok, lowering_failure_kind: select(st.ok && built.ok, 0, 9) };
    let fresh_blocks: SsaBlockList = SsaBlockList.LCons { head: source_block, tail: built.arm_blocks };
    let all_blocks: SsaBlockList = prepend_generated_blocks<P, N>(pages, stride, total, fresh_blocks, st.generated_blocks);
    return ExprBuild { rest: rest, env: built.join_env, stack: ValueStack.WCons { head: built.join_result, tail: built.join_stack }, instructions: InstructionList.QNil, values: built.source.values, next_value: built.next_value, next_instruction: built.next_instruction, sequence: 0, block: join_id, parameters: built.join_params, generated_blocks: all_blocks, next_block_id: built.next_block, nominals: st.nominals, ok: st.ok && built.ok, failure_op: select(st.failure_op > 0, st.failure_op, select(built.ok, 0, 4)) };
}
fn finite_arm_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FiniteArmBuild) -> (result: FiniteArmBuild) {
    return match st.rest {
        decl.TypedFiniteMatchArmList.TFNil => st,
        decl.TypedFiniteMatchArmList.TFCons { head: arm, tail: rest } => lower_finite_arm<P, N>(pages, stride, total, st, arm, rest)
    };
}
record MatchCaseReverse { rest: FiniteMatchCaseList, acc: FiniteMatchCaseList }
fn reverse_finite_match_cases<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cases: FiniteMatchCaseList) -> (result: FiniteMatchCaseList) {
    iterate i up_to 1024 carrying st: MatchCaseReverse = MatchCaseReverse { rest: cases, acc: FiniteMatchCaseList.MCNil } { next st = reverse_finite_match_cases_step(st); }
    return st.acc;
}
fn reverse_finite_match_cases_step(st: MatchCaseReverse) -> (result: MatchCaseReverse) {
    return match st.rest { FiniteMatchCaseList.MCNil => st, FiniteMatchCaseList.MCCons { head: case, tail: rest } => MatchCaseReverse { rest: rest, acc: FiniteMatchCaseList.MCCons { head: case, tail: st.acc } } };
}
fn lower_finite_arm<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FiniteArmBuild, arm: decl.TypedFiniteMatchArm, rest: decl.TypedFiniteMatchArmList) -> (result: FiniteArmBuild) {
    let arm_id: u64 = st.source.next_block_id + st.arm_index;
    let prepared: MatchContextBuild = match_context_parameters<P, N>(pages, stride, total, st.source.env, st.source.stack, arm_id, st.next_value, st.source.values, st.source.nominals);
    let subject_param: Value = Value { id: prepared.next_value, ty: st.subject_ty, owner_block: arm_id, kind: 1, index: prepared.parameter_index };
    let arm_params: ValueList = ValueList.VCons { head: subject_param, tail: prepared.parameters };
    let values_with_subject: ValueList = ValueList.VCons { head: subject_param, tail: prepared.values };
    let payloads: PayloadLowerBuild = lower_match_payloads<P, N>(pages, stride, total, arm.bindings, arm.payload_fields, prepared.env, subject_param.id, arm.variant_start, arm.variant_end, st.nominal, st.match_start, st.match_end, InstructionList.QNil, values_with_subject, prepared.next_value + 1, st.next_instruction, 0, arm_id, st.source.nominals, prepared.ok);
    let arm_seed: ExprBuild = ExprBuild { rest: arm.ops, env: payloads.env, stack: ValueStack.WNil, instructions: payloads.instructions, values: payloads.values, next_value: payloads.next_value, next_instruction: payloads.next_instruction, sequence: payloads.sequence, block: arm_id, parameters: arm_params, generated_blocks: SsaBlockList.LNil, next_block_id: st.next_block, nominals: st.source.nominals, ok: payloads.ok, failure_op: 0 };
    let lowered: ExprBuild = lower_nested_arm_ops<P, N>(pages, stride, total, arm_seed);
    let result: Value = expression_value(lowered.stack);
    let result_ok: bool = expression_stack_single(lowered.stack) && decl.sem_eq<P, N>(pages, stride, total, result.ty, st.result_ty);
    let jump_args: IdList = arm_jump_args<P, N>(pages, stride, total, lowered.block != arm_id, prepared.ok && lowered.ok && result_ok, lowered.env, lowered.stack, result.id, prepared.env, prepared.stack);
    let arm_term: Terminator = Terminator.Jump { target: st.join_id, arguments: jump_args };
    let arm_block: SsaBlock = SsaBlock { id: lowered.block, parameters: lowered.parameters, instructions: reverse_instructions<P, N>(pages, stride, total, lowered.instructions), terminator: arm_term, reachable: true, lowering_ok: lowered.ok && result_ok && prepared.ok, lowering_failure_kind: select(lowered.ok && result_ok && prepared.ok, 0, 9) };
    let edge_case: FiniteMatchCase = FiniteMatchCase { variant_start: arm.variant_start, variant_end: arm.variant_end, target: arm_id, arguments: st.source_arguments };
    let source_next: ExprBuild = ExprBuild { ..st.source, values: lowered.values, next_value: lowered.next_value, next_instruction: lowered.next_instruction };
    let fresh_arm: SsaBlockList = SsaBlockList.LCons { head: arm_block, tail: lowered.generated_blocks };
    let arm_blocks: SsaBlockList = prepend_generated_blocks<P, N>(pages, stride, total, fresh_arm, st.arm_blocks);
    let bumped: u64 = select(lowered.next_block_id > st.next_block, lowered.next_block_id, st.next_block);
    return FiniteArmBuild { rest: rest, source: source_next, cases: FiniteMatchCaseList.MCCons { head: edge_case, tail: st.cases }, arm_blocks: arm_blocks, arm_index: st.arm_index + 1, arm_count: st.arm_count, join_id: st.join_id, join_env: st.join_env, join_stack: st.join_stack, join_params: st.join_params, join_result: st.join_result, source_arguments: st.source_arguments, nominal: st.nominal, subject: st.subject, subject_ty: st.subject_ty, result_ty: st.result_ty, match_start: st.match_start, match_end: st.match_end, next_value: lowered.next_value, next_instruction: lowered.next_instruction, next_block: bumped, ok: st.ok && prepared.ok && payloads.ok && lowered.ok && result_ok };
}
fn lower_scalar_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, result_ty: decl.SemType, subject_ty: decl.SemType, arms: decl.TypedScalarMatchArmList, arm_count: u64, default_count: u64, start: u64, end: u64) -> (result: ExprBuild) {
    return match st.stack {
        WNil => ExprBuild { ..st, rest: rest, ok: false, failure_op: select(st.failure_op > 0, st.failure_op, 2) },
        WCons { head: subject, tail: base_stack } => lower_scalar_match_subject<P, N>(pages, stride, total, st, rest, result_ty, subject_ty, arms, arm_count, default_count, start, end, subject, base_stack)
    };
}
fn lower_scalar_match_subject<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, result_ty: decl.SemType, subject_ty: decl.SemType, arms: decl.TypedScalarMatchArmList, arm_count: u64, default_count: u64, start: u64, end: u64, subject: Value, base_stack: ValueStack) -> (result: ExprBuild) {
    let actual_count: u64 = typed_scalar_match_arm_total<P, N>(pages, stride, total, arms);
    let basic_ok: bool = decl.is_int_ty(subject_ty) && actual_count == arm_count && arm_count > 0 && default_count == 1 && decl.sem_eq<P, N>(pages, stride, total, subject.ty, subject_ty) && supported_value_type<P, N>(pages, stride, total, result_ty, st.nominals);
    if !(basic_ok) { return ExprBuild { ..st, rest: rest, ok: false, failure_op: select(st.failure_op > 0, st.failure_op, 2) }; }
    let join_id: u64 = st.next_block_id + arm_count;
    let join_context: MatchContextBuild = match_context_parameters<P, N>(pages, stride, total, st.env, base_stack, join_id, st.next_value, st.values, st.nominals);
    let join_result: Value = Value { id: join_context.next_value, ty: result_ty, owner_block: join_id, kind: 1, index: join_context.parameter_index };
    let join_params: ValueList = ValueList.VCons { head: join_result, tail: join_context.parameters };
    let join_values: ValueList = ValueList.VCons { head: join_result, tail: join_context.values };
    let source_args: IdList = match_context_ids<P, N>(pages, stride, total, st.env, base_stack);
    let source: ExprBuild = ExprBuild { ..st, rest: rest, stack: base_stack, values: join_values, next_value: join_context.next_value + 1, next_instruction: st.next_instruction, next_block_id: st.next_block_id };
    let initial: ScalarArmBuild = ScalarArmBuild { rest: arms, source: source, cases: ScalarMatchCaseList.SCNil, arm_blocks: SsaBlockList.LNil, arm_index: 0, arm_count: arm_count, join_id: join_id, join_env: join_context.env, join_stack: join_context.stack, join_params: join_params, join_result: join_result, source_arguments: source_args, default_target: 0, subject: subject, subject_ty: subject_ty, result_ty: result_ty, match_start: start, match_end: end, next_value: join_context.next_value + 1, next_instruction: st.next_instruction, next_block: join_id + 1, ok: join_context.ok };
    iterate i up_to 1024 carrying built: ScalarArmBuild = initial { next built = scalar_arm_step<P, N>(pages, stride, total, built); }
    let ordered_cases: ScalarMatchCaseList = reverse_scalar_match_cases<P, N>(pages, stride, total, built.cases);
    let source_term: Terminator = Terminator.ScalarSwitch { subject: subject.id, subject_ty: subject_ty, result_type: result_ty, source_start: start, source_end: end, arm_count: arm_count, default_target: built.default_target, join_target: join_id, cases: ordered_cases };
    let source_block: SsaBlock = SsaBlock { id: st.block, parameters: st.parameters, instructions: reverse_instructions<P, N>(pages, stride, total, st.instructions), terminator: source_term, reachable: true, lowering_ok: st.ok && built.ok, lowering_failure_kind: select(st.ok && built.ok, 0, 9) };
    let fresh_blocks: SsaBlockList = SsaBlockList.LCons { head: source_block, tail: built.arm_blocks };
    let all_blocks: SsaBlockList = prepend_generated_blocks<P, N>(pages, stride, total, fresh_blocks, st.generated_blocks);
    return ExprBuild { rest: rest, env: built.join_env, stack: ValueStack.WCons { head: built.join_result, tail: built.join_stack }, instructions: InstructionList.QNil, values: built.source.values, next_value: built.next_value, next_instruction: built.next_instruction, sequence: 0, block: join_id, parameters: built.join_params, generated_blocks: all_blocks, next_block_id: built.next_block, nominals: st.nominals, ok: st.ok && built.ok, failure_op: select(st.failure_op > 0, st.failure_op, select(built.ok, 0, 2)) };
}
fn typed_scalar_match_arm_total<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: decl.TypedScalarMatchArmList) -> (result: u64) {
    let count: decl.TypedScalarMatchCount = decl.typed_scalar_match_count<P, N>(pages, stride, total, arms);
    return count.n;
}
fn scalar_arm_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ScalarArmBuild) -> (result: ScalarArmBuild) {
    return match st.rest {
        decl.TypedScalarMatchArmList.TSNil => st,
        decl.TypedScalarMatchArmList.TSCons { head: arm, tail: rest } => lower_scalar_arm<P, N>(pages, stride, total, st, arm, rest)
    };
}
record ScalarCaseReverse { rest: ScalarMatchCaseList, acc: ScalarMatchCaseList }
fn reverse_scalar_match_cases<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cases: ScalarMatchCaseList) -> (result: ScalarMatchCaseList) {
    iterate i up_to 1024 carrying st: ScalarCaseReverse = ScalarCaseReverse { rest: cases, acc: ScalarMatchCaseList.SCNil } { next st = reverse_scalar_match_cases_step(st); }
    return st.acc;
}
fn reverse_scalar_match_cases_step(st: ScalarCaseReverse) -> (result: ScalarCaseReverse) {
    return match st.rest { ScalarMatchCaseList.SCNil => st, ScalarMatchCaseList.SCCons { head: case, tail: rest } => ScalarCaseReverse { rest: rest, acc: ScalarMatchCaseList.SCCons { head: case, tail: st.acc } } };
}
fn lower_scalar_arm<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ScalarArmBuild, arm: decl.TypedScalarMatchArm, rest: decl.TypedScalarMatchArmList) -> (result: ScalarArmBuild) {
    let arm_id: u64 = st.source.next_block_id + st.arm_index;
    let prepared: MatchContextBuild = match_context_parameters<P, N>(pages, stride, total, st.source.env, st.source.stack, arm_id, st.next_value, st.source.values, st.source.nominals);
    let arm_seed: ExprBuild = ExprBuild { rest: arm.ops, env: prepared.env, stack: ValueStack.WNil, instructions: InstructionList.QNil, values: prepared.values, next_value: prepared.next_value, next_instruction: st.next_instruction, sequence: 0, block: arm_id, parameters: prepared.parameters, generated_blocks: SsaBlockList.LNil, next_block_id: st.next_block, nominals: st.source.nominals, ok: prepared.ok, failure_op: 0 };
    let lowered: ExprBuild = lower_nested_arm_ops<P, N>(pages, stride, total, arm_seed);
    let result: Value = expression_value(lowered.stack);
    let result_ok: bool = expression_stack_single(lowered.stack) && decl.sem_eq<P, N>(pages, stride, total, result.ty, st.result_ty);
    let jump_args: IdList = arm_jump_args<P, N>(pages, stride, total, lowered.block != arm_id, prepared.ok && lowered.ok && result_ok, lowered.env, lowered.stack, result.id, prepared.env, prepared.stack);
    let arm_term: Terminator = Terminator.Jump { target: st.join_id, arguments: jump_args };
    let arm_block: SsaBlock = SsaBlock { id: lowered.block, parameters: lowered.parameters, instructions: reverse_instructions<P, N>(pages, stride, total, lowered.instructions), terminator: arm_term, reachable: true, lowering_ok: lowered.ok && result_ok && prepared.ok, lowering_failure_kind: select(lowered.ok && result_ok && prepared.ok, 0, 9) };
    let edge_case: ScalarMatchCase = ScalarMatchCase { is_default: arm.is_default, negative: arm.negative, value: arm.value, overflow: arm.overflow, pattern_start: arm.pattern_start, pattern_end: arm.pattern_end, target: arm_id, arguments: st.source_arguments };
    let source_next: ExprBuild = ExprBuild { ..st.source, values: lowered.values, next_value: lowered.next_value, next_instruction: lowered.next_instruction };
    let fresh_arm: SsaBlockList = SsaBlockList.LCons { head: arm_block, tail: lowered.generated_blocks };
    let arm_blocks: SsaBlockList = prepend_generated_blocks<P, N>(pages, stride, total, fresh_arm, st.arm_blocks);
    let bumped: u64 = select(lowered.next_block_id > st.next_block, lowered.next_block_id, st.next_block);
    return ScalarArmBuild { rest: rest, source: source_next, cases: ScalarMatchCaseList.SCCons { head: edge_case, tail: st.cases }, arm_blocks: arm_blocks, arm_index: st.arm_index + 1, arm_count: st.arm_count, join_id: st.join_id, join_env: st.join_env, join_stack: st.join_stack, join_params: st.join_params, join_result: st.join_result, source_arguments: st.source_arguments, default_target: select(arm.is_default, arm_id, st.default_target), subject: st.subject, subject_ty: st.subject_ty, result_ty: st.result_ty, match_start: st.match_start, match_end: st.match_end, next_value: lowered.next_value, next_instruction: lowered.next_instruction, next_block: bumped, ok: st.ok && prepared.ok && lowered.ok && result_ok };
}
fn lower_nested_arm_ops<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, seed: ExprBuild) -> (result: ExprBuild) {
    let driver: NestDriver = NestDriver { build: seed, frames: NestFrameList.NFNil, done: false };
    iterate i up_to 1024 carrying d: NestDriver = driver { next d = nest_driver_step<P, N>(pages, stride, total, d); }
    return nest_driver_result(d);
}
fn nest_driver_result(st: NestDriver) -> (result: ExprBuild) {
    if st.done { return st.build; }
    return ExprBuild { ..st.build, ok: false };
}
fn nest_driver_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NestDriver) -> (result: NestDriver) {
    if !(st.build.ok) || st.done { return st; }
    return match st.build.rest {
        decl.TOpList.PNil => nest_driver_pop<P, N>(pages, stride, total, st),
        decl.TOpList.PCons { head: operation, tail: rest } => nest_driver_op<P, N>(pages, stride, total, st, operation, rest)
    };
}
fn nest_driver_op<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NestDriver, operation: decl.TOp, rest: decl.TOpList) -> (result: NestDriver) {
    return match operation {
        TInt { value: v, ty: ty, start: s, end: e } => NestDriver { build: lower_arm_operation<P, N>(pages, stride, total, st.build, operation, rest), frames: st.frames, done: false },
        TBool { value: v, ty: ty, start: s, end: e } => NestDriver { build: lower_arm_operation<P, N>(pages, stride, total, st.build, operation, rest), frames: st.frames, done: false },
        TName { ty: ty, start: s, end: e } => NestDriver { build: lower_arm_operation<P, N>(pages, stride, total, st.build, operation, rest), frames: st.frames, done: false },
        TNot { ty: ty, start: s, end: e } => NestDriver { build: lower_arm_operation<P, N>(pages, stride, total, st.build, operation, rest), frames: st.frames, done: false },
        TRepeat { ty: ty, element: element, count: count, start: s, end: e } => NestDriver { build: lower_arm_operation<P, N>(pages, stride, total, st.build, operation, rest), frames: st.frames, done: false },
        TMatch { ty: ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, default_count: default_count, start: s, end: e } => nest_scalar_setup<P, N>(pages, stride, total, st, rest, ty, subject_ty, arms, arm_count, default_count, s, e),
        TFiniteMatch { ty: ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, start: s, end: e } => nest_finite_setup<P, N>(pages, stride, total, st, rest, ty, subject_ty, arms, arm_count, s, e),
        TEnumConstruct { ty: ty, variant_start: vs, variant_end: ve, field_count: f, params: params, start: s, end: e } => NestDriver { build: lower_arm_operation<P, N>(pages, stride, total, st.build, operation, rest), frames: st.frames, done: false },
        TBin { op: op, ty: ty, start: s, end: e } => NestDriver { build: lower_arm_operation<P, N>(pages, stride, total, st.build, operation, rest), frames: st.frames, done: false },
        TCall { ty: ty, argc: argc, params: params, start: s, end: e, ns: ns, ne: ne, identity: identity, effects: effects, capabilities: capabilities } => NestDriver { build: lower_arm_operation<P, N>(pages, stride, total, st.build, operation, rest), frames: st.frames, done: false },
        TProj { ty: ty, fstart: fs, fend: fe, field_index: index, start: s, end: e } => NestDriver { build: lower_arm_operation<P, N>(pages, stride, total, st.build, operation, rest), frames: st.frames, done: false },
        TOp { slot: slot, ty: ty, argc: argc, ns: ns, ne: ne, identity: identity, start: s, end: e } => NestDriver { build: lower_arm_operation<P, N>(pages, stride, total, st.build, operation, rest), frames: st.frames, done: false }
    };
}
fn nest_driver_pop<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NestDriver) -> (result: NestDriver) {
    return match st.frames {
        NFNil => NestDriver { ..st, done: true },
        NFFinite { head: frame, tail: rest } => nest_finite_arm_done<P, N>(pages, stride, total, st, frame, rest),
        NFScalar { head: frame, tail: rest } => nest_scalar_arm_done<P, N>(pages, stride, total, st, frame, rest)
    };
}
fn nest_finite_setup<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NestDriver, rest: decl.TOpList, result_ty: decl.SemType, subject_ty: decl.SemType, arms: decl.TypedFiniteMatchArmList, arm_count: u64, start: u64, end: u64) -> (result: NestDriver) {
    return match st.build.stack {
        WNil => NestDriver { build: ExprBuild { ..st.build, ok: false, failure_op: select(st.build.failure_op > 0, st.build.failure_op, 4) }, frames: st.frames, done: false },
        WCons { head: subject, tail: base_stack } => nest_finite_setup_subject<P, N>(pages, stride, total, st, rest, result_ty, subject_ty, arms, arm_count, start, end, subject, base_stack)
    };
}
fn nest_finite_setup_subject<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NestDriver, rest: decl.TOpList, result_ty: decl.SemType, subject_ty: decl.SemType, arms: decl.TypedFiniteMatchArmList, arm_count: u64, start: u64, end: u64, subject: Value, base_stack: ValueStack) -> (result: NestDriver) {
    let nominal: decl.SemanticIdentity = nominal_identity_for_type<P, N>(pages, stride, total, st.build.nominals, subject_ty);
    let actual_count: u64 = decl.typed_finite_match_count<P, N>(pages, stride, total, arms);
    let basic_ok: bool = nominal.valid && actual_count == arm_count && arm_count > 0 && decl.sem_eq<P, N>(pages, stride, total, subject.ty, subject_ty) && supported_value_type<P, N>(pages, stride, total, result_ty, st.build.nominals);
    if !(basic_ok) { return NestDriver { build: ExprBuild { ..st.build, ok: false, failure_op: select(st.build.failure_op > 0, st.build.failure_op, 4) }, frames: st.frames, done: false }; }
    let join_id: u64 = st.build.next_block_id + arm_count;
    let join_context: MatchContextBuild = match_context_parameters<P, N>(pages, stride, total, st.build.env, base_stack, join_id, st.build.next_value, st.build.values, st.build.nominals);
    let join_result: Value = Value { id: join_context.next_value, ty: result_ty, owner_block: join_id, kind: 1, index: join_context.parameter_index };
    let join_params: ValueList = ValueList.VCons { head: join_result, tail: join_context.parameters };
    let join_values: ValueList = ValueList.VCons { head: join_result, tail: join_context.values };
    let source_args: IdList = append_ids<P, N>(pages, stride, total, IdList.ICons { head: Id { value: subject.id }, tail: IdList.INil }, match_context_ids<P, N>(pages, stride, total, st.build.env, base_stack));
    let source: ExprBuild = ExprBuild { ..st.build, rest: rest, stack: base_stack, values: join_values, next_value: join_context.next_value + 1, next_instruction: st.build.next_instruction, next_block_id: st.build.next_block_id };
    let ctx: FiniteArmBuild = FiniteArmBuild { rest: arms, source: source, cases: FiniteMatchCaseList.MCNil, arm_blocks: SsaBlockList.LNil, arm_index: 0, arm_count: arm_count, join_id: join_id, join_env: join_context.env, join_stack: join_context.stack, join_params: join_params, join_result: join_result, source_arguments: source_args, nominal: nominal, subject: subject, subject_ty: subject_ty, result_ty: result_ty, match_start: start, match_end: end, next_value: join_context.next_value + 1, next_instruction: st.build.next_instruction, next_block: join_id + 1, ok: join_context.ok };
    return match arms {
        decl.TypedFiniteMatchArmList.TFNil => NestDriver { build: ExprBuild { ..st.build, ok: false, failure_op: select(st.build.failure_op > 0, st.build.failure_op, 4) }, frames: st.frames, done: false },
        decl.TypedFiniteMatchArmList.TFCons { head: arm, tail: rest_arms } => nest_finite_arm_start<P, N>(pages, stride, total, st, ctx, arm, rest_arms)
    };
}
fn nest_finite_arm_start<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NestDriver, ctx: FiniteArmBuild, arm: decl.TypedFiniteMatchArm, rest_arms: decl.TypedFiniteMatchArmList) -> (result: NestDriver) {
    let entry_id: u64 = ctx.source.next_block_id + ctx.arm_index;
    let prepared: MatchContextBuild = match_context_parameters<P, N>(pages, stride, total, ctx.source.env, ctx.source.stack, entry_id, ctx.next_value, ctx.source.values, ctx.source.nominals);
    let subject_param: Value = Value { id: prepared.next_value, ty: ctx.subject_ty, owner_block: entry_id, kind: 1, index: prepared.parameter_index };
    let arm_params: ValueList = ValueList.VCons { head: subject_param, tail: prepared.parameters };
    let values_with_subject: ValueList = ValueList.VCons { head: subject_param, tail: prepared.values };
    let payloads: PayloadLowerBuild = lower_match_payloads<P, N>(pages, stride, total, arm.bindings, arm.payload_fields, prepared.env, subject_param.id, arm.variant_start, arm.variant_end, ctx.nominal, ctx.match_start, ctx.match_end, InstructionList.QNil, values_with_subject, prepared.next_value + 1, ctx.next_instruction, 0, entry_id, ctx.source.nominals, prepared.ok);
    let seed: ExprBuild = ExprBuild { rest: arm.ops, env: payloads.env, stack: ValueStack.WNil, instructions: payloads.instructions, values: payloads.values, next_value: payloads.next_value, next_instruction: payloads.next_instruction, sequence: payloads.sequence, block: entry_id, parameters: arm_params, generated_blocks: SsaBlockList.LNil, next_block_id: ctx.next_block, nominals: ctx.source.nominals, ok: payloads.ok, failure_op: 0 };
    let frame: NestFiniteFrame = NestFiniteFrame { match_ctx: FiniteArmBuild { ..ctx, rest: rest_arms }, arm: arm, prepared_env: prepared.env, prepared_stack: prepared.stack };
    return NestDriver { build: seed, frames: NestFrameList.NFFinite { head: frame, tail: st.frames }, done: false };
}
fn nest_finite_arm_done<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NestDriver, frame: NestFiniteFrame, rest_frames: NestFrameList) -> (result: NestDriver) {
    let build: ExprBuild = st.build;
    let entry_id: u64 = frame.match_ctx.source.next_block_id + frame.match_ctx.arm_index;
    let result: Value = expression_value(build.stack);
    let result_ok: bool = expression_stack_single(build.stack) && decl.sem_eq<P, N>(pages, stride, total, result.ty, frame.match_ctx.result_ty);
    let jump_args: IdList = arm_jump_args<P, N>(pages, stride, total, build.block != entry_id, build.ok && result_ok, build.env, build.stack, result.id, frame.prepared_env, frame.prepared_stack);
    let arm_term: Terminator = Terminator.Jump { target: frame.match_ctx.join_id, arguments: jump_args };
    let arm_block: SsaBlock = SsaBlock { id: build.block, parameters: build.parameters, instructions: reverse_instructions<P, N>(pages, stride, total, build.instructions), terminator: arm_term, reachable: true, lowering_ok: build.ok && result_ok, lowering_failure_kind: select(build.ok && result_ok, 0, 9) };
    let edge_case: FiniteMatchCase = FiniteMatchCase { variant_start: frame.arm.variant_start, variant_end: frame.arm.variant_end, target: entry_id, arguments: frame.match_ctx.source_arguments };
    let fresh_arm: SsaBlockList = SsaBlockList.LCons { head: arm_block, tail: build.generated_blocks };
    let arm_blocks: SsaBlockList = prepend_generated_blocks<P, N>(pages, stride, total, fresh_arm, frame.match_ctx.arm_blocks);
    let source_next: ExprBuild = ExprBuild { ..frame.match_ctx.source, values: build.values, next_value: build.next_value, next_instruction: build.next_instruction };
    let bumped: u64 = select(build.next_block_id > frame.match_ctx.next_block, build.next_block_id, frame.match_ctx.next_block);
    let ctx: FiniteArmBuild = FiniteArmBuild { ..frame.match_ctx, source: source_next, cases: FiniteMatchCaseList.MCCons { head: edge_case, tail: frame.match_ctx.cases }, arm_blocks: arm_blocks, arm_index: frame.match_ctx.arm_index + 1, next_value: build.next_value, next_instruction: build.next_instruction, next_block: bumped, ok: frame.match_ctx.ok && build.ok && result_ok };
    return match frame.match_ctx.rest {
        decl.TypedFiniteMatchArmList.TFNil => nest_finite_assemble<P, N>(pages, stride, total, build, ctx, rest_frames),
        decl.TypedFiniteMatchArmList.TFCons { head: next_arm, tail: rest_arms } => nest_finite_arm_start<P, N>(pages, stride, total, NestDriver { build: build, frames: rest_frames, done: false }, FiniteArmBuild { ..ctx, rest: rest_arms }, next_arm, rest_arms)
    };
}
fn nest_finite_assemble<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, build: ExprBuild, ctx: FiniteArmBuild, rest_frames: NestFrameList) -> (result: NestDriver) {
    let ordered_cases: FiniteMatchCaseList = reverse_finite_match_cases<P, N>(pages, stride, total, ctx.cases);
    let source_term: Terminator = Terminator.FiniteSwitch { subject: ctx.subject.id, subject_ty: ctx.subject_ty, nominal_identity: ctx.nominal, result_type: ctx.result_ty, source_start: ctx.match_start, source_end: ctx.match_end, arm_count: ctx.arm_count, join_target: ctx.join_id, cases: ordered_cases };
    let source_block: SsaBlock = SsaBlock { id: ctx.source.block, parameters: ctx.source.parameters, instructions: reverse_instructions<P, N>(pages, stride, total, ctx.source.instructions), terminator: source_term, reachable: true, lowering_ok: ctx.source.ok && ctx.ok, lowering_failure_kind: select(ctx.source.ok && ctx.ok, 0, 9) };
    let fresh_blocks: SsaBlockList = SsaBlockList.LCons { head: source_block, tail: ctx.arm_blocks };
    let all_blocks: SsaBlockList = prepend_generated_blocks<P, N>(pages, stride, total, fresh_blocks, ctx.source.generated_blocks);
    let cont: ExprBuild = ExprBuild { rest: ctx.source.rest, env: ctx.join_env, stack: ValueStack.WCons { head: ctx.join_result, tail: ctx.join_stack }, instructions: InstructionList.QNil, values: ctx.source.values, next_value: ctx.next_value, next_instruction: ctx.next_instruction, sequence: 0, block: ctx.join_id, parameters: ctx.join_params, generated_blocks: all_blocks, next_block_id: ctx.next_block, nominals: ctx.source.nominals, ok: ctx.source.ok && ctx.ok, failure_op: select(ctx.source.failure_op > 0, ctx.source.failure_op, select(ctx.ok, 0, 4)) };
    return NestDriver { build: cont, frames: rest_frames, done: false };
}
fn nest_scalar_setup<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NestDriver, rest: decl.TOpList, result_ty: decl.SemType, subject_ty: decl.SemType, arms: decl.TypedScalarMatchArmList, arm_count: u64, default_count: u64, start: u64, end: u64) -> (result: NestDriver) {
    return match st.build.stack {
        WNil => NestDriver { build: ExprBuild { ..st.build, ok: false, failure_op: select(st.build.failure_op > 0, st.build.failure_op, 2) }, frames: st.frames, done: false },
        WCons { head: subject, tail: base_stack } => nest_scalar_setup_subject<P, N>(pages, stride, total, st, rest, result_ty, subject_ty, arms, arm_count, default_count, start, end, subject, base_stack)
    };
}
fn nest_scalar_setup_subject<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NestDriver, rest: decl.TOpList, result_ty: decl.SemType, subject_ty: decl.SemType, arms: decl.TypedScalarMatchArmList, arm_count: u64, default_count: u64, start: u64, end: u64, subject: Value, base_stack: ValueStack) -> (result: NestDriver) {
    let actual_count: u64 = typed_scalar_match_arm_total<P, N>(pages, stride, total, arms);
    let basic_ok: bool = decl.is_int_ty(subject_ty) && actual_count == arm_count && arm_count > 0 && default_count == 1 && decl.sem_eq<P, N>(pages, stride, total, subject.ty, subject_ty) && supported_value_type<P, N>(pages, stride, total, result_ty, st.build.nominals);
    if !(basic_ok) { return NestDriver { build: ExprBuild { ..st.build, ok: false, failure_op: select(st.build.failure_op > 0, st.build.failure_op, 2) }, frames: st.frames, done: false }; }
    let join_id: u64 = st.build.next_block_id + arm_count;
    let join_context: MatchContextBuild = match_context_parameters<P, N>(pages, stride, total, st.build.env, base_stack, join_id, st.build.next_value, st.build.values, st.build.nominals);
    let join_result: Value = Value { id: join_context.next_value, ty: result_ty, owner_block: join_id, kind: 1, index: join_context.parameter_index };
    let join_params: ValueList = ValueList.VCons { head: join_result, tail: join_context.parameters };
    let join_values: ValueList = ValueList.VCons { head: join_result, tail: join_context.values };
    let source_args: IdList = match_context_ids<P, N>(pages, stride, total, st.build.env, base_stack);
    let source: ExprBuild = ExprBuild { ..st.build, rest: rest, stack: base_stack, values: join_values, next_value: join_context.next_value + 1, next_instruction: st.build.next_instruction, next_block_id: st.build.next_block_id };
    let ctx: ScalarArmBuild = ScalarArmBuild { rest: arms, source: source, cases: ScalarMatchCaseList.SCNil, arm_blocks: SsaBlockList.LNil, arm_index: 0, arm_count: arm_count, join_id: join_id, join_env: join_context.env, join_stack: join_context.stack, join_params: join_params, join_result: join_result, source_arguments: source_args, default_target: 0, subject: subject, subject_ty: subject_ty, result_ty: result_ty, match_start: start, match_end: end, next_value: join_context.next_value + 1, next_instruction: st.build.next_instruction, next_block: join_id + 1, ok: join_context.ok };
    return match arms {
        decl.TypedScalarMatchArmList.TSNil => NestDriver { build: ExprBuild { ..st.build, ok: false, failure_op: select(st.build.failure_op > 0, st.build.failure_op, 2) }, frames: st.frames, done: false },
        decl.TypedScalarMatchArmList.TSCons { head: arm, tail: rest_arms } => nest_scalar_arm_start<P, N>(pages, stride, total, st, ctx, arm, rest_arms)
    };
}
fn nest_scalar_arm_start<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NestDriver, ctx: ScalarArmBuild, arm: decl.TypedScalarMatchArm, rest_arms: decl.TypedScalarMatchArmList) -> (result: NestDriver) {
    let entry_id: u64 = ctx.source.next_block_id + ctx.arm_index;
    let prepared: MatchContextBuild = match_context_parameters<P, N>(pages, stride, total, ctx.source.env, ctx.source.stack, entry_id, ctx.next_value, ctx.source.values, ctx.source.nominals);
    let seed: ExprBuild = ExprBuild { rest: arm.ops, env: prepared.env, stack: ValueStack.WNil, instructions: InstructionList.QNil, values: prepared.values, next_value: prepared.next_value, next_instruction: ctx.next_instruction, sequence: 0, block: entry_id, parameters: prepared.parameters, generated_blocks: SsaBlockList.LNil, next_block_id: ctx.next_block, nominals: ctx.source.nominals, ok: prepared.ok, failure_op: 0 };
    let frame: NestScalarFrame = NestScalarFrame { match_ctx: ScalarArmBuild { ..ctx, rest: rest_arms }, arm: arm, prepared_env: prepared.env, prepared_stack: prepared.stack };
    return NestDriver { build: seed, frames: NestFrameList.NFScalar { head: frame, tail: st.frames }, done: false };
}
fn nest_scalar_arm_done<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: NestDriver, frame: NestScalarFrame, rest_frames: NestFrameList) -> (result: NestDriver) {
    let build: ExprBuild = st.build;
    let entry_id: u64 = frame.match_ctx.source.next_block_id + frame.match_ctx.arm_index;
    let result: Value = expression_value(build.stack);
    let result_ok: bool = expression_stack_single(build.stack) && decl.sem_eq<P, N>(pages, stride, total, result.ty, frame.match_ctx.result_ty);
    let jump_args: IdList = arm_jump_args<P, N>(pages, stride, total, build.block != entry_id, build.ok && result_ok, build.env, build.stack, result.id, frame.prepared_env, frame.prepared_stack);
    let arm_term: Terminator = Terminator.Jump { target: frame.match_ctx.join_id, arguments: jump_args };
    let arm_block: SsaBlock = SsaBlock { id: build.block, parameters: build.parameters, instructions: reverse_instructions<P, N>(pages, stride, total, build.instructions), terminator: arm_term, reachable: true, lowering_ok: build.ok && result_ok, lowering_failure_kind: select(build.ok && result_ok, 0, 9) };
    let edge_case: ScalarMatchCase = ScalarMatchCase { is_default: frame.arm.is_default, negative: frame.arm.negative, value: frame.arm.value, overflow: frame.arm.overflow, pattern_start: frame.arm.pattern_start, pattern_end: frame.arm.pattern_end, target: entry_id, arguments: frame.match_ctx.source_arguments };
    let fresh_arm: SsaBlockList = SsaBlockList.LCons { head: arm_block, tail: build.generated_blocks };
    let arm_blocks: SsaBlockList = prepend_generated_blocks<P, N>(pages, stride, total, fresh_arm, frame.match_ctx.arm_blocks);
    let source_next: ExprBuild = ExprBuild { ..frame.match_ctx.source, values: build.values, next_value: build.next_value, next_instruction: build.next_instruction };
    let bumped: u64 = select(build.next_block_id > frame.match_ctx.next_block, build.next_block_id, frame.match_ctx.next_block);
    let ctx: ScalarArmBuild = ScalarArmBuild { ..frame.match_ctx, source: source_next, cases: ScalarMatchCaseList.SCCons { head: edge_case, tail: frame.match_ctx.cases }, arm_blocks: arm_blocks, arm_index: frame.match_ctx.arm_index + 1, default_target: select(frame.arm.is_default, entry_id, frame.match_ctx.default_target), next_value: build.next_value, next_instruction: build.next_instruction, next_block: bumped, ok: frame.match_ctx.ok && build.ok && result_ok };
    return match frame.match_ctx.rest {
        decl.TypedScalarMatchArmList.TSNil => nest_scalar_assemble<P, N>(pages, stride, total, build, ctx, rest_frames),
        decl.TypedScalarMatchArmList.TSCons { head: next_arm, tail: rest_arms } => nest_scalar_arm_start<P, N>(pages, stride, total, NestDriver { build: build, frames: rest_frames, done: false }, ScalarArmBuild { ..ctx, rest: rest_arms }, next_arm, rest_arms)
    };
}
fn nest_scalar_assemble<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, build: ExprBuild, ctx: ScalarArmBuild, rest_frames: NestFrameList) -> (result: NestDriver) {
    let ordered_cases: ScalarMatchCaseList = reverse_scalar_match_cases<P, N>(pages, stride, total, ctx.cases);
    let source_term: Terminator = Terminator.ScalarSwitch { subject: ctx.subject.id, subject_ty: ctx.subject_ty, result_type: ctx.result_ty, source_start: ctx.match_start, source_end: ctx.match_end, arm_count: ctx.arm_count, default_target: ctx.default_target, join_target: ctx.join_id, cases: ordered_cases };
    let source_block: SsaBlock = SsaBlock { id: ctx.source.block, parameters: ctx.source.parameters, instructions: reverse_instructions<P, N>(pages, stride, total, ctx.source.instructions), terminator: source_term, reachable: true, lowering_ok: ctx.source.ok && ctx.ok, lowering_failure_kind: select(ctx.source.ok && ctx.ok, 0, 9) };
    let fresh_blocks: SsaBlockList = SsaBlockList.LCons { head: source_block, tail: ctx.arm_blocks };
    let all_blocks: SsaBlockList = prepend_generated_blocks<P, N>(pages, stride, total, fresh_blocks, ctx.source.generated_blocks);
    let cont: ExprBuild = ExprBuild { rest: ctx.source.rest, env: ctx.join_env, stack: ValueStack.WCons { head: ctx.join_result, tail: ctx.join_stack }, instructions: InstructionList.QNil, values: ctx.source.values, next_value: ctx.next_value, next_instruction: ctx.next_instruction, sequence: 0, block: ctx.join_id, parameters: ctx.join_params, generated_blocks: all_blocks, next_block_id: ctx.next_block, nominals: ctx.source.nominals, ok: ctx.source.ok && ctx.ok, failure_op: select(ctx.source.failure_op > 0, ctx.source.failure_op, select(ctx.ok, 0, 2)) };
    return NestDriver { build: cont, frames: rest_frames, done: false };
}
// Straight-line arm operations. Match ops divert to the nested driver
// before reaching here; the failing arms below stay as a closed backstop.
fn lower_arm_operation<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, operation: decl.TOp, rest: decl.TOpList) -> (result: ExprBuild) {
    return match operation {
        TInt { value: value, ty: ty, start: start, end: end } => emit_constant(st, rest, 0, value, false, ty, start, end),
        TBool { value: value, ty: ty, start: start, end: end } => emit_constant(st, rest, 1, 0, value, ty, start, end),
        TName { ty: ty, start: start, end: end } => lower_name<P, N>(pages, stride, total, st, rest, ty, start, end),
        TNot { ty: ty, start: start, end: end } => lower_not<P, N>(pages, stride, total, st, rest, ty, start, end),
        TRepeat { ty: ty, element: element, count: count, start: start, end: end } => lower_repeat<P, N>(pages, stride, total, st, rest, ty, element, count, start, end),
        TMatch { ty: ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, default_count: default_count, start: start, end: end } => ExprBuild { ..st, rest: rest, ok: false, failure_op: select(st.failure_op > 0, st.failure_op, 2) },
        TFiniteMatch { ty: ty, subject_ty: subject_ty, arms: arms, arm_count: arm_count, start: start, end: end } => ExprBuild { ..st, rest: rest, ok: false, failure_op: select(st.failure_op > 0, st.failure_op, 4) },
        TEnumConstruct { ty: ty, variant_start: variant_start, variant_end: variant_end, field_count: count, params: params, start: start, end: end } => lower_enum_construct<P, N>(pages, stride, total, st, rest, ty, variant_start, variant_end, count, params, start, end),
        TBin { op: op, ty: ty, start: start, end: end } => lower_binary<P, N>(pages, stride, total, st, rest, op, ty, start, end),
        TCall { ty: ty, argc: argc, params: params, start: start, end: end, ns: ns, ne: ne, identity: identity, effects: effects, capabilities: capabilities } => lower_call<P, N>(pages, stride, total, st, rest, ty, argc, params, identity, effects, capabilities, start, end),
        TProj { ty: ty, fstart: field_start, fend: field_end, field_index: index, start: start, end: end } => lower_project<P, N>(pages, stride, total, st, rest, ty, field_start, field_end, index, start, end),
        TOp { slot: slot, ty: ty, argc: argc, ns: ns, ne: ne, identity: identity, start: start, end: end } => lower_top_op<P, N>(pages, stride, total, st, rest, ty, slot, argc, ns, ne, identity, start, end)
    };
}
fn match_context_parameters<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, env: Environment, stack: ValueStack, block: u64, next_value: u64, values: ValueList, nominals: decl.NominalTypeIdentityList) -> (result: MatchContextBuild) {
    let incoming: Incoming = Incoming { found: true, ok: true, count: 1, bindings: env };
    let env_params: BlockParamBuild = prepare_block_environment<P, N>(pages, stride, total, block, incoming, next_value, values, nominals);
    let initial: StackParamBuild = StackParamBuild { rest: stack, parameters_rev: env_params.params, stack_rev: ValueStack.WNil, values: env_params.values, next_value: env_params.next_value, index: env_params.parameter_index, block: block, nominals: nominals, ok: env_params.ok };
    iterate i up_to 1024 carrying built: StackParamBuild = initial { next built = match_stack_parameter_step<P, N>(pages, stride, total, built); }
    return MatchContextBuild { env: env_params.env, stack: reverse_value_stack<P, N>(pages, stride, total, built.stack_rev), parameters: built.parameters_rev, values: built.values, next_value: built.next_value, parameter_index: built.index, block: block, nominals: nominals, ok: built.ok };
}
fn match_stack_parameter_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StackParamBuild) -> (result: StackParamBuild) {
    return match st.rest {
        ValueStack.WNil => st,
        ValueStack.WCons { head: old, tail: rest } => match_stack_parameter_one<P, N>(pages, stride, total, st, old, rest)
    };
}
fn match_stack_parameter_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: StackParamBuild, old: Value, rest: ValueStack) -> (result: StackParamBuild) {
    let value: Value = Value { id: st.next_value, ty: old.ty, owner_block: st.block, kind: 1, index: st.index };
    return StackParamBuild { rest: rest, parameters_rev: ValueList.VCons { head: value, tail: st.parameters_rev }, stack_rev: ValueStack.WCons { head: value, tail: st.stack_rev }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, index: st.index + 1, block: st.block, nominals: st.nominals, ok: st.ok && supported_value_type<P, N>(pages, stride, total, old.ty, st.nominals) };
}
fn reverse_value_list<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList) -> (result: ValueList) {
    iterate i up_to 1024 carrying st: ValueListReverse = ValueListReverse { rest: values, acc: ValueList.VNil } { next st = reverse_value_list_step(st); }
    return st.acc;
}
fn reverse_value_list_step(st: ValueListReverse) -> (result: ValueListReverse) {
    return match st.rest { ValueList.VNil => st, ValueList.VCons { head: value, tail: rest } => ValueListReverse { rest: rest, acc: ValueList.VCons { head: value, tail: st.acc } } };
}
fn reverse_value_stack<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, stack: ValueStack) -> (result: ValueStack) {
    iterate i up_to 1024 carrying st: ValueStackReverse = ValueStackReverse { rest: stack, acc: ValueStack.WNil } { next st = reverse_value_stack_step(st); }
    return st.acc;
}
fn reverse_value_stack_step(st: ValueStackReverse) -> (result: ValueStackReverse) {
    return match st.rest { ValueStack.WNil => st, ValueStack.WCons { head: value, tail: rest } => ValueStackReverse { rest: rest, acc: ValueStack.WCons { head: value, tail: st.acc } } };
}
record ValueListAppend { rest: ValueList, acc: ValueList }
fn append_value<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, value: Value) -> (result: ValueList) {
    let reversed: ValueList = reverse_value_list<P, N>(pages, stride, total, values);
    iterate i up_to 1024 carrying st: ValueListAppend = ValueListAppend { rest: reversed, acc: ValueList.VCons { head: value, tail: ValueList.VNil } } { next st = append_value_step(st); }
    return st.acc;
}
fn append_value_step(st: ValueListAppend) -> (result: ValueListAppend) {
    return match st.rest { ValueList.VNil => st, ValueList.VCons { head: value, tail: rest } => ValueListAppend { rest: rest, acc: ValueList.VCons { head: value, tail: st.acc } } };
}
fn match_context_ids<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, env: Environment, stack: ValueStack) -> (result: IdList) {
    return append_ids<P, N>(pages, stride, total, reverse_id_list<P, N>(pages, stride, total, value_stack_ids<P, N>(pages, stride, total, stack)), binding_ids<P, N>(pages, stride, total, env));
}
record StackIdBuild { rest: ValueStack, acc: IdList }
fn value_stack_ids<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, stack: ValueStack) -> (result: IdList) {
    iterate i up_to 1024 carrying st: StackIdBuild = StackIdBuild { rest: stack, acc: IdList.INil } { next st = value_stack_id_step(st); }
    return reverse_id_list<P, N>(pages, stride, total, st.acc);
}
fn value_stack_id_step(st: StackIdBuild) -> (result: StackIdBuild) {
    return match st.rest { ValueStack.WNil => st, ValueStack.WCons { head: value, tail: rest } => StackIdBuild { rest: rest, acc: IdList.ICons { head: Id { value: value.id }, tail: st.acc } } };
}
fn append_id<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ids: IdList, value: Id) -> (result: IdList) {
    return append_ids<P, N>(pages, stride, total, ids, IdList.ICons { head: value, tail: IdList.INil });
}
record IdListAppend { rest: IdList, acc: IdList }
fn append_ids<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, left: IdList, right: IdList) -> (result: IdList) {
    let reversed: IdList = reverse_id_list<P, N>(pages, stride, total, left);
    iterate i up_to 1024 carrying st: IdListAppend = IdListAppend { rest: reversed, acc: right } { next st = append_id_step(st); }
    return st.acc;
}
fn reverse_id_list<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ids: IdList) -> (result: IdList) {
    iterate i up_to 1024 carrying st: IdListReverse = IdListReverse { rest: ids, acc: IdList.INil } { next st = reverse_id_list_step(st); }
    return st.acc;
}
fn reverse_id_list_step(st: IdListReverse) -> (result: IdListReverse) {
    return match st.rest { IdList.INil => st, IdList.ICons { head: id, tail: rest } => IdListReverse { rest: rest, acc: IdList.ICons { head: id, tail: st.acc } } };
}
fn append_id_step(st: IdListAppend) -> (result: IdListAppend) {
    return match st.rest { IdList.INil => st, IdList.ICons { head: id, tail: rest } => IdListAppend { rest: rest, acc: IdList.ICons { head: id, tail: st.acc } } };
}
fn lower_match_payloads<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, bindings: decl.PayloadBindingList, fields: decl.BindList, env: Environment, subject: u64, variant_start: u64, variant_end: u64, nominal: decl.SemanticIdentity, match_start: u64, match_end: u64, instructions: InstructionList, values: ValueList, next_value: u64, next_instruction: u64, sequence: u64, block: u64, nominals: decl.NominalTypeIdentityList, ok: bool) -> (result: PayloadLowerBuild) {
    let initial: PayloadLowerBuild = PayloadLowerBuild { rest: bindings, fields: fields, env: env, subject: subject, variant_start: variant_start, variant_end: variant_end, nominal: nominal, match_start: match_start, match_end: match_end, instructions: instructions, values: values, next_value: next_value, next_instruction: next_instruction, sequence: sequence, block: block, nominals: nominals, ok: ok };
    iterate i up_to 1024 carrying st: PayloadLowerBuild = initial { next st = lower_match_payload_step<P, N>(pages, stride, total, st); }
    return st;
}
fn lower_match_payload_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadLowerBuild) -> (result: PayloadLowerBuild) {
    if !(st.ok) { return st; }
    return match st.rest {
        decl.PayloadBindingList.YNil => st,
        decl.PayloadBindingList.YCons { head: binding, tail: rest } => lower_match_payload_one<P, N>(pages, stride, total, st, binding, rest)
    };
}
fn lower_match_payload_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadLowerBuild, binding: decl.PayloadBinding, rest: decl.PayloadBindingList) -> (result: PayloadLowerBuild) {
    let field: PayloadFieldFind = find_match_payload_field<P, N>(pages, stride, total, st.fields, binding.field_start, binding.field_end);
    if !(field.found) { return PayloadLowerBuild { ..st, rest: rest, ok: false }; }
    if match_payload_wildcard<P, N>(pages, stride, total, binding.name_start, binding.name_end) { return PayloadLowerBuild { ..st, rest: rest }; }
    let value: Value = Value { id: st.next_value, ty: field.field.ty, owner_block: st.block, kind: 2, index: st.sequence };
    let input_id: IdList = IdList.ICons { head: Id { value: st.subject }, tail: IdList.INil };
    let params: decl.BindList = decl.BindList.BCons { head: field.field, tail: decl.BindList.BNil };
    let inst: Instruction = Instruction { id: st.next_instruction, sequence: st.sequence, kind: 6, operator: 0, result: value.id, ty: value.ty, inputs: input_id, argc: 1, params: params, identity: invalid_identity(), nominal_identity: st.nominal, variant_start: st.variant_start, variant_end: st.variant_end, binding_start: binding.name_start, binding_end: binding.name_end, effects: decl.EffectIdentityList.EINil, capabilities: decl.CapabilityIdentityList.CINil, start: st.match_start, end: st.match_end };
    let mapped: Binding = Binding { name_start: binding.name_start, name_end: binding.name_end, value: value.id, ty: value.ty };
    return PayloadLowerBuild { ..st, rest: rest, env: Environment.EnvCons { head: mapped, tail: st.env }, instructions: InstructionList.QCons { head: inst, tail: st.instructions }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, next_instruction: st.next_instruction + 1, sequence: st.sequence + 1, ok: supported_value_type<P, N>(pages, stride, total, value.ty, st.nominals) };
}
record PayloadFieldFind { rest: decl.BindList, start: u64, end: u64, found: bool, field: decl.Bind }
fn find_match_payload_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fields: decl.BindList, start: u64, end: u64) -> (result: PayloadFieldFind) {
    iterate i up_to 1024 carrying st: PayloadFieldFind = PayloadFieldFind { rest: fields, start: start, end: end, found: false, field: decl.Bind { start: 0, end: 0, ty: decl.SemType.TPoison } } { next st = find_match_payload_field_step<P, N>(pages, stride, total, st); }
    return st;
}
fn find_match_payload_field_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadFieldFind) -> (result: PayloadFieldFind) {
    if st.found { return st; }
    return match st.rest {
        decl.BindList.BNil => st,
        decl.BindList.BCons { head: field, tail: rest } => PayloadFieldFind { rest: rest, start: st.start, end: st.end, found: decl.spans_equal<P, N>(pages, stride, total, field.start, field.end, st.start, st.end), field: field }
    };
}
fn match_payload_wildcard<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: bool) {
    if end != start + 1 || end > total { return false; }
    return source.byte_at_global<P, N>(pages, stride, total, start) == 95;
}
fn lower_enum_construct<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, ty: decl.SemType, variant_start: u64, variant_end: u64, field_count: u64, params: decl.BindList, start: u64, end: u64) -> (result: ExprBuild) {
    iterate i up_to 1024 carrying popped: PopArgs = PopArgs { stack: st.stack, remaining: field_count, arguments: IdList.INil, ok: true } { next popped = pop_call_arg(popped); }
    let nominal: decl.SemanticIdentity = nominal_identity_for_type<P, N>(pages, stride, total, st.nominals, ty);
    let shape_ok: bool = popped.ok && popped.remaining == 0 && id_count<P, N>(pages, stride, total, popped.arguments) == field_count && bind_count<P, N>(pages, stride, total, params) == field_count;
    let fields_ok: bool = call_argument_types_match<P, N>(pages, stride, total, st.values, popped.arguments, params) && enum_construct_source_valid<P, N>(pages, stride, total, ty, variant_start, variant_end, params, start, end);
    if !(shape_ok) || !(fields_ok) || !(nominal.valid) { return ExprBuild { ..st, rest: rest, ok: false, failure_op: select(st.failure_op > 0, st.failure_op, 5) }; }
    let value: Value = Value { id: st.next_value, ty: ty, owner_block: st.block, kind: 2, index: st.sequence };
    let inst: Instruction = Instruction { id: st.next_instruction, sequence: st.sequence, kind: 5, operator: 0, result: value.id, ty: ty, inputs: popped.arguments, argc: field_count, params: params, identity: invalid_identity(), nominal_identity: nominal, variant_start: variant_start, variant_end: variant_end, binding_start: 0, binding_end: 0, effects: decl.EffectIdentityList.EINil, capabilities: decl.CapabilityIdentityList.CINil, start: start, end: end };
    return ExprBuild { rest: rest, env: st.env, stack: ValueStack.WCons { head: value, tail: popped.stack }, instructions: InstructionList.QCons { head: inst, tail: st.instructions }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, next_instruction: st.next_instruction + 1, sequence: st.sequence + 1, block: st.block, parameters: st.parameters, generated_blocks: st.generated_blocks, next_block_id: st.next_block_id, nominals: st.nominals, ok: st.ok && supported_value_type<P, N>(pages, stride, total, ty, st.nominals), failure_op: st.failure_op };
}
fn lower_repeat<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, ty: decl.SemType, element_ty: decl.SemType, count: u64, start: u64, end: u64) -> (result: ExprBuild) {
    return match st.stack {
        ValueStack.WNil => ExprBuild { ..st, rest: rest, ok: false, failure_op: select(st.failure_op > 0, st.failure_op, 1) },
        ValueStack.WCons { head: element, tail: remaining } => emit_repeat<P, N>(pages, stride, total, st, rest, ty, element_ty, count, start, end, element, remaining)
    };
}
fn emit_repeat<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, ty: decl.SemType, element_ty: decl.SemType, count: u64, start: u64, end: u64, element: Value, remaining: ValueStack) -> (result: ExprBuild) {
    let type_ok: bool = match ty {
        TSeqExact { element: result_element, length: length, length_valid: valid } => valid && length == count && decl.sem_eq<P, N>(pages, stride, total, result_element, element_ty),
        TBool => false,
        TByte => false,
        TInt { width: width, signed: signed } => false,
        TNamed { start: named_start, end: named_end } => false,
        TSeq => false,
        TPoison => false
    };
    let source_ok: bool = repeat_source_count_matches<P, N>(pages, stride, total, start, end, count);
    if !(type_ok) || !(source_ok) || !(decl.sem_eq<P, N>(pages, stride, total, element.ty, element_ty)) || !(supported_value_type<P, N>(pages, stride, total, ty, st.nominals)) { return ExprBuild { ..st, rest: rest, ok: false, failure_op: select(st.failure_op > 0, st.failure_op, 1) }; }
    let value: Value = Value { id: st.next_value, ty: ty, owner_block: st.block, kind: 2, index: st.sequence };
    let args: IdList = IdList.ICons { head: Id { value: element.id }, tail: IdList.INil };
    let inst: Instruction = Instruction { id: st.next_instruction, sequence: st.sequence, kind: 7, operator: count, result: value.id, ty: ty, inputs: args, argc: 1, params: decl.BindList.BNil, identity: invalid_identity(), nominal_identity: invalid_identity(), variant_start: 0, variant_end: 0, binding_start: 0, binding_end: 0, effects: decl.EffectIdentityList.EINil, capabilities: decl.CapabilityIdentityList.CINil, start: start, end: end };
    return ExprBuild { rest: rest, env: st.env, stack: ValueStack.WCons { head: value, tail: remaining }, instructions: InstructionList.QCons { head: inst, tail: st.instructions }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, next_instruction: st.next_instruction + 1, sequence: st.sequence + 1, block: st.block, parameters: st.parameters, generated_blocks: st.generated_blocks, next_block_id: st.next_block_id, nominals: st.nominals, ok: st.ok, failure_op: st.failure_op };
}
fn emit_constant(st: ExprBuild, rest: decl.TOpList, kind: u64, integer: u64, boolean: bool, ty: decl.SemType, start: u64, end: u64) -> (result: ExprBuild) {
    let value: Value = Value { id: st.next_value, ty: ty, owner_block: st.block, kind: 2, index: st.sequence };
    let payload: u64 = select(kind == 0, integer, boolean_value(boolean));
    let inst: Instruction = Instruction { id: st.next_instruction, sequence: st.sequence, kind: kind, operator: payload, result: value.id, ty: ty, inputs: IdList.INil, argc: 0, params: decl.BindList.BNil, identity: invalid_identity(), nominal_identity: invalid_identity(), variant_start: 0, variant_end: 0, binding_start: 0, binding_end: 0, effects: decl.EffectIdentityList.EINil, capabilities: decl.CapabilityIdentityList.CINil, start: start, end: end };
    return ExprBuild { rest: rest, env: st.env, stack: ValueStack.WCons { head: value, tail: st.stack }, instructions: InstructionList.QCons { head: inst, tail: st.instructions }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, next_instruction: st.next_instruction + 1, sequence: st.sequence + 1, block: st.block, parameters: st.parameters, generated_blocks: st.generated_blocks, next_block_id: st.next_block_id, nominals: st.nominals, ok: st.ok && scalar_type(ty), failure_op: st.failure_op };
}
fn boolean_value(value: bool) -> (result: u64) { return select(value, 1, 0); }
fn lower_not<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, ty: decl.SemType, start: u64, end: u64) -> (result: ExprBuild) {
    return match st.stack {
        WNil => ExprBuild { ..st, rest: rest, ok: false },
        WCons { head: operand, tail: remaining } => emit_not<P, N>(pages, stride, total, st, rest, ty, start, end, operand, remaining)
    };
}
fn emit_not<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, ty: decl.SemType, start: u64, end: u64, operand: Value, remaining: ValueStack) -> (result: ExprBuild) {
    let value: Value = Value { id: st.next_value, ty: ty, owner_block: st.block, kind: 2, index: st.sequence };
    let args: IdList = IdList.ICons { head: Id { value: operand.id }, tail: IdList.INil };
    let inst: Instruction = Instruction { id: st.next_instruction, sequence: st.sequence, kind: 4, operator: 0, result: value.id, ty: ty, inputs: args, argc: 1, params: decl.BindList.BNil, identity: invalid_identity(), nominal_identity: invalid_identity(), variant_start: 0, variant_end: 0, binding_start: 0, binding_end: 0, effects: decl.EffectIdentityList.EINil, capabilities: decl.CapabilityIdentityList.CINil, start: start, end: end };
    let valid: bool = decl.sem_eq<P, N>(pages, stride, total, operand.ty, decl.SemType.TBool);
    return ExprBuild { rest: rest, env: st.env, stack: ValueStack.WCons { head: value, tail: remaining }, instructions: InstructionList.QCons { head: inst, tail: st.instructions }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, next_instruction: st.next_instruction + 1, sequence: st.sequence + 1, block: st.block, parameters: st.parameters, generated_blocks: st.generated_blocks, next_block_id: st.next_block_id, nominals: st.nominals, ok: st.ok && valid && decl.sem_eq<P, N>(pages, stride, total, ty, decl.SemType.TBool), failure_op: st.failure_op };
}
fn lower_project<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, ty: decl.SemType, fstart: u64, fend: u64, field_index: u64, start: u64, end: u64) -> (result: ExprBuild) {
    return match st.stack {
        WNil => ExprBuild { ..st, rest: rest, ok: false, failure_op: select(st.failure_op > 0, st.failure_op, 3) },
        WCons { head: base, tail: remaining } => emit_project<P, N>(pages, stride, total, st, rest, ty, fstart, fend, field_index, start, end, base, remaining)
    };
}
fn emit_project<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, ty: decl.SemType, fstart: u64, fend: u64, field_index: u64, start: u64, end: u64, base: Value, remaining: ValueStack) -> (result: ExprBuild) {
    let value: Value = Value { id: st.next_value, ty: ty, owner_block: st.block, kind: 2, index: st.sequence };
    let args: IdList = IdList.ICons { head: Id { value: base.id }, tail: IdList.INil };
    let nominal: decl.SemanticIdentity = nominal_identity_for_type<P, N>(pages, stride, total, st.nominals, base.ty);
    let inst: Instruction = Instruction { id: st.next_instruction, sequence: st.sequence, kind: 8, operator: field_index, result: value.id, ty: ty, inputs: args, argc: 1, params: decl.BindList.BNil, identity: invalid_identity(), nominal_identity: nominal, variant_start: 0, variant_end: 0, binding_start: fstart, binding_end: fend, effects: decl.EffectIdentityList.EINil, capabilities: decl.CapabilityIdentityList.CINil, start: start, end: end };
    let valid: bool = is_named_type(base.ty) && nominal.valid && fend > fstart && supported_value_type<P, N>(pages, stride, total, ty, st.nominals);
    return ExprBuild { rest: rest, env: st.env, stack: ValueStack.WCons { head: value, tail: remaining }, instructions: InstructionList.QCons { head: inst, tail: st.instructions }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, next_instruction: st.next_instruction + 1, sequence: st.sequence + 1, block: st.block, parameters: st.parameters, generated_blocks: st.generated_blocks, next_block_id: st.next_block_id, nominals: st.nominals, ok: st.ok && valid, failure_op: select(st.failure_op > 0, st.failure_op, select(valid, 0, 3)) };
}
fn lower_name<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, ty: decl.SemType, start: u64, end: u64) -> (result: ExprBuild) {
    let found: BindingLookup = lookup_binding<P, N>(pages, stride, total, st.env, start, end);
    if !(found.found) || !(decl.sem_eq<P, N>(pages, stride, total, found.binding.ty, ty)) { return ExprBuild { ..st, rest: rest, ok: false }; }
    return ExprBuild { rest: rest, env: st.env, stack: ValueStack.WCons { head: Value { id: found.binding.value, ty: found.binding.ty, owner_block: 0, kind: 3, index: 0 }, tail: st.stack }, instructions: st.instructions, values: st.values, next_value: st.next_value, next_instruction: st.next_instruction, sequence: st.sequence, block: st.block, parameters: st.parameters, generated_blocks: st.generated_blocks, next_block_id: st.next_block_id, nominals: st.nominals, ok: st.ok, failure_op: st.failure_op };
}
record BindingLookup { found: bool, binding: Binding }
record BindingScan { rest: Environment, start: u64, end: u64, found: bool, binding: Binding }
fn lookup_binding<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, env: Environment, start: u64, end: u64) -> (result: BindingLookup) {
    iterate i up_to 1024 carrying st: BindingScan = BindingScan { rest: env, start: start, end: end, found: false, binding: Binding { name_start: 0, name_end: 0, value: 0, ty: decl.SemType.TPoison } } { next st = binding_scan_step<P, N>(pages, stride, total, st); }
    return BindingLookup { found: st.found, binding: st.binding };
}
fn binding_scan_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BindingScan) -> (result: BindingScan) {
    if st.found { return st; }
    return match st.rest { EnvNil => st, EnvCons { head: h, tail: t } => binding_scan_cons<P, N>(pages, stride, total, st, h, t) };
}
fn binding_scan_cons<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BindingScan, h: Binding, t: Environment) -> (result: BindingScan) {
    if decl.spans_equal<P, N>(pages, stride, total, h.name_start, h.name_end, st.start, st.end) { return BindingScan { rest: Environment.EnvNil, start: st.start, end: st.end, found: true, binding: h }; }
    return BindingScan { ..st, rest: t };
}

fn lower_binary<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, op: u64, ty: decl.SemType, start: u64, end: u64) -> (result: ExprBuild) {
    return match st.stack {
        WNil => ExprBuild { ..st, rest: rest, ok: false },
        WCons { head: right, tail: lefts } => lower_binary_left<P, N>(pages, stride, total, st, rest, op, ty, start, end, right, lefts)
    };
}
fn lower_binary_left<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, op: u64, ty: decl.SemType, start: u64, end: u64, right: Value, lefts: ValueStack) -> (result: ExprBuild) {
    return match lefts {
        WNil => ExprBuild { ..st, rest: rest, ok: false },
        WCons { head: left, tail: tail } => emit_binary<P, N>(pages, stride, total, st, rest, op, ty, start, end, right, left, tail)
    };
}
fn emit_binary<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, op: u64, ty: decl.SemType, start: u64, end: u64, right: Value, left: Value, tail: ValueStack) -> (result: ExprBuild) {
    let value: Value = Value { id: st.next_value, ty: ty, owner_block: st.block, kind: 2, index: st.sequence };
    let args: IdList = IdList.ICons { head: Id { value: left.id }, tail: IdList.ICons { head: Id { value: right.id }, tail: IdList.INil } };
    let inst: Instruction = Instruction { id: st.next_instruction, sequence: st.sequence, kind: 2, operator: op, result: value.id, ty: ty, inputs: args, argc: 2, params: decl.BindList.BNil, identity: invalid_identity(), nominal_identity: invalid_identity(), variant_start: 0, variant_end: 0, binding_start: 0, binding_end: 0, effects: decl.EffectIdentityList.EINil, capabilities: decl.CapabilityIdentityList.CINil, start: start, end: end };
    return ExprBuild { rest: rest, env: st.env, stack: ValueStack.WCons { head: value, tail: tail }, instructions: InstructionList.QCons { head: inst, tail: st.instructions }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, next_instruction: st.next_instruction + 1, sequence: st.sequence + 1, block: st.block, parameters: st.parameters, generated_blocks: st.generated_blocks, next_block_id: st.next_block_id, nominals: st.nominals, ok: st.ok && scalar_type(left.ty) && decl.sem_eq<P, N>(pages, stride, total, left.ty, right.ty) && scalar_type(ty), failure_op: st.failure_op };
}

// Compiler operations lower to kind-9 instructions carrying the operation
// slot as the operator, the stable operation identity, and the operation
// name span in the binding fields. Operand typing is the verifier's job
// (verify_op_instruction), mirroring call lowering.
fn lower_top_op<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, ty: decl.SemType, slot: u64, argc: u64, ns: u64, ne: u64, identity: decl.SemanticIdentity, start: u64, end: u64) -> (result: ExprBuild) {
    iterate i up_to 1024 carrying popped: PopArgs = PopArgs { stack: st.stack, remaining: argc, arguments: IdList.INil, ok: true } { next popped = pop_call_arg(popped); }
    if !(popped.ok) || popped.remaining != 0 || slot > 4 || argc != decl.op_arity(slot) || !(identity.valid) { return ExprBuild { ..st, rest: rest, ok: false }; }
    let value: Value = Value { id: st.next_value, ty: ty, owner_block: st.block, kind: 2, index: st.sequence };
    let inst: Instruction = Instruction { id: st.next_instruction, sequence: st.sequence, kind: 9, operator: slot, result: value.id, ty: ty, inputs: popped.arguments, argc: argc, params: decl.BindList.BNil, identity: identity, nominal_identity: invalid_identity(), variant_start: 0, variant_end: 0, binding_start: ns, binding_end: ne, effects: decl.EffectIdentityList.EINil, capabilities: decl.CapabilityIdentityList.CINil, start: start, end: end };
    return ExprBuild { rest: rest, env: st.env, stack: ValueStack.WCons { head: value, tail: popped.stack }, instructions: InstructionList.QCons { head: inst, tail: st.instructions }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, next_instruction: st.next_instruction + 1, sequence: st.sequence + 1, block: st.block, parameters: st.parameters, generated_blocks: st.generated_blocks, next_block_id: st.next_block_id, nominals: st.nominals, ok: st.ok && supported_value_type<P, N>(pages, stride, total, ty, st.nominals), failure_op: st.failure_op };
}
fn lower_call<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ExprBuild, rest: decl.TOpList, ty: decl.SemType, argc: u64, params: decl.BindList, identity: decl.SemanticIdentity, effects: decl.EffectIdentityList, capabilities: decl.CapabilityIdentityList, start: u64, end: u64) -> (result: ExprBuild) {
    iterate i up_to 1024 carrying popped: PopArgs = PopArgs { stack: st.stack, remaining: argc, arguments: IdList.INil, ok: true } { next popped = pop_call_arg(popped); }
    if !(popped.ok) || popped.remaining != 0 || !(identity.valid) || !(decl.signature_identity_valid<P, N>(pages, stride, total, effects, capabilities)) { return ExprBuild { ..st, rest: rest, ok: false }; }
    let value: Value = Value { id: st.next_value, ty: ty, owner_block: st.block, kind: 2, index: st.sequence };
    let inst: Instruction = Instruction { id: st.next_instruction, sequence: st.sequence, kind: 3, operator: 0, result: value.id, ty: ty, inputs: popped.arguments, argc: argc, params: params, identity: identity, nominal_identity: invalid_identity(), variant_start: 0, variant_end: 0, binding_start: 0, binding_end: 0, effects: effects, capabilities: capabilities, start: start, end: end };
    return ExprBuild { rest: rest, env: st.env, stack: ValueStack.WCons { head: value, tail: popped.stack }, instructions: InstructionList.QCons { head: inst, tail: st.instructions }, values: ValueList.VCons { head: value, tail: st.values }, next_value: st.next_value + 1, next_instruction: st.next_instruction + 1, sequence: st.sequence + 1, block: st.block, parameters: st.parameters, generated_blocks: st.generated_blocks, next_block_id: st.next_block_id, nominals: st.nominals, ok: st.ok && supported_value_type<P, N>(pages, stride, total, ty, st.nominals), failure_op: st.failure_op };
}
fn pop_call_arg(st: PopArgs) -> (result: PopArgs) {
    if !(st.ok) || st.remaining == 0 { return st; }
    return match st.stack {
        WNil => PopArgs { ..st, ok: false },
        WCons { head: value, tail: rest } => PopArgs { stack: rest, remaining: st.remaining - 1, arguments: IdList.ICons { head: Id { value: value.id }, tail: st.arguments }, ok: true }
    };
}

fn reverse_instructions<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, instructions: InstructionList) -> (result: InstructionList) {
    iterate i up_to 1024 carrying st: InstructionReverse = InstructionReverse { rest: instructions, acc: InstructionList.QNil } { next st = reverse_instruction_step(st); }
    return st.acc;
}
record InstructionReverse { rest: InstructionList, acc: InstructionList }
fn reverse_instruction_step(st: InstructionReverse) -> (result: InstructionReverse) {
    return match st.rest { QNil => st, QCons { head: h, tail: t } => InstructionReverse { rest: t, acc: InstructionList.QCons { head: h, tail: st.acc } } };
}
fn reverse_blocks<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, blocks: SsaBlockList) -> (result: SsaBlockList) {
    iterate i up_to 1024 carrying st: SsaBlockRev = SsaBlockRev { rest: blocks, acc: SsaBlockList.LNil } { next st = reverse_block_step(st); }
    return st.acc;
}
fn reverse_block_step(st: SsaBlockRev) -> (result: SsaBlockRev) {
    return match st.rest { LNil => st, LCons { head: h, tail: t } => SsaBlockRev { rest: t, acc: SsaBlockList.LCons { head: h, tail: st.acc } } };
}

fn make_terminator<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, block: flow.Block, exprs: ExpressionBuild) -> (result: Terminator) {
    if block.kind == 1 { return Terminator.Branch { condition: exprs.branch_value, yes: block.succ0, no: block.succ1, yes_args: binding_ids<P, N>(pages, stride, total, exprs.env), no_args: binding_ids<P, N>(pages, stride, total, exprs.env) }; }
    if block.kind == 2 { return Terminator.Jump { target: block.succ0, arguments: binding_ids<P, N>(pages, stride, total, exprs.env) }; }
    if block.kind == 3 { return Terminator.Return { value: exprs.return_value }; }
    return Terminator.Fail;
}
fn terminator_shape(block: flow.Block, term: Terminator) -> (result: bool) {
    if block.kind == 1 { return match term { Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => block.succ_count == 2 && y == block.succ0 && n == block.succ1, Jump { target: t, arguments: a } => false, FiniteSwitch { subject: subject, subject_ty: subject_ty, nominal_identity: nominal, result_type: result_ty, source_start: start, source_end: end, arm_count: count, join_target: join, cases: cases } => false, ScalarSwitch { subject: subject, subject_ty: subject_ty, result_type: result_ty, source_start: start, source_end: end, arm_count: count, default_target: default_target, join_target: join, cases: cases } => false, Return { value: v } => false, Fail => false }; }
    if block.kind == 2 { return match term { Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => false, Jump { target: t, arguments: a } => block.succ_count == 1 && t == block.succ0, FiniteSwitch { subject: subject, subject_ty: subject_ty, nominal_identity: nominal, result_type: result_ty, source_start: start, source_end: end, arm_count: count, join_target: join, cases: cases } => false, ScalarSwitch { subject: subject, subject_ty: subject_ty, result_type: result_ty, source_start: start, source_end: end, arm_count: count, default_target: default_target, join_target: join, cases: cases } => false, Return { value: v } => false, Fail => false }; }
    if block.kind == 3 { return match term { Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => false, Jump { target: t, arguments: a } => false, FiniteSwitch { subject: subject, subject_ty: subject_ty, nominal_identity: nominal, result_type: result_ty, source_start: start, source_end: end, arm_count: count, join_target: join, cases: cases } => false, ScalarSwitch { subject: subject, subject_ty: subject_ty, result_type: result_ty, source_start: start, source_end: end, arm_count: count, default_target: default_target, join_target: join, cases: cases } => false, Return { value: v } => block.succ_count == 0, Fail => false }; }
    if block.kind == 4 { return match term { Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => false, Jump { target: t, arguments: a } => false, FiniteSwitch { subject: subject, subject_ty: subject_ty, nominal_identity: nominal, result_type: result_ty, source_start: start, source_end: end, arm_count: count, join_target: join, cases: cases } => false, ScalarSwitch { subject: subject, subject_ty: subject_ty, result_type: result_ty, source_start: start, source_end: end, arm_count: count, default_target: default_target, join_target: join, cases: cases } => false, Return { value: v } => false, Fail => block.succ_count == 0 }; }
    return false;
}
fn binding_ids<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, bindings: Environment) -> (result: IdList) {
    iterate i up_to 1024 carrying st: BindingIdBuild = BindingIdBuild { rest: bindings, acc: IdList.INil } { next st = binding_id_step(st); }
    return st.acc;
}
record BindingIdBuild { rest: Environment, acc: IdList }
fn binding_id_step(st: BindingIdBuild) -> (result: BindingIdBuild) {
    return match st.rest { EnvNil => st, EnvCons { head: h, tail: t } => BindingIdBuild { rest: t, acc: IdList.ICons { head: Id { value: h.value }, tail: st.acc } } };
}
fn add_block_edges<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, edges: EdgeList, block: flow.Block, term: Terminator, env: Environment) -> (result: EdgeList) {
    return add_block_edges_from<P, N>(pages, stride, total, edges, block.id, block, term, env);
}
fn add_block_edges_from<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, edges: EdgeList, source: u64, block: flow.Block, term: Terminator, env: Environment) -> (result: EdgeList) {
    return match term {
        Branch { condition: c, yes: y, no: n, yes_args: ya, no_args: na } => EdgeList.ECons { head: Edge { source: source, target: n, bindings: env, arguments: na }, tail: EdgeList.ECons { head: Edge { source: source, target: y, bindings: env, arguments: ya }, tail: edges } },
        Jump { target: target, arguments: args } => EdgeList.ECons { head: Edge { source: source, target: target, bindings: env, arguments: args }, tail: edges },
        FiniteSwitch { subject: subject, subject_ty: subject_ty, nominal_identity: nominal, result_type: result_ty, source_start: start, source_end: end, arm_count: count, join_target: join, cases: cases } => edges,
        ScalarSwitch { subject: subject, subject_ty: subject_ty, result_type: result_ty, source_start: start, source_end: end, arm_count: count, default_target: default_target, join_target: join, cases: cases } => edges,
        Return { value: v } => edges,
        Fail => edges
    };
}

fn verify_function<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function) -> (result: bool) {
    // CP-0021: fail closed on a non-canonical page composition, mirroring
    // the parse_unit gate; project-chained lowering trusts build time.
    if source.validate_pages<P, N>(pages, stride, total) != 0 { return false; }
    if !(function.identity.valid) || function.identity.len == 0 || !(function.supported) || !(supported_value_type<P, N>(pages, stride, total, function.result_type, function.nominals)) || function.value_count == 0 { return false; }
    if !(verify_value_ids<P, N>(pages, stride, total, function)) || !(verify_function_inputs<P, N>(pages, stride, total, function)) { return false; }
    if !(verify_blocks<P, N>(pages, stride, total, function, function.blocks)) || !(verify_definition_counts<P, N>(pages, stride, total, function)) { return false; }
    return true;
}
record ValueIdCheck { rest: ValueList, seen: u64, ok: bool, count: u64, nominals: decl.NominalTypeIdentityList }
fn verify_value_ids<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function) -> (result: bool) {
    iterate i up_to 1024 carrying st: ValueIdCheck = ValueIdCheck { rest: function.values, seen: 0, ok: true, count: function.value_count, nominals: function.nominals } { next st = value_id_step<P, N>(pages, stride, total, st); }
    return st.ok && st.seen == st.count && value_list_empty(st.rest);
}
fn value_id_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ValueIdCheck) -> (result: ValueIdCheck) {
    if !(st.ok) { return st; }
    return match st.rest { VNil => st, VCons { head: h, tail: t } => ValueIdCheck { rest: t, seen: st.seen + 1, ok: h.id < st.count && h.kind < 3 && supported_value_type<P, N>(pages, stride, total, h.ty, st.nominals) && !(value_id_in<P, N>(pages, stride, total, t, h.id)), count: st.count, nominals: st.nominals } };
}
record ValueIdLookup { rest: ValueList, id: u64, found: bool }
fn value_id_in<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, id: u64) -> (result: bool) {
    iterate i up_to 1024 carrying st: ValueIdLookup = ValueIdLookup { rest: values, id: id, found: false } { next st = value_id_lookup_step(st); }
    return st.found;
}
fn value_id_lookup_step(st: ValueIdLookup) -> (result: ValueIdLookup) {
    if st.found { return st; }
    return match st.rest { VNil => st, VCons { head: h, tail: t } => ValueIdLookup { rest: t, id: st.id, found: h.id == st.id } };
}
fn value_list_empty(values: ValueList) -> (result: bool) { return match values { VNil => true, VCons { head: h, tail: t } => false }; }
fn verify_function_inputs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function) -> (result: bool) {
    let inputs_ok: bool = verify_input_list<P, N>(pages, stride, total, function.values, function.inputs);
    return inputs_ok && value_count<P, N>(pages, stride, total, function.inputs) == value_kind_count<P, N>(pages, stride, total, function.values, 0);
}
record InputCheck { rest: ValueList, values: ValueList, ok: bool }
fn verify_input_list<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, inputs: ValueList) -> (result: bool) {
    iterate i up_to 1024 carrying st: InputCheck = InputCheck { rest: inputs, values: values, ok: true } { next st = verify_input_step<P, N>(pages, stride, total, st); }
    return st.ok && value_list_empty(st.rest);
}
fn verify_input_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: InputCheck) -> (result: InputCheck) {
    if !(st.ok) { return st; }
    return match st.rest { VNil => st, VCons { head: value, tail: rest } => verify_input_one<P, N>(pages, stride, total, st, value, rest) };
}
fn verify_input_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: InputCheck, value: Value, rest: ValueList) -> (result: InputCheck) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, st.values, value.id);
    let same: bool = found.found && found.value.kind == 0 && found.value.id == value.id && decl.sem_eq<P, N>(pages, stride, total, found.value.ty, value.ty);
    return InputCheck { rest: rest, values: st.values, ok: value.kind == 0 && value.owner_block == 0 && value.index == 0 && same && !(value_id_in<P, N>(pages, stride, total, rest, value.id)) };
}
record ValueKindCount { rest: ValueList, kind: u64, count: u64 }
fn value_kind_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, kind: u64) -> (result: u64) {
    iterate i up_to 1024 carrying st: ValueKindCount = ValueKindCount { rest: values, kind: kind, count: 0 } { next st = value_kind_count_step(st); }
    return st.count;
}
fn value_kind_count_step(st: ValueKindCount) -> (result: ValueKindCount) {
    return match st.rest { VNil => st, VCons { head: value, tail: rest } => ValueKindCount { rest: rest, kind: st.kind, count: st.count + select(value.kind == st.kind, 1, 0) } };
}
fn verify_blocks<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, blocks: SsaBlockList) -> (result: bool) {
    iterate i up_to 1024 carrying st: BlockCheck = BlockCheck { rest: blocks, function: function, ok: true, count: 0 } { next st = verify_block_step<P, N>(pages, stride, total, st); }
    return st.ok && block_list_empty(st.rest) && st.count > 0 && verify_block_ids<P, N>(pages, stride, total, blocks, st.count);
}
record BlockCheck { rest: SsaBlockList, function: Function, ok: bool, count: u64 }
fn block_list_empty(blocks: SsaBlockList) -> (result: bool) { return match blocks { LNil => true, LCons { head: h, tail: t } => false }; }
fn verify_block_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockCheck) -> (result: BlockCheck) {
    if !(st.ok) { return st; }
    return match st.rest { LNil => st, LCons { head: block, tail: rest } => BlockCheck { rest: rest, function: st.function, ok: verify_one_block<P, N>(pages, stride, total, st.function, block), count: st.count + 1 } };
}
fn verify_one_block<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, block: SsaBlock) -> (result: bool) {
    let params_ok: bool = verify_parameters<P, N>(pages, stride, total, function, block.id, block.parameters);
    let instructions_ok: bool = verify_instructions<P, N>(pages, stride, total, function, block, block.instructions);
    let term_ok: bool = verify_terminator<P, N>(pages, stride, total, function, block, block.terminator, block.instructions);
    return block.lowering_ok && params_ok && instructions_ok && term_ok;
}
record BlockIdCheck { rest: SsaBlockList, total: u64, seen: u64, ok: bool }
record BlockIdLookup { rest: SsaBlockList, id: u64, found: bool }
fn verify_block_ids<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, blocks: SsaBlockList, expected: u64) -> (result: bool) {
    iterate i up_to 1024 carrying st: BlockIdCheck = BlockIdCheck { rest: blocks, total: expected, seen: 0, ok: true } { next st = verify_block_id_step<P, N>(pages, stride, total, st); }
    return st.ok && st.seen == expected && block_list_empty(st.rest);
}
fn verify_block_id_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: BlockIdCheck) -> (result: BlockIdCheck) {
    if !(st.ok) { return st; }
    return match st.rest {
        LNil => st,
        LCons { head: block, tail: rest } => BlockIdCheck { rest: rest, total: st.total, seen: st.seen + 1, ok: block.id < st.total && !(block_id_in<P, N>(pages, stride, total, rest, block.id)) }
    };
}
fn block_id_in<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, blocks: SsaBlockList, id: u64) -> (result: bool) {
    iterate i up_to 1024 carrying st: BlockIdLookup = BlockIdLookup { rest: blocks, id: id, found: false } { next st = block_id_lookup_step(st); }
    return st.found;
}
fn block_id_lookup_step(st: BlockIdLookup) -> (result: BlockIdLookup) {
    if st.found { return st; }
    return match st.rest { LNil => st, LCons { head: block, tail: rest } => BlockIdLookup { rest: rest, id: st.id, found: block.id == st.id } };
}
fn verify_parameters<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, block_id: u64, params: ValueList) -> (result: bool) {
    let last_index: u64 = value_count<P, N>(pages, stride, total, params);
    let first_index: u64 = predecessor_or_zero(last_index);
    iterate i up_to 1024 carrying st: ParameterCheck = ParameterCheck { rest: params, function: function, block: block_id, index: first_index, ok: true } { next st = verify_parameter_step<P, N>(pages, stride, total, st); }
    return st.ok && value_list_empty(st.rest);
}
fn predecessor_or_zero(value: u64) -> (result: u64) {
    if value == 0 { return 0; }
    return value - 1;
}
record ParameterCheck { rest: ValueList, function: Function, block: u64, index: u64, ok: bool }
fn verify_parameter_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ParameterCheck) -> (result: ParameterCheck) {
    if !(st.ok) { return st; }
    return match st.rest { VNil => st, VCons { head: v, tail: t } => parameter_is_defined<P, N>(pages, stride, total, st, v, t) };
}
fn parameter_is_defined<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ParameterCheck, value: Value, rest: ValueList) -> (result: ParameterCheck) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, st.function.values, value.id);
    let same: bool = found.found && found.value.kind == value.kind && found.value.owner_block == value.owner_block && found.value.index == value.index && decl.sem_eq<P, N>(pages, stride, total, found.value.ty, value.ty);
    let next_index: u64 = predecessor_or_zero(st.index);
    return ParameterCheck { rest: rest, function: st.function, block: st.block, index: next_index, ok: value.kind == 1 && value.owner_block == st.block && value.index == st.index && same };
}

fn verify_instructions<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, block: SsaBlock, instructions: InstructionList) -> (result: bool) {
    iterate i up_to 1024 carrying st: InstructionCheck = InstructionCheck { rest: instructions, function: function, block: block.id, ok: true, sequence: 0 } { next st = verify_instruction_step<P, N>(pages, stride, total, st); }
    return st.ok && instruction_list_empty(st.rest);
}
record InstructionCheck { rest: InstructionList, function: Function, block: u64, ok: bool, sequence: u64 }
fn instruction_list_empty(instructions: InstructionList) -> (result: bool) { return match instructions { QNil => true, QCons { head: h, tail: t } => false }; }
fn verify_instruction_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: InstructionCheck) -> (result: InstructionCheck) {
    if !(st.ok) { return st; }
    return match st.rest { QNil => st, QCons { head: inst, tail: rest } => InstructionCheck { rest: rest, function: st.function, block: st.block, ok: verify_instruction<P, N>(pages, stride, total, st.function, st.block, inst, st.sequence), sequence: st.sequence + 1 } };
}
record DefinitionCountScan { rest: SsaBlockList, parameters: u64, instructions: u64 }
fn verify_definition_counts<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function) -> (result: bool) {
    iterate i up_to 1024 carrying st: DefinitionCountScan = DefinitionCountScan { rest: function.blocks, parameters: 0, instructions: 0 } { next st = definition_count_step<P, N>(pages, stride, total, st); }
    return st.parameters == value_kind_count<P, N>(pages, stride, total, function.values, 1) && st.instructions == value_kind_count<P, N>(pages, stride, total, function.values, 2);
}
fn definition_count_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: DefinitionCountScan) -> (result: DefinitionCountScan) {
    return match st.rest {
        LNil => st,
        LCons { head: block, tail: rest } => DefinitionCountScan { rest: rest, parameters: st.parameters + value_count<P, N>(pages, stride, total, block.parameters), instructions: st.instructions + instruction_count<P, N>(pages, stride, total, block.instructions) }
    };
}
fn verify_instruction<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, block: u64, inst: Instruction, sequence: u64) -> (result: bool) {
    if inst.sequence != sequence || !(available_values<P, N>(pages, stride, total, function.values, inst.inputs, block, sequence)) { return false; }
    let result_value: LookupValue = find_value<P, N>(pages, stride, total, function.values, inst.result);
    if !(result_value.found) || result_value.value.kind != 2 || result_value.value.owner_block != block || result_value.value.index != sequence || !(decl.sem_eq<P, N>(pages, stride, total, result_value.value.ty, inst.ty)) { return false; }
    if inst.kind == 0 { return id_list_empty(inst.inputs) && scalar_type(inst.ty); }
    if inst.kind == 1 { return id_list_empty(inst.inputs) && scalar_type(inst.ty); }
    if inst.kind == 2 { return verify_binary_instruction<P, N>(pages, stride, total, function, inst); }
    if inst.kind == 3 { return verify_call_instruction<P, N>(pages, stride, total, function, inst); }
    if inst.kind == 4 { return verify_not_instruction<P, N>(pages, stride, total, function, inst); }
    if inst.kind == 5 { return verify_enum_construct_instruction<P, N>(pages, stride, total, function, inst); }
    if inst.kind == 6 { return verify_match_payload_instruction<P, N>(pages, stride, total, function, inst); }
    if inst.kind == 7 { return verify_repeat_instruction<P, N>(pages, stride, total, function, inst); }
    if inst.kind == 8 { return verify_project_instruction<P, N>(pages, stride, total, function, inst); }
    if inst.kind == 9 { return verify_op_instruction<P, N>(pages, stride, total, function, inst); }
    return false;
}
fn verify_repeat_instruction<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inst: Instruction) -> (result: bool) {
    return match inst.inputs {
        IdList.INil => false,
        IdList.ICons { head: element, tail: rest } => verify_repeat_operand<P, N>(pages, stride, total, function, inst, element, rest)
    };
}
fn verify_repeat_operand<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inst: Instruction, element: Id, rest: IdList) -> (result: bool) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, function.values, element.value);
    let shape_ok: bool = match inst.ty {
        TSeqExact { element: result_element, length: length, length_valid: valid } => valid && length == inst.operator && decl.sem_eq<P, N>(pages, stride, total, result_element, found.value.ty),
        TBool => false,
        TByte => false,
        TInt { width: width, signed: signed } => false,
        TNamed { start: start, end: end } => false,
        TSeq => false,
        TPoison => false
    };
    let source_ok: bool = repeat_source_count_matches<P, N>(pages, stride, total, inst.start, inst.end, inst.operator);
    return id_list_empty(rest) && inst.argc == 1 && found.found && shape_ok && source_ok && decl.bind_list_empty(inst.params) && !(inst.identity.valid) && !(inst.nominal_identity.valid) && inst.variant_start == 0 && inst.variant_end == 0 && inst.binding_start == 0 && inst.binding_end == 0 && decl.signature_identity_valid<P, N>(pages, stride, total, inst.effects, inst.capabilities) && supported_value_type<P, N>(pages, stride, total, inst.ty, function.nominals);
}
fn repeat_source_count_matches<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, expected: u64) -> (result: bool) {
    let parsed: decl.ExprParse = decl.parse_expr<P, N>(pages, stride, total, start, true);
    if !(parsed.ok) || parsed.start != start || parsed.end != end { return false; }
    return match parsed.node {
        Repeat { value: value, count_start: count_start, count_end: count_end, count_kind: count_kind, start: repeat_start, end: repeat_end } => repeat_start == start && repeat_end == end && repeat_count_literal_matches<P, N>(pages, stride, total, count_kind, count_start, count_end, expected),
        Name { start: name_start, end: name_end } => false,
        Integer { start: integer_start, end: integer_end, value: value, overflow: overflow } => false,
        Boolean { start: boolean_start, end: boolean_end, value: value } => false,
        UnaryNot { value: value, start: not_start, end: not_end } => false,
        ScalarMatch { subject: subject, arms: arms, start: match_start, end: match_end } => false,
        Binary { op: op, left: left, right: right, start: binary_start, end: binary_end } => false,
        Call { name_start: name_start, name_end: name_end, args: args, targs: tg, start: call_start, end: call_end } => false,
        Project { base: base, field_start: field_start, field_end: field_end, start: project_start, end: project_end, path: path } => false,
        FiniteMatch { subject: subject, arms: arms, start: match_start, end: match_end } => false,
        EnumConstruct { type_start: type_start, type_end: type_end, variant_start: variant_start, variant_end: variant_end, fields: fields, start: construct_start, end: construct_end } => false,
        Index { base: ib, index: ii, start: is, end: ie } => false,
        Cast { value: cv, type_start: cts, type_end: cte, type_kind: ctk, start: cs, end: ce } => false,
        RecordConstruct { type_start: type_start, type_end: type_end, base: b, has_base: hb, fields: fields, start: construct_start, end: construct_end } => false,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => false
    };
}
fn repeat_count_literal_matches<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, kind: u64, start: u64, end: u64, expected: u64) -> (result: bool) {
    let parsed: decl.IntVal = decl.int_value<P, N>(pages, stride, total, start, end);
    return kind == 5 && !(parsed.overflow) && parsed.value == expected;
}
fn verify_project_instruction<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inst: Instruction) -> (result: bool) {
    return match inst.inputs {
        IdList.INil => false,
        IdList.ICons { head: base, tail: rest } => verify_project_base<P, N>(pages, stride, total, function, inst, base, rest)
    };
}
fn verify_project_base<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inst: Instruction, base: Id, rest: IdList) -> (result: bool) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, function.values, base.value);
    let expected_nominal: decl.SemanticIdentity = nominal_identity_for_type<P, N>(pages, stride, total, function.nominals, found.value.ty);
    let source_ok: bool = project_source_valid<P, N>(pages, stride, total, inst.start, inst.end, inst.binding_start, inst.binding_end);
    let declared_ok: bool = project_declared_field<P, N>(pages, stride, total, function, found.value.ty, inst.binding_start, inst.binding_end, inst.operator, inst.ty);
    return id_list_empty(rest) && inst.argc == 1 && found.found && is_named_type(found.value.ty) && expected_nominal.valid && decl.semantic_identity_equal(expected_nominal, inst.nominal_identity) && declared_ok && inst.binding_end > inst.binding_start && inst.variant_start == 0 && inst.variant_end == 0 && source_ok && !(inst.identity.valid) && decl.bind_list_empty(inst.params) && decl.signature_identity_valid<P, N>(pages, stride, total, inst.effects, inst.capabilities) && supported_value_type<P, N>(pages, stride, total, inst.ty, function.nominals);
}
fn project_declared_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, base_ty: decl.SemType, fstart: u64, fend: u64, field_index: u64, output_ty: decl.SemType) -> (result: bool) {
    return match base_ty {
        TNamed { start: type_start, end: type_end } => project_declared_named_field<P, N>(pages, stride, total, function, type_start, type_end, fstart, fend, field_index, output_ty),
        TBool => false,
        TByte => false,
        TInt { width: width, signed: signed } => false,
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: valid } => false,
        TPoison => false
    };
}
fn project_declared_named_field<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, type_start: u64, type_end: u64, fstart: u64, fend: u64, field_index: u64, output_ty: decl.SemType) -> (result: bool) {
    let unit: decl.Unit = decl.parse_unit<P, N>(pages, stride, total);
    let found_record: decl.RecFind = decl.rec_lookup<P, N>(pages, stride, total, unit.records, type_start, type_end);
    if !(unit.ok) || !(found_record.found) { return false; }
    let field: decl.FieldScan = decl.field_scan<P, N>(pages, stride, total, found_record.decl.fields, fstart, fend);
    if !(field.found) || field.index != field_index { return false; }
    let resolved: decl.TyRes = decl.resolve_type<P, N>(pages, stride, total, field.field.type_kind, field.field.type_start, field.field.type_end, unit.records, unit.enums, function.nominals);
    return resolved.ok && decl.sem_eq<P, N>(pages, stride, total, resolved.ty, output_ty);
}
fn project_source_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, fstart: u64, fend: u64) -> (result: bool) {
    let parsed: decl.ExprParse = decl.parse_expr<P, N>(pages, stride, total, start, true);
    if !(parsed.ok) || parsed.start != start || parsed.end != end { return false; }
    return match parsed.node {
        Project { base: base, field_start: field_start, field_end: field_end, start: project_start, end: project_end, path: path } => project_start == start && project_end == end && field_start == fstart && field_end == fend,
        Name { start: s, end: e } => false,
        Integer { start: s, end: e, value: value, overflow: overflow } => false,
        Boolean { start: s, end: e, value: value } => false,
        UnaryNot { value: value, start: s, end: e } => false,
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => false,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => false,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => false,
        Binary { op: op, left: left, right: right, start: s, end: e } => false,
        Call { name_start: ns, name_end: ne, args: args, targs: tg, start: s, end: e } => false,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: fields, start: s, end: e } => false,
        Index { base: ib, index: ii, start: is, end: ie } => false,
        Cast { value: cv, type_start: cts, type_end: cte, type_kind: ctk, start: cs, end: ce } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: fields, start: s, end: e } => false,
        OpCall { slot: slot, name_start: os, name_end: oe, args: a, start: s2, end: e2 } => false
    };
}
fn verify_match_payload_instruction<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inst: Instruction) -> (result: bool) {
    return match inst.inputs {
        IdList.INil => false,
        IdList.ICons { head: subject, tail: rest } => verify_match_payload_subject<P, N>(pages, stride, total, function, inst, subject, rest)
    };
}
fn verify_match_payload_subject<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inst: Instruction, subject: Id, rest: IdList) -> (result: bool) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, function.values, subject.value);
    let expected_nominal: decl.SemanticIdentity = nominal_identity_for_type<P, N>(pages, stride, total, function.nominals, found.value.ty);
    let source_ok: bool = payload_extract_source_valid<P, N>(pages, stride, total, inst.start, inst.end, inst.variant_start, inst.variant_end, inst.binding_start, inst.binding_end, inst.params);
    let declared_type_ok: bool = payload_declared_field_type<P, N>(pages, stride, total, function, found.value.ty, inst.variant_start, inst.variant_end, inst.params, inst.ty);
    let field_type_ok: bool = match inst.params {
        decl.BindList.BNil => false,
        decl.BindList.BCons { head: field, tail: fields } => decl.bind_list_empty(fields) && decl.sem_eq<P, N>(pages, stride, total, field.ty, inst.ty)
    };
    return id_list_empty(rest) && inst.argc == 1 && inst.operator == 0 && found.found && is_named_type(found.value.ty) && expected_nominal.valid && decl.semantic_identity_equal(expected_nominal, inst.nominal_identity) && field_type_ok && declared_type_ok && inst.binding_end > inst.binding_start && !(match_payload_wildcard<P, N>(pages, stride, total, inst.binding_start, inst.binding_end)) && source_ok && !(inst.identity.valid) && decl.signature_identity_valid<P, N>(pages, stride, total, inst.effects, inst.capabilities) && supported_value_type<P, N>(pages, stride, total, inst.ty, function.nominals);
}
fn payload_declared_field_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, subject_ty: decl.SemType, variant_start: u64, variant_end: u64, params: decl.BindList, output_ty: decl.SemType) -> (result: bool) {
    return match subject_ty {
        TNamed { start: type_start, end: type_end } => payload_declared_named_field_type<P, N>(pages, stride, total, function, type_start, type_end, variant_start, variant_end, params, output_ty),
        TBool => false,
        TByte => false,
        TInt { width: width, signed: signed } => false,
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: valid } => false,
        TPoison => false
    };
}
fn payload_declared_named_field_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, type_start: u64, type_end: u64, variant_start: u64, variant_end: u64, params: decl.BindList, output_ty: decl.SemType) -> (result: bool) {
    let unit: decl.Unit = decl.parse_unit<P, N>(pages, stride, total);
    let enum_find: decl.EnumFind = decl.enum_lookup<P, N>(pages, stride, total, unit.enums, type_start, type_end);
    if !(unit.ok) || !(enum_find.found) { return false; }
    let variant: decl.VariantScan = decl.variant_scan<P, N>(pages, stride, total, enum_find.decl.variants, variant_start, variant_end);
    if !(variant.found) { return false; }
    return match params {
        decl.BindList.BNil => false,
        decl.BindList.BCons { head: parameter, tail: rest } => payload_declared_field_parameter<P, N>(pages, stride, total, function, variant.variant.fields, parameter, rest, output_ty, unit)
    };
}
fn payload_declared_field_parameter<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, fields: decl.FieldList, parameter: decl.Bind, rest: decl.BindList, output_ty: decl.SemType, unit: decl.Unit) -> (result: bool) {
    if !(decl.bind_list_empty(rest)) { return false; }
    let field: decl.FieldScan = decl.field_scan<P, N>(pages, stride, total, fields, parameter.start, parameter.end);
    if !(field.found) { return false; }
    let resolved: decl.TyRes = decl.resolve_type<P, N>(pages, stride, total, field.field.type_kind, field.field.type_start, field.field.type_end, unit.records, unit.enums, function.nominals);
    return resolved.ok && decl.sem_eq<P, N>(pages, stride, total, resolved.ty, parameter.ty) && decl.sem_eq<P, N>(pages, stride, total, resolved.ty, output_ty);
}
fn payload_extract_source_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, variant_start: u64, variant_end: u64, binding_start: u64, binding_end: u64, params: decl.BindList) -> (result: bool) {
    let parsed: decl.ExprParse = decl.parse_expr<P, N>(pages, stride, total, start, true);
    if !(parsed.ok) || parsed.start != start || parsed.end != end { return false; }
    return match parsed.node {
        FiniteMatch { subject: subject, arms: arms, start: source_start, end: source_end } => source_start == start && source_end == end && payload_source_arm_found<P, N>(pages, stride, total, arms, variant_start, variant_end, binding_start, binding_end, params),
        Name { start: s, end: e } => false,
        Integer { start: s, end: e, value: value, overflow: overflow } => false,
        Boolean { start: s, end: e, value: value } => false,
        UnaryNot { value: value, start: s, end: e } => false,
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => false,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => false,
        Binary { op: op, left: left, right: right, start: s, end: e } => false,
        Call { name_start: ns, name_end: ne, args: args, targs: tg, start: s, end: e } => false,
        Project { base: base, field_start: fs, field_end: fe, start: s, end: e, path: path } => false,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: fields, start: s, end: e } => false,
        Index { base: ib, index: ii, start: is, end: ie } => false,
        Cast { value: cv, type_start: cts, type_end: cte, type_kind: ctk, start: cs, end: ce } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: fields, start: s, end: e } => false,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => false
    };
}
record PayloadSourceArmSearch { rest: decl.FiniteMatchArmList, variant_start: u64, variant_end: u64, binding_start: u64, binding_end: u64, params: decl.BindList, found: bool }
fn payload_source_arm_found<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: decl.FiniteMatchArmList, variant_start: u64, variant_end: u64, binding_start: u64, binding_end: u64, params: decl.BindList) -> (result: bool) {
    iterate i up_to 1024 carrying st: PayloadSourceArmSearch = PayloadSourceArmSearch { rest: arms, variant_start: variant_start, variant_end: variant_end, binding_start: binding_start, binding_end: binding_end, params: params, found: false } { next st = payload_source_arm_step<P, N>(pages, stride, total, st); }
    return st.found;
}
fn payload_source_arm_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadSourceArmSearch) -> (result: PayloadSourceArmSearch) {
    if st.found { return st; }
    return match st.rest {
        decl.FiniteMatchArmList.ANil => st,
        decl.FiniteMatchArmList.ACons { head: arm, tail: rest } => payload_source_arm_one<P, N>(pages, stride, total, st, arm, rest)
    };
}
fn payload_source_arm_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadSourceArmSearch, arm: decl.FiniteMatchArm, rest: decl.FiniteMatchArmList) -> (result: PayloadSourceArmSearch) {
    if arm.variant_start != st.variant_start || arm.variant_end != st.variant_end { return PayloadSourceArmSearch { ..st, rest: rest }; }
    return PayloadSourceArmSearch { ..st, rest: rest, found: payload_source_binding_found<P, N>(pages, stride, total, arm.bindings, st.params, st.binding_start, st.binding_end) };
}
fn payload_source_binding_found<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, bindings: decl.PayloadBindingList, params: decl.BindList, binding_start: u64, binding_end: u64) -> (result: bool) {
    return match params {
        decl.BindList.BNil => false,
        decl.BindList.BCons { head: field, tail: fields } => decl.bind_list_empty(fields) && payload_source_binding_has<P, N>(pages, stride, total, bindings, field.start, field.end, binding_start, binding_end)
    };
}
record PayloadSourceBindingSearch { rest: decl.PayloadBindingList, field_start: u64, field_end: u64, binding_start: u64, binding_end: u64, found: bool }
fn payload_source_binding_has<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, bindings: decl.PayloadBindingList, field_start: u64, field_end: u64, binding_start: u64, binding_end: u64) -> (result: bool) {
    iterate i up_to 1024 carrying st: PayloadSourceBindingSearch = PayloadSourceBindingSearch { rest: bindings, field_start: field_start, field_end: field_end, binding_start: binding_start, binding_end: binding_end, found: false } { next st = payload_source_binding_step<P, N>(pages, stride, total, st); }
    return st.found;
}
fn payload_source_binding_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: PayloadSourceBindingSearch) -> (result: PayloadSourceBindingSearch) {
    if st.found { return st; }
    return match st.rest {
        decl.PayloadBindingList.YNil => st,
        decl.PayloadBindingList.YCons { head: binding, tail: rest } => PayloadSourceBindingSearch { rest: rest, field_start: st.field_start, field_end: st.field_end, binding_start: st.binding_start, binding_end: st.binding_end, found: decl.spans_equal<P, N>(pages, stride, total, binding.field_start, binding.field_end, st.field_start, st.field_end) && decl.spans_equal<P, N>(pages, stride, total, binding.name_start, binding.name_end, st.binding_start, st.binding_end) }
    };
}
fn verify_enum_construct_instruction<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inst: Instruction) -> (result: bool) {
    let nominal: decl.SemanticIdentity = nominal_identity_for_type<P, N>(pages, stride, total, function.nominals, inst.ty);
    let shape_ok: bool = inst.argc == id_count<P, N>(pages, stride, total, inst.inputs) && inst.argc == bind_count<P, N>(pages, stride, total, inst.params);
    let fields_ok: bool = call_argument_types_match<P, N>(pages, stride, total, function.values, inst.inputs, inst.params) && enum_construct_source_valid<P, N>(pages, stride, total, inst.ty, inst.variant_start, inst.variant_end, inst.params, inst.start, inst.end);
    return shape_ok && fields_ok && inst.argc == bind_count<P, N>(pages, stride, total, inst.params) && inst.identity.valid == false && decl.signature_identity_valid<P, N>(pages, stride, total, inst.effects, inst.capabilities) && supported_value_type<P, N>(pages, stride, total, inst.ty, function.nominals) && nominal.valid && decl.semantic_identity_equal(nominal, inst.nominal_identity);
}
fn verify_not_instruction<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inst: Instruction) -> (result: bool) {
    return match inst.inputs {
        INil => false,
        ICons { head: operand, tail: rest } => verify_not_operand<P, N>(pages, stride, total, function.values, operand, rest, inst.ty, inst.argc)
    };
}
fn verify_not_operand<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, operand: Id, rest: IdList, result_type: decl.SemType, argc: u64) -> (result: bool) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, values, operand.value);
    return argc == 1 && id_list_empty(rest) && found.found && decl.sem_eq<P, N>(pages, stride, total, found.value.ty, decl.SemType.TBool) && decl.sem_eq<P, N>(pages, stride, total, result_type, decl.SemType.TBool);
}
fn verify_binary_instruction<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inst: Instruction) -> (result: bool) {
    return match inst.inputs {
        INil => false,
        ICons { head: left, tail: rest } => match rest { INil => false, ICons { head: right, tail: more } => verify_binary_pair<P, N>(pages, stride, total, function.values, left, right, more, inst.operator, inst.ty) }
    };
}
fn verify_binary_pair<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, left: Id, right: Id, rest: IdList, operator: u64, result_type: decl.SemType) -> (result: bool) {
    let a: LookupValue = find_value<P, N>(pages, stride, total, values, left.value);
    let b: LookupValue = find_value<P, N>(pages, stride, total, values, right.value);
    if !(a.found) || !(b.found) || !(id_list_empty(rest)) || !(decl.sem_eq<P, N>(pages, stride, total, a.value.ty, b.value.ty)) || !(scalar_type(result_type)) || decl.prec(operator) == 0 { return false; }
    let class: u64 = decl.op_class(operator);
    if class == 2 || class == 3 { return decl.sem_eq<P, N>(pages, stride, total, result_type, decl.SemType.TBool) && binary_operands_match_class<P, N>(pages, stride, total, class, a.value.ty); }
    return decl.sem_eq<P, N>(pages, stride, total, result_type, a.value.ty) && binary_operands_match_class<P, N>(pages, stride, total, class, a.value.ty);
}
fn binary_operands_match_class<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, class: u64, ty: decl.SemType) -> (result: bool) {
    if class == 3 { return decl.sem_eq<P, N>(pages, stride, total, ty, decl.SemType.TBool); }
    return match ty {
        TInt { width: w, signed: s } => class != 3,
        TByte => class != 3,
        TBool => false,
        TNamed { start: s, end: e } => false,
        TSeq => false,
        TSeqExact { element: element, length: length, length_valid: valid } => false,
        TPoison => false
    };
}
// Kind-9 host-operation instructions: the operator is the operation slot,
// the binding span names the operation, and the identity must equal the
// canonical operation identity re-derived from that span. Operands satisfy
// the same per-slot contract the proof enforces (shared via decl), and the
// instruction is source-anchored by re-parsing, mirroring projections.
fn verify_op_instruction<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inst: Instruction) -> (result: bool) {
    if inst.operator > 4 || inst.argc != decl.op_arity(inst.operator) || !(inst.binding_end > inst.binding_start) { return false; }
    let expected: decl.SemanticIdentity = decl.canonical_operation_identity<P, N>(pages, stride, total, inst.binding_start, inst.binding_end);
    if !(inst.identity.valid) || inst.identity.len == 0 || !(decl.semantic_identity_equal(expected, inst.identity)) { return false; }
    if !(op_source_valid<P, N>(pages, stride, total, inst.operator, inst.binding_start, inst.binding_end, inst.argc, inst.start, inst.end)) { return false; }
    if !(op_result_shape_ok(inst.operator, inst.ty)) { return false; }
    return id_count<P, N>(pages, stride, total, inst.inputs) == inst.argc && op_inputs_match<P, N>(pages, stride, total, function.values, inst.inputs, inst.operator, function.nominals) && bind_list_empty(inst.params) && !(inst.nominal_identity.valid) && inst.variant_start == 0 && inst.variant_end == 0 && decl.signature_identity_valid<P, N>(pages, stride, total, inst.effects, inst.capabilities) && supported_value_type<P, N>(pages, stride, total, inst.ty, function.nominals);
}
fn op_result_shape_ok(slot: u64, ty: decl.SemType) -> (result: bool) {
    if slot == 1 { return !(decl.is_poison(ty)); }
    return decl.is_u64_ty(ty);
}
record OpInputCheck { arguments: IdList, values: ValueList, nominals: decl.NominalTypeIdentityList, slot: u64, index: u64, ok: bool }
fn op_inputs_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, arguments: IdList, slot: u64, nominals: decl.NominalTypeIdentityList) -> (result: bool) {
    iterate i up_to 1024 carrying st: OpInputCheck = OpInputCheck { arguments: arguments, values: values, nominals: nominals, slot: slot, index: 0, ok: true } { next st = op_input_step<P, N>(pages, stride, total, st); }
    return st.ok && id_list_empty(st.arguments);
}
fn op_input_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: OpInputCheck) -> (result: OpInputCheck) {
    if !(st.ok) { return st; }
    return match st.arguments { INil => st, ICons { head: argument, tail: arguments } => op_input_one<P, N>(pages, stride, total, st, argument, arguments) };
}
fn op_input_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: OpInputCheck, argument: Id, arguments: IdList) -> (result: OpInputCheck) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, st.values, argument.value);
    if !(found.found) { return OpInputCheck { arguments: arguments, values: st.values, nominals: st.nominals, slot: st.slot, index: st.index + 1, ok: false }; }
    let bad: u64 = decl.op_operand_kind<P, N>(pages, stride, total, st.slot, st.index, found.value.ty, st.nominals, decl.RecordList.RNil, decl.EnumList.GNil);
    return OpInputCheck { arguments: arguments, values: st.values, nominals: st.nominals, slot: st.slot, index: st.index + 1, ok: bad == 0 };
}
fn op_source_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, slot: u64, ns: u64, ne: u64, argc: u64, start: u64, end: u64) -> (result: bool) {
    let parsed: decl.ExprParse = decl.parse_expr<P, N>(pages, stride, total, start, true);
    if !(parsed.ok) || parsed.start != start || parsed.end != end { return false; }
    return match parsed.node {
        OpCall { slot: found, name_start: fns, name_end: fne, args: a, start: s, end: e } => found == slot && fns == ns && fne == ne && s == start && e == end && decl.count_exprs<P, N>(pages, stride, total, a) == argc,
        Name { start: s, end: e } => false,
        Integer { start: s, end: e, value: value, overflow: overflow } => false,
        Boolean { start: s, end: e, value: value } => false,
        UnaryNot { value: value, start: s, end: e } => false,
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => false,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => false,
        Binary { op: op, left: left, right: right, start: s, end: e } => false,
        Call { name_start: cns, name_end: cne, args: a, targs: tg, start: s, end: e } => false,
        Project { base: base, field_start: fs, field_end: fe, start: s, end: e, path: path } => false,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => false,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: fields, start: s, end: e } => false,
        Index { base: ib, index: ii, start: is, end: ie } => false,
        Cast { value: cv, type_start: cts, type_end: cte, type_kind: ctk, start: cs, end: ce } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: fields, start: s, end: e } => false
    };
}
fn verify_call_instruction<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inst: Instruction) -> (result: bool) {
    return inst.identity.valid && inst.identity.len > 0 && decl.signature_identity_valid<P, N>(pages, stride, total, inst.effects, inst.capabilities) && id_count<P, N>(pages, stride, total, inst.inputs) == inst.argc && bind_count<P, N>(pages, stride, total, inst.params) == inst.argc && call_argument_types_match<P, N>(pages, stride, total, function.values, inst.inputs, inst.params) && supported_value_type<P, N>(pages, stride, total, inst.ty, function.nominals);
}
record BindCount { rest: decl.BindList, count: u64 }
fn bind_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, params: decl.BindList) -> (result: u64) {
    iterate i up_to 1024 carrying st: BindCount = BindCount { rest: params, count: 0 } { next st = bind_count_step(st); }
    return st.count;
}
fn bind_count_step(st: BindCount) -> (result: BindCount) {
    return match st.rest { BNil => st, BCons { head: h, tail: rest } => BindCount { rest: rest, count: st.count + 1 } };
}
record CallTypeCheck { arguments: IdList, params: decl.BindList, values: ValueList, ok: bool }
fn call_argument_types_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, arguments: IdList, params: decl.BindList) -> (result: bool) {
    iterate i up_to 1024 carrying st: CallTypeCheck = CallTypeCheck { arguments: arguments, params: params, values: values, ok: true } { next st = call_argument_type_step<P, N>(pages, stride, total, st); }
    return st.ok && id_list_empty(st.arguments) && bind_list_empty(st.params);
}
fn bind_list_empty(params: decl.BindList) -> (result: bool) { return match params { BNil => true, BCons { head: h, tail: t } => false }; }
fn call_argument_type_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CallTypeCheck) -> (result: CallTypeCheck) {
    if !(st.ok) { return st; }
    return match st.arguments { INil => CallTypeCheck { ..st, ok: bind_list_empty(st.params) }, ICons { head: argument, tail: arguments } => call_argument_parameter<P, N>(pages, stride, total, st, argument, arguments) };
}
fn call_argument_parameter<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CallTypeCheck, argument: Id, arguments: IdList) -> (result: CallTypeCheck) {
    return match st.params { BNil => CallTypeCheck { ..st, arguments: arguments, ok: false }, BCons { head: parameter, tail: params } => call_argument_value_type<P, N>(pages, stride, total, st, argument, arguments, parameter, params) };
}
fn call_argument_value_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: CallTypeCheck, argument: Id, arguments: IdList, parameter: decl.Bind, params: decl.BindList) -> (result: CallTypeCheck) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, st.values, argument.value);
    return CallTypeCheck { arguments: arguments, params: params, values: st.values, ok: found.found && decl.sem_eq<P, N>(pages, stride, total, found.value.ty, parameter.ty) };
}
record LookupValue { found: bool, value: Value }
record ValueScan { rest: ValueList, id: u64, found: bool, value: Value }
fn find_value<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, id: u64) -> (result: LookupValue) {
    iterate i up_to 1024 carrying st: ValueScan = ValueScan { rest: values, id: id, found: false, value: Value { id: 0, ty: decl.SemType.TPoison, owner_block: 0, kind: 0, index: 0 } } { next st = value_scan_step(st); }
    return LookupValue { found: st.found, value: st.value };
}
fn value_scan_step(st: ValueScan) -> (result: ValueScan) {
    if st.found { return st; }
    return match st.rest { VNil => st, VCons { head: h, tail: t } => ValueScan { rest: t, id: st.id, found: h.id == st.id, value: h } };
}
fn id_list_empty(ids: IdList) -> (result: bool) { return match ids { INil => true, ICons { head: h, tail: t } => false }; }
record IdCount { rest: IdList, count: u64 }
fn id_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ids: IdList) -> (result: u64) {
    iterate i up_to 1024 carrying st: IdCount = IdCount { rest: ids, count: 0 } { next st = id_count_step(st); }
    return st.count;
}
fn id_count_step(st: IdCount) -> (result: IdCount) { return match st.rest { INil => st, ICons { head: h, tail: t } => IdCount { rest: t, count: st.count + 1 } }; }
record AvailableCheck { rest: IdList, values: ValueList, block: u64, before: u64, ok: bool }
fn available_values<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, ids: IdList, block: u64, before: u64) -> (result: bool) {
    iterate i up_to 1024 carrying st: AvailableCheck = AvailableCheck { rest: ids, values: values, block: block, before: before, ok: true } { next st = available_step<P, N>(pages, stride, total, st); }
    return st.ok && id_list_empty(st.rest);
}
fn available_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: AvailableCheck) -> (result: AvailableCheck) {
    if !(st.ok) { return st; }
    return match st.rest { INil => st, ICons { head: id, tail: rest } => available_one<P, N>(pages, stride, total, st, id, rest) };
}
fn available_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: AvailableCheck, id: Id, rest: IdList) -> (result: AvailableCheck) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, st.values, id.value);
    if !(found.found) { return AvailableCheck { ..st, rest: rest, ok: false }; }
    let value: Value = found.value;
    let available: bool = value.kind == 0 || (value.owner_block == st.block && ((value.kind == 1) || (value.kind == 2 && value.index < st.before)));
    return AvailableCheck { ..st, rest: rest, ok: available };
}

fn verify_terminator<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, block: SsaBlock, term: Terminator, instructions: InstructionList) -> (result: bool) {
    let instruction_total: u64 = instruction_count<P, N>(pages, stride, total, instructions);
    return match term {
        Branch { condition: condition, yes: yes, no: no, yes_args: ya, no_args: na } => verify_branch_term<P, N>(pages, stride, total, function, block.id, condition, yes, no, ya, na, instruction_total),
        Jump { target: target, arguments: args } => verify_edge<P, N>(pages, stride, total, function, block.id, target, args, instruction_total),
        FiniteSwitch { subject: subject, subject_ty: subject_ty, nominal_identity: nominal, result_type: result_type, source_start: start, source_end: end, arm_count: arm_count, join_target: join_target, cases: cases } => verify_finite_switch<P, N>(pages, stride, total, function, block, subject, subject_ty, nominal, result_type, start, end, arm_count, join_target, cases, instruction_total),
        ScalarSwitch { subject: subject, subject_ty: subject_ty, result_type: result_type, source_start: start, source_end: end, arm_count: arm_count, default_target: default_target, join_target: join_target, cases: cases } => verify_scalar_switch<P, N>(pages, stride, total, function, block, subject, subject_ty, result_type, start, end, arm_count, default_target, join_target, cases, instruction_total),
        Return { value: value } => verify_return_term<P, N>(pages, stride, total, function, block.id, value, instruction_total),
        Fail => false
    };
}
record FiniteCaseCount { rest: FiniteMatchCaseList, count: u64 }
fn finite_case_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cases: FiniteMatchCaseList) -> (result: u64) {
    iterate i up_to 1024 carrying st: FiniteCaseCount = FiniteCaseCount { rest: cases, count: 0 } { next st = finite_case_count_step(st); }
    return st.count;
}
fn finite_case_count_step(st: FiniteCaseCount) -> (result: FiniteCaseCount) {
    return match st.rest { FiniteMatchCaseList.MCNil => st, FiniteMatchCaseList.MCCons { head: case, tail: rest } => FiniteCaseCount { rest: rest, count: st.count + 1 } };
}
fn verify_finite_switch<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, block: SsaBlock, subject: u64, subject_ty: decl.SemType, nominal: decl.SemanticIdentity, result_ty: decl.SemType, start: u64, end: u64, arm_count: u64, join: u64, cases: FiniteMatchCaseList, before: u64) -> (result: bool) {
    let subject_value: LookupValue = find_value<P, N>(pages, stride, total, function.values, subject);
    let expected_nominal: decl.SemanticIdentity = nominal_identity_for_type<P, N>(pages, stride, total, function.nominals, subject_ty);
    let join_block: BlockLookup = find_block<P, N>(pages, stride, total, function.blocks, join);
    let source_ok: bool = finite_match_source_cases_valid<P, N>(pages, stride, total, start, end, cases, arm_count);
    let cases_ok: bool = verify_finite_switch_cases<P, N>(pages, stride, total, function, block.id, join, result_ty, cases, before);
    return subject_value.found && value_available<P, N>(pages, stride, total, function.values, subject, block.id, before) && is_named_type(subject_ty) && decl.sem_eq<P, N>(pages, stride, total, subject_value.value.ty, subject_ty) && expected_nominal.valid && decl.semantic_identity_equal(expected_nominal, nominal) && supported_value_type<P, N>(pages, stride, total, result_ty, function.nominals) && arm_count > 0 && finite_case_count<P, N>(pages, stride, total, cases) == arm_count && source_ok && cases_ok && join_block.found && match_join_result_type<P, N>(pages, stride, total, join_block.block.parameters, result_ty);
}
fn is_named_type(ty: decl.SemType) -> (result: bool) {
    return match ty { TNamed { start: start, end: end } => true, TBool => false, TByte => false, TInt { width: width, signed: signed } => false, TSeq => false, TSeqExact { element: element, length: length, length_valid: valid } => false, TPoison => false };
}
record FiniteSwitchCaseScan { rest: FiniteMatchCaseList, function: Function, source: u64, join: u64, result_ty: decl.SemType, before: u64, ok: bool }
fn verify_finite_switch_cases<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, source: u64, join: u64, result_ty: decl.SemType, cases: FiniteMatchCaseList, before: u64) -> (result: bool) {
    iterate i up_to 1024 carrying st: FiniteSwitchCaseScan = FiniteSwitchCaseScan { rest: cases, function: function, source: source, join: join, result_ty: result_ty, before: before, ok: true } { next st = verify_finite_switch_case_step<P, N>(pages, stride, total, st); }
    return st.ok && finite_match_cases_empty(st.rest);
}
fn finite_match_cases_empty(cases: FiniteMatchCaseList) -> (result: bool) { return match cases { FiniteMatchCaseList.MCNil => true, FiniteMatchCaseList.MCCons { head: h, tail: t } => false }; }
fn verify_finite_switch_case_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FiniteSwitchCaseScan) -> (result: FiniteSwitchCaseScan) {
    if !(st.ok) { return st; }
    return match st.rest { FiniteMatchCaseList.MCNil => st, FiniteMatchCaseList.MCCons { head: case, tail: rest } => verify_finite_switch_case<P, N>(pages, stride, total, st, case, rest) };
}
fn verify_finite_switch_case<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: FiniteSwitchCaseScan, case: FiniteMatchCase, rest: FiniteMatchCaseList) -> (result: FiniteSwitchCaseScan) {
    let target: BlockLookup = find_block<P, N>(pages, stride, total, st.function.blocks, case.target);
    let unique: bool = !(finite_match_case_duplicate<P, N>(pages, stride, total, rest, case));
    let edge_ok: bool = verify_edge<P, N>(pages, stride, total, st.function, st.source, case.target, case.arguments, st.before);
    let target_term_ok: bool = target.found && match_arm_jumps_to_join<P, N>(pages, stride, total, st.function, target.block, st.join, st.result_ty);
    return FiniteSwitchCaseScan { ..st, rest: rest, ok: unique && case.target != st.source && case.target != st.join && case.variant_end > case.variant_start && edge_ok && target_term_ok };
}
record DuplicateFiniteCaseScan { rest: FiniteMatchCaseList, variant_start: u64, variant_end: u64, target: u64, found: bool }
fn finite_match_case_duplicate<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cases: FiniteMatchCaseList, candidate: FiniteMatchCase) -> (result: bool) {
    iterate i up_to 1024 carrying st: DuplicateFiniteCaseScan = DuplicateFiniteCaseScan { rest: cases, variant_start: candidate.variant_start, variant_end: candidate.variant_end, target: candidate.target, found: false } { next st = finite_match_duplicate_step(st); }
    return st.found;
}
fn finite_match_duplicate_step(st: DuplicateFiniteCaseScan) -> (result: DuplicateFiniteCaseScan) {
    if st.found { return st; }
    return match st.rest { FiniteMatchCaseList.MCNil => st, FiniteMatchCaseList.MCCons { head: case, tail: rest } => DuplicateFiniteCaseScan { rest: rest, variant_start: st.variant_start, variant_end: st.variant_end, target: st.target, found: case.target == st.target || (case.variant_start == st.variant_start && case.variant_end == st.variant_end) } };
}
fn match_arm_jumps_to_join<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, block: SsaBlock, join: u64, result_ty: decl.SemType) -> (result: bool) {
    return match block.terminator {
        Jump { target: target, arguments: args } => target == join && verify_edge<P, N>(pages, stride, total, function, block.id, target, args, instruction_count<P, N>(pages, stride, total, block.instructions)) && first_argument_has_type<P, N>(pages, stride, total, function.values, args, result_ty),
        Branch { condition: condition, yes: yes, no: no, yes_args: ya, no_args: na } => false,
        FiniteSwitch { subject: subject, subject_ty: subject_ty, nominal_identity: nominal, result_type: result, source_start: start, source_end: end, arm_count: count, join_target: target, cases: cases } => nested_join_jumps_to_join<P, N>(pages, stride, total, function, target, join, result_ty),
        ScalarSwitch { subject: subject, subject_ty: subject_ty, result_type: result, source_start: start, source_end: end, arm_count: count, default_target: default_target, join_target: target, cases: cases } => nested_join_jumps_to_join<P, N>(pages, stride, total, function, target, join, result_ty),
        Return { value: value } => false,
        Fail => false
    };
}
// A case target may end in a nested switch only when the nested join
// jumps directly to this join with a correctly typed result edge. The
// nested switch's own cases are verified independently when its block is
// visited, so one hop per level composes to arbitrary depth; longer
// join chains fail closed (the lowering always emits the one-hop,
// match-last shape).
fn nested_join_jumps_to_join<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, inner: u64, join: u64, result_ty: decl.SemType) -> (result: bool) {
    let found: BlockLookup = find_block<P, N>(pages, stride, total, function.blocks, inner);
    if !(found.found) { return false; }
    return match found.block.terminator {
        Jump { target: target, arguments: args } => target == join && verify_edge<P, N>(pages, stride, total, function, inner, join, args, instruction_count<P, N>(pages, stride, total, found.block.instructions)) && first_argument_has_type<P, N>(pages, stride, total, function.values, args, result_ty),
        Branch { condition: condition, yes: yes, no: no, yes_args: ya, no_args: na } => false,
        FiniteSwitch { subject: subject, subject_ty: subject_ty, nominal_identity: nominal, result_type: result, source_start: start, source_end: end, arm_count: count, join_target: target, cases: cases } => false,
        ScalarSwitch { subject: subject, subject_ty: subject_ty, result_type: result, source_start: start, source_end: end, arm_count: count, default_target: default_target, join_target: target, cases: cases } => false,
        Return { value: value } => false,
        Fail => false
    };
}
record LastIdType { rest: IdList, values: ValueList, last: u64, found: bool, ty: decl.SemType }
fn last_argument_has_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, args: IdList, want: decl.SemType) -> (result: bool) {
    iterate i up_to 1024 carrying st: LastIdType = LastIdType { rest: args, values: values, last: 0, found: false, ty: decl.SemType.TPoison } { next st = last_argument_type_step<P, N>(pages, stride, total, st); }
    return st.found && id_list_empty(st.rest) && decl.sem_eq<P, N>(pages, stride, total, st.ty, want);
}
fn last_argument_type_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LastIdType) -> (result: LastIdType) {
    return match st.rest { IdList.INil => st, IdList.ICons { head: id, tail: rest } => last_argument_type_one<P, N>(pages, stride, total, st, id, rest) };
}
fn last_argument_type_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: LastIdType, id: Id, rest: IdList) -> (result: LastIdType) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, st.values, id.value);
    return LastIdType { rest: rest, values: st.values, last: id.value, found: found.found, ty: found.value.ty };
}
fn first_argument_has_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, args: IdList, want: decl.SemType) -> (result: bool) {
    return match args {
        IdList.INil => false,
        IdList.ICons { head: id, tail: rest } => first_argument_type<P, N>(pages, stride, total, values, id, want)
    };
}
fn first_argument_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, id: Id, want: decl.SemType) -> (result: bool) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, values, id.value);
    return found.found && decl.sem_eq<P, N>(pages, stride, total, found.value.ty, want);
}
record LastValueType { rest: ValueList, found: bool, ty: decl.SemType }
fn match_join_result_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, params: ValueList, want: decl.SemType) -> (result: bool) {
    return match params { ValueList.VNil => false, ValueList.VCons { head: value, tail: rest } => decl.sem_eq<P, N>(pages, stride, total, value.ty, want) };
}
fn last_value_type_step(st: LastValueType) -> (result: LastValueType) {
    return match st.rest { ValueList.VNil => st, ValueList.VCons { head: value, tail: rest } => LastValueType { rest: rest, found: true, ty: value.ty } };
}
fn verify_scalar_switch<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, block: SsaBlock, subject: u64, subject_ty: decl.SemType, result_ty: decl.SemType, start: u64, end: u64, arm_count: u64, default_target: u64, join: u64, cases: ScalarMatchCaseList, before: u64) -> (result: bool) {
    let subject_value: LookupValue = find_value<P, N>(pages, stride, total, function.values, subject);
    let join_block: BlockLookup = find_block<P, N>(pages, stride, total, function.blocks, join);
    let source_ok: bool = scalar_match_source_cases_valid<P, N>(pages, stride, total, start, end, cases, arm_count);
    let cases_ok: bool = verify_scalar_switch_cases<P, N>(pages, stride, total, function, block.id, join, result_ty, cases, before);
    let defaults: ScalarDefaultScan = scalar_switch_default_scan<P, N>(pages, stride, total, cases, default_target);
    return subject_value.found && value_available<P, N>(pages, stride, total, function.values, subject, block.id, before) && decl.is_int_ty(subject_ty) && decl.sem_eq<P, N>(pages, stride, total, subject_value.value.ty, subject_ty) && supported_value_type<P, N>(pages, stride, total, result_ty, function.nominals) && arm_count > 0 && scalar_case_count<P, N>(pages, stride, total, cases) == arm_count && defaults.count == 1 && defaults.target_ok && source_ok && cases_ok && join_block.found && match_join_result_type<P, N>(pages, stride, total, join_block.block.parameters, result_ty);
}
record ScalarCaseCount { rest: ScalarMatchCaseList, count: u64 }
fn scalar_case_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cases: ScalarMatchCaseList) -> (result: u64) {
    iterate i up_to 1024 carrying st: ScalarCaseCount = ScalarCaseCount { rest: cases, count: 0 } { next st = scalar_case_count_step(st); }
    return st.count;
}
fn scalar_case_count_step(st: ScalarCaseCount) -> (result: ScalarCaseCount) {
    return match st.rest { ScalarMatchCaseList.SCNil => st, ScalarMatchCaseList.SCCons { head: case, tail: rest } => ScalarCaseCount { rest: rest, count: st.count + 1 } };
}
record ScalarDefaultScan { rest: ScalarMatchCaseList, default_target: u64, count: u64, target_ok: bool }
fn scalar_switch_default_scan<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cases: ScalarMatchCaseList, default_target: u64) -> (result: ScalarDefaultScan) {
    iterate i up_to 1024 carrying st: ScalarDefaultScan = ScalarDefaultScan { rest: cases, default_target: default_target, count: 0, target_ok: true } { next st = scalar_switch_default_step(st); }
    return st;
}
fn scalar_switch_default_step(st: ScalarDefaultScan) -> (result: ScalarDefaultScan) {
    return match st.rest {
        ScalarMatchCaseList.SCNil => st,
        ScalarMatchCaseList.SCCons { head: case, tail: rest } => ScalarDefaultScan { rest: rest, default_target: st.default_target, count: st.count + select(case.is_default, 1, 0), target_ok: st.target_ok && select(case.is_default, case.target == st.default_target, true) }
    };
}
record ScalarSwitchCaseScan { rest: ScalarMatchCaseList, function: Function, source: u64, join: u64, result_ty: decl.SemType, before: u64, ok: bool }
fn verify_scalar_switch_cases<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, source: u64, join: u64, result_ty: decl.SemType, cases: ScalarMatchCaseList, before: u64) -> (result: bool) {
    iterate i up_to 1024 carrying st: ScalarSwitchCaseScan = ScalarSwitchCaseScan { rest: cases, function: function, source: source, join: join, result_ty: result_ty, before: before, ok: true } { next st = verify_scalar_switch_case_step<P, N>(pages, stride, total, st); }
    return st.ok && scalar_match_cases_empty(st.rest);
}
fn scalar_match_cases_empty(cases: ScalarMatchCaseList) -> (result: bool) { return match cases { ScalarMatchCaseList.SCNil => true, ScalarMatchCaseList.SCCons { head: h, tail: t } => false }; }
fn verify_scalar_switch_case_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ScalarSwitchCaseScan) -> (result: ScalarSwitchCaseScan) {
    if !(st.ok) { return st; }
    return match st.rest { ScalarMatchCaseList.SCNil => st, ScalarMatchCaseList.SCCons { head: case, tail: rest } => verify_scalar_switch_case<P, N>(pages, stride, total, st, case, rest) };
}
fn verify_scalar_switch_case<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ScalarSwitchCaseScan, case: ScalarMatchCase, rest: ScalarMatchCaseList) -> (result: ScalarSwitchCaseScan) {
    let target: BlockLookup = find_block<P, N>(pages, stride, total, st.function.blocks, case.target);
    let unique: bool = !(scalar_match_case_duplicate<P, N>(pages, stride, total, rest, case));
    let edge_ok: bool = verify_edge<P, N>(pages, stride, total, st.function, st.source, case.target, case.arguments, st.before);
    let target_term_ok: bool = target.found && match_arm_jumps_to_join<P, N>(pages, stride, total, st.function, target.block, st.join, st.result_ty);
    return ScalarSwitchCaseScan { ..st, rest: rest, ok: unique && case.target != st.source && case.target != st.join && case.pattern_end > case.pattern_start && edge_ok && target_term_ok };
}
record DuplicateScalarCaseScan { rest: ScalarMatchCaseList, payload: u64, is_default: bool, target: u64, found: bool }
fn scalar_match_case_duplicate<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, cases: ScalarMatchCaseList, candidate: ScalarMatchCase) -> (result: bool) {
    let payload: u64 = select(candidate.negative, decl.negative_payload(candidate.value), candidate.value);
    iterate i up_to 1024 carrying st: DuplicateScalarCaseScan = DuplicateScalarCaseScan { rest: cases, payload: payload, is_default: candidate.is_default, target: candidate.target, found: false } { next st = scalar_match_duplicate_step<P, N>(pages, stride, total, st); }
    return st.found;
}
fn scalar_match_duplicate_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: DuplicateScalarCaseScan) -> (result: DuplicateScalarCaseScan) {
    if st.found { return st; }
    return match st.rest { ScalarMatchCaseList.SCNil => st, ScalarMatchCaseList.SCCons { head: case, tail: rest } => scalar_match_duplicate_one<P, N>(pages, stride, total, st, case, rest) };
}
fn scalar_match_duplicate_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: DuplicateScalarCaseScan, case: ScalarMatchCase, rest: ScalarMatchCaseList) -> (result: DuplicateScalarCaseScan) {
    let payload: u64 = select(case.negative, decl.negative_payload(case.value), case.value);
    let clash: bool = case.target == st.target || (!(st.is_default) && !(case.is_default) && payload == st.payload);
    return DuplicateScalarCaseScan { rest: rest, payload: st.payload, is_default: st.is_default, target: st.target, found: clash };
}
// A match nested under a continuing operator (binary operand,
// projection base) re-parses from its start as the enclosing
// expression rather than the bare match. Correspondence still holds
// through the left spine: Binary/Project continuations keep the match
// as the leftmost atom with identical spans and arms.
fn leftmost_match_step(node: decl.Expr) -> (result: decl.Expr) {
    return match node {
        Name { start: s, end: e } => node,
        Integer { start: s, end: e, value: value, overflow: overflow } => node,
        Boolean { start: s, end: e, value: value } => node,
        UnaryNot { value: v, start: s, end: e } => node,
        Repeat { value: v, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => node,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => node,
        Binary { op: op, left: left, right: right, start: s, end: e } => left,
        Call { name_start: ns, name_end: ne, args: args, targs: tg, start: s, end: e } => node,
        Project { base: base, field_start: fs, field_end: fe, start: s, end: e, path: p } => base,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => node,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: fields, start: s, end: e } => node,
        Index { base: ib, index: ii, start: is, end: ie } => node,
        Cast { value: cv, type_start: cts, type_end: cte, type_kind: ctk, start: cs, end: ce } => node,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: fields, start: s, end: e } => node,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: args, start: s, end: e } => node
    };
}
fn leftmost_match_atom<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, node: decl.Expr) -> (result: decl.Expr) {
    iterate i up_to 1024 carrying current: decl.Expr = node { next current = leftmost_match_step(current); }
    return current;
}
fn scalar_match_source_cases_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, cases: ScalarMatchCaseList, count: u64) -> (result: bool) {
    let parsed: decl.ExprParse = decl.parse_expr<P, N>(pages, stride, total, start, true);
    if !(parsed.ok) || parsed.start != start { return false; }
    let atom: decl.Expr = leftmost_match_atom<P, N>(pages, stride, total, parsed.node);
    return match atom {
        ScalarMatch { subject: subject, arms: arms, start: source_start, end: source_end } => source_start == start && source_end == end && scalar_match_source_arm_pairs<P, N>(pages, stride, total, arms, cases, count),
        Name { start: s, end: e } => false,
        Integer { start: s, end: e, value: value, overflow: overflow } => false,
        Boolean { start: s, end: e, value: value } => false,
        UnaryNot { value: value, start: s, end: e } => false,
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => false,
        FiniteMatch { subject: subject, arms: arms, start: s, end: e } => false,
        Binary { op: op, left: left, right: right, start: s, end: e } => false,
        Call { name_start: ns, name_end: ne, args: args, targs: tg, start: s, end: e } => false,
        Project { base: base, field_start: fs, field_end: fe, start: s, end: e, path: path } => false,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: fields, start: s, end: e } => false,
        Index { base: ib, index: ii, start: is, end: ie } => false,
        Cast { value: cv, type_start: cts, type_end: cte, type_kind: ctk, start: cs, end: ce } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: fields, start: s, end: e } => false,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => false
    };
}
record SourceScalarCasePair { arms: decl.ScalarMatchArmList, cases: ScalarMatchCaseList, count: u64, ok: bool }
fn scalar_match_source_arm_pairs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: decl.ScalarMatchArmList, cases: ScalarMatchCaseList, count: u64) -> (result: bool) {
    iterate i up_to 1024 carrying st: SourceScalarCasePair = SourceScalarCasePair { arms: arms, cases: cases, count: 0, ok: true } { next st = scalar_match_source_pair_step(st); }
    return st.ok && st.count == count && source_scalar_arms_empty(st.arms) && scalar_match_cases_empty(st.cases);
}
fn source_scalar_arms_empty(arms: decl.ScalarMatchArmList) -> (result: bool) { return match arms { MNil => true, MCons { head: h, tail: t } => false }; }
fn scalar_match_source_pair_step(st: SourceScalarCasePair) -> (result: SourceScalarCasePair) {
    return match st.arms {
        decl.ScalarMatchArmList.MNil => SourceScalarCasePair { ..st, ok: st.ok && scalar_match_cases_empty(st.cases) },
        decl.ScalarMatchArmList.MCons { head: arm, tail: rest } => scalar_match_source_pair_case(st, arm, rest)
    };
}
fn scalar_match_source_pair_case(st: SourceScalarCasePair, arm: decl.ScalarMatchArm, rest: decl.ScalarMatchArmList) -> (result: SourceScalarCasePair) {
    return match st.cases {
        ScalarMatchCaseList.SCNil => SourceScalarCasePair { ..st, arms: rest, ok: false },
        ScalarMatchCaseList.SCCons { head: case, tail: cases } => SourceScalarCasePair { arms: rest, cases: cases, count: st.count + 1, ok: st.ok && arm.is_default == case.is_default && arm.negative == case.negative && arm.value == case.value && arm.pattern_start == case.pattern_start && arm.pattern_end == case.pattern_end }
    };
}
fn finite_match_source_cases_valid<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, cases: FiniteMatchCaseList, count: u64) -> (result: bool) {
    let parsed: decl.ExprParse = decl.parse_expr<P, N>(pages, stride, total, start, true);
    if !(parsed.ok) || parsed.start != start { return false; }
    let atom: decl.Expr = leftmost_match_atom<P, N>(pages, stride, total, parsed.node);
    return match atom {
        FiniteMatch { subject: subject, arms: arms, start: source_start, end: source_end } => source_start == start && source_end == end && finite_match_source_arm_pairs<P, N>(pages, stride, total, arms, cases, count),
        Name { start: s, end: e } => false,
        Integer { start: s, end: e, value: value, overflow: overflow } => false,
        Boolean { start: s, end: e, value: value } => false,
        UnaryNot { value: value, start: s, end: e } => false,
        Repeat { value: value, count_start: cs, count_end: ce, count_kind: ck, start: s, end: e } => false,
        ScalarMatch { subject: subject, arms: arms, start: s, end: e } => false,
        Binary { op: op, left: left, right: right, start: s, end: e } => false,
        Call { name_start: ns, name_end: ne, args: args, targs: tg, start: s, end: e } => false,
        Project { base: base, field_start: fs, field_end: fe, start: s, end: e, path: path } => false,
        EnumConstruct { type_start: ts, type_end: te, variant_start: vs, variant_end: ve, fields: fields, start: s, end: e } => false,
        Index { base: ib, index: ii, start: is, end: ie } => false,
        Cast { value: cv, type_start: cts, type_end: cte, type_kind: ctk, start: cs, end: ce } => false,
        RecordConstruct { type_start: ts, type_end: te, base: b, has_base: hb, fields: fields, start: s, end: e } => false,
        OpCall { slot: slot, name_start: ns, name_end: ne, args: a, start: s, end: e } => false
    };
}
record SourceFiniteCasePair { arms: decl.FiniteMatchArmList, cases: FiniteMatchCaseList, count: u64, ok: bool }
fn finite_match_source_arm_pairs<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, arms: decl.FiniteMatchArmList, cases: FiniteMatchCaseList, count: u64) -> (result: bool) {
    iterate i up_to 1024 carrying st: SourceFiniteCasePair = SourceFiniteCasePair { arms: arms, cases: cases, count: 0, ok: true } { next st = finite_match_source_pair_step(st); }
    return st.ok && st.count == count && source_match_arms_empty(st.arms) && finite_match_cases_empty(st.cases);
}
fn source_match_arms_empty(arms: decl.FiniteMatchArmList) -> (result: bool) { return match arms { ANil => true, ACons { head: h, tail: t } => false }; }
fn finite_match_source_pair_step(st: SourceFiniteCasePair) -> (result: SourceFiniteCasePair) {
    return match st.arms {
        decl.FiniteMatchArmList.ANil => SourceFiniteCasePair { ..st, ok: st.ok && finite_match_cases_empty(st.cases) },
        decl.FiniteMatchArmList.ACons { head: arm, tail: rest } => finite_match_source_pair_case(st, arm, rest)
    };
}
fn finite_match_source_pair_case(st: SourceFiniteCasePair, arm: decl.FiniteMatchArm, rest: decl.FiniteMatchArmList) -> (result: SourceFiniteCasePair) {
    return match st.cases {
        FiniteMatchCaseList.MCNil => SourceFiniteCasePair { ..st, arms: rest, ok: false },
        FiniteMatchCaseList.MCCons { head: case, tail: cases } => SourceFiniteCasePair { arms: rest, cases: cases, count: st.count + 1, ok: st.ok && arm.variant_start == case.variant_start && arm.variant_end == case.variant_end }
    };
}
fn verify_branch_term<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, block: u64, condition: u64, yes: u64, no: u64, yes_args: IdList, no_args: IdList, before: u64) -> (result: bool) {
    let cond: LookupValue = find_value<P, N>(pages, stride, total, function.values, condition);
    let a: bool = verify_edge<P, N>(pages, stride, total, function, block, yes, yes_args, before);
    let b: bool = verify_edge<P, N>(pages, stride, total, function, block, no, no_args, before);
    return cond.found && decl.sem_eq<P, N>(pages, stride, total, cond.value.ty, decl.SemType.TBool) && value_available<P, N>(pages, stride, total, function.values, condition, block, before) && a && b && yes != no;
}
fn verify_return_term<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, block: u64, value: u64, before: u64) -> (result: bool) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, function.values, value);
    return found.found && decl.sem_eq<P, N>(pages, stride, total, found.value.ty, function.result_type) && value_available<P, N>(pages, stride, total, function.values, value, block, before);
}
fn value_available<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, id: u64, block: u64, before: u64) -> (result: bool) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, values, id);
    if !(found.found) { return false; }
    let value: Value = found.value;
    return value.kind == 0 || value.owner_block == block && ((value.kind == 1) || (value.kind == 2 && value.index < before));
}
fn verify_edge<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, function: Function, source: u64, target: u64, args: IdList, before: u64) -> (result: bool) {
    let target_block: BlockLookup = find_block<P, N>(pages, stride, total, function.blocks, target);
    if !(target_block.found) || !(available_values<P, N>(pages, stride, total, function.values, args, source, before)) { return false; }
    return argument_types_match<P, N>(pages, stride, total, function.values, args, target_block.block.parameters);
}
record BlockLookup { found: bool, block: SsaBlock }
record BlockScan { rest: SsaBlockList, id: u64, found: bool, block: SsaBlock }
fn find_block<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, blocks: SsaBlockList, id: u64) -> (result: BlockLookup) {
    iterate i up_to 1024 carrying st: BlockScan = BlockScan { rest: blocks, id: id, found: false, block: SsaBlock { id: 0, parameters: ValueList.VNil, instructions: InstructionList.QNil, terminator: Terminator.Fail, reachable: false, lowering_ok: false, lowering_failure_kind: 0 } } { next st = block_scan_step(st); }
    return BlockLookup { found: st.found, block: st.block };
}
fn block_scan_step(st: BlockScan) -> (result: BlockScan) {
    if st.found { return st; }
    return match st.rest { LNil => st, LCons { head: h, tail: t } => BlockScan { rest: t, id: st.id, found: h.id == st.id, block: h } };
}
fn argument_types_match<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, values: ValueList, args: IdList, params: ValueList) -> (result: bool) {
    iterate i up_to 1024 carrying st: ArgumentTypeCheck = ArgumentTypeCheck { args: args, params: params, values: values, ok: true } { next st = argument_type_step<P, N>(pages, stride, total, st); }
    return st.ok && id_list_empty(st.args) && value_list_empty(st.params);
}
record ArgumentTypeCheck { args: IdList, params: ValueList, values: ValueList, ok: bool }
fn argument_type_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ArgumentTypeCheck) -> (result: ArgumentTypeCheck) {
    if !(st.ok) { return st; }
    return match st.args { INil => ArgumentTypeCheck { ..st, ok: value_list_empty(st.params) }, ICons { head: arg, tail: args } => argument_param<P, N>(pages, stride, total, st, arg, args) };
}
fn argument_param<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ArgumentTypeCheck, arg: Id, args: IdList) -> (result: ArgumentTypeCheck) {
    return match st.params { VNil => ArgumentTypeCheck { ..st, args: args, ok: false }, VCons { head: param, tail: params } => argument_value_type<P, N>(pages, stride, total, st, arg, args, param, params) };
}
fn argument_value_type<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ArgumentTypeCheck, arg: Id, args: IdList, param: Value, params: ValueList) -> (result: ArgumentTypeCheck) {
    let found: LookupValue = find_value<P, N>(pages, stride, total, st.values, arg.value);
    return ArgumentTypeCheck { args: args, params: params, values: st.values, ok: found.found && decl.sem_eq<P, N>(pages, stride, total, found.value.ty, param.ty) };
}
record InstructionCount { rest: InstructionList, count: u64 }
fn instruction_count<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, instructions: InstructionList) -> (result: u64) {
    iterate i up_to 1024 carrying st: InstructionCount = InstructionCount { rest: instructions, count: 0 } { next st = instruction_count_step(st); }
    return st.count;
}
fn instruction_count_step(st: InstructionCount) -> (result: InstructionCount) { return match st.rest { QNil => st, QCons { head: h, tail: t } => InstructionCount { rest: t, count: st.count + 1 } }; }
