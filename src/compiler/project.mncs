mncs 0.18;
module mncs.compiler.project.v1;
use mncs.compiler.decl.v1 as decl;
use mncs.compiler.flow.v1 as flow;
use mncs.compiler.ssa.v1 as ssa;
use mncs.compiler.source.v1 as source;

// Host filesystem discovery is an adapter boundary. The native compiler
// receives stable path metadata plus exact per-file byte sequences and owns
// module identity, import matching, semantic proof, and CFG construction.
// The source count is bounded at 64; each file's actual byte bound is a
// compile-time sequence parameter rather than a fixed project-wide buffer.
record ProjectSource {
    source_id: [byte; up_to 256],
    source_path: [byte; up_to 256],
    page_start: u64,
    page_count: u64,
    stride: u64,
    total: u64
}
record ProjectSnapshot {
    fingerprint: [byte; up_to 64],
    sources: [ProjectSource; up_to 64]
}

// CP-0021: every module's bytes live in one flat page array; each
// ProjectSource descriptor selects its module's logical source slice
// (page_start, page_count) plus its (stride, total) addressing. Slices
// are validated by the declaration gate on first parse; the project
// entry additionally requires the descriptors to partition the flat
// array in source order (no gaps, overlaps, or trailing pages).
fn module_pages<P: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to P], index: u64) -> (result: [[byte; up_to N]; up_to 1024]) {
    // Total on hostile descriptors: out-of-range slices degrade to the
    // empty slice, which the declaration validation gate (or the header
    // parse for total 0) fails closed. Callers pass indices derived from
    // guarded construction (build loop, ParsedModule owners), never raw
    // transport integers, so sources[index] itself cannot trap.
    let meta: ProjectSource = sources[index];
    if meta.page_start > flat_pages.len { return flat_pages[0..0]; }
    if meta.page_count > flat_pages.len - meta.page_start { return flat_pages[0..0]; }
    return flat_pages[meta.page_start..meta.page_start + meta.page_count];
}
fn module_stride(sources: [ProjectSource; up_to 64], index: u64) -> (result: u64) {
    let meta: ProjectSource = sources[index];
    return meta.stride;
}
fn module_total(sources: [ProjectSource; up_to 64], index: u64) -> (result: u64) {
    let meta: ProjectSource = sources[index];
    return meta.total;
}
record CoverState { index: u64, cursor: u64, ok: bool }
fn descriptors_cover<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M]) -> (result: bool) {
    iterate i over sources carrying st: CoverState = CoverState { index: 0, cursor: 0, ok: true } {
        next st = cover_step(sources, st);
    }
    return st.ok && st.cursor == flat_pages.len;
}
fn cover_step(sources: [ProjectSource; up_to 64], st: CoverState) -> (result: CoverState) {
    if !(st.ok) || st.index >= sources.len { return st; }
    let meta: ProjectSource = sources[st.index];
    if meta.page_start != st.cursor { return CoverState { index: st.index + 1, cursor: st.cursor, ok: false }; }
    return CoverState { index: st.index + 1, cursor: st.cursor + meta.page_count, ok: true };
}

record ParsedModule {
    source_id: [byte; up_to 256],
    source_path: [byte; up_to 256],
    source_index: u64,
    unit: decl.Unit
}
enum ModuleList { MNil, MCons { head: ParsedModule, tail: ModuleList } }
record ModuleReverse { rest: ModuleList, acc: ModuleList }
record TargetModuleSelection { rest: ModuleList, selected: ModuleList, target_source_index: u64, found: bool }
// First parse/proof/flow failure across project modules. stage: 0 none,
// 2 proof, 3 flow (parse failures ride ModuleBuild). Proof carries the unit
// error span; flow carries the first flow diagnostic. Value-SSA unsupported
// anchors stay in the module summary: SSA failure must not flip project
// `valid`, which is a parse/proof/flow verdict.
record StageFailure { stage: u64, source_index: u64, code: u64, start: u64, end: u64 }
record NominalModule { source_index: u64, local: decl.NominalTypeIdentityList, resolved: decl.NominalTypeIdentityList }
enum NominalModuleList { NMNil, NMCons { head: NominalModule, tail: NominalModuleList } }
record NominalModuleBuild { rest: ModuleList, acc: NominalModuleList }
record NominalModuleLookup { rest: NominalModuleList, source_index: u64, found: bool, facts: NominalModule }
record NominalResolutionBuild { rest: ModuleList, all: ModuleList, locals: NominalModuleList, acc: NominalModuleList }
record ProjectNominalIdentityWalk { rest: decl.NominalTypeIdentityList, acc: decl.NominalTypeIdentityList, count: u64 }
record ProjectNominalModuleWalk { rest: NominalModuleList, acc: decl.NominalTypeIdentityList, count: u64 }
record ProjectNominalContains { rest: decl.NominalTypeIdentityList, wanted: decl.SemanticIdentity, found: bool }
record ProjectRecordWalk { rest: ModuleList, nominal_modules: NominalModuleList, markers: decl.NominalTypeIdentityList, acc: decl.ImportedRecordList }
record ProjectRecordDeclWalk { rest: decl.RecordList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, records: decl.RecordList, enums: decl.EnumList, acc: decl.ImportedRecordList }
record ProjectRecordFieldWalk { rest: decl.FieldList, index: u64, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, records: decl.RecordList, enums: decl.EnumList, acc: decl.ImportedRecordFieldList, ok: bool }
record ProjectRecordFields { fields: decl.ImportedRecordFieldList, ok: bool }
record ProjectRecordFieldReverse { rest: decl.ImportedRecordFieldList, acc: decl.ImportedRecordFieldList }
record ProjectEnumWalk { rest: ModuleList, nominal_modules: NominalModuleList, markers: decl.NominalTypeIdentityList, acc: decl.ImportedEnumList }
record ProjectEnumDeclWalk { rest: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, records: decl.RecordList, enums: decl.EnumList, acc: decl.ImportedEnumList }
record ProjectEnumVariantWalk { rest: decl.VariantList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, records: decl.RecordList, enums: decl.EnumList, acc: decl.ImportedEnumVariantList, ok: bool }
record ProjectEnumVariantBuild { variants: decl.ImportedEnumVariantList, ok: bool }
record ProjectEnumFieldWalk { rest: decl.FieldList, index: u64, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, records: decl.RecordList, enums: decl.EnumList, acc: decl.ImportedEnumFieldList, ok: bool }
record ProjectEnumFields { fields: decl.ImportedEnumFieldList, ok: bool }
record ProjectEnumFieldReverse { rest: decl.ImportedEnumFieldList, acc: decl.ImportedEnumFieldList }
record ProjectEnumVariantReverse { rest: decl.ImportedEnumVariantList, acc: decl.ImportedEnumVariantList }

record ProjectModule {
    source_id: [byte; up_to 256],
    source_path: [byte; up_to 256],
    source_index: u64,
    flow: flow.LoweredUnit,
    value_ssa: ssa.ValueSsaSummary
}
enum ProjectModuleList { PNil, PCons { head: ProjectModule, tail: ProjectModuleList } }

record ImportLink {
    source_index: u64,
    target_index: u64,
    module_start: u64,
    module_end: u64,
    alias_start: u64,
    alias_end: u64,
    has_alias: bool
}
enum ImportList { INil, ICons { head: ImportLink, tail: ImportList } }
// These name-resolution results belong to one consumer module in one
// immutable parsed snapshot. The list is capped at the 64 facts the lookup
// examines. They carry no semantic verification evidence; missing results
// still produce a fresh diagnostic for each current use.
record ModuleResolutionFact { module_start: u64, module_end: u64, target_found: bool, target_index: u64 }
enum ModuleResolutionFactList { MRNil, MRCons { head: ModuleResolutionFact, tail: ModuleResolutionFactList } }
record ModuleResolutionCacheLookup { rest: ModuleResolutionFactList, source_index: u64, module_start: u64, module_end: u64, found: bool, target_found: bool, target_index: u64 }
enum ProjectIndexList { PINil, PICons { head: u64, tail: ProjectIndexList } }
record ProjectIndexContains { rest: ProjectIndexList, wanted: u64, found: bool }
record ProjectImportClosure { indices: ProjectIndexList, changed: bool }
record ProjectImportClosureWalk { rest: ImportList, indices: ProjectIndexList, changed: bool }
record ProjectModuleClosureFilter { rest: ModuleList, indices: ProjectIndexList, acc: ModuleList }

enum ProjectDiagnostic {
    SourceOrder { source_index: u64 },
    SourceCountMismatch { source_index: u64 },
    DuplicateModule { source_index: u64, start: u64, end: u64 },
    MissingImport { source_index: u64, start: u64, end: u64 },
    ParseFailed { source_index: u64, start: u64, end: u64 },
    ProofFailed { source_index: u64, start: u64, end: u64 },
    FlowFailed { source_index: u64, code: u64, start: u64, end: u64 },
    TargetModuleMissing { source_index: u64 },
    ImportLimitExceeded { source_index: u64, start: u64, end: u64, limit: u64 }
}
enum DiagnosticList { DiagNil, DiagCons { head: ProjectDiagnostic, tail: DiagnosticList } }
record DiagnosticReverse { rest: DiagnosticList, acc: DiagnosticList }
// Source locations are a projection over immutable project diagnostics. The
// byte spans remain authoritative; mapping is refreshed from the current
// snapshot and fails closed for an invalid source descriptor or page slice.
record ProjectDiagnosticSpan { source_index: u64, start: u64, end: u64, has_span: bool }
record ProjectDiagnosticLocation {
    diagnostic: ProjectDiagnostic,
    source_index: u64,
    has_span: bool,
    mapped: bool,
    start: source.LineCol,
    end: source.LineCol
}
enum ProjectDiagnosticLocationList {
    LocationNil,
    LocationCons { head: ProjectDiagnosticLocation, tail: ProjectDiagnosticLocationList }
}
record ProjectDiagnosticLocationWalk { rest: DiagnosticList, acc: ProjectDiagnosticLocationList }
record ProjectDiagnosticLocationReverse { rest: ProjectDiagnosticLocationList, acc: ProjectDiagnosticLocationList }

fn project_diagnostic_span(diagnostic: ProjectDiagnostic) -> (result: ProjectDiagnosticSpan) {
    return match diagnostic {
        SourceOrder { source_index: index } => ProjectDiagnosticSpan { source_index: index, start: 0, end: 0, has_span: false },
        SourceCountMismatch { source_index: index } => ProjectDiagnosticSpan { source_index: index, start: 0, end: 0, has_span: false },
        DuplicateModule { source_index: index, start: start, end: end } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true },
        MissingImport { source_index: index, start: start, end: end } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true },
        ParseFailed { source_index: index, start: start, end: end } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true },
        ProofFailed { source_index: index, start: start, end: end } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true },
        FlowFailed { source_index: index, code: code, start: start, end: end } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true },
        TargetModuleMissing { source_index: index } => ProjectDiagnosticSpan { source_index: index, start: 0, end: 0, has_span: false },
        ImportLimitExceeded { source_index: index, start: start, end: end, limit: limit } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true }
    };
}

fn project_diagnostic_location<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], diagnostic: ProjectDiagnostic) -> (result: ProjectDiagnosticLocation) {
    let span: ProjectDiagnosticSpan = project_diagnostic_span(diagnostic);
    let initial: source.LineCol = source.LineCol { line: 1, col: 1 };
    if !(span.has_span) || span.source_index >= sources.len {
        return ProjectDiagnosticLocation { diagnostic: diagnostic, source_index: span.source_index, has_span: span.has_span, mapped: false, start: initial, end: initial };
    }
    let meta: ProjectSource = sources[span.source_index];
    // Check before slicing so a hostile descriptor cannot trap location
    // projection. Validate the selected composition before trusting its
    // stride and total as a current source snapshot.
    if meta.page_start > flat_pages.len || meta.page_count > flat_pages.len - meta.page_start {
        return ProjectDiagnosticLocation { diagnostic: diagnostic, source_index: span.source_index, has_span: true, mapped: false, start: initial, end: initial };
    }
    let pages: [[byte; up_to N]; up_to 1024] = flat_pages[meta.page_start..meta.page_start + meta.page_count];
    if source.validate_pages<1024, N>(pages, meta.stride, meta.total) != 0 {
        return ProjectDiagnosticLocation { diagnostic: diagnostic, source_index: span.source_index, has_span: true, mapped: false, start: initial, end: initial };
    }
    if !source.span_valid_global(meta.total, span.start, span.end) {
        return ProjectDiagnosticLocation { diagnostic: diagnostic, source_index: span.source_index, has_span: true, mapped: false, start: initial, end: initial };
    }
    let positions: source.LineColSpan = source.line_col_span_global<1024, N>(pages, meta.stride, meta.total, span.start, span.end);
    return ProjectDiagnosticLocation { diagnostic: diagnostic, source_index: span.source_index, has_span: true, mapped: true, start: positions.start, end: positions.end };
}

// Convert an existing diagnostic list without recompiling the project. Two
// bounded loop levels cover the current project diagnostic ceiling while
// preserving input order in the returned projection.
fn locate_project_diagnostics_global<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], diagnostics: DiagnosticList) -> (result: ProjectDiagnosticLocationList) {
    iterate chunk up_to 1024 carrying outer: ProjectDiagnosticLocationWalk = ProjectDiagnosticLocationWalk { rest: diagnostics, acc: ProjectDiagnosticLocationList.LocationNil } {
        iterate i up_to 1024 carrying inner: ProjectDiagnosticLocationWalk = outer {
            if diagnostic_list_empty(inner.rest) { return reverse_project_diagnostic_locations(inner.acc); }
            next inner = project_diagnostic_location_step<M, N>(sources, flat_pages, inner);
        }
        if diagnostic_list_empty(inner.rest) { return reverse_project_diagnostic_locations(inner.acc); }
        next outer = inner;
    }
    return reverse_project_diagnostic_locations(outer.acc);
}
fn project_diagnostic_location_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectDiagnosticLocationWalk) -> (result: ProjectDiagnosticLocationWalk) {
    return match st.rest {
        DiagNil => st,
        DiagCons { head: diagnostic, tail: rest } => ProjectDiagnosticLocationWalk {
            rest: rest,
            acc: ProjectDiagnosticLocationList.LocationCons {
                head: project_diagnostic_location<M, N>(sources, flat_pages, diagnostic),
                tail: st.acc
            }
        }
    };
}
fn reverse_project_diagnostic_locations(initial: ProjectDiagnosticLocationList) -> (result: ProjectDiagnosticLocationList) {
    iterate chunk up_to 1024 carrying outer: ProjectDiagnosticLocationReverse = ProjectDiagnosticLocationReverse { rest: initial, acc: ProjectDiagnosticLocationList.LocationNil } {
        iterate i up_to 1024 carrying inner: ProjectDiagnosticLocationReverse = outer {
            if project_diagnostic_locations_empty(inner.rest) { return inner.acc; }
            next inner = reverse_project_diagnostic_location_step(inner);
        }
        if project_diagnostic_locations_empty(inner.rest) { return inner.acc; }
        next outer = inner;
    }
    return outer.acc;
}
fn project_diagnostic_locations_empty(locations: ProjectDiagnosticLocationList) -> (result: bool) {
    return match locations {
        LocationNil => true,
        LocationCons { head: location, tail: rest } => false
    };
}
fn reverse_project_diagnostic_location_step(st: ProjectDiagnosticLocationReverse) -> (result: ProjectDiagnosticLocationReverse) {
    return match st.rest {
        LocationNil => st,
        LocationCons { head: location, tail: rest } => ProjectDiagnosticLocationReverse { rest: rest, acc: ProjectDiagnosticLocationList.LocationCons { head: location, tail: st.acc } }
    };
}

record ProjectResult {
    valid: bool,
    fingerprint: [byte; up_to 64],
    fingerprint_authenticated: bool,
    value_ssa_valid: bool,
    source_count: u64,
    module_count: u64,
    import_count: u64,
    import_module_name_comparisons: u64,
    import_resolution_cache_hits: u64,
    import_resolution_negative_cache_hits: u64,
    import_resolution_cache_entries_max: u64,
    modules: ProjectModuleList,
    imports: ImportList,
    diagnostics: DiagnosticList
}

record ProjectResultWithDiagnosticLocations {
    result: ProjectResult,
    diagnostic_locations: ProjectDiagnosticLocationList
}

record ModuleBuild { rest: ModuleList, acc: ModuleList, valid: bool, count: u64, parse_failed: bool, parse_index: u64, parse_start: u64, parse_end: u64 }
fn build_modules<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_source_index: u64, target_only: bool) -> (result: ModuleBuild) {
    iterate i over sources carrying st: ModuleBuild = ModuleBuild {
        rest: ModuleList.MNil,
        acc: ModuleList.MNil,
        valid: true,
        count: 0,
        parse_failed: false,
        parse_index: 0,
        parse_start: 0,
        parse_end: 0
    } {
        next st = build_one_module<M, N>(sources, flat_pages, i, target_source_index, target_only, st);
    }
    return st;
}
fn build_one_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], index: u64, target_source_index: u64, target_only: bool, st: ModuleBuild) -> (result: ModuleBuild) {
    if index >= sources.len { return ModuleBuild { rest: st.rest, acc: st.acc, valid: false, count: st.count, parse_failed: true, parse_index: select(st.parse_failed, st.parse_index, index), parse_start: select(st.parse_failed, st.parse_start, 0), parse_end: select(st.parse_failed, st.parse_end, 0) }; }
    let item: ProjectSource = sources[index];
    let pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, index);
    let unit: decl.Unit = parse_project_unit<M, N>(pages, item.stride, item.total, index, target_source_index, target_only);
    return ModuleBuild {
        rest: st.rest,
        acc: ModuleList.MCons {
            head: ParsedModule {
                source_id: item.source_id,
                source_path: item.source_path,
                source_index: index,
                unit: unit
            },
            tail: st.acc
        },
        valid: st.valid && unit.ok,
        count: st.count + 1,
        parse_failed: st.parse_failed || !(unit.ok),
        parse_index: select(st.parse_failed, st.parse_index, index),
        parse_start: select(st.parse_failed, st.parse_start, unit.err_start),
        parse_end: select(st.parse_failed, st.parse_end, unit.err_end)
    };
}
fn parse_project_unit<M: Nat, N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, source_index: u64, target_source_index: u64, target_only: bool) -> (result: decl.Unit) {
    if target_only && source_index != target_source_index { return decl.parse_unit_signatures<1024, N>(pages, stride, total); }
    return decl.parse_unit<1024, N>(pages, stride, total);
}

fn reverse_modules<M: Nat>(sources: [ProjectSource; up_to M], modules: ModuleList) -> (result: ModuleList) {
    iterate i over sources carrying st: ModuleReverse = ModuleReverse {
        rest: modules,
        acc: ModuleList.MNil
    } {
        next st = reverse_module_step(st);
    }
    return st.acc;
}
fn reverse_module_step(st: ModuleReverse) -> (result: ModuleReverse) {
    return match st.rest {
        MNil => st,
        MCons { head: h, tail: t } => ModuleReverse {
            rest: t,
            acc: ModuleList.MCons { head: h, tail: st.acc }
        }
    };
}

record OrderState { valid: bool }
fn source_ordered<M: Nat>(sources: [ProjectSource; up_to M]) -> (result: bool) {
    iterate i over sources carrying st: OrderState = OrderState { valid: true } {
        next st = source_order_step(sources, i, st);
    }
    return st.valid;
}
fn source_order_step<M: Nat>(sources: [ProjectSource; up_to M], index: u64, st: OrderState) -> (result: OrderState) {
    if !(st.valid) || index == 0 { return st; }
    let previous: ProjectSource = sources[index - 1];
    let current: ProjectSource = sources[index];
    return OrderState { valid: byte_string_before(previous.source_id, current.source_id) };
}

fn byte_string_before(a: [byte; up_to 256], b: [byte; up_to 256]) -> (result: bool) {
    iterate i over a carrying st: ByteCompare = ByteCompare {
        decided: false,
        less: false
    } {
        next st = byte_compare_step(a, b, i, st);
    }
    if st.decided { return st.less; }
    return a.len < b.len;
}
record ByteCompare { decided: bool, less: bool }
fn byte_compare_step(a: [byte; up_to 256], b: [byte; up_to 256], index: u64, st: ByteCompare) -> (result: ByteCompare) {
    if st.decided || index >= b.len { return st; }
    let left: u64 = a[index] as u64;
    let right: u64 = b[index] as u64;
    if left < right { return ByteCompare { decided: true, less: true }; }
    if left > right { return ByteCompare { decided: true, less: false }; }
    return st;
}

fn duplicate_modules<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList) -> (result: DiagnosticList) {
    iterate i over sources carrying st: DuplicateState = DuplicateState {
        rest: modules,
        all: modules,
        diagnostics: DiagnosticList.DiagNil
    } {
        next st = duplicate_module_step<M, N>(sources, flat_pages, st);
    }
    return reverse_diagnostics(sources, st.diagnostics);
}
record DuplicateState { rest: ModuleList, all: ModuleList, diagnostics: DiagnosticList }
fn duplicate_module_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: DuplicateState) -> (result: DuplicateState) {
    return match st.rest {
        MNil => st,
        MCons { head: current, tail: tail } => duplicate_module_cons<M, N>(sources, flat_pages, st, current, tail)
    };
}
fn duplicate_module_cons<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: DuplicateState, current: ParsedModule, tail: ModuleList) -> (result: DuplicateState) {
    let found: DuplicateCheck = find_duplicate_module<M, N>(sources, flat_pages, st.all, current);
    let diagnostics: DiagnosticList = duplicate_diagnostic(current, found, st.diagnostics);
    return DuplicateState { rest: tail, all: st.all, diagnostics: diagnostics };
}
record DuplicateCheck { found: bool, index: u64, start: u64, end: u64 }
fn find_duplicate_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule) -> (result: DuplicateCheck) {
    iterate i over sources carrying st: DuplicateScan = DuplicateScan {
        rest: all,
        current_index: current.source_index,
        current: current,
        found: false,
        index: 0,
        start: 0,
        end: 0
    } {
        next st = duplicate_scan_step<M, N>(sources, flat_pages, st);
    }
    return DuplicateCheck { found: st.found, index: st.index, start: st.start, end: st.end };
}
record DuplicateScan {
    rest: ModuleList,
    current_index: u64,
    current: ParsedModule,
    found: bool,
    index: u64,
    start: u64,
    end: u64
}
fn duplicate_scan_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: DuplicateScan) -> (result: DuplicateScan) {
    if st.found { return st; }
    return match st.rest {
        MNil => st,
        MCons { head: candidate, tail: tail } => duplicate_scan_candidate<M, N>(sources, flat_pages, st, candidate, tail)
    };
}
fn duplicate_scan_candidate<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: DuplicateScan, candidate: ParsedModule, tail: ModuleList) -> (result: DuplicateScan) {
    if candidate.source_index >= st.current_index { return DuplicateScan {
        rest: ModuleList.MNil,
        current_index: st.current_index,
        current: st.current,
        found: false,
        index: 0,
        start: 0,
        end: 0
    }; }
    let equal: bool = module_names_equal<M, N>(sources, flat_pages, st.current, candidate);
    let header: decl.Header = candidate.unit.header;
    if equal { return DuplicateScan {
        rest: ModuleList.MNil,
        current_index: st.current_index,
        current: st.current,
        found: true,
        index: candidate.source_index,
        start: header.module_start,
        end: header.module_end
    }; }
    return DuplicateScan {
        rest: tail,
        current_index: st.current_index,
        current: st.current,
        found: st.found,
        index: st.index,
        start: st.start,
        end: st.end
    };
}
fn duplicate_diagnostic(current: ParsedModule, found: DuplicateCheck, diagnostics: DiagnosticList) -> (result: DiagnosticList) {
    if !(found.found) { return diagnostics; }
    let header: decl.Header = current.unit.header;
    return DiagnosticList.DiagCons {
        head: ProjectDiagnostic.DuplicateModule {
            source_index: current.source_index,
            start: header.module_start,
            end: header.module_end
        },
        tail: diagnostics
    };
}

record Resolution { valid: bool, count: u64, imports: ImportList, diagnostics: DiagnosticList, import_module_name_comparisons: u64, import_resolution_cache_hits: u64, import_resolution_negative_cache_hits: u64, import_resolution_cache_entries_max: u64 }
record ResolveModules {
    rest: ModuleList,
    all: ModuleList,
    imports: ImportList,
    diagnostics: DiagnosticList,
    valid: bool,
    count: u64,
    import_module_name_comparisons: u64,
    import_resolution_cache_hits: u64,
    import_resolution_negative_cache_hits: u64,
    import_resolution_cache_entries_max: u64,
    limit_reached: bool
}
fn resolve_imports<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList) -> (result: Resolution) {
    iterate i over sources carrying st: ResolveModules = ResolveModules {
        rest: modules,
        all: modules,
        imports: ImportList.INil,
        diagnostics: DiagnosticList.DiagNil,
        valid: true,
        count: 0,
        import_module_name_comparisons: 0,
        import_resolution_cache_hits: 0,
        import_resolution_negative_cache_hits: 0,
        import_resolution_cache_entries_max: 0,
        limit_reached: false
    } {
        next st = resolve_module_step<M, N>(sources, flat_pages, st);
    }
    return Resolution {
        valid: st.valid,
        count: st.count,
        imports: reverse_imports(sources, st.imports),
        diagnostics: reverse_diagnostics(sources, st.diagnostics),
        import_module_name_comparisons: st.import_module_name_comparisons,
        import_resolution_cache_hits: st.import_resolution_cache_hits,
        import_resolution_negative_cache_hits: st.import_resolution_negative_cache_hits,
        import_resolution_cache_entries_max: st.import_resolution_cache_entries_max
    };
}
fn resolve_module_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ResolveModules) -> (result: ResolveModules) {
    if st.limit_reached { return st; }
    return match st.rest {
        MNil => st,
        MCons { head: current, tail: tail } => resolve_module_uses<M, N>(sources, flat_pages, st, current, tail)
    };
}
fn resolve_module_uses<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ResolveModules, current: ParsedModule, tail: ModuleList) -> (result: ResolveModules) {
    let unit: decl.Unit = current.unit;
    let resolved: UseResolution = resolve_use_list<M, N>(sources, flat_pages, st.all, current, unit.uses, st.imports, st.diagnostics, st.valid, st.count);
    return ResolveModules {
        rest: tail,
        all: st.all,
        imports: resolved.imports,
        diagnostics: resolved.diagnostics,
        valid: resolved.valid,
        count: resolved.count,
        import_module_name_comparisons: st.import_module_name_comparisons + resolved.import_module_name_comparisons,
        import_resolution_cache_hits: st.import_resolution_cache_hits + resolved.import_resolution_cache_hits,
        import_resolution_negative_cache_hits: st.import_resolution_negative_cache_hits + resolved.import_resolution_negative_cache_hits,
        import_resolution_cache_entries_max: select(st.import_resolution_cache_entries_max > resolved.import_resolution_cache_entries_max, st.import_resolution_cache_entries_max, resolved.import_resolution_cache_entries_max),
        limit_reached: resolved.limit_reached
    };
}
record UseResolution { imports: ImportList, diagnostics: DiagnosticList, valid: bool, count: u64, import_module_name_comparisons: u64, import_resolution_cache_hits: u64, import_resolution_negative_cache_hits: u64, import_resolution_cache_entries_max: u64, limit_reached: bool }
record ResolveUses {
    rest: decl.UseList,
    imports: ImportList,
    diagnostics: DiagnosticList,
    valid: bool,
    count: u64,
    facts: ModuleResolutionFactList,
    facts_count: u64,
    import_module_name_comparisons: u64,
    import_resolution_cache_hits: u64,
    import_resolution_negative_cache_hits: u64,
    import_resolution_cache_entries_max: u64
}
fn resolve_use_list<M: Nat, N: Nat>(
    sources: [ProjectSource; up_to 64],
    flat_pages: [[byte; up_to N]; up_to M],
    all: ModuleList,
    current: ParsedModule,
    uses: decl.UseList,
    imports: ImportList,
    diagnostics: DiagnosticList,
    valid: bool,
    count: u64
) -> (result: UseResolution) {
    if decl.use_list_empty(uses) {
        return UseResolution { imports: imports, diagnostics: diagnostics, valid: valid, count: count, import_module_name_comparisons: 0, import_resolution_cache_hits: 0, import_resolution_negative_cache_hits: 0, import_resolution_cache_entries_max: 0, limit_reached: false };
    }
    iterate i up_to 1024 carrying st: ResolveUses = ResolveUses {
        rest: uses,
        imports: imports,
        diagnostics: diagnostics,
        valid: valid,
        count: count,
        facts: ModuleResolutionFactList.MRNil,
        facts_count: 0,
        import_module_name_comparisons: 0,
        import_resolution_cache_hits: 0,
        import_resolution_negative_cache_hits: 0,
        import_resolution_cache_entries_max: 0
    } {
        if decl.use_list_empty(st.rest) { return finish_use_resolution(st, current.source_index, 1024); }
        if project_import_limit_reached(st.count) {
            return finish_global_import_limit(st, current.source_index);
        }
        next st = resolve_use_step<M, N>(sources, flat_pages, all, current, st);
    }
    return finish_use_resolution(st, current.source_index, 1024);
}
fn project_import_limit_reached(count: u64) -> (result: bool) {
    return count >= 4096;
}
fn finish_global_import_limit(st: ResolveUses, source_index: u64) -> (result: UseResolution) {
    return finish_use_resolution(st, source_index, 4096);
}
fn finish_use_resolution(st: ResolveUses, source_index: u64, limit: u64) -> (result: UseResolution) {
    return match st.rest {
        UNil => UseResolution { imports: st.imports, diagnostics: st.diagnostics, valid: st.valid, count: st.count, import_module_name_comparisons: st.import_module_name_comparisons, import_resolution_cache_hits: st.import_resolution_cache_hits, import_resolution_negative_cache_hits: st.import_resolution_negative_cache_hits, import_resolution_cache_entries_max: st.import_resolution_cache_entries_max, limit_reached: false },
        UCons { head: usage, tail: rest } => UseResolution {
            imports: st.imports,
            diagnostics: DiagnosticList.DiagCons { head: ProjectDiagnostic.ImportLimitExceeded { source_index: source_index, start: usage.module_start, end: usage.module_end, limit: limit }, tail: st.diagnostics },
            valid: false,
            count: st.count,
            import_module_name_comparisons: st.import_module_name_comparisons,
            import_resolution_cache_hits: st.import_resolution_cache_hits,
            import_resolution_negative_cache_hits: st.import_resolution_negative_cache_hits,
            import_resolution_cache_entries_max: st.import_resolution_cache_entries_max,
            limit_reached: limit == 4096
        }
    };
}
fn resolve_use_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, st: ResolveUses) -> (result: ResolveUses) {
    return match st.rest {
        UNil => st,
        UCons { head: usage, tail: tail } => resolve_one_use<M, N>(sources, flat_pages, all, current, usage, tail, st)
    };
}
fn resolve_one_use<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, usage: decl.UseDecl, tail: decl.UseList, st: ResolveUses) -> (result: ResolveUses) {
    let cached: ModuleResolutionCacheLookup = module_resolution_cache_lookup<M, N>(sources, flat_pages, current, usage, st.facts);
    let cacheable: bool = module_resolution_cache_name_cacheable<M, N>(sources, flat_pages, current.source_index, usage.module_start, usage.module_end);
    if cached.found { return resolve_one_use_result(current, usage, tail, st, true, cached.target_found, cached.target_index, 0, cacheable); }
    let found: ModuleLookup = find_import_target<M, N>(sources, flat_pages, all, current, usage);
    return resolve_one_use_result(current, usage, tail, st, false, found.found, found.index, found.name_comparisons, cacheable);
}
fn resolve_one_use_result(current: ParsedModule, usage: decl.UseDecl, tail: decl.UseList, st: ResolveUses, cache_hit: bool, target_found: bool, target_index: u64, name_comparisons: u64, cacheable: bool) -> (result: ResolveUses) {
    let facts: ModuleResolutionFactList = module_resolution_cache_add(st.facts, st.facts_count, usage, target_found, target_index, cache_hit, cacheable);
    let adds_fact: bool = cacheable && !(cache_hit);
    let added_fact_count: u64 = select(st.facts_count >= 64, 1, st.facts_count + 1);
    let facts_count: u64 = select(adds_fact, added_fact_count, st.facts_count);
    let facts_max: u64 = select(st.import_resolution_cache_entries_max > facts_count, st.import_resolution_cache_entries_max, facts_count);
    let cache_hits: u64 = st.import_resolution_cache_hits + select(cache_hit && target_found, 1, 0);
    let negative_cache_hits: u64 = st.import_resolution_negative_cache_hits + select(cache_hit && !(target_found), 1, 0);
    if !(target_found) { return ResolveUses {
        rest: tail,
        imports: st.imports,
        diagnostics: DiagnosticList.DiagCons {
            head: ProjectDiagnostic.MissingImport {
                source_index: current.source_index,
                start: usage.module_start,
                end: usage.module_end
            },
            tail: st.diagnostics
        },
        valid: false,
        count: st.count,
        facts: facts,
        facts_count: facts_count,
        import_module_name_comparisons: st.import_module_name_comparisons + name_comparisons,
        import_resolution_cache_hits: cache_hits,
        import_resolution_negative_cache_hits: negative_cache_hits,
        import_resolution_cache_entries_max: facts_max
    }; }
    return ResolveUses {
        rest: tail,
        imports: ImportList.ICons {
            head: ImportLink {
                source_index: current.source_index,
                target_index: target_index,
                module_start: usage.module_start,
                module_end: usage.module_end,
                alias_start: usage.alias_start,
                alias_end: usage.alias_end,
                has_alias: usage.has_alias
            },
            tail: st.imports
        },
        diagnostics: st.diagnostics,
        valid: st.valid,
        count: st.count + 1,
        facts: facts,
        facts_count: facts_count,
        import_module_name_comparisons: st.import_module_name_comparisons + name_comparisons,
        import_resolution_cache_hits: cache_hits,
        import_resolution_negative_cache_hits: negative_cache_hits,
        import_resolution_cache_entries_max: facts_max
    };
}
fn module_resolution_cache_lookup<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, usage: decl.UseDecl, facts: ModuleResolutionFactList) -> (result: ModuleResolutionCacheLookup) {
    iterate i up_to 64 carrying st: ModuleResolutionCacheLookup = ModuleResolutionCacheLookup { rest: facts, source_index: current.source_index, module_start: usage.module_start, module_end: usage.module_end, found: false, target_found: false, target_index: 0 } {
        // Return on a match or exhausted facts instead of paying for the
        // remaining no-op iterations in this bounded lookup.
        if module_resolution_cache_lookup_done(st) { return st; }
        next st = module_resolution_cache_step<M, N>(sources, flat_pages, current.source_index, st);
    }
    return st;
}
fn module_resolution_cache_lookup_done(st: ModuleResolutionCacheLookup) -> (result: bool) {
    if st.found { return true; }
    return match st.rest {
        MRNil => true,
        MRCons { head: head, tail: tail } => false
    };
}
fn module_resolution_cache_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, st: ModuleResolutionCacheLookup) -> (result: ModuleResolutionCacheLookup) {
    if st.found { return st; }
    return match st.rest {
        MRNil => st,
        MRCons { head: fact, tail: rest } => module_resolution_cache_fact<M, N>(sources, flat_pages, source_index, st, fact, rest)
    };
}
fn module_resolution_cache_fact<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, st: ModuleResolutionCacheLookup, fact: ModuleResolutionFact, rest: ModuleResolutionFactList) -> (result: ModuleResolutionCacheLookup) {
    if module_resolution_cache_key_equal<M, N>(sources, flat_pages, source_index, st.module_start, st.module_end, fact.module_start, fact.module_end) {
        return ModuleResolutionCacheLookup { rest: ModuleResolutionFactList.MRNil, source_index: st.source_index, module_start: st.module_start, module_end: st.module_end, found: true, target_found: fact.target_found, target_index: fact.target_index };
    }
    return ModuleResolutionCacheLookup { rest: rest, source_index: st.source_index, module_start: st.module_start, module_end: st.module_end, found: false, target_found: false, target_index: 0 };
}
record ModuleResolutionNameCompare { length: u64, left_start: u64, right_start: u64, offset: u64, equal: bool }
fn module_resolution_cache_key_equal<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, left_start: u64, left_end: u64, right_start: u64, right_end: u64) -> (result: bool) {
    if left_end < left_start || right_end < right_start { return false; }
    if left_end - left_start != right_end - right_start { return false; }
    let meta: ProjectSource = sources[source_index];
    if meta.stride == 0 || left_end > meta.total || right_end > meta.total { return false; }
    if meta.page_start > flat_pages.len || meta.page_count > flat_pages.len - meta.page_start { return false; }
    let length: u64 = left_end - left_start;
    // Cache only the common short module-name case. Longer names take the
    // conservative uncached resolver path instead of burning 1024 steps.
    if length > 64 { return false; }
    iterate i up_to 64 carrying st: ModuleResolutionNameCompare = ModuleResolutionNameCompare {
        length: length,
        left_start: left_start,
        right_start: right_start,
        offset: 0,
        equal: true
    } {
        // Stop on a mismatch or once all name bytes have been compared.
        if !(st.equal) || st.offset >= st.length { return st.equal && st.offset >= st.length; }
        next st = module_resolution_name_compare_step<M, N>(sources, flat_pages, source_index, st);
    }
    return st.equal && st.offset >= st.length;
}
fn module_resolution_cache_name_cacheable<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, name_start: u64, name_end: u64) -> (result: bool) {
    if source_index >= sources.len || name_end < name_start || name_end - name_start > 64 { return false; }
    let meta: ProjectSource = sources[source_index];
    if meta.stride == 0 || name_end > meta.total { return false; }
    if meta.page_start > flat_pages.len || meta.page_count > flat_pages.len - meta.page_start { return false; }
    return true;
}
fn module_resolution_name_compare_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, st: ModuleResolutionNameCompare) -> (result: ModuleResolutionNameCompare) {
    if !(st.equal) || st.offset >= st.length { return st; }
    let left: u64 = project_source_byte_at<M, N>(sources, flat_pages, source_index, st.left_start + st.offset);
    let right: u64 = project_source_byte_at<M, N>(sources, flat_pages, source_index, st.right_start + st.offset);
    return ModuleResolutionNameCompare { length: st.length, left_start: st.left_start, right_start: st.right_start, offset: st.offset + 1, equal: left < 256 && right < 256 && left == right };
}
fn project_source_byte_at<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, offset: u64) -> (result: u64) {
    let meta: ProjectSource = sources[source_index];
    if meta.stride == 0 || offset >= meta.total { return 256; }
    let relative_page: u64 = offset / meta.stride;
    if relative_page >= meta.page_count { return 256; }
    if meta.page_start > flat_pages.len || meta.page_count > flat_pages.len - meta.page_start { return 256; }
    let page: [byte; up_to N] = flat_pages[meta.page_start + relative_page];
    let within_page: u64 = offset % meta.stride;
    if within_page >= page.len { return 256; }
    return page[within_page] as u64;
}
fn module_resolution_cache_add(facts: ModuleResolutionFactList, facts_count: u64, usage: decl.UseDecl, target_found: bool, target_index: u64, cache_hit: bool, cacheable: bool) -> (result: ModuleResolutionFactList) {
    if cache_hit || !(cacheable) { return facts; }
    if facts_count >= 64 { return ModuleResolutionFactList.MRCons { head: ModuleResolutionFact { module_start: usage.module_start, module_end: usage.module_end, target_found: target_found, target_index: target_index }, tail: ModuleResolutionFactList.MRNil }; }
    return ModuleResolutionFactList.MRCons { head: ModuleResolutionFact { module_start: usage.module_start, module_end: usage.module_end, target_found: target_found, target_index: target_index }, tail: facts };
}
record ModuleLookup { found: bool, index: u64, name_comparisons: u64 }
record ModuleLookupState { rest: ModuleList, current: ParsedModule, usage: decl.UseDecl, found: bool, index: u64, name_comparisons: u64 }
fn find_import_target<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, usage: decl.UseDecl) -> (result: ModuleLookup) {
    iterate i over sources carrying st: ModuleLookupState = ModuleLookupState {
        rest: all,
        current: current,
        usage: usage,
        found: false,
        index: 0,
        name_comparisons: 0
    } {
        next st = module_lookup_step<M, N>(sources, flat_pages, st);
    }
    return ModuleLookup { found: st.found, index: st.index, name_comparisons: st.name_comparisons };
}
fn module_lookup_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ModuleLookupState) -> (result: ModuleLookupState) {
    if st.found { return st; }
    return match st.rest {
        MNil => st,
        MCons { head: candidate, tail: tail } => module_lookup_candidate<M, N>(sources, flat_pages, st, candidate, tail)
    };
}
fn module_lookup_candidate<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ModuleLookupState, candidate: ParsedModule, tail: ModuleList) -> (result: ModuleLookupState) {
    if candidate.source_index == st.current.source_index { return ModuleLookupState {
        rest: tail,
        current: st.current,
        usage: st.usage,
        found: st.found,
        index: st.index,
        name_comparisons: st.name_comparisons
    }; }
    if use_matches_module<M, N>(sources, flat_pages, st.current, st.usage, candidate) { return ModuleLookupState {
        rest: ModuleList.MNil,
        current: st.current,
        usage: st.usage,
        found: true,
        index: candidate.source_index,
        name_comparisons: st.name_comparisons + 1
    }; }
    return ModuleLookupState {
        rest: tail,
        current: st.current,
        usage: st.usage,
        found: st.found,
        index: st.index,
        name_comparisons: st.name_comparisons + 1
    };
}

fn module_names_equal<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], a: ParsedModule, b: ParsedModule) -> (result: bool) {
    let left: decl.Header = a.unit.header;
    let right: decl.Header = b.unit.header;
    return spans_equal_between<M, N>(sources, flat_pages, a.source_index, left.module_start, left.module_end, b.source_index, right.module_start, right.module_end);
}
fn use_matches_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, usage: decl.UseDecl, target: ParsedModule) -> (result: bool) {
    let header: decl.Header = target.unit.header;
    return spans_equal_between<M, N>(sources, flat_pages, current.source_index, usage.module_start, usage.module_end, target.source_index, header.module_start, header.module_end);
}

// Nominal names are resolved from exact parsed type-reference spans and the
// declaring module selected by this module's `use` edge. A matching short
// name in another module never participates in the lookup.
record ProjectNominalWalk { spans: decl.NominalTypeSpanList, current: ParsedModule, all: ModuleList, locals: NominalModuleList, acc: decl.NominalTypeIdentityList }
record NominalUseWalk { uses: decl.UseList, current: ParsedModule, all: ModuleList, locals: NominalModuleList, span: decl.NominalTypeSpan, found: bool, count: u64, identity: decl.SemanticIdentity }
record TargetIdentityWalk { modules: ModuleList, locals: NominalModuleList, target_index: u64, caller_index: u64, name_start: u64, name_end: u64, found: bool, identity: decl.SemanticIdentity }
record TargetTypeWalk { enums: decl.EnumList, records: decl.RecordList, local: decl.NominalTypeIdentityList, target_index: u64, caller_index: u64, name_start: u64, name_end: u64, found: bool, identity: decl.SemanticIdentity }

fn collect_local_nominal_modules<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList) -> (result: NominalModuleList) {
    iterate i over sources carrying st: NominalModuleBuild = NominalModuleBuild { rest: modules, acc: NominalModuleList.NMNil } {
        next st = collect_local_nominal_module<M, N>(sources, flat_pages, st);
    }
    return st.acc;
}
fn collect_local_nominal_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: NominalModuleBuild) -> (result: NominalModuleBuild) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => collect_local_nominal_module_one<M, N>(sources, flat_pages, st, parsed, rest)
    };
}
fn collect_local_nominal_module_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: NominalModuleBuild, parsed: ParsedModule, rest: ModuleList) -> (result: NominalModuleBuild) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let input_stride: u64 = module_stride(sources, parsed.source_index);
    let input_total: u64 = module_total(sources, parsed.source_index);
    let local: decl.NominalTypeIdentityList = decl.local_nominal_type_identities<1024, N>(input_pages, input_stride, input_total, parsed.unit);
    return NominalModuleBuild { rest: rest, acc: NominalModuleList.NMCons { head: NominalModule { source_index: parsed.source_index, local: local, resolved: decl.NominalTypeIdentityList.NINil }, tail: st.acc } };
}
fn nominal_module_by_index<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: NominalModuleList, source_index: u64) -> (result: NominalModuleLookup) {
    let empty: NominalModule = NominalModule { source_index: 0, local: decl.NominalTypeIdentityList.NINil, resolved: decl.NominalTypeIdentityList.NINil };
    iterate i over sources carrying st: NominalModuleLookup = NominalModuleLookup { rest: modules, source_index: source_index, found: false, facts: empty } {
        next st = nominal_module_lookup_step(st);
    }
    return st;
}
fn nominal_module_lookup_step(st: NominalModuleLookup) -> (result: NominalModuleLookup) {
    if st.found { return st; }
    return match st.rest {
        NMNil => st,
        NMCons { head: item, tail: rest } => nominal_module_lookup_one(st, item, rest)
    };
}
fn nominal_module_lookup_one(st: NominalModuleLookup, item: NominalModule, rest: NominalModuleList) -> (result: NominalModuleLookup) {
    if item.source_index == st.source_index { return NominalModuleLookup { ..st, rest: NominalModuleList.NMNil, found: true, facts: item }; }
    return NominalModuleLookup { ..st, rest: rest };
}
fn resolve_project_nominal_modules<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, locals: NominalModuleList) -> (result: NominalModuleList) {
    iterate i over sources carrying st: NominalResolutionBuild = NominalResolutionBuild { rest: modules, all: modules, locals: locals, acc: NominalModuleList.NMNil } {
        next st = resolve_project_nominal_module<M, N>(sources, flat_pages, st);
    }
    return st.acc;
}
fn resolve_project_nominal_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: NominalResolutionBuild) -> (result: NominalResolutionBuild) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => resolve_project_nominal_module_one<M, N>(sources, flat_pages, st, parsed, rest)
    };
}
fn resolve_project_nominal_module_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: NominalResolutionBuild, parsed: ParsedModule, rest: ModuleList) -> (result: NominalResolutionBuild) {
    let found: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, st.locals, parsed.source_index);
    let resolved: decl.NominalTypeIdentityList = project_nominal_type_identities<M, N>(sources, flat_pages, parsed, st.all, st.locals, found.facts.local);
    let cached: NominalModule = NominalModule { source_index: parsed.source_index, local: found.facts.local, resolved: resolved };
    return NominalResolutionBuild { ..st, rest: rest, acc: NominalModuleList.NMCons { head: cached, tail: st.acc } };
}

fn project_nominal_type_identities<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, all: ModuleList, locals: NominalModuleList, local: decl.NominalTypeIdentityList) -> (result: decl.NominalTypeIdentityList) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, current.source_index);
    let input_stride: u64 = module_stride(sources, current.source_index);
    let input_total: u64 = module_total(sources, current.source_index);
    let spans: decl.NominalTypeSpanList = decl.collect_unit_nominal_type_spans<1024, N>(input_pages, input_stride, input_total, current.unit);
    iterate i up_to 1024 carrying st: ProjectNominalWalk = ProjectNominalWalk { spans: spans, current: current, all: all, locals: locals, acc: local } {
        next st = project_nominal_span_step<M, N>(sources, flat_pages, input_pages, input_stride, input_total, st);
    }
    let references: decl.NominalTypeIdentityList = decl.nominal_reference_entries<1024, N>(input_pages, input_stride, input_total, st.acc);
    return decl.combine_nominal_type_identities<1024, N>(input_pages, input_stride, input_total, local, references);
}
fn project_nominal_span_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, st: ProjectNominalWalk) -> (result: ProjectNominalWalk) {
    return match st.spans {
        decl.NominalTypeSpanList.NSNil => st,
        decl.NominalTypeSpanList.NSCons { head: span, tail: rest } => project_nominal_span_one<M, N>(sources, flat_pages, input_pages, input_stride, input_total, st, span, rest)
    };
}
fn project_nominal_span_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, st: ProjectNominalWalk, span: decl.NominalTypeSpan, rest: decl.NominalTypeSpanList) -> (result: ProjectNominalWalk) {
    let local: decl.NominalLookup = decl.nominal_identity_by_name<1024, N>(input_pages, input_stride, input_total, st.acc, span.start, span.end);
    if span.kind == 5 && local.found { return ProjectNominalWalk { ..st, spans: rest }; }
    let uses: NominalUseWalk = resolve_nominal_in_uses<M, N>(sources, flat_pages, input_pages, input_stride, input_total, st.current, st.all, st.locals, span);
    if !(uses.found) || uses.count != 1 || !(uses.identity.valid) { return ProjectNominalWalk { ..st, spans: rest }; }
    let reference: decl.NominalTypeIdentity = decl.NominalTypeIdentity { start: span.start, end: span.end, identity: uses.identity, reference: true };
    return ProjectNominalWalk { ..st, spans: rest, acc: decl.NominalTypeIdentityList.NICons { head: reference, tail: st.acc } };
}
fn resolve_nominal_in_uses<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, current: ParsedModule, all: ModuleList, locals: NominalModuleList, span: decl.NominalTypeSpan) -> (result: NominalUseWalk) {
    iterate i up_to 1024 carrying st: NominalUseWalk = NominalUseWalk { uses: current.unit.uses, current: current, all: all, locals: locals, span: span, found: false, count: 0, identity: decl.invalid_semantic_identity() } {
        next st = resolve_nominal_use_step<M, N>(sources, flat_pages, input_pages, input_stride, input_total, st);
    }
    return st;
}
fn resolve_nominal_use_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, st: NominalUseWalk) -> (result: NominalUseWalk) {
    return match st.uses {
        decl.UseList.UNil => st,
        decl.UseList.UCons { head: usage, tail: rest } => resolve_nominal_use_one<M, N>(sources, flat_pages, input_pages, input_stride, input_total, st, usage, rest)
    };
}
fn resolve_nominal_use_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, st: NominalUseWalk, usage: decl.UseDecl, rest: decl.UseList) -> (result: NominalUseWalk) {
    if !(nominal_span_matches_use<N>(input_pages, input_stride, input_total, st.span, usage)) { return NominalUseWalk { ..st, uses: rest }; }
    let target: ModuleLookup = find_import_target<M, N>(sources, flat_pages, st.all, st.current, usage);
    if !(target.found) { return NominalUseWalk { ..st, uses: rest }; }
    let prefix_start: u64 = select(usage.has_alias, usage.alias_start, usage.module_start);
    let prefix_end: u64 = select(usage.has_alias, usage.alias_end, usage.module_end);
    let name_start: u64 = select(st.span.kind == 6, st.span.start + (prefix_end - prefix_start) + 1, st.span.start);
    let identity: decl.SemanticIdentity = nominal_identity_from_target<M, N>(sources, flat_pages, st.all, st.locals, target.index, st.current.source_index, name_start, st.span.end);
    if !(identity.valid) { return NominalUseWalk { ..st, uses: rest }; }
    let first: bool = st.count == 0;
    let same: bool = first || decl.semantic_identity_equal(st.identity, identity);
    let previous_identity: decl.SemanticIdentity = select_semantic_identity(first, identity, st.identity);
    if first { return NominalUseWalk { ..st, uses: rest, found: true, count: st.count + 1, identity: previous_identity }; }
    return NominalUseWalk { ..st, uses: rest, found: st.found && same, count: st.count + 1, identity: previous_identity };
}
fn nominal_span_matches_use<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, span: decl.NominalTypeSpan, usage: decl.UseDecl) -> (result: bool) {
    if span.end <= span.start { return false; }
    if span.kind == 5 { return !(usage.has_alias) && decl.spans_equal<1024, N>(pages, stride, total, span.start, span.end, span.start, span.end); }
    let prefix_start: u64 = select(usage.has_alias, usage.alias_start, usage.module_start);
    let prefix_end: u64 = select(usage.has_alias, usage.alias_end, usage.module_end);
    if prefix_end <= prefix_start || span.end - span.start <= prefix_end - prefix_start + 1 { return false; }
    if !(decl.spans_equal<1024, N>(pages, stride, total, span.start, span.start + (prefix_end - prefix_start), prefix_start, prefix_end)) { return false; }
    return source.byte_at_global<1024, N>(pages, stride, total, span.start + (prefix_end - prefix_start)) == 46;
}
fn select_semantic_identity(first: bool, candidate: decl.SemanticIdentity, previous: decl.SemanticIdentity) -> (result: decl.SemanticIdentity) {
    if first { return candidate; }
    return previous;
}
fn nominal_identity_from_target<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, locals: NominalModuleList, target_index: u64, caller_index: u64, name_start: u64, name_end: u64) -> (result: decl.SemanticIdentity) {
    iterate i over sources carrying st: TargetIdentityWalk = TargetIdentityWalk { modules: modules, locals: locals, target_index: target_index, caller_index: caller_index, name_start: name_start, name_end: name_end, found: false, identity: decl.invalid_semantic_identity() } {
        next st = nominal_target_step<M, N>(sources, flat_pages, st);
    }
    return st.identity;
}
fn nominal_target_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetIdentityWalk) -> (result: TargetIdentityWalk) {
    if st.found { return st; }
    return match st.modules {
        MNil => st,
        MCons { head: target, tail: rest } => nominal_target_candidate<M, N>(sources, flat_pages, st, target, rest)
    };
}
fn nominal_target_candidate<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetIdentityWalk, target: ParsedModule, rest: ModuleList) -> (result: TargetIdentityWalk) {
    if target.source_index != st.target_index { return TargetIdentityWalk { ..st, modules: rest }; }
    let local: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, st.locals, target.source_index);
    let matched: decl.SemanticIdentity = target_nominal_by_name<M, N>(sources, flat_pages, target, local.facts.local, st.caller_index, st.name_start, st.name_end);
    return TargetIdentityWalk { ..st, modules: ModuleList.MNil, found: matched.valid, identity: matched };
}
fn target_nominal_by_name<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target: ParsedModule, local: decl.NominalTypeIdentityList, caller_index: u64, name_start: u64, name_end: u64) -> (result: decl.SemanticIdentity) {
    let records: TargetTypeWalk = search_target_records<M, N>(sources, flat_pages, target, local, caller_index, name_start, name_end);
    if records.found { return records.identity; }
    let enums: TargetTypeWalk = search_target_enums<M, N>(sources, flat_pages, records, target.unit.enums);
    return enums.identity;
}
fn search_target_records<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target: ParsedModule, local: decl.NominalTypeIdentityList, caller_index: u64, name_start: u64, name_end: u64) -> (result: TargetTypeWalk) {
    let target_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, target.source_index);
    let target_stride: u64 = module_stride(sources, target.source_index);
    let target_total: u64 = module_total(sources, target.source_index);
    iterate i up_to 1024 carrying st: TargetTypeWalk = TargetTypeWalk { enums: decl.EnumList.GNil, records: target.unit.records, local: local, target_index: target.source_index, caller_index: caller_index, name_start: name_start, name_end: name_end, found: false, identity: decl.invalid_semantic_identity() } {
        next st = search_target_record_step<M, N>(sources, flat_pages, target_pages, target_stride, target_total, st);
    }
    return st;
}
fn search_target_record_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_pages: [[byte; up_to N]; up_to 1024], target_stride: u64, target_total: u64, st: TargetTypeWalk) -> (result: TargetTypeWalk) {
    if st.found { return st; }
    return match st.records {
        decl.RecordList.RNil => st,
        decl.RecordList.RCons { head: item, tail: rest } => search_target_record_one<M, N>(sources, flat_pages, target_pages, target_stride, target_total, st, item, rest)
    };
}
fn search_target_record_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_pages: [[byte; up_to N]; up_to 1024], target_stride: u64, target_total: u64, st: TargetTypeWalk, item: decl.RecordDecl, rest: decl.RecordList) -> (result: TargetTypeWalk) {
    if spans_equal_between<M, N>(sources, flat_pages, st.caller_index, st.name_start, st.name_end, st.target_index, item.name_start, item.name_end) {
        let found: decl.NominalLookup = decl.nominal_identity_by_name<1024, N>(target_pages, target_stride, target_total, st.local, item.name_start, item.name_end);
        return TargetTypeWalk { ..st, records: decl.RecordList.RNil, found: found.found, identity: found.identity };
    }
    return TargetTypeWalk { ..st, records: rest };
}
fn search_target_enums<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetTypeWalk, enums: decl.EnumList) -> (result: TargetTypeWalk) {
    let target_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, st.target_index);
    let target_stride: u64 = module_stride(sources, st.target_index);
    let target_total: u64 = module_total(sources, st.target_index);
    iterate i up_to 1024 carrying current: TargetTypeWalk = TargetTypeWalk { ..st, enums: enums } {
        next current = search_target_enum_step<M, N>(sources, flat_pages, target_pages, target_stride, target_total, current);
    }
    return current;
}
fn search_target_enum_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_pages: [[byte; up_to N]; up_to 1024], target_stride: u64, target_total: u64, st: TargetTypeWalk) -> (result: TargetTypeWalk) {
    if st.found { return st; }
    return match st.enums {
        decl.EnumList.GNil => st,
        decl.EnumList.GCons { head: item, tail: rest } => search_target_enum_one<M, N>(sources, flat_pages, target_pages, target_stride, target_total, st, item, rest)
    };
}
fn search_target_enum_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_pages: [[byte; up_to N]; up_to 1024], target_stride: u64, target_total: u64, st: TargetTypeWalk, item: decl.EnumDecl, rest: decl.EnumList) -> (result: TargetTypeWalk) {
    if spans_equal_between<M, N>(sources, flat_pages, st.caller_index, st.name_start, st.name_end, st.target_index, item.name_start, item.name_end) {
        let found: decl.NominalLookup = decl.nominal_identity_by_name<1024, N>(target_pages, target_stride, target_total, st.local, item.name_start, item.name_end);
        return TargetTypeWalk { ..st, enums: decl.EnumList.GNil, found: found.found, identity: found.identity };
    }
    return TargetTypeWalk { ..st, enums: rest };
}
fn spans_equal_between<M: Nat, N: Nat>(
    sources: [ProjectSource; up_to 64],
    flat_pages: [[byte; up_to N]; up_to M],
    left_index: u64,
    left_start: u64,
    left_end: u64,
    right_index: u64,
    right_start: u64,
    right_end: u64
) -> (result: bool) {
    if left_end < left_start || right_end < right_start { return false; }
    if left_end - left_start != right_end - right_start { return false; }
    // CP-0021: counted byte fuel replaces the old view-length fuel. The
    // 1024-byte compared-span ceiling matches the old view ceiling; the
    // post-check keeps longer spans exact by refusing prefix-equal
    // verdicts when fuel runs out (fail closed, never trap).
    // The module slices resolve once here, never per step: page slicing
    // allocates, and per-step slicing over multi-page modules exhausts
    // the backend value arena (16 MiB) on real compiler modules.
    let left_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, left_index);
    let left_stride: u64 = module_stride(sources, left_index);
    let left_total: u64 = module_total(sources, left_index);
    let right_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, right_index);
    let right_stride: u64 = module_stride(sources, right_index);
    let right_total: u64 = module_total(sources, right_index);
    iterate i up_to 1024 carrying st: SpanCompare = SpanCompare {
        length: left_end - left_start,
        left_index: left_index,
        left_start: left_start,
        right_index: right_index,
        right_start: right_start,
        offset: 0,
        equal: true
    } {
        next st = span_compare_step<N>(left_pages, left_stride, left_total, right_pages, right_stride, right_total, st);
    }
    return st.equal && st.offset >= st.length;
}
record SpanCompare {
    length: u64,
    left_index: u64,
    left_start: u64,
    right_index: u64,
    right_start: u64,
    offset: u64,
    equal: bool
}
fn span_compare_step<N: Nat>(left_pages: [[byte; up_to N]; up_to 1024], left_stride: u64, left_total: u64, right_pages: [[byte; up_to N]; up_to 1024], right_stride: u64, right_total: u64, st: SpanCompare) -> (result: SpanCompare) {
    if !(st.equal) || st.offset >= st.length { return st; }
    let a: u64 = source.byte_at_global<1024, N>(left_pages, left_stride, left_total, st.left_start + st.offset);
    let b: u64 = source.byte_at_global<1024, N>(right_pages, right_stride, right_total, st.right_start + st.offset);
    return SpanCompare {
        length: st.length,
        left_index: st.left_index,
        left_start: st.left_start,
        right_index: st.right_index,
        right_start: st.right_start,
        offset: st.offset + 1,
        equal: a == b
    };
}

fn reverse_imports<M: Nat>(sources: [ProjectSource; up_to M], imports: ImportList) -> (result: ImportList) {
    // Four 1024-link chunks retain the complete project-wide bound.
    let first: ImportReverse = reverse_import_part(ImportReverse { rest: imports, acc: ImportList.INil });
    let second: ImportReverse = reverse_import_part(first);
    let third: ImportReverse = reverse_import_part(second);
    let fourth: ImportReverse = reverse_import_part(third);
    return fourth.acc;
}
fn reverse_import_part(initial: ImportReverse) -> (result: ImportReverse) {
    iterate i up_to 1024 carrying st: ImportReverse = initial {
        if import_list_empty(st.rest) { return st; }
        next st = reverse_import_step(st);
    }
    return st;
}
record ImportReverse { rest: ImportList, acc: ImportList }
fn reverse_import_step(st: ImportReverse) -> (result: ImportReverse) {
    return match st.rest {
        INil => st,
        ICons { head: h, tail: t } => ImportReverse { rest: t, acc: ImportList.ICons { head: h, tail: st.acc } }
    };
}
fn append_diagnostics<M: Nat>(sources: [ProjectSource; up_to M], first: DiagnosticList, second: DiagnosticList) -> (result: DiagnosticList) {
    iterate chunk up_to 1024 carrying outer: DiagnosticReverse = DiagnosticReverse { rest: first, acc: second } {
        iterate i up_to 1024 carrying inner: DiagnosticReverse = outer {
            if diagnostic_list_empty(inner.rest) { return inner.acc; }
            next inner = append_diagnostic_step(inner);
        }
        if diagnostic_list_empty(inner.rest) { return inner.acc; }
        next outer = inner;
    }
    return outer.acc;
}
fn append_diagnostic_step(st: DiagnosticReverse) -> (result: DiagnosticReverse) {
    return match st.rest {
        DiagNil => st,
        DiagCons { head: h, tail: t } => DiagnosticReverse { rest: t, acc: DiagnosticList.DiagCons { head: h, tail: st.acc } }
    };
}
fn reverse_diagnostics<M: Nat>(sources: [ProjectSource; up_to M], diagnostics: DiagnosticList) -> (result: DiagnosticList) {
    iterate chunk up_to 1024 carrying outer: DiagnosticReverse = DiagnosticReverse { rest: diagnostics, acc: DiagnosticList.DiagNil } {
        iterate i up_to 1024 carrying inner: DiagnosticReverse = outer {
            if diagnostic_list_empty(inner.rest) { return inner.acc; }
            next inner = reverse_diagnostic_step(inner);
        }
        if diagnostic_list_empty(inner.rest) { return inner.acc; }
        next outer = inner;
    }
    return outer.acc;
}
fn diagnostic_list_empty(diagnostics: DiagnosticList) -> (result: bool) {
    return match diagnostics {
        DiagNil => true,
        DiagCons { head: diagnostic, tail: rest } => false
    };
}
fn reverse_diagnostic_step(st: DiagnosticReverse) -> (result: DiagnosticReverse) {
    return match st.rest {
        DiagNil => st,
        DiagCons { head: h, tail: t } => DiagnosticReverse { rest: t, acc: DiagnosticList.DiagCons { head: h, tail: st.acc } }
    };
}
record DiagnosticCount { rest: DiagnosticList, count: u64 }
fn diagnostics_empty<M: Nat>(sources: [ProjectSource; up_to M], diagnostics: DiagnosticList) -> (result: bool) {
    iterate i over sources carrying st: DiagnosticCount = DiagnosticCount { rest: diagnostics, count: 0 } {
        next st = diagnostic_count_step(st);
    }
    return st.count == 0;
}
fn diagnostic_count_step(st: DiagnosticCount) -> (result: DiagnosticCount) {
    return match st.rest {
        DiagNil => st,
        DiagCons { head: h, tail: t } => DiagnosticCount { rest: t, count: st.count + 1 }
    };
}
fn order_diagnostics<M: Nat>(sources: [ProjectSource; up_to M], ordered: bool, counts_match: bool) -> (result: DiagnosticList) {
    if !(ordered) { return DiagnosticList.DiagCons { head: ProjectDiagnostic.SourceOrder { source_index: 0 }, tail: DiagnosticList.DiagNil }; }
    if !(counts_match) { return DiagnosticList.DiagCons { head: ProjectDiagnostic.SourceCountMismatch { source_index: sources.len }, tail: DiagnosticList.DiagNil }; }
    return DiagnosticList.DiagNil;
}

// Build an imported signature environment from already parsed module facts.
// Transport preserves sequence bounds and parameter order while nominal
// ownership is resolved by identity instead of matching type spelling.
// Provider signatures and nominal ownership are immutable within one
// project invocation. The cache is deliberately local to imported_signatures:
// source_index is unique in that invocation, and no fact survives a new
// source snapshot or compiler request.
record ProviderSignatureFacts { source_index: u64, signatures: decl.SigTab, nominals: decl.NominalTypeIdentityList }
enum ProviderSignatureFactsList { PSNil, PSCons { head: ProviderSignatureFacts, tail: ProviderSignatureFactsList } }
record ProviderSignatureLookupWalk { rest: ProviderSignatureFactsList, target_index: u64, found: bool, signatures: decl.SigTab, nominals: decl.NominalTypeIdentityList }
record ProviderSignatureLookup { found: bool, signatures: decl.SigTab, nominals: decl.NominalTypeIdentityList }
record ResolvedImportFact { member_start: u64, member_end: u64, provider_source_index: u64, signature: decl.Sig }
enum ResolvedImportFactList { RIFNil, RIFCons { head: ResolvedImportFact, tail: ResolvedImportFactList } }
record ResolvedImportFactCache { facts: ResolvedImportFactList, count: u64 }
record ResolvedImportLookupWalk { rest: ResolvedImportFactList, member_start: u64, member_end: u64, provider_source_index: u64, found: bool, signature: decl.Sig }
record ResolvedImportLookup { found: bool, signature: decl.Sig }
record TargetSignatureResult { acc: decl.SigTab, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache }
record UseSignatureResult { acc: decl.SigTab, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache }
record ExportSignatureResult { acc: decl.SigTab, resolved: ResolvedImportFactCache }
record CallSigWalk { rest: decl.CallSiteList, acc: decl.SigTab, nominals: decl.NominalTypeIdentityList, modules: NominalModuleList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache }
record UseSigWalk { rest: decl.UseList, call: decl.CallSite, acc: decl.SigTab, nominals: decl.NominalTypeIdentityList, modules: NominalModuleList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache }
record TargetSigWalk { rest: ModuleList, modules: NominalModuleList, target_index: u64, current: ParsedModule, usage: decl.UseDecl, call: decl.CallSite, acc: decl.SigTab, caller_nominals: decl.NominalTypeIdentityList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache }
record ExportSigWalk { rest: decl.SigTab, caller: ParsedModule, target: ParsedModule, member_start: u64, member_end: u64, call: decl.CallSite, caller_nominals: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, acc: decl.SigTab, resolved: ResolvedImportFactCache }

fn imported_signatures<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, all: ModuleList, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList) -> (result: decl.SigTab) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, current.source_index);
    let input_stride: u64 = module_stride(sources, current.source_index);
    let input_total: u64 = module_total(sources, current.source_index);
    let calls: decl.CallSiteList = decl.collect_call_sites<1024, N>(input_pages, input_stride, input_total, current.unit.fns);
    let initial: CallSigWalk = CallSigWalk { rest: calls, acc: decl.SigTab.HNil, nominals: nominals, modules: nominal_modules, provider_facts: ProviderSignatureFactsList.PSNil, resolved: ResolvedImportFactCache { facts: ResolvedImportFactList.RIFNil, count: 0 } };
    iterate chunk up_to 64 carrying st: CallSigWalk = initial {
        if decl.call_site_list_empty(st.rest) { return st.acc; }
        next st = imported_signature_chunk<M, N>(sources, flat_pages, current, all, st);
    }
    return st.acc;
}
fn imported_signature_chunk<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, all: ModuleList, initial: CallSigWalk) -> (result: CallSigWalk) {
    iterate i up_to 1024 carrying st: CallSigWalk = initial {
        if decl.call_site_list_empty(st.rest) { return st; }
        next st = imported_signature_for_call<M, N>(sources, flat_pages, current, all, st);
    }
    return st;
}
fn imported_signature_for_call<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, all: ModuleList, st: CallSigWalk) -> (result: CallSigWalk) {
    return match st.rest {
        CNil => st,
        CCons { head: call, tail: rest } => imported_signature_for_one_call<M, N>(sources, flat_pages, current, all, call, rest, st)
    };
}
fn imported_signature_for_one_call<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, all: ModuleList, call: decl.CallSite, rest: decl.CallSiteList, st: CallSigWalk) -> (result: CallSigWalk) {
    let uses: decl.UseList = current.unit.uses;
    let found: UseSignatureResult = signatures_from_uses<M, N>(sources, flat_pages, all, current, uses, call, st.acc, st.nominals, st.modules, st.provider_facts, st.resolved);
    return CallSigWalk { rest: rest, acc: found.acc, nominals: st.nominals, modules: st.modules, provider_facts: found.provider_facts, resolved: found.resolved };
}
fn signatures_from_uses<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, uses: decl.UseList, call: decl.CallSite, acc: decl.SigTab, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache) -> (result: UseSignatureResult) {
    iterate i up_to 1024 carrying st: UseSigWalk = UseSigWalk { rest: uses, call: call, acc: acc, nominals: nominals, modules: nominal_modules, provider_facts: provider_facts, resolved: resolved } {
        if decl.use_list_empty(st.rest) {
            return UseSignatureResult { acc: st.acc, provider_facts: st.provider_facts, resolved: st.resolved };
        }
        next st = signatures_from_use<M, N>(sources, flat_pages, all, current, st);
    }
    return UseSignatureResult { acc: st.acc, provider_facts: st.provider_facts, resolved: st.resolved };
}
fn signatures_from_use<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, st: UseSigWalk) -> (result: UseSigWalk) {
    return match st.rest {
        UNil => st,
        UCons { head: usage, tail: rest } => signatures_from_one_use<M, N>(sources, flat_pages, all, current, st, usage, rest)
    };
}
fn signatures_from_one_use<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, st: UseSigWalk, usage: decl.UseDecl, rest: decl.UseList) -> (result: UseSigWalk) {
    if !(call_has_import_prefix<M, N>(sources, flat_pages, current.source_index, st.call, usage)) { return UseSigWalk { ..st, rest: rest }; }
    let target: ModuleLookup = find_import_target<M, N>(sources, flat_pages, all, current, usage);
    if !(target.found) { return UseSigWalk { ..st, rest: rest }; }
    let cached: ResolvedImportLookup = resolved_import_signature_lookup<M, N>(sources, flat_pages, current, st.call, usage, target.index, st.resolved);
    if cached.found {
        let reused: decl.SigTab = reuse_resolved_import_signature(st.call, cached.signature, st.acc);
        return UseSigWalk { rest: rest, call: st.call, acc: reused, nominals: st.nominals, modules: st.modules, provider_facts: st.provider_facts, resolved: st.resolved };
    }
    let sigs: TargetSignatureResult = signatures_from_target<M, N>(sources, flat_pages, all, st.modules, current, target.index, usage, st.call, st.acc, st.nominals, st.provider_facts, st.resolved);
    return UseSigWalk { rest: rest, call: st.call, acc: sigs.acc, nominals: st.nominals, modules: st.modules, provider_facts: sigs.provider_facts, resolved: sigs.resolved };
}
fn call_has_import_prefix<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], index: u64, call: decl.CallSite, usage: decl.UseDecl) -> (result: bool) {
    let pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, index);
    let stride: u64 = module_stride(sources, index);
    let total: u64 = module_total(sources, index);
    let prefix_start: u64 = select(usage.has_alias, usage.alias_start, usage.module_start);
    let prefix_end: u64 = select(usage.has_alias, usage.alias_end, usage.module_end);
    if call.end <= call.start || prefix_end <= prefix_start { return false; }
    let prefix_len: u64 = prefix_end - prefix_start;
    if call.end - call.start <= prefix_len + 1 { return false; }
    if !(decl.spans_equal<1024, N>(pages, stride, total, call.start, call.start + prefix_len, prefix_start, prefix_end)) { return false; }
    return source.byte_at_global<1024, N>(pages, stride, total, call.start + prefix_len) == 46;
}
fn resolved_import_signature_lookup<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, call: decl.CallSite, usage: decl.UseDecl, provider_source_index: u64, facts: ResolvedImportFactCache) -> (result: ResolvedImportLookup) {
    let pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, current.source_index);
    let stride: u64 = module_stride(sources, current.source_index);
    let total: u64 = module_total(sources, current.source_index);
    let prefix_start: u64 = select(usage.has_alias, usage.alias_start, usage.module_start);
    let prefix_end: u64 = select(usage.has_alias, usage.alias_end, usage.module_end);
    let member_start: u64 = call.start + (prefix_end - prefix_start) + 1;
    let empty_signature: decl.Sig = decl.Sig { start: 0, end: 0, params: decl.BindList.BNil, nparams: 0, generic_bounds: decl.GenericBoundList.KNil, result: decl.SemType.TPoison, fx: decl.EffectList.XNil, raw_capabilities: decl.CapList.ANil, effects: decl.EffectIdentityList.EINil, capabilities: decl.CapabilityIdentityList.CINil, identity: decl.invalid_semantic_identity() };
    let initial: ResolvedImportLookupWalk = ResolvedImportLookupWalk { rest: facts.facts, member_start: member_start, member_end: call.end, provider_source_index: provider_source_index, found: false, signature: empty_signature };
    iterate chunk up_to 64 carrying st: ResolvedImportLookupWalk = initial {
        if st.found || resolved_import_fact_list_empty(st.rest) { return ResolvedImportLookup { found: st.found, signature: st.signature }; }
        next st = resolved_import_signature_lookup_chunk<1024, N>(pages, stride, total, st);
    }
    return ResolvedImportLookup { found: st.found, signature: st.signature };
}
fn resolved_import_signature_lookup_chunk<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, initial: ResolvedImportLookupWalk) -> (result: ResolvedImportLookupWalk) {
    iterate i up_to 1024 carrying st: ResolvedImportLookupWalk = initial {
        if st.found || resolved_import_fact_list_empty(st.rest) { return st; }
        next st = resolved_import_signature_lookup_step<P, N>(pages, stride, total, st);
    }
    return st;
}
fn resolved_import_fact_list_empty(facts: ResolvedImportFactList) -> (result: bool) {
    return match facts {
        RIFNil => true,
        RIFCons { head: item, tail: rest } => false
    };
}
fn resolved_import_signature_lookup_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ResolvedImportLookupWalk) -> (result: ResolvedImportLookupWalk) {
    return match st.rest {
        RIFNil => st,
        RIFCons { head: fact, tail: rest } => resolved_import_signature_lookup_item<P, N>(pages, stride, total, st, fact, rest)
    };
}
fn resolved_import_signature_lookup_item<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, st: ResolvedImportLookupWalk, fact: ResolvedImportFact, rest: ResolvedImportFactList) -> (result: ResolvedImportLookupWalk) {
    if fact.provider_source_index == st.provider_source_index && decl.spans_equal<P, N>(pages, stride, total, st.member_start, st.member_end, fact.member_start, fact.member_end) {
        return ResolvedImportLookupWalk { rest: rest, member_start: st.member_start, member_end: st.member_end, provider_source_index: st.provider_source_index, found: true, signature: fact.signature };
    }
    return ResolvedImportLookupWalk { ..st, rest: rest };
}
fn resolved_import_fact_push_bounded(fact: ResolvedImportFact, cache: ResolvedImportFactCache) -> (result: ResolvedImportFactCache) {
    // Retain at most 64 exact imported names. Common misses add one fact in
    // constant work; when full, reset the cache rather than rebuilding a list.
    if cache.count >= 64 {
        return ResolvedImportFactCache { facts: ResolvedImportFactList.RIFCons { head: fact, tail: ResolvedImportFactList.RIFNil }, count: 1 };
    }
    return ResolvedImportFactCache { facts: ResolvedImportFactList.RIFCons { head: fact, tail: cache.facts }, count: cache.count + 1 };
}
fn reuse_resolved_import_signature(call: decl.CallSite, cached: decl.Sig, acc: decl.SigTab) -> (result: decl.SigTab) {
    let reused: decl.Sig = decl.Sig { ..cached, start: call.start, end: call.end };
    return decl.SigTab.HCons { head: reused, tail: acc };
}
fn signatures_from_target<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, nominal_modules: NominalModuleList, current: ParsedModule, target_index: u64, usage: decl.UseDecl, call: decl.CallSite, acc: decl.SigTab, caller_nominals: decl.NominalTypeIdentityList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache) -> (result: TargetSignatureResult) {
    iterate i over sources carrying st: TargetSigWalk = TargetSigWalk { rest: all, modules: nominal_modules, target_index: target_index, current: current, usage: usage, call: call, acc: acc, caller_nominals: caller_nominals, provider_facts: provider_facts, resolved: resolved } {
        next st = signatures_from_target_step<M, N>(sources, flat_pages, st);
    }
    return TargetSignatureResult { acc: st.acc, provider_facts: st.provider_facts, resolved: st.resolved };
}
fn signatures_from_target_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetSigWalk) -> (result: TargetSigWalk) {
    return match st.rest {
        MNil => st,
        MCons { head: target, tail: rest } => build_signatures_from_candidate<M, N>(sources, flat_pages, st, target, rest)
    };
}
fn build_signatures_from_candidate<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetSigWalk, target: ParsedModule, rest: ModuleList) -> (result: TargetSigWalk) {
    if target.source_index != st.target_index { return TargetSigWalk { ..st, rest: rest }; }
    let cached: ProviderSignatureLookup = provider_signature_lookup(st.provider_facts, target.source_index);
    if cached.found { return signatures_from_cached_provider<M, N>(sources, flat_pages, st, target, cached); }
    let t_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, target.source_index);
    let t_stride: u64 = module_stride(sources, target.source_index);
    let t_total: u64 = module_total(sources, target.source_index);
    let target_facts: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, st.modules, target.source_index);
    let target_nominals: decl.NominalTypeIdentityList = target_facts.facts.resolved;
    let sigs: decl.SigTabRep = decl.collect_sigtab<1024, N>(t_pages, t_stride, t_total, target.unit.fns, target.unit.records, target.unit.enums, target_nominals);
    let owned_sigs: decl.SigTab = decl.bind_local_callable_identities<1024, N>(t_pages, t_stride, t_total, target.unit.header, sigs.tab);
    let exported: ExportSignatureResult = signatures_from_exports<M, N>(sources, flat_pages, st.current, target, st.usage, st.call, owned_sigs, st.acc, st.caller_nominals, target_nominals, st.resolved);
    let facts: ProviderSignatureFacts = ProviderSignatureFacts { source_index: target.source_index, signatures: owned_sigs, nominals: target_nominals };
    let cached_facts: ProviderSignatureFactsList = ProviderSignatureFactsList.PSCons { head: facts, tail: st.provider_facts };
    return TargetSigWalk { ..st, rest: ModuleList.MNil, acc: exported.acc, provider_facts: cached_facts, resolved: exported.resolved };
}
fn signatures_from_cached_provider<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetSigWalk, target: ParsedModule, cached: ProviderSignatureLookup) -> (result: TargetSigWalk) {
    let exported: ExportSignatureResult = signatures_from_exports<M, N>(sources, flat_pages, st.current, target, st.usage, st.call, cached.signatures, st.acc, st.caller_nominals, cached.nominals, st.resolved);
    return TargetSigWalk { ..st, rest: ModuleList.MNil, acc: exported.acc, resolved: exported.resolved };
}
fn provider_signature_lookup(facts: ProviderSignatureFactsList, target_index: u64) -> (result: ProviderSignatureLookup) {
    let initial: ProviderSignatureLookupWalk = ProviderSignatureLookupWalk { rest: facts, target_index: target_index, found: false, signatures: decl.SigTab.HNil, nominals: decl.NominalTypeIdentityList.NINil };
    iterate i up_to 64 carrying st: ProviderSignatureLookupWalk = initial {
        if st.found || provider_signature_facts_empty(st.rest) { return ProviderSignatureLookup { found: st.found, signatures: st.signatures, nominals: st.nominals }; }
        next st = provider_signature_lookup_step(st);
    }
    return ProviderSignatureLookup { found: st.found, signatures: st.signatures, nominals: st.nominals };
}
fn provider_signature_facts_empty(facts: ProviderSignatureFactsList) -> (result: bool) {
    return match facts { PSNil => true, PSCons { head: item, tail: rest } => false };
}
fn provider_signature_lookup_step(st: ProviderSignatureLookupWalk) -> (result: ProviderSignatureLookupWalk) {
    return match st.rest {
        PSNil => st,
        PSCons { head: item, tail: rest } => provider_signature_lookup_item(st, item, rest)
    };
}
fn provider_signature_lookup_item(st: ProviderSignatureLookupWalk, item: ProviderSignatureFacts, rest: ProviderSignatureFactsList) -> (result: ProviderSignatureLookupWalk) {
    if item.source_index == st.target_index { return ProviderSignatureLookupWalk { rest: rest, target_index: st.target_index, found: true, signatures: item.signatures, nominals: item.nominals }; }
    return ProviderSignatureLookupWalk { ..st, rest: rest };
}
fn signatures_from_exports<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller: ParsedModule, target: ParsedModule, usage: decl.UseDecl, call: decl.CallSite, target_sigs: decl.SigTab, acc: decl.SigTab, caller_nominals: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, resolved: ResolvedImportFactCache) -> (result: ExportSignatureResult) {
    // The provider signature table already carries every declaration name
    // and checked signature. Compare the imported member across source
    // identities once instead of walking FnDecls before searching this table.
    let prefix_start: u64 = select(usage.has_alias, usage.alias_start, usage.module_start);
    let prefix_end: u64 = select(usage.has_alias, usage.alias_end, usage.module_end);
    let member_start: u64 = call.start + (prefix_end - prefix_start) + 1;
    iterate chunk up_to 64 carrying st: ExportSigWalk = ExportSigWalk { rest: target_sigs, caller: caller, target: target, member_start: member_start, member_end: call.end, call: call, caller_nominals: caller_nominals, target_nominals: target_nominals, acc: acc, resolved: resolved } {
        if export_signature_table_empty(st.rest) { return ExportSignatureResult { acc: st.acc, resolved: st.resolved }; }
        next st = signatures_from_export_chunk<M, N>(sources, flat_pages, st);
    }
    return ExportSignatureResult { acc: st.acc, resolved: st.resolved };
}
fn export_signature_table_empty(signatures: decl.SigTab) -> (result: bool) {
    return match signatures {
        decl.SigTab.HNil => true,
        decl.SigTab.HCons { head: item, tail: rest } => false
    };
}
fn signatures_from_export_chunk<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], initial: ExportSigWalk) -> (result: ExportSigWalk) {
    iterate i up_to 1024 carrying st: ExportSigWalk = initial {
        if export_signature_table_empty(st.rest) { return st; }
        next st = signatures_from_export<M, N>(sources, flat_pages, st);
    }
    return st;
}
fn signatures_from_export<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ExportSigWalk) -> (result: ExportSigWalk) {
    return match st.rest {
        decl.SigTab.HNil => st,
        decl.SigTab.HCons { head: signature, tail: rest } => signature_from_export<M, N>(sources, flat_pages, st, signature, rest)
    };
}
fn signature_from_export<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ExportSigWalk, candidate: decl.Sig, rest: decl.SigTab) -> (result: ExportSigWalk) {
    if !(spans_equal_between<M, N>(sources, flat_pages, st.caller.source_index, st.member_start, st.member_end, st.target.source_index, candidate.start, candidate.end)) {
        return ExportSigWalk { ..st, rest: rest };
    }
    let transported: SignatureTransport = transport_signature<M, N>(sources, flat_pages, st.caller.source_index, st.target.source_index, candidate, st.target_nominals, st.caller_nominals);
    if !(transported.ok) { return ExportSigWalk { ..st, rest: rest }; }
    let sig: decl.Sig = decl.Sig {
        start: st.call.start,
        end: st.call.end,
        params: transported.params,
        nparams: candidate.nparams,
        generic_bounds: candidate.generic_bounds,
        result: transported.result,
        fx: decl.EffectList.XNil,
        raw_capabilities: decl.CapList.ANil,
        effects: candidate.effects,
        capabilities: candidate.capabilities,
        identity: candidate.identity
    };
    let fact: ResolvedImportFact = ResolvedImportFact { member_start: st.member_start, member_end: st.member_end, provider_source_index: st.target.source_index, signature: sig };
    let resolved: ResolvedImportFactCache = resolved_import_fact_push_bounded(fact, st.resolved);
    return ExportSigWalk { ..st, rest: decl.SigTab.HNil, acc: decl.SigTab.HCons { head: sig, tail: st.acc }, resolved: resolved };
}
record TypeTransport { ty: decl.SemType, ok: bool }
record ParameterTransport { rest: decl.BindList, acc: decl.BindList, ok: bool }
record SignatureTransport { params: decl.BindList, result: decl.SemType, ok: bool }
fn transport_signature<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, sig: decl.Sig, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: SignatureTransport) {
    let result: TypeTransport = transport_type<M, N>(sources, flat_pages, caller_index, target_index, sig.result, target_nominals, caller_nominals);
    iterate i up_to 1024 carrying st: ParameterTransport = ParameterTransport { rest: sig.params, acc: decl.BindList.BNil, ok: result.ok } {
        next st = transport_parameter_step<M, N>(sources, flat_pages, caller_index, target_index, st, target_nominals, caller_nominals);
    }
    return SignatureTransport { params: reverse_transported_parameters(st.acc), result: result.ty, ok: st.ok && bind_list_empty(st.rest) };
}
fn transport_parameter_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, st: ParameterTransport, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: ParameterTransport) {
    if !(st.ok) { return st; }
    return match st.rest {
        decl.BindList.BNil => st,
        decl.BindList.BCons { head: parameter, tail: rest } => transport_one_parameter<M, N>(sources, flat_pages, caller_index, target_index, st, parameter, rest, target_nominals, caller_nominals)
    };
}
fn transport_one_parameter<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, st: ParameterTransport, parameter: decl.Bind, rest: decl.BindList, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: ParameterTransport) {
    let ty: TypeTransport = transport_type<M, N>(sources, flat_pages, caller_index, target_index, parameter.ty, target_nominals, caller_nominals);
    let rebound: decl.Bind = decl.Bind { ..parameter, ty: ty.ty };
    return ParameterTransport { rest: rest, acc: decl.BindList.BCons { head: rebound, tail: st.acc }, ok: ty.ok };
}
fn bind_list_empty(params: decl.BindList) -> (result: bool) { return match params { decl.BindList.BNil => true, decl.BindList.BCons { head: h, tail: t } => false }; }
record BindReverse { rest: decl.BindList, acc: decl.BindList }
fn reverse_transported_parameters(params: decl.BindList) -> (result: decl.BindList) {
    iterate i up_to 1024 carrying st: BindReverse = BindReverse { rest: params, acc: decl.BindList.BNil } { next st = reverse_transported_parameter_step(st); }
    return st.acc;
}
fn reverse_transported_parameter_step(st: BindReverse) -> (result: BindReverse) {
    return match st.rest {
        decl.BindList.BNil => st,
        decl.BindList.BCons { head: h, tail: rest } => BindReverse { rest: rest, acc: decl.BindList.BCons { head: h, tail: st.acc } }
    };
}
fn transport_type<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, ty: decl.SemType, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    return match ty {
        TBool => TypeTransport { ty: ty, ok: true },
        TByte => TypeTransport { ty: ty, ok: true },
        TInt { width: w, signed: s } => TypeTransport { ty: ty, ok: true },
        TNamed { start: a, end: b } => transport_nominal_type<M, N>(sources, flat_pages, caller_index, target_index, a, b, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: ty, ok: true },
        TSeqExact { element: element, length: length, length_valid: valid } => transport_sequence_type<M, N>(sources, flat_pages, caller_index, target_index, element, length, valid, target_nominals, caller_nominals),
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
}
// Schema fields are resolved and transported within their declaring module.
// Reuse that module's page slice instead of rebuilding it for each nominal
// field through the general cross-module transport path.
fn transport_type_in_module<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: decl.SemType, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    return match ty {
        TBool => TypeTransport { ty: ty, ok: true },
        TByte => TypeTransport { ty: ty, ok: true },
        TInt { width: width, signed: signed } => TypeTransport { ty: ty, ok: true },
        TNamed { start: start, end: end } => transport_nominal_type_in_module<P, N>(pages, stride, total, start, end, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: ty, ok: true },
        TSeqExact { element: element, length: length, length_valid: valid } => transport_sequence_type_in_module<P, N>(pages, stride, total, element, length, valid, target_nominals, caller_nominals),
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
}
fn transport_sequence_type_in_module<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, element: decl.SemType, length: u64, length_valid: bool, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let transported: TypeTransport = transport_sequence_element_in_module<P, N>(pages, stride, total, element, target_nominals, caller_nominals);
    if !(transported.ok) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    return TypeTransport { ty: decl.SemType.TSeqExact { element: transported.ty, length: length, length_valid: length_valid }, ok: true };
}
fn transport_sequence_element_in_module<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, element: decl.SemType, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    return match element {
        TBool => TypeTransport { ty: element, ok: true },
        TByte => TypeTransport { ty: element, ok: true },
        TInt { width: width, signed: signed } => TypeTransport { ty: element, ok: true },
        TNamed { start: start, end: end } => transport_nominal_type_in_module<P, N>(pages, stride, total, start, end, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: element, ok: true },
        TSeqExact { element: nested, length: count, length_valid: valid } => transport_nested_sequence_element_in_module<P, N>(pages, stride, total, nested, count, valid, target_nominals, caller_nominals),
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
}
fn transport_nested_sequence_element_in_module<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, element: decl.SemType, length: u64, length_valid: bool, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let transported: TypeTransport = match element {
        TBool => TypeTransport { ty: element, ok: true },
        TByte => TypeTransport { ty: element, ok: true },
        TInt { width: width, signed: signed } => TypeTransport { ty: element, ok: true },
        TNamed { start: start, end: end } => transport_nominal_type_in_module<P, N>(pages, stride, total, start, end, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: decl.SemType.TPoison, ok: false },
        TSeqExact { element: nested, length: count, length_valid: valid } => TypeTransport { ty: decl.SemType.TPoison, ok: false },
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
    if !(transported.ok) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    return TypeTransport { ty: decl.SemType.TSeqExact { element: transported.ty, length: length, length_valid: length_valid }, ok: true };
}
fn transport_nominal_type_in_module<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let imported: decl.NominalLookup = decl.nominal_identity_at<P, N>(pages, stride, total, target_nominals, start, end);
    let target: decl.NominalLookup = select_nominal_lookup(imported.found, imported, decl.nominal_identity_by_name<P, N>(pages, stride, total, target_nominals, start, end));
    if !(target.found) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    let caller: decl.NominalRefLookup = decl.nominal_reference_by_identity<P, N>(pages, stride, total, caller_nominals, target.identity);
    if !(caller.found) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    return TypeTransport { ty: decl.SemType.TNamed { start: caller.start, end: caller.end }, ok: true };
}
fn transport_sequence_type<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, element: decl.SemType, length: u64, length_valid: bool, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let transported: TypeTransport = transport_sequence_element<M, N>(sources, flat_pages, caller_index, target_index, element, target_nominals, caller_nominals);
    if !(transported.ok) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    // `length_valid` marks a concrete exact length. Views and symbolic
    // generic bounds intentionally keep it false; their sentinel is part
    // of the imported signature and must survive transport unchanged. Stage-0
    // admits one nested sequence layer in signatures; the element transport
    // preserves that inner bound without recursively walking compiler types.
    return TypeTransport { ty: decl.SemType.TSeqExact { element: transported.ty, length: length, length_valid: length_valid }, ok: true };
}
fn transport_sequence_element<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, element: decl.SemType, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    return match element {
        TBool => TypeTransport { ty: element, ok: true },
        TByte => TypeTransport { ty: element, ok: true },
        TInt { width: width, signed: signed } => TypeTransport { ty: element, ok: true },
        TNamed { start: start, end: end } => transport_nominal_type<M, N>(sources, flat_pages, caller_index, target_index, start, end, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: element, ok: true },
        TSeqExact { element: nested, length: count, length_valid: valid } => transport_nested_sequence_element<M, N>(sources, flat_pages, caller_index, target_index, nested, count, valid, target_nominals, caller_nominals),
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
}
fn transport_nested_sequence_element<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, element: decl.SemType, length: u64, length_valid: bool, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let transported: TypeTransport = match element {
        TBool => TypeTransport { ty: element, ok: true },
        TByte => TypeTransport { ty: element, ok: true },
        TInt { width: width, signed: signed } => TypeTransport { ty: element, ok: true },
        TNamed { start: start, end: end } => transport_nominal_type<M, N>(sources, flat_pages, caller_index, target_index, start, end, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: decl.SemType.TPoison, ok: false },
        TSeqExact { element: nested, length: count, length_valid: valid } => TypeTransport { ty: decl.SemType.TPoison, ok: false },
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
    if !(transported.ok) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    return TypeTransport { ty: decl.SemType.TSeqExact { element: transported.ty, length: length, length_valid: length_valid }, ok: true };
}
fn transport_nominal_type<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, start: u64, end: u64, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let target_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, target_index);
    let target_stride: u64 = module_stride(sources, target_index);
    let target_total: u64 = module_total(sources, target_index);
    let caller_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, caller_index);
    let caller_stride: u64 = module_stride(sources, caller_index);
    let caller_total: u64 = module_total(sources, caller_index);
    let imported: decl.NominalLookup = decl.nominal_identity_at<1024, N>(target_pages, target_stride, target_total, target_nominals, start, end);
    let target: decl.NominalLookup = select_nominal_lookup(imported.found, imported, decl.nominal_identity_by_name<1024, N>(target_pages, target_stride, target_total, target_nominals, start, end));
    if !(target.found) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    let caller: decl.NominalRefLookup = decl.nominal_reference_by_identity<1024, N>(caller_pages, caller_stride, caller_total, caller_nominals, target.identity);
    if !(caller.found) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    return TypeTransport { ty: decl.SemType.TNamed { start: caller.start, end: caller.end }, ok: true };
}
fn select_nominal_lookup(imported_first: bool, imported: decl.NominalLookup, local: decl.NominalLookup) -> (result: decl.NominalLookup) {
    if imported_first { return imported; }
    return local;
}
fn effect_list_empty(fx: decl.EffectList) -> (result: bool) {
    return match fx { XNil => true, XCons { head: h, tail: t } => false };
}
// Project nominal types receive stable out-of-source spans. Generic type
// variables occupy marker slots 1..1024, so project identities start at
// 1025. Every module sees the same identity-to-marker mapping, which lets
// imported field types survive semantic proof and the SSA verifier without
// borrowing another module's byte offsets.
fn project_nominal_markers(modules: NominalModuleList) -> (result: decl.NominalTypeIdentityList) {
    iterate i up_to 64 carrying st: ProjectNominalModuleWalk = ProjectNominalModuleWalk { rest: modules, acc: decl.NominalTypeIdentityList.NINil, count: 0 } {
        next st = project_nominal_module_step(st);
    }
    return st.acc;
}
fn project_nominal_module_step(st: ProjectNominalModuleWalk) -> (result: ProjectNominalModuleWalk) {
    return match st.rest {
        NMNil => st,
        NMCons { head: nominal_item, tail: rest } => project_nominal_module_cons(st, nominal_item, rest)
    };
}
fn project_nominal_module_cons(st: ProjectNominalModuleWalk, nominal_item: NominalModule, rest: NominalModuleList) -> (result: ProjectNominalModuleWalk) {
    let identities: ProjectNominalIdentityWalk = project_nominal_identity_list(nominal_item.resolved, st.acc, st.count);
    return ProjectNominalModuleWalk { rest: rest, acc: identities.acc, count: identities.count };
}
fn project_nominal_identity_list(identities: decl.NominalTypeIdentityList, acc: decl.NominalTypeIdentityList, count: u64) -> (result: ProjectNominalIdentityWalk) {
    iterate i up_to 1024 carrying st: ProjectNominalIdentityWalk = ProjectNominalIdentityWalk { rest: identities, acc: acc, count: count } {
        next st = project_nominal_identity_step(st);
    }
    return st;
}
fn project_nominal_identity_step(st: ProjectNominalIdentityWalk) -> (result: ProjectNominalIdentityWalk) {
    return match st.rest {
        NINil => st,
        NICons { head: identity, tail: rest } => project_nominal_identity_cons(st, identity, rest)
    };
}
fn project_nominal_identity_cons(st: ProjectNominalIdentityWalk, identity: decl.NominalTypeIdentity, rest: decl.NominalTypeIdentityList) -> (result: ProjectNominalIdentityWalk) {
    let exists: ProjectNominalContains = project_nominal_contains(st.acc, identity.identity);
    if !(identity.identity.valid) || exists.found || st.count >= 1024 {
        return ProjectNominalIdentityWalk { rest: rest, acc: st.acc, count: st.count };
    }
    let marker: decl.NominalTypeIdentity = decl.NominalTypeIdentity { start: 18446744073709551615 - (1024 + st.count + 1), end: 18446744073709551615, identity: identity.identity, reference: true };
    return ProjectNominalIdentityWalk { rest: rest, acc: decl.NominalTypeIdentityList.NICons { head: marker, tail: st.acc }, count: st.count + 1 };
}
fn project_nominal_contains(identities: decl.NominalTypeIdentityList, wanted: decl.SemanticIdentity) -> (result: ProjectNominalContains) {
    iterate i up_to 1024 carrying st: ProjectNominalContains = ProjectNominalContains { rest: identities, wanted: wanted, found: false } {
        if st.found { return st; }
        next st = project_nominal_contains_step(st);
    }
    return st;
}
fn project_nominal_contains_step(st: ProjectNominalContains) -> (result: ProjectNominalContains) {
    return match st.rest {
        NINil => st,
        NICons { head: identity, tail: rest } => project_nominal_contains_cons(st, identity, rest)
    };
}
fn project_nominal_contains_cons(st: ProjectNominalContains, identity: decl.NominalTypeIdentity, rest: decl.NominalTypeIdentityList) -> (result: ProjectNominalContains) {
    if decl.semantic_identity_equal(identity.identity, st.wanted) { return ProjectNominalContains { rest: decl.NominalTypeIdentityList.NINil, wanted: st.wanted, found: true }; }
    return ProjectNominalContains { rest: rest, wanted: st.wanted, found: false };
}

fn project_record_schemas<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, nominal_modules: NominalModuleList, markers: decl.NominalTypeIdentityList) -> (result: decl.ImportedRecordList) {
    iterate i up_to 64 carrying st: ProjectRecordWalk = ProjectRecordWalk { rest: modules, nominal_modules: nominal_modules, markers: markers, acc: decl.ImportedRecordList.IRNil } {
        next st = project_record_module_step<M, N>(sources, flat_pages, st);
    }
    return st.acc;
}
fn project_record_module_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectRecordWalk) -> (result: ProjectRecordWalk) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => project_record_module_cons<M, N>(sources, flat_pages, st, parsed, rest)
    };
}
fn project_record_module_cons<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectRecordWalk, parsed: ParsedModule, rest: ModuleList) -> (result: ProjectRecordWalk) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let input_stride: u64 = module_stride(sources, parsed.source_index);
    let input_total: u64 = module_total(sources, parsed.source_index);
    let facts: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, st.nominal_modules, parsed.source_index);
    let target_nominals: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(input_pages, input_stride, input_total, st.markers, facts.facts.resolved);
    let schemas: decl.ImportedRecordList = project_record_decls<N>(input_pages, input_stride, input_total, parsed.unit.records, parsed.unit.records, parsed.unit.enums, st.markers, target_nominals, st.acc);
    return ProjectRecordWalk { rest: rest, nominal_modules: st.nominal_modules, markers: st.markers, acc: schemas };
}
fn project_record_decls<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, records: decl.RecordList, unit_records: decl.RecordList, enums: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, acc: decl.ImportedRecordList) -> (result: decl.ImportedRecordList) {
    iterate i up_to 1024 carrying st: ProjectRecordDeclWalk = ProjectRecordDeclWalk { rest: records, markers: markers, target_nominals: target_nominals, records: unit_records, enums: enums, acc: acc } {
        next st = project_record_decl_step<N>(pages, stride, total, st);
    }
    return st.acc;
}
fn project_record_decl_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectRecordDeclWalk) -> (result: ProjectRecordDeclWalk) {
    return match st.rest {
        decl.RecordList.RNil => st,
        decl.RecordList.RCons { head: record_decl, tail: rest } => project_record_decl_cons<N>(pages, stride, total, st, record_decl, rest)
    };
}
fn project_record_decl_cons<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectRecordDeclWalk, record_decl: decl.RecordDecl, rest: decl.RecordList) -> (result: ProjectRecordDeclWalk) {
    let identity: decl.NominalLookup = decl.nominal_identity_by_name<1024, N>(pages, stride, total, st.target_nominals, record_decl.name_start, record_decl.name_end);
    let built_fields: ProjectRecordFields = project_record_fields<N>(pages, stride, total, record_decl.fields, st.records, st.enums, st.markers, st.target_nominals);
    if !(identity.found) { return ProjectRecordDeclWalk { ..st, rest: rest }; }
    let schema: decl.ImportedRecordSchema = decl.ImportedRecordSchema { identity: identity.identity, fields: built_fields.fields };
    return ProjectRecordDeclWalk { rest: rest, markers: st.markers, target_nominals: st.target_nominals, records: st.records, enums: st.enums, acc: decl.ImportedRecordList.IRCons { head: schema, tail: st.acc } };
}
fn project_record_fields<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, fields: decl.FieldList, records: decl.RecordList, enums: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList) -> (result: ProjectRecordFields) {
    iterate i up_to 1024 carrying st: ProjectRecordFieldWalk = ProjectRecordFieldWalk { rest: fields, index: 0, markers: markers, target_nominals: target_nominals, records: records, enums: enums, acc: decl.ImportedRecordFieldList.IRFNil, ok: true } {
        next st = project_record_field_step<N>(pages, stride, total, st);
    }
    let ordered: decl.ImportedRecordFieldList = reverse_project_record_fields(st.acc);
    return ProjectRecordFields { fields: ordered, ok: st.ok };
}
fn project_record_field_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectRecordFieldWalk) -> (result: ProjectRecordFieldWalk) {
    return match st.rest {
        decl.FieldList.FNil => st,
        decl.FieldList.FCons { head: field, tail: rest } => project_record_field_cons<N>(pages, stride, total, st, field, rest)
    };
}
fn project_record_field_cons<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectRecordFieldWalk, field: decl.Field, rest: decl.FieldList) -> (result: ProjectRecordFieldWalk) {
    let resolved: decl.TyRes = decl.resolve_type<1024, N>(pages, stride, total, field.type_kind, field.type_start, field.type_end, st.records, st.enums, st.target_nominals);
    let transported: TypeTransport = transport_type_in_module<1024, N>(pages, stride, total, resolved.ty, st.target_nominals, st.markers);
    let valid: bool = resolved.ok && transported.ok;
    let item: decl.ImportedRecordField = decl.ImportedRecordField { name: decl.signature_name_key<1024, N>(pages, stride, total, field.name_start, field.name_end), index: st.index, ty: transported.ty, type_valid: valid };
    return ProjectRecordFieldWalk { rest: rest, index: st.index + 1, markers: st.markers, target_nominals: st.target_nominals, records: st.records, enums: st.enums, acc: decl.ImportedRecordFieldList.IRFCons { head: item, tail: st.acc }, ok: st.ok && valid };
}
fn reverse_project_record_fields(fields: decl.ImportedRecordFieldList) -> (result: decl.ImportedRecordFieldList) {
    iterate i up_to 1024 carrying st: ProjectRecordFieldReverse = ProjectRecordFieldReverse { rest: fields, acc: decl.ImportedRecordFieldList.IRFNil } {
        next st = reverse_project_record_field_step(st);
    }
    return st.acc;
}
fn reverse_project_record_field_step(st: ProjectRecordFieldReverse) -> (result: ProjectRecordFieldReverse) {
    return match st.rest {
        decl.ImportedRecordFieldList.IRFNil => st,
        decl.ImportedRecordFieldList.IRFCons { head: field, tail: rest } => ProjectRecordFieldReverse { rest: rest, acc: decl.ImportedRecordFieldList.IRFCons { head: field, tail: st.acc } }
    };
}

fn project_enum_schemas<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, nominal_modules: NominalModuleList, markers: decl.NominalTypeIdentityList) -> (result: decl.ImportedEnumList) {
    iterate i up_to 64 carrying st: ProjectEnumWalk = ProjectEnumWalk { rest: modules, nominal_modules: nominal_modules, markers: markers, acc: decl.ImportedEnumList.IENil } { next st = project_enum_module_step<M, N>(sources, flat_pages, st); }
    return st.acc;
}
fn project_enum_module_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectEnumWalk) -> (result: ProjectEnumWalk) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => project_enum_module_cons<M, N>(sources, flat_pages, st, parsed, rest)
    };
}
fn project_enum_module_cons<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectEnumWalk, parsed: ParsedModule, rest: ModuleList) -> (result: ProjectEnumWalk) {
    let pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let stride: u64 = module_stride(sources, parsed.source_index);
    let total: u64 = module_total(sources, parsed.source_index);
    let facts: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, st.nominal_modules, parsed.source_index);
    let target_nominals: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(pages, stride, total, st.markers, facts.facts.resolved);
    let schemas: decl.ImportedEnumList = project_enum_decls<N>(pages, stride, total, parsed.unit.enums, parsed.unit.records, parsed.unit.enums, st.markers, target_nominals, st.acc);
    return ProjectEnumWalk { rest: rest, nominal_modules: st.nominal_modules, markers: st.markers, acc: schemas };
}
fn project_enum_decls<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, enums: decl.EnumList, records: decl.RecordList, unit_enums: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, acc: decl.ImportedEnumList) -> (result: decl.ImportedEnumList) {
    iterate i up_to 1024 carrying st: ProjectEnumDeclWalk = ProjectEnumDeclWalk { rest: enums, markers: markers, target_nominals: target_nominals, records: records, enums: unit_enums, acc: acc } { next st = project_enum_decl_step<N>(pages, stride, total, st); }
    return st.acc;
}
fn project_enum_decl_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumDeclWalk) -> (result: ProjectEnumDeclWalk) {
    return match st.rest {
        decl.EnumList.GNil => st,
        decl.EnumList.GCons { head: enum_decl, tail: rest } => project_enum_decl_cons<N>(pages, stride, total, st, enum_decl, rest)
    };
}
fn project_enum_decl_cons<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumDeclWalk, enum_decl: decl.EnumDecl, rest: decl.EnumList) -> (result: ProjectEnumDeclWalk) {
    let identity: decl.NominalLookup = decl.nominal_identity_by_name<1024, N>(pages, stride, total, st.target_nominals, enum_decl.name_start, enum_decl.name_end);
    let built: ProjectEnumVariantBuild = project_enum_variants<N>(pages, stride, total, enum_decl.variants, st.records, st.enums, st.markers, st.target_nominals);
    if !(identity.found) { return ProjectEnumDeclWalk { ..st, rest: rest }; }
    let schema: decl.ImportedEnumSchema = decl.ImportedEnumSchema { identity: identity.identity, variants: built.variants };
    return ProjectEnumDeclWalk { rest: rest, markers: st.markers, target_nominals: st.target_nominals, records: st.records, enums: st.enums, acc: decl.ImportedEnumList.IECons { head: schema, tail: st.acc } };
}
fn project_enum_variants<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, variants: decl.VariantList, records: decl.RecordList, enums: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList) -> (result: ProjectEnumVariantBuild) {
    let seed: ProjectEnumVariantWalk = ProjectEnumVariantWalk { rest: variants, markers: markers, target_nominals: target_nominals, records: records, enums: enums, acc: decl.ImportedEnumVariantList.IEVNil, ok: true };
    iterate i up_to 1024 carrying st: ProjectEnumVariantWalk = seed { next st = project_enum_variant_step<N>(pages, stride, total, st); }
    return ProjectEnumVariantBuild { variants: reverse_project_enum_variants(st.acc), ok: st.ok };
}
fn project_enum_variant_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumVariantWalk) -> (result: ProjectEnumVariantWalk) {
    return match st.rest {
        decl.VariantList.VNil => st,
        decl.VariantList.VCons { head: variant, tail: rest } => project_enum_variant_cons<N>(pages, stride, total, st, variant, rest)
    };
}
fn project_enum_variant_cons<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumVariantWalk, variant: decl.Variant, rest: decl.VariantList) -> (result: ProjectEnumVariantWalk) {
    let built: ProjectEnumFields = project_enum_fields<N>(pages, stride, total, variant.fields, st.records, st.enums, st.markers, st.target_nominals);
    let item: decl.ImportedEnumVariant = decl.ImportedEnumVariant { name: decl.signature_name_key<1024, N>(pages, stride, total, variant.name_start, variant.name_end), fields: built.fields };
    return ProjectEnumVariantWalk { rest: rest, markers: st.markers, target_nominals: st.target_nominals, records: st.records, enums: st.enums, acc: decl.ImportedEnumVariantList.IEVCons { head: item, tail: st.acc }, ok: st.ok && built.ok };
}
fn project_enum_fields<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, fields: decl.FieldList, records: decl.RecordList, enums: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList) -> (result: ProjectEnumFields) {
    let seed: ProjectEnumFieldWalk = ProjectEnumFieldWalk { rest: fields, index: 0, markers: markers, target_nominals: target_nominals, records: records, enums: enums, acc: decl.ImportedEnumFieldList.IEFNil, ok: true };
    iterate i up_to 1024 carrying st: ProjectEnumFieldWalk = seed { next st = project_enum_field_step<N>(pages, stride, total, st); }
    return ProjectEnumFields { fields: reverse_project_enum_fields(st.acc), ok: st.ok };
}
fn project_enum_field_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumFieldWalk) -> (result: ProjectEnumFieldWalk) {
    return match st.rest {
        decl.FieldList.FNil => st,
        decl.FieldList.FCons { head: field, tail: rest } => project_enum_field_cons<N>(pages, stride, total, st, field, rest)
    };
}
fn project_enum_field_cons<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumFieldWalk, field: decl.Field, rest: decl.FieldList) -> (result: ProjectEnumFieldWalk) {
    let resolved: decl.TyRes = decl.resolve_type<1024, N>(pages, stride, total, field.type_kind, field.type_start, field.type_end, st.records, st.enums, st.target_nominals);
    let transported: TypeTransport = transport_type_in_module<1024, N>(pages, stride, total, resolved.ty, st.target_nominals, st.markers);
    let valid: bool = resolved.ok && transported.ok;
    let item: decl.ImportedEnumField = decl.ImportedEnumField { name: decl.signature_name_key<1024, N>(pages, stride, total, field.name_start, field.name_end), index: st.index, ty: transported.ty, type_valid: valid };
    return ProjectEnumFieldWalk { rest: rest, index: st.index + 1, markers: st.markers, target_nominals: st.target_nominals, records: st.records, enums: st.enums, acc: decl.ImportedEnumFieldList.IEFCons { head: item, tail: st.acc }, ok: st.ok && valid };
}
fn reverse_project_enum_fields(fields: decl.ImportedEnumFieldList) -> (result: decl.ImportedEnumFieldList) {
    iterate i up_to 1024 carrying st: ProjectEnumFieldReverse = ProjectEnumFieldReverse { rest: fields, acc: decl.ImportedEnumFieldList.IEFNil } { next st = reverse_project_enum_field_step(st); }
    return st.acc;
}
fn reverse_project_enum_field_step(st: ProjectEnumFieldReverse) -> (result: ProjectEnumFieldReverse) {
    return match st.rest {
        decl.ImportedEnumFieldList.IEFNil => st,
        decl.ImportedEnumFieldList.IEFCons { head: field, tail: rest } => ProjectEnumFieldReverse { rest: rest, acc: decl.ImportedEnumFieldList.IEFCons { head: field, tail: st.acc } }
    };
}
fn reverse_project_enum_variants(variants: decl.ImportedEnumVariantList) -> (result: decl.ImportedEnumVariantList) {
    iterate i up_to 1024 carrying st: ProjectEnumVariantReverse = ProjectEnumVariantReverse { rest: variants, acc: decl.ImportedEnumVariantList.IEVNil } { next st = reverse_project_enum_variant_step(st); }
    return st.acc;
}
fn reverse_project_enum_variant_step(st: ProjectEnumVariantReverse) -> (result: ProjectEnumVariantReverse) {
    return match st.rest {
        decl.ImportedEnumVariantList.IEVNil => st,
        decl.ImportedEnumVariantList.IEVCons { head: variant, tail: rest } => ProjectEnumVariantReverse { rest: rest, acc: decl.ImportedEnumVariantList.IEVCons { head: variant, tail: st.acc } }
    };
}

record ProjectBuild { rest: ModuleList, all: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, nominal_markers: decl.NominalTypeIdentityList, imported_records: decl.ImportedRecordList, imported_enums: decl.ImportedEnumList, acc: ProjectModuleList, valid: bool, ssa_valid: bool, count: u64, failed: StageFailure, target_missing: bool }
record ProjectBuildRev { rest: ProjectModuleList, acc: ProjectModuleList }
fn begin_project_lowering(modules: ModuleList, imports: ImportList, nominal_modules: NominalModuleList) -> (result: ProjectBuild) {
    return begin_project_lowering_with_schemas(modules, imports, nominal_modules, decl.NominalTypeIdentityList.NINil, decl.ImportedRecordList.IRNil, decl.ImportedEnumList.IENil);
}
fn begin_project_lowering_with_schemas(modules: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, nominal_markers: decl.NominalTypeIdentityList, imported_records: decl.ImportedRecordList, imported_enums: decl.ImportedEnumList) -> (result: ProjectBuild) {
    return ProjectBuild { rest: modules, all: modules, imports: imports, nominal_modules: nominal_modules, nominal_markers: nominal_markers, imported_records: imported_records, imported_enums: imported_enums, acc: ProjectModuleList.PNil, valid: true, ssa_valid: true, count: 0, failed: StageFailure { stage: 0, source_index: 0, code: 0, start: 0, end: 0 }, target_missing: false };
}
fn lower_project_modules<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, imports: ImportList, nominal_modules: NominalModuleList) -> (result: ProjectBuild) {
    let markers: decl.NominalTypeIdentityList = project_nominal_markers(nominal_modules);
    let imported_records: decl.ImportedRecordList = project_record_schemas<M, N>(sources, flat_pages, modules, nominal_modules, markers);
    let imported_enums: decl.ImportedEnumList = project_enum_schemas<M, N>(sources, flat_pages, modules, nominal_modules, markers);
    let initial: ProjectBuild = begin_project_lowering_with_schemas(modules, imports, nominal_modules, markers, imported_records, imported_enums);
    iterate i over sources carrying st: ProjectBuild = initial {
        next st = lower_project_one<M, N>(sources, flat_pages, st);
    }
    iterate i over sources carrying rev: ProjectBuildRev = ProjectBuildRev { rest: st.acc, acc: ProjectModuleList.PNil } {
        next rev = reverse_project_build(rev);
    }
    return ProjectBuild { rest: ModuleList.MNil, all: modules, imports: imports, nominal_modules: nominal_modules, nominal_markers: markers, imported_records: imported_records, imported_enums: imported_enums, acc: rev.acc, valid: st.valid, ssa_valid: st.ssa_valid, count: st.count, failed: st.failed, target_missing: false };
}
fn lower_project_modules_for_source<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, target_source_index: u64) -> (result: ProjectBuild) {
    let selected: TargetModuleSelection = select_target_module(modules, target_source_index);
    let dependency_indices: ProjectIndexList = project_import_closure(imports, target_source_index);
    let dependency_modules: ModuleList = project_modules_in_closure<64>(sources, modules, dependency_indices);
    return lower_project_modules_selected<M, N>(sources, flat_pages, modules, selected.selected, imports, nominal_modules, dependency_modules, selected.found);
}

// Resolve the target's transitive import closure for schema construction.
// Import signatures and source diagnostics still use the complete project;
// only record and enum schemas are restricted to modules that can affect the
// selected module. Each module admits at most 1024 uses, while the project
// retains at most 4096 resolved links. Repeated passes handle source ordering
// and cycles within that project-wide bound.
fn project_import_closure(imports: ImportList, target_source_index: u64) -> (result: ProjectIndexList) {
    let first: ProjectImportClosure = ProjectImportClosure { indices: ProjectIndexList.PICons { head: target_source_index, tail: ProjectIndexList.PINil }, changed: true };
    iterate i up_to 64 carrying st: ProjectImportClosure = first {
        if !(st.changed) { return st.indices; }
        next st = project_import_closure_round(imports, st.indices);
    }
    return st.indices;
}
fn project_import_closure_round(imports: ImportList, indices: ProjectIndexList) -> (result: ProjectImportClosure) {
    let first: ProjectImportClosureWalk = project_import_closure_part(ProjectImportClosureWalk { rest: imports, indices: indices, changed: false });
    let second: ProjectImportClosureWalk = project_import_closure_part(first);
    let third: ProjectImportClosureWalk = project_import_closure_part(second);
    let fourth: ProjectImportClosureWalk = project_import_closure_part(third);
    return ProjectImportClosure { indices: fourth.indices, changed: fourth.changed };
}
fn project_import_closure_part(initial: ProjectImportClosureWalk) -> (result: ProjectImportClosureWalk) {
    iterate i up_to 1024 carrying st: ProjectImportClosureWalk = initial {
        if import_list_empty(st.rest) { return st; }
        next st = project_import_closure_link(st);
    }
    return st;
}
fn import_list_empty(imports: ImportList) -> (result: bool) {
    return match imports { INil => true, ICons { head: link, tail: rest } => false };
}
fn project_import_closure_link(st: ProjectImportClosureWalk) -> (result: ProjectImportClosureWalk) {
    return match st.rest {
        INil => st,
        ICons { head: link, tail: rest } => project_import_closure_link_one(st, link, rest)
    };
}
fn project_import_closure_link_one(st: ProjectImportClosureWalk, link: ImportLink, rest: ImportList) -> (result: ProjectImportClosureWalk) {
    let reachable: bool = project_index_contains(st.indices, link.source_index);
    if !(reachable) { return ProjectImportClosureWalk { rest: rest, indices: st.indices, changed: st.changed }; }
    let already_included: bool = project_index_contains(st.indices, link.target_index);
    if already_included { return ProjectImportClosureWalk { rest: rest, indices: st.indices, changed: st.changed }; }
    return ProjectImportClosureWalk {
        rest: rest,
        indices: ProjectIndexList.PICons { head: link.target_index, tail: st.indices },
        changed: true
    };
}
fn project_index_contains(indices: ProjectIndexList, wanted: u64) -> (result: bool) {
    iterate i up_to 64 carrying st: ProjectIndexContains = ProjectIndexContains { rest: indices, wanted: wanted, found: false } {
        if st.found { return true; }
        next st = project_index_contains_step(st);
    }
    return st.found;
}
fn project_index_contains_step(st: ProjectIndexContains) -> (result: ProjectIndexContains) {
    return match st.rest {
        PINil => st,
        PICons { head: index, tail: rest } => project_index_contains_one(st, index, rest)
    };
}
fn project_index_contains_one(st: ProjectIndexContains, index: u64, rest: ProjectIndexList) -> (result: ProjectIndexContains) {
    if index == st.wanted { return ProjectIndexContains { rest: ProjectIndexList.PINil, wanted: st.wanted, found: true }; }
    return ProjectIndexContains { rest: rest, wanted: st.wanted, found: false };
}
fn project_modules_in_closure<M: Nat>(sources: [ProjectSource; up_to M], modules: ModuleList, indices: ProjectIndexList) -> (result: ModuleList) {
    iterate i over sources carrying st: ProjectModuleClosureFilter = ProjectModuleClosureFilter { rest: modules, indices: indices, acc: ModuleList.MNil } {
        if module_list_empty(st.rest) { return reverse_modules<M>(sources, st.acc); }
        next st = project_module_closure_filter_step(st);
    }
    return reverse_modules<M>(sources, st.acc);
}
fn project_module_closure_filter_step(st: ProjectModuleClosureFilter) -> (result: ProjectModuleClosureFilter) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => project_module_closure_filter_one(st, parsed, rest)
    };
}
fn project_module_closure_filter_one(st: ProjectModuleClosureFilter, parsed: ParsedModule, rest: ModuleList) -> (result: ProjectModuleClosureFilter) {
    let included: bool = project_index_contains(st.indices, parsed.source_index);
    if !(included) { return ProjectModuleClosureFilter { rest: rest, indices: st.indices, acc: st.acc }; }
    return ProjectModuleClosureFilter { rest: rest, indices: st.indices, acc: ModuleList.MCons { head: parsed, tail: st.acc } };
}

fn lower_project_modules_selected<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all_modules: ModuleList, to_lower: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, dependency_modules: ModuleList, target_found: bool) -> (result: ProjectBuild) {
    let markers: decl.NominalTypeIdentityList = project_nominal_markers(nominal_modules);
    let imported_records: decl.ImportedRecordList = project_record_schemas<M, N>(sources, flat_pages, dependency_modules, nominal_modules, markers);
    let imported_enums: decl.ImportedEnumList = project_enum_schemas<M, N>(sources, flat_pages, dependency_modules, nominal_modules, markers);
    let initial: ProjectBuild = begin_project_lowering_for_modules(to_lower, all_modules, imports, nominal_modules, markers, imported_records, imported_enums, target_found);
    iterate i over sources carrying st: ProjectBuild = initial {
        next st = lower_project_one<M, N>(sources, flat_pages, st);
    }
    iterate i over sources carrying rev: ProjectBuildRev = ProjectBuildRev { rest: st.acc, acc: ProjectModuleList.PNil } {
        next rev = reverse_project_build(rev);
    }
    return ProjectBuild { rest: ModuleList.MNil, all: all_modules, imports: imports, nominal_modules: nominal_modules, nominal_markers: markers, imported_records: imported_records, imported_enums: imported_enums, acc: rev.acc, valid: st.valid, ssa_valid: st.ssa_valid, count: st.count, failed: st.failed, target_missing: st.target_missing };
}
fn select_target_module(modules: ModuleList, target_source_index: u64) -> (result: TargetModuleSelection) {
    iterate i up_to 64 carrying st: TargetModuleSelection = TargetModuleSelection { rest: modules, selected: ModuleList.MNil, target_source_index: target_source_index, found: false } {
        if st.found || module_list_empty(st.rest) { return st; }
        next st = select_target_module_step(st);
    }
    return st;
}
fn module_list_empty(modules: ModuleList) -> (result: bool) {
    return match modules { MNil => true, MCons { head: parsed, tail: rest } => false };
}
fn select_target_module_step(st: TargetModuleSelection) -> (result: TargetModuleSelection) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => select_target_module_one(st, parsed, rest)
    };
}
fn select_target_module_one(st: TargetModuleSelection, parsed: ParsedModule, rest: ModuleList) -> (result: TargetModuleSelection) {
    if parsed.source_index == st.target_source_index { return TargetModuleSelection { rest: rest, selected: ModuleList.MCons { head: parsed, tail: ModuleList.MNil }, target_source_index: st.target_source_index, found: true }; }
    return TargetModuleSelection { rest: rest, selected: st.selected, target_source_index: st.target_source_index, found: false };
}
fn begin_project_lowering_for_modules(rest: ModuleList, all: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, nominal_markers: decl.NominalTypeIdentityList, imported_records: decl.ImportedRecordList, imported_enums: decl.ImportedEnumList, target_found: bool) -> (result: ProjectBuild) {
    return ProjectBuild { rest: rest, all: all, imports: imports, nominal_modules: nominal_modules, nominal_markers: nominal_markers, imported_records: imported_records, imported_enums: imported_enums, acc: ProjectModuleList.PNil, valid: target_found, ssa_valid: target_found, count: 0, failed: StageFailure { stage: 0, source_index: 0, code: 0, start: 0, end: 0 }, target_missing: !(target_found) };
}
fn lower_project_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectBuild) -> (result: ProjectBuild) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => lower_one_project_module<M, N>(sources, flat_pages, st, parsed, rest)
    };
}
fn lower_one_project_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectBuild, parsed: ParsedModule, rest: ModuleList) -> (result: ProjectBuild) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let input_stride: u64 = module_stride(sources, parsed.source_index);
    let input_total: u64 = module_total(sources, parsed.source_index);
    let facts: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, st.nominal_modules, parsed.source_index);
    let nominals: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(input_pages, input_stride, input_total, st.nominal_markers, facts.facts.resolved);
    let imported: decl.SigTab = imported_signatures<M, N>(sources, flat_pages, parsed, st.all, nominals, st.nominal_modules);
    let proof: decl.UnitProve = decl.prove_parsed_unit_with_imported_schemas<1024, N>(input_pages, input_stride, input_total, parsed.unit, imported, nominals, st.imported_records, st.imported_enums);
    let lowered: flow.LoweredUnit = flow.lower_proven_unit<1024, N>(input_pages, input_stride, input_total, proof);
    let value_ssa: ssa.ValueSsaSummary = ssa.lower_value_ssa_with_imported_schemas<1024, N>(input_pages, input_stride, input_total, lowered, nominals, st.imported_records, st.imported_enums);
    return ProjectBuild {
        rest: rest,
        all: st.all,
        imports: st.imports,
        nominal_modules: st.nominal_modules,
        nominal_markers: st.nominal_markers,
        imported_records: st.imported_records,
        imported_enums: st.imported_enums,
        acc: ProjectModuleList.PCons { head: ProjectModule { source_id: parsed.source_id, source_path: parsed.source_path, source_index: parsed.source_index, flow: lowered, value_ssa: value_ssa }, tail: st.acc },
        valid: st.valid && lowered.valid,
        ssa_valid: st.ssa_valid && value_ssa.valid,
        count: st.count + 1,
        failed: lower_stage_failure(st.failed, parsed.source_index, proof, lowered),
        target_missing: st.target_missing
    };
}
fn lower_stage_failure(prior: StageFailure, source_index: u64, proof: decl.UnitProve, lowered: flow.LoweredUnit) -> (result: StageFailure) {
    if prior.stage != 0 { return prior; }
    if !(proof.ok) { return StageFailure { stage: 2, source_index: source_index, code: 0, start: proof.err_start, end: proof.err_end }; }
    if !(lowered.valid) {
        let diag: flow.Diagnostic = flow.first_diagnostic(lowered);
        return StageFailure { stage: 3, source_index: source_index, code: diag.code, start: diag.start, end: diag.end };
    }
    return prior;
}
fn reverse_project_build(st: ProjectBuildRev) -> (result: ProjectBuildRev) {
    return match st.rest {
        PNil => st,
        PCons { head: built_module, tail: rest } => ProjectBuildRev { rest: rest, acc: ProjectModuleList.PCons { head: built_module, tail: st.acc } }
    };
}

// The first failing stage explains itself: a parse/proof/flow/SSA failure
// always carries its module and span or unsupported anchor, so a project
// result is never invalid without a reason.
fn append_stage_diagnostic<M: Nat>(sources: [ProjectSource; up_to M], diagnostics: DiagnosticList, built: ModuleBuild, failed: StageFailure) -> (result: DiagnosticList) {
    if built.parse_failed { return DiagnosticList.DiagCons { head: ProjectDiagnostic.ParseFailed { source_index: built.parse_index, start: built.parse_start, end: built.parse_end }, tail: diagnostics }; }
    if failed.stage == 0 { return diagnostics; }
    if failed.stage == 2 { return DiagnosticList.DiagCons { head: ProjectDiagnostic.ProofFailed { source_index: failed.source_index, start: failed.start, end: failed.end }, tail: diagnostics }; }
    return DiagnosticList.DiagCons { head: ProjectDiagnostic.FlowFailed { source_index: failed.source_index, code: failed.code, start: failed.start, end: failed.end }, tail: diagnostics };
}
fn append_target_missing(diagnostics: DiagnosticList, target_missing: bool, target_source_index: u64, target_only: bool) -> (result: DiagnosticList) {
    if target_only && target_missing { return DiagnosticList.DiagCons { head: ProjectDiagnostic.TargetModuleMissing { source_index: target_source_index }, tail: diagnostics }; }
    return diagnostics;
}

fn compile_project<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M]) -> (result: ProjectResult) {
    let ordered: bool = source_ordered<64>(snapshot.sources);
    // CP-0021: the per-module page descriptors must partition the flat
    // page array in source order; a gap, overlap, or trailing page fails
    // the project exactly like the old source/view count mismatch did.
    let counts_match: bool = descriptors_cover<M, N>(snapshot.sources, flat_pages);
    let built: ModuleBuild = build_modules<M, N>(snapshot.sources, flat_pages, 0, false);
    let parsed: ModuleList = reverse_modules<64>(snapshot.sources, built.acc);
    let duplicate: DiagnosticList = duplicate_modules<M, N>(snapshot.sources, flat_pages, parsed);
    let resolved: Resolution = resolve_imports<M, N>(snapshot.sources, flat_pages, parsed);
    let local_nominals: NominalModuleList = collect_local_nominal_modules<M, N>(snapshot.sources, flat_pages, parsed);
    let nominal_modules: NominalModuleList = resolve_project_nominal_modules<M, N>(snapshot.sources, flat_pages, parsed, local_nominals);
    let lowered: ProjectBuild = lower_project_modules<M, N>(snapshot.sources, flat_pages, parsed, resolved.imports, nominal_modules);
    let basic: DiagnosticList = order_diagnostics<64>(snapshot.sources, ordered, counts_match);
    let diagnostics1: DiagnosticList = append_diagnostics<64>(snapshot.sources, basic, duplicate);
    let diagnostics2: DiagnosticList = append_diagnostics<64>(snapshot.sources, diagnostics1, resolved.diagnostics);
    let diagnostics: DiagnosticList = append_stage_diagnostic<64>(snapshot.sources, diagnostics2, built, lowered.failed);
    // The host-provided fingerprint is advisory metadata only. This native
    // project pass has not recomputed its digest over the supplied snapshot.
    let valid: bool = ordered && counts_match && built.valid && diagnostics_empty<64>(snapshot.sources, diagnostics) && resolved.valid && lowered.valid;
    return ProjectResult {
        valid: valid,
        fingerprint: snapshot.fingerprint,
        fingerprint_authenticated: false,
        value_ssa_valid: lowered.ssa_valid && resolved.valid,
        source_count: snapshot.sources.len,
        module_count: built.count,
        import_count: resolved.count,
        import_module_name_comparisons: resolved.import_module_name_comparisons,
        import_resolution_cache_hits: resolved.import_resolution_cache_hits,
        import_resolution_negative_cache_hits: resolved.import_resolution_negative_cache_hits,
        import_resolution_cache_entries_max: resolved.import_resolution_cache_entries_max,
        modules: lowered.acc,
        imports: resolved.imports,
        diagnostics: diagnostics
    };
}
// Compile one ordered snapshot source through proof, CFG, and verified SSA
// while retaining every module as an import, nominal, and record-schema
// provider. `target_source_index` indexes the ordered source descriptors.
fn compile_project_target<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], target_source_index: u64) -> (result: ProjectResult) {
    let ordered: bool = source_ordered<64>(snapshot.sources);
    let counts_match: bool = descriptors_cover<M, N>(snapshot.sources, flat_pages);
    // Parse target bodies for lowering; parse provider bodies fully for the
    // same syntax diagnostics, then retain only their import signatures.
    let built: ModuleBuild = build_modules<M, N>(snapshot.sources, flat_pages, target_source_index, true);
    let parsed: ModuleList = reverse_modules<64>(snapshot.sources, built.acc);
    let duplicate: DiagnosticList = duplicate_modules<M, N>(snapshot.sources, flat_pages, parsed);
    let resolved: Resolution = resolve_imports<M, N>(snapshot.sources, flat_pages, parsed);
    let local_nominals: NominalModuleList = collect_local_nominal_modules<M, N>(snapshot.sources, flat_pages, parsed);
    let nominal_modules: NominalModuleList = resolve_project_nominal_modules<M, N>(snapshot.sources, flat_pages, parsed, local_nominals);
    let lowered: ProjectBuild = lower_project_modules_for_source<M, N>(snapshot.sources, flat_pages, parsed, resolved.imports, nominal_modules, target_source_index);
    let basic: DiagnosticList = order_diagnostics<64>(snapshot.sources, ordered, counts_match);
    let diagnostics1: DiagnosticList = append_diagnostics<64>(snapshot.sources, basic, duplicate);
    let diagnostics2: DiagnosticList = append_diagnostics<64>(snapshot.sources, diagnostics1, resolved.diagnostics);
    let diagnostics3: DiagnosticList = append_stage_diagnostic<64>(snapshot.sources, diagnostics2, built, lowered.failed);
    let diagnostics: DiagnosticList = append_target_missing(diagnostics3, lowered.target_missing, target_source_index, true);
    let valid: bool = ordered && counts_match && built.valid && diagnostics_empty<64>(snapshot.sources, diagnostics) && resolved.valid && lowered.valid && !(lowered.target_missing);
    return ProjectResult {
        valid: valid,
        fingerprint: snapshot.fingerprint,
        fingerprint_authenticated: false,
        value_ssa_valid: lowered.ssa_valid && resolved.valid && !(lowered.target_missing),
        source_count: snapshot.sources.len,
        module_count: built.count,
        import_count: resolved.count,
        import_module_name_comparisons: resolved.import_module_name_comparisons,
        import_resolution_cache_hits: resolved.import_resolution_cache_hits,
        import_resolution_negative_cache_hits: resolved.import_resolution_negative_cache_hits,
        import_resolution_cache_entries_max: resolved.import_resolution_cache_entries_max,
        modules: lowered.acc,
        imports: resolved.imports,
        diagnostics: diagnostics
    };
}

// Compile the selected source and project its current diagnostics into source
// positions in one native call. ProjectResult remains byte-span authoritative;
// callers can refresh locations from the exact source pages used here.
fn compile_project_target_with_diagnostic_locations<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], target_source_index: u64) -> (result: ProjectResultWithDiagnosticLocations) {
    let sources: [ProjectSource; up_to 64] = snapshot.sources;
    let compiled: ProjectResult = compile_project_target<M, N>(snapshot, flat_pages, target_source_index);
    let locations: ProjectDiagnosticLocationList = locate_project_diagnostics_global<M, N>(sources, flat_pages, compiled.diagnostics);
    return ProjectResultWithDiagnosticLocations { result: compiled, diagnostic_locations: locations };
}
