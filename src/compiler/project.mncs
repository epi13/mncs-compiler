mncs 0.19;
module mncs.compiler.project.v1;
use mncs.compiler.decl.v1 as decl;
use mncs.compiler.flow.v1 as flow;
use mncs.compiler.ssa.v1 as ssa;
use mncs.compiler.source.v1 as source;

// Host filesystem discovery is an adapter boundary. The native compiler
// receives stable path metadata plus exact per-file byte sequences and owns
// module identity, import matching, semantic proof, and CFG construction.
// The source count is bounded at 64; each file's actual byte bound is a
// compile-time sequence parameter rather than a fixed project-wide buffer.
record ProjectSource {
    source_id: [byte; up_to 256],
    source_path: [byte; up_to 256],
    page_start: u64,
    page_count: u64,
    stride: u64,
    total: u64
}
record ProjectSnapshot {
    fingerprint: [byte; up_to 64],
    sources: [ProjectSource; up_to 64]
}

// CP-0021: every module's bytes live in one flat page array; each
// ProjectSource descriptor selects its module's logical source slice
// (page_start, page_count) plus its (stride, total) addressing. Slices
// are validated by the declaration gate on first parse; the project
// entry additionally requires the descriptors to partition the flat
// array in source order (no gaps, overlaps, or trailing pages).
fn module_pages<P: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to P], index: u64) -> (result: [[byte; up_to N]; up_to 1024]) {
    // Total on hostile descriptors: out-of-range slices degrade to the
    // empty slice, which the declaration validation gate (or the header
    // parse for total 0) fails closed. Callers pass indices derived from
    // guarded construction (build loop, ParsedModule owners), never raw
    // transport integers, so sources[index] itself cannot trap.
    let meta: ProjectSource = sources[index];
    if meta.page_start > flat_pages.len { return flat_pages[0..0]; }
    if meta.page_count > flat_pages.len - meta.page_start { return flat_pages[0..0]; }
    return flat_pages[meta.page_start..meta.page_start + meta.page_count];
}
fn module_stride(sources: [ProjectSource; up_to 64], index: u64) -> (result: u64) {
    let meta: ProjectSource = sources[index];
    return meta.stride;
}
fn module_total(sources: [ProjectSource; up_to 64], index: u64) -> (result: u64) {
    let meta: ProjectSource = sources[index];
    return meta.total;
}
record CoverState { index: u64, cursor: u64, ok: bool }
fn descriptors_cover<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M]) -> (result: bool) {
    iterate i over sources carrying st: CoverState = CoverState { index: 0, cursor: 0, ok: true } {
        next st = cover_step(sources, st);
    }
    return st.ok && st.cursor == flat_pages.len;
}
fn cover_step(sources: [ProjectSource; up_to 64], st: CoverState) -> (result: CoverState) {
    if !(st.ok) || st.index >= sources.len { return st; }
    let meta: ProjectSource = sources[st.index];
    if meta.page_start != st.cursor { return CoverState { index: st.index + 1, cursor: st.cursor, ok: false }; }
    return CoverState { index: st.index + 1, cursor: st.cursor + meta.page_count, ok: true };
}

record ParsedModule {
    source_id: [byte; up_to 256],
    source_path: [byte; up_to 256],
    source_index: u64,
    unit: decl.Unit
}
enum ModuleList { MNil, MCons { head: ParsedModule, tail: ModuleList } }
record ModuleReverse { rest: ModuleList, acc: ModuleList }
record TargetModuleSelection { rest: ModuleList, selected: ModuleList, target_source_index: u64, found: bool }
// First parse/proof/flow failure across project modules. stage: 0 none,
// 2 proof, 3 flow (parse failures ride ModuleBuild). Proof carries the unit
// error span; flow carries the first flow diagnostic. Value-SSA unsupported
// anchors stay in the module summary: SSA failure must not flip project
// `valid`, which is a parse/proof/flow verdict.
record StageFailure { stage: u64, source_index: u64, code: u64, start: u64, end: u64 }
record NominalModule { source_index: u64, local: decl.NominalTypeIdentityList, resolved: decl.NominalTypeIdentityList }
enum NominalModuleList { NMNil, NMCons { head: NominalModule, tail: NominalModuleList } }
record NominalModuleBuild { rest: ModuleList, acc: NominalModuleList }
record NominalModuleLookup { rest: NominalModuleList, source_index: u64, found: bool, facts: NominalModule }
record NominalResolutionBuild { rest: ModuleList, all: ModuleList, locals: NominalModuleList, acc: NominalModuleList }
record ProjectNominalIdentityWalk { rest: decl.NominalTypeIdentityList, acc: decl.NominalTypeIdentityList, count: u64 }
record ProjectNominalModuleWalk { rest: NominalModuleList, acc: decl.NominalTypeIdentityList, count: u64 }
record ProjectNominalContains { rest: decl.NominalTypeIdentityList, wanted: decl.SemanticIdentity, found: bool }
record NominalModuleClosureFilter { rest: NominalModuleList, reachable: [bool; 64], acc: NominalModuleList }
record NominalMarkerLookup { rest: decl.NominalTypeIdentityList, start: u64, end: u64, found: bool, marker: decl.NominalTypeIdentity }
record NominalMarkerByIdLookup { rest: decl.NominalTypeIdentityList, wanted: decl.SemanticIdentity, found: bool, marker: decl.NominalTypeIdentity }
record MarkerAddResult { markers: decl.NominalTypeIdentityList, added: bool }
record SeedNominalMarkerWalk { rest: decl.NominalTypeIdentityList, all_markers: decl.NominalTypeIdentityList, wanted: decl.NominalTypeIdentityList }
record SeedSigTabMarkerWalk { rest: decl.SigTab, all_markers: decl.NominalTypeIdentityList, wanted: decl.NominalTypeIdentityList }
record SeedBindMarkerWalk { rest: decl.BindList, all_markers: decl.NominalTypeIdentityList, wanted: decl.NominalTypeIdentityList }
record ProviderFnBuckets { source_index: u64, buckets: [decl.FnList; 64] }
enum ProviderFnBucketsList { PFBNil, PFBCons { head: ProviderFnBuckets, tail: ProviderFnBucketsList } }
record FnBucketsWalk { rest: decl.FnList, buckets: [decl.FnList; 64] }
record ProviderFnBucketsBuild { rest: ModuleList, acc: ProviderFnBucketsList }
record TargetNominalBuckets { source_index: u64, buckets: [decl.NominalTypeIdentityList; 64] }
enum TargetNominalBucketsList { TNBNil, TNBCons { head: TargetNominalBuckets, tail: TargetNominalBucketsList } }
record ResolvedUseTarget { target_index: u64, has_alias: bool, prefix_start: u64, prefix_end: u64 }
enum ResolvedUseTargetList { RUTNil, RUTCons { head: ResolvedUseTarget, tail: ResolvedUseTargetList } }
record TargetSchemaState { wanted_markers: decl.NominalTypeIdentityList, records: decl.ImportedRecordList, enums: decl.ImportedEnumList, provider_nominals: NominalModuleList, provider_fn_buckets: ProviderFnBucketsList, provider_nominal_buckets: TargetNominalBucketsList, changed: bool }
record TargetSchemaModuleWalk { rest: ModuleList, nominal_modules: NominalModuleList, all_markers: decl.NominalTypeIdentityList, state: TargetSchemaState }
record TargetSchemaRecordWalk { rest: decl.RecordList, local: decl.NominalTypeIdentityList, all_markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, unit_records: decl.RecordList, unit_enums: decl.EnumList, state: TargetSchemaState }
record TargetSchemaEnumWalk { rest: decl.EnumList, local: decl.NominalTypeIdentityList, all_markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, unit_records: decl.RecordList, unit_enums: decl.EnumList, state: TargetSchemaState }
record RecordFieldMarkerWalk { rest: decl.ImportedRecordFieldList, all_markers: decl.NominalTypeIdentityList, result: MarkerAddResult }
record EnumVariantMarkerWalk { rest: decl.ImportedEnumVariantList, all_markers: decl.NominalTypeIdentityList, result: MarkerAddResult }
record EnumFieldMarkerWalk { rest: decl.ImportedEnumFieldList, all_markers: decl.NominalTypeIdentityList, result: MarkerAddResult }
record ImportedRecordHasWalk { rest: decl.ImportedRecordList, wanted: decl.SemanticIdentity, found: bool }
record ImportedEnumHasWalk { rest: decl.ImportedEnumList, wanted: decl.SemanticIdentity, found: bool }
record ProjectRecordWalk { rest: ModuleList, nominal_modules: NominalModuleList, markers: decl.NominalTypeIdentityList, acc: decl.ImportedRecordList }
record ProjectRecordDeclWalk { rest: decl.RecordList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, records: decl.RecordList, enums: decl.EnumList, acc: decl.ImportedRecordList }
record ProjectRecordFieldWalk { rest: decl.FieldList, index: u64, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, records: decl.RecordList, enums: decl.EnumList, acc: decl.ImportedRecordFieldList, ok: bool }
record ProjectRecordFields { fields: decl.ImportedRecordFieldList, ok: bool }
record ProjectRecordFieldReverse { rest: decl.ImportedRecordFieldList, acc: decl.ImportedRecordFieldList }
record ProjectEnumWalk { rest: ModuleList, nominal_modules: NominalModuleList, markers: decl.NominalTypeIdentityList, acc: decl.ImportedEnumList }
record ProjectEnumDeclWalk { rest: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, records: decl.RecordList, enums: decl.EnumList, acc: decl.ImportedEnumList }
record ProjectEnumVariantWalk { rest: decl.VariantList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, records: decl.RecordList, enums: decl.EnumList, acc: decl.ImportedEnumVariantList, ok: bool }
record ProjectEnumVariantBuild { variants: decl.ImportedEnumVariantList, ok: bool }
record ProjectEnumFieldWalk { rest: decl.FieldList, index: u64, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, records: decl.RecordList, enums: decl.EnumList, acc: decl.ImportedEnumFieldList, ok: bool }
record ProjectEnumFields { fields: decl.ImportedEnumFieldList, ok: bool }
record ProjectEnumFieldReverse { rest: decl.ImportedEnumFieldList, acc: decl.ImportedEnumFieldList }
record ProjectEnumVariantReverse { rest: decl.ImportedEnumVariantList, acc: decl.ImportedEnumVariantList }

record ProjectModule {
    source_id: [byte; up_to 256],
    source_path: [byte; up_to 256],
    source_index: u64,
    flow: flow.LoweredUnit,
    value_ssa: ssa.ValueSsaSummary
}
enum ProjectModuleList { PNil, PCons { head: ProjectModule, tail: ProjectModuleList } }

record ImportLink {
    source_index: u64,
    target_index: u64,
    module_start: u64,
    module_end: u64,
    alias_start: u64,
    alias_end: u64,
    has_alias: bool
}
enum ImportList { INil, ICons { head: ImportLink, tail: ImportList } }
// These name-resolution results belong to one consumer module in one
// immutable parsed snapshot. The list is capped at the 64 facts the lookup
// examines. They carry no semantic verification evidence; missing results
// still produce a fresh diagnostic for each current use.
record ModuleResolutionFact { module_start: u64, module_end: u64, target_found: bool, target_index: u64 }
enum ModuleResolutionFactList { MRNil, MRCons { head: ModuleResolutionFact, tail: ModuleResolutionFactList } }
record ModuleResolutionCacheLookup { rest: ModuleResolutionFactList, source_index: u64, module_start: u64, module_end: u64, found: bool, target_found: bool, target_index: u64 }
// Project source indices are bounded to values less than 64. Keep membership in this
// fixed vector so closure discovery and filtering do not repeatedly walk a
// linked list just to answer whether one source index is present.
record ProjectImportClosure { reachable: [bool; 64], changed: bool }
record ProjectImportAdjacencyBuild { rest: ImportList, by_source: [ImportList; 64], source_count: u64 }
record ProjectImportClosureWork { reachable: [bool; 64], pending: [u64; 64], pending_count: u64, source_count: u64 }
record ProjectImportClosureSeed { pending: [u64; 64], pending_count: u64 }
record ProjectImportClosureWalk { rest: ImportList, reachable: [bool; 64], changed: bool, source_count: u64 }
record ProjectImportClosureExpansion { rest: ImportList, work: ProjectImportClosureWork }
record ProjectModuleClosureFilter { rest: ModuleList, reachable: [bool; 64], acc: ModuleList }

enum ProjectDiagnostic {
    SourceOrder { source_index: u64 },
    SourceCountMismatch { source_index: u64 },
    DuplicateModule { source_index: u64, start: u64, end: u64 },
    MissingImport { source_index: u64, start: u64, end: u64 },
    ParseFailed { source_index: u64, start: u64, end: u64 },
    ProofFailed { source_index: u64, start: u64, end: u64 },
    FlowFailed { source_index: u64, code: u64, start: u64, end: u64 },
    TargetModuleMissing { source_index: u64 },
    ImportLimitExceeded { source_index: u64, start: u64, end: u64, limit: u64 }
}
enum DiagnosticList { DiagNil, DiagCons { head: ProjectDiagnostic, tail: DiagnosticList } }
record DiagnosticReverse { rest: DiagnosticList, acc: DiagnosticList }
// Source locations are a projection over immutable project diagnostics. The
// byte spans remain authoritative; mapping is refreshed from the current
// snapshot and fails closed for an invalid source descriptor or page slice.
record ProjectDiagnosticSpan { source_index: u64, start: u64, end: u64, has_span: bool }
record ProjectDiagnosticLocation {
    diagnostic: ProjectDiagnostic,
    source_index: u64,
    has_span: bool,
    mapped: bool,
    start: source.LineCol,
    end: source.LineCol
}
// Diagnostic lists are emitted in source order by the compiler. Keep one
// immutable-source cursor while projecting them so adjacent spans do not
// rescan the same source prefix. Nonmonotone spans use the full-scan fallback.
record ProjectDiagnosticCursor {
    has_source: bool,
    source_index: u64,
    pages_valid: bool,
    cursor_valid: bool,
    offset: u64,
    position: source.LineCol
}
record ProjectDiagnosticLocationTransition {
    location: ProjectDiagnosticLocation,
    cursor: ProjectDiagnosticCursor
}
enum ProjectDiagnosticLocationList {
    LocationNil,
    LocationCons { head: ProjectDiagnosticLocation, tail: ProjectDiagnosticLocationList }
}
record ProjectDiagnosticLocationWalk {
    rest: DiagnosticList,
    acc: ProjectDiagnosticLocationList,
    cursor: ProjectDiagnosticCursor
}
record ProjectDiagnosticLocationReverse { rest: ProjectDiagnosticLocationList, acc: ProjectDiagnosticLocationList }

fn project_diagnostic_span(diagnostic: ProjectDiagnostic) -> (result: ProjectDiagnosticSpan) {
    return match diagnostic {
        SourceOrder { source_index: index } => ProjectDiagnosticSpan { source_index: index, start: 0, end: 0, has_span: false },
        SourceCountMismatch { source_index: index } => ProjectDiagnosticSpan { source_index: index, start: 0, end: 0, has_span: false },
        DuplicateModule { source_index: index, start: start, end: end } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true },
        MissingImport { source_index: index, start: start, end: end } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true },
        ParseFailed { source_index: index, start: start, end: end } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true },
        ProofFailed { source_index: index, start: start, end: end } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true },
        FlowFailed { source_index: index, code: code, start: start, end: end } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true },
        TargetModuleMissing { source_index: index } => ProjectDiagnosticSpan { source_index: index, start: 0, end: 0, has_span: false },
        ImportLimitExceeded { source_index: index, start: start, end: end, limit: limit } => ProjectDiagnosticSpan { source_index: index, start: start, end: end, has_span: true }
    };
}

fn unmapped_project_diagnostic_location(diagnostic: ProjectDiagnostic, span: ProjectDiagnosticSpan) -> (result: ProjectDiagnosticLocation) {
    let initial: source.LineCol = source.LineCol { line: 1, col: 1 };
    return ProjectDiagnosticLocation { diagnostic: diagnostic, source_index: span.source_index, has_span: span.has_span, mapped: false, start: initial, end: initial };
}

fn project_diagnostic_location<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], diagnostic: ProjectDiagnostic) -> (result: ProjectDiagnosticLocation) {
    let span: ProjectDiagnosticSpan = project_diagnostic_span(diagnostic);
    if !(span.has_span) || span.source_index >= sources.len {
        return unmapped_project_diagnostic_location(diagnostic, span);
    }
    let meta: ProjectSource = sources[span.source_index];
    // Check before slicing so a hostile descriptor cannot trap location
    // projection. Validate the selected composition before trusting its
    // stride and total as a current source snapshot.
    if meta.page_start > flat_pages.len || meta.page_count > flat_pages.len - meta.page_start {
        return unmapped_project_diagnostic_location(diagnostic, span);
    }
    let pages: [[byte; up_to N]; up_to 1024] = flat_pages[meta.page_start..meta.page_start + meta.page_count];
    if source.validate_pages<1024, N>(pages, meta.stride, meta.total) != 0 {
        return unmapped_project_diagnostic_location(diagnostic, span);
    }
    if !source.span_valid_global(meta.total, span.start, span.end) {
        return unmapped_project_diagnostic_location(diagnostic, span);
    }
    let positions: source.LineColSpan = source.line_col_span_global<1024, N>(pages, meta.stride, meta.total, span.start, span.end);
    return ProjectDiagnosticLocation { diagnostic: diagnostic, source_index: span.source_index, has_span: true, mapped: true, start: positions.start, end: positions.end };
}

fn project_diagnostic_location_cursor<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], diagnostic: ProjectDiagnostic, cursor: ProjectDiagnosticCursor) -> (result: ProjectDiagnosticLocationTransition) {
    let span: ProjectDiagnosticSpan = project_diagnostic_span(diagnostic);
    let initial: source.LineCol = source.LineCol { line: 1, col: 1 };
    if !(span.has_span) || span.source_index >= sources.len {
        return ProjectDiagnosticLocationTransition {
            location: unmapped_project_diagnostic_location(diagnostic, span),
            cursor: cursor
        };
    }
    let meta: ProjectSource = sources[span.source_index];
    if meta.page_start > flat_pages.len || meta.page_count > flat_pages.len - meta.page_start {
        let invalid_cursor: ProjectDiagnosticCursor = ProjectDiagnosticCursor {
            has_source: true,
            source_index: span.source_index,
            pages_valid: false,
            cursor_valid: false,
            offset: 0,
            position: initial
        };
        return ProjectDiagnosticLocationTransition {
            location: unmapped_project_diagnostic_location(diagnostic, span),
            cursor: invalid_cursor
        };
    }
    let pages: [[byte; up_to N]; up_to 1024] = flat_pages[meta.page_start..meta.page_start + meta.page_count];
    let same_source: bool = cursor.has_source && cursor.source_index == span.source_index;
    if same_source && !cursor.pages_valid {
        return ProjectDiagnosticLocationTransition {
            location: unmapped_project_diagnostic_location(diagnostic, span),
            cursor: cursor
        };
    }
    if !same_source && source.validate_pages<1024, N>(pages, meta.stride, meta.total) != 0 {
        let invalid_cursor: ProjectDiagnosticCursor = ProjectDiagnosticCursor {
            has_source: true,
            source_index: span.source_index,
            pages_valid: false,
            cursor_valid: false,
            offset: 0,
            position: initial
        };
        return ProjectDiagnosticLocationTransition {
            location: unmapped_project_diagnostic_location(diagnostic, span),
            cursor: invalid_cursor
        };
    }
    let source_cursor: ProjectDiagnosticCursor = match select(same_source, 1, 0) {
        0 => ProjectDiagnosticCursor {
            has_source: true,
            source_index: span.source_index,
            pages_valid: true,
            cursor_valid: false,
            offset: 0,
            position: initial
        },
        _ => cursor
    };
    if !source.span_valid_global(meta.total, span.start, span.end) {
        return ProjectDiagnosticLocationTransition {
            location: unmapped_project_diagnostic_location(diagnostic, span),
            cursor: source_cursor
        };
    }
    if same_source && source_cursor.cursor_valid && span.start >= source_cursor.offset {
        let start_position: source.LineCol = source.line_col_advance_global<1024, N>(
            pages, meta.stride, source_cursor.offset, span.start, source_cursor.position
        );
        let end_position: source.LineCol = source.line_col_advance_global<1024, N>(
            pages, meta.stride, span.start, span.end, start_position
        );
        let next_cursor: ProjectDiagnosticCursor = ProjectDiagnosticCursor {
            has_source: true,
            source_index: span.source_index,
            pages_valid: true,
            cursor_valid: true,
            offset: span.end,
            position: end_position
        };
        return ProjectDiagnosticLocationTransition {
            location: ProjectDiagnosticLocation {
                diagnostic: diagnostic,
                source_index: span.source_index,
                has_span: true,
                mapped: true,
                start: start_position,
                end: end_position
            },
            cursor: next_cursor
        };
    }
    let positions: source.LineColSpan = source.line_col_span_global<1024, N>(
        pages, meta.stride, meta.total, span.start, span.end
    );
    let next_cursor: ProjectDiagnosticCursor = ProjectDiagnosticCursor {
        has_source: true,
        source_index: span.source_index,
        pages_valid: true,
        cursor_valid: true,
        offset: span.end,
        position: positions.end
    };
    return ProjectDiagnosticLocationTransition {
        location: ProjectDiagnosticLocation {
            diagnostic: diagnostic,
            source_index: span.source_index,
            has_span: true,
            mapped: true,
            start: positions.start,
            end: positions.end
        },
        cursor: next_cursor
    };
}

// Convert an existing diagnostic list without recompiling the project. Two
// bounded loop levels cover the current project diagnostic ceiling while
// preserving input order. Each source's pages are validated once per adjacent
// diagnostic group; monotone spans advance from the previous mapped endpoint.
fn locate_project_diagnostics_global<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], diagnostics: DiagnosticList) -> (result: ProjectDiagnosticLocationList) {
    let initial: source.LineCol = source.LineCol { line: 1, col: 1 };
    let initial_cursor: ProjectDiagnosticCursor = ProjectDiagnosticCursor {
        has_source: false,
        source_index: 0,
        pages_valid: false,
        cursor_valid: false,
        offset: 0,
        position: initial
    };
    iterate chunk up_to 1024 carrying outer: ProjectDiagnosticLocationWalk = ProjectDiagnosticLocationWalk { rest: diagnostics, acc: ProjectDiagnosticLocationList.LocationNil, cursor: initial_cursor } {
        iterate i up_to 1024 carrying inner: ProjectDiagnosticLocationWalk = outer {
            if diagnostic_list_empty(inner.rest) { return reverse_project_diagnostic_locations(inner.acc); }
            next inner = project_diagnostic_location_step<M, N>(sources, flat_pages, inner);
        }
        if diagnostic_list_empty(inner.rest) { return reverse_project_diagnostic_locations(inner.acc); }
        next outer = inner;
    }
    return reverse_project_diagnostic_locations(outer.acc);
}
fn project_diagnostic_location_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectDiagnosticLocationWalk) -> (result: ProjectDiagnosticLocationWalk) {
    return match st.rest {
        DiagNil => st,
        DiagCons { head: diagnostic, tail: rest } => project_diagnostic_location_cons<M, N>(sources, flat_pages, st, diagnostic, rest)
    };
}
fn project_diagnostic_location_cons<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectDiagnosticLocationWalk, diagnostic: ProjectDiagnostic, rest: DiagnosticList) -> (result: ProjectDiagnosticLocationWalk) {
    let transition: ProjectDiagnosticLocationTransition = project_diagnostic_location_cursor<M, N>(sources, flat_pages, diagnostic, st.cursor);
    return ProjectDiagnosticLocationWalk {
        rest: rest,
        acc: ProjectDiagnosticLocationList.LocationCons {
            head: transition.location,
            tail: st.acc
        },
        cursor: transition.cursor
    };
}
fn reverse_project_diagnostic_locations(initial: ProjectDiagnosticLocationList) -> (result: ProjectDiagnosticLocationList) {
    iterate chunk up_to 1024 carrying outer: ProjectDiagnosticLocationReverse = ProjectDiagnosticLocationReverse { rest: initial, acc: ProjectDiagnosticLocationList.LocationNil } {
        iterate i up_to 1024 carrying inner: ProjectDiagnosticLocationReverse = outer {
            if project_diagnostic_locations_empty(inner.rest) { return inner.acc; }
            next inner = reverse_project_diagnostic_location_step(inner);
        }
        if project_diagnostic_locations_empty(inner.rest) { return inner.acc; }
        next outer = inner;
    }
    return outer.acc;
}
fn project_diagnostic_locations_empty(locations: ProjectDiagnosticLocationList) -> (result: bool) {
    return match locations {
        LocationNil => true,
        LocationCons { head: location, tail: rest } => false
    };
}
fn reverse_project_diagnostic_location_step(st: ProjectDiagnosticLocationReverse) -> (result: ProjectDiagnosticLocationReverse) {
    return match st.rest {
        LocationNil => st,
        LocationCons { head: location, tail: rest } => ProjectDiagnosticLocationReverse { rest: rest, acc: ProjectDiagnosticLocationList.LocationCons { head: location, tail: st.acc } }
    };
}

record ProjectResult {
    valid: bool,
    fingerprint: [byte; up_to 64],
    fingerprint_authenticated: bool,
    value_ssa_valid: bool,
    source_count: u64,
    module_count: u64,
    import_count: u64,
    import_module_name_comparisons: u64,
    import_resolution_cache_hits: u64,
    import_resolution_negative_cache_hits: u64,
    import_resolution_cache_entries_max: u64,
    modules: ProjectModuleList,
    imports: ImportList,
    diagnostics: DiagnosticList
}

record ProjectResultWithDiagnosticLocations {
    result: ProjectResult,
    diagnostic_locations: ProjectDiagnosticLocationList
}

// Selected-target compilation context retaining only the resolved import
// closure's signature/schema metadata so downstream consumers (such as
// selected-callable VM emission) can materialize provider bodies on demand
// without re-parsing unrelated sources or lowering uncalled modules.
record SelectedProjectContext {
    result: ProjectResult,
    reachable: [bool; 64],
    dependency_modules: ModuleList,
    dependency_nominal_modules: NominalModuleList,
    nominal_markers: decl.NominalTypeIdentityList
}
record MaterializedProviderBuild {
    ok: bool,
    modules: ProjectModuleList,
    start: u64,
    end: u64
}

record ModuleBuild { rest: ModuleList, acc: ModuleList, valid: bool, count: u64, parse_failed: bool, parse_index: u64, parse_start: u64, parse_end: u64 }
fn build_modules<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_source_index: u64, target_only: bool) -> (result: ModuleBuild) {
    iterate i over sources carrying st: ModuleBuild = ModuleBuild {
        rest: ModuleList.MNil,
        acc: ModuleList.MNil,
        valid: true,
        count: 0,
        parse_failed: false,
        parse_index: 0,
        parse_start: 0,
        parse_end: 0
    } {
        next st = build_one_module<M, N>(sources, flat_pages, i, target_source_index, target_only, st);
    }
    return st;
}
fn build_one_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], index: u64, target_source_index: u64, target_only: bool, st: ModuleBuild) -> (result: ModuleBuild) {
    if index >= sources.len { return ModuleBuild { rest: st.rest, acc: st.acc, valid: false, count: st.count, parse_failed: true, parse_index: select(st.parse_failed, st.parse_index, index), parse_start: select(st.parse_failed, st.parse_start, 0), parse_end: select(st.parse_failed, st.parse_end, 0) }; }
    let item: ProjectSource = sources[index];
    let pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, index);
    let unit: decl.Unit = parse_project_unit<M, N>(pages, item.stride, item.total, index, target_source_index, target_only);
    return ModuleBuild {
        rest: st.rest,
        acc: ModuleList.MCons {
            head: ParsedModule {
                source_id: item.source_id,
                source_path: item.source_path,
                source_index: index,
                unit: unit
            },
            tail: st.acc
        },
        valid: st.valid && unit.ok,
        count: st.count + 1,
        parse_failed: st.parse_failed || !(unit.ok),
        parse_index: select(st.parse_failed, st.parse_index, index),
        parse_start: select(st.parse_failed, st.parse_start, unit.err_start),
        parse_end: select(st.parse_failed, st.parse_end, unit.err_end)
    };
}
fn parse_project_unit<M: Nat, N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, source_index: u64, target_source_index: u64, target_only: bool) -> (result: decl.Unit) {
    if target_only && source_index != target_source_index { return decl.parse_unit_signatures<1024, N>(pages, stride, total); }
    return decl.parse_unit<1024, N>(pages, stride, total);
}

fn reverse_modules<M: Nat>(sources: [ProjectSource; up_to M], modules: ModuleList) -> (result: ModuleList) {
    iterate i over sources carrying st: ModuleReverse = ModuleReverse {
        rest: modules,
        acc: ModuleList.MNil
    } {
        next st = reverse_module_step(st);
    }
    return st.acc;
}
fn reverse_module_step(st: ModuleReverse) -> (result: ModuleReverse) {
    return match st.rest {
        MNil => st,
        MCons { head: h, tail: t } => ModuleReverse {
            rest: t,
            acc: ModuleList.MCons { head: h, tail: st.acc }
        }
    };
}

record OrderState { valid: bool }
fn source_ordered<M: Nat>(sources: [ProjectSource; up_to M]) -> (result: bool) {
    iterate i over sources carrying st: OrderState = OrderState { valid: true } {
        next st = source_order_step(sources, i, st);
    }
    return st.valid;
}
fn source_order_step<M: Nat>(sources: [ProjectSource; up_to M], index: u64, st: OrderState) -> (result: OrderState) {
    if !(st.valid) || index == 0 { return st; }
    let previous: ProjectSource = sources[index - 1];
    let current: ProjectSource = sources[index];
    return OrderState { valid: byte_string_before(previous.source_id, current.source_id) };
}

fn byte_string_before(a: [byte; up_to 256], b: [byte; up_to 256]) -> (result: bool) {
    iterate i over a carrying st: ByteCompare = ByteCompare {
        decided: false,
        less: false
    } {
        next st = byte_compare_step(a, b, i, st);
    }
    if st.decided { return st.less; }
    return a.len < b.len;
}
record ByteCompare { decided: bool, less: bool }
fn byte_compare_step(a: [byte; up_to 256], b: [byte; up_to 256], index: u64, st: ByteCompare) -> (result: ByteCompare) {
    if st.decided || index >= b.len { return st; }
    let left: u64 = a[index] as u64;
    let right: u64 = b[index] as u64;
    if left < right { return ByteCompare { decided: true, less: true }; }
    if left > right { return ByteCompare { decided: true, less: false }; }
    return st;
}

fn duplicate_modules<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList) -> (result: DiagnosticList) {
    iterate i over sources carrying st: DuplicateState = DuplicateState {
        rest: modules,
        all: modules,
        diagnostics: DiagnosticList.DiagNil
    } {
        next st = duplicate_module_step<M, N>(sources, flat_pages, st);
    }
    return reverse_diagnostics(sources, st.diagnostics);
}
record DuplicateState { rest: ModuleList, all: ModuleList, diagnostics: DiagnosticList }
fn duplicate_module_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: DuplicateState) -> (result: DuplicateState) {
    return match st.rest {
        MNil => st,
        MCons { head: current, tail: tail } => duplicate_module_cons<M, N>(sources, flat_pages, st, current, tail)
    };
}
fn duplicate_module_cons<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: DuplicateState, current: ParsedModule, tail: ModuleList) -> (result: DuplicateState) {
    let found: DuplicateCheck = find_duplicate_module<M, N>(sources, flat_pages, st.all, current);
    let diagnostics: DiagnosticList = duplicate_diagnostic(current, found, st.diagnostics);
    return DuplicateState { rest: tail, all: st.all, diagnostics: diagnostics };
}
record DuplicateCheck { found: bool, index: u64, start: u64, end: u64 }
fn find_duplicate_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule) -> (result: DuplicateCheck) {
    iterate i over sources carrying st: DuplicateScan = DuplicateScan {
        rest: all,
        current_index: current.source_index,
        current: current,
        found: false,
        index: 0,
        start: 0,
        end: 0
    } {
        next st = duplicate_scan_step<M, N>(sources, flat_pages, st);
    }
    return DuplicateCheck { found: st.found, index: st.index, start: st.start, end: st.end };
}
record DuplicateScan {
    rest: ModuleList,
    current_index: u64,
    current: ParsedModule,
    found: bool,
    index: u64,
    start: u64,
    end: u64
}
fn duplicate_scan_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: DuplicateScan) -> (result: DuplicateScan) {
    if st.found { return st; }
    return match st.rest {
        MNil => st,
        MCons { head: candidate, tail: tail } => duplicate_scan_candidate<M, N>(sources, flat_pages, st, candidate, tail)
    };
}
fn duplicate_scan_candidate<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: DuplicateScan, candidate: ParsedModule, tail: ModuleList) -> (result: DuplicateScan) {
    if candidate.source_index >= st.current_index { return DuplicateScan {
        rest: ModuleList.MNil,
        current_index: st.current_index,
        current: st.current,
        found: false,
        index: 0,
        start: 0,
        end: 0
    }; }
    let equal: bool = module_names_equal<M, N>(sources, flat_pages, st.current, candidate);
    let header: decl.Header = candidate.unit.header;
    if equal { return DuplicateScan {
        rest: ModuleList.MNil,
        current_index: st.current_index,
        current: st.current,
        found: true,
        index: candidate.source_index,
        start: header.module_start,
        end: header.module_end
    }; }
    return DuplicateScan {
        rest: tail,
        current_index: st.current_index,
        current: st.current,
        found: st.found,
        index: st.index,
        start: st.start,
        end: st.end
    };
}
fn duplicate_diagnostic(current: ParsedModule, found: DuplicateCheck, diagnostics: DiagnosticList) -> (result: DiagnosticList) {
    if !(found.found) { return diagnostics; }
    let header: decl.Header = current.unit.header;
    return DiagnosticList.DiagCons {
        head: ProjectDiagnostic.DuplicateModule {
            source_index: current.source_index,
            start: header.module_start,
            end: header.module_end
        },
        tail: diagnostics
    };
}

record Resolution { valid: bool, count: u64, imports: ImportList, diagnostics: DiagnosticList, import_module_name_comparisons: u64, import_resolution_cache_hits: u64, import_resolution_negative_cache_hits: u64, import_resolution_cache_entries_max: u64 }
record ResolveModules {
    rest: ModuleList,
    all: ModuleList,
    imports: ImportList,
    diagnostics: DiagnosticList,
    valid: bool,
    count: u64,
    import_module_name_comparisons: u64,
    import_resolution_cache_hits: u64,
    import_resolution_negative_cache_hits: u64,
    import_resolution_cache_entries_max: u64,
    limit_reached: bool
}
fn resolve_imports<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList) -> (result: Resolution) {
    iterate i over sources carrying st: ResolveModules = ResolveModules {
        rest: modules,
        all: modules,
        imports: ImportList.INil,
        diagnostics: DiagnosticList.DiagNil,
        valid: true,
        count: 0,
        import_module_name_comparisons: 0,
        import_resolution_cache_hits: 0,
        import_resolution_negative_cache_hits: 0,
        import_resolution_cache_entries_max: 0,
        limit_reached: false
    } {
        next st = resolve_module_step<M, N>(sources, flat_pages, st);
    }
    return Resolution {
        valid: st.valid,
        count: st.count,
        imports: reverse_imports(sources, st.imports),
        diagnostics: reverse_diagnostics(sources, st.diagnostics),
        import_module_name_comparisons: st.import_module_name_comparisons,
        import_resolution_cache_hits: st.import_resolution_cache_hits,
        import_resolution_negative_cache_hits: st.import_resolution_negative_cache_hits,
        import_resolution_cache_entries_max: st.import_resolution_cache_entries_max
    };
}
fn resolve_module_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ResolveModules) -> (result: ResolveModules) {
    if st.limit_reached { return st; }
    return match st.rest {
        MNil => st,
        MCons { head: current, tail: tail } => resolve_module_uses<M, N>(sources, flat_pages, st, current, tail)
    };
}
fn resolve_module_uses<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ResolveModules, current: ParsedModule, tail: ModuleList) -> (result: ResolveModules) {
    let unit: decl.Unit = current.unit;
    let resolved: UseResolution = resolve_use_list<M, N>(sources, flat_pages, st.all, current, unit.uses, st.imports, st.diagnostics, st.valid, st.count);
    return ResolveModules {
        rest: tail,
        all: st.all,
        imports: resolved.imports,
        diagnostics: resolved.diagnostics,
        valid: resolved.valid,
        count: resolved.count,
        import_module_name_comparisons: st.import_module_name_comparisons + resolved.import_module_name_comparisons,
        import_resolution_cache_hits: st.import_resolution_cache_hits + resolved.import_resolution_cache_hits,
        import_resolution_negative_cache_hits: st.import_resolution_negative_cache_hits + resolved.import_resolution_negative_cache_hits,
        import_resolution_cache_entries_max: select(st.import_resolution_cache_entries_max > resolved.import_resolution_cache_entries_max, st.import_resolution_cache_entries_max, resolved.import_resolution_cache_entries_max),
        limit_reached: resolved.limit_reached
    };
}
record UseResolution { imports: ImportList, diagnostics: DiagnosticList, valid: bool, count: u64, import_module_name_comparisons: u64, import_resolution_cache_hits: u64, import_resolution_negative_cache_hits: u64, import_resolution_cache_entries_max: u64, limit_reached: bool }
record ResolveUses {
    rest: decl.UseList,
    imports: ImportList,
    diagnostics: DiagnosticList,
    valid: bool,
    count: u64,
    facts: ModuleResolutionFactList,
    facts_count: u64,
    import_module_name_comparisons: u64,
    import_resolution_cache_hits: u64,
    import_resolution_negative_cache_hits: u64,
    import_resolution_cache_entries_max: u64
}
fn resolve_use_list<M: Nat, N: Nat>(
    sources: [ProjectSource; up_to 64],
    flat_pages: [[byte; up_to N]; up_to M],
    all: ModuleList,
    current: ParsedModule,
    uses: decl.UseList,
    imports: ImportList,
    diagnostics: DiagnosticList,
    valid: bool,
    count: u64
) -> (result: UseResolution) {
    if decl.use_list_empty(uses) {
        return UseResolution { imports: imports, diagnostics: diagnostics, valid: valid, count: count, import_module_name_comparisons: 0, import_resolution_cache_hits: 0, import_resolution_negative_cache_hits: 0, import_resolution_cache_entries_max: 0, limit_reached: false };
    }
    iterate i up_to 1024 carrying st: ResolveUses = ResolveUses {
        rest: uses,
        imports: imports,
        diagnostics: diagnostics,
        valid: valid,
        count: count,
        facts: ModuleResolutionFactList.MRNil,
        facts_count: 0,
        import_module_name_comparisons: 0,
        import_resolution_cache_hits: 0,
        import_resolution_negative_cache_hits: 0,
        import_resolution_cache_entries_max: 0
    } {
        if decl.use_list_empty(st.rest) { return finish_use_resolution(st, current.source_index, 1024); }
        if project_import_limit_reached(st.count) {
            return finish_global_import_limit(st, current.source_index);
        }
        next st = resolve_use_step<M, N>(sources, flat_pages, all, current, st);
    }
    return finish_use_resolution(st, current.source_index, 1024);
}
fn project_import_limit_reached(count: u64) -> (result: bool) {
    return count >= 4096;
}
fn finish_global_import_limit(st: ResolveUses, source_index: u64) -> (result: UseResolution) {
    return finish_use_resolution(st, source_index, 4096);
}
fn finish_use_resolution(st: ResolveUses, source_index: u64, limit: u64) -> (result: UseResolution) {
    return match st.rest {
        UNil => UseResolution { imports: st.imports, diagnostics: st.diagnostics, valid: st.valid, count: st.count, import_module_name_comparisons: st.import_module_name_comparisons, import_resolution_cache_hits: st.import_resolution_cache_hits, import_resolution_negative_cache_hits: st.import_resolution_negative_cache_hits, import_resolution_cache_entries_max: st.import_resolution_cache_entries_max, limit_reached: false },
        UCons { head: usage, tail: rest } => UseResolution {
            imports: st.imports,
            diagnostics: DiagnosticList.DiagCons { head: ProjectDiagnostic.ImportLimitExceeded { source_index: source_index, start: usage.module_start, end: usage.module_end, limit: limit }, tail: st.diagnostics },
            valid: false,
            count: st.count,
            import_module_name_comparisons: st.import_module_name_comparisons,
            import_resolution_cache_hits: st.import_resolution_cache_hits,
            import_resolution_negative_cache_hits: st.import_resolution_negative_cache_hits,
            import_resolution_cache_entries_max: st.import_resolution_cache_entries_max,
            limit_reached: limit == 4096
        }
    };
}
fn resolve_use_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, st: ResolveUses) -> (result: ResolveUses) {
    return match st.rest {
        UNil => st,
        UCons { head: usage, tail: tail } => resolve_one_use<M, N>(sources, flat_pages, all, current, usage, tail, st)
    };
}
fn resolve_one_use<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, usage: decl.UseDecl, tail: decl.UseList, st: ResolveUses) -> (result: ResolveUses) {
    let cached: ModuleResolutionCacheLookup = module_resolution_cache_lookup<M, N>(sources, flat_pages, current, usage, st.facts);
    let cacheable: bool = module_resolution_cache_name_cacheable<M, N>(sources, flat_pages, current.source_index, usage.module_start, usage.module_end);
    if cached.found { return resolve_one_use_result(current, usage, tail, st, true, cached.target_found, cached.target_index, 0, cacheable); }
    let found: ModuleLookup = find_import_target<M, N>(sources, flat_pages, all, current, usage);
    return resolve_one_use_result(current, usage, tail, st, false, found.found, found.index, found.name_comparisons, cacheable);
}
fn resolve_one_use_result(current: ParsedModule, usage: decl.UseDecl, tail: decl.UseList, st: ResolveUses, cache_hit: bool, target_found: bool, target_index: u64, name_comparisons: u64, cacheable: bool) -> (result: ResolveUses) {
    let facts: ModuleResolutionFactList = module_resolution_cache_add(st.facts, st.facts_count, usage, target_found, target_index, cache_hit, cacheable);
    let adds_fact: bool = cacheable && !(cache_hit);
    let added_fact_count: u64 = select(st.facts_count >= 64, 1, st.facts_count + 1);
    let facts_count: u64 = select(adds_fact, added_fact_count, st.facts_count);
    let facts_max: u64 = select(st.import_resolution_cache_entries_max > facts_count, st.import_resolution_cache_entries_max, facts_count);
    let cache_hits: u64 = st.import_resolution_cache_hits + select(cache_hit && target_found, 1, 0);
    let negative_cache_hits: u64 = st.import_resolution_negative_cache_hits + select(cache_hit && !(target_found), 1, 0);
    if !(target_found) { return ResolveUses {
        rest: tail,
        imports: st.imports,
        diagnostics: DiagnosticList.DiagCons {
            head: ProjectDiagnostic.MissingImport {
                source_index: current.source_index,
                start: usage.module_start,
                end: usage.module_end
            },
            tail: st.diagnostics
        },
        valid: false,
        count: st.count,
        facts: facts,
        facts_count: facts_count,
        import_module_name_comparisons: st.import_module_name_comparisons + name_comparisons,
        import_resolution_cache_hits: cache_hits,
        import_resolution_negative_cache_hits: negative_cache_hits,
        import_resolution_cache_entries_max: facts_max
    }; }
    return ResolveUses {
        rest: tail,
        imports: ImportList.ICons {
            head: ImportLink {
                source_index: current.source_index,
                target_index: target_index,
                module_start: usage.module_start,
                module_end: usage.module_end,
                alias_start: usage.alias_start,
                alias_end: usage.alias_end,
                has_alias: usage.has_alias
            },
            tail: st.imports
        },
        diagnostics: st.diagnostics,
        valid: st.valid,
        count: st.count + 1,
        facts: facts,
        facts_count: facts_count,
        import_module_name_comparisons: st.import_module_name_comparisons + name_comparisons,
        import_resolution_cache_hits: cache_hits,
        import_resolution_negative_cache_hits: negative_cache_hits,
        import_resolution_cache_entries_max: facts_max
    };
}
fn module_resolution_cache_lookup<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, usage: decl.UseDecl, facts: ModuleResolutionFactList) -> (result: ModuleResolutionCacheLookup) {
    iterate i up_to 64 carrying st: ModuleResolutionCacheLookup = ModuleResolutionCacheLookup { rest: facts, source_index: current.source_index, module_start: usage.module_start, module_end: usage.module_end, found: false, target_found: false, target_index: 0 } {
        // Return on a match or exhausted facts instead of paying for the
        // remaining no-op iterations in this bounded lookup.
        if module_resolution_cache_lookup_done(st) { return st; }
        next st = module_resolution_cache_step<M, N>(sources, flat_pages, current.source_index, st);
    }
    return st;
}
fn module_resolution_cache_lookup_done(st: ModuleResolutionCacheLookup) -> (result: bool) {
    if st.found { return true; }
    return match st.rest {
        MRNil => true,
        MRCons { head: head, tail: tail } => false
    };
}
fn module_resolution_cache_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, st: ModuleResolutionCacheLookup) -> (result: ModuleResolutionCacheLookup) {
    if st.found { return st; }
    return match st.rest {
        MRNil => st,
        MRCons { head: fact, tail: rest } => module_resolution_cache_fact<M, N>(sources, flat_pages, source_index, st, fact, rest)
    };
}
fn module_resolution_cache_fact<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, st: ModuleResolutionCacheLookup, fact: ModuleResolutionFact, rest: ModuleResolutionFactList) -> (result: ModuleResolutionCacheLookup) {
    if module_resolution_cache_key_equal<M, N>(sources, flat_pages, source_index, st.module_start, st.module_end, fact.module_start, fact.module_end) {
        return ModuleResolutionCacheLookup { rest: ModuleResolutionFactList.MRNil, source_index: st.source_index, module_start: st.module_start, module_end: st.module_end, found: true, target_found: fact.target_found, target_index: fact.target_index };
    }
    return ModuleResolutionCacheLookup { rest: rest, source_index: st.source_index, module_start: st.module_start, module_end: st.module_end, found: false, target_found: false, target_index: 0 };
}
record ModuleResolutionNameCompare { length: u64, left_start: u64, right_start: u64, offset: u64, equal: bool }
fn module_resolution_cache_key_equal<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, left_start: u64, left_end: u64, right_start: u64, right_end: u64) -> (result: bool) {
    if left_end < left_start || right_end < right_start { return false; }
    if left_end - left_start != right_end - right_start { return false; }
    let meta: ProjectSource = sources[source_index];
    if meta.stride == 0 || left_end > meta.total || right_end > meta.total { return false; }
    if meta.page_start > flat_pages.len || meta.page_count > flat_pages.len - meta.page_start { return false; }
    let length: u64 = left_end - left_start;
    // Cache only the common short module-name case. Longer names take the
    // conservative uncached resolver path instead of burning 1024 steps.
    if length > 64 { return false; }
    iterate i up_to 64 carrying st: ModuleResolutionNameCompare = ModuleResolutionNameCompare {
        length: length,
        left_start: left_start,
        right_start: right_start,
        offset: 0,
        equal: true
    } {
        // Stop on a mismatch or once all name bytes have been compared.
        if !(st.equal) || st.offset >= st.length { return st.equal && st.offset >= st.length; }
        next st = module_resolution_name_compare_step<M, N>(sources, flat_pages, source_index, st);
    }
    return st.equal && st.offset >= st.length;
}
fn module_resolution_cache_name_cacheable<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, name_start: u64, name_end: u64) -> (result: bool) {
    if source_index >= sources.len || name_end < name_start || name_end - name_start > 64 { return false; }
    let meta: ProjectSource = sources[source_index];
    if meta.stride == 0 || name_end > meta.total { return false; }
    if meta.page_start > flat_pages.len || meta.page_count > flat_pages.len - meta.page_start { return false; }
    return true;
}
fn module_resolution_name_compare_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, st: ModuleResolutionNameCompare) -> (result: ModuleResolutionNameCompare) {
    if !(st.equal) || st.offset >= st.length { return st; }
    let left: u64 = project_source_byte_at<M, N>(sources, flat_pages, source_index, st.left_start + st.offset);
    let right: u64 = project_source_byte_at<M, N>(sources, flat_pages, source_index, st.right_start + st.offset);
    return ModuleResolutionNameCompare { length: st.length, left_start: st.left_start, right_start: st.right_start, offset: st.offset + 1, equal: left < 256 && right < 256 && left == right };
}
fn project_source_byte_at<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, offset: u64) -> (result: u64) {
    let meta: ProjectSource = sources[source_index];
    if meta.stride == 0 || offset >= meta.total { return 256; }
    let relative_page: u64 = offset / meta.stride;
    if relative_page >= meta.page_count { return 256; }
    if meta.page_start > flat_pages.len || meta.page_count > flat_pages.len - meta.page_start { return 256; }
    let page: [byte; up_to N] = flat_pages[meta.page_start + relative_page];
    let within_page: u64 = offset % meta.stride;
    if within_page >= page.len { return 256; }
    return page[within_page] as u64;
}
fn module_resolution_cache_add(facts: ModuleResolutionFactList, facts_count: u64, usage: decl.UseDecl, target_found: bool, target_index: u64, cache_hit: bool, cacheable: bool) -> (result: ModuleResolutionFactList) {
    if cache_hit || !(cacheable) { return facts; }
    if facts_count >= 64 { return ModuleResolutionFactList.MRCons { head: ModuleResolutionFact { module_start: usage.module_start, module_end: usage.module_end, target_found: target_found, target_index: target_index }, tail: ModuleResolutionFactList.MRNil }; }
    return ModuleResolutionFactList.MRCons { head: ModuleResolutionFact { module_start: usage.module_start, module_end: usage.module_end, target_found: target_found, target_index: target_index }, tail: facts };
}
record ModuleLookup { found: bool, index: u64, name_comparisons: u64 }
record ModuleLookupState { rest: ModuleList, current: ParsedModule, usage: decl.UseDecl, found: bool, index: u64, name_comparisons: u64 }
fn find_import_target<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, usage: decl.UseDecl) -> (result: ModuleLookup) {
    iterate i over sources carrying st: ModuleLookupState = ModuleLookupState {
        rest: all,
        current: current,
        usage: usage,
        found: false,
        index: 0,
        name_comparisons: 0
    } {
        next st = module_lookup_step<M, N>(sources, flat_pages, st);
    }
    return ModuleLookup { found: st.found, index: st.index, name_comparisons: st.name_comparisons };
}
fn module_lookup_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ModuleLookupState) -> (result: ModuleLookupState) {
    if st.found { return st; }
    return match st.rest {
        MNil => st,
        MCons { head: candidate, tail: tail } => module_lookup_candidate<M, N>(sources, flat_pages, st, candidate, tail)
    };
}
fn module_lookup_candidate<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ModuleLookupState, candidate: ParsedModule, tail: ModuleList) -> (result: ModuleLookupState) {
    if candidate.source_index == st.current.source_index { return ModuleLookupState {
        rest: tail,
        current: st.current,
        usage: st.usage,
        found: st.found,
        index: st.index,
        name_comparisons: st.name_comparisons
    }; }
    if use_matches_module<M, N>(sources, flat_pages, st.current, st.usage, candidate) { return ModuleLookupState {
        rest: ModuleList.MNil,
        current: st.current,
        usage: st.usage,
        found: true,
        index: candidate.source_index,
        name_comparisons: st.name_comparisons + 1
    }; }
    return ModuleLookupState {
        rest: tail,
        current: st.current,
        usage: st.usage,
        found: st.found,
        index: st.index,
        name_comparisons: st.name_comparisons + 1
    };
}

fn module_names_equal<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], a: ParsedModule, b: ParsedModule) -> (result: bool) {
    let left: decl.Header = a.unit.header;
    let right: decl.Header = b.unit.header;
    return spans_equal_between<M, N>(sources, flat_pages, a.source_index, left.module_start, left.module_end, b.source_index, right.module_start, right.module_end);
}
fn use_matches_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, usage: decl.UseDecl, target: ParsedModule) -> (result: bool) {
    let header: decl.Header = target.unit.header;
    return spans_equal_between<M, N>(sources, flat_pages, current.source_index, usage.module_start, usage.module_end, target.source_index, header.module_start, header.module_end);
}

// Nominal names are resolved from exact parsed type-reference spans and the
// declaring module selected by this module's `use` edge. A matching short
// name in another module never participates in the lookup.
record ProjectNominalWalk { spans: decl.NominalTypeSpanList, current: ParsedModule, all: ModuleList, locals: NominalModuleList, local: decl.NominalTypeIdentityList, acc: decl.NominalTypeIdentityList }
record NominalUseWalk { uses: decl.UseList, current: ParsedModule, all: ModuleList, locals: NominalModuleList, span: decl.NominalTypeSpan, found: bool, count: u64, identity: decl.SemanticIdentity }
record TargetIdentityWalk { modules: ModuleList, locals: NominalModuleList, target_index: u64, caller_index: u64, name_start: u64, name_end: u64, found: bool, identity: decl.SemanticIdentity }
record TargetTypeWalk { enums: decl.EnumList, records: decl.RecordList, local: decl.NominalTypeIdentityList, target_index: u64, caller_index: u64, name_start: u64, name_end: u64, found: bool, identity: decl.SemanticIdentity }

fn collect_local_nominal_modules<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList) -> (result: NominalModuleList) {
    iterate i over sources carrying st: NominalModuleBuild = NominalModuleBuild { rest: modules, acc: NominalModuleList.NMNil } {
        next st = collect_local_nominal_module<M, N>(sources, flat_pages, st);
    }
    return st.acc;
}
fn collect_local_nominal_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: NominalModuleBuild) -> (result: NominalModuleBuild) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => collect_local_nominal_module_one<M, N>(sources, flat_pages, st, parsed, rest)
    };
}
fn collect_local_nominal_module_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: NominalModuleBuild, parsed: ParsedModule, rest: ModuleList) -> (result: NominalModuleBuild) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let input_stride: u64 = module_stride(sources, parsed.source_index);
    let input_total: u64 = module_total(sources, parsed.source_index);
    let local: decl.NominalTypeIdentityList = decl.local_nominal_type_identities<1024, N>(input_pages, input_stride, input_total, parsed.unit);
    return NominalModuleBuild { rest: rest, acc: NominalModuleList.NMCons { head: NominalModule { source_index: parsed.source_index, local: local, resolved: decl.NominalTypeIdentityList.NINil }, tail: st.acc } };
}
fn nominal_module_head_matches(modules: NominalModuleList, source_index: u64) -> (result: bool) {
    return match modules { NMNil => false, NMCons { head: item, tail: rest } => item.source_index == source_index };
}
fn nominal_module_head(modules: NominalModuleList, empty: NominalModule) -> (result: NominalModule) {
    return match modules { NMNil => empty, NMCons { head: item, tail: rest } => item };
}
fn nominal_module_tail(modules: NominalModuleList) -> (result: NominalModuleList) {
    return match modules { NMNil => NominalModuleList.NMNil, NMCons { head: item, tail: rest } => rest };
}
fn nominal_module_by_index<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: NominalModuleList, source_index: u64) -> (result: NominalModuleLookup) {
    let empty: NominalModule = NominalModule { source_index: 0, local: decl.NominalTypeIdentityList.NINil, resolved: decl.NominalTypeIdentityList.NINil };
    iterate i over sources carrying rest: NominalModuleList = modules {
        if nominal_module_list_empty(rest) { return NominalModuleLookup { rest: NominalModuleList.NMNil, source_index: source_index, found: false, facts: empty }; }
        if nominal_module_head_matches(rest, source_index) {
            return NominalModuleLookup { rest: NominalModuleList.NMNil, source_index: source_index, found: true, facts: nominal_module_head(rest, empty) };
        }
        next rest = nominal_module_tail(rest);
    }
    return NominalModuleLookup { rest: NominalModuleList.NMNil, source_index: source_index, found: false, facts: empty };
}
record NominalBucketInsert { rest: decl.NominalTypeIdentityList, source_index: u64, buckets: [decl.NominalTypeIdentityList; 64] }
fn insert_local_nominals_into_buckets<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, local: decl.NominalTypeIdentityList) -> (result: [decl.NominalTypeIdentityList; 64]) {
    let empty_buckets: [decl.NominalTypeIdentityList; 64] = [decl.NominalTypeIdentityList.NINil; 64];
    let initial: NominalBucketInsert = NominalBucketInsert { rest: local, source_index: source_index, buckets: empty_buckets };
    iterate chunk up_to 64 carrying outer: NominalBucketInsert = initial {
        if decl.nominal_type_identity_list_empty(outer.rest) { return outer.buckets; }
        iterate i up_to 1024 carrying st: NominalBucketInsert = outer {
            if decl.nominal_type_identity_list_empty(st.rest) { return st.buckets; }
            next st = insert_local_nominal_bucket_step<M, N>(sources, flat_pages, st);
        }
        next outer = st;
    }
    return outer.buckets;
}
fn insert_local_nominal_bucket_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: NominalBucketInsert) -> (result: NominalBucketInsert) {
    return match st.rest {
        NINil => st,
        NICons { head: item, tail: rest } => insert_local_nominal_bucket_one<M, N>(sources, flat_pages, st, item, rest)
    };
}
fn insert_local_nominal_bucket_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: NominalBucketInsert, item: decl.NominalTypeIdentity, rest: decl.NominalTypeIdentityList) -> (result: NominalBucketInsert) {
    if item.reference { return NominalBucketInsert { ..st, rest: rest }; }
    let b: u64 = decl_name_bucket64_flat<M, N>(sources, flat_pages, st.source_index, item.start, item.end);
    let next_list: decl.NominalTypeIdentityList = decl.NominalTypeIdentityList.NICons { head: item, tail: st.buckets[b] };
    return NominalBucketInsert { rest: rest, source_index: st.source_index, buckets: replace(st.buckets, b, next_list) };
}
record TargetNominalBucketsBuild { rest: NominalModuleList, acc: TargetNominalBucketsList }
fn build_target_nominal_buckets<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], locals: NominalModuleList) -> (result: TargetNominalBucketsList) {
    iterate i up_to 64 carrying st: TargetNominalBucketsBuild = TargetNominalBucketsBuild { rest: locals, acc: TargetNominalBucketsList.TNBNil } {
        if nominal_module_list_empty(st.rest) { return st.acc; }
        next st = match st.rest {
            NMNil => st,
            NMCons { head: item, tail: rest } => TargetNominalBucketsBuild {
                rest: rest,
                acc: TargetNominalBucketsList.TNBCons {
                    head: TargetNominalBuckets {
                        source_index: item.source_index,
                        buckets: insert_local_nominals_into_buckets<M, N>(sources, flat_pages, item.source_index, item.local)
                    },
                    tail: st.acc
                }
            }
        };
    }
    return st.acc;
}
fn target_nominal_buckets_list_empty(list: TargetNominalBucketsList) -> (result: bool) {
    return match list { TNBNil => true, TNBCons { head: h, tail: t } => false };
}
fn target_nominal_buckets_head_matches(list: TargetNominalBucketsList, source_index: u64) -> (result: bool) {
    return match list { TNBNil => false, TNBCons { head: h, tail: t } => h.source_index == source_index };
}
fn target_nominal_buckets_tail(list: TargetNominalBucketsList) -> (result: TargetNominalBucketsList) {
    return match list { TNBNil => TargetNominalBucketsList.TNBNil, TNBCons { head: h, tail: t } => t };
}
fn find_target_nominal_buckets_node(list: TargetNominalBucketsList, source_index: u64) -> (result: TargetNominalBucketsList) {
    iterate i up_to 64 carrying rest: TargetNominalBucketsList = list {
        if target_nominal_buckets_list_empty(rest) { return TargetNominalBucketsList.TNBNil; }
        if target_nominal_buckets_head_matches(rest, source_index) { return rest; }
        next rest = target_nominal_buckets_tail(rest);
    }
    return TargetNominalBucketsList.TNBNil;
}
fn target_nominal_bucket_lookup_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, member_start: u64, member_end: u64, target_index: u64, buckets: [decl.NominalTypeIdentityList; 64]) -> (result: decl.NominalTypeIdentityList) {
    let b: u64 = decl_name_bucket64_flat<M, N>(sources, flat_pages, caller_index, member_start, member_end);
    iterate chunk up_to 64 carrying outer: decl.NominalTypeIdentityList = buckets[b] {
        if decl.nominal_type_identity_list_empty(outer) { return decl.NominalTypeIdentityList.NINil; }
        iterate i up_to 1024 carrying rest: decl.NominalTypeIdentityList = outer {
            if decl.nominal_type_identity_list_empty(rest) { return decl.NominalTypeIdentityList.NINil; }
            let matched: bool = match rest {
                NINil => false,
                NICons { head: item, tail: t } => !(item.reference) && spans_equal_flat_sources<M, N>(sources, flat_pages, caller_index, member_start, member_end, target_index, item.start, item.end)
            };
            if matched { return rest; }
            next rest = decl.nominal_identity_tail(rest);
        }
        next outer = rest;
    }
    return decl.NominalTypeIdentityList.NINil;
}
fn target_nominal_in_buckets_list<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, member_start: u64, member_end: u64, target_index: u64, buckets_list: TargetNominalBucketsList) -> (result: decl.NominalTypeIdentityList) {
    let node: TargetNominalBucketsList = find_target_nominal_buckets_node(buckets_list, target_index);
    return match node {
        TNBNil => decl.NominalTypeIdentityList.NINil,
        TNBCons { head: entry, tail: t } => target_nominal_bucket_lookup_flat<M, N>(sources, flat_pages, caller_index, member_start, member_end, target_index, entry.buckets)
    };
}
fn module_index_for_use_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, caller_index: u64, mod_start: u64, mod_end: u64) -> (result: u64) {
    iterate i up_to 64 carrying rest: ModuleList = all {
        if module_list_empty(rest) { return sources.len; }
        let matched: bool = match rest {
            MNil => false,
            MCons { head: candidate, tail: t } => spans_equal_flat_sources<M, N>(sources, flat_pages, caller_index, mod_start, mod_end, candidate.source_index, candidate.unit.header.module_start, candidate.unit.header.module_end)
        };
        if matched {
            return match rest { MNil => sources.len, MCons { head: candidate, tail: t } => candidate.source_index };
        }
        next rest = module_tail(rest);
    }
    return sources.len;
}
record UseTargetsBuild { rest: decl.UseList, acc: ResolvedUseTargetList, has_bare: bool }
fn resolve_use_targets_once<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule) -> (result: UseTargetsBuild) {
    iterate i up_to 1024 carrying st: UseTargetsBuild = UseTargetsBuild { rest: current.unit.uses, acc: ResolvedUseTargetList.RUTNil, has_bare: false } {
        if decl.use_list_empty(st.rest) { return st; }
        next st = match st.rest {
            UNil => st,
            UCons { head: usage, tail: rest } => resolve_one_use_target<M, N>(sources, flat_pages, all, current.source_index, usage, rest, st.acc, st.has_bare)
        };
    }
    return st;
}
fn resolve_one_use_target<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, caller_index: u64, usage: decl.UseDecl, rest: decl.UseList, acc: ResolvedUseTargetList, has_bare: bool) -> (result: UseTargetsBuild) {
    let tidx: u64 = module_index_for_use_flat<M, N>(sources, flat_pages, all, caller_index, usage.module_start, usage.module_end);
    if tidx >= sources.len {
        return UseTargetsBuild { rest: rest, acc: acc, has_bare: has_bare || !(usage.has_alias) };
    }
    let p_start: u64 = select(usage.has_alias, usage.alias_start, usage.module_start);
    let p_end: u64 = select(usage.has_alias, usage.alias_end, usage.module_end);
    let item: ResolvedUseTarget = ResolvedUseTarget { target_index: tidx, has_alias: usage.has_alias, prefix_start: p_start, prefix_end: p_end };
    return UseTargetsBuild { rest: rest, acc: ResolvedUseTargetList.RUTCons { head: item, tail: acc }, has_bare: has_bare || !(usage.has_alias) };
}
record UseNominalNodeWalk { rest: ResolvedUseTargetList, matched: decl.NominalTypeIdentityList, ok: bool }
fn nominal_span_node_from_uses_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, resolved_uses: ResolvedUseTargetList, buckets_list: TargetNominalBucketsList, span: decl.NominalTypeSpan) -> (result: decl.NominalTypeIdentityList) {
    if span.end <= span.start { return decl.NominalTypeIdentityList.NINil; }
    let span_len: u64 = span.end - span.start;
    iterate i up_to 1024 carrying st: UseNominalNodeWalk = UseNominalNodeWalk { rest: resolved_uses, matched: decl.NominalTypeIdentityList.NINil, ok: true } {
        if !(st.ok) || resolved_use_target_list_empty(st.rest) {
            if st.ok { return st.matched; }
            return decl.NominalTypeIdentityList.NINil;
        }
        next st = match st.rest {
            RUTNil => st,
            RUTCons { head: u, tail: rest } => match_resolved_use_nominal_step<M, N>(sources, flat_pages, caller_index, buckets_list, span, span_len, st, u, rest)
        };
    }
    if st.ok { return st.matched; }
    return decl.NominalTypeIdentityList.NINil;
}
fn resolved_use_target_list_empty(xs: ResolvedUseTargetList) -> (result: bool) {
    return match xs { RUTNil => true, RUTCons { head: h, tail: t } => false };
}
fn match_resolved_use_nominal_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, buckets_list: TargetNominalBucketsList, span: decl.NominalTypeSpan, span_len: u64, st: UseNominalNodeWalk, u: ResolvedUseTarget, rest: ResolvedUseTargetList) -> (result: UseNominalNodeWalk) {
    if span.kind == 5 {
        if u.has_alias { return UseNominalNodeWalk { ..st, rest: rest }; }
        let hit: decl.NominalTypeIdentityList = target_nominal_in_buckets_list<M, N>(sources, flat_pages, caller_index, span.start, span.end, u.target_index, buckets_list);
        return merge_matched_nominal_node(st, hit, rest);
    }
    if u.prefix_end <= u.prefix_start { return UseNominalNodeWalk { ..st, rest: rest }; }
    let plen: u64 = u.prefix_end - u.prefix_start;
    if span_len <= plen + 1 { return UseNominalNodeWalk { ..st, rest: rest }; }
    if byte_at_flat_source<M, N>(sources, flat_pages, caller_index, span.start + plen) != 46 {
        return UseNominalNodeWalk { ..st, rest: rest };
    }
    if !(spans_equal_flat_sources<M, N>(sources, flat_pages, caller_index, span.start, span.start + plen, caller_index, u.prefix_start, u.prefix_end)) {
        return UseNominalNodeWalk { ..st, rest: rest };
    }
    let hit: decl.NominalTypeIdentityList = target_nominal_in_buckets_list<M, N>(sources, flat_pages, caller_index, span.start + plen + 1, span.end, u.target_index, buckets_list);
    return merge_matched_nominal_node(st, hit, rest);
}
fn merge_matched_nominal_node(st: UseNominalNodeWalk, hit: decl.NominalTypeIdentityList, rest: ResolvedUseTargetList) -> (result: UseNominalNodeWalk) {
    if decl.nominal_type_identity_list_empty(hit) { return UseNominalNodeWalk { ..st, rest: rest }; }
    let hit_id: decl.SemanticIdentity = decl.nominal_identity_head(hit).identity;
    if !(hit_id.valid) { return UseNominalNodeWalk { ..st, rest: rest }; }
    if decl.nominal_type_identity_list_empty(st.matched) {
        return UseNominalNodeWalk { rest: rest, matched: hit, ok: true };
    }
    let prev_id: decl.SemanticIdentity = decl.nominal_identity_head(st.matched).identity;
    if decl.semantic_identity_equal(prev_id, hit_id) {
        return UseNominalNodeWalk { rest: rest, matched: st.matched, ok: true };
    }
    return UseNominalNodeWalk { rest: rest, matched: st.matched, ok: false };
}
record SpanBucketsWalk { rest: decl.NominalTypeSpanList, acc: decl.NominalTypeIdentityList }
fn project_nominal_spans_bucketed<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, all: ModuleList, buckets_list: TargetNominalBucketsList, spans: decl.NominalTypeSpanList) -> (result: decl.NominalTypeIdentityList) {
    if decl.nominal_type_span_list_empty(spans) { return decl.NominalTypeIdentityList.NINil; }
    let uses_info: UseTargetsBuild = resolve_use_targets_once<M, N>(sources, flat_pages, all, current);
    if resolved_use_target_list_empty(uses_info.acc) { return decl.NominalTypeIdentityList.NINil; }
    iterate chunk up_to 64 carrying outer: SpanBucketsWalk = SpanBucketsWalk { rest: spans, acc: decl.NominalTypeIdentityList.NINil } {
        if decl.nominal_type_span_list_empty(outer.rest) { return outer.acc; }
        iterate i up_to 1024 carrying st: SpanBucketsWalk = outer {
            if decl.nominal_type_span_list_empty(st.rest) { return st.acc; }
            next st = match st.rest {
                NSNil => st,
                NSCons { head: span, tail: rest } => project_nominal_span_bucketed_one<M, N>(sources, flat_pages, current.source_index, uses_info.acc, uses_info.has_bare, buckets_list, span, rest, st.acc)
            };
        }
        next outer = st;
    }
    return outer.acc;
}
fn project_nominal_span_bucketed_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, resolved_uses: ResolvedUseTargetList, has_bare: bool, buckets_list: TargetNominalBucketsList, span: decl.NominalTypeSpan, rest: decl.NominalTypeSpanList, acc: decl.NominalTypeIdentityList) -> (result: SpanBucketsWalk) {
    if span.kind == 5 && !(has_bare) { return SpanBucketsWalk { rest: rest, acc: acc }; }
    let matched: decl.NominalTypeIdentityList = nominal_span_node_from_uses_flat<M, N>(sources, flat_pages, caller_index, resolved_uses, buckets_list, span);
    if decl.nominal_type_identity_list_empty(matched) {
        return SpanBucketsWalk { rest: rest, acc: acc };
    }
    let item: decl.NominalTypeIdentity = decl.NominalTypeIdentity { start: span.start, end: span.end, identity: decl.nominal_identity_head(matched).identity, reference: true };
    return SpanBucketsWalk { rest: rest, acc: decl.NominalTypeIdentityList.NICons { head: item, tail: acc } };
}
fn select_module_nominal_spans<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, unit: decl.Unit, decl_only_spans: bool) -> (result: decl.NominalTypeSpanList) {
    if decl_only_spans {
        return decl.collect_decl_nominal_type_spans<1024, N>(pages, stride, total, unit);
    }
    return decl.collect_unit_nominal_type_spans<1024, N>(pages, stride, total, unit);
}
fn resolve_project_nominal_modules<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, locals: NominalModuleList) -> (result: NominalModuleList) {
    // Pass 1 resolves cross-module nominal references and refreshes each
    // module's local record identities that embed qualified imported field
    // types (matching Stage-0 `canonical_value_type`). Pass 2 re-resolves
    // downstream references against those finalized record identities.
    let pass1: NominalModuleList = resolve_project_nominal_modules_pass_mode<M, N>(sources, flat_pages, modules, locals, true);
    return resolve_project_nominal_modules_pass_mode<M, N>(sources, flat_pages, modules, pass1, false);
}
fn resolve_project_nominal_modules_pass<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, locals: NominalModuleList) -> (result: NominalModuleList) {
    return resolve_project_nominal_modules_pass_mode<M, N>(sources, flat_pages, modules, locals, false);
}
fn resolve_project_nominal_modules_pass_mode<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, locals: NominalModuleList, decl_only_spans: bool) -> (result: NominalModuleList) {
    let buckets_list: TargetNominalBucketsList = build_target_nominal_buckets<M, N>(sources, flat_pages, locals);
    iterate i over sources carrying st: NominalResolutionBuild = NominalResolutionBuild { rest: modules, all: modules, locals: locals, acc: NominalModuleList.NMNil } {
        next st = resolve_project_nominal_module<M, N>(sources, flat_pages, buckets_list, decl_only_spans, st);
    }
    return st.acc;
}
fn resolve_project_nominal_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], buckets_list: TargetNominalBucketsList, decl_only_spans: bool, st: NominalResolutionBuild) -> (result: NominalResolutionBuild) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => resolve_project_nominal_module_one<M, N>(sources, flat_pages, buckets_list, decl_only_spans, st, parsed, rest)
    };
}
fn resolve_project_nominal_module_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], buckets_list: TargetNominalBucketsList, decl_only_spans: bool, st: NominalResolutionBuild, parsed: ParsedModule, rest: ModuleList) -> (result: NominalResolutionBuild) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let input_stride: u64 = module_stride(sources, parsed.source_index);
    let input_total: u64 = module_total(sources, parsed.source_index);
    let found: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, st.locals, parsed.source_index);
    let spans: decl.NominalTypeSpanList = select_module_nominal_spans<N>(input_pages, input_stride, input_total, parsed.unit, decl_only_spans);
    let references: decl.NominalTypeIdentityList = project_nominal_spans_bucketed<M, N>(sources, flat_pages, parsed, st.all, buckets_list, spans);
    let refreshed_local: decl.NominalTypeIdentityList = decl.local_nominal_type_identities_using_references<1024, N>(input_pages, input_stride, input_total, parsed.unit, references);
    let resolved: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(input_pages, input_stride, input_total, refreshed_local, references);
    let cached: NominalModule = NominalModule { source_index: parsed.source_index, local: refreshed_local, resolved: resolved };
    return NominalResolutionBuild { ..st, rest: rest, acc: NominalModuleList.NMCons { head: cached, tail: st.acc } };
}

fn project_nominal_spans_only<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, current: ParsedModule, all: ModuleList, locals: NominalModuleList, local: decl.NominalTypeIdentityList, spans: decl.NominalTypeSpanList) -> (result: decl.NominalTypeIdentityList) {
    let initial: ProjectNominalWalk = ProjectNominalWalk { spans: spans, current: current, all: all, locals: locals, local: local, acc: decl.NominalTypeIdentityList.NINil };
    iterate chunk up_to 64 carrying st: ProjectNominalWalk = initial {
        if decl.nominal_type_span_list_empty(st.spans) {
            return decl.nominal_reference_entries<1024, N>(input_pages, input_stride, input_total, st.acc);
        }
        next st = project_nominal_span_chunk<M, N>(sources, flat_pages, input_pages, input_stride, input_total, st);
    }
    return decl.nominal_reference_entries<1024, N>(input_pages, input_stride, input_total, st.acc);
}
fn project_nominal_references_only<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, current: ParsedModule, all: ModuleList, locals: NominalModuleList, local: decl.NominalTypeIdentityList) -> (result: decl.NominalTypeIdentityList) {
    let spans: decl.NominalTypeSpanList = decl.collect_unit_nominal_type_spans<1024, N>(input_pages, input_stride, input_total, current.unit);
    return project_nominal_spans_only<M, N>(sources, flat_pages, input_pages, input_stride, input_total, current, all, locals, local, spans);
}
fn project_nominal_type_identities<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, all: ModuleList, locals: NominalModuleList, local: decl.NominalTypeIdentityList) -> (result: decl.NominalTypeIdentityList) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, current.source_index);
    let input_stride: u64 = module_stride(sources, current.source_index);
    let input_total: u64 = module_total(sources, current.source_index);
    let references: decl.NominalTypeIdentityList = project_nominal_references_only<M, N>(sources, flat_pages, input_pages, input_stride, input_total, current, all, locals, local);
    return decl.combine_nominal_type_identities<1024, N>(input_pages, input_stride, input_total, local, references);
}
fn project_nominal_span_chunk<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, initial: ProjectNominalWalk) -> (result: ProjectNominalWalk) {
    iterate i up_to 1024 carrying st: ProjectNominalWalk = initial {
        if decl.nominal_type_span_list_empty(st.spans) { return st; }
        next st = project_nominal_span_step<M, N>(sources, flat_pages, input_pages, input_stride, input_total, st);
    }
    return st;
}
fn project_nominal_span_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, st: ProjectNominalWalk) -> (result: ProjectNominalWalk) {
    return match st.spans {
        decl.NominalTypeSpanList.NSNil => st,
        decl.NominalTypeSpanList.NSCons { head: span, tail: rest } => project_nominal_span_one<M, N>(sources, flat_pages, input_pages, input_stride, input_total, st, span, rest)
    };
}
fn project_nominal_span_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, st: ProjectNominalWalk, span: decl.NominalTypeSpan, rest: decl.NominalTypeSpanList) -> (result: ProjectNominalWalk) {
    if span.kind == 5 {
        let local_lk: decl.NominalLookup = decl.nominal_identity_by_name<1024, N>(input_pages, input_stride, input_total, st.local, span.start, span.end);
        if local_lk.found { return ProjectNominalWalk { ..st, spans: rest }; }
    }
    let uses: NominalUseResult = resolve_nominal_in_uses<M, N>(sources, flat_pages, input_pages, input_stride, input_total, st.current, st.all, st.locals, span);
    if !(uses.found) || uses.count != 1 || !(uses.identity.valid) { return ProjectNominalWalk { ..st, spans: rest }; }
    let reference: decl.NominalTypeIdentity = decl.NominalTypeIdentity { start: span.start, end: span.end, identity: uses.identity, reference: true };
    return ProjectNominalWalk { ..st, spans: rest, acc: decl.NominalTypeIdentityList.NICons { head: reference, tail: st.acc } };
}
record NominalUseResult { found: bool, count: u64, identity: decl.SemanticIdentity }
fn resolve_nominal_in_uses<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, current: ParsedModule, all: ModuleList, locals: NominalModuleList, span: decl.NominalTypeSpan) -> (result: NominalUseResult) {
    iterate i up_to 1024 carrying st: NominalUseWalk = NominalUseWalk { uses: current.unit.uses, current: current, all: all, locals: locals, span: span, found: false, count: 0, identity: decl.invalid_semantic_identity() } {
        if decl.use_list_empty(st.uses) { return NominalUseResult { found: st.found, count: st.count, identity: st.identity }; }
        next st = resolve_nominal_use_step<M, N>(sources, flat_pages, input_pages, input_stride, input_total, st);
    }
    return NominalUseResult { found: st.found, count: st.count, identity: st.identity };
}
fn resolve_nominal_use_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, st: NominalUseWalk) -> (result: NominalUseWalk) {
    return match st.uses {
        decl.UseList.UNil => st,
        decl.UseList.UCons { head: usage, tail: rest } => resolve_nominal_use_one<M, N>(sources, flat_pages, input_pages, input_stride, input_total, st, usage, rest)
    };
}
fn resolve_nominal_use_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, st: NominalUseWalk, usage: decl.UseDecl, rest: decl.UseList) -> (result: NominalUseWalk) {
    if !(nominal_span_matches_use<N>(input_pages, input_stride, input_total, st.span, usage)) { return NominalUseWalk { ..st, uses: rest }; }
    let target: ModuleLookup = find_import_target<M, N>(sources, flat_pages, st.all, st.current, usage);
    if !(target.found) { return NominalUseWalk { ..st, uses: rest }; }
    let prefix_start: u64 = select(usage.has_alias, usage.alias_start, usage.module_start);
    let prefix_end: u64 = select(usage.has_alias, usage.alias_end, usage.module_end);
    let name_start: u64 = select(st.span.kind == 6, st.span.start + (prefix_end - prefix_start) + 1, st.span.start);
    let identity: decl.SemanticIdentity = nominal_identity_from_target<M, N>(sources, flat_pages, st.all, st.locals, target.index, st.current.source_index, name_start, st.span.end);
    if !(identity.valid) { return NominalUseWalk { ..st, uses: rest }; }
    let first: bool = st.count == 0;
    let same: bool = first || decl.semantic_identity_equal(st.identity, identity);
    let previous_identity: decl.SemanticIdentity = select_semantic_identity(first, identity, st.identity);
    if first { return NominalUseWalk { ..st, uses: rest, found: true, count: st.count + 1, identity: previous_identity }; }
    return NominalUseWalk { ..st, uses: rest, found: st.found && same, count: st.count + 1, identity: previous_identity };
}
fn nominal_span_matches_use<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, span: decl.NominalTypeSpan, usage: decl.UseDecl) -> (result: bool) {
    if span.end <= span.start { return false; }
    if span.kind == 5 { return !(usage.has_alias) && decl.spans_equal<1024, N>(pages, stride, total, span.start, span.end, span.start, span.end); }
    let prefix_start: u64 = select(usage.has_alias, usage.alias_start, usage.module_start);
    let prefix_end: u64 = select(usage.has_alias, usage.alias_end, usage.module_end);
    if prefix_end <= prefix_start || span.end - span.start <= prefix_end - prefix_start + 1 { return false; }
    if !(decl.spans_equal<1024, N>(pages, stride, total, span.start, span.start + (prefix_end - prefix_start), prefix_start, prefix_end)) { return false; }
    return source.byte_at_global<1024, N>(pages, stride, total, span.start + (prefix_end - prefix_start)) == 46;
}
fn select_semantic_identity(first: bool, candidate: decl.SemanticIdentity, previous: decl.SemanticIdentity) -> (result: decl.SemanticIdentity) {
    if first { return candidate; }
    return previous;
}
fn nominal_identity_from_target<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, locals: NominalModuleList, target_index: u64, caller_index: u64, name_start: u64, name_end: u64) -> (result: decl.SemanticIdentity) {
    iterate i over sources carrying st: TargetIdentityWalk = TargetIdentityWalk { modules: modules, locals: locals, target_index: target_index, caller_index: caller_index, name_start: name_start, name_end: name_end, found: false, identity: decl.invalid_semantic_identity() } {
        next st = nominal_target_step<M, N>(sources, flat_pages, st);
    }
    return st.identity;
}
fn nominal_target_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetIdentityWalk) -> (result: TargetIdentityWalk) {
    if st.found { return st; }
    return match st.modules {
        MNil => st,
        MCons { head: target, tail: rest } => nominal_target_candidate<M, N>(sources, flat_pages, st, target, rest)
    };
}
fn nominal_target_candidate<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetIdentityWalk, target: ParsedModule, rest: ModuleList) -> (result: TargetIdentityWalk) {
    if target.source_index != st.target_index { return TargetIdentityWalk { ..st, modules: rest }; }
    let local: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, st.locals, target.source_index);
    let matched: decl.SemanticIdentity = target_nominal_by_name<M, N>(sources, flat_pages, target, local.facts.local, st.caller_index, st.name_start, st.name_end);
    return TargetIdentityWalk { ..st, modules: ModuleList.MNil, found: matched.valid, identity: matched };
}
fn target_nominal_by_name<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target: ParsedModule, local: decl.NominalTypeIdentityList, caller_index: u64, name_start: u64, name_end: u64) -> (result: decl.SemanticIdentity) {
    let records: TargetTypeWalk = search_target_records<M, N>(sources, flat_pages, target, local, caller_index, name_start, name_end);
    if records.found { return records.identity; }
    let enums: TargetTypeWalk = search_target_enums<M, N>(sources, flat_pages, records, target.unit.enums);
    return enums.identity;
}
fn search_target_records<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target: ParsedModule, local: decl.NominalTypeIdentityList, caller_index: u64, name_start: u64, name_end: u64) -> (result: TargetTypeWalk) {
    let target_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, target.source_index);
    let target_stride: u64 = module_stride(sources, target.source_index);
    let target_total: u64 = module_total(sources, target.source_index);
    let initial: TargetTypeWalk = TargetTypeWalk { enums: decl.EnumList.GNil, records: target.unit.records, local: local, target_index: target.source_index, caller_index: caller_index, name_start: name_start, name_end: name_end, found: false, identity: decl.invalid_semantic_identity() };
    iterate chunk up_to 64 carrying st: TargetTypeWalk = initial {
        if st.found || record_decl_list_empty(st.records) { return st; }
        next st = search_target_record_chunk<M, N>(sources, flat_pages, target_pages, target_stride, target_total, st);
    }
    return st;
}
fn search_target_record_chunk<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_pages: [[byte; up_to N]; up_to 1024], target_stride: u64, target_total: u64, initial: TargetTypeWalk) -> (result: TargetTypeWalk) {
    iterate i up_to 1024 carrying st: TargetTypeWalk = initial {
        if st.found || record_decl_list_empty(st.records) { return st; }
        next st = search_target_record_step<M, N>(sources, flat_pages, target_pages, target_stride, target_total, st);
    }
    return st;
}
fn search_target_record_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_pages: [[byte; up_to N]; up_to 1024], target_stride: u64, target_total: u64, st: TargetTypeWalk) -> (result: TargetTypeWalk) {
    if st.found { return st; }
    return match st.records {
        decl.RecordList.RNil => st,
        decl.RecordList.RCons { head: item, tail: rest } => search_target_record_one<M, N>(sources, flat_pages, target_pages, target_stride, target_total, st, item, rest)
    };
}
fn search_target_record_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_pages: [[byte; up_to N]; up_to 1024], target_stride: u64, target_total: u64, st: TargetTypeWalk, item: decl.RecordDecl, rest: decl.RecordList) -> (result: TargetTypeWalk) {
    if spans_equal_between<M, N>(sources, flat_pages, st.caller_index, st.name_start, st.name_end, st.target_index, item.name_start, item.name_end) {
        let found: decl.NominalLookup = decl.nominal_identity_by_name<1024, N>(target_pages, target_stride, target_total, st.local, item.name_start, item.name_end);
        return TargetTypeWalk { ..st, records: decl.RecordList.RNil, found: found.found, identity: found.identity };
    }
    return TargetTypeWalk { ..st, records: rest };
}
fn search_target_enums<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetTypeWalk, enums: decl.EnumList) -> (result: TargetTypeWalk) {
    let target_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, st.target_index);
    let target_stride: u64 = module_stride(sources, st.target_index);
    let target_total: u64 = module_total(sources, st.target_index);
    let initial: TargetTypeWalk = TargetTypeWalk { ..st, enums: enums };
    iterate chunk up_to 64 carrying current: TargetTypeWalk = initial {
        if current.found || enum_decl_list_empty(current.enums) { return current; }
        next current = search_target_enum_chunk<M, N>(sources, flat_pages, target_pages, target_stride, target_total, current);
    }
    return current;
}
fn search_target_enum_chunk<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_pages: [[byte; up_to N]; up_to 1024], target_stride: u64, target_total: u64, initial: TargetTypeWalk) -> (result: TargetTypeWalk) {
    iterate i up_to 1024 carrying current: TargetTypeWalk = initial {
        if current.found || enum_decl_list_empty(current.enums) { return current; }
        next current = search_target_enum_step<M, N>(sources, flat_pages, target_pages, target_stride, target_total, current);
    }
    return current;
}
fn search_target_enum_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_pages: [[byte; up_to N]; up_to 1024], target_stride: u64, target_total: u64, st: TargetTypeWalk) -> (result: TargetTypeWalk) {
    if st.found { return st; }
    return match st.enums {
        decl.EnumList.GNil => st,
        decl.EnumList.GCons { head: item, tail: rest } => search_target_enum_one<M, N>(sources, flat_pages, target_pages, target_stride, target_total, st, item, rest)
    };
}
fn search_target_enum_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target_pages: [[byte; up_to N]; up_to 1024], target_stride: u64, target_total: u64, st: TargetTypeWalk, item: decl.EnumDecl, rest: decl.EnumList) -> (result: TargetTypeWalk) {
    if spans_equal_between<M, N>(sources, flat_pages, st.caller_index, st.name_start, st.name_end, st.target_index, item.name_start, item.name_end) {
        let found: decl.NominalLookup = decl.nominal_identity_by_name<1024, N>(target_pages, target_stride, target_total, st.local, item.name_start, item.name_end);
        return TargetTypeWalk { ..st, enums: decl.EnumList.GNil, found: found.found, identity: found.identity };
    }
    return TargetTypeWalk { ..st, enums: rest };
}
fn spans_equal_between<M: Nat, N: Nat>(
    sources: [ProjectSource; up_to 64],
    flat_pages: [[byte; up_to N]; up_to M],
    left_index: u64,
    left_start: u64,
    left_end: u64,
    right_index: u64,
    right_start: u64,
    right_end: u64
) -> (result: bool) {
    if left_end < left_start || right_end < right_start { return false; }
    if left_end - left_start != right_end - right_start { return false; }
    // CP-0021: counted byte fuel replaces the old view-length fuel. The
    // 1024-byte compared-span ceiling matches the old view ceiling; the
    // post-check keeps longer spans exact by refusing prefix-equal
    // verdicts when fuel runs out (fail closed, never trap).
    // The module slices resolve once here, never per step: page slicing
    // allocates, and per-step slicing over multi-page modules exhausts
    // the backend value arena (16 MiB) on real compiler modules.
    let left_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, left_index);
    let left_stride: u64 = module_stride(sources, left_index);
    let left_total: u64 = module_total(sources, left_index);
    let right_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, right_index);
    let right_stride: u64 = module_stride(sources, right_index);
    let right_total: u64 = module_total(sources, right_index);
    iterate i up_to 1024 carrying st: SpanCompare = SpanCompare {
        length: left_end - left_start,
        left_index: left_index,
        left_start: left_start,
        right_index: right_index,
        right_start: right_start,
        offset: 0,
        equal: true
    } {
        if !(st.equal) || st.offset >= st.length { return st.equal && st.offset >= st.length; }
        next st = span_compare_step<N>(left_pages, left_stride, left_total, right_pages, right_stride, right_total, st);
    }
    return st.equal && st.offset >= st.length;
}
fn spans_equal_pages<N: Nat>(
    left_pages: [[byte; up_to N]; up_to 1024],
    left_stride: u64,
    left_total: u64,
    left_start: u64,
    left_end: u64,
    right_pages: [[byte; up_to N]; up_to 1024],
    right_stride: u64,
    right_total: u64,
    right_start: u64,
    right_end: u64
) -> (result: bool) {
    if left_end < left_start || right_end < right_start { return false; }
    if left_end - left_start != right_end - right_start { return false; }
    iterate i up_to 1024 carrying st: SpanCompare = SpanCompare {
        length: left_end - left_start,
        left_index: 0,
        left_start: left_start,
        right_index: 0,
        right_start: right_start,
        offset: 0,
        equal: true
    } {
        if !(st.equal) || st.offset >= st.length { return st.equal && st.offset >= st.length; }
        next st = span_compare_step<N>(left_pages, left_stride, left_total, right_pages, right_stride, right_total, st);
    }
    return st.equal && st.offset >= st.length;
}
record SpanCompare {
    length: u64,
    left_index: u64,
    left_start: u64,
    right_index: u64,
    right_start: u64,
    offset: u64,
    equal: bool
}
fn span_compare_step<N: Nat>(left_pages: [[byte; up_to N]; up_to 1024], left_stride: u64, left_total: u64, right_pages: [[byte; up_to N]; up_to 1024], right_stride: u64, right_total: u64, st: SpanCompare) -> (result: SpanCompare) {
    if !(st.equal) || st.offset >= st.length { return st; }
    let a: u64 = source.byte_at_global<1024, N>(left_pages, left_stride, left_total, st.left_start + st.offset);
    let b: u64 = source.byte_at_global<1024, N>(right_pages, right_stride, right_total, st.right_start + st.offset);
    return SpanCompare {
        length: st.length,
        left_index: st.left_index,
        left_start: st.left_start,
        right_index: st.right_index,
        right_start: st.right_start,
        offset: st.offset + 1,
        equal: a == b
    };
}

fn reverse_imports<M: Nat>(sources: [ProjectSource; up_to M], imports: ImportList) -> (result: ImportList) {
    // Four 1024-link chunks retain the complete project-wide bound.
    let first: ImportReverse = reverse_import_part(ImportReverse { rest: imports, acc: ImportList.INil });
    let second: ImportReverse = reverse_import_part(first);
    let third: ImportReverse = reverse_import_part(second);
    let fourth: ImportReverse = reverse_import_part(third);
    return fourth.acc;
}
fn reverse_import_part(initial: ImportReverse) -> (result: ImportReverse) {
    iterate i up_to 1024 carrying st: ImportReverse = initial {
        if import_list_empty(st.rest) { return st; }
        next st = reverse_import_step(st);
    }
    return st;
}
record ImportReverse { rest: ImportList, acc: ImportList }
fn reverse_import_step(st: ImportReverse) -> (result: ImportReverse) {
    return match st.rest {
        INil => st,
        ICons { head: h, tail: t } => ImportReverse { rest: t, acc: ImportList.ICons { head: h, tail: st.acc } }
    };
}
fn append_diagnostics<M: Nat>(sources: [ProjectSource; up_to M], first: DiagnosticList, second: DiagnosticList) -> (result: DiagnosticList) {
    iterate chunk up_to 1024 carrying outer: DiagnosticReverse = DiagnosticReverse { rest: first, acc: second } {
        iterate i up_to 1024 carrying inner: DiagnosticReverse = outer {
            if diagnostic_list_empty(inner.rest) { return inner.acc; }
            next inner = append_diagnostic_step(inner);
        }
        if diagnostic_list_empty(inner.rest) { return inner.acc; }
        next outer = inner;
    }
    return outer.acc;
}
fn append_diagnostic_step(st: DiagnosticReverse) -> (result: DiagnosticReverse) {
    return match st.rest {
        DiagNil => st,
        DiagCons { head: h, tail: t } => DiagnosticReverse { rest: t, acc: DiagnosticList.DiagCons { head: h, tail: st.acc } }
    };
}
fn reverse_diagnostics<M: Nat>(sources: [ProjectSource; up_to M], diagnostics: DiagnosticList) -> (result: DiagnosticList) {
    iterate chunk up_to 1024 carrying outer: DiagnosticReverse = DiagnosticReverse { rest: diagnostics, acc: DiagnosticList.DiagNil } {
        iterate i up_to 1024 carrying inner: DiagnosticReverse = outer {
            if diagnostic_list_empty(inner.rest) { return inner.acc; }
            next inner = reverse_diagnostic_step(inner);
        }
        if diagnostic_list_empty(inner.rest) { return inner.acc; }
        next outer = inner;
    }
    return outer.acc;
}
fn diagnostic_list_empty(diagnostics: DiagnosticList) -> (result: bool) {
    return match diagnostics {
        DiagNil => true,
        DiagCons { head: diagnostic, tail: rest } => false
    };
}
fn reverse_diagnostic_step(st: DiagnosticReverse) -> (result: DiagnosticReverse) {
    return match st.rest {
        DiagNil => st,
        DiagCons { head: h, tail: t } => DiagnosticReverse { rest: t, acc: DiagnosticList.DiagCons { head: h, tail: st.acc } }
    };
}
record DiagnosticCount { rest: DiagnosticList, count: u64 }
fn diagnostics_empty<M: Nat>(sources: [ProjectSource; up_to M], diagnostics: DiagnosticList) -> (result: bool) {
    iterate i over sources carrying st: DiagnosticCount = DiagnosticCount { rest: diagnostics, count: 0 } {
        next st = diagnostic_count_step(st);
    }
    return st.count == 0;
}
fn diagnostic_count_step(st: DiagnosticCount) -> (result: DiagnosticCount) {
    return match st.rest {
        DiagNil => st,
        DiagCons { head: h, tail: t } => DiagnosticCount { rest: t, count: st.count + 1 }
    };
}
fn order_diagnostics<M: Nat>(sources: [ProjectSource; up_to M], ordered: bool, counts_match: bool) -> (result: DiagnosticList) {
    if !(ordered) { return DiagnosticList.DiagCons { head: ProjectDiagnostic.SourceOrder { source_index: 0 }, tail: DiagnosticList.DiagNil }; }
    if !(counts_match) { return DiagnosticList.DiagCons { head: ProjectDiagnostic.SourceCountMismatch { source_index: sources.len }, tail: DiagnosticList.DiagNil }; }
    return DiagnosticList.DiagNil;
}

// Build an imported signature environment from already parsed module facts.
// Transport preserves sequence bounds and parameter order while nominal
// ownership is resolved by identity instead of matching type spelling.
// Provider signatures and nominal ownership are immutable within one
// project invocation. The cache is deliberately local to imported_signatures:
// source_index is unique in that invocation, and no fact survives a new
// source snapshot or compiler request.
record ProviderSignatureFacts { source_index: u64, signatures: decl.SigTab, nominals: decl.NominalTypeIdentityList }
enum ProviderSignatureFactsList { PSNil, PSCons { head: ProviderSignatureFacts, tail: ProviderSignatureFactsList } }
record ProviderSignatureLookupWalk { rest: ProviderSignatureFactsList, target_index: u64, found: bool, signatures: decl.SigTab, nominals: decl.NominalTypeIdentityList }
record ProviderSignatureLookup { found: bool, signatures: decl.SigTab, nominals: decl.NominalTypeIdentityList }
record ResolvedImportFact { member_start: u64, member_end: u64, provider_source_index: u64, signature: decl.Sig }
enum ResolvedImportFactList { RIFNil, RIFCons { head: ResolvedImportFact, tail: ResolvedImportFactList } }
record ResolvedImportFactCache { facts: ResolvedImportFactList, count: u64 }
record ResolvedImportLookupWalk { rest: ResolvedImportFactList, member_start: u64, member_end: u64, provider_source_index: u64, found: bool, signature: decl.Sig }
record ResolvedImportLookup { found: bool, signature: decl.Sig }
record TargetSignatureResult { acc: decl.SigTab, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache }
record UseSignatureResult { acc: decl.SigTab, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache }
record ExportSignatureResult { acc: decl.SigTab, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache }
record ProviderLocalSigEntry { source_index: u64, name_start: u64, name_end: u64, sig: decl.Sig }
enum ProviderLocalSigBucketList { PLSCNil, PLSCCons { head: ProviderLocalSigEntry, tail: ProviderLocalSigBucketList } }
record ProviderLocalSigCache { buckets: [ProviderLocalSigBucketList; 64] }
record ProviderLocalSigLookup { found: bool, sig: decl.Sig }
record TargetOwnedSigResult { owned: decl.Sig, local_sig_cache: ProviderLocalSigCache }
record CallSigResult { tab: decl.SigTab, local_sig_cache: ProviderLocalSigCache }
record SelectedLocalSigResult { acc: decl.SigTab, local_sig_cache: ProviderLocalSigCache }
fn empty_provider_local_sig_cache() -> (result: ProviderLocalSigCache) {
    return ProviderLocalSigCache { buckets: [ProviderLocalSigBucketList.PLSCNil; 64] };
}
fn local_sig_bucket64(source_index: u64, name_start: u64, name_end: u64) -> (result: u64) {
    return (source_index * 31 + name_start + name_end) % 64;
}
fn insert_cached_local_sig(cache: ProviderLocalSigCache, source_index: u64, name_start: u64, name_end: u64, sig: decl.Sig) -> (result: ProviderLocalSigCache) {
    let b: u64 = local_sig_bucket64(source_index, name_start, name_end);
    let entry: ProviderLocalSigEntry = ProviderLocalSigEntry { source_index: source_index, name_start: name_start, name_end: name_end, sig: sig };
    let updated: ProviderLocalSigBucketList = ProviderLocalSigBucketList.PLSCCons { head: entry, tail: cache.buckets[b] };
    return ProviderLocalSigCache { buckets: replace(cache.buckets, b, updated) };
}
fn provider_local_sig_bucket_empty(cache: ProviderLocalSigBucketList) -> (result: bool) {
    return match cache { PLSCNil => true, PLSCCons { head: h, tail: t } => false };
}
fn provider_local_sig_bucket_matches(cache: ProviderLocalSigBucketList, source_index: u64, name_start: u64, name_end: u64) -> (result: bool) {
    return match cache {
        PLSCNil => false,
        PLSCCons { head: h, tail: t } => h.source_index == source_index && h.name_start == name_start && h.name_end == name_end
    };
}
fn empty_decl_signature() -> (result: decl.Sig) {
    return decl.Sig { start: 0, end: 0, params: decl.BindList.BNil, nparams: 0, generic_bounds: decl.GenericBoundList.KNil, result: decl.SemType.TPoison, fx: decl.EffectList.XNil, raw_capabilities: decl.CapList.ANil, effects: decl.EffectIdentityList.EINil, capabilities: decl.CapabilityIdentityList.CINil, identity: decl.invalid_semantic_identity() };
}
fn provider_local_sig_bucket_head_sig_or(cache: ProviderLocalSigBucketList, fallback: decl.Sig) -> (result: decl.Sig) {
    return match cache {
        PLSCNil => fallback,
        PLSCCons { head: h, tail: t } => h.sig
    };
}
fn provider_local_sig_bucket_tail(cache: ProviderLocalSigBucketList) -> (result: ProviderLocalSigBucketList) {
    return match cache { PLSCNil => ProviderLocalSigBucketList.PLSCNil, PLSCCons { head: h, tail: t } => t };
}
fn lookup_cached_local_sig_or(cache: ProviderLocalSigCache, source_index: u64, name_start: u64, name_end: u64, empty_sig: decl.Sig) -> (result: ProviderLocalSigLookup) {
    let b: u64 = local_sig_bucket64(source_index, name_start, name_end);
    iterate chunk up_to 16 carrying outer: ProviderLocalSigBucketList = cache.buckets[b] {
        iterate i up_to 1024 carrying rest: ProviderLocalSigBucketList = outer {
            if provider_local_sig_bucket_empty(rest) { return ProviderLocalSigLookup { found: false, sig: empty_sig }; }
            if provider_local_sig_bucket_matches(rest, source_index, name_start, name_end) {
                return ProviderLocalSigLookup { found: true, sig: provider_local_sig_bucket_head_sig_or(rest, empty_sig) };
            }
            next rest = provider_local_sig_bucket_tail(rest);
        }
        if provider_local_sig_bucket_empty(rest) { return ProviderLocalSigLookup { found: false, sig: empty_sig }; }
        next outer = rest;
    }
    return ProviderLocalSigLookup { found: false, sig: empty_sig };
}
fn lookup_cached_local_sig(cache: ProviderLocalSigCache, source_index: u64, name_start: u64, name_end: u64) -> (result: ProviderLocalSigLookup) {
    return lookup_cached_local_sig_or(cache, source_index, name_start, name_end, empty_decl_signature());
}
record CallSigWalk { rest: decl.CallSiteList, acc: decl.SigTab, nominals: decl.NominalTypeIdentityList, modules: NominalModuleList, local_declarations: decl.FnList, local_sig_cache: ProviderLocalSigCache, fn_buckets: ProviderFnBucketsList, use_current_buckets: bool, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, empty_sig: decl.Sig }
record UseSigWalk { rest: decl.UseList, call: decl.CallSite, acc: decl.SigTab, nominals: decl.NominalTypeIdentityList, modules: NominalModuleList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, fn_buckets: ProviderFnBucketsList, empty_sig: decl.Sig }
record TargetSigWalk { rest: ModuleList, modules: NominalModuleList, target_index: u64, cache_provider_index: u64, member_start: u64, current: ParsedModule, call: decl.CallSite, acc: decl.SigTab, caller_nominals: decl.NominalTypeIdentityList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, fn_buckets: ProviderFnBucketsList, empty_sig: decl.Sig }
record ExportSigWalk { rest: decl.SigTab, caller: ParsedModule, target: ParsedModule, member_start: u64, member_end: u64, call: decl.CallSite, caller_nominals: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, acc: decl.SigTab, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache }
record CallPrefixMatch { matched: bool, member_start: u64 }
record LocalFnSearchWalk { rest: decl.FnList, member_start: u64, member_end: u64, found: bool, selected: decl.FnList }
record ProviderDeclaringMatch { found: bool, declaring_source_index: u64 }
record ProviderSearchState { stack: [u64; 128], sp: u64, visited: [bool; 64], found: bool, declaring_source_index: u64 }
record ProviderVisitWalk { rest: ModuleList, target_index: u64, state: ProviderSearchState, done: bool }
record PushUsesWalk { rest: decl.UseList, stack: [u64; 128], sp: u64, visited: [bool; 64] }
record BareUseSearchWalk { rest: decl.UseList, found: bool, conflict: bool, declaring_source_index: u64 }

// Direct flat_pages accessors avoid allocating per-module 1024-page view
// slices during cross-module signature lookup, nominal transport, and closure scan.
fn byte_at_flat_source<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, offset: u64) -> (result: u64) {
    if source_index >= sources.len { return 256; }
    let src: ProjectSource = sources[source_index];
    if src.stride == 0 || offset >= src.total { return 256; }
    let page: u64 = offset / src.stride;
    if page >= src.page_count { return 256; }
    let flat_idx: u64 = src.page_start + page;
    if flat_idx >= flat_pages.len { return 256; }
    let intra: u64 = offset % src.stride;
    let view: [byte; up_to N] = flat_pages[flat_idx];
    if intra >= view.len { return 256; }
    return view[intra] as u64;
}
fn spans_equal_flat_sources<M: Nat, N: Nat>(
    sources: [ProjectSource; up_to 64],
    flat_pages: [[byte; up_to N]; up_to M],
    left_index: u64,
    left_start: u64,
    left_end: u64,
    right_index: u64,
    right_start: u64,
    right_end: u64
) -> (result: bool) {
    if left_end < left_start || right_end < right_start { return false; }
    let len: u64 = left_end - left_start;
    if len != right_end - right_start { return false; }
    if left_index >= sources.len || right_index >= sources.len { return false; }
    if len > 1024 { return false; }
    iterate i up_to 1024 carrying off: u64 = 0 {
        if off >= len { return true; }
        if byte_at_flat_source<M, N>(sources, flat_pages, left_index, left_start + off)
            != byte_at_flat_source<M, N>(sources, flat_pages, right_index, right_start + off) {
            return false;
        }
        next off = off + 1;
    }
    return off >= len;
}
fn decl_name_bucket64_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, start: u64, end: u64) -> (result: u64) {
    if source_index >= sources.len { return 0; }
    let total: u64 = sources[source_index].total;
    if end <= start || end > total { return 0; }
    let len: u64 = end - start;
    let a: u64 = byte_at_flat_source<M, N>(sources, flat_pages, source_index, start);
    let b: u64 = byte_at_flat_source<M, N>(sources, flat_pages, source_index, end - 1);
    let c: u64 = byte_at_flat_source<M, N>(sources, flat_pages, source_index, start + len / 2);
    return (len + a * 31 + b * 7 + c * 13) % 64;
}
fn identity_span_matches_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, wanted: decl.SemanticIdentity, offset: u64, start: u64, end: u64) -> (result: bool) {
    if source_index >= sources.len { return false; }
    let total: u64 = sources[source_index].total;
    if end <= start || end > total { return false; }
    let size: u64 = end - start;
    if offset > wanted.len || size > wanted.len - offset || wanted.len > wanted.bytes.len { return false; }
    iterate i up_to 512 carrying n: u64 = 0 {
        if n >= size { return true; }
        let idx: u64 = offset + n;
        if idx >= wanted.bytes.len { return false; }
        if (byte_at_flat_source<M, N>(sources, flat_pages, source_index, start + n) as byte) != wanted.bytes[idx] { return false; }
        next n = n + 1;
    }
    return n == size;
}
fn function_identity_module_matches_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, module_start: u64, module_end: u64, wanted: decl.SemanticIdentity) -> (result: bool) {
    if source_index >= sources.len { return false; }
    let total: u64 = sources[source_index].total;
    if !(decl.function_identity_prefix_ok(wanted)) || module_end <= module_start || module_end > total { return false; }
    let mod_len: u64 = module_end - module_start;
    if 18 + mod_len + 2 >= wanted.len || wanted.len > wanted.bytes.len { return false; }
    if wanted.bytes[18 + mod_len] != (58 as byte) || wanted.bytes[18 + mod_len + 1] != (58 as byte) { return false; }
    return identity_span_matches_flat<M, N>(sources, flat_pages, source_index, wanted, 18, module_start, module_end);
}
fn select_fn_list_in_bucket_index(fn_buckets: ProviderFnBucketsList, source_index: u64, fallback_fns: decl.FnList, b: u64) -> (result: decl.FnList) {
    let node: ProviderFnBucketsList = find_provider_fn_buckets_node(fn_buckets, source_index);
    if provider_fn_buckets_empty(node) { return fallback_fns; }
    return provider_fn_buckets_head_bucket(node, b % 64);
}
fn nominal_identity_head_matches_name_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, list: decl.NominalTypeIdentityList, start: u64, end: u64) -> (result: bool) {
    return match list {
        NINil => false,
        NICons { head: item, tail: rest } => !(item.reference) && spans_equal_flat_sources<M, N>(sources, flat_pages, source_index, item.start, item.end, source_index, start, end)
    };
}
fn nominal_identity_by_name_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, types: decl.NominalTypeIdentityList, start: u64, end: u64) -> (result: decl.NominalLookup) {
    iterate chunk up_to 64 carrying outer: decl.NominalTypeIdentityList = types {
        iterate i up_to 1024 carrying rest: decl.NominalTypeIdentityList = outer {
            if decl.nominal_type_identity_list_empty(rest) {
                return decl.NominalLookup { found: false, identity: decl.invalid_semantic_identity() };
            }
            if nominal_identity_head_matches_name_flat<M, N>(sources, flat_pages, source_index, rest, start, end) {
                let item: decl.NominalTypeIdentity = decl.nominal_identity_head(rest);
                return decl.NominalLookup { found: true, identity: item.identity };
            }
            next rest = decl.nominal_identity_tail(rest);
        }
        if decl.nominal_type_identity_list_empty(rest) {
            return decl.NominalLookup { found: false, identity: decl.invalid_semantic_identity() };
        }
        next outer = rest;
    }
    return decl.NominalLookup { found: false, identity: decl.invalid_semantic_identity() };
}

fn decl_name_bucket64<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: u64) {
    if end <= start || end > total { return 0; }
    let len: u64 = end - start;
    let a: u64 = source.byte_at_global<P, N>(pages, stride, total, start);
    let b: u64 = source.byte_at_global<P, N>(pages, stride, total, end - 1);
    let c: u64 = source.byte_at_global<P, N>(pages, stride, total, start + len / 2);
    return (len + a * 31 + b * 7 + c * 13) % 64;
}
fn empty_fn_buckets() -> (result: [decl.FnList; 64]) {
    return [decl.FnList.DNil; 64];
}
fn prepend_decl_fn_bucket<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, buckets: [decl.FnList; 64], fd: decl.FnDecl) -> (result: [decl.FnList; 64]) {
    let b: u64 = decl_name_bucket64<P, N>(pages, stride, total, fd.sig.name_start, fd.sig.name_end);
    return replace(buckets, b, decl.FnList.DCons { head: fd, tail: buckets[b] });
}
fn build_fn_buckets<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fns: decl.FnList) -> (result: [decl.FnList; 64]) {
    let initial: FnBucketsWalk = FnBucketsWalk { rest: fns, buckets: empty_fn_buckets() };
    iterate chunk up_to 64 carrying w: FnBucketsWalk = initial {
        if decl.declared_fn_list_empty(w.rest) { return w.buckets; }
        next w = build_fn_buckets_chunk<P, N>(pages, stride, total, w);
    }
    return w.buckets;
}
fn build_fn_buckets_chunk<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, initial: FnBucketsWalk) -> (result: FnBucketsWalk) {
    iterate i up_to 1024 carrying w: FnBucketsWalk = initial {
        if decl.declared_fn_list_empty(w.rest) { return w; }
        next w = match w.rest {
            decl.FnList.DNil => w,
            decl.FnList.DCons { head: fd, tail: rest } => FnBucketsWalk { rest: rest, buckets: prepend_decl_fn_bucket<P, N>(pages, stride, total, w.buckets, fd) }
        };
    }
    return w;
}
fn provider_fn_buckets_empty(list: ProviderFnBucketsList) -> (result: bool) {
    return match list { PFBNil => true, PFBCons { head: h, tail: t } => false };
}
fn provider_fn_buckets_head_matches(list: ProviderFnBucketsList, source_index: u64) -> (result: bool) {
    return match list { PFBNil => false, PFBCons { head: h, tail: t } => h.source_index == source_index };
}
fn provider_fn_buckets_tail(list: ProviderFnBucketsList) -> (result: ProviderFnBucketsList) {
    return match list { PFBNil => ProviderFnBucketsList.PFBNil, PFBCons { head: h, tail: t } => t };
}
fn provider_fn_buckets_head_bucket(list: ProviderFnBucketsList, bucket_idx: u64) -> (result: decl.FnList) {
    return match list { PFBNil => decl.FnList.DNil, PFBCons { head: h, tail: t } => h.buckets[bucket_idx] };
}
fn find_provider_fn_buckets_node(list: ProviderFnBucketsList, source_index: u64) -> (result: ProviderFnBucketsList) {
    iterate i up_to 64 carrying rest: ProviderFnBucketsList = list {
        if provider_fn_buckets_empty(rest) { return ProviderFnBucketsList.PFBNil; }
        if provider_fn_buckets_head_matches(rest, source_index) { return rest; }
        next rest = provider_fn_buckets_tail(rest);
    }
    return ProviderFnBucketsList.PFBNil;
}
fn build_provider_fn_buckets_list<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList) -> (result: ProviderFnBucketsList) {
    iterate i up_to 64 carrying st: ProviderFnBucketsBuild = ProviderFnBucketsBuild { rest: modules, acc: ProviderFnBucketsList.PFBNil } {
        if module_list_empty(st.rest) { return st.acc; }
        next st = build_provider_fn_buckets_step<M, N>(sources, flat_pages, st);
    }
    return st.acc;
}
fn build_provider_fn_buckets_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProviderFnBucketsBuild) -> (result: ProviderFnBucketsBuild) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => build_provider_fn_buckets_one<M, N>(sources, flat_pages, st.acc, parsed, rest)
    };
}
fn build_provider_fn_buckets_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], acc: ProviderFnBucketsList, parsed: ParsedModule, rest: ModuleList) -> (result: ProviderFnBucketsBuild) {
    if parsed.source_index >= sources.len || parsed.source_index >= 64 {
        return ProviderFnBucketsBuild { rest: rest, acc: acc };
    }
    let pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let stride: u64 = module_stride(sources, parsed.source_index);
    let total: u64 = module_total(sources, parsed.source_index);
    let buckets: [decl.FnList; 64] = build_fn_buckets<1024, N>(pages, stride, total, parsed.unit.fns);
    return ProviderFnBucketsBuild { rest: rest, acc: ProviderFnBucketsList.PFBCons { head: ProviderFnBuckets { source_index: parsed.source_index, buckets: buckets }, tail: acc } };
}
fn select_fn_list_in_buckets<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fn_buckets: ProviderFnBucketsList, source_index: u64, fallback_fns: decl.FnList, start: u64, end: u64) -> (result: decl.FnList) {
    let node: ProviderFnBucketsList = find_provider_fn_buckets_node(fn_buckets, source_index);
    if provider_fn_buckets_empty(node) { return fallback_fns; }
    let b: u64 = decl_name_bucket64<P, N>(pages, stride, total, start, end);
    return provider_fn_buckets_head_bucket(node, b);
}

fn imported_signatures<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, all: ModuleList, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList) -> (result: decl.SigTab) {
    return resolve_call_signatures<M, N>(sources, flat_pages, current, all, nominals, nominal_modules, decl.FnList.DNil);
}
fn imported_signatures_with_buckets<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, all: ModuleList, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList, fn_buckets: ProviderFnBucketsList, use_current_buckets: bool) -> (result: decl.SigTab) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, current.source_index);
    let input_stride: u64 = module_stride(sources, current.source_index);
    let input_total: u64 = module_total(sources, current.source_index);
    let calls: decl.CallSiteList = decl.collect_call_sites<1024, N>(input_pages, input_stride, input_total, current.unit.fns);
    let res: CallSigResult = resolve_call_signatures_with_cache_and_sites_and_buckets<M, N>(sources, flat_pages, input_pages, input_stride, input_total, current, all, nominals, nominal_modules, decl.FnList.DNil, empty_provider_local_sig_cache(), fn_buckets, use_current_buckets, calls);
    return res.tab;
}
fn resolve_call_signatures<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, all: ModuleList, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList, local_declarations: decl.FnList) -> (result: decl.SigTab) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, current.source_index);
    let input_stride: u64 = module_stride(sources, current.source_index);
    let input_total: u64 = module_total(sources, current.source_index);
    let res: CallSigResult = resolve_call_signatures_with_cache<M, N>(sources, flat_pages, input_pages, input_stride, input_total, current, all, nominals, nominal_modules, local_declarations, empty_provider_local_sig_cache());
    return res.tab;
}
fn resolve_call_signatures_with_cache_and_sites_and_buckets<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, current: ParsedModule, all: ModuleList, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList, local_declarations: decl.FnList, local_sig_cache: ProviderLocalSigCache, fn_buckets: ProviderFnBucketsList, use_current_buckets: bool, calls: decl.CallSiteList) -> (result: CallSigResult) {
    let initial: CallSigWalk = CallSigWalk { rest: calls, acc: decl.SigTab.HNil, nominals: nominals, modules: nominal_modules, local_declarations: local_declarations, local_sig_cache: local_sig_cache, fn_buckets: fn_buckets, use_current_buckets: use_current_buckets, provider_facts: ProviderSignatureFactsList.PSNil, resolved: ResolvedImportFactCache { facts: ResolvedImportFactList.RIFNil, count: 0 }, empty_sig: empty_decl_signature() };
    iterate chunk up_to 64 carrying st: CallSigWalk = initial {
        if decl.call_site_list_empty(st.rest) { return CallSigResult { tab: st.acc, local_sig_cache: st.local_sig_cache }; }
        next st = imported_signature_chunk<M, N>(sources, flat_pages, input_pages, input_stride, input_total, current, all, st);
    }
    return CallSigResult { tab: st.acc, local_sig_cache: st.local_sig_cache };
}
fn resolve_call_signatures_with_cache_and_sites<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, current: ParsedModule, all: ModuleList, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList, local_declarations: decl.FnList, local_sig_cache: ProviderLocalSigCache, calls: decl.CallSiteList) -> (result: CallSigResult) {
    return resolve_call_signatures_with_cache_and_sites_and_buckets<M, N>(sources, flat_pages, input_pages, input_stride, input_total, current, all, nominals, nominal_modules, local_declarations, local_sig_cache, ProviderFnBucketsList.PFBNil, false, calls);
}
fn resolve_call_signatures_with_cache<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], input_pages: [[byte; up_to N]; up_to 1024], input_stride: u64, input_total: u64, current: ParsedModule, all: ModuleList, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList, local_declarations: decl.FnList, local_sig_cache: ProviderLocalSigCache) -> (result: CallSigResult) {
    let calls: decl.CallSiteList = decl.collect_call_sites<1024, N>(input_pages, input_stride, input_total, current.unit.fns);
    return resolve_call_signatures_with_cache_and_sites<M, N>(sources, flat_pages, input_pages, input_stride, input_total, current, all, nominals, nominal_modules, local_declarations, local_sig_cache, calls);
}
fn imported_signature_chunk<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], c_pages: [[byte; up_to N]; up_to 1024], c_stride: u64, c_total: u64, current: ParsedModule, all: ModuleList, initial: CallSigWalk) -> (result: CallSigWalk) {
    iterate i up_to 1024 carrying st: CallSigWalk = initial {
        if decl.call_site_list_empty(st.rest) { return st; }
        next st = imported_signature_for_call<M, N>(sources, flat_pages, c_pages, c_stride, c_total, current, all, st);
    }
    return st;
}
fn imported_signature_for_call<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], c_pages: [[byte; up_to N]; up_to 1024], c_stride: u64, c_total: u64, current: ParsedModule, all: ModuleList, st: CallSigWalk) -> (result: CallSigWalk) {
    return match st.rest {
        CNil => st,
        CCons { head: call, tail: rest } => imported_signature_for_one_call<M, N>(sources, flat_pages, c_pages, c_stride, c_total, current, all, call, rest, st)
    };
}
fn select_current_local_fns<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, current: ParsedModule, fn_buckets: ProviderFnBucketsList, use_current_buckets: bool, start: u64, end: u64) -> (result: decl.FnList) {
    if !(use_current_buckets) { return current.unit.fns; }
    return select_fn_list_in_buckets<P, N>(pages, stride, total, fn_buckets, current.source_index, current.unit.fns, start, end);
}
fn imported_signature_for_one_call<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], c_pages: [[byte; up_to N]; up_to 1024], c_stride: u64, c_total: u64, current: ParsedModule, all: ModuleList, call: decl.CallSite, rest: decl.CallSiteList, st: CallSigWalk) -> (result: CallSigWalk) {
    if !(call_has_dot<1024, N>(c_pages, c_stride, c_total, call.start, call.end)) {
        // Local declarations and built-in intrinsics take precedence over
        // unqualified imported bindings without touching any provider.
        let current_fns: decl.FnList = select_current_local_fns<1024, N>(c_pages, c_stride, c_total, current, st.fn_buckets, st.use_current_buckets, call.start, call.end);
        if module_has_local_fn_same<1024, N>(c_pages, c_stride, c_total, call.start, call.end, current_fns) {
            return CallSigWalk { ..st, rest: rest };
        }
        let local: LocalFnSearchWalk = find_local_fn_same<1024, N>(c_pages, c_stride, c_total, call.start, call.end, st.local_declarations);
        if local.found {
            let signature: SelectedLocalSigResult = selected_local_signature<M, N>(sources, flat_pages, c_pages, c_stride, c_total, current.source_index, current.unit, st.nominals, st.modules, local.selected, st.acc, st.local_sig_cache, st.empty_sig);
            return CallSigWalk { ..st, rest: rest, acc: signature.acc, local_sig_cache: signature.local_sig_cache };
        }
        if decl.stage0_intrinsic_known<1024, N>(c_pages, c_stride, c_total, call.start, call.end) {
            return CallSigWalk { ..st, rest: rest };
        }
        let bare: UseSignatureResult = resolve_bare_imported_call<M, N>(sources, flat_pages, all, current, call, st.acc, st.nominals, st.modules, st.provider_facts, st.resolved, st.local_sig_cache, st.fn_buckets, st.empty_sig);
        return CallSigWalk { ..st, rest: rest, acc: bare.acc, provider_facts: bare.provider_facts, resolved: bare.resolved, local_sig_cache: bare.local_sig_cache };
    }
    let uses: decl.UseList = current.unit.uses;
    let found: UseSignatureResult = signatures_from_uses_with_buckets<M, N>(sources, flat_pages, all, current, uses, call, st.acc, st.nominals, st.modules, st.provider_facts, st.resolved, st.local_sig_cache, st.fn_buckets, st.empty_sig);
    return CallSigWalk { ..st, rest: rest, acc: found.acc, provider_facts: found.provider_facts, resolved: found.resolved, local_sig_cache: found.local_sig_cache };
}
fn selected_local_signature<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, source_index: u64, unit: decl.Unit, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList, selected: decl.FnList, acc: decl.SigTab, local_sig_cache: ProviderLocalSigCache, empty_sig: decl.Sig) -> (result: SelectedLocalSigResult) {
    return match selected {
        DNil => SelectedLocalSigResult { acc: acc, local_sig_cache: local_sig_cache },
        DCons { head: fd, tail: rest } => prepend_selected_local_signature<M, N>(sources, flat_pages, pages, stride, total, source_index, unit, nominals, nominal_modules, fd, acc, local_sig_cache, empty_sig)
    };
}
fn prepend_selected_local_signature<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, source_index: u64, unit: decl.Unit, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList, fd: decl.FnDecl, acc: decl.SigTab, local_sig_cache: ProviderLocalSigCache, empty_sig: decl.Sig) -> (result: SelectedLocalSigResult) {
    let cached: ProviderLocalSigLookup = lookup_cached_local_sig_or(local_sig_cache, source_index, fd.sig.name_start, fd.sig.name_end, empty_sig);
    if cached.found {
        return SelectedLocalSigResult { acc: decl.SigTab.HCons { head: cached.sig, tail: acc }, local_sig_cache: local_sig_cache };
    }
    let mod_nom: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, nominal_modules, source_index);
    let sig_nominals: decl.NominalTypeIdentityList = select_combined_sig_nominals<N>(pages, stride, total, nominals, mod_nom);
    let rep: decl.SigRep = decl.check_sig<1024, N>(pages, stride, total, fd, unit.records, unit.enums, sig_nominals);
    let owned: decl.Sig = decl.bind_callable_signature<1024, N>(pages, stride, total, unit.header.module_start, unit.header.module_end, rep.sig);
    let next_cache: ProviderLocalSigCache = insert_cached_local_sig(local_sig_cache, source_index, fd.sig.name_start, fd.sig.name_end, owned);
    return SelectedLocalSigResult { acc: decl.SigTab.HCons { head: owned, tail: acc }, local_sig_cache: next_cache };
}
fn select_combined_sig_nominals<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, nominals: decl.NominalTypeIdentityList, mod_nom: NominalModuleLookup) -> (result: decl.NominalTypeIdentityList) {
    if !(mod_nom.found) { return nominals; }
    return decl.combine_nominal_type_identities<1024, N>(pages, stride, total, nominals, mod_nom.facts.resolved);
}
fn call_has_dot<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: bool) {
    if end <= start || end > total { return false; }
    let len: u64 = end - start;
    iterate i up_to 1024 carrying idx: u64 = 0 {
        if idx >= len { return false; }
        if source.byte_at_global<P, N>(pages, stride, total, start + idx) == 46 { return true; }
        next idx = idx + 1;
    }
    return false;
}
fn module_has_local_fn_same<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, member_start: u64, member_end: u64, fns: decl.FnList) -> (result: bool) {
    iterate chunk up_to 64 carrying outer: decl.FnList = fns {
        iterate i up_to 1024 carrying rest: decl.FnList = outer {
            if decl.declared_fn_list_empty(rest) { return false; }
            if local_fn_head_matches_same<P, N>(pages, stride, total, rest, member_start, member_end) { return true; }
            next rest = local_fn_tail(rest);
        }
        if decl.declared_fn_list_empty(rest) { return false; }
        next outer = rest;
    }
    return false;
}
fn local_fn_head_matches_same<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, fns: decl.FnList, member_start: u64, member_end: u64) -> (result: bool) {
    return match fns {
        decl.FnList.DNil => false,
        decl.FnList.DCons { head: candidate, tail: rest } => decl.spans_equal<P, N>(pages, stride, total, member_start, member_end, candidate.sig.name_start, candidate.sig.name_end)
    };
}
fn local_fn_head_selected(fns: decl.FnList) -> (result: decl.FnList) {
    return match fns {
        decl.FnList.DNil => decl.FnList.DNil,
        decl.FnList.DCons { head: candidate, tail: rest } => decl.FnList.DCons { head: candidate, tail: decl.FnList.DNil }
    };
}
fn local_fn_tail(fns: decl.FnList) -> (result: decl.FnList) {
    return match fns {
        decl.FnList.DNil => decl.FnList.DNil,
        decl.FnList.DCons { head: candidate, tail: rest } => rest
    };
}
fn find_local_fn_same<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, member_start: u64, member_end: u64, fns: decl.FnList) -> (result: LocalFnSearchWalk) {
    iterate chunk up_to 64 carrying outer: decl.FnList = fns {
        iterate i up_to 1024 carrying rest: decl.FnList = outer {
            if decl.declared_fn_list_empty(rest) { return LocalFnSearchWalk { rest: decl.FnList.DNil, member_start: member_start, member_end: member_end, found: false, selected: decl.FnList.DNil }; }
            if local_fn_head_matches_same<P, N>(pages, stride, total, rest, member_start, member_end) {
                return LocalFnSearchWalk { rest: decl.FnList.DNil, member_start: member_start, member_end: member_end, found: true, selected: local_fn_head_selected(rest) };
            }
            next rest = local_fn_tail(rest);
        }
        if decl.declared_fn_list_empty(rest) { return LocalFnSearchWalk { rest: decl.FnList.DNil, member_start: member_start, member_end: member_end, found: false, selected: decl.FnList.DNil }; }
        next outer = rest;
    }
    return LocalFnSearchWalk { rest: decl.FnList.DNil, member_start: member_start, member_end: member_end, found: false, selected: decl.FnList.DNil };
}
fn fn_head_matches_between<N: Nat>(c_pages: [[byte; up_to N]; up_to 1024], c_stride: u64, c_total: u64, member_start: u64, member_end: u64, t_pages: [[byte; up_to N]; up_to 1024], t_stride: u64, t_total: u64, fns: decl.FnList) -> (result: bool) {
    return match fns {
        decl.FnList.DNil => false,
        decl.FnList.DCons { head: candidate, tail: rest } => spans_equal_pages<N>(c_pages, c_stride, c_total, member_start, member_end, t_pages, t_stride, t_total, candidate.sig.name_start, candidate.sig.name_end)
    };
}
fn find_matching_fn_between<N: Nat>(c_pages: [[byte; up_to N]; up_to 1024], c_stride: u64, c_total: u64, member_start: u64, member_end: u64, t_pages: [[byte; up_to N]; up_to 1024], t_stride: u64, t_total: u64, fns: decl.FnList) -> (result: decl.FnList) {
    iterate chunk up_to 64 carrying outer: decl.FnList = fns {
        iterate i up_to 1024 carrying rest: decl.FnList = outer {
            if decl.declared_fn_list_empty(rest) { return decl.FnList.DNil; }
            if fn_head_matches_between<N>(c_pages, c_stride, c_total, member_start, member_end, t_pages, t_stride, t_total, rest) { return rest; }
            next rest = local_fn_tail(rest);
        }
        if decl.declared_fn_list_empty(rest) { return decl.FnList.DNil; }
        next outer = rest;
    }
    return decl.FnList.DNil;
}
fn module_has_local_fn_between_bucketed<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, member_start: u64, member_end: u64, target: ParsedModule, fn_buckets: ProviderFnBucketsList) -> (result: bool) {
    let c_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, caller_index);
    let c_stride: u64 = module_stride(sources, caller_index);
    let c_total: u64 = module_total(sources, caller_index);
    let t_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, target.source_index);
    let t_stride: u64 = module_stride(sources, target.source_index);
    let t_total: u64 = module_total(sources, target.source_index);
    let search_fns: decl.FnList = select_fn_list_in_buckets<1024, N>(c_pages, c_stride, c_total, fn_buckets, target.source_index, target.unit.fns, member_start, member_end);
    let hit: decl.FnList = find_matching_fn_between<N>(c_pages, c_stride, c_total, member_start, member_end, t_pages, t_stride, t_total, search_fns);
    return !(decl.declared_fn_list_empty(hit));
}
fn module_has_local_fn_between<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, member_start: u64, member_end: u64, target: ParsedModule) -> (result: bool) {
    return module_has_local_fn_between_bucketed<M, N>(sources, flat_pages, caller_index, member_start, member_end, target, ProviderFnBucketsList.PFBNil);
}

// Resolve a callable member exported by `provider_index` (either declared
// locally in `provider_index` or transitively re-exported through its `use`
// closure), returning the original declaring module's `source_index`.
// Pushing direct uses in declaration order onto a LIFO stack checks local
// declarations first and resolves transitive re-exports in Stage-0's
// deterministic import-override order.
fn resolve_declaring_module_in_provider_with_buckets<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, caller_index: u64, provider_index: u64, member_start: u64, member_end: u64, fn_buckets: ProviderFnBucketsList) -> (result: ProviderDeclaringMatch) {
    if provider_index >= 64 { return ProviderDeclaringMatch { found: false, declaring_source_index: 0 }; }
    let empty_stack: [u64; 128] = [0; 128];
    let seed_stack: [u64; 128] = replace(empty_stack, 0, provider_index);
    let empty_visited: [bool; 64] = [false; 64];
    let initial: ProviderSearchState = ProviderSearchState { stack: seed_stack, sp: 1, visited: empty_visited, found: false, declaring_source_index: 0 };
    iterate step up_to 128 carrying st: ProviderSearchState = initial {
        if st.found || st.sp == 0 {
            return ProviderDeclaringMatch { found: st.found, declaring_source_index: st.declaring_source_index };
        }
        next st = resolve_declaring_module_step<M, N>(sources, flat_pages, all, caller_index, member_start, member_end, fn_buckets, st);
    }
    return ProviderDeclaringMatch { found: st.found, declaring_source_index: st.declaring_source_index };
}
fn resolve_declaring_module_in_provider<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, caller_index: u64, provider_index: u64, member_start: u64, member_end: u64) -> (result: ProviderDeclaringMatch) {
    return resolve_declaring_module_in_provider_with_buckets<M, N>(sources, flat_pages, all, caller_index, provider_index, member_start, member_end, ProviderFnBucketsList.PFBNil);
}
fn resolve_declaring_module_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, caller_index: u64, member_start: u64, member_end: u64, fn_buckets: ProviderFnBucketsList, st: ProviderSearchState) -> (result: ProviderSearchState) {
    if st.found || st.sp == 0 || st.sp > 128 { return st; }
    let next_sp: u64 = st.sp - 1;
    let idx: u64 = st.stack[next_sp];
    if idx >= 64 { return ProviderSearchState { ..st, sp: next_sp }; }
    if st.visited[idx] { return ProviderSearchState { ..st, sp: next_sp }; }
    let popped: ProviderSearchState = ProviderSearchState { ..st, sp: next_sp, visited: replace(st.visited, idx, true) };
    return visit_provider_module<M, N>(sources, flat_pages, all, caller_index, idx, member_start, member_end, fn_buckets, popped);
}
fn visit_provider_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, caller_index: u64, target_index: u64, member_start: u64, member_end: u64, fn_buckets: ProviderFnBucketsList, state: ProviderSearchState) -> (result: ProviderSearchState) {
    let selected: TargetModuleSelection = select_target_module(all, target_index);
    return match selected.selected {
        MNil => state,
        MCons { head: candidate, tail: rest } => visit_provider_candidate<M, N>(sources, flat_pages, all, caller_index, member_start, member_end, fn_buckets, state, candidate)
    };
}
fn visit_provider_candidate<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, caller_index: u64, member_start: u64, member_end: u64, fn_buckets: ProviderFnBucketsList, state: ProviderSearchState, candidate: ParsedModule) -> (result: ProviderSearchState) {
    if module_has_local_fn_between_bucketed<M, N>(sources, flat_pages, caller_index, member_start, member_end, candidate, fn_buckets) {
        return ProviderSearchState { ..state, found: true, declaring_source_index: candidate.source_index };
    }
    return push_provider_uses<M, N>(sources, flat_pages, all, candidate, state);
}
fn push_provider_uses<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, provider: ParsedModule, state: ProviderSearchState) -> (result: ProviderSearchState) {
    let initial: PushUsesWalk = PushUsesWalk { rest: provider.unit.uses, stack: state.stack, sp: state.sp, visited: state.visited };
    iterate i up_to 64 carrying u: PushUsesWalk = initial {
        if decl.use_list_empty(u.rest) {
            return ProviderSearchState { ..state, stack: u.stack, sp: u.sp };
        }
        next u = push_provider_use_step<M, N>(sources, flat_pages, all, provider, u);
    }
    return ProviderSearchState { ..state, stack: u.stack, sp: u.sp };
}
fn push_provider_use_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, provider: ParsedModule, u: PushUsesWalk) -> (result: PushUsesWalk) {
    return match u.rest {
        UNil => u,
        UCons { head: usage, tail: rest } => push_provider_use_one<M, N>(sources, flat_pages, all, provider, u, usage, rest)
    };
}
fn push_provider_use_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, provider: ParsedModule, u: PushUsesWalk, usage: decl.UseDecl, rest: decl.UseList) -> (result: PushUsesWalk) {
    let target: ModuleLookup = find_import_target<M, N>(sources, flat_pages, all, provider, usage);
    if !(target.found) || target.index >= 64 || u.sp >= 128 {
        return PushUsesWalk { ..u, rest: rest };
    }
    if u.visited[target.index] {
        return PushUsesWalk { ..u, rest: rest };
    }
    return PushUsesWalk { rest: rest, stack: replace(u.stack, u.sp, target.index), sp: u.sp + 1, visited: u.visited };
}

// Resolve a bare (unqualified) imported call against all direct imports of
// `current`. Same-identity diamonds collapse cleanly; distinct declaring
// modules conflict and leave the call unbound so `decl.seed_call` reports
// MNE131 at the exact callee span.
fn resolve_bare_imported_call<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, call: decl.CallSite, acc: decl.SigTab, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, fn_buckets: ProviderFnBucketsList, empty_sig: decl.Sig) -> (result: UseSignatureResult) {
    let cached: ResolvedImportLookup = resolved_import_signature_lookup_or<M, N>(sources, flat_pages, current, call.start, call.end, 1024, resolved, empty_sig);
    if cached.found {
        let reused: decl.SigTab = reuse_resolved_import_signature(call, cached.signature, acc);
        return UseSignatureResult { acc: reused, provider_facts: provider_facts, resolved: resolved, local_sig_cache: local_sig_cache };
    }
    let initial: BareUseSearchWalk = BareUseSearchWalk { rest: current.unit.uses, found: false, conflict: false, declaring_source_index: 0 };
    iterate i up_to 64 carrying bs: BareUseSearchWalk = initial {
        if bs.conflict || decl.use_list_empty(bs.rest) {
            return finish_bare_imported_call<M, N>(sources, flat_pages, all, nominal_modules, current, call, acc, nominals, provider_facts, resolved, local_sig_cache, fn_buckets, bs, empty_sig);
        }
        next bs = bare_use_search_step<M, N>(sources, flat_pages, all, current, call, fn_buckets, bs);
    }
    return finish_bare_imported_call<M, N>(sources, flat_pages, all, nominal_modules, current, call, acc, nominals, provider_facts, resolved, local_sig_cache, fn_buckets, bs, empty_sig);
}
fn bare_use_search_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, call: decl.CallSite, fn_buckets: ProviderFnBucketsList, bs: BareUseSearchWalk) -> (result: BareUseSearchWalk) {
    return match bs.rest {
        UNil => bs,
        UCons { head: usage, tail: rest } => bare_use_search_one<M, N>(sources, flat_pages, all, current, call, fn_buckets, bs, usage, rest)
    };
}
fn bare_use_search_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, call: decl.CallSite, fn_buckets: ProviderFnBucketsList, bs: BareUseSearchWalk, usage: decl.UseDecl, rest: decl.UseList) -> (result: BareUseSearchWalk) {
    let target: ModuleLookup = find_import_target<M, N>(sources, flat_pages, all, current, usage);
    if !(target.found) { return BareUseSearchWalk { ..bs, rest: rest }; }
    let resolved: ProviderDeclaringMatch = resolve_declaring_module_in_provider_with_buckets<M, N>(sources, flat_pages, all, current.source_index, target.index, call.start, call.end, fn_buckets);
    if !(resolved.found) { return BareUseSearchWalk { ..bs, rest: rest }; }
    if !(bs.found) {
        return BareUseSearchWalk { rest: rest, found: true, conflict: false, declaring_source_index: resolved.declaring_source_index };
    }
    if resolved.declaring_source_index == bs.declaring_source_index {
        return BareUseSearchWalk { ..bs, rest: rest };
    }
    return BareUseSearchWalk { rest: decl.UseList.UNil, found: true, conflict: true, declaring_source_index: bs.declaring_source_index };
}
fn finish_bare_imported_call<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, nominal_modules: NominalModuleList, current: ParsedModule, call: decl.CallSite, acc: decl.SigTab, caller_nominals: decl.NominalTypeIdentityList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, fn_buckets: ProviderFnBucketsList, bs: BareUseSearchWalk, empty_sig: decl.Sig) -> (result: UseSignatureResult) {
    if !(bs.found) || bs.conflict {
        return UseSignatureResult { acc: acc, provider_facts: provider_facts, resolved: resolved, local_sig_cache: local_sig_cache };
    }
    let sigs: TargetSignatureResult = signatures_from_target_with_buckets<M, N>(sources, flat_pages, all, nominal_modules, current, bs.declaring_source_index, 1024, call.start, call, acc, caller_nominals, provider_facts, resolved, local_sig_cache, fn_buckets, empty_sig);
    return UseSignatureResult { acc: sigs.acc, provider_facts: sigs.provider_facts, resolved: sigs.resolved, local_sig_cache: sigs.local_sig_cache };
}

fn use_list_tail(uses: decl.UseList) -> (result: decl.UseList) {
    return match uses { UNil => decl.UseList.UNil, UCons { head: usage, tail: rest } => rest };
}
fn use_head_matches_call_prefix<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], index: u64, call: decl.CallSite, uses: decl.UseList) -> (result: bool) {
    return match uses {
        UNil => false,
        UCons { head: usage, tail: rest } => call_has_import_prefix<M, N>(sources, flat_pages, index, call, usage)
    };
}
fn advance_uses_matching_prefix<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], index: u64, call: decl.CallSite, uses: decl.UseList) -> (result: decl.UseList) {
    iterate i up_to 1024 carrying rest: decl.UseList = uses {
        if decl.use_list_empty(rest) { return decl.UseList.UNil; }
        if use_head_matches_call_prefix<M, N>(sources, flat_pages, index, call, rest) { return rest; }
        next rest = use_list_tail(rest);
    }
    return decl.UseList.UNil;
}
fn signatures_from_uses_with_buckets<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, uses: decl.UseList, call: decl.CallSite, acc: decl.SigTab, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, fn_buckets: ProviderFnBucketsList, empty_sig: decl.Sig) -> (result: UseSignatureResult) {
    let matched_uses: decl.UseList = advance_uses_matching_prefix<M, N>(sources, flat_pages, current.source_index, call, uses);
    if decl.use_list_empty(matched_uses) {
        return UseSignatureResult { acc: acc, provider_facts: provider_facts, resolved: resolved, local_sig_cache: local_sig_cache };
    }
    iterate i up_to 1024 carrying st: UseSigWalk = UseSigWalk { rest: matched_uses, call: call, acc: acc, nominals: nominals, modules: nominal_modules, provider_facts: provider_facts, resolved: resolved, local_sig_cache: local_sig_cache, fn_buckets: fn_buckets, empty_sig: empty_sig } {
        if decl.use_list_empty(st.rest) {
            return UseSignatureResult { acc: st.acc, provider_facts: st.provider_facts, resolved: st.resolved, local_sig_cache: st.local_sig_cache };
        }
        next st = signatures_from_use<M, N>(sources, flat_pages, all, current, st);
    }
    return UseSignatureResult { acc: st.acc, provider_facts: st.provider_facts, resolved: st.resolved, local_sig_cache: st.local_sig_cache };
}
fn signatures_from_uses<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, uses: decl.UseList, call: decl.CallSite, acc: decl.SigTab, nominals: decl.NominalTypeIdentityList, nominal_modules: NominalModuleList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, empty_sig: decl.Sig) -> (result: UseSignatureResult) {
    return signatures_from_uses_with_buckets<M, N>(sources, flat_pages, all, current, uses, call, acc, nominals, nominal_modules, provider_facts, resolved, local_sig_cache, ProviderFnBucketsList.PFBNil, empty_sig);
}
fn signatures_from_use<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, st: UseSigWalk) -> (result: UseSigWalk) {
    return match st.rest {
        UNil => st,
        UCons { head: usage, tail: rest } => signatures_from_one_use<M, N>(sources, flat_pages, all, current, st, usage, rest)
    };
}
fn signatures_from_one_use<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, current: ParsedModule, st: UseSigWalk, usage: decl.UseDecl, rest: decl.UseList) -> (result: UseSigWalk) {
    let prefix: CallPrefixMatch = call_import_prefix_match<M, N>(sources, flat_pages, current.source_index, st.call, usage);
    if !(prefix.matched) { return UseSigWalk { ..st, rest: advance_uses_matching_prefix<M, N>(sources, flat_pages, current.source_index, st.call, rest) }; }
    let target: ModuleLookup = find_import_target<M, N>(sources, flat_pages, all, current, usage);
    if !(target.found) { return UseSigWalk { ..st, rest: advance_uses_matching_prefix<M, N>(sources, flat_pages, current.source_index, st.call, rest) }; }
    let cached: ResolvedImportLookup = resolved_import_signature_lookup_or<M, N>(sources, flat_pages, current, prefix.member_start, st.call.end, target.index, st.resolved, st.empty_sig);
    if cached.found {
        let reused: decl.SigTab = reuse_resolved_import_signature(st.call, cached.signature, st.acc);
        return UseSigWalk { rest: decl.UseList.UNil, call: st.call, acc: reused, nominals: st.nominals, modules: st.modules, provider_facts: st.provider_facts, resolved: st.resolved, local_sig_cache: st.local_sig_cache, fn_buckets: st.fn_buckets, empty_sig: st.empty_sig };
    }
    let declaring: ProviderDeclaringMatch = resolve_declaring_module_in_provider_with_buckets<M, N>(sources, flat_pages, all, current.source_index, target.index, prefix.member_start, st.call.end, st.fn_buckets);
    if !(declaring.found) { return UseSigWalk { ..st, rest: advance_uses_matching_prefix<M, N>(sources, flat_pages, current.source_index, st.call, rest) }; }
    let sigs: TargetSignatureResult = signatures_from_target_with_buckets<M, N>(sources, flat_pages, all, st.modules, current, declaring.declaring_source_index, target.index, prefix.member_start, st.call, st.acc, st.nominals, st.provider_facts, st.resolved, st.local_sig_cache, st.fn_buckets, st.empty_sig);
    return UseSigWalk { rest: decl.UseList.UNil, call: st.call, acc: sigs.acc, nominals: st.nominals, modules: st.modules, provider_facts: sigs.provider_facts, resolved: sigs.resolved, local_sig_cache: sigs.local_sig_cache, fn_buckets: st.fn_buckets, empty_sig: st.empty_sig };
}
fn call_span_has_prefix<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, call: decl.CallSite, prefix_start: u64, prefix_end: u64) -> (result: bool) {
    if call.end <= call.start || prefix_end <= prefix_start { return false; }
    let prefix_len: u64 = prefix_end - prefix_start;
    if call.end - call.start <= prefix_len + 1 { return false; }
    if !(decl.spans_equal<P, N>(pages, stride, total, call.start, call.start + prefix_len, prefix_start, prefix_end)) { return false; }
    return source.byte_at_global<P, N>(pages, stride, total, call.start + prefix_len) == 46;
}
fn call_import_prefix_match<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], index: u64, call: decl.CallSite, usage: decl.UseDecl) -> (result: CallPrefixMatch) {
    let pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, index);
    let stride: u64 = module_stride(sources, index);
    let total: u64 = module_total(sources, index);
    if usage.has_alias {
        if call_span_has_prefix<1024, N>(pages, stride, total, call, usage.alias_start, usage.alias_end) {
            return CallPrefixMatch { matched: true, member_start: call.start + (usage.alias_end - usage.alias_start) + 1 };
        }
    }
    if call_span_has_prefix<1024, N>(pages, stride, total, call, usage.module_start, usage.module_end) {
        return CallPrefixMatch { matched: true, member_start: call.start + (usage.module_end - usage.module_start) + 1 };
    }
    return CallPrefixMatch { matched: false, member_start: 0 };
}
fn call_has_import_prefix<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], index: u64, call: decl.CallSite, usage: decl.UseDecl) -> (result: bool) {
    let m: CallPrefixMatch = call_import_prefix_match<M, N>(sources, flat_pages, index, call, usage);
    return m.matched;
}
fn resolved_import_head_matches<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, facts: ResolvedImportFactList, member_start: u64, member_end: u64, provider_source_index: u64) -> (result: bool) {
    return match facts {
        RIFNil => false,
        RIFCons { head: fact, tail: rest } => fact.provider_source_index == provider_source_index && decl.spans_equal<P, N>(pages, stride, total, member_start, member_end, fact.member_start, fact.member_end)
    };
}
fn resolved_import_head_signature(facts: ResolvedImportFactList, empty_signature: decl.Sig) -> (result: decl.Sig) {
    return match facts { RIFNil => empty_signature, RIFCons { head: fact, tail: rest } => fact.signature };
}
fn resolved_import_fact_tail(facts: ResolvedImportFactList) -> (result: ResolvedImportFactList) {
    return match facts { RIFNil => ResolvedImportFactList.RIFNil, RIFCons { head: fact, tail: rest } => rest };
}
fn resolved_import_head_matches_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], source_index: u64, facts: ResolvedImportFactList, member_start: u64, member_end: u64, provider_source_index: u64) -> (result: bool) {
    return match facts {
        RIFNil => false,
        RIFCons { head: fact, tail: rest } => fact.provider_source_index == provider_source_index
            && spans_equal_flat_sources<M, N>(sources, flat_pages, source_index, member_start, member_end, source_index, fact.member_start, fact.member_end)
    };
}
fn resolved_import_signature_lookup_or<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, member_start: u64, member_end: u64, provider_source_index: u64, facts: ResolvedImportFactCache, empty_signature: decl.Sig) -> (result: ResolvedImportLookup) {
    if resolved_import_fact_list_empty(facts.facts) {
        return ResolvedImportLookup { found: false, signature: empty_signature };
    }
    iterate chunk up_to 64 carrying outer: ResolvedImportFactList = facts.facts {
        iterate i up_to 1024 carrying rest: ResolvedImportFactList = outer {
            if resolved_import_fact_list_empty(rest) { return ResolvedImportLookup { found: false, signature: empty_signature }; }
            if resolved_import_head_matches_flat<M, N>(sources, flat_pages, current.source_index, rest, member_start, member_end, provider_source_index) {
                return ResolvedImportLookup { found: true, signature: resolved_import_head_signature(rest, empty_signature) };
            }
            next rest = resolved_import_fact_tail(rest);
        }
        if resolved_import_fact_list_empty(rest) { return ResolvedImportLookup { found: false, signature: empty_signature }; }
        next outer = rest;
    }
    return ResolvedImportLookup { found: false, signature: empty_signature };
}
fn resolved_import_signature_lookup<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], current: ParsedModule, member_start: u64, member_end: u64, provider_source_index: u64, facts: ResolvedImportFactCache) -> (result: ResolvedImportLookup) {
    return resolved_import_signature_lookup_or<M, N>(sources, flat_pages, current, member_start, member_end, provider_source_index, facts, empty_decl_signature());
}
fn resolved_import_fact_list_empty(facts: ResolvedImportFactList) -> (result: bool) {
    return match facts {
        RIFNil => true,
        RIFCons { head: item, tail: rest } => false
    };
}
fn resolved_import_fact_push_bounded(fact: ResolvedImportFact, cache: ResolvedImportFactCache) -> (result: ResolvedImportFactCache) {
    // Retain at most 64 exact imported names. Common misses add one fact in
    // constant work; when full, reset the cache rather than rebuilding a list.
    if cache.count >= 64 {
        return ResolvedImportFactCache { facts: ResolvedImportFactList.RIFCons { head: fact, tail: ResolvedImportFactList.RIFNil }, count: 1 };
    }
    return ResolvedImportFactCache { facts: ResolvedImportFactList.RIFCons { head: fact, tail: cache.facts }, count: cache.count + 1 };
}
fn reuse_resolved_import_signature(call: decl.CallSite, cached: decl.Sig, acc: decl.SigTab) -> (result: decl.SigTab) {
    let reused: decl.Sig = decl.Sig { ..cached, start: call.start, end: call.end };
    return decl.SigTab.HCons { head: reused, tail: acc };
}
fn signatures_from_target_with_buckets<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, nominal_modules: NominalModuleList, current: ParsedModule, target_index: u64, cache_provider_index: u64, member_start: u64, call: decl.CallSite, acc: decl.SigTab, caller_nominals: decl.NominalTypeIdentityList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, fn_buckets: ProviderFnBucketsList, empty_sig: decl.Sig) -> (result: TargetSignatureResult) {
    let selected: TargetModuleSelection = select_target_module(all, target_index);
    return match selected.selected {
        MNil => TargetSignatureResult { acc: acc, provider_facts: provider_facts, resolved: resolved, local_sig_cache: local_sig_cache },
        MCons { head: target, tail: unused } => signatures_from_selected_target<M, N>(sources, flat_pages, nominal_modules, current, target, cache_provider_index, member_start, call, acc, caller_nominals, provider_facts, resolved, local_sig_cache, fn_buckets, empty_sig)
    };
}
fn signatures_from_selected_target<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], nominal_modules: NominalModuleList, current: ParsedModule, target: ParsedModule, cache_provider_index: u64, member_start: u64, call: decl.CallSite, acc: decl.SigTab, caller_nominals: decl.NominalTypeIdentityList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, fn_buckets: ProviderFnBucketsList, empty_sig: decl.Sig) -> (result: TargetSignatureResult) {
    let target_facts: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, nominal_modules, target.source_index);
    let target_nominals: decl.NominalTypeIdentityList = target_facts.facts.resolved;
    let exported: ExportSignatureResult = signature_from_target_fns_bucketed<M, N>(sources, flat_pages, current, target, cache_provider_index, member_start, call, acc, caller_nominals, target_nominals, resolved, local_sig_cache, fn_buckets, empty_sig);
    return TargetSignatureResult { acc: exported.acc, provider_facts: provider_facts, resolved: exported.resolved, local_sig_cache: exported.local_sig_cache };
}
fn signatures_from_target<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all: ModuleList, nominal_modules: NominalModuleList, current: ParsedModule, target_index: u64, cache_provider_index: u64, member_start: u64, call: decl.CallSite, acc: decl.SigTab, caller_nominals: decl.NominalTypeIdentityList, provider_facts: ProviderSignatureFactsList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, empty_sig: decl.Sig) -> (result: TargetSignatureResult) {
    return signatures_from_target_with_buckets<M, N>(sources, flat_pages, all, nominal_modules, current, target_index, cache_provider_index, member_start, call, acc, caller_nominals, provider_facts, resolved, local_sig_cache, ProviderFnBucketsList.PFBNil, empty_sig);
}
record TargetFnSigWalk { rest: decl.FnList, caller: ParsedModule, target: ParsedModule, cache_provider_index: u64, member_start: u64, member_end: u64, call: decl.CallSite, caller_nominals: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, acc: decl.SigTab, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, empty_sig: decl.Sig, found: bool }

fn fn_decl_tail(list: decl.FnList) -> (result: decl.FnList) {
    return match list {
        decl.FnList.DNil => decl.FnList.DNil,
        decl.FnList.DCons { head: h, tail: t } => t
    };
}
fn fn_decl_head_matches_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, member_start: u64, member_end: u64, target_index: u64, list: decl.FnList) -> (result: bool) {
    return match list {
        decl.FnList.DNil => false,
        decl.FnList.DCons { head: h, tail: t } => spans_equal_flat_sources<M, N>(sources, flat_pages, caller_index, member_start, member_end, target_index, h.sig.name_start, h.sig.name_end)
    };
}
fn find_matching_fn_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, member_start: u64, member_end: u64, target_index: u64, fns: decl.FnList) -> (result: decl.FnList) {
    iterate chunk up_to 64 carrying outer: decl.FnList = fns {
        iterate i up_to 1024 carrying rest: decl.FnList = outer {
            if decl.declared_fn_list_empty(rest) { return decl.FnList.DNil; }
            if fn_decl_head_matches_flat<M, N>(sources, flat_pages, caller_index, member_start, member_end, target_index, rest) { return rest; }
            next rest = fn_decl_tail(rest);
        }
        if decl.declared_fn_list_empty(rest) { return decl.FnList.DNil; }
        next outer = rest;
    }
    return decl.FnList.DNil;
}
fn signature_from_target_fns<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller: ParsedModule, target: ParsedModule, cache_provider_index: u64, member_start: u64, call: decl.CallSite, acc: decl.SigTab, caller_nominals: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, empty_sig: decl.Sig) -> (result: ExportSignatureResult) {
    return signature_from_target_fns_bucketed<M, N>(sources, flat_pages, caller, target, cache_provider_index, member_start, call, acc, caller_nominals, target_nominals, resolved, local_sig_cache, ProviderFnBucketsList.PFBNil, empty_sig);
}
fn signature_from_target_fns_bucketed<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller: ParsedModule, target: ParsedModule, cache_provider_index: u64, member_start: u64, call: decl.CallSite, acc: decl.SigTab, caller_nominals: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, resolved: ResolvedImportFactCache, local_sig_cache: ProviderLocalSigCache, fn_buckets: ProviderFnBucketsList, empty_sig: decl.Sig) -> (result: ExportSignatureResult) {
    // Resolve only the called provider declaration on demand instead of
    // collecting and identity-binding every declaration in the provider.
    let bucket: u64 = decl_name_bucket64_flat<M, N>(sources, flat_pages, caller.source_index, member_start, call.end);
    let search_fns: decl.FnList = select_fn_list_in_bucket_index(fn_buckets, target.source_index, target.unit.fns, bucket);
    let hit: decl.FnList = find_matching_fn_flat<M, N>(sources, flat_pages, caller.source_index, member_start, call.end, target.source_index, search_fns);
    if decl.declared_fn_list_empty(hit) {
        return ExportSignatureResult { acc: acc, resolved: resolved, local_sig_cache: local_sig_cache };
    }
    let initial: TargetFnSigWalk = TargetFnSigWalk { rest: hit, caller: caller, target: target, cache_provider_index: cache_provider_index, member_start: member_start, member_end: call.end, call: call, caller_nominals: caller_nominals, target_nominals: target_nominals, acc: acc, resolved: resolved, local_sig_cache: local_sig_cache, empty_sig: empty_sig, found: false };
    iterate attempt up_to 64 carrying st: TargetFnSigWalk = initial {
        if st.found || decl.declared_fn_list_empty(st.rest) { return ExportSignatureResult { acc: st.acc, resolved: st.resolved, local_sig_cache: st.local_sig_cache }; }
        next st = signature_from_target_fn_hit_step_flat<M, N>(sources, flat_pages, st);
    }
    return ExportSignatureResult { acc: st.acc, resolved: st.resolved, local_sig_cache: st.local_sig_cache };
}
fn signature_from_target_fn_hit_step_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetFnSigWalk) -> (result: TargetFnSigWalk) {
    let hit: decl.FnList = find_matching_fn_flat<M, N>(sources, flat_pages, st.caller.source_index, st.member_start, st.member_end, st.target.source_index, st.rest);
    return match hit {
        decl.FnList.DNil => TargetFnSigWalk { ..st, rest: decl.FnList.DNil },
        decl.FnList.DCons { head: candidate, tail: rest } => signature_from_target_fn_matched_flat<M, N>(sources, flat_pages, st, candidate, rest)
    };
}
fn resolve_target_owned_signature_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], target: ParsedModule, target_nominals: decl.NominalTypeIdentityList, candidate: decl.FnDecl, local_sig_cache: ProviderLocalSigCache, empty_sig: decl.Sig) -> (result: TargetOwnedSigResult) {
    let cached: ProviderLocalSigLookup = lookup_cached_local_sig_or(local_sig_cache, target.source_index, candidate.sig.name_start, candidate.sig.name_end, empty_sig);
    if cached.found {
        return TargetOwnedSigResult { owned: cached.sig, local_sig_cache: local_sig_cache };
    }
    let t_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, target.source_index);
    let t_stride: u64 = module_stride(sources, target.source_index);
    let t_total: u64 = module_total(sources, target.source_index);
    let rep: decl.SigRep = decl.check_sig<1024, N>(t_pages, t_stride, t_total, candidate, target.unit.records, target.unit.enums, target_nominals);
    let owned: decl.Sig = decl.bind_callable_signature<1024, N>(t_pages, t_stride, t_total, target.unit.header.module_start, target.unit.header.module_end, rep.sig);
    let next_cache: ProviderLocalSigCache = insert_cached_local_sig(local_sig_cache, target.source_index, candidate.sig.name_start, candidate.sig.name_end, owned);
    return TargetOwnedSigResult { owned: owned, local_sig_cache: next_cache };
}
fn signature_from_target_fn_matched_flat<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetFnSigWalk, candidate: decl.FnDecl, rest: decl.FnList) -> (result: TargetFnSigWalk) {
    let resolved_owned: TargetOwnedSigResult = resolve_target_owned_signature_flat<M, N>(sources, flat_pages, st.target, st.target_nominals, candidate, st.local_sig_cache, st.empty_sig);
    let owned: decl.Sig = resolved_owned.owned;
    let transported: SignatureTransport = transport_signature<M, N>(sources, flat_pages, st.caller.source_index, st.target.source_index, owned, st.target_nominals, st.caller_nominals);
    if !(transported.ok) { return TargetFnSigWalk { ..st, rest: rest, local_sig_cache: resolved_owned.local_sig_cache }; }
    let sig: decl.Sig = decl.Sig {
        start: st.call.start,
        end: st.call.end,
        params: transported.params,
        nparams: owned.nparams,
        generic_bounds: owned.generic_bounds,
        result: transported.result,
        fx: decl.EffectList.XNil,
        raw_capabilities: decl.CapList.ANil,
        effects: owned.effects,
        capabilities: owned.capabilities,
        identity: owned.identity
    };
    let fact: ResolvedImportFact = ResolvedImportFact { member_start: st.member_start, member_end: st.member_end, provider_source_index: st.cache_provider_index, signature: sig };
    let resolved: ResolvedImportFactCache = resolved_import_fact_push_bounded(fact, st.resolved);
    return TargetFnSigWalk { ..st, rest: decl.FnList.DNil, acc: decl.SigTab.HCons { head: sig, tail: st.acc }, resolved: resolved, local_sig_cache: resolved_owned.local_sig_cache, found: true };
}
fn signatures_from_cached_provider<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: TargetSigWalk, target: ParsedModule, cached: ProviderSignatureLookup) -> (result: TargetSigWalk) {
    let exported: ExportSignatureResult = signatures_from_exports<M, N>(sources, flat_pages, st.current, target, st.member_start, st.call, cached.signatures, st.acc, st.caller_nominals, cached.nominals, st.resolved);
    return TargetSigWalk { ..st, rest: ModuleList.MNil, acc: exported.acc, resolved: exported.resolved };
}
fn provider_signature_lookup(facts: ProviderSignatureFactsList, target_index: u64) -> (result: ProviderSignatureLookup) {
    let initial: ProviderSignatureLookupWalk = ProviderSignatureLookupWalk { rest: facts, target_index: target_index, found: false, signatures: decl.SigTab.HNil, nominals: decl.NominalTypeIdentityList.NINil };
    iterate i up_to 64 carrying st: ProviderSignatureLookupWalk = initial {
        if st.found || provider_signature_facts_empty(st.rest) { return ProviderSignatureLookup { found: st.found, signatures: st.signatures, nominals: st.nominals }; }
        next st = provider_signature_lookup_step(st);
    }
    return ProviderSignatureLookup { found: st.found, signatures: st.signatures, nominals: st.nominals };
}
fn provider_signature_facts_empty(facts: ProviderSignatureFactsList) -> (result: bool) {
    return match facts { PSNil => true, PSCons { head: item, tail: rest } => false };
}
fn provider_signature_lookup_step(st: ProviderSignatureLookupWalk) -> (result: ProviderSignatureLookupWalk) {
    return match st.rest {
        PSNil => st,
        PSCons { head: item, tail: rest } => provider_signature_lookup_item(st, item, rest)
    };
}
fn provider_signature_lookup_item(st: ProviderSignatureLookupWalk, item: ProviderSignatureFacts, rest: ProviderSignatureFactsList) -> (result: ProviderSignatureLookupWalk) {
    if item.source_index == st.target_index { return ProviderSignatureLookupWalk { rest: rest, target_index: st.target_index, found: true, signatures: item.signatures, nominals: item.nominals }; }
    return ProviderSignatureLookupWalk { ..st, rest: rest };
}
fn signatures_from_exports<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller: ParsedModule, target: ParsedModule, member_start: u64, call: decl.CallSite, target_sigs: decl.SigTab, acc: decl.SigTab, caller_nominals: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, resolved: ResolvedImportFactCache) -> (result: ExportSignatureResult) {
    // The provider signature table already carries every declaration name
    // and checked signature. Compare the imported member across source
    // identities once instead of walking FnDecls before searching this table.
    iterate chunk up_to 64 carrying st: ExportSigWalk = ExportSigWalk { rest: target_sigs, caller: caller, target: target, member_start: member_start, member_end: call.end, call: call, caller_nominals: caller_nominals, target_nominals: target_nominals, acc: acc, resolved: resolved, local_sig_cache: empty_provider_local_sig_cache() } {
        if export_signature_table_empty(st.rest) { return ExportSignatureResult { acc: st.acc, resolved: st.resolved, local_sig_cache: st.local_sig_cache }; }
        next st = signatures_from_export_chunk<M, N>(sources, flat_pages, st);
    }
    return ExportSignatureResult { acc: st.acc, resolved: st.resolved, local_sig_cache: st.local_sig_cache };
}
fn export_signature_table_empty(signatures: decl.SigTab) -> (result: bool) {
    return match signatures {
        decl.SigTab.HNil => true,
        decl.SigTab.HCons { head: item, tail: rest } => false
    };
}
fn signatures_from_export_chunk<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], initial: ExportSigWalk) -> (result: ExportSigWalk) {
    iterate i up_to 1024 carrying st: ExportSigWalk = initial {
        if export_signature_table_empty(st.rest) { return st; }
        next st = signatures_from_export<M, N>(sources, flat_pages, st);
    }
    return st;
}
fn signatures_from_export<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ExportSigWalk) -> (result: ExportSigWalk) {
    return match st.rest {
        decl.SigTab.HNil => st,
        decl.SigTab.HCons { head: signature, tail: rest } => signature_from_export<M, N>(sources, flat_pages, st, signature, rest)
    };
}
fn signature_from_export<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ExportSigWalk, candidate: decl.Sig, rest: decl.SigTab) -> (result: ExportSigWalk) {
    if !(spans_equal_between<M, N>(sources, flat_pages, st.caller.source_index, st.member_start, st.member_end, st.target.source_index, candidate.start, candidate.end)) {
        return ExportSigWalk { ..st, rest: rest };
    }
    let transported: SignatureTransport = transport_signature<M, N>(sources, flat_pages, st.caller.source_index, st.target.source_index, candidate, st.target_nominals, st.caller_nominals);
    if !(transported.ok) { return ExportSigWalk { ..st, rest: rest }; }
    let sig: decl.Sig = decl.Sig {
        start: st.call.start,
        end: st.call.end,
        params: transported.params,
        nparams: candidate.nparams,
        generic_bounds: candidate.generic_bounds,
        result: transported.result,
        fx: decl.EffectList.XNil,
        raw_capabilities: decl.CapList.ANil,
        effects: candidate.effects,
        capabilities: candidate.capabilities,
        identity: candidate.identity
    };
    let fact: ResolvedImportFact = ResolvedImportFact { member_start: st.member_start, member_end: st.member_end, provider_source_index: st.target.source_index, signature: sig };
    let resolved: ResolvedImportFactCache = resolved_import_fact_push_bounded(fact, st.resolved);
    return ExportSigWalk { ..st, rest: decl.SigTab.HNil, acc: decl.SigTab.HCons { head: sig, tail: st.acc }, resolved: resolved };
}
record TypeTransport { ty: decl.SemType, ok: bool }
record ParameterTransport { rest: decl.BindList, acc: decl.BindList, ok: bool }
record SignatureTransport { params: decl.BindList, result: decl.SemType, ok: bool }
fn finish_transport_signature(st: ParameterTransport, result_ty: decl.SemType) -> (result: SignatureTransport) {
    return SignatureTransport { params: reverse_transported_parameters(st.acc), result: result_ty, ok: st.ok && bind_list_empty(st.rest) };
}
fn transport_signature<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, sig: decl.Sig, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: SignatureTransport) {
    let result: TypeTransport = transport_type<M, N>(sources, flat_pages, caller_index, target_index, sig.result, target_nominals, caller_nominals);
    iterate i up_to 1024 carrying st: ParameterTransport = ParameterTransport { rest: sig.params, acc: decl.BindList.BNil, ok: result.ok } {
        if !(st.ok) || bind_list_empty(st.rest) { return finish_transport_signature(st, result.ty); }
        next st = transport_parameter_step<M, N>(sources, flat_pages, caller_index, target_index, st, target_nominals, caller_nominals);
    }
    return finish_transport_signature(st, result.ty);
}
fn transport_parameter_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, st: ParameterTransport, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: ParameterTransport) {
    if !(st.ok) { return st; }
    return match st.rest {
        decl.BindList.BNil => st,
        decl.BindList.BCons { head: parameter, tail: rest } => transport_one_parameter<M, N>(sources, flat_pages, caller_index, target_index, st, parameter, rest, target_nominals, caller_nominals)
    };
}
fn transport_one_parameter<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, st: ParameterTransport, parameter: decl.Bind, rest: decl.BindList, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: ParameterTransport) {
    let ty: TypeTransport = transport_type<M, N>(sources, flat_pages, caller_index, target_index, parameter.ty, target_nominals, caller_nominals);
    let rebound: decl.Bind = decl.Bind { ..parameter, ty: ty.ty };
    return ParameterTransport { rest: rest, acc: decl.BindList.BCons { head: rebound, tail: st.acc }, ok: ty.ok };
}
fn bind_list_empty(params: decl.BindList) -> (result: bool) { return match params { decl.BindList.BNil => true, decl.BindList.BCons { head: h, tail: t } => false }; }
record BindReverse { rest: decl.BindList, acc: decl.BindList }
fn reverse_transported_parameters(params: decl.BindList) -> (result: decl.BindList) {
    iterate i up_to 1024 carrying st: BindReverse = BindReverse { rest: params, acc: decl.BindList.BNil } {
        if bind_list_empty(st.rest) { return st.acc; }
        next st = reverse_transported_parameter_step(st);
    }
    return st.acc;
}
fn reverse_transported_parameter_step(st: BindReverse) -> (result: BindReverse) {
    return match st.rest {
        decl.BindList.BNil => st,
        decl.BindList.BCons { head: h, tail: rest } => BindReverse { rest: rest, acc: decl.BindList.BCons { head: h, tail: st.acc } }
    };
}
fn transport_type<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, ty: decl.SemType, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    return match ty {
        TBool => TypeTransport { ty: ty, ok: true },
        TByte => TypeTransport { ty: ty, ok: true },
        TInt { width: w, signed: s } => TypeTransport { ty: ty, ok: true },
        TNamed { start: a, end: b } => transport_nominal_type<M, N>(sources, flat_pages, caller_index, target_index, a, b, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: ty, ok: true },
        TSeqExact { element: element, length: length, length_valid: valid } => transport_sequence_type<M, N>(sources, flat_pages, caller_index, target_index, element, length, valid, target_nominals, caller_nominals),
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
}
// Schema fields are resolved and transported within their declaring module.
// Reuse that module's page slice instead of rebuilding it for each nominal
// field through the general cross-module transport path.
fn transport_type_in_module<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, ty: decl.SemType, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    return match ty {
        TBool => TypeTransport { ty: ty, ok: true },
        TByte => TypeTransport { ty: ty, ok: true },
        TInt { width: width, signed: signed } => TypeTransport { ty: ty, ok: true },
        TNamed { start: start, end: end } => transport_nominal_type_in_module<P, N>(pages, stride, total, start, end, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: ty, ok: true },
        TSeqExact { element: element, length: length, length_valid: valid } => transport_sequence_type_in_module<P, N>(pages, stride, total, element, length, valid, target_nominals, caller_nominals),
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
}
fn transport_sequence_type_in_module<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, element: decl.SemType, length: u64, length_valid: bool, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let transported: TypeTransport = transport_sequence_element_in_module<P, N>(pages, stride, total, element, target_nominals, caller_nominals);
    if !(transported.ok) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    return TypeTransport { ty: decl.SemType.TSeqExact { element: transported.ty, length: length, length_valid: length_valid }, ok: true };
}
fn transport_sequence_element_in_module<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, element: decl.SemType, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    return match element {
        TBool => TypeTransport { ty: element, ok: true },
        TByte => TypeTransport { ty: element, ok: true },
        TInt { width: width, signed: signed } => TypeTransport { ty: element, ok: true },
        TNamed { start: start, end: end } => transport_nominal_type_in_module<P, N>(pages, stride, total, start, end, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: element, ok: true },
        TSeqExact { element: nested, length: count, length_valid: valid } => transport_nested_sequence_element_in_module<P, N>(pages, stride, total, nested, count, valid, target_nominals, caller_nominals),
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
}
fn transport_nested_sequence_element_in_module<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, element: decl.SemType, length: u64, length_valid: bool, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let transported: TypeTransport = match element {
        TBool => TypeTransport { ty: element, ok: true },
        TByte => TypeTransport { ty: element, ok: true },
        TInt { width: width, signed: signed } => TypeTransport { ty: element, ok: true },
        TNamed { start: start, end: end } => transport_nominal_type_in_module<P, N>(pages, stride, total, start, end, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: decl.SemType.TPoison, ok: false },
        TSeqExact { element: nested, length: count, length_valid: valid } => TypeTransport { ty: decl.SemType.TPoison, ok: false },
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
    if !(transported.ok) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    return TypeTransport { ty: decl.SemType.TSeqExact { element: transported.ty, length: length, length_valid: length_valid }, ok: true };
}
fn finish_transport_nominal(target: decl.NominalLookup, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    if !(target.found) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    let marker: decl.NominalRefLookup = decl.nominal_marker_reference_by_identity(caller_nominals, target.identity);
    if marker.found { return TypeTransport { ty: decl.SemType.TNamed { start: marker.start, end: marker.end }, ok: true }; }
    let caller: decl.NominalRefLookup = decl.nominal_reference_by_identity_only(caller_nominals, target.identity);
    if !(caller.found) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    return TypeTransport { ty: decl.SemType.TNamed { start: caller.start, end: caller.end }, ok: true };
}
fn transport_nominal_type_in_module<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let imported: decl.NominalLookup = decl.nominal_identity_at<P, N>(pages, stride, total, target_nominals, start, end);
    if imported.found { return finish_transport_nominal(imported, caller_nominals); }
    let target: decl.NominalLookup = decl.nominal_identity_by_name<P, N>(pages, stride, total, target_nominals, start, end);
    return finish_transport_nominal(target, caller_nominals);
}
fn transport_sequence_type<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, element: decl.SemType, length: u64, length_valid: bool, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let transported: TypeTransport = transport_sequence_element<M, N>(sources, flat_pages, caller_index, target_index, element, target_nominals, caller_nominals);
    if !(transported.ok) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    // `length_valid` marks a concrete exact length. Views and symbolic
    // generic bounds intentionally keep it false; their sentinel is part
    // of the imported signature and must survive transport unchanged. Stage-0
    // admits one nested sequence layer in signatures; the element transport
    // preserves that inner bound without recursively walking compiler types.
    return TypeTransport { ty: decl.SemType.TSeqExact { element: transported.ty, length: length, length_valid: length_valid }, ok: true };
}
fn transport_sequence_element<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, element: decl.SemType, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    return match element {
        TBool => TypeTransport { ty: element, ok: true },
        TByte => TypeTransport { ty: element, ok: true },
        TInt { width: width, signed: signed } => TypeTransport { ty: element, ok: true },
        TNamed { start: start, end: end } => transport_nominal_type<M, N>(sources, flat_pages, caller_index, target_index, start, end, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: element, ok: true },
        TSeqExact { element: nested, length: count, length_valid: valid } => transport_nested_sequence_element<M, N>(sources, flat_pages, caller_index, target_index, nested, count, valid, target_nominals, caller_nominals),
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
}
fn transport_nested_sequence_element<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, element: decl.SemType, length: u64, length_valid: bool, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let transported: TypeTransport = match element {
        TBool => TypeTransport { ty: element, ok: true },
        TByte => TypeTransport { ty: element, ok: true },
        TInt { width: width, signed: signed } => TypeTransport { ty: element, ok: true },
        TNamed { start: start, end: end } => transport_nominal_type<M, N>(sources, flat_pages, caller_index, target_index, start, end, target_nominals, caller_nominals),
        TSeq => TypeTransport { ty: decl.SemType.TPoison, ok: false },
        TSeqExact { element: nested, length: count, length_valid: valid } => TypeTransport { ty: decl.SemType.TPoison, ok: false },
        TPoison => TypeTransport { ty: decl.SemType.TPoison, ok: false }
    };
    if !(transported.ok) { return TypeTransport { ty: decl.SemType.TPoison, ok: false }; }
    return TypeTransport { ty: decl.SemType.TSeqExact { element: transported.ty, length: length, length_valid: length_valid }, ok: true };
}
fn transport_nominal_type<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], caller_index: u64, target_index: u64, start: u64, end: u64, target_nominals: decl.NominalTypeIdentityList, caller_nominals: decl.NominalTypeIdentityList) -> (result: TypeTransport) {
    let imported: decl.NominalLookup = decl.nominal_identity_at_marker(target_nominals, start, end);
    if imported.found { return finish_transport_nominal(imported, caller_nominals); }
    let target: decl.NominalLookup = nominal_identity_by_name_flat<M, N>(sources, flat_pages, target_index, target_nominals, start, end);
    return finish_transport_nominal(target, caller_nominals);
}
fn select_nominal_lookup(imported_first: bool, imported: decl.NominalLookup, local: decl.NominalLookup) -> (result: decl.NominalLookup) {
    if imported_first { return imported; }
    return local;
}
fn effect_list_empty(fx: decl.EffectList) -> (result: bool) {
    return match fx { XNil => true, XCons { head: h, tail: t } => false };
}
// Project nominal types receive stable out-of-source spans. Generic type
// variables occupy marker slots 1..1024, so project identities start at
// 1025. Every module sees the same identity-to-marker mapping, which lets
// imported field types survive semantic proof and the SSA verifier without
// borrowing another module's byte offsets.
fn project_nominal_markers(modules: NominalModuleList) -> (result: decl.NominalTypeIdentityList) {
    iterate i up_to 64 carrying st: ProjectNominalModuleWalk = ProjectNominalModuleWalk { rest: modules, acc: decl.NominalTypeIdentityList.NINil, count: 0 } {
        if nominal_module_list_empty(st.rest) { return st.acc; }
        next st = project_nominal_module_step(st);
    }
    return st.acc;
}
fn project_nominal_module_step(st: ProjectNominalModuleWalk) -> (result: ProjectNominalModuleWalk) {
    return match st.rest {
        NMNil => st,
        NMCons { head: nominal_item, tail: rest } => project_nominal_module_cons(st, nominal_item, rest)
    };
}
fn project_nominal_module_cons(st: ProjectNominalModuleWalk, nominal_item: NominalModule, rest: NominalModuleList) -> (result: ProjectNominalModuleWalk) {
    let identities: ProjectNominalIdentityWalk = project_nominal_identity_list(nominal_item.resolved, st.acc, st.count);
    return ProjectNominalModuleWalk { rest: rest, acc: identities.acc, count: identities.count };
}
fn nominal_identity_list_empty(identities: decl.NominalTypeIdentityList) -> (result: bool) {
    return match identities {
        NINil => true,
        NICons { head: h, tail: t } => false
    };
}
fn nominal_module_list_empty(modules: NominalModuleList) -> (result: bool) {
    return match modules {
        NMNil => true,
        NMCons { head: h, tail: t } => false
    };
}
fn record_decl_list_empty(records: decl.RecordList) -> (result: bool) {
    return match records {
        decl.RecordList.RNil => true,
        decl.RecordList.RCons { head: h, tail: t } => false
    };
}
fn enum_decl_list_empty(enums: decl.EnumList) -> (result: bool) {
    return match enums {
        decl.EnumList.GNil => true,
        decl.EnumList.GCons { head: h, tail: t } => false
    };
}
fn field_decl_list_empty(fields: decl.FieldList) -> (result: bool) {
    return match fields {
        decl.FieldList.FNil => true,
        decl.FieldList.FCons { head: h, tail: t } => false
    };
}
fn variant_decl_list_empty(variants: decl.VariantList) -> (result: bool) {
    return match variants {
        decl.VariantList.VNil => true,
        decl.VariantList.VCons { head: h, tail: t } => false
    };
}
fn imported_record_field_list_empty(fields: decl.ImportedRecordFieldList) -> (result: bool) {
    return match fields {
        decl.ImportedRecordFieldList.IRFNil => true,
        decl.ImportedRecordFieldList.IRFCons { head: h, tail: t } => false
    };
}
fn imported_enum_variant_list_empty(variants: decl.ImportedEnumVariantList) -> (result: bool) {
    return match variants {
        decl.ImportedEnumVariantList.IEVNil => true,
        decl.ImportedEnumVariantList.IEVCons { head: h, tail: t } => false
    };
}
fn imported_enum_field_list_empty(fields: decl.ImportedEnumFieldList) -> (result: bool) {
    return match fields {
        decl.ImportedEnumFieldList.IEFNil => true,
        decl.ImportedEnumFieldList.IEFCons { head: h, tail: t } => false
    };
}
fn imported_record_list_empty(records: decl.ImportedRecordList) -> (result: bool) {
    return match records {
        decl.ImportedRecordList.IRNil => true,
        decl.ImportedRecordList.IRCons { head: h, tail: t } => false
    };
}
fn imported_enum_list_empty(enums: decl.ImportedEnumList) -> (result: bool) {
    return match enums {
        decl.ImportedEnumList.IENil => true,
        decl.ImportedEnumList.IECons { head: h, tail: t } => false
    };
}
fn project_nominal_identity_list(identities: decl.NominalTypeIdentityList, acc: decl.NominalTypeIdentityList, count: u64) -> (result: ProjectNominalIdentityWalk) {
    let initial: ProjectNominalIdentityWalk = ProjectNominalIdentityWalk { rest: identities, acc: acc, count: count };
    iterate chunk up_to 64 carrying st: ProjectNominalIdentityWalk = initial {
        if nominal_identity_list_empty(st.rest) { return st; }
        next st = project_nominal_identity_chunk(st);
    }
    return st;
}
fn project_nominal_identity_chunk(initial: ProjectNominalIdentityWalk) -> (result: ProjectNominalIdentityWalk) {
    iterate i up_to 1024 carrying st: ProjectNominalIdentityWalk = initial {
        if nominal_identity_list_empty(st.rest) { return st; }
        next st = project_nominal_identity_step(st);
    }
    return st;
}
fn project_nominal_identity_step(st: ProjectNominalIdentityWalk) -> (result: ProjectNominalIdentityWalk) {
    return match st.rest {
        NINil => st,
        NICons { head: identity, tail: rest } => project_nominal_identity_cons(st, identity, rest)
    };
}
fn project_nominal_identity_cons(st: ProjectNominalIdentityWalk, identity: decl.NominalTypeIdentity, rest: decl.NominalTypeIdentityList) -> (result: ProjectNominalIdentityWalk) {
    let exists: ProjectNominalContains = project_nominal_contains(st.acc, identity.identity);
    if !(identity.identity.valid) || exists.found || st.count >= 1024 {
        return ProjectNominalIdentityWalk { rest: rest, acc: st.acc, count: st.count };
    }
    let marker: decl.NominalTypeIdentity = decl.NominalTypeIdentity { start: 18446744073709551615 - (1024 + st.count + 1), end: 18446744073709551615, identity: identity.identity, reference: true };
    return ProjectNominalIdentityWalk { rest: rest, acc: decl.NominalTypeIdentityList.NICons { head: marker, tail: st.acc }, count: st.count + 1 };
}
fn project_nominal_head_matches_id(identities: decl.NominalTypeIdentityList, wanted: decl.SemanticIdentity) -> (result: bool) {
    return match identities {
        NINil => false,
        NICons { head: identity, tail: rest } => decl.semantic_identity_equal(identity.identity, wanted)
    };
}
fn project_nominal_head_matches_span(identities: decl.NominalTypeIdentityList, start: u64, end: u64) -> (result: bool) {
    return match identities {
        NINil => false,
        NICons { head: item, tail: rest } => item.start == start && item.end == end
    };
}
fn project_nominal_head(identities: decl.NominalTypeIdentityList) -> (result: decl.NominalTypeIdentity) {
    return match identities {
        NINil => empty_nominal_type_identity(),
        NICons { head: item, tail: rest } => item
    };
}
fn project_nominal_tail(identities: decl.NominalTypeIdentityList) -> (result: decl.NominalTypeIdentityList) {
    return match identities {
        NINil => decl.NominalTypeIdentityList.NINil,
        NICons { head: item, tail: rest } => rest
    };
}
fn project_nominal_contains(identities: decl.NominalTypeIdentityList, wanted: decl.SemanticIdentity) -> (result: ProjectNominalContains) {
    iterate chunk up_to 64 carrying outer: decl.NominalTypeIdentityList = identities {
        iterate i up_to 1024 carrying rest: decl.NominalTypeIdentityList = outer {
            if nominal_identity_list_empty(rest) {
                return ProjectNominalContains { rest: decl.NominalTypeIdentityList.NINil, wanted: wanted, found: false };
            }
            if project_nominal_head_matches_id(rest, wanted) {
                return ProjectNominalContains { rest: decl.NominalTypeIdentityList.NINil, wanted: wanted, found: true };
            }
            next rest = project_nominal_tail(rest);
        }
        if nominal_identity_list_empty(rest) {
            return ProjectNominalContains { rest: decl.NominalTypeIdentityList.NINil, wanted: wanted, found: false };
        }
        next outer = rest;
    }
    return ProjectNominalContains { rest: decl.NominalTypeIdentityList.NINil, wanted: wanted, found: false };
}

fn project_record_schemas<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, nominal_modules: NominalModuleList, markers: decl.NominalTypeIdentityList) -> (result: decl.ImportedRecordList) {
    iterate i up_to 64 carrying st: ProjectRecordWalk = ProjectRecordWalk { rest: modules, nominal_modules: nominal_modules, markers: markers, acc: decl.ImportedRecordList.IRNil } {
        if module_list_empty(st.rest) { return st.acc; }
        next st = project_record_module_step<M, N>(sources, flat_pages, st);
    }
    return st.acc;
}
fn project_record_module_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectRecordWalk) -> (result: ProjectRecordWalk) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => project_record_module_cons<M, N>(sources, flat_pages, st, parsed, rest)
    };
}
fn project_record_module_cons<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectRecordWalk, parsed: ParsedModule, rest: ModuleList) -> (result: ProjectRecordWalk) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let input_stride: u64 = module_stride(sources, parsed.source_index);
    let input_total: u64 = module_total(sources, parsed.source_index);
    let facts: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, st.nominal_modules, parsed.source_index);
    let target_nominals: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(input_pages, input_stride, input_total, st.markers, facts.facts.resolved);
    let schemas: decl.ImportedRecordList = project_record_decls<N>(input_pages, input_stride, input_total, parsed.unit.records, parsed.unit.records, parsed.unit.enums, st.markers, target_nominals, st.acc);
    return ProjectRecordWalk { rest: rest, nominal_modules: st.nominal_modules, markers: st.markers, acc: schemas };
}
fn project_record_decls<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, records: decl.RecordList, unit_records: decl.RecordList, enums: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, acc: decl.ImportedRecordList) -> (result: decl.ImportedRecordList) {
    iterate i up_to 1024 carrying st: ProjectRecordDeclWalk = ProjectRecordDeclWalk { rest: records, markers: markers, target_nominals: target_nominals, records: unit_records, enums: enums, acc: acc } {
        if record_decl_list_empty(st.rest) { return st.acc; }
        next st = project_record_decl_step<N>(pages, stride, total, st);
    }
    return st.acc;
}
fn project_record_decl_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectRecordDeclWalk) -> (result: ProjectRecordDeclWalk) {
    return match st.rest {
        decl.RecordList.RNil => st,
        decl.RecordList.RCons { head: record_decl, tail: rest } => project_record_decl_cons<N>(pages, stride, total, st, record_decl, rest)
    };
}
fn project_record_decl_cons<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectRecordDeclWalk, record_decl: decl.RecordDecl, rest: decl.RecordList) -> (result: ProjectRecordDeclWalk) {
    let identity: decl.NominalLookup = decl.nominal_identity_by_name<1024, N>(pages, stride, total, st.target_nominals, record_decl.name_start, record_decl.name_end);
    let built_fields: ProjectRecordFields = project_record_fields<N>(pages, stride, total, record_decl.fields, st.records, st.enums, st.markers, st.target_nominals);
    if !(identity.found) { return ProjectRecordDeclWalk { ..st, rest: rest }; }
    let schema: decl.ImportedRecordSchema = decl.ImportedRecordSchema { identity: identity.identity, fields: built_fields.fields };
    return ProjectRecordDeclWalk { rest: rest, markers: st.markers, target_nominals: st.target_nominals, records: st.records, enums: st.enums, acc: decl.ImportedRecordList.IRCons { head: schema, tail: st.acc } };
}
fn project_record_fields<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, fields: decl.FieldList, records: decl.RecordList, enums: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList) -> (result: ProjectRecordFields) {
    iterate i up_to 1024 carrying st: ProjectRecordFieldWalk = ProjectRecordFieldWalk { rest: fields, index: 0, markers: markers, target_nominals: target_nominals, records: records, enums: enums, acc: decl.ImportedRecordFieldList.IRFNil, ok: true } {
        if field_decl_list_empty(st.rest) { return ProjectRecordFields { fields: reverse_project_record_fields(st.acc), ok: st.ok }; }
        next st = project_record_field_step<N>(pages, stride, total, st);
    }
    let ordered: decl.ImportedRecordFieldList = reverse_project_record_fields(st.acc);
    return ProjectRecordFields { fields: ordered, ok: st.ok };
}
fn project_record_field_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectRecordFieldWalk) -> (result: ProjectRecordFieldWalk) {
    return match st.rest {
        decl.FieldList.FNil => st,
        decl.FieldList.FCons { head: field, tail: rest } => project_record_field_cons<N>(pages, stride, total, st, field, rest)
    };
}
fn project_record_field_cons<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectRecordFieldWalk, field: decl.Field, rest: decl.FieldList) -> (result: ProjectRecordFieldWalk) {
    let resolved: decl.TyRes = decl.resolve_type<1024, N>(pages, stride, total, field.type_kind, field.type_start, field.type_end, st.records, st.enums, st.target_nominals);
    let transported: TypeTransport = transport_type_in_module<1024, N>(pages, stride, total, resolved.ty, st.target_nominals, st.markers);
    let valid: bool = resolved.ok && transported.ok;
    let item: decl.ImportedRecordField = decl.ImportedRecordField { name: decl.signature_name_key<1024, N>(pages, stride, total, field.name_start, field.name_end), index: st.index, ty: transported.ty, type_valid: valid };
    return ProjectRecordFieldWalk { rest: rest, index: st.index + 1, markers: st.markers, target_nominals: st.target_nominals, records: st.records, enums: st.enums, acc: decl.ImportedRecordFieldList.IRFCons { head: item, tail: st.acc }, ok: st.ok && valid };
}
fn reverse_project_record_fields(fields: decl.ImportedRecordFieldList) -> (result: decl.ImportedRecordFieldList) {
    iterate i up_to 1024 carrying st: ProjectRecordFieldReverse = ProjectRecordFieldReverse { rest: fields, acc: decl.ImportedRecordFieldList.IRFNil } {
        if imported_record_field_list_empty(st.rest) { return st.acc; }
        next st = reverse_project_record_field_step(st);
    }
    return st.acc;
}
fn reverse_project_record_field_step(st: ProjectRecordFieldReverse) -> (result: ProjectRecordFieldReverse) {
    return match st.rest {
        decl.ImportedRecordFieldList.IRFNil => st,
        decl.ImportedRecordFieldList.IRFCons { head: field, tail: rest } => ProjectRecordFieldReverse { rest: rest, acc: decl.ImportedRecordFieldList.IRFCons { head: field, tail: st.acc } }
    };
}

fn project_enum_schemas<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, nominal_modules: NominalModuleList, markers: decl.NominalTypeIdentityList) -> (result: decl.ImportedEnumList) {
    iterate i up_to 64 carrying st: ProjectEnumWalk = ProjectEnumWalk { rest: modules, nominal_modules: nominal_modules, markers: markers, acc: decl.ImportedEnumList.IENil } {
        if module_list_empty(st.rest) { return st.acc; }
        next st = project_enum_module_step<M, N>(sources, flat_pages, st);
    }
    return st.acc;
}
fn project_enum_module_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectEnumWalk) -> (result: ProjectEnumWalk) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => project_enum_module_cons<M, N>(sources, flat_pages, st, parsed, rest)
    };
}
fn project_enum_module_cons<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectEnumWalk, parsed: ParsedModule, rest: ModuleList) -> (result: ProjectEnumWalk) {
    let pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let stride: u64 = module_stride(sources, parsed.source_index);
    let total: u64 = module_total(sources, parsed.source_index);
    let facts: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, st.nominal_modules, parsed.source_index);
    let target_nominals: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(pages, stride, total, st.markers, facts.facts.resolved);
    let schemas: decl.ImportedEnumList = project_enum_decls<N>(pages, stride, total, parsed.unit.enums, parsed.unit.records, parsed.unit.enums, st.markers, target_nominals, st.acc);
    return ProjectEnumWalk { rest: rest, nominal_modules: st.nominal_modules, markers: st.markers, acc: schemas };
}
fn project_enum_decls<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, enums: decl.EnumList, records: decl.RecordList, unit_enums: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, acc: decl.ImportedEnumList) -> (result: decl.ImportedEnumList) {
    iterate i up_to 1024 carrying st: ProjectEnumDeclWalk = ProjectEnumDeclWalk { rest: enums, markers: markers, target_nominals: target_nominals, records: records, enums: unit_enums, acc: acc } {
        if enum_decl_list_empty(st.rest) { return st.acc; }
        next st = project_enum_decl_step<N>(pages, stride, total, st);
    }
    return st.acc;
}
fn project_enum_decl_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumDeclWalk) -> (result: ProjectEnumDeclWalk) {
    return match st.rest {
        decl.EnumList.GNil => st,
        decl.EnumList.GCons { head: enum_decl, tail: rest } => project_enum_decl_cons<N>(pages, stride, total, st, enum_decl, rest)
    };
}
fn project_enum_decl_cons<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumDeclWalk, enum_decl: decl.EnumDecl, rest: decl.EnumList) -> (result: ProjectEnumDeclWalk) {
    let identity: decl.NominalLookup = decl.nominal_identity_by_name<1024, N>(pages, stride, total, st.target_nominals, enum_decl.name_start, enum_decl.name_end);
    let built: ProjectEnumVariantBuild = project_enum_variants<N>(pages, stride, total, enum_decl.variants, st.records, st.enums, st.markers, st.target_nominals);
    if !(identity.found) { return ProjectEnumDeclWalk { ..st, rest: rest }; }
    let schema: decl.ImportedEnumSchema = decl.ImportedEnumSchema { identity: identity.identity, variants: built.variants };
    return ProjectEnumDeclWalk { rest: rest, markers: st.markers, target_nominals: st.target_nominals, records: st.records, enums: st.enums, acc: decl.ImportedEnumList.IECons { head: schema, tail: st.acc } };
}
fn project_enum_variants<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, variants: decl.VariantList, records: decl.RecordList, enums: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList) -> (result: ProjectEnumVariantBuild) {
    let seed: ProjectEnumVariantWalk = ProjectEnumVariantWalk { rest: variants, markers: markers, target_nominals: target_nominals, records: records, enums: enums, acc: decl.ImportedEnumVariantList.IEVNil, ok: true };
    iterate i up_to 1024 carrying st: ProjectEnumVariantWalk = seed {
        if variant_decl_list_empty(st.rest) { return ProjectEnumVariantBuild { variants: reverse_project_enum_variants(st.acc), ok: st.ok }; }
        next st = project_enum_variant_step<N>(pages, stride, total, st);
    }
    return ProjectEnumVariantBuild { variants: reverse_project_enum_variants(st.acc), ok: st.ok };
}
fn project_enum_variant_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumVariantWalk) -> (result: ProjectEnumVariantWalk) {
    return match st.rest {
        decl.VariantList.VNil => st,
        decl.VariantList.VCons { head: variant, tail: rest } => project_enum_variant_cons<N>(pages, stride, total, st, variant, rest)
    };
}
fn project_enum_variant_cons<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumVariantWalk, variant: decl.Variant, rest: decl.VariantList) -> (result: ProjectEnumVariantWalk) {
    let built: ProjectEnumFields = project_enum_fields<N>(pages, stride, total, variant.fields, st.records, st.enums, st.markers, st.target_nominals);
    let item: decl.ImportedEnumVariant = decl.ImportedEnumVariant { name: decl.signature_name_key<1024, N>(pages, stride, total, variant.name_start, variant.name_end), fields: built.fields };
    return ProjectEnumVariantWalk { rest: rest, markers: st.markers, target_nominals: st.target_nominals, records: st.records, enums: st.enums, acc: decl.ImportedEnumVariantList.IEVCons { head: item, tail: st.acc }, ok: st.ok && built.ok };
}
fn project_enum_fields<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, fields: decl.FieldList, records: decl.RecordList, enums: decl.EnumList, markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList) -> (result: ProjectEnumFields) {
    let seed: ProjectEnumFieldWalk = ProjectEnumFieldWalk { rest: fields, index: 0, markers: markers, target_nominals: target_nominals, records: records, enums: enums, acc: decl.ImportedEnumFieldList.IEFNil, ok: true };
    iterate i up_to 1024 carrying st: ProjectEnumFieldWalk = seed {
        if field_decl_list_empty(st.rest) { return ProjectEnumFields { fields: reverse_project_enum_fields(st.acc), ok: st.ok }; }
        next st = project_enum_field_step<N>(pages, stride, total, st);
    }
    return ProjectEnumFields { fields: reverse_project_enum_fields(st.acc), ok: st.ok };
}
fn project_enum_field_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumFieldWalk) -> (result: ProjectEnumFieldWalk) {
    return match st.rest {
        decl.FieldList.FNil => st,
        decl.FieldList.FCons { head: field, tail: rest } => project_enum_field_cons<N>(pages, stride, total, st, field, rest)
    };
}
fn project_enum_field_cons<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: ProjectEnumFieldWalk, field: decl.Field, rest: decl.FieldList) -> (result: ProjectEnumFieldWalk) {
    let resolved: decl.TyRes = decl.resolve_type<1024, N>(pages, stride, total, field.type_kind, field.type_start, field.type_end, st.records, st.enums, st.target_nominals);
    let transported: TypeTransport = transport_type_in_module<1024, N>(pages, stride, total, resolved.ty, st.target_nominals, st.markers);
    let valid: bool = resolved.ok && transported.ok;
    let item: decl.ImportedEnumField = decl.ImportedEnumField { name: decl.signature_name_key<1024, N>(pages, stride, total, field.name_start, field.name_end), index: st.index, ty: transported.ty, type_valid: valid };
    return ProjectEnumFieldWalk { rest: rest, index: st.index + 1, markers: st.markers, target_nominals: st.target_nominals, records: st.records, enums: st.enums, acc: decl.ImportedEnumFieldList.IEFCons { head: item, tail: st.acc }, ok: st.ok && valid };
}
fn reverse_project_enum_fields(fields: decl.ImportedEnumFieldList) -> (result: decl.ImportedEnumFieldList) {
    iterate i up_to 1024 carrying st: ProjectEnumFieldReverse = ProjectEnumFieldReverse { rest: fields, acc: decl.ImportedEnumFieldList.IEFNil } {
        if imported_enum_field_list_empty(st.rest) { return st.acc; }
        next st = reverse_project_enum_field_step(st);
    }
    return st.acc;
}
fn reverse_project_enum_field_step(st: ProjectEnumFieldReverse) -> (result: ProjectEnumFieldReverse) {
    return match st.rest {
        decl.ImportedEnumFieldList.IEFNil => st,
        decl.ImportedEnumFieldList.IEFCons { head: field, tail: rest } => ProjectEnumFieldReverse { rest: rest, acc: decl.ImportedEnumFieldList.IEFCons { head: field, tail: st.acc } }
    };
}
fn reverse_project_enum_variants(variants: decl.ImportedEnumVariantList) -> (result: decl.ImportedEnumVariantList) {
    iterate i up_to 1024 carrying st: ProjectEnumVariantReverse = ProjectEnumVariantReverse { rest: variants, acc: decl.ImportedEnumVariantList.IEVNil } {
        if imported_enum_variant_list_empty(st.rest) { return st.acc; }
        next st = reverse_project_enum_variant_step(st);
    }
    return st.acc;
}
fn reverse_project_enum_variant_step(st: ProjectEnumVariantReverse) -> (result: ProjectEnumVariantReverse) {
    return match st.rest {
        decl.ImportedEnumVariantList.IEVNil => st,
        decl.ImportedEnumVariantList.IEVCons { head: variant, tail: rest } => ProjectEnumVariantReverse { rest: rest, acc: decl.ImportedEnumVariantList.IEVCons { head: variant, tail: st.acc } }
    };
}

record ProjectBuild { rest: ModuleList, all: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, nominal_markers: decl.NominalTypeIdentityList, imported_records: decl.ImportedRecordList, imported_enums: decl.ImportedEnumList, acc: ProjectModuleList, valid: bool, ssa_valid: bool, count: u64, failed: StageFailure, target_missing: bool }
record ProjectBuildRev { rest: ProjectModuleList, acc: ProjectModuleList }
fn begin_project_lowering(modules: ModuleList, imports: ImportList, nominal_modules: NominalModuleList) -> (result: ProjectBuild) {
    return begin_project_lowering_with_schemas(modules, imports, nominal_modules, decl.NominalTypeIdentityList.NINil, decl.ImportedRecordList.IRNil, decl.ImportedEnumList.IENil);
}
fn begin_project_lowering_with_schemas(modules: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, nominal_markers: decl.NominalTypeIdentityList, imported_records: decl.ImportedRecordList, imported_enums: decl.ImportedEnumList) -> (result: ProjectBuild) {
    return ProjectBuild { rest: modules, all: modules, imports: imports, nominal_modules: nominal_modules, nominal_markers: nominal_markers, imported_records: imported_records, imported_enums: imported_enums, acc: ProjectModuleList.PNil, valid: true, ssa_valid: true, count: 0, failed: StageFailure { stage: 0, source_index: 0, code: 0, start: 0, end: 0 }, target_missing: false };
}
fn lower_project_modules<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, imports: ImportList, nominal_modules: NominalModuleList) -> (result: ProjectBuild) {
    let markers: decl.NominalTypeIdentityList = project_nominal_markers(nominal_modules);
    let imported_records: decl.ImportedRecordList = project_record_schemas<M, N>(sources, flat_pages, modules, nominal_modules, markers);
    let imported_enums: decl.ImportedEnumList = project_enum_schemas<M, N>(sources, flat_pages, modules, nominal_modules, markers);
    let initial: ProjectBuild = begin_project_lowering_with_schemas(modules, imports, nominal_modules, markers, imported_records, imported_enums);
    iterate i over sources carrying st: ProjectBuild = initial {
        next st = lower_project_one<M, N>(sources, flat_pages, st);
    }
    iterate i over sources carrying rev: ProjectBuildRev = ProjectBuildRev { rest: st.acc, acc: ProjectModuleList.PNil } {
        next rev = reverse_project_build(rev);
    }
    return ProjectBuild { rest: ModuleList.MNil, all: modules, imports: imports, nominal_modules: nominal_modules, nominal_markers: markers, imported_records: imported_records, imported_enums: imported_enums, acc: rev.acc, valid: st.valid, ssa_valid: st.ssa_valid, count: st.count, failed: st.failed, target_missing: false };
}
fn lower_project_modules_for_source<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], modules: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, target_source_index: u64) -> (result: ProjectBuild) {
    let selected: TargetModuleSelection = select_target_module(modules, target_source_index);
    let dependency_closure: ProjectImportClosure = project_import_closure(imports, target_source_index, sources.len);
    let dependency_modules: ModuleList = project_modules_in_closure<64>(sources, modules, dependency_closure.reachable);
    let dependency_nominal_modules: NominalModuleList = project_nominal_modules_in_closure<64>(sources, nominal_modules, dependency_closure.reachable);
    let markers: decl.NominalTypeIdentityList = project_nominal_markers(dependency_nominal_modules);
    return lower_target_module_selected<M, N>(sources, flat_pages, modules, selected.selected, imports, nominal_modules, dependency_modules, dependency_nominal_modules, markers, selected.found);
}

fn project_nominal_modules_in_closure<M: Nat>(sources: [ProjectSource; up_to M], modules: NominalModuleList, reachable: [bool; 64]) -> (result: NominalModuleList) {
    iterate i over sources carrying st: NominalModuleClosureFilter = NominalModuleClosureFilter {
        rest: modules,
        reachable: reachable,
        acc: NominalModuleList.NMNil
    } {
        if nominal_module_list_empty(st.rest) { return st.acc; }
        next st = project_nominal_module_closure_step(st);
    }
    return st.acc;
}
fn project_nominal_module_closure_step(st: NominalModuleClosureFilter) -> (result: NominalModuleClosureFilter) {
    return match st.rest {
        NMNil => st,
        NMCons { head: item, tail: rest } => project_nominal_module_closure_one(st, item, rest)
    };
}
fn project_nominal_module_closure_one(st: NominalModuleClosureFilter, item: NominalModule, rest: NominalModuleList) -> (result: NominalModuleClosureFilter) {
    if item.source_index >= st.reachable.len {
        return NominalModuleClosureFilter { rest: rest, reachable: st.reachable, acc: st.acc };
    }
    if !(st.reachable[item.source_index]) {
        return NominalModuleClosureFilter { rest: rest, reachable: st.reachable, acc: st.acc };
    }
    return NominalModuleClosureFilter {
        rest: rest,
        reachable: st.reachable,
        acc: NominalModuleList.NMCons { head: item, tail: st.acc }
    };
}

fn empty_nominal_type_identity() -> (result: decl.NominalTypeIdentity) {
    return decl.NominalTypeIdentity { start: 0, end: 0, identity: decl.invalid_semantic_identity(), reference: false };
}
fn nominal_marker_by_span(markers: decl.NominalTypeIdentityList, start: u64, end: u64) -> (result: NominalMarkerLookup) {
    iterate chunk up_to 64 carrying outer: decl.NominalTypeIdentityList = markers {
        iterate i up_to 1024 carrying rest: decl.NominalTypeIdentityList = outer {
            if nominal_identity_list_empty(rest) {
                return NominalMarkerLookup { rest: decl.NominalTypeIdentityList.NINil, start: start, end: end, found: false, marker: empty_nominal_type_identity() };
            }
            if project_nominal_head_matches_span(rest, start, end) {
                return NominalMarkerLookup { rest: decl.NominalTypeIdentityList.NINil, start: start, end: end, found: true, marker: project_nominal_head(rest) };
            }
            next rest = project_nominal_tail(rest);
        }
        if nominal_identity_list_empty(rest) {
            return NominalMarkerLookup { rest: decl.NominalTypeIdentityList.NINil, start: start, end: end, found: false, marker: empty_nominal_type_identity() };
        }
        next outer = rest;
    }
    return NominalMarkerLookup { rest: decl.NominalTypeIdentityList.NINil, start: start, end: end, found: false, marker: empty_nominal_type_identity() };
}
fn nominal_marker_list_has_span(markers: decl.NominalTypeIdentityList, start: u64, end: u64) -> (result: bool) {
    let found: NominalMarkerLookup = nominal_marker_by_span(markers, start, end);
    return found.found;
}
fn nominal_marker_by_identity(markers: decl.NominalTypeIdentityList, wanted: decl.SemanticIdentity) -> (result: NominalMarkerByIdLookup) {
    iterate chunk up_to 64 carrying outer: decl.NominalTypeIdentityList = markers {
        iterate i up_to 1024 carrying rest: decl.NominalTypeIdentityList = outer {
            if nominal_identity_list_empty(rest) {
                return NominalMarkerByIdLookup { rest: decl.NominalTypeIdentityList.NINil, wanted: wanted, found: false, marker: empty_nominal_type_identity() };
            }
            if project_nominal_head_matches_id(rest, wanted) {
                return NominalMarkerByIdLookup { rest: decl.NominalTypeIdentityList.NINil, wanted: wanted, found: true, marker: project_nominal_head(rest) };
            }
            next rest = project_nominal_tail(rest);
        }
        if nominal_identity_list_empty(rest) {
            return NominalMarkerByIdLookup { rest: decl.NominalTypeIdentityList.NINil, wanted: wanted, found: false, marker: empty_nominal_type_identity() };
        }
        next outer = rest;
    }
    return NominalMarkerByIdLookup { rest: decl.NominalTypeIdentityList.NINil, wanted: wanted, found: false, marker: empty_nominal_type_identity() };
}
fn add_marker_if_new(state: MarkerAddResult, marker: decl.NominalTypeIdentity) -> (result: MarkerAddResult) {
    if !(marker.identity.valid) { return state; }
    if nominal_marker_list_has_span(state.markers, marker.start, marker.end) { return state; }
    return MarkerAddResult { markers: decl.NominalTypeIdentityList.NICons { head: marker, tail: state.markers }, added: true };
}
fn add_marker_for_span(all_markers: decl.NominalTypeIdentityList, state: MarkerAddResult, start: u64, end: u64) -> (result: MarkerAddResult) {
    let found: NominalMarkerLookup = nominal_marker_by_span(all_markers, start, end);
    if !(found.found) { return state; }
    return add_marker_if_new(state, found.marker);
}
fn add_markers_for_sem_type(all_markers: decl.NominalTypeIdentityList, ty: decl.SemType, state: MarkerAddResult) -> (result: MarkerAddResult) {
    return match ty {
        TBool => state,
        TByte => state,
        TInt { width: w, signed: s } => state,
        TNamed { start: start, end: end } => add_marker_for_span(all_markers, state, start, end),
        TSeq => state,
        TSeqExact { element: element, length: length, length_valid: valid } => add_markers_for_sequence_element(all_markers, element, state),
        TPoison => state
    };
}
fn add_markers_for_sequence_element(all_markers: decl.NominalTypeIdentityList, element: decl.SemType, state: MarkerAddResult) -> (result: MarkerAddResult) {
    return match element {
        TBool => state,
        TByte => state,
        TInt { width: w, signed: s } => state,
        TNamed { start: start, end: end } => add_marker_for_span(all_markers, state, start, end),
        TSeq => state,
        TSeqExact { element: nested, length: length, length_valid: valid } => add_markers_for_nested_sequence_element(all_markers, nested, state),
        TPoison => state
    };
}
fn add_markers_for_nested_sequence_element(all_markers: decl.NominalTypeIdentityList, element: decl.SemType, state: MarkerAddResult) -> (result: MarkerAddResult) {
    return match element {
        TBool => state,
        TByte => state,
        TInt { width: w, signed: s } => state,
        TNamed { start: start, end: end } => add_marker_for_span(all_markers, state, start, end),
        TSeq => state,
        TSeqExact { element: nested, length: length, length_valid: valid } => state,
        TPoison => state
    };
}
fn seed_markers_from_nominals(all_markers: decl.NominalTypeIdentityList, nominals: decl.NominalTypeIdentityList, wanted: decl.NominalTypeIdentityList) -> (result: decl.NominalTypeIdentityList) {
    let initial: SeedNominalMarkerWalk = SeedNominalMarkerWalk { rest: nominals, all_markers: all_markers, wanted: wanted };
    iterate chunk up_to 64 carrying st: SeedNominalMarkerWalk = initial {
        if nominal_identity_list_empty(st.rest) { return st.wanted; }
        next st = seed_markers_from_nominal_chunk(st);
    }
    return st.wanted;
}
fn seed_markers_from_nominal_chunk(initial: SeedNominalMarkerWalk) -> (result: SeedNominalMarkerWalk) {
    iterate i up_to 1024 carrying st: SeedNominalMarkerWalk = initial {
        if nominal_identity_list_empty(st.rest) { return st; }
        next st = seed_markers_from_nominal_step(st);
    }
    return st;
}
fn seed_markers_from_nominal_step(st: SeedNominalMarkerWalk) -> (result: SeedNominalMarkerWalk) {
    return match st.rest {
        NINil => st,
        NICons { head: item, tail: rest } => seed_markers_from_nominal_one(st, item, rest)
    };
}
fn seed_markers_from_nominal_one(st: SeedNominalMarkerWalk, item: decl.NominalTypeIdentity, rest: decl.NominalTypeIdentityList) -> (result: SeedNominalMarkerWalk) {
    let found: NominalMarkerByIdLookup = nominal_marker_by_identity(st.all_markers, item.identity);
    if !(found.found) { return SeedNominalMarkerWalk { ..st, rest: rest }; }
    let added: MarkerAddResult = add_marker_if_new(MarkerAddResult { markers: st.wanted, added: false }, found.marker);
    return SeedNominalMarkerWalk { rest: rest, all_markers: st.all_markers, wanted: added.markers };
}
fn seed_markers_from_sigtab(all_markers: decl.NominalTypeIdentityList, sigs: decl.SigTab, wanted: decl.NominalTypeIdentityList) -> (result: decl.NominalTypeIdentityList) {
    iterate chunk up_to 64 carrying st: SeedSigTabMarkerWalk = SeedSigTabMarkerWalk { rest: sigs, all_markers: all_markers, wanted: wanted } {
        if export_signature_table_empty(st.rest) { return st.wanted; }
        next st = seed_markers_from_sigtab_chunk(st);
    }
    return st.wanted;
}
fn seed_markers_from_sigtab_chunk(initial: SeedSigTabMarkerWalk) -> (result: SeedSigTabMarkerWalk) {
    iterate i up_to 1024 carrying st: SeedSigTabMarkerWalk = initial {
        if export_signature_table_empty(st.rest) { return st; }
        next st = seed_markers_from_sigtab_step(st);
    }
    return st;
}
fn seed_markers_from_sigtab_step(st: SeedSigTabMarkerWalk) -> (result: SeedSigTabMarkerWalk) {
    return match st.rest {
        decl.SigTab.HNil => st,
        decl.SigTab.HCons { head: sig, tail: rest } => seed_markers_from_sig(st, sig, rest)
    };
}
fn seed_markers_from_sig(st: SeedSigTabMarkerWalk, sig: decl.Sig, rest: decl.SigTab) -> (result: SeedSigTabMarkerWalk) {
    let with_result: MarkerAddResult = add_markers_for_sem_type(st.all_markers, sig.result, MarkerAddResult { markers: st.wanted, added: false });
    let with_params: decl.NominalTypeIdentityList = seed_markers_from_binds(st.all_markers, sig.params, with_result.markers);
    return SeedSigTabMarkerWalk { rest: rest, all_markers: st.all_markers, wanted: with_params };
}
fn seed_markers_from_binds(all_markers: decl.NominalTypeIdentityList, binds: decl.BindList, wanted: decl.NominalTypeIdentityList) -> (result: decl.NominalTypeIdentityList) {
    iterate i up_to 1024 carrying st: SeedBindMarkerWalk = SeedBindMarkerWalk { rest: binds, all_markers: all_markers, wanted: wanted } {
        if bind_list_empty(st.rest) { return st.wanted; }
        next st = seed_markers_from_bind_step(st);
    }
    return st.wanted;
}
fn seed_markers_from_bind_step(st: SeedBindMarkerWalk) -> (result: SeedBindMarkerWalk) {
    return match st.rest {
        decl.BindList.BNil => st,
        decl.BindList.BCons { head: bind, tail: rest } => seed_markers_from_bind_one(st, bind, rest)
    };
}
fn seed_markers_from_bind_one(st: SeedBindMarkerWalk, bind: decl.Bind, rest: decl.BindList) -> (result: SeedBindMarkerWalk) {
    let next_markers: MarkerAddResult = add_markers_for_sem_type(st.all_markers, bind.ty, MarkerAddResult { markers: st.wanted, added: false });
    return SeedBindMarkerWalk { rest: rest, all_markers: st.all_markers, wanted: next_markers.markers };
}

fn local_nominal_identity_by_span(local: decl.NominalTypeIdentityList, name_start: u64, name_end: u64) -> (result: decl.NominalLookup) {
    iterate i up_to 1024 carrying rest: decl.NominalTypeIdentityList = local {
        if nominal_identity_list_empty(rest) {
            return decl.NominalLookup { found: false, identity: decl.invalid_semantic_identity() };
        }
        if local_nominal_head_matches_span(rest, name_start, name_end) {
            return decl.NominalLookup { found: true, identity: local_nominal_head_identity(rest) };
        }
        next rest = local_nominal_tail(rest);
    }
    return decl.NominalLookup { found: false, identity: decl.invalid_semantic_identity() };
}
fn local_nominal_head_matches_span(rest: decl.NominalTypeIdentityList, name_start: u64, name_end: u64) -> (result: bool) {
    return match rest {
        NINil => false,
        NICons { head: item, tail: tail } => !(item.reference) && item.start == name_start && item.end == name_end && item.identity.valid
    };
}
fn local_nominal_head_identity(rest: decl.NominalTypeIdentityList) -> (result: decl.SemanticIdentity) {
    return match rest {
        NINil => decl.invalid_semantic_identity(),
        NICons { head: item, tail: tail } => item.identity
    };
}
fn local_nominal_tail(rest: decl.NominalTypeIdentityList) -> (result: decl.NominalTypeIdentityList) {
    return match rest {
        NINil => decl.NominalTypeIdentityList.NINil,
        NICons { head: item, tail: tail } => tail
    };
}
fn imported_record_list_has(records: decl.ImportedRecordList, wanted: decl.SemanticIdentity) -> (result: bool) {
    iterate i up_to 1024 carrying st: ImportedRecordHasWalk = ImportedRecordHasWalk { rest: records, wanted: wanted, found: false } {
        if st.found || imported_record_list_empty(st.rest) { return st.found; }
        next st = imported_record_list_has_step(st);
    }
    return st.found;
}
fn imported_record_list_has_step(st: ImportedRecordHasWalk) -> (result: ImportedRecordHasWalk) {
    return match st.rest {
        decl.ImportedRecordList.IRNil => st,
        decl.ImportedRecordList.IRCons { head: item, tail: rest } => imported_record_list_has_one(st, item, rest)
    };
}
fn imported_record_list_has_one(st: ImportedRecordHasWalk, item: decl.ImportedRecordSchema, rest: decl.ImportedRecordList) -> (result: ImportedRecordHasWalk) {
    if decl.semantic_identity_equal(item.identity, st.wanted) {
        return ImportedRecordHasWalk { rest: decl.ImportedRecordList.IRNil, wanted: st.wanted, found: true };
    }
    return ImportedRecordHasWalk { rest: rest, wanted: st.wanted, found: false };
}
fn imported_enum_list_has(enums: decl.ImportedEnumList, wanted: decl.SemanticIdentity) -> (result: bool) {
    iterate i up_to 1024 carrying st: ImportedEnumHasWalk = ImportedEnumHasWalk { rest: enums, wanted: wanted, found: false } {
        if st.found || imported_enum_list_empty(st.rest) { return st.found; }
        next st = imported_enum_list_has_step(st);
    }
    return st.found;
}
fn imported_enum_list_has_step(st: ImportedEnumHasWalk) -> (result: ImportedEnumHasWalk) {
    return match st.rest {
        decl.ImportedEnumList.IENil => st,
        decl.ImportedEnumList.IECons { head: item, tail: rest } => imported_enum_list_has_one(st, item, rest)
    };
}
fn imported_enum_list_has_one(st: ImportedEnumHasWalk, item: decl.ImportedEnumSchema, rest: decl.ImportedEnumList) -> (result: ImportedEnumHasWalk) {
    if decl.semantic_identity_equal(item.identity, st.wanted) {
        return ImportedEnumHasWalk { rest: decl.ImportedEnumList.IENil, wanted: st.wanted, found: true };
    }
    return ImportedEnumHasWalk { rest: rest, wanted: st.wanted, found: false };
}

fn add_markers_for_record_fields(all_markers: decl.NominalTypeIdentityList, fields: decl.ImportedRecordFieldList, initial: MarkerAddResult) -> (result: MarkerAddResult) {
    iterate i up_to 1024 carrying st: RecordFieldMarkerWalk = RecordFieldMarkerWalk { rest: fields, all_markers: all_markers, result: initial } {
        if imported_record_field_list_empty(st.rest) { return st.result; }
        next st = add_markers_for_record_field_step(st);
    }
    return st.result;
}
fn add_markers_for_record_field_step(st: RecordFieldMarkerWalk) -> (result: RecordFieldMarkerWalk) {
    return match st.rest {
        decl.ImportedRecordFieldList.IRFNil => st,
        decl.ImportedRecordFieldList.IRFCons { head: field, tail: rest } => RecordFieldMarkerWalk { rest: rest, all_markers: st.all_markers, result: add_markers_for_sem_type(st.all_markers, field.ty, st.result) }
    };
}
fn add_markers_for_enum_variants(all_markers: decl.NominalTypeIdentityList, variants: decl.ImportedEnumVariantList, initial: MarkerAddResult) -> (result: MarkerAddResult) {
    iterate i up_to 1024 carrying st: EnumVariantMarkerWalk = EnumVariantMarkerWalk { rest: variants, all_markers: all_markers, result: initial } {
        if imported_enum_variant_list_empty(st.rest) { return st.result; }
        next st = add_markers_for_enum_variant_step(st);
    }
    return st.result;
}
fn add_markers_for_enum_variant_step(st: EnumVariantMarkerWalk) -> (result: EnumVariantMarkerWalk) {
    return match st.rest {
        decl.ImportedEnumVariantList.IEVNil => st,
        decl.ImportedEnumVariantList.IEVCons { head: variant, tail: rest } => EnumVariantMarkerWalk { rest: rest, all_markers: st.all_markers, result: add_markers_for_enum_fields(st.all_markers, variant.fields, st.result) }
    };
}
fn add_markers_for_enum_fields(all_markers: decl.NominalTypeIdentityList, fields: decl.ImportedEnumFieldList, initial: MarkerAddResult) -> (result: MarkerAddResult) {
    iterate i up_to 1024 carrying st: EnumFieldMarkerWalk = EnumFieldMarkerWalk { rest: fields, all_markers: all_markers, result: initial } {
        if imported_enum_field_list_empty(st.rest) { return st.result; }
        next st = add_markers_for_enum_field_step(st);
    }
    return st.result;
}
fn add_markers_for_enum_field_step(st: EnumFieldMarkerWalk) -> (result: EnumFieldMarkerWalk) {
    return match st.rest {
        decl.ImportedEnumFieldList.IEFNil => st,
        decl.ImportedEnumFieldList.IEFCons { head: field, tail: rest } => EnumFieldMarkerWalk { rest: rest, all_markers: st.all_markers, result: add_markers_for_sem_type(st.all_markers, field.ty, st.result) }
    };
}

record TargetNominalPrecombine { rest: NominalModuleList, acc: NominalModuleList }
fn precombine_target_nominals<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], nominal_modules: NominalModuleList, all_markers: decl.NominalTypeIdentityList) -> (result: NominalModuleList) {
    iterate i up_to 64 carrying st: TargetNominalPrecombine = TargetNominalPrecombine { rest: nominal_modules, acc: NominalModuleList.NMNil } {
        if nominal_module_list_empty(st.rest) { return st.acc; }
        next st = precombine_target_nominal_step<M, N>(sources, flat_pages, all_markers, st);
    }
    return st.acc;
}
fn precombine_target_nominal_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all_markers: decl.NominalTypeIdentityList, st: TargetNominalPrecombine) -> (result: TargetNominalPrecombine) {
    return match st.rest {
        NMNil => st,
        NMCons { head: item, tail: rest } => precombine_target_nominal_one<M, N>(sources, flat_pages, all_markers, item, rest, st.acc)
    };
}
fn precombine_target_nominal_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all_markers: decl.NominalTypeIdentityList, item: NominalModule, rest: NominalModuleList, acc: NominalModuleList) -> (result: TargetNominalPrecombine) {
    if item.source_index >= sources.len || item.source_index >= 64 {
        return TargetNominalPrecombine { rest: rest, acc: NominalModuleList.NMCons { head: item, tail: acc } };
    }
    let pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, item.source_index);
    let stride: u64 = module_stride(sources, item.source_index);
    let total: u64 = module_total(sources, item.source_index);
    let combined: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(pages, stride, total, all_markers, item.resolved);
    let cached: NominalModule = NominalModule { source_index: item.source_index, local: item.local, resolved: combined };
    return TargetNominalPrecombine { rest: rest, acc: NominalModuleList.NMCons { head: cached, tail: acc } };
}
// Compute only the transitive nominal schema closure reachable from the
// target module's AST and imported callable signatures.
fn expand_target_schemas<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], dependency_modules: ModuleList, nominal_modules: NominalModuleList, all_markers: decl.NominalTypeIdentityList, seed_markers: decl.NominalTypeIdentityList) -> (result: TargetSchemaState) {
    let precombined: NominalModuleList = precombine_target_nominals<M, N>(sources, flat_pages, nominal_modules, all_markers);
    let initial: TargetSchemaState = TargetSchemaState {
        wanted_markers: seed_markers,
        records: decl.ImportedRecordList.IRNil,
        enums: decl.ImportedEnumList.IENil,
        provider_nominals: NominalModuleList.NMNil,
        provider_fn_buckets: ProviderFnBucketsList.PFBNil,
        provider_nominal_buckets: TargetNominalBucketsList.TNBNil,
        changed: true
    };
    iterate round up_to 32 carrying st: TargetSchemaState = initial {
        if !(st.changed) { return st; }
        next st = expand_target_schemas_round<M, N>(sources, flat_pages, dependency_modules, precombined, all_markers, TargetSchemaState { ..st, changed: false });
    }
    return st;
}
fn expand_target_schemas_round<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], dependency_modules: ModuleList, nominal_modules: NominalModuleList, all_markers: decl.NominalTypeIdentityList, state: TargetSchemaState) -> (result: TargetSchemaState) {
    iterate i up_to 64 carrying walk: TargetSchemaModuleWalk = TargetSchemaModuleWalk { rest: dependency_modules, nominal_modules: nominal_modules, all_markers: all_markers, state: state } {
        if module_list_empty(walk.rest) { return walk.state; }
        next walk = expand_target_schemas_module_step<M, N>(sources, flat_pages, walk);
    }
    return walk.state;
}
fn expand_target_schemas_module_step<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], walk: TargetSchemaModuleWalk) -> (result: TargetSchemaModuleWalk) {
    return match walk.rest {
        MNil => walk,
        MCons { head: parsed, tail: rest } => expand_target_schemas_module_one<M, N>(sources, flat_pages, walk, parsed, rest)
    };
}
fn expand_target_schemas_module_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], walk: TargetSchemaModuleWalk, parsed: ParsedModule, rest: ModuleList) -> (result: TargetSchemaModuleWalk) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let input_stride: u64 = module_stride(sources, parsed.source_index);
    let input_total: u64 = module_total(sources, parsed.source_index);
    let facts: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, walk.nominal_modules, parsed.source_index);
    let target_nominals: decl.NominalTypeIdentityList = facts.facts.resolved;
    let after_records: TargetSchemaState = expand_target_record_decls<N>(input_pages, input_stride, input_total, parsed.unit.records, facts.facts.local, walk.all_markers, target_nominals, parsed.unit.records, parsed.unit.enums, walk.state);
    let after_enums: TargetSchemaState = expand_target_enum_decls<N>(input_pages, input_stride, input_total, parsed.unit.enums, facts.facts.local, walk.all_markers, target_nominals, parsed.unit.records, parsed.unit.enums, after_records);
    return TargetSchemaModuleWalk { rest: rest, nominal_modules: walk.nominal_modules, all_markers: walk.all_markers, state: after_enums };
}
fn expand_target_record_decls<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, records: decl.RecordList, local: decl.NominalTypeIdentityList, all_markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, unit_records: decl.RecordList, unit_enums: decl.EnumList, state: TargetSchemaState) -> (result: TargetSchemaState) {
    iterate i up_to 1024 carrying st: TargetSchemaRecordWalk = TargetSchemaRecordWalk { rest: records, local: local, all_markers: all_markers, target_nominals: target_nominals, unit_records: unit_records, unit_enums: unit_enums, state: state } {
        if record_decl_list_empty(st.rest) { return st.state; }
        next st = expand_target_record_decl_step<N>(pages, stride, total, st);
    }
    return st.state;
}
fn expand_target_record_decl_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: TargetSchemaRecordWalk) -> (result: TargetSchemaRecordWalk) {
    return match st.rest {
        decl.RecordList.RNil => st,
        decl.RecordList.RCons { head: record_decl, tail: rest } => expand_target_record_decl_one<N>(pages, stride, total, st, record_decl, rest)
    };
}
fn expand_target_record_decl_one<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: TargetSchemaRecordWalk, record_decl: decl.RecordDecl, rest: decl.RecordList) -> (result: TargetSchemaRecordWalk) {
    let identity: decl.NominalLookup = local_nominal_identity_by_span(st.local, record_decl.name_start, record_decl.name_end);
    if !(identity.found) { return TargetSchemaRecordWalk { ..st, rest: rest }; }
    let wanted: ProjectNominalContains = project_nominal_contains(st.state.wanted_markers, identity.identity);
    if !(wanted.found) || imported_record_list_has(st.state.records, identity.identity) {
        return TargetSchemaRecordWalk { ..st, rest: rest };
    }
    let built_fields: ProjectRecordFields = project_record_fields<N>(pages, stride, total, record_decl.fields, st.unit_records, st.unit_enums, st.all_markers, st.target_nominals);
    let schema: decl.ImportedRecordSchema = decl.ImportedRecordSchema { identity: identity.identity, fields: built_fields.fields };
    let next_markers: MarkerAddResult = add_markers_for_record_fields(st.all_markers, built_fields.fields, MarkerAddResult { markers: st.state.wanted_markers, added: false });
    let next_state: TargetSchemaState = TargetSchemaState {
        ..st.state,
        wanted_markers: next_markers.markers,
        records: decl.ImportedRecordList.IRCons { head: schema, tail: st.state.records },
        changed: st.state.changed || next_markers.added
    };
    return TargetSchemaRecordWalk { ..st, rest: rest, state: next_state };
}
fn expand_target_enum_decls<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, enums: decl.EnumList, local: decl.NominalTypeIdentityList, all_markers: decl.NominalTypeIdentityList, target_nominals: decl.NominalTypeIdentityList, unit_records: decl.RecordList, unit_enums: decl.EnumList, state: TargetSchemaState) -> (result: TargetSchemaState) {
    iterate i up_to 1024 carrying st: TargetSchemaEnumWalk = TargetSchemaEnumWalk { rest: enums, local: local, all_markers: all_markers, target_nominals: target_nominals, unit_records: unit_records, unit_enums: unit_enums, state: state } {
        if enum_decl_list_empty(st.rest) { return st.state; }
        next st = expand_target_enum_decl_step<N>(pages, stride, total, st);
    }
    return st.state;
}
fn expand_target_enum_decl_step<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: TargetSchemaEnumWalk) -> (result: TargetSchemaEnumWalk) {
    return match st.rest {
        decl.EnumList.GNil => st,
        decl.EnumList.GCons { head: enum_decl, tail: rest } => expand_target_enum_decl_one<N>(pages, stride, total, st, enum_decl, rest)
    };
}
fn expand_target_enum_decl_one<N: Nat>(pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, st: TargetSchemaEnumWalk, enum_decl: decl.EnumDecl, rest: decl.EnumList) -> (result: TargetSchemaEnumWalk) {
    let identity: decl.NominalLookup = local_nominal_identity_by_span(st.local, enum_decl.name_start, enum_decl.name_end);
    if !(identity.found) { return TargetSchemaEnumWalk { ..st, rest: rest }; }
    let wanted: ProjectNominalContains = project_nominal_contains(st.state.wanted_markers, identity.identity);
    if !(wanted.found) || imported_enum_list_has(st.state.enums, identity.identity) {
        return TargetSchemaEnumWalk { ..st, rest: rest };
    }
    let built: ProjectEnumVariantBuild = project_enum_variants<N>(pages, stride, total, enum_decl.variants, st.unit_records, st.unit_enums, st.all_markers, st.target_nominals);
    let schema: decl.ImportedEnumSchema = decl.ImportedEnumSchema { identity: identity.identity, variants: built.variants };
    let next_markers: MarkerAddResult = add_markers_for_enum_variants(st.all_markers, built.variants, MarkerAddResult { markers: st.state.wanted_markers, added: false });
    let next_state: TargetSchemaState = TargetSchemaState {
        ..st.state,
        wanted_markers: next_markers.markers,
        enums: decl.ImportedEnumList.IECons { head: schema, tail: st.state.enums },
        changed: st.state.changed || next_markers.added
    };
    return TargetSchemaEnumWalk { ..st, rest: rest, state: next_state };
}

fn lower_target_module_selected<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all_modules: ModuleList, to_lower: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, dependency_modules: ModuleList, dependency_nominal_modules: NominalModuleList, all_markers: decl.NominalTypeIdentityList, target_found: bool) -> (result: ProjectBuild) {
    if !(target_found) {
        return begin_project_lowering_for_modules(to_lower, all_modules, imports, nominal_modules, decl.NominalTypeIdentityList.NINil, decl.ImportedRecordList.IRNil, decl.ImportedEnumList.IENil, false);
    }
    return match to_lower {
        MNil => begin_project_lowering_for_modules(ModuleList.MNil, all_modules, imports, nominal_modules, decl.NominalTypeIdentityList.NINil, decl.ImportedRecordList.IRNil, decl.ImportedEnumList.IENil, false),
        MCons { head: parsed, tail: rest } => lower_one_target_project_module<M, N>(sources, flat_pages, all_modules, imports, nominal_modules, dependency_modules, dependency_nominal_modules, all_markers, parsed)
    };
}
fn lower_one_target_project_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all_modules: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, dependency_modules: ModuleList, dependency_nominal_modules: NominalModuleList, all_markers: decl.NominalTypeIdentityList, parsed: ParsedModule) -> (result: ProjectBuild) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let input_stride: u64 = module_stride(sources, parsed.source_index);
    let input_total: u64 = module_total(sources, parsed.source_index);
    let facts: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, dependency_nominal_modules, parsed.source_index);
    let transport_nominals: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(input_pages, input_stride, input_total, all_markers, facts.facts.resolved);
    let fn_buckets: ProviderFnBucketsList = build_provider_fn_buckets_list<M, N>(sources, flat_pages, dependency_modules);
    let imported: decl.SigTab = imported_signatures_with_buckets<M, N>(sources, flat_pages, parsed, all_modules, transport_nominals, nominal_modules, fn_buckets, true);
    let seeded_from_ast: decl.NominalTypeIdentityList = seed_markers_from_nominals(all_markers, facts.facts.resolved, decl.NominalTypeIdentityList.NINil);
    let seed_markers: decl.NominalTypeIdentityList = seed_markers_from_sigtab(all_markers, imported, seeded_from_ast);
    let closure: TargetSchemaState = expand_target_schemas<M, N>(sources, flat_pages, dependency_modules, dependency_nominal_modules, all_markers, seed_markers);
    let nominals: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(input_pages, input_stride, input_total, closure.wanted_markers, facts.facts.resolved);
    let proof: decl.UnitProve = decl.prove_parsed_unit_with_imported_schemas<1024, N>(input_pages, input_stride, input_total, parsed.unit, imported, nominals, closure.records, closure.enums);
    let lowered: flow.LoweredUnit = flow.lower_proven_unit<1024, N>(input_pages, input_stride, input_total, proof);
    let value_ssa: ssa.ValueSsaSummary = ssa.lower_value_ssa_with_imported_schemas<1024, N>(input_pages, input_stride, input_total, lowered, nominals, closure.records, closure.enums);
    let built_module: ProjectModule = ProjectModule { source_id: parsed.source_id, source_path: parsed.source_path, source_index: parsed.source_index, flow: lowered, value_ssa: value_ssa };
    return ProjectBuild {
        rest: ModuleList.MNil,
        all: all_modules,
        imports: imports,
        nominal_modules: nominal_modules,
        nominal_markers: closure.wanted_markers,
        imported_records: closure.records,
        imported_enums: closure.enums,
        acc: ProjectModuleList.PCons { head: built_module, tail: ProjectModuleList.PNil },
        valid: lowered.valid,
        ssa_valid: value_ssa.valid,
        count: 1,
        failed: lower_stage_failure(StageFailure { stage: 0, source_index: 0, code: 0, start: 0, end: 0 }, parsed.source_index, proof, lowered),
        target_missing: false
    };
}

fn prove_provider_body<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, unit: decl.Unit, imported: decl.SigTab, nominals: decl.NominalTypeIdentityList, schemas: TargetSchemaState) -> (result: decl.UnitProve) {
    return prove_provider_body_with_identity<P, N>(pages, stride, total, unit, imported, nominals, schemas, decl.invalid_semantic_identity());
}
fn prove_provider_body_with_identity<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, unit: decl.Unit, imported: decl.SigTab, nominals: decl.NominalTypeIdentityList, schemas: TargetSchemaState, known_identity: decl.SemanticIdentity) -> (result: decl.UnitProve) {
    // Provider selection established a single, unambiguous declaration and
    // the resolved nominal identities already include the source's locals.
    let sigs: decl.SigTabRep = decl.collect_sigtab<P, N>(pages, stride, total, unit.fns, unit.records, unit.enums, nominals);
    let local: decl.SigTab = decl.bind_single_local_callable_identity<P, N>(pages, stride, total, unit.header, sigs.tab, known_identity);
    let signatures: decl.SigTab = decl.merge_sig_tables<P, N>(pages, stride, total, local, imported);
    let profile_011: bool = decl.profile_at_least_minor<P, N>(pages, stride, total, unit.header.version_start, unit.header.version_end, 11);
    let profile_013: bool = decl.profile_at_least_013<P, N>(pages, stride, total, unit.header.version_start, unit.header.version_end);
    let initial: decl.BodyWalk = decl.BodyWalk {
        rest: unit.fns, tab: signatures, rectab: unit.records, enumtab: unit.enums,
        nominals: nominals, imported_records: schemas.records, imported_enums: schemas.enums,
        total: total, profile_011: profile_011, profile_013: profile_013,
        obls: sigs.obls, tops: decl.TopsList.TLNil, ok: true, n: 0
    };
    let body: decl.BodyWalk = decl.prove_bodies_step<P, N>(pages, stride, total, initial);
    let ok: bool = body.ok && body.n == 1 && decl.declared_fn_list_empty(body.rest)
        && !(decl.obl_has_fail<P, N>(pages, stride, total, body.obls));
    let err: decl.ExprSpan = decl.first_fail_span<P, N>(pages, stride, total, body.obls);
    return decl.UnitProve { ok: ok, err_start: select(ok, 0, err.start), err_end: select(ok, 0, err.end), unit: unit, obls: body.obls, tops: body.tops, fn_count: body.n };
}

// Resolve the target's transitive import closure for schema construction.
// Import signatures and source diagnostics still use the complete project;
// only record and enum schemas are restricted to modules that can affect the
// selected module. Each module admits at most 1024 uses, while the project
// retains at most 4096 resolved links. Build bounded per-source adjacency once
// and visit each reachable module once, so reverse-ordered chains do not
// rescan the complete link list on every fixed-point round.
fn project_import_closure(imports: ImportList, target_source_index: u64, source_count: u64) -> (result: ProjectImportClosure) {
    let empty: [bool; 64] = [false; 64];
    if target_source_index >= empty.len {
        return ProjectImportClosure { reachable: empty, changed: false };
    }
    if source_count < empty.len {
        if target_source_index >= source_count {
            return ProjectImportClosure { reachable: empty, changed: false };
        }
    }
    let initial_reachable: [bool; 64] = replace(empty, target_source_index, true);
    // Keep the common shallow-closure path to at most two linear scans. Deeper
    // reverse-ordered chains use adjacency plus a worklist instead of paying
    // for repeated full-project rescans before traversal.
    let first_round: ProjectImportClosure = project_import_closure_round(imports, initial_reachable, source_count);
    if !(first_round.changed) { return first_round; }
    if source_count < empty.len {
        if project_import_closure_complete_prefix(first_round.reachable, source_count) {
            return ProjectImportClosure { reachable: first_round.reachable, changed: false };
        }
    }
    let second_round: ProjectImportClosure = project_import_closure_round(imports, first_round.reachable, source_count);
    if !(second_round.changed) {
        return ProjectImportClosure { reachable: second_round.reachable, changed: false };
    }
    if source_count == empty.len {
        if project_import_closure_complete(second_round.reachable) {
            return ProjectImportClosure { reachable: second_round.reachable, changed: false };
        }
    } else {
        if project_import_closure_complete_prefix(second_round.reachable, source_count) {
            return ProjectImportClosure { reachable: second_round.reachable, changed: false };
        }
    }

    let adjacency: [ImportList; 64] = project_import_adjacency(imports, source_count);
    let seeded: ProjectImportClosureWork = project_import_closure_seed_work(second_round.reachable, source_count);
    iterate i up_to 64 carrying st: ProjectImportClosureWork = seeded {
        if st.pending_count == 0 {
            return ProjectImportClosure { reachable: st.reachable, changed: false };
        }
        let source_index: u64 = st.pending[st.pending_count - 1];
        let popped: ProjectImportClosureWork = ProjectImportClosureWork {
            reachable: st.reachable,
            pending: st.pending,
            pending_count: st.pending_count - 1,
            source_count: st.source_count
        };
        let outgoing: ImportList = adjacency[source_index];
        next st = project_import_closure_expand(outgoing, popped);
    }
    return ProjectImportClosure { reachable: st.reachable, changed: false };
}
fn project_import_closure_round(imports: ImportList, reachable: [bool; 64], source_count: u64) -> (result: ProjectImportClosure) {
    let initial: ProjectImportClosureWalk = ProjectImportClosureWalk { rest: imports, reachable: reachable, changed: false, source_count: source_count };
    iterate batch up_to 4 carrying st: ProjectImportClosureWalk = initial {
        if import_list_empty(st.rest) { return ProjectImportClosure { reachable: st.reachable, changed: st.changed }; }
        next st = project_import_closure_part(st);
    }
    return ProjectImportClosure { reachable: st.reachable, changed: st.changed };
}
fn project_import_closure_part(initial: ProjectImportClosureWalk) -> (result: ProjectImportClosureWalk) {
    iterate i up_to 1024 carrying st: ProjectImportClosureWalk = initial {
        if import_list_empty(st.rest) { return st; }
        next st = project_import_closure_link(st);
    }
    return st;
}
fn project_import_closure_link(st: ProjectImportClosureWalk) -> (result: ProjectImportClosureWalk) {
    return match st.rest {
        INil => st,
        ICons { head: link, tail: rest } => project_import_closure_link_one(st, link, rest)
    };
}
fn project_import_closure_link_one(st: ProjectImportClosureWalk, link: ImportLink, rest: ImportList) -> (result: ProjectImportClosureWalk) {
    // The fixed 64-slot representation is capacity, not membership in this project.
    if link.source_index >= st.reachable.len || link.target_index >= st.reachable.len
        || link.source_index >= st.source_count || link.target_index >= st.source_count {
        return ProjectImportClosureWalk { rest: rest, reachable: st.reachable, changed: st.changed, source_count: st.source_count };
    }
    if !(st.reachable[link.source_index]) || st.reachable[link.target_index] {
        return ProjectImportClosureWalk { rest: rest, reachable: st.reachable, changed: st.changed, source_count: st.source_count };
    }
    return ProjectImportClosureWalk {
        rest: rest,
        reachable: replace(st.reachable, link.target_index, true),
        changed: true,
        source_count: st.source_count
    };
}
fn project_import_closure_complete(reachable: [bool; 64]) -> (result: bool) {
    iterate i up_to 64 carrying complete: bool = true {
        if !(reachable[i]) { return false; }
        next complete = true;
    }
    return complete;
}
fn project_import_closure_complete_prefix(reachable: [bool; 64], source_count: u64) -> (result: bool) {
    iterate i up_to 64 carrying complete: bool = true {
        if i >= source_count { return complete; }
        if !(reachable[i]) { return false; }
        next complete = true;
    }
    return complete;
}
fn project_import_closure_seed_work(reachable: [bool; 64], source_count: u64) -> (result: ProjectImportClosureWork) {
    let empty: [u64; 64] = [0; 64];
    let initial: ProjectImportClosureSeed = ProjectImportClosureSeed { pending: empty, pending_count: 0 };
    iterate i up_to 64 carrying st: ProjectImportClosureSeed = initial {
        if i >= source_count {
            return ProjectImportClosureWork { reachable: reachable, pending: st.pending, pending_count: st.pending_count, source_count: source_count };
        }
        next st = project_import_closure_seed_step(reachable, i, st);
    }
    return ProjectImportClosureWork { reachable: reachable, pending: st.pending, pending_count: st.pending_count, source_count: source_count };
}
fn project_import_closure_seed_step(reachable: [bool; 64], index: u64, st: ProjectImportClosureSeed) -> (result: ProjectImportClosureSeed) {
    if !(reachable[index]) { return st; }
    let pending: [u64; 64] = replace(st.pending, st.pending_count, index);
    return ProjectImportClosureSeed { pending: pending, pending_count: st.pending_count + 1 };
}

fn project_import_adjacency(imports: ImportList, source_count: u64) -> (result: [ImportList; 64]) {
    let empty: [ImportList; 64] = [ImportList.INil; 64];
    let initial: ProjectImportAdjacencyBuild = ProjectImportAdjacencyBuild { rest: imports, by_source: empty, source_count: source_count };
    iterate batch up_to 4 carrying st: ProjectImportAdjacencyBuild = initial {
        if import_list_empty(st.rest) { return st.by_source; }
        next st = project_import_adjacency_part(st);
    }
    return st.by_source;
}
fn project_import_adjacency_part(initial: ProjectImportAdjacencyBuild) -> (result: ProjectImportAdjacencyBuild) {
    iterate i up_to 1024 carrying st: ProjectImportAdjacencyBuild = initial {
        if import_list_empty(st.rest) { return st; }
        next st = project_import_adjacency_step(st);
    }
    return st;
}
fn project_import_adjacency_step(st: ProjectImportAdjacencyBuild) -> (result: ProjectImportAdjacencyBuild) {
    return match st.rest {
        INil => st,
        ICons { head: link, tail: rest } => project_import_adjacency_add(st, link, rest)
    };
}
fn project_import_adjacency_add(st: ProjectImportAdjacencyBuild, link: ImportLink, rest: ImportList) -> (result: ProjectImportAdjacencyBuild) {
    if link.source_index >= 64 || link.target_index >= 64
        || link.source_index >= st.source_count || link.target_index >= st.source_count {
        return ProjectImportAdjacencyBuild { rest: rest, by_source: st.by_source, source_count: st.source_count };
    }
    let outgoing: ImportList = st.by_source[link.source_index];
    let updated: ImportList = ImportList.ICons { head: link, tail: outgoing };
    return ProjectImportAdjacencyBuild {
        rest: rest,
        by_source: replace(st.by_source, link.source_index, updated),
        source_count: st.source_count
    };
}

fn project_import_closure_expand(links: ImportList, work: ProjectImportClosureWork) -> (result: ProjectImportClosureWork) {
    let initial: ProjectImportClosureExpansion = ProjectImportClosureExpansion { rest: links, work: work };
    iterate i up_to 1024 carrying st: ProjectImportClosureExpansion = initial {
        if import_list_empty(st.rest) { return st.work; }
        next st = project_import_closure_expand_step(st);
    }
    return st.work;
}
fn project_import_closure_expand_step(st: ProjectImportClosureExpansion) -> (result: ProjectImportClosureExpansion) {
    return match st.rest {
        INil => st,
        ICons { head: link, tail: rest } => project_import_closure_expand_link(st, link, rest)
    };
}
fn project_import_closure_expand_link(st: ProjectImportClosureExpansion, link: ImportLink, rest: ImportList) -> (result: ProjectImportClosureExpansion) {
    if link.target_index >= st.work.reachable.len || link.target_index >= st.work.source_count
        || st.work.reachable[link.target_index] || st.work.pending_count >= st.work.pending.len {
        return ProjectImportClosureExpansion { rest: rest, work: st.work };
    }
    let reachable: [bool; 64] = replace(st.work.reachable, link.target_index, true);
    let pending: [u64; 64] = replace(st.work.pending, st.work.pending_count, link.target_index);
    return ProjectImportClosureExpansion {
        rest: rest,
        work: ProjectImportClosureWork {
            reachable: reachable,
            pending: pending,
            pending_count: st.work.pending_count + 1,
            source_count: st.work.source_count
        }
    };
}
fn import_list_empty(imports: ImportList) -> (result: bool) {
    return match imports { INil => true, ICons { head: link, tail: rest } => false };
}
fn project_modules_in_closure<M: Nat>(sources: [ProjectSource; up_to M], modules: ModuleList, reachable: [bool; 64]) -> (result: ModuleList) {
    iterate i over sources carrying st: ProjectModuleClosureFilter = ProjectModuleClosureFilter {
        rest: modules,
        reachable: reachable,
        acc: ModuleList.MNil
    } {
        if module_list_empty(st.rest) { return reverse_modules<M>(sources, st.acc); }
        next st = project_module_closure_filter_step(st);
    }
    return reverse_modules<M>(sources, st.acc);
}
fn project_module_closure_filter_step(st: ProjectModuleClosureFilter) -> (result: ProjectModuleClosureFilter) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => project_module_closure_filter_one(st, parsed, rest)
    };
}
fn project_module_closure_filter_one(st: ProjectModuleClosureFilter, parsed: ParsedModule, rest: ModuleList) -> (result: ProjectModuleClosureFilter) {
    if parsed.source_index >= st.reachable.len {
        return ProjectModuleClosureFilter { rest: rest, reachable: st.reachable, acc: st.acc };
    }
    if !(st.reachable[parsed.source_index]) {
        return ProjectModuleClosureFilter { rest: rest, reachable: st.reachable, acc: st.acc };
    }
    return ProjectModuleClosureFilter {
        rest: rest,
        reachable: st.reachable,
        acc: ModuleList.MCons { head: parsed, tail: st.acc }
    };
}

fn lower_project_modules_selected<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], all_modules: ModuleList, to_lower: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, dependency_modules: ModuleList, target_found: bool) -> (result: ProjectBuild) {
    let markers: decl.NominalTypeIdentityList = project_nominal_markers(nominal_modules);
    let imported_records: decl.ImportedRecordList = project_record_schemas<M, N>(sources, flat_pages, dependency_modules, nominal_modules, markers);
    let imported_enums: decl.ImportedEnumList = project_enum_schemas<M, N>(sources, flat_pages, dependency_modules, nominal_modules, markers);
    let initial: ProjectBuild = begin_project_lowering_for_modules(to_lower, all_modules, imports, nominal_modules, markers, imported_records, imported_enums, target_found);
    iterate i over sources carrying st: ProjectBuild = initial {
        next st = lower_project_one<M, N>(sources, flat_pages, st);
    }
    iterate i over sources carrying rev: ProjectBuildRev = ProjectBuildRev { rest: st.acc, acc: ProjectModuleList.PNil } {
        next rev = reverse_project_build(rev);
    }
    return ProjectBuild { rest: ModuleList.MNil, all: all_modules, imports: imports, nominal_modules: nominal_modules, nominal_markers: markers, imported_records: imported_records, imported_enums: imported_enums, acc: rev.acc, valid: st.valid, ssa_valid: st.ssa_valid, count: st.count, failed: st.failed, target_missing: st.target_missing };
}
fn module_head_matches_index(modules: ModuleList, target_source_index: u64) -> (result: bool) {
    return match modules { MNil => false, MCons { head: parsed, tail: rest } => parsed.source_index == target_source_index };
}
fn module_tail(modules: ModuleList) -> (result: ModuleList) {
    return match modules { MNil => ModuleList.MNil, MCons { head: parsed, tail: rest } => rest };
}
fn module_head_singleton(modules: ModuleList) -> (result: ModuleList) {
    return match modules { MNil => ModuleList.MNil, MCons { head: parsed, tail: rest } => ModuleList.MCons { head: parsed, tail: ModuleList.MNil } };
}
fn select_target_module(modules: ModuleList, target_source_index: u64) -> (result: TargetModuleSelection) {
    iterate i up_to 64 carrying rest: ModuleList = modules {
        if module_list_empty(rest) { return TargetModuleSelection { rest: ModuleList.MNil, selected: ModuleList.MNil, target_source_index: target_source_index, found: false }; }
        if module_head_matches_index(rest, target_source_index) {
            return TargetModuleSelection { rest: module_tail(rest), selected: module_head_singleton(rest), target_source_index: target_source_index, found: true };
        }
        next rest = module_tail(rest);
    }
    return TargetModuleSelection { rest: ModuleList.MNil, selected: ModuleList.MNil, target_source_index: target_source_index, found: false };
}
fn module_list_empty(modules: ModuleList) -> (result: bool) {
    return match modules { MNil => true, MCons { head: parsed, tail: rest } => false };
}
fn begin_project_lowering_for_modules(rest: ModuleList, all: ModuleList, imports: ImportList, nominal_modules: NominalModuleList, nominal_markers: decl.NominalTypeIdentityList, imported_records: decl.ImportedRecordList, imported_enums: decl.ImportedEnumList, target_found: bool) -> (result: ProjectBuild) {
    return ProjectBuild { rest: rest, all: all, imports: imports, nominal_modules: nominal_modules, nominal_markers: nominal_markers, imported_records: imported_records, imported_enums: imported_enums, acc: ProjectModuleList.PNil, valid: target_found, ssa_valid: target_found, count: 0, failed: StageFailure { stage: 0, source_index: 0, code: 0, start: 0, end: 0 }, target_missing: !(target_found) };
}
fn lower_project_one<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectBuild) -> (result: ProjectBuild) {
    return match st.rest {
        MNil => st,
        MCons { head: parsed, tail: rest } => lower_one_project_module<M, N>(sources, flat_pages, st, parsed, rest)
    };
}
fn lower_one_project_module<M: Nat, N: Nat>(sources: [ProjectSource; up_to 64], flat_pages: [[byte; up_to N]; up_to M], st: ProjectBuild, parsed: ParsedModule, rest: ModuleList) -> (result: ProjectBuild) {
    let input_pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(sources, flat_pages, parsed.source_index);
    let input_stride: u64 = module_stride(sources, parsed.source_index);
    let input_total: u64 = module_total(sources, parsed.source_index);
    let facts: NominalModuleLookup = nominal_module_by_index<M, N>(sources, flat_pages, st.nominal_modules, parsed.source_index);
    let nominals: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(input_pages, input_stride, input_total, st.nominal_markers, facts.facts.resolved);
    let imported: decl.SigTab = imported_signatures<M, N>(sources, flat_pages, parsed, st.all, nominals, st.nominal_modules);
    let proof: decl.UnitProve = decl.prove_parsed_unit_with_imported_schemas<1024, N>(input_pages, input_stride, input_total, parsed.unit, imported, nominals, st.imported_records, st.imported_enums);
    let lowered: flow.LoweredUnit = flow.lower_proven_unit<1024, N>(input_pages, input_stride, input_total, proof);
    let value_ssa: ssa.ValueSsaSummary = ssa.lower_value_ssa_with_imported_schemas<1024, N>(input_pages, input_stride, input_total, lowered, nominals, st.imported_records, st.imported_enums);
    return ProjectBuild {
        rest: rest,
        all: st.all,
        imports: st.imports,
        nominal_modules: st.nominal_modules,
        nominal_markers: st.nominal_markers,
        imported_records: st.imported_records,
        imported_enums: st.imported_enums,
        acc: ProjectModuleList.PCons { head: ProjectModule { source_id: parsed.source_id, source_path: parsed.source_path, source_index: parsed.source_index, flow: lowered, value_ssa: value_ssa }, tail: st.acc },
        valid: st.valid && lowered.valid,
        ssa_valid: st.ssa_valid && value_ssa.valid,
        count: st.count + 1,
        failed: lower_stage_failure(st.failed, parsed.source_index, proof, lowered),
        target_missing: st.target_missing
    };
}
fn lower_stage_failure(prior: StageFailure, source_index: u64, proof: decl.UnitProve, lowered: flow.LoweredUnit) -> (result: StageFailure) {
    if prior.stage != 0 { return prior; }
    if !(proof.ok) { return StageFailure { stage: 2, source_index: source_index, code: 0, start: proof.err_start, end: proof.err_end }; }
    if !(lowered.valid) {
        let diag: flow.Diagnostic = flow.first_diagnostic(lowered);
        return StageFailure { stage: 3, source_index: source_index, code: diag.code, start: diag.start, end: diag.end };
    }
    return prior;
}
fn reverse_project_build(st: ProjectBuildRev) -> (result: ProjectBuildRev) {
    return match st.rest {
        PNil => st,
        PCons { head: built_module, tail: rest } => ProjectBuildRev { rest: rest, acc: ProjectModuleList.PCons { head: built_module, tail: st.acc } }
    };
}

// The first failing stage explains itself: a parse/proof/flow/SSA failure
// always carries its module and span or unsupported anchor, so a project
// result is never invalid without a reason.
fn append_stage_diagnostic<M: Nat>(sources: [ProjectSource; up_to M], diagnostics: DiagnosticList, built: ModuleBuild, failed: StageFailure) -> (result: DiagnosticList) {
    if built.parse_failed { return DiagnosticList.DiagCons { head: ProjectDiagnostic.ParseFailed { source_index: built.parse_index, start: built.parse_start, end: built.parse_end }, tail: diagnostics }; }
    if failed.stage == 0 { return diagnostics; }
    if failed.stage == 2 { return DiagnosticList.DiagCons { head: ProjectDiagnostic.ProofFailed { source_index: failed.source_index, start: failed.start, end: failed.end }, tail: diagnostics }; }
    return DiagnosticList.DiagCons { head: ProjectDiagnostic.FlowFailed { source_index: failed.source_index, code: failed.code, start: failed.start, end: failed.end }, tail: diagnostics };
}
fn append_target_missing(diagnostics: DiagnosticList, target_missing: bool, target_source_index: u64, target_only: bool) -> (result: DiagnosticList) {
    if target_only && target_missing { return DiagnosticList.DiagCons { head: ProjectDiagnostic.TargetModuleMissing { source_index: target_source_index }, tail: diagnostics }; }
    return diagnostics;
}

fn compile_project<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M]) -> (result: ProjectResult) {
    let ordered: bool = source_ordered<64>(snapshot.sources);
    // CP-0021: the per-module page descriptors must partition the flat
    // page array in source order; a gap, overlap, or trailing page fails
    // the project exactly like the old source/view count mismatch did.
    let counts_match: bool = descriptors_cover<M, N>(snapshot.sources, flat_pages);
    let built: ModuleBuild = build_modules<M, N>(snapshot.sources, flat_pages, 0, false);
    let parsed: ModuleList = reverse_modules<64>(snapshot.sources, built.acc);
    let duplicate: DiagnosticList = duplicate_modules<M, N>(snapshot.sources, flat_pages, parsed);
    let resolved: Resolution = resolve_imports<M, N>(snapshot.sources, flat_pages, parsed);
    let local_nominals: NominalModuleList = collect_local_nominal_modules<M, N>(snapshot.sources, flat_pages, parsed);
    let nominal_modules: NominalModuleList = resolve_project_nominal_modules<M, N>(snapshot.sources, flat_pages, parsed, local_nominals);
    let lowered: ProjectBuild = lower_project_modules<M, N>(snapshot.sources, flat_pages, parsed, resolved.imports, nominal_modules);
    let basic: DiagnosticList = order_diagnostics<64>(snapshot.sources, ordered, counts_match);
    let diagnostics1: DiagnosticList = append_diagnostics<64>(snapshot.sources, basic, duplicate);
    let diagnostics2: DiagnosticList = append_diagnostics<64>(snapshot.sources, diagnostics1, resolved.diagnostics);
    let diagnostics: DiagnosticList = append_stage_diagnostic<64>(snapshot.sources, diagnostics2, built, lowered.failed);
    // The host-provided fingerprint is advisory metadata only. This native
    // project pass has not recomputed its digest over the supplied snapshot.
    let valid: bool = ordered && counts_match && built.valid && diagnostics_empty<64>(snapshot.sources, diagnostics) && resolved.valid && lowered.valid;
    return ProjectResult {
        valid: valid,
        fingerprint: snapshot.fingerprint,
        fingerprint_authenticated: false,
        value_ssa_valid: lowered.ssa_valid && resolved.valid,
        source_count: snapshot.sources.len,
        module_count: built.count,
        import_count: resolved.count,
        import_module_name_comparisons: resolved.import_module_name_comparisons,
        import_resolution_cache_hits: resolved.import_resolution_cache_hits,
        import_resolution_negative_cache_hits: resolved.import_resolution_negative_cache_hits,
        import_resolution_cache_entries_max: resolved.import_resolution_cache_entries_max,
        modules: lowered.acc,
        imports: resolved.imports,
        diagnostics: diagnostics
    };
}
// Compile one ordered snapshot source through proof, CFG, and verified SSA
// while retaining only the target's transitive import closure as signature,
// nominal, and record-schema providers for on-demand provider materialization.
fn compile_project_target_with_context<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], target_source_index: u64) -> (result: SelectedProjectContext) {
    let ordered: bool = source_ordered<64>(snapshot.sources);
    let counts_match: bool = descriptors_cover<M, N>(snapshot.sources, flat_pages);
    // Parse target bodies for lowering; parse provider bodies fully for the
    // same syntax diagnostics, then retain only their import signatures.
    let built: ModuleBuild = build_modules<M, N>(snapshot.sources, flat_pages, target_source_index, true);
    let parsed: ModuleList = reverse_modules<64>(snapshot.sources, built.acc);
    let duplicate: DiagnosticList = duplicate_modules<M, N>(snapshot.sources, flat_pages, parsed);
    let resolved: Resolution = resolve_imports<M, N>(snapshot.sources, flat_pages, parsed);
    let local_nominals: NominalModuleList = collect_local_nominal_modules<M, N>(snapshot.sources, flat_pages, parsed);
    let nominal_modules: NominalModuleList = resolve_project_nominal_modules<M, N>(snapshot.sources, flat_pages, parsed, local_nominals);
    let selected: TargetModuleSelection = select_target_module(parsed, target_source_index);
    let dependency_closure: ProjectImportClosure = project_import_closure(resolved.imports, target_source_index, snapshot.sources.len);
    let dependency_modules: ModuleList = project_modules_in_closure<64>(snapshot.sources, parsed, dependency_closure.reachable);
    let dependency_nominal_modules: NominalModuleList = project_nominal_modules_in_closure<64>(snapshot.sources, nominal_modules, dependency_closure.reachable);
    let markers: decl.NominalTypeIdentityList = project_nominal_markers(dependency_nominal_modules);
    let lowered: ProjectBuild = lower_target_module_selected<M, N>(snapshot.sources, flat_pages, parsed, selected.selected, resolved.imports, nominal_modules, dependency_modules, dependency_nominal_modules, markers, selected.found);
    let basic: DiagnosticList = order_diagnostics<64>(snapshot.sources, ordered, counts_match);
    let diagnostics1: DiagnosticList = append_diagnostics<64>(snapshot.sources, basic, duplicate);
    let diagnostics2: DiagnosticList = append_diagnostics<64>(snapshot.sources, diagnostics1, resolved.diagnostics);
    let diagnostics3: DiagnosticList = append_stage_diagnostic<64>(snapshot.sources, diagnostics2, built, lowered.failed);
    let diagnostics: DiagnosticList = append_target_missing(diagnostics3, lowered.target_missing, target_source_index, true);
    let valid: bool = ordered && counts_match && built.valid && diagnostics_empty<64>(snapshot.sources, diagnostics) && resolved.valid && lowered.valid && !(lowered.target_missing);
    let proj_res: ProjectResult = ProjectResult {
        valid: valid,
        fingerprint: snapshot.fingerprint,
        fingerprint_authenticated: false,
        value_ssa_valid: lowered.ssa_valid && resolved.valid && !(lowered.target_missing),
        source_count: snapshot.sources.len,
        module_count: built.count,
        import_count: resolved.count,
        import_module_name_comparisons: resolved.import_module_name_comparisons,
        import_resolution_cache_hits: resolved.import_resolution_cache_hits,
        import_resolution_negative_cache_hits: resolved.import_resolution_negative_cache_hits,
        import_resolution_cache_entries_max: resolved.import_resolution_cache_entries_max,
        modules: lowered.acc,
        imports: resolved.imports,
        diagnostics: diagnostics
    };
    return SelectedProjectContext {
        result: proj_res,
        reachable: dependency_closure.reachable,
        dependency_modules: dependency_modules,
        dependency_nominal_modules: dependency_nominal_modules,
        nominal_markers: markers
    };
}

// Pre-combine project nominal markers with each dependency module's resolved
// nominals once per provider so per-callable materialization never re-copies
// the full project marker list on every reachable function.
record ProviderNominalPrecombine { rest: NominalModuleList, acc: NominalModuleList }
fn precombine_provider_nominals<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: SelectedProjectContext, dep_nominals: NominalModuleList, markers: decl.NominalTypeIdentityList) -> (result: NominalModuleList) {
    iterate i up_to 64 carrying st: ProviderNominalPrecombine = ProviderNominalPrecombine { rest: dep_nominals, acc: NominalModuleList.NMNil } {
        if nominal_module_list_empty(st.rest) { return st.acc; }
        next st = precombine_provider_nominal_step<M, N>(snapshot, flat_pages, ctx, markers, st);
    }
    return st.acc;
}
fn precombine_provider_nominal_step<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: SelectedProjectContext, markers: decl.NominalTypeIdentityList, st: ProviderNominalPrecombine) -> (result: ProviderNominalPrecombine) {
    return match st.rest {
        NMNil => st,
        NMCons { head: item, tail: rest } => precombine_provider_nominal_one<M, N>(snapshot, flat_pages, ctx, markers, item, rest, st.acc)
    };
}
fn precombine_provider_nominal_one<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: SelectedProjectContext, markers: decl.NominalTypeIdentityList, item: NominalModule, rest: NominalModuleList, acc: NominalModuleList) -> (result: ProviderNominalPrecombine) {
    let pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(snapshot.sources, flat_pages, item.source_index);
    let stride: u64 = module_stride(snapshot.sources, item.source_index);
    let total: u64 = module_total(snapshot.sources, item.source_index);
    let selected: TargetModuleSelection = select_target_module(ctx.dependency_modules, item.source_index);
    let decl_refs: decl.NominalTypeIdentityList = match selected.selected {
        MNil => decl.NominalTypeIdentityList.NINil,
        MCons { head: provider, tail: unused } => precombine_provider_decl_refs<M, N>(snapshot, flat_pages, pages, stride, total, ctx, provider, item.local)
    };
    let with_markers: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(pages, stride, total, decl_refs, markers);
    let combined: decl.NominalTypeIdentityList = decl.combine_nominal_type_identities<1024, N>(pages, stride, total, item.local, with_markers);
    let cached: NominalModule = NominalModule { source_index: item.source_index, local: item.local, resolved: combined };
    return ProviderNominalPrecombine { rest: rest, acc: NominalModuleList.NMCons { head: cached, tail: acc } };
}
fn precombine_provider_decl_refs<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, ctx: SelectedProjectContext, provider: ParsedModule, local: decl.NominalTypeIdentityList) -> (result: decl.NominalTypeIdentityList) {
    let decl_only_unit: decl.Unit = decl.Unit { ..provider.unit, fns: decl.FnList.DNil };
    let decl_only_provider: ParsedModule = ParsedModule { ..provider, unit: decl_only_unit };
    return project_nominal_references_only<M, N>(
        snapshot.sources, flat_pages, pages, stride, total, decl_only_provider,
        ctx.dependency_modules, ctx.dependency_nominal_modules, local
    );
}

// Resolve once for the immutable import closure used by provider bodies.
fn project_provider_schemas<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: SelectedProjectContext) -> (result: TargetSchemaState) {
    let records: decl.ImportedRecordList = project_record_schemas<M, N>(snapshot.sources, flat_pages, ctx.dependency_modules, ctx.dependency_nominal_modules, ctx.nominal_markers);
    let enums: decl.ImportedEnumList = project_enum_schemas<M, N>(snapshot.sources, flat_pages, ctx.dependency_modules, ctx.dependency_nominal_modules, ctx.nominal_markers);
    let provider_nominals: NominalModuleList = precombine_provider_nominals<M, N>(snapshot, flat_pages, ctx, ctx.dependency_nominal_modules, ctx.nominal_markers);
    let provider_fn_buckets: ProviderFnBucketsList = build_provider_fn_buckets_list<M, N>(snapshot.sources, flat_pages, ctx.dependency_modules);
    let provider_nominal_buckets: TargetNominalBucketsList = build_target_nominal_buckets<M, N>(snapshot.sources, flat_pages, ctx.dependency_nominal_modules);
    return TargetSchemaState { wanted_markers: ctx.nominal_markers, records: records, enums: enums, provider_nominals: provider_nominals, provider_fn_buckets: provider_fn_buckets, provider_nominal_buckets: provider_nominal_buckets, changed: false };
}
// Materialize one reachable body from the already syntax-checked provider.
// The body stays in its original paged view and the complete signature
// inventory remains available for calls in that body.
record MaterializedProviderBuildWithCache { ok: bool, modules: ProjectModuleList, start: u64, end: u64, local_sig_cache: ProviderLocalSigCache }
fn materialize_provider_callable<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: SelectedProjectContext, schemas: TargetSchemaState, provider_source_index: u64, start: u64, end: u64) -> (result: MaterializedProviderBuild) {
    let built: MaterializedProviderBuildWithCache = materialize_provider_callable_cached<M, N>(snapshot, flat_pages, ctx, schemas, provider_source_index, start, end, decl.invalid_semantic_identity(), empty_provider_local_sig_cache());
    return MaterializedProviderBuild { ok: built.ok, modules: built.modules, start: built.start, end: built.end };
}
fn materialize_provider_callable_cached<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: SelectedProjectContext, schemas: TargetSchemaState, provider_source_index: u64, start: u64, end: u64, known_identity: decl.SemanticIdentity, local_sig_cache: ProviderLocalSigCache) -> (result: MaterializedProviderBuildWithCache) {
    let refused: MaterializedProviderBuildWithCache = MaterializedProviderBuildWithCache { ok: false, modules: ProjectModuleList.PNil, start: 0, end: 0, local_sig_cache: local_sig_cache };
    if !(ctx.result.valid) || provider_source_index >= snapshot.sources.len || provider_source_index >= 64 {
        return refused;
    }
    if !(ctx.reachable[provider_source_index]) {
        return refused;
    }
    let selected: TargetModuleSelection = select_target_module(ctx.dependency_modules, provider_source_index);
    return match selected.selected {
        MNil => refused,
        MCons { head: provider, tail: rest } => build_provider_callable_cached<M, N>(snapshot, flat_pages, ctx, schemas, provider, start, end, known_identity, local_sig_cache)
    };
}

record LocalCallDeclarations { rest: decl.CallSiteList, declarations: decl.FnList }
fn local_declarations_for_call_sites_bucketed<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, calls: decl.CallSiteList, declarations: decl.FnList, bucket_node: ProviderFnBucketsList) -> (result: decl.FnList) {
    let initial: LocalCallDeclarations = LocalCallDeclarations { rest: calls, declarations: decl.FnList.DNil };
    iterate chunk up_to 64 carrying outer: LocalCallDeclarations = initial {
        iterate i up_to 1024 carrying inner: LocalCallDeclarations = outer {
            if decl.call_site_list_empty(inner.rest) { return inner.declarations; }
            next inner = local_call_declarations_step<P, N>(pages, stride, total, declarations, bucket_node, inner);
        }
        next outer = inner;
    }
    return outer.declarations;
}
fn local_declarations_for_call_sites<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, calls: decl.CallSiteList, declarations: decl.FnList) -> (result: decl.FnList) {
    return local_declarations_for_call_sites_bucketed<P, N>(pages, stride, total, calls, declarations, ProviderFnBucketsList.PFBNil);
}
fn local_declarations_for_calls<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, body: decl.FnList, declarations: decl.FnList) -> (result: decl.FnList) {
    let calls: decl.CallSiteList = decl.collect_call_sites<P, N>(pages, stride, total, body);
    return local_declarations_for_call_sites<P, N>(pages, stride, total, calls, declarations);
}
fn local_call_declarations_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, declarations: decl.FnList, bucket_node: ProviderFnBucketsList, st: LocalCallDeclarations) -> (result: LocalCallDeclarations) {
    return match st.rest {
        CNil => st,
        CCons { head: call, tail: rest } => local_call_declarations_one<P, N>(pages, stride, total, declarations, bucket_node, st.declarations, call, rest)
    };
}
fn select_search_fns_from_bucket<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, bucket_node: ProviderFnBucketsList, declarations: decl.FnList, start: u64, end: u64) -> (result: decl.FnList) {
    if provider_fn_buckets_empty(bucket_node) { return declarations; }
    return provider_fn_buckets_head_bucket(bucket_node, decl_name_bucket64<P, N>(pages, stride, total, start, end));
}
fn local_call_declarations_one<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, declarations: decl.FnList, bucket_node: ProviderFnBucketsList, selected: decl.FnList, call: decl.CallSite, rest: decl.CallSiteList) -> (result: LocalCallDeclarations) {
    if call_has_dot<P, N>(pages, stride, total, call.start, call.end) || module_has_local_fn_same<P, N>(pages, stride, total, call.start, call.end, selected) {
        return LocalCallDeclarations { rest: rest, declarations: selected };
    }
    let search_fns: decl.FnList = select_search_fns_from_bucket<P, N>(pages, stride, total, bucket_node, declarations, call.start, call.end);
    let match_fn: LocalFnSearchWalk = find_local_fn_same<P, N>(pages, stride, total, call.start, call.end, search_fns);
    let next_declarations: decl.FnList = match match_fn.selected {
        DNil => selected,
        DCons { head: fd, tail: unused } => decl.FnList.DCons { head: fd, tail: selected }
    };
    return LocalCallDeclarations { rest: rest, declarations: next_declarations };
}

fn resolve_provider_callable_nominals<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], pages: [[byte; up_to N]; up_to 1024], stride: u64, total: u64, ctx: SelectedProjectContext, schemas: TargetSchemaState, parsed_provider: ParsedModule, body: decl.FnDecl, walked: decl.CallWalk, existing_nom: NominalModuleLookup) -> (result: decl.NominalTypeIdentityList) {
    let body_spans: decl.NominalTypeSpanList = decl.collect_fn_body_nominal_type_spans_with_walk<1024, N>(pages, stride, total, body, walked);
    if decl.nominal_type_span_list_empty(body_spans) {
        return existing_nom.facts.resolved;
    }
    let refreshed_refs: decl.NominalTypeIdentityList = project_nominal_spans_bucketed<M, N>(
        snapshot.sources, flat_pages, parsed_provider,
        ctx.dependency_modules, schemas.provider_nominal_buckets, body_spans
    );
    return decl.combine_nominal_type_identities<1024, N>(pages, stride, total, refreshed_refs, existing_nom.facts.resolved);
}
fn build_provider_callable_cached<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], ctx: SelectedProjectContext, schemas: TargetSchemaState, provider: ParsedModule, start: u64, end: u64, known_identity: decl.SemanticIdentity, local_sig_cache: ProviderLocalSigCache) -> (result: MaterializedProviderBuildWithCache) {
    let provider_source_index: u64 = provider.source_index;
    let item: ProjectSource = snapshot.sources[provider_source_index];
    let pages: [[byte; up_to N]; up_to 1024] = module_pages<M, N>(snapshot.sources, flat_pages, provider_source_index);
    let keyword: decl.Expect = decl.expect<1024, N>(pages, item.stride, item.total, start, 12);
    if !(keyword.ok) {
        return MaterializedProviderBuildWithCache { ok: false, modules: ProjectModuleList.PNil, start: keyword.err_start, end: keyword.err_end, local_sig_cache: local_sig_cache };
    }
    let profile_013: bool = decl.profile_at_least_013<1024, N>(pages, item.stride, item.total, provider.unit.header.version_start, provider.unit.header.version_end);
    let body: decl.FnDecl = decl.parse_fn<1024, N>(pages, item.stride, item.total, keyword.cursor, start, profile_013, true);
    if !(body.ok) || body.fn_end != end {
        return MaterializedProviderBuildWithCache { ok: false, modules: ProjectModuleList.PNil, start: body.err_start, end: body.err_end, local_sig_cache: local_sig_cache };
    }
    let unit: decl.Unit = decl.Unit { ..provider.unit, fns: decl.FnList.DCons { head: body, tail: decl.FnList.DNil } };
    let parsed_provider: ParsedModule = ParsedModule {
        ..provider,
        unit: unit
    };
    let walked: decl.CallWalk = decl.collect_call_walk<1024, N>(pages, item.stride, item.total, unit.fns);
    let calls: decl.CallSiteList = decl.reverse_call_sites<1024, N>(pages, item.stride, item.total, walked.calls);
    let bucket_node: ProviderFnBucketsList = find_provider_fn_buckets_node(schemas.provider_fn_buckets, provider_source_index);
    let local_calls: decl.FnList = local_declarations_for_call_sites_bucketed<1024, N>(pages, item.stride, item.total, calls, provider.unit.fns, bucket_node);
    let existing_nom: NominalModuleLookup = nominal_module_by_index<M, N>(snapshot.sources, flat_pages, schemas.provider_nominals, provider_source_index);
    let nominals: decl.NominalTypeIdentityList = resolve_provider_callable_nominals<M, N>(snapshot, flat_pages, pages, item.stride, item.total, ctx, schemas, parsed_provider, body, walked, existing_nom);
    let sig_res: CallSigResult = resolve_call_signatures_with_cache_and_sites_and_buckets<M, N>(snapshot.sources, flat_pages, pages, item.stride, item.total, parsed_provider, ctx.dependency_modules, nominals, ctx.dependency_nominal_modules, local_calls, local_sig_cache, schemas.provider_fn_buckets, false, calls);
    let proof: decl.UnitProve = prove_provider_body_with_identity<1024, N>(pages, item.stride, item.total, unit, sig_res.tab, nominals, schemas, known_identity);
    let lowered: flow.LoweredUnit = flow.lower_proven_unit<1024, N>(pages, item.stride, item.total, proof);
    let value_ssa: ssa.ValueSsaSummary = ssa.lower_value_ssa_with_known_identity<1024, N>(pages, item.stride, item.total, lowered, nominals, schemas.records, schemas.enums, known_identity);
    if !(lowered.valid) || !(value_ssa.valid) {
        let failed: StageFailure = lower_stage_failure(StageFailure { stage: 0, source_index: 0, code: 0, start: 0, end: 0 }, provider_source_index, proof, lowered);
        return MaterializedProviderBuildWithCache { ok: false, modules: ProjectModuleList.PNil, start: failed.start, end: failed.end, local_sig_cache: sig_res.local_sig_cache };
    }
    let built_module: ProjectModule = ProjectModule { source_id: provider.source_id, source_path: provider.source_path, source_index: provider_source_index, flow: lowered, value_ssa: value_ssa };
    return MaterializedProviderBuildWithCache { ok: true, modules: ProjectModuleList.PCons { head: built_module, tail: ProjectModuleList.PNil }, start: 0, end: 0, local_sig_cache: sig_res.local_sig_cache };
}

// Compile one ordered snapshot source through proof, CFG, and verified SSA
// while retaining every module as an import, nominal, and record-schema
// provider. `target_source_index` indexes the ordered source descriptors.
fn compile_project_target<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], target_source_index: u64) -> (result: ProjectResult) {
    let ctx: SelectedProjectContext = compile_project_target_with_context<M, N>(snapshot, flat_pages, target_source_index);
    return ctx.result;
}

// Compile the selected source and project its current diagnostics into source
// positions in one native call. ProjectResult remains byte-span authoritative;
// callers can refresh locations from the exact source pages used here.
fn compile_project_target_with_diagnostic_locations<M: Nat, N: Nat>(snapshot: ProjectSnapshot, flat_pages: [[byte; up_to N]; up_to M], target_source_index: u64) -> (result: ProjectResultWithDiagnosticLocations) {
    let sources: [ProjectSource; up_to 64] = snapshot.sources;
    let compiled: ProjectResult = compile_project_target<M, N>(snapshot, flat_pages, target_source_index);
    let locations: ProjectDiagnosticLocationList = locate_project_diagnostics_global<M, N>(sources, flat_pages, compiled.diagnostics);
    return ProjectResultWithDiagnosticLocations { result: compiled, diagnostic_locations: locations };
}
