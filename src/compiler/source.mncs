// Render both ends of an ordered source span in one bounded prefix walk.
// Start is clamped to the clamped end when callers provide a reversed span.
// The zero-stride fallback preserves the total behavior of line_col_global;
// canonical logical sources use a positive stride and take the single-pass path.
fn line_col_span_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: LineColSpan) {
    let clamped_end: u64 = select(end <= total, end, total);
    let clamped_start: u64 = select(start <= clamped_end, start, clamped_end);
    if stride == 0 {
        return LineColSpan {
            start: line_col_global<P, N>(pages, stride, total, clamped_start),
            end: line_col_global<P, N>(pages, stride, total, clamped_end)
        };
    }
    let initial: LineCol = LineCol { line: 1, col: 1 };
    if clamped_start == 0 {
        return LineColSpan {
            start: initial,
            end: line_col_global<P, N>(pages, stride, total, clamped_end)
        };
    }
    if clamped_start == clamped_end {
        let position: LineCol = line_col_global<P, N>(pages, stride, total, clamped_end);
        return LineColSpan { start: position, end: position };
    }
    let required_pages: u64 = page_count_for(stride, clamped_end);
    let scanned_pages: u64 = select(required_pages <= pages.len, required_pages, pages.len);
    let initial_scan: LineColSpanScan = LineColSpanScan {
        current: initial,
        start: initial,
        found_start: clamped_start == 0
    };
    iterate p over pages[0..scanned_pages] carrying scan: LineColSpanScan = initial_scan {
        next scan = line_col_span_page_step<P, N>(
            pages, stride, p, clamped_start, clamped_end, scan
        );
    }
    if !scan.found_start {
        return LineColSpan { start: scan.current, end: scan.current };
    }
    return LineColSpan { start: scan.start, end: scan.current };
}
fn line_col_span_page_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, index: u64, start: u64, end: u64, st: LineColSpanScan) -> (result: LineColSpanScan) {
    let page: [byte; up_to N] = pages[index];
    let base: u64 = index * stride;
    if base >= end { return st; }
    let remaining: u64 = end - base;
    let scanned_bytes: u64 = select(page.len <= remaining, page.len, remaining);
    iterate i over page[0..scanned_bytes] carrying cur: LineColSpanScan = st {
        next cur = line_col_span_step(base + i, start, end, page[i] as u64, cur);
    }
    return cur;
}
fn line_col_span_step(pos: u64, start: u64, end: u64, value: u64, st: LineColSpanScan) -> (result: LineColSpanScan) {
    let current: LineCol = line_step_at(pos, end, value, st.current);
    if pos == start {
        return LineColSpanScan { current: current, start: st.current, found_start: true };
    }
    return LineColSpanScan { current: current, start: st.start, found_start: st.found_start };
}
fn line_step_at(pos: u64, end: u64, value: u64, st: LineCol) -> (result: LineCol) {
    if pos >= end { return st; }
    if value == 10 { return LineCol { line: st.line + 1, col: 1 }; }
    if value >= 128 && value <= 191 { return st; }
    return LineCol { line: st.line, col: st.col + 1 };
}

// Static resource accounting for a claimed logical shape: page count,
// bytes, capacity, and the per-operation step bounds the implementation
// above honors (byte access O(1), validation O(pages), full scans O(bytes)).
record LogicalCost { pages: u64, bytes: u64, capacity: u64, byte_at_steps: u64, validate_steps: u64, full_scan_steps: u64 }
fn accounting(stride: u64, total: u64) -> (result: LogicalCost) {
    let pages: u64 = page_count_for(stride, total);
    return LogicalCost { pages: pages, bytes: total, capacity: pages * stride, byte_at_steps: 1, validate_steps: pages, full_scan_steps: total };
}
