// alphanumeric ranges generated from Rust char properties (841 intervals above ASCII).
fn unicode_alphanumeric(value: u64) -> (result: bool) {
    if value < 128 || value > 1114111 { return false; }
    return match value / 65536 {
        0 => unicode_alphanumeric_plane0(value),
        1 => unicode_alphanumeric_plane1(value),
        2 => unicode_alphanumeric_plane2(value),
        3 => unicode_alphanumeric_plane3(value),
        _ => false
    };
}
