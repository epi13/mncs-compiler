mncs 0.18;
module mncs.compiler.source.v1;

// A source unit is a bounded byte view whose capacity is inferred from the
// caller. The actual length remains runtime data; compiler APIs do not impose
// the old four-times-64-byte experiment limit.
fn byte_at<N: Nat>(source: [byte; up_to N], offset: u64) -> (result: u64) {
    if offset < source.len {
        return source[offset] as u64;
    }
    return 256;
}

fn ascii<N: Nat>(source: [byte; up_to N]) -> (result: bool) {
    return ascii_view<N>(source);
}

// Check sixteen bytes per interpreter transition. The bounded source views used
// by the compiler are often long, so a byte-at-a-time loop made ASCII
// admission consume one MNCS step for every byte before parsing could start.
fn ascii_view<N: Nat>(source: [byte; up_to N]) -> (result: bool) {
    let groups: u64 = source.len / 16;
    iterate group over source[0..groups] carrying valid: bool = true {
        if !valid { return false; }
        let base: u64 = group * 16;
        if source[base + 0] as u64 >= 128 { return false; }
        if source[base + 1] as u64 >= 128 { return false; }
        if source[base + 2] as u64 >= 128 { return false; }
        if source[base + 3] as u64 >= 128 { return false; }
        if source[base + 4] as u64 >= 128 { return false; }
        if source[base + 5] as u64 >= 128 { return false; }
        if source[base + 6] as u64 >= 128 { return false; }
        if source[base + 7] as u64 >= 128 { return false; }
        if source[base + 8] as u64 >= 128 { return false; }
        if source[base + 9] as u64 >= 128 { return false; }
        if source[base + 10] as u64 >= 128 { return false; }
        if source[base + 11] as u64 >= 128 { return false; }
        if source[base + 12] as u64 >= 128 { return false; }
        if source[base + 13] as u64 >= 128 { return false; }
        if source[base + 14] as u64 >= 128 { return false; }
        if source[base + 15] as u64 >= 128 { return false; }
        next valid = true;
    }
    let tail: u64 = groups * 16;
    if tail < source.len {
        if source[tail] as u64 >= 128 { return false; }
    }
    if tail + 1 < source.len {
        if source[tail + 1] as u64 >= 128 { return false; }
    }
    if tail + 2 < source.len {
        if source[tail + 2] as u64 >= 128 { return false; }
    }
    if tail + 3 < source.len {
        if source[tail + 3] as u64 >= 128 { return false; }
    }
    if tail + 4 < source.len {
        if source[tail + 4] as u64 >= 128 { return false; }
    }
    if tail + 5 < source.len {
        if source[tail + 5] as u64 >= 128 { return false; }
    }
    if tail + 6 < source.len {
        if source[tail + 6] as u64 >= 128 { return false; }
    }
    if tail + 7 < source.len {
        if source[tail + 7] as u64 >= 128 { return false; }
    }
    if tail + 8 < source.len {
        if source[tail + 8] as u64 >= 128 { return false; }
    }
    if tail + 9 < source.len {
        if source[tail + 9] as u64 >= 128 { return false; }
    }
    if tail + 10 < source.len {
        if source[tail + 10] as u64 >= 128 { return false; }
    }
    if tail + 11 < source.len {
        if source[tail + 11] as u64 >= 128 { return false; }
    }
    if tail + 12 < source.len {
        if source[tail + 12] as u64 >= 128 { return false; }
    }
    if tail + 13 < source.len {
        if source[tail + 13] as u64 >= 128 { return false; }
    }
    if tail + 14 < source.len {
        if source[tail + 14] as u64 >= 128 { return false; }
    }
    return true;
}

fn span_valid<N: Nat>(source: [byte; up_to N], start: u64, end: u64) -> (result: bool) {
    return start <= end && end <= source.len;
}

// Human rendering of a byte offset: 1-based line and column, matching
// Stage-0's SourceSpan convention. Columns count bytes on the admitted ASCII
// domain; Unicode scalar columns remain a separately tracked parity item.
record LineCol { line: u64, col: u64 }
record LineColSpan { start: LineCol, end: LineCol }
record LineColSpanScan { current: LineCol, start: LineCol, found_start: bool }
fn line_col<N: Nat>(source: [byte; up_to N], offset: u64) -> (result: LineCol) {
    iterate i over source carrying st: LineCol = LineCol { line: 1, col: 1 } {
        next st = line_step<N>(source, offset, i, st);
    }
    return st;
}
fn line_step<N: Nat>(source: [byte; up_to N], offset: u64, pos: u64, st: LineCol) -> (result: LineCol) {
    if pos >= offset { return st; }
    if byte_at<N>(source, pos) == 10 { return LineCol { line: st.line + 1, col: 1 }; }
    return LineCol { line: st.line, col: st.col + 1 };
}

// Logical immutable source (CP-0001): a fixed-stride page composition of
// bounded views. The host transports pages only; every offset, span, and
// identity decision below executes in MNCS. Canonical form: stride in
// 1..=1024; pages.len == ceil(total / stride) (zero pages iff total == 0);
// every non-terminal page has length exactly stride; the terminal page has
// length total - (pages.len - 1) * stride. A global offset o in [0, total)
// addresses page o / stride, intra-page index o % stride: O(1) with no
// iteration, so per-byte access costs one step regardless of source size.
// The 1024 sequence ceiling caps one logical source at 1024 pages of 1024
// bytes (1 MiB); larger corpora are multi-module projects, not one source.
fn page_count_for(stride: u64, total: u64) -> (result: u64) {
    if stride == 0 { return 0; }
    if total == 0 { return 0; }
    return (total - 1) / stride + 1;
}

// Structural validation of a transported page composition. Codes: 0 valid;
// 1 stride is zero; 2 stride exceeds 1024; 3 a page exceeds the stride;
// 4 a non-terminal page is short; 5 the page count disagrees with
// ceil(total / stride) (duplicate, missing, or padded pages); 6 the
// terminal page length disagrees with the claimed total. Validation is
// O(pages); content identity is a separate fingerprint comparison.
fn validate_pages<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: u64) {
    if stride == 0 { return 1; }
    if stride > 1024 { return 2; }
    if pages.len != page_count_for(stride, total) { return 5; }
    if pages.len == 0 { return 0; }
    iterate i over pages carrying code: u64 = 0 {
        let page: [byte; up_to N] = pages[i];
        // Keep these checks in the page loop: a helper call per page added
        // interpreter work without sharing any validation state.
        let too_large: bool = page.len > stride;
        let short_middle: bool = i + 1 < pages.len && page.len != stride;
        let page_error: u64 = select(too_large, 3, select(short_middle, 4, 0));
        next code = select(code != 0, code, page_error);
    }
    if code != 0 { return code; }
    let last: u64 = pages.len - 1;
    if total < last * stride { return 6; }
    let terminal: [byte; up_to N] = pages[last];
    if terminal.len != total - last * stride { return 6; }
    return 0;
}

// Total global byte access: the content byte as u64, or 256 past the end,
// under a zero stride, or past a transported page edge. Callers validate
// first; this stays total on malformed input regardless.
fn byte_at_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offset: u64) -> (result: u64) {
    if stride == 0 { return 256; }
    if offset >= total { return 256; }
    let page: u64 = offset / stride;
    let intra: u64 = offset % stride;
    if page >= pages.len { return 256; }
    let view: [byte; up_to N] = pages[page];
    if intra >= view.len { return 256; }
    return view[intra] as u64;
}

// Read four adjacent bytes from a logical source. The common case stays in
// one page and avoids four separate global address calculations; page edges,
// short inputs, and malformed views retain byte_at_global's total behavior.
record ByteWindow4 { b0: u64, b1: u64, b2: u64, b3: u64 }
record GlobalPageAddress { valid: bool, page: u64, intra: u64, offset: u64 }
enum ByteWindow4Choice {
    Direct { window: ByteWindow4 },
    GlobalFallback
}

// Resolve the logical page and offset without transporting the page table to
// each scan step. The page-table bound is checked by the caller before it
// indexes the selected page.
fn global_page_address(stride: u64, total: u64, offset: u64) -> (result: GlobalPageAddress) {
    if stride == 0 || offset >= total {
        return GlobalPageAddress { valid: false, page: 0, intra: 0, offset: offset };
    }
    return GlobalPageAddress { valid: true, page: offset / stride, intra: offset % stride, offset: offset };
}

// Produce the common same-page window from one already-selected page. The
// caller uses byte_window4_global for cross-page, short, or malformed cases,
// which remains the total authority for global reads.
fn byte_window4_page<N: Nat>(view: [byte; up_to N], selected_page: u64, address: GlobalPageAddress, stride: u64, total: u64) -> (result: ByteWindow4Choice) {
    if !address.valid || selected_page != address.page || stride == 0 || address.offset >= total || address.intra >= stride || address.intra >= view.len {
        return ByteWindow4Choice.GlobalFallback;
    }
    if total - address.offset >= 4 && stride - address.intra >= 4 && view.len - address.intra >= 4 {
        let b0: u64 = view[address.intra + 0] as u64;
        let b1: u64 = view[address.intra + 1] as u64;
        let b2: u64 = view[address.intra + 2] as u64;
        let b3: u64 = view[address.intra + 3] as u64;
        return ByteWindow4Choice.Direct { window: ByteWindow4 { b0: b0, b1: b1, b2: b2, b3: b3 } };
    }
    return ByteWindow4Choice.GlobalFallback;
}

fn byte_at_global_delta<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offset: u64, delta: u64) -> (result: u64) {
    if offset > 18446744073709551615 - delta { return 256; }
    return byte_at_global<P, N>(pages, stride, total, offset + delta);
}

fn missing_window4() -> (result: ByteWindow4) {
    return ByteWindow4 { b0: 256, b1: 256, b2: 256, b3: 256 };
}

// The common case stays in one page and avoids four global address
// calculations. Page edges and malformed views retain byte_at_global behavior.
fn byte_window4_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offset: u64) -> (result: ByteWindow4) {
    if stride == 0 { return missing_window4(); }
    if offset >= total { return missing_window4(); }
    let page: u64 = offset / stride;
    let intra: u64 = offset % stride;
    if page >= pages.len { return missing_window4(); }
    let view: [byte; up_to N] = pages[page];
    if intra >= view.len { return missing_window4(); }
    if total - offset >= 4 && stride - intra >= 4 && view.len - intra >= 4 {
        let b0: u64 = view[intra + 0] as u64;
        let b1: u64 = view[intra + 1] as u64;
        let b2: u64 = view[intra + 2] as u64;
        let b3: u64 = view[intra + 3] as u64;
        return ByteWindow4 { b0: b0, b1: b1, b2: b2, b3: b3 };
    }
    let b0: u64 = byte_at_global_delta<P, N>(pages, stride, total, offset, 0);
    let b1: u64 = byte_at_global_delta<P, N>(pages, stride, total, offset, 1);
    let b2: u64 = byte_at_global_delta<P, N>(pages, stride, total, offset, 2);
    let b3: u64 = byte_at_global_delta<P, N>(pages, stride, total, offset, 3);
    return ByteWindow4 { b0: b0, b1: b1, b2: b2, b3: b3 };
}

// Global spans are stable across stride choices: the same content chunked
// at any stride lexes to identical spans.
fn span_valid_global(total: u64, start: u64, end: u64) -> (result: bool) {
    return start <= end && end <= total;
}

// The ASCII admission predicate over all transported page bytes. The empty
// source is vacuously ASCII; a zero stride addresses nothing and likewise
// admits. Validators run separately; this never fails.
fn ascii_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    if stride == 0 || total == 0 { return true; }
    iterate p over pages carrying valid: bool = true {
        let page_valid: bool = ascii_page_step<P, N>(pages, p, valid);
        if !page_valid { return false; }
        next valid = page_valid;
    }
    return valid;
}
fn ascii_page_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], index: u64, valid: bool) -> (result: bool) {
    if !valid { return false; }
    let page: [byte; up_to N] = pages[index];
    return ascii_view<N>(page);
}

// FNV-1a/64 content identity, vendored from the mncs.std.fnv1a.v1 step so
// the compiler owns module identity without a stdlib dependency. Order and
// duplication sensitive: swapped, duplicated, or dropped pages change the
// fold. The empty source folds to the basis. Not cryptographic.
fn fnv_basis() -> (result: u64) { return 14695981039346656037; }
fn fnv_step(state: u64, value: byte) -> (result: u64) {
    return (state ^ (value as u64)) *% 1099511628211;
}
fn fingerprint_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: u64) {
    if stride == 0 || total == 0 { return fnv_basis(); }
    iterate p over pages carrying h: u64 = fnv_basis() {
        next h = fingerprint_page_step<P, N>(pages, p, h);
    }
    return h;
}
fn fingerprint_page_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], index: u64, h: u64) -> (result: u64) {
    let page: [byte; up_to N] = pages[index];
    let groups: u64 = page.len / 4;
    iterate group over page[0..groups] carrying grouped: u64 = h {
        let base: u64 = group * 4;
        let h0: u64 = (grouped ^ (page[base + 0] as u64)) *% 1099511628211;
        let h1: u64 = (h0 ^ (page[base + 1] as u64)) *% 1099511628211;
        let h2: u64 = (h1 ^ (page[base + 2] as u64)) *% 1099511628211;
        next grouped = (h2 ^ (page[base + 3] as u64)) *% 1099511628211;
    }
    let tail_count: u64 = page.len - groups * 4;
    iterate tail_index over page[0..tail_count] carrying acc: u64 = grouped {
        next acc = fnv_step(acc, page[groups * 4 + tail_index]);
    }
    return acc;
}

// Global rendering of a byte offset: 1-based line and column under the same
// convention as line_col. Page p starts at global p * stride; bytes at or
// past the clamped offset freeze the carry. Out-of-range offsets render the
// end-of-source position.
fn line_col_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offset: u64) -> (result: LineCol) {
    let end: u64 = select(offset <= total, offset, total);
    if stride == 0 {
        iterate p over pages carrying st: LineCol = LineCol { line: 1, col: 1 } {
            next st = line_col_page_step<P, N>(pages, stride, p, end, st);
        }
        return st;
    }
    let required_pages: u64 = page_count_for(stride, end);
    let scanned_pages: u64 = select(required_pages <= pages.len, required_pages, pages.len);
    iterate p over pages[0..scanned_pages] carrying st: LineCol = LineCol { line: 1, col: 1 } {
        next st = line_col_page_step<P, N>(pages, stride, p, end, st);
    }
    return st;
}

// Map a bounded monotone batch of byte offsets with one forward scan. Offsets
// are clamped to total as in line_col_global; equal clamped offsets are
// allowed. An out-of-order batch is rejected with its first decreasing query
// index so callers can sort source locations or use independent lookups.
record LineColManyResult { ordered: bool, invalid_index: u64, locations: [LineCol; up_to 64] }
record LineColManyState {
    cursor: u64,
    current: LineCol,
    previous: u64,
    has_previous: bool,
    ordered: bool,
    invalid_index: u64,
    locations: [LineCol; 64]
}
fn line_cols_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offsets: [u64; up_to 64]) -> (result: LineColManyResult) {
    let initial: LineCol = LineCol { line: 1, col: 1 };
    let empty_locations: [LineCol; 64] = [initial; 64];
    iterate index over offsets carrying st: LineColManyState = LineColManyState {
        cursor: 0,
        current: initial,
        previous: 0,
        has_previous: false,
        ordered: true,
        invalid_index: 0,
        locations: empty_locations
    } {
        next st = line_cols_step<P, N>(pages, stride, total, offsets[index], index, st);
    }
    if !st.ordered {
        return LineColManyResult {
            ordered: false,
            invalid_index: st.invalid_index,
            locations: st.locations[0..0]
        };
    }
    return LineColManyResult {
        ordered: true,
        invalid_index: 0,
        locations: st.locations[0..offsets.len]
    };
}
fn line_cols_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offset: u64, index: u64, st: LineColManyState) -> (result: LineColManyState) {
    if !st.ordered { return st; }
    let clamped: u64 = select(offset <= total, offset, total);
    if st.has_previous && clamped < st.previous {
        return LineColManyState {
            cursor: st.cursor,
            current: st.current,
            previous: st.previous,
            has_previous: true,
            ordered: false,
            invalid_index: index,
            locations: st.locations
        };
    }
    let position: LineCol = line_col_many_position<P, N>(
        pages, stride, total, st.cursor, clamped, st.current
    );
    let next_state: LineColManyState = LineColManyState {
        cursor: clamped,
        current: position,
        previous: clamped,
        has_previous: true,
        ordered: true,
        invalid_index: 0,
        locations: replace(st.locations, index, position)
    };
    return next_state;
}
fn line_col_many_position<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, current: LineCol) -> (result: LineCol) {
    if stride == 0 { return line_col_global<P, N>(pages, stride, total, end); }
    return line_col_advance_global<P, N>(pages, stride, start, end, current);
}
fn line_col_advance_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, start: u64, end: u64, initial: LineCol) -> (result: LineCol) {
    if stride == 0 { return line_col_global<P, N>(pages, stride, end, end); }
    let required_pages: u64 = page_count_for(stride, end);
    let scanned_pages: u64 = select(required_pages <= pages.len, required_pages, pages.len);
    // Ordered callers already scanned the prefix ending at start. Skip its
    // page headers and scan only the remainder of the current page onward.
    let requested_start_page: u64 = start / stride;
    let first_page: u64 = select(requested_start_page <= scanned_pages, requested_start_page, scanned_pages);
    iterate p over pages[first_page..scanned_pages] carrying st: LineCol = initial {
        next st = line_col_advance_page_step<P, N>(pages, stride, start, end, first_page + p, st);
    }
    return st;
}
fn line_col_advance_page_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, start: u64, end: u64, index: u64, st: LineCol) -> (result: LineCol) {
    let page: [byte; up_to N] = pages[index];
    let base: u64 = index * stride;
    if base >= end { return st; }
    let begin: u64 = line_col_page_local_start(start, base);
    let remaining: u64 = end - base;
    let finish: u64 = select(page.len <= remaining, page.len, remaining);
    if begin >= finish { return st; }
    iterate i over page[begin..finish] carrying cur: LineCol = st {
        next cur = line_col_advance_byte(page[begin + i] as u64, cur);
    }
    return cur;
}
fn line_col_page_local_start(start: u64, base: u64) -> (result: u64) {
    if start > base { return start - base; }
    return 0;
}
fn line_col_advance_byte(value: u64, current: LineCol) -> (result: LineCol) {
    if value == 10 { return LineCol { line: current.line + 1, col: 1 }; }
    return LineCol { line: current.line, col: current.col + 1 };
}
fn line_col_page_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, index: u64, end: u64, st: LineCol) -> (result: LineCol) {
    let page: [byte; up_to N] = pages[index];
    if stride == 0 {
        iterate i over page carrying cur: LineCol = st {
            next cur = line_step_at(i, end, page[i] as u64, cur);
        }
        return cur;
    }
    let base: u64 = index * stride;
    if base >= end { return st; }
    let remaining: u64 = end - base;
    let scanned_bytes: u64 = select(page.len <= remaining, page.len, remaining);
    iterate i over page[0..scanned_bytes] carrying cur: LineCol = st {
        next cur = line_step_at(base + i, end, page[i] as u64, cur);
    }
    return cur;
}
// Render both ends of an ordered source span in one bounded prefix walk.
// Start is clamped to the clamped end when callers provide a reversed span.
// The zero-stride fallback preserves the total behavior of line_col_global;
// canonical logical sources use a positive stride and take the single-pass path.
fn line_col_span_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64) -> (result: LineColSpan) {
    let clamped_end: u64 = select(end <= total, end, total);
    let clamped_start: u64 = select(start <= clamped_end, start, clamped_end);
    if stride == 0 {
        return LineColSpan {
            start: line_col_global<P, N>(pages, stride, total, clamped_start),
            end: line_col_global<P, N>(pages, stride, total, clamped_end)
        };
    }
    let initial: LineCol = LineCol { line: 1, col: 1 };
    if clamped_start == 0 {
        return LineColSpan {
            start: initial,
            end: line_col_global<P, N>(pages, stride, total, clamped_end)
        };
    }
    if clamped_start == clamped_end {
        let position: LineCol = line_col_global<P, N>(pages, stride, total, clamped_end);
        return LineColSpan { start: position, end: position };
    }
    let required_pages: u64 = page_count_for(stride, clamped_end);
    let scanned_pages: u64 = select(required_pages <= pages.len, required_pages, pages.len);
    let initial_scan: LineColSpanScan = LineColSpanScan {
        current: initial,
        start: initial,
        found_start: clamped_start == 0
    };
    iterate p over pages[0..scanned_pages] carrying scan: LineColSpanScan = initial_scan {
        next scan = line_col_span_page_step<P, N>(
            pages, stride, p, clamped_start, clamped_end, scan
        );
    }
    if !scan.found_start {
        return LineColSpan { start: scan.current, end: scan.current };
    }
    return LineColSpan { start: scan.start, end: scan.current };
}
fn line_col_span_page_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, index: u64, start: u64, end: u64, st: LineColSpanScan) -> (result: LineColSpanScan) {
    let page: [byte; up_to N] = pages[index];
    let base: u64 = index * stride;
    if base >= end { return st; }
    let remaining: u64 = end - base;
    let scanned_bytes: u64 = select(page.len <= remaining, page.len, remaining);
    iterate i over page[0..scanned_bytes] carrying cur: LineColSpanScan = st {
        next cur = line_col_span_step(base + i, start, end, page[i] as u64, cur);
    }
    return cur;
}
fn line_col_span_step(pos: u64, start: u64, end: u64, value: u64, st: LineColSpanScan) -> (result: LineColSpanScan) {
    let current: LineCol = line_step_at(pos, end, value, st.current);
    if pos == start {
        return LineColSpanScan { current: current, start: st.current, found_start: true };
    }
    return LineColSpanScan { current: current, start: st.start, found_start: st.found_start };
}
fn line_step_at(pos: u64, end: u64, value: u64, st: LineCol) -> (result: LineCol) {
    if pos >= end { return st; }
    if value == 10 { return LineCol { line: st.line + 1, col: 1 }; }
    return LineCol { line: st.line, col: st.col + 1 };
}

// Static resource accounting for a claimed logical shape: page count,
// bytes, capacity, and the per-operation step bounds the implementation
// above honors (byte access O(1), validation O(pages), full scans O(bytes)).
record LogicalCost { pages: u64, bytes: u64, capacity: u64, byte_at_steps: u64, validate_steps: u64, full_scan_steps: u64 }
fn accounting(stride: u64, total: u64) -> (result: LogicalCost) {
    let pages: u64 = page_count_for(stride, total);
    return LogicalCost { pages: pages, bytes: total, capacity: pages * stride, byte_at_steps: 1, validate_steps: pages, full_scan_steps: total };
}
