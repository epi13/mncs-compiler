// Read four adjacent bytes from a logical source. The common case stays in
// one page and avoids four separate global address calculations; page edges,
// short inputs, and malformed views retain byte_at_global's total behavior.
record ByteWindow4 { b0: u64, b1: u64, b2: u64, b3: u64 }
record GlobalPageAddress { valid: bool, page: u64, intra: u64, offset: u64 }
enum ByteWindow4Choice {
    Direct { window: ByteWindow4 },
    GlobalFallback
}

// Resolve the logical page and offset without transporting the page table to
// each scan step. The page-table bound is checked by the caller before it
// indexes the selected page.
fn global_page_address(stride: u64, total: u64, offset: u64) -> (result: GlobalPageAddress) {
    if stride == 0 || offset >= total {
        return GlobalPageAddress { valid: false, page: 0, intra: 0, offset: offset };
    }
    return GlobalPageAddress { valid: true, page: offset / stride, intra: offset % stride, offset: offset };
}

// Produce the common same-page window from one already-selected page. The
// caller uses byte_window4_global for cross-page, short, or malformed cases,
// which remains the total authority for global reads.
fn byte_window4_page<N: Nat>(view: [byte; up_to N], selected_page: u64, address: GlobalPageAddress, stride: u64, total: u64) -> (result: ByteWindow4Choice) {
    if !address.valid || selected_page != address.page || stride == 0 || address.offset >= total || address.intra >= stride || address.intra >= view.len {
        return ByteWindow4Choice.GlobalFallback;
    }
    if total - address.offset >= 4 && stride - address.intra >= 4 && view.len - address.intra >= 4 {
        let b0: u64 = view[address.intra + 0] as u64;
        let b1: u64 = view[address.intra + 1] as u64;
        let b2: u64 = view[address.intra + 2] as u64;
        let b3: u64 = view[address.intra + 3] as u64;
        return ByteWindow4Choice.Direct { window: ByteWindow4 { b0: b0, b1: b1, b2: b2, b3: b3 } };
    }
    return ByteWindow4Choice.GlobalFallback;
}

fn byte_at_global_delta<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offset: u64, delta: u64) -> (result: u64) {
    if offset > 18446744073709551615 - delta { return 256; }
    return byte_at_global<P, N>(pages, stride, total, offset + delta);
}

fn missing_window4() -> (result: ByteWindow4) {
    return ByteWindow4 { b0: 256, b1: 256, b2: 256, b3: 256 };
}

// The common case stays in one page and avoids four global address
// calculations. Page edges and malformed views retain byte_at_global behavior.
fn byte_window4_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offset: u64) -> (result: ByteWindow4) {
    if stride == 0 { return missing_window4(); }
    if offset >= total { return missing_window4(); }
    let page: u64 = offset / stride;
    let intra: u64 = offset % stride;
    if page >= pages.len { return missing_window4(); }
    let view: [byte; up_to N] = pages[page];
    if intra >= view.len { return missing_window4(); }
    if total - offset >= 4 && stride - intra >= 4 && view.len - intra >= 4 {
        let b0: u64 = view[intra + 0] as u64;
        let b1: u64 = view[intra + 1] as u64;
        let b2: u64 = view[intra + 2] as u64;
        let b3: u64 = view[intra + 3] as u64;
        return ByteWindow4 { b0: b0, b1: b1, b2: b2, b3: b3 };
    }
    let b0: u64 = byte_at_global_delta<P, N>(pages, stride, total, offset, 0);
    let b1: u64 = byte_at_global_delta<P, N>(pages, stride, total, offset, 1);
    let b2: u64 = byte_at_global_delta<P, N>(pages, stride, total, offset, 2);
    let b3: u64 = byte_at_global_delta<P, N>(pages, stride, total, offset, 3);
    return ByteWindow4 { b0: b0, b1: b1, b2: b2, b3: b3 };
}

// Global spans are stable across stride choices: the same content chunked
// at any stride lexes to identical spans.
fn span_valid_global(total: u64, start: u64, end: u64) -> (result: bool) {
    return start <= end && end <= total;
}

// The ASCII admission predicate over all transported page bytes. The empty
// source is vacuously ASCII; a zero stride addresses nothing and likewise
// admits. Validators run separately; this never fails.
fn ascii_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: bool) {
    if stride == 0 || total == 0 { return true; }
    iterate p over pages carrying valid: bool = true {
        let page_valid: bool = ascii_page_step<P, N>(pages, p, valid);
        if !page_valid { return false; }
        next valid = page_valid;
    }
    return valid;
}
fn ascii_page_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], index: u64, valid: bool) -> (result: bool) {
    if !valid { return false; }
    let page: [byte; up_to N] = pages[index];
    return ascii_view<N>(page);
}

// FNV-1a/64 content identity, vendored from the mncs.std.fnv1a.v1 step so
// the compiler owns module identity without a stdlib dependency. Order and
// duplication sensitive: swapped, duplicated, or dropped pages change the
// fold. The empty source folds to the basis. Not cryptographic.
fn fnv_basis() -> (result: u64) { return 14695981039346656037; }
fn fnv_step(state: u64, value: byte) -> (result: u64) {
    return (state ^ (value as u64)) *% 1099511628211;
}
fn fingerprint_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: u64) {
    if stride == 0 || total == 0 { return fnv_basis(); }
    iterate p over pages carrying h: u64 = fnv_basis() {
        next h = fingerprint_page_step<P, N>(pages, p, h);
    }
    return h;
}
fn fingerprint_page_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], index: u64, h: u64) -> (result: u64) {
    let page: [byte; up_to N] = pages[index];
    let groups: u64 = page.len / 4;
    iterate group over page[0..groups] carrying grouped: u64 = h {
        let base: u64 = group * 4;
        let h0: u64 = (grouped ^ (page[base + 0] as u64)) *% 1099511628211;
        let h1: u64 = (h0 ^ (page[base + 1] as u64)) *% 1099511628211;
        let h2: u64 = (h1 ^ (page[base + 2] as u64)) *% 1099511628211;
        next grouped = (h2 ^ (page[base + 3] as u64)) *% 1099511628211;
    }
    let tail_count: u64 = page.len - groups * 4;
    iterate tail_index over page[0..tail_count] carrying acc: u64 = grouped {
        next acc = fnv_step(acc, page[groups * 4 + tail_index]);
    }
    return acc;
}

// Global rendering of a byte offset: 1-based line and column under the same
// convention as line_col. Page p starts at global p * stride; bytes at or
// past the clamped offset freeze the carry. Out-of-range offsets render the
// end-of-source position.
fn line_col_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offset: u64) -> (result: LineCol) {
    let end: u64 = select(offset <= total, offset, total);
    if stride == 0 {
        iterate p over pages carrying st: LineCol = LineCol { line: 1, col: 1 } {
            next st = line_col_page_step<P, N>(pages, stride, p, end, st);
        }
        return st;
    }
    let required_pages: u64 = page_count_for(stride, end);
    let scanned_pages: u64 = select(required_pages <= pages.len, required_pages, pages.len);
    iterate p over pages[0..scanned_pages] carrying st: LineCol = LineCol { line: 1, col: 1 } {
        next st = line_col_page_step<P, N>(pages, stride, p, end, st);
    }
    return st;
}

// Map a bounded monotone batch of byte offsets with one forward scan. Offsets
// are clamped to total as in line_col_global; equal clamped offsets are
// allowed. An out-of-order batch is rejected with its first decreasing query
// index so callers can sort source locations or use independent lookups.
record LineColManyResult { ordered: bool, invalid_index: u64, locations: [LineCol; up_to 64] }
record LineColManyState {
    cursor: u64,
    current: LineCol,
    previous: u64,
    has_previous: bool,
    ordered: bool,
    invalid_index: u64,
    locations: [LineCol; 64]
}
fn line_cols_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offsets: [u64; up_to 64]) -> (result: LineColManyResult) {
    let initial: LineCol = LineCol { line: 1, col: 1 };
    let empty_locations: [LineCol; 64] = [initial; 64];
    iterate index over offsets carrying st: LineColManyState = LineColManyState {
        cursor: 0,
        current: initial,
        previous: 0,
        has_previous: false,
        ordered: true,
        invalid_index: 0,
        locations: empty_locations
    } {
        next st = line_cols_step<P, N>(pages, stride, total, offsets[index], index, st);
    }
    if !st.ordered {
        return LineColManyResult {
            ordered: false,
            invalid_index: st.invalid_index,
            locations: st.locations[0..0]
        };
    }
    return LineColManyResult {
        ordered: true,
        invalid_index: 0,
        locations: st.locations[0..offsets.len]
    };
}
fn line_cols_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offset: u64, index: u64, st: LineColManyState) -> (result: LineColManyState) {
    if !st.ordered { return st; }
    let clamped: u64 = select(offset <= total, offset, total);
    if st.has_previous && clamped < st.previous {
        return LineColManyState {
            cursor: st.cursor,
            current: st.current,
            previous: st.previous,
            has_previous: true,
            ordered: false,
            invalid_index: index,
            locations: st.locations
        };
    }
    let position: LineCol = line_col_many_position<P, N>(
        pages, stride, total, st.cursor, clamped, st.current
    );
    let next_state: LineColManyState = LineColManyState {
        cursor: clamped,
        current: position,
        previous: clamped,
        has_previous: true,
        ordered: true,
        invalid_index: 0,
        locations: replace(st.locations, index, position)
    };
    return next_state;
}
fn line_col_many_position<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, start: u64, end: u64, current: LineCol) -> (result: LineCol) {
    if stride == 0 { return line_col_global<P, N>(pages, stride, total, end); }
    return line_col_advance_global<P, N>(pages, stride, start, end, current);
}
fn line_col_advance_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, start: u64, end: u64, initial: LineCol) -> (result: LineCol) {
    if stride == 0 { return line_col_global<P, N>(pages, stride, end, end); }
    let required_pages: u64 = page_count_for(stride, end);
    let scanned_pages: u64 = select(required_pages <= pages.len, required_pages, pages.len);
    // Ordered callers already scanned the prefix ending at start. Skip its
    // page headers and scan only the remainder of the current page onward.
