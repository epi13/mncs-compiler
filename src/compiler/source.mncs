    if base >= end { return st; }
    let begin: u64 = line_col_page_local_start(start, base);
    let remaining: u64 = end - base;
    let finish: u64 = select(page.len <= remaining, page.len, remaining);
    if begin >= finish { return st; }
    iterate i over page[begin..finish] carrying cur: LineCol = st {
        next cur = line_col_advance_byte(page[begin + i] as u64, cur);
