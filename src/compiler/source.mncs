fn line_col_page_local_start(start: u64, base: u64) -> (result: u64) {
    if start > base { return start - base; }
    return 0;
}
fn line_col_advance_byte(value: u64, current: LineCol) -> (result: LineCol) {
    if value == 10 { return LineCol { line: current.line + 1, col: 1 }; }
    if value >= 128 && value <= 191 { return current; }
    return LineCol { line: current.line, col: current.col + 1 };
}
fn line_col_page_step<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, index: u64, end: u64, st: LineCol) -> (result: LineCol) {
