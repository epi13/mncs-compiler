}

fn utf8_continuation(value: u64) -> (result: bool) {
    return value >= 128 && value <= 191;
}
fn utf8_lead_continuations(value: u64) -> (result: u64) {
    if value >= 194 && value <= 223 { return 1; }
    if value >= 224 && value <= 239 { return 2; }
    if value >= 240 && value <= 244 { return 3; }
    return 0;
}
fn utf8_first_continuation_valid(lead: u64, continuation: u64) -> (result: bool) {
    if !(utf8_continuation(continuation)) { return false; }
    if lead == 224 && continuation < 160 { return false; }
    if lead == 237 && continuation >= 160 { return false; }
    if lead == 240 && continuation < 144 { return false; }
    if lead == 244 && continuation >= 144 { return false; }
    return true;
}

// Decode one UTF-8 scalar from a bounded byte view. Malformed input advances
// one byte so callers can always make progress; offsets remain byte offsets.
fn utf8_scalar<N: Nat>(source: [byte; up_to N], at: u64) -> (result: Utf8Scalar) {
    if at >= source.len { return Utf8Scalar { scalar: 0, next: at, valid: false }; }
    let b0: u64 = source[at] as u64;
    if b0 < 128 { return Utf8Scalar { scalar: b0, next: at + 1, valid: true }; }
    let need: u64 = utf8_lead_continuations(b0);
    if need == 0 { return Utf8Scalar { scalar: 0, next: at + 1, valid: false }; }
    if at + need >= source.len { return Utf8Scalar { scalar: 0, next: at + 1, valid: false }; }
    let b1: u64 = source[at + 1] as u64;
    if !(utf8_first_continuation_valid(b0, b1)) {
        return Utf8Scalar { scalar: 0, next: at + 1, valid: false };
    }
    if need == 1 {
        let scalar: u64 = (b0 - 192) * 64 + b1 % 64;
        return Utf8Scalar { scalar: scalar, next: at + 2, valid: true };
    }
    let b2: u64 = source[at + 2] as u64;
    if !(utf8_continuation(b2)) {
        return Utf8Scalar { scalar: 0, next: at + 1, valid: false };
    }
    if need == 2 {
        let scalar: u64 = (b0 - 224) * 4096 + (b1 % 64) * 64 + b2 % 64;
        return Utf8Scalar { scalar: scalar, next: at + 3, valid: true };
    }
    let b3: u64 = source[at + 3] as u64;
    if !(utf8_continuation(b3)) {
        return Utf8Scalar { scalar: 0, next: at + 1, valid: false };
    }
    let scalar: u64 = (b0 - 240) * 262144 + (b1 % 64) * 4096 + (b2 % 64) * 64 + b3 % 64;
    return Utf8Scalar { scalar: scalar, next: at + 4, valid: true };
}

fn utf8_validation_step(state: Utf8ValidationState, value: u64, index: u64) -> (result: Utf8ValidationState) {
    if state.error { return state; }
    if state.remaining > 0 {
        if !(utf8_continuation(value)) {
            return Utf8ValidationState { ..state, cursor: index + 1, remaining: 0, lead: 0, error: true, error_offset: index };
        }
        if state.lead != 0 && !(utf8_first_continuation_valid(state.lead, value)) {
            return Utf8ValidationState { ..state, cursor: index + 1, remaining: 0, lead: 0, error: true, error_offset: index };
        }
        return Utf8ValidationState { ..state, cursor: index + 1, remaining: state.remaining - 1, lead: 0 };
    }
    let need: u64 = utf8_lead_continuations(value);
    if value >= 128 && need == 0 {
        return Utf8ValidationState { ..state, cursor: index + 1, error: true, error_offset: index };
    }
    if need == 0 {
        return Utf8ValidationState { ..state, cursor: index + 1 };
    }
    return Utf8ValidationState { ..state, cursor: index + 1, remaining: need, lead: value };
}

fn validate_utf8_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: Utf8Validation) {
    if ascii_global<P, N>(pages, stride, total) { return Utf8Validation { valid: true, error_offset: 0 }; }
    let initial: Utf8ValidationState = Utf8ValidationState { cursor: 0, remaining: 0, lead: 0, error: false, error_offset: 0 };
    iterate batch up_to 1024 carrying outer: Utf8ValidationState = initial {
        if outer.error { return Utf8Validation { valid: false, error_offset: outer.error_offset }; }
        if outer.cursor >= total {
            if outer.remaining > 0 { return Utf8Validation { valid: false, error_offset: total }; }
            return Utf8Validation { valid: true, error_offset: 0 };
        }
        iterate byte_index up_to 1024 carrying inner: Utf8ValidationState = outer {
            let advanced: Utf8ValidationState = match select(inner.error || inner.cursor >= total, 1, 0) {
                1 => inner,
                _ => utf8_validation_step(inner, byte_at_global<P, N>(pages, stride, total, inner.cursor), inner.cursor)
            };
            next inner = advanced;
        }
        next outer = inner;
    }
    if outer.error { return Utf8Validation { valid: false, error_offset: outer.error_offset }; }
    if outer.cursor < total { return Utf8Validation { valid: false, error_offset: outer.cursor }; }
    if outer.remaining > 0 { return Utf8Validation { valid: false, error_offset: total }; }
    return Utf8Validation { valid: true, error_offset: 0 };
}

// Return the first invalid byte; a truncated final scalar points at the
// source length. ASCII keeps the existing sixteen-byte-per-transition path.
fn validate_utf8<N: Nat>(source: [byte; up_to N]) -> (result: Utf8Validation) {
    if ascii_view<N>(source) { return Utf8Validation { valid: true, error_offset: 0 }; }
    let initial: Utf8ValidationState = Utf8ValidationState { cursor: 0, remaining: 0, lead: 0, error: false, error_offset: 0 };
    iterate i over source carrying state: Utf8ValidationState = initial {
        if state.error { return Utf8Validation { valid: false, error_offset: state.error_offset }; }
        next state = utf8_validation_step(state, source[i] as u64, i);
    }
    if state.error { return Utf8Validation { valid: false, error_offset: state.error_offset }; }
    if state.remaining > 0 { return Utf8Validation { valid: false, error_offset: source.len }; }
    return Utf8Validation { valid: true, error_offset: 0 };
}

fn span_valid<N: Nat>(source: [byte; up_to N], start: u64, end: u64) -> (result: bool) {
    return start <= end && end <= source.len;
}

// Human rendering of a byte offset: 1-based line and Unicode-scalar column,
// matching Stage-0's SourceSpan convention. Spans remain byte based.
record LineCol { line: u64, col: u64 }
record LineColSpan { start: LineCol, end: LineCol }
record LineColSpanScan { current: LineCol, start: LineCol, found_start: bool }
fn line_col<N: Nat>(source: [byte; up_to N], offset: u64) -> (result: LineCol) {
    iterate i over source carrying st: LineCol = LineCol { line: 1, col: 1 } {
        next st = line_step<N>(source, offset, i, st);
    }
    return st;
}
fn line_step<N: Nat>(source: [byte; up_to N], offset: u64, pos: u64, st: LineCol) -> (result: LineCol) {
    if pos >= offset { return st; }
    let value: u64 = byte_at<N>(source, pos);
    if value == 10 { return LineCol { line: st.line + 1, col: 1 }; }
    if value >= 128 && value <= 191 { return st; }
    return LineCol { line: st.line, col: st.col + 1 };
}

// Logical immutable source (CP-0001): a fixed-stride page composition of
// bounded views. The host transports pages only; every offset, span, and
// identity decision below executes in MNCS. Canonical form: stride in
// 1..=1024; pages.len == ceil(total / stride) (zero pages iff total == 0);
// every non-terminal page has length exactly stride; the terminal page has
// length total - (pages.len - 1) * stride. A global offset o in [0, total)
// addresses page o / stride, intra-page index o % stride: O(1) with no
// iteration, so per-byte access costs one step regardless of source size.
// The 1024 sequence ceiling caps one logical source at 1024 pages of 1024
// bytes (1 MiB); larger corpora are multi-module projects, not one source.
fn page_count_for(stride: u64, total: u64) -> (result: u64) {
    if stride == 0 { return 0; }
    if total == 0 { return 0; }
    return (total - 1) / stride + 1;
}

// Structural validation of a transported page composition. Codes: 0 valid;
// 1 stride is zero; 2 stride exceeds 1024; 3 a page exceeds the stride;
// 4 a non-terminal page is short; 5 the page count disagrees with
// ceil(total / stride) (duplicate, missing, or padded pages); 6 the
// terminal page length disagrees with the claimed total. Validation is
// O(pages); content identity is a separate fingerprint comparison.
fn validate_pages<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64) -> (result: u64) {
    if stride == 0 { return 1; }
    if stride > 1024 { return 2; }
    if pages.len != page_count_for(stride, total) { return 5; }
    if pages.len == 0 { return 0; }
    iterate i over pages carrying code: u64 = 0 {
        let page: [byte; up_to N] = pages[i];
        // Keep these checks in the page loop: a helper call per page added
        // interpreter work without sharing any validation state.
        let too_large: bool = page.len > stride;
        let short_middle: bool = i + 1 < pages.len && page.len != stride;
        let page_error: u64 = select(too_large, 3, select(short_middle, 4, 0));
        next code = select(code != 0, code, page_error);
    }
    if code != 0 { return code; }
    let last: u64 = pages.len - 1;
    if total < last * stride { return 6; }
    let terminal: [byte; up_to N] = pages[last];
    if terminal.len != total - last * stride { return 6; }
    return 0;
}

// Total global byte access: the content byte as u64, or 256 past the end,
// under a zero stride, or past a transported page edge. Callers validate
// first; this stays total on malformed input regardless.
fn byte_at_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, offset: u64) -> (result: u64) {
    if stride == 0 { return 256; }
    if offset >= total { return 256; }
    let page: u64 = offset / stride;
    let intra: u64 = offset % stride;
    if page >= pages.len { return 256; }
    let view: [byte; up_to N] = pages[page];
    if intra >= view.len { return 256; }
    return view[intra] as u64;
}

fn utf8_scalar_global<P: Nat, N: Nat>(pages: [[byte; up_to N]; up_to P], stride: u64, total: u64, at: u64) -> (result: Utf8Scalar) {
    if at >= total { return Utf8Scalar { scalar: 0, next: at, valid: false }; }
    let b0: u64 = byte_at_global<P, N>(pages, stride, total, at);
    if b0 >= 256 { return Utf8Scalar { scalar: 0, next: at + 1, valid: false }; }
    if b0 < 128 { return Utf8Scalar { scalar: b0, next: at + 1, valid: true }; }
    let need: u64 = utf8_lead_continuations(b0);
    if need == 0 { return Utf8Scalar { scalar: 0, next: at + 1, valid: false }; }
    if at + need >= total { return Utf8Scalar { scalar: 0, next: at + 1, valid: false }; }
    let b1: u64 = byte_at_global<P, N>(pages, stride, total, at + 1);
    if !(utf8_first_continuation_valid(b0, b1)) {
        return Utf8Scalar { scalar: 0, next: at + 1, valid: false };
    }
    if need == 1 {
        return Utf8Scalar { scalar: (b0 - 192) * 64 + b1 % 64, next: at + 2, valid: true };
    }
    let b2: u64 = byte_at_global<P, N>(pages, stride, total, at + 2);
    if !(utf8_continuation(b2)) { return Utf8Scalar { scalar: 0, next: at + 1, valid: false }; }
    if need == 2 {
        return Utf8Scalar { scalar: (b0 - 224) * 4096 + (b1 % 64) * 64 + b2 % 64, next: at + 3, valid: true };
    }
    let b3: u64 = byte_at_global<P, N>(pages, stride, total, at + 3);
    if !(utf8_continuation(b3)) { return Utf8Scalar { scalar: 0, next: at + 1, valid: false }; }
    return Utf8Scalar { scalar: (b0 - 240) * 262144 + (b1 % 64) * 4096 + (b2 % 64) * 64 + b3 % 64, next: at + 4, valid: true };
}

