module mncs.compiler.source.v1;

record Utf8Scalar { scalar: u64, next: u64, valid: bool }
record Utf8Validation { valid: bool, error_offset: u64 }
record Utf8ValidationState { cursor: u64, remaining: u64, lead: u64, error: bool, error_offset: u64 }

// A source unit is a bounded byte view whose capacity is inferred from the
// caller. The actual length remains runtime data; compiler APIs do not impose
// the old four-times-64-byte experiment limit.
fn byte_at<N: Nat>(source: [byte; up_to N], offset: u64) -> (result: u64) {
    if offset < source.len {
        return source[offset] as u64;
    }
    return 256;
}

fn ascii<N: Nat>(source: [byte; up_to N]) -> (result: bool) {
    return ascii_view<N>(source);
}

// Check sixteen bytes per interpreter transition. The bounded source views used
// by the compiler are often long, so a byte-at-a-time loop made ASCII
// admission consume one MNCS step for every byte before parsing could start.
fn ascii_view<N: Nat>(source: [byte; up_to N]) -> (result: bool) {
    let groups: u64 = source.len / 16;
    iterate group over source[0..groups] carrying valid: bool = true {
        if !valid { return false; }
        let base: u64 = group * 16;
        if source[base + 0] as u64 >= 128 { return false; }
        if source[base + 1] as u64 >= 128 { return false; }
        if source[base + 2] as u64 >= 128 { return false; }
        if source[base + 3] as u64 >= 128 { return false; }
        if source[base + 4] as u64 >= 128 { return false; }
        if source[base + 5] as u64 >= 128 { return false; }
        if source[base + 6] as u64 >= 128 { return false; }
        if source[base + 7] as u64 >= 128 { return false; }
        if source[base + 8] as u64 >= 128 { return false; }
        if source[base + 9] as u64 >= 128 { return false; }
        if source[base + 10] as u64 >= 128 { return false; }
        if source[base + 11] as u64 >= 128 { return false; }
        if source[base + 12] as u64 >= 128 { return false; }
        if source[base + 13] as u64 >= 128 { return false; }
        if source[base + 14] as u64 >= 128 { return false; }
        if source[base + 15] as u64 >= 128 { return false; }
        next valid = true;
    }
    let tail: u64 = groups * 16;
    if tail < source.len {
        if source[tail] as u64 >= 128 { return false; }
    }
    if tail + 1 < source.len {
        if source[tail + 1] as u64 >= 128 { return false; }
    }
    if tail + 2 < source.len {
        if source[tail + 2] as u64 >= 128 { return false; }
    }
    if tail + 3 < source.len {
        if source[tail + 3] as u64 >= 128 { return false; }
    }
    if tail + 4 < source.len {
        if source[tail + 4] as u64 >= 128 { return false; }
    }
    if tail + 5 < source.len {
        if source[tail + 5] as u64 >= 128 { return false; }
    }
    if tail + 6 < source.len {
        if source[tail + 6] as u64 >= 128 { return false; }
    }
    if tail + 7 < source.len {
        if source[tail + 7] as u64 >= 128 { return false; }
    }
    if tail + 8 < source.len {
        if source[tail + 8] as u64 >= 128 { return false; }
    }
    if tail + 9 < source.len {
        if source[tail + 9] as u64 >= 128 { return false; }
    }
    if tail + 10 < source.len {
        if source[tail + 10] as u64 >= 128 { return false; }
    }
    if tail + 11 < source.len {
        if source[tail + 11] as u64 >= 128 { return false; }
    }
    if tail + 12 < source.len {
        if source[tail + 12] as u64 >= 128 { return false; }
    }
    if tail + 13 < source.len {
        if source[tail + 13] as u64 >= 128 { return false; }
    }
    if tail + 14 < source.len {
        if source[tail + 14] as u64 >= 128 { return false; }
